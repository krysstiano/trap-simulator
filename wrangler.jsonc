{
  // Cloudflare Workers (Static Assets) — serwuje statyczną stronę z folderu website/ jako site.
  // Build (Cloudflare) odpala `node website/gen-patchnotes.cjs` (patchnotes + web-demo /play/),
  // potem `npx wrangler deploy` wgrywa website/ jako statyczne assety (brak skryptu Workera = assets-only).
  "name": "trap-simulator",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./website"
  }
}
