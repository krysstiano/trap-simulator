// CINEMATIC SIĹOWNI #3 â€” Powrot do szczytu (forma/kondycja >= 100 PO spadku)
// Wywolywane po treningu jesli milestone juz pokazany ale gracz odzyskuje 100
function checkFormaComeback(){
  if(!G || (G.forma||0) < 100) { G._formaWasAt100 = false; return; }
  // Forma >= 100. Jezeli juz pokazano forma100 milestone (cinematic #2)...
  if(G._milestonesShown && G._milestonesShown.forma100){
    // ...i gracz spadl ponizej 100 wczesniej, teraz wraca
    if(!G._formaWasAt100){
      G._formaWasAt100 = true;
      const variants = [
        'POWROT DO ZYCIOWKI! đź’Ş',
        'ZNOWU NA SZCZYCIE! đź”Ą',
        'COMEBACK! Pompa wrocila',
        'NIGDY NIE ODPUSZCZAJ! Forma 100',
      ];
      const t = variants[Math.floor(Math.random()*variants.length)];
      if(typeof showMilestoneCinematic === 'function'){
        showMilestoneCinematic({
          emoji:'đź’Ş', title:t, subtitle:'Wrociles do swojej szczytowej formy!',
          tagline:'Bonus +10 max zdrowia/energii/glodu znowu aktywny',
          accentColor:'#27ae60', accent2:'#f1c40f', duration:4000
        });
      }
    }
  } else {
    // Pierwszy raz â€” flag dla cinematic #2
    G._formaWasAt100 = true;
  }
}
function checkFitnessComeback(){
  if(!G || (G.fitness||0) < 100) { G._fitnessWasAt100 = false; return; }
  if(G._milestonesShown && G._milestonesShown.fitness100){
    if(!G._fitnessWasAt100){
      G._fitnessWasAt100 = true;
      const variants = [
        'POWROT KONDYCJI! đźŹ',
        'ZNOWU SZYBKI! đź”Ą',
        'COMEBACK KONDYCYJNY!',
        'BIEGNIESZ JAK WIATR! Kondycja 100',
      ];
      const t = variants[Math.floor(Math.random()*variants.length)];
      if(typeof showMilestoneCinematic === 'function'){
        showMilestoneCinematic({
          emoji:'đźŹ', title:t, subtitle:'Wrociles do swojej szczytowej kondycji!',
          tagline:'Bonus +10 max zdrowia/energii/glodu znowu aktywny',
          accentColor:'#27ae60', accent2:'#00bcd4', duration:4000
        });
      }
    }
  } else {
    G._fitnessWasAt100 = true;
  }
}
window.checkFormaComeback = checkFormaComeback;
window.checkFitnessComeback = checkFitnessComeback;

