function getLuxuryDiscount(){
  const rep=G.streetRep||0;
  return rep>=100?0.15:rep>=75?0.10:rep>=50?0.05:0;
}
function renderLuxuryShop(brandId){
  const cat=LUXURY_CATALOG[brandId];
  if(!cat){renderWIP(brandId);return;}
  const drip=G.drip||0;
  const dripMult=(1+drip*0.005).toFixed(2);
  const disc=getLuxuryDiscount();
  const discLabel=disc>0?`<span style="color:#2ecc71;font-size:11px;margin-left:8px">đź”± Rep ${Math.round(disc*100)}% zniĹĽka</span>`:'';
  document.getElementById('ov-content').innerHTML=`
    <h2>${cat.emoji} ${cat.brand}</h2>
    <p class="sub" style="color:#c8a520">Dzielnica Dripu â€” luksus definiuje twĂłj zasiÄ™g i styl</p>
    <div style="display:flex;gap:16px;align-items:center;margin-bottom:16px;background:rgba(200,165,32,.08);border:1px solid rgba(200,165,32,.3);border-radius:8px;padding:10px 16px">
      <span style="font-size:24px">đź’Ž</span>
      <div>
        <div style="font-size:13px;color:#c8a520;font-weight:700">TwĂłj Drip: <strong>${drip}</strong>${discLabel}</div>
        <div style="font-size:11px;color:#997730">Ă—${dripMult} followersĂłw z postĂłw Â· koncerty (zarobki + fani) +${Math.min(getRaperST('autopromocja')>=4?30:20,Math.floor((getEffectiveDrip()||drip)*0.1))}% Â· tantiemy +${Math.min(getRaperST('autopromocja')>=4?60:40,Math.floor((getEffectiveDrip()||drip)*0.2))}% Â· lepsze oferty label${getRaperST('autopromocja')>=4?' (Ulepszenie "Personal brand": rozszerzone capy)':''}</div>
        ${drip>=50?`<div style="font-size:11px;color:#7ec87e;margin-top:3px">âś¨ Drip ${drip}+ â†’ codzienny pasywny przyrost: +${Math.floor(drip*0.05)} obs./dzieĹ„ Â· +${Math.floor(drip*0.015)} fanĂłw/dzieĹ„</div>`:`<div style="font-size:11px;color:#666;margin-top:3px">đź’ˇ Drip 50+ odblokowuje codzienny pasywny przyrost obserwujÄ…cych i fanĂłw (rozpoznawalna marka)</div>`}
      </div>
    </div>
    <div class="shopgrid">
      ${cat.items.map((item,i)=>{
        const finalPrice=Math.round(item.price*(1-disc));
        const discStr=disc>0?`<span style="text-decoration:line-through;color:#666;font-size:11px">${item.price.toLocaleString('pl')} zĹ‚</span> `:'';
        const ownedKey=`${brandId}_${i}`;
        const owned=(G._ownedLux||[]).includes(ownedKey);
        return `
        <div class="sitem" style="border-color:#3a2a00;background:linear-gradient(160deg,#0d0a00,#1a1400)">
          <h3 style="color:#c8a520">${item.emoji} ${item.name}</h3>
          <p style="font-size:11px;color:#887750">${item.desc}</p>
          <p style="color:#c8a520;font-size:12px;margin:4px 0">đź’Ž +${item.drip} Drip</p>
          <div class="pr" style="color:#f1c40f">${discStr}${finalPrice.toLocaleString('pl')} zĹ‚</div>
          ${owned?'<div class="owned">âś… W kolekcji</div>':''}
          <button class="bbtn" style="background:#1a0e00;border-color:#c8a520;color:#c8a520"
            onclick="buyLuxuryItem('${brandId}',${i})"
            ${owned||G.money<finalPrice?'disabled':''}>${owned?'Posiadasz':'Kup'}</button>
        </div>`;
      }).join('')}
    </div>
    <div class="res" id="shop-res">Kup luksusowy przedmiot â†’ zyskaj Drip đź’Ž</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}
window.buyLuxuryItem=(brandId,idx)=>{
  const cat=LUXURY_CATALOG[brandId];
  const item=cat.items[idx];
  if(!item) return;
  const ownedKey=`${brandId}_${idx}`;
  G._ownedLux=G._ownedLux||[];
  if(G._ownedLux.includes(ownedKey)){
    document.getElementById('shop-res').textContent='JuĹĽ masz ten przedmiot w kolekcji!';return;
  }
  const finalPrice=Math.round(item.price*(1-getLuxuryDiscount()));
  if(G.money<finalPrice){document.getElementById('shop-res').textContent='Za maĹ‚o pieniÄ™dzy!';return;}
  G.money-=finalPrice;
  G._ownedLux.push(ownedKey);
  /* v1.9.35: cap drip 200 (poprzednio unbounded â€” wszystkie 21 luxury items dawaĹ‚y >350) */
  G.drip=Math.min(200,(G.drip||0)+item.drip);
  /* v1.9.35: Prestige fameMult through addFame() */
  if(typeof addFame==='function') addFame(Math.floor(item.drip/2)); else G.fame=clamp((G.fame||0)+Math.floor(item.drip/2),0,500);
  G.followers=(G.followers||0)+Math.floor(item.drip*3);
  showMsg(`đź’Ž ${item.name} â€” ${cat.brand}! +${item.drip} Drip, +${Math.floor(item.drip/2)} sĹ‚awa, +${Math.floor(item.drip*3)} followersĂłw`);
  addNotif(`đź’Ž +${item.drip} Drip (${cat.brand})`);
  addXP(5);
  renderLuxuryShop(brandId);
};

function renderBarber(){
  // v1.9.3: 4 â†’ 9 fryzur, v1.9.8: + Buzz (10 total)
  const hairstyles=[
    {id:0,name:'KrĂłtka',price:30},
    {id:1,name:'DĹ‚uga',price:50},
    {id:2,name:'Dredy',price:120},
    {id:3,name:'Ĺysy',price:20},
    {id:4,name:'Afro',price:140},
    {id:5,name:'Irokez',price:100},
    {id:6,name:'Bokser',price:25},
    {id:7,name:'Loczki',price:90},
    {id:8,name:'Quiff',price:80},
    {id:9,name:'Buzz cut',price:35},
  ];
  document.getElementById('ov-content').innerHTML=`
    <h2>âś‚ď¸Ź Fryzjer</h2><p class="sub">ZmieĹ„ fryzurÄ™ swojej postaci.</p>
    <div style="display:flex;gap:30px;align-items:flex-start;flex-wrap:wrap;margin-bottom:14px">
      <div>
        <div style="font-size:12px;color:#556;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px">PodglÄ…d</div>
        <canvas id="barber-preview" width="120" height="120" style="border:1px solid #1a2a3a;border-radius:8px;background:#0a1220;display:block;"></canvas>
        <div style="font-size:12px;color:#667;text-align:center;margin-top:4px" id="barber-preview-lbl">Aktualna fryzura</div>
      </div>
      <div class="shopgrid" style="margin-bottom:0">
        ${hairstyles.map(h=>`<div class="sitem"><h3>${h.name}</h3><div class="pr">${h.price} zĹ‚</div>${G.hair===h.id?'<div class="owned">âś… Aktualna</div>':''}<button class="bbtn" onmouseover="previewHaircut(${h.id},'${h.name}')" onmouseout="previewHaircut(${G.hair},'Aktualna fryzura')" onclick="buyHaircut(${h.id},${h.price})" ${G.hair===h.id||G.money<h.price?'disabled':''}>StrzyĹĽ</button></div>`).join('')}
      </div>
    </div>
    <div class="res" id="shop-res">Wybierz fryzurÄ™.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  setTimeout(()=>previewHaircut(G.hair,'Aktualna fryzura'),50);
}
window.previewHaircut=function(hairId,lbl){
  const cvs=document.getElementById('barber-preview');if(!cvs)return;
  const cx=cvs.getContext('2d');
  cx.clearRect(0,0,120,120);
  cx.fillStyle='#0a1220';cx.fillRect(0,0,120,120);
  // Draw simple face â€” G.skin moĹĽe byÄ‡ stringiem 'light'/'medium'/'dark' (z kreatora) lub hexem
  const _skin=G.skin||P.skin||'light';
  const skinColor=SKIN_COLS[_skin]||(typeof _skin==='string'&&_skin.startsWith('#')?_skin:'#e0a870');
  const px=60,py=60;
  // v1.9.3: Twarz/szyja PRZED wĹ‚osami. Oczy/usta DOPIERO PO wĹ‚osach (ĹĽeby fryzura nie zakrywaĹ‚a oczu)
  cx.fillStyle=skinColor;cx.beginPath();cx.arc(px,py+5,28,0,Math.PI*2);cx.fill();
  cx.fillStyle=skinColor;cx.fillRect(px-8,py+28,16,14);
  // â”€â”€ HAIR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // v1.9.5/v1.9.8: 10 fryzur â€” clean silhouettes z gradientami
  const _hairBase=['#2a1808','#1a0a05','#221206','transparent','#150a04','#2a1408','#3a2616','#3a1f10','#2a1208','#3a2818'];
  const _hairLight=['#5a3818','#3a2010','#4a2810','transparent','#2a1606','#5a3018','#6a4a30','#6a3a20','#5a2a18','#6a4838'];
  const baseCol=_hairBase[hairId]||'#2a1808';
  const lightCol=_hairLight[hairId]||'#5a3818';
  // Pomocnik: gradient pionowy (jaĹ›niej u gĂłry, ciemniej u doĹ‚u â€” Ĺ›wiatĹ‚o z gĂłry)
  const _hairGrad=(y1,y2)=>{const g=cx.createLinearGradient(0,y1,0,y2);g.addColorStop(0,lightCol);g.addColorStop(0.5,baseCol);g.addColorStop(1,baseCol);return g;};
  if(hairId===0){
    // KRĂ“TKA â€” czysta kopuĹ‚a z naturalnym frontem (grzywkÄ… po jednej stronie)
    cx.fillStyle=_hairGrad(py-34,py-2);
    cx.beginPath();
    cx.moveTo(px-26,py-3);
    cx.bezierCurveTo(px-32,py-18, px-22,py-34, px,py-34);
    cx.bezierCurveTo(px+22,py-34, px+32,py-18, px+26,py-3);
    cx.quadraticCurveTo(px+22,py-5, px+18,py-4);
    cx.quadraticCurveTo(px+8,py+2, px-2,py-3);     // przedziaĹ‚ grzywki po prawej
    cx.quadraticCurveTo(px-12,py-7, px-22,py-4);
    cx.quadraticCurveTo(px-25,py-3, px-26,py-3);
    cx.closePath();cx.fill();
    // Highlight wzdĹ‚uĹĽ czubka
    cx.fillStyle='rgba(255,200,140,.18)';
    cx.beginPath();cx.ellipse(px-2,py-26,16,4,-.1,0,Math.PI*2);cx.fill();
  } else if(hairId===1){
    // DĹUGA â€” czysta sylwetka opadajÄ…ca do ramion z gĹ‚adkimi falami
    cx.fillStyle=_hairGrad(py-34,py+30);
    cx.beginPath();
    cx.moveTo(px-28,py+30);                                     // dolny lewy
    cx.bezierCurveTo(px-34,py+10, px-32,py-12, px-26,py-26);    // lewy Ĺ‚uk
    cx.bezierCurveTo(px-18,py-34, px+18,py-34, px+26,py-26);    // czubek
    cx.bezierCurveTo(px+32,py-12, px+34,py+10, px+28,py+30);    // prawy Ĺ‚uk
    cx.bezierCurveTo(px+22,py+32, px+18,py+28, px+15,py+18);    // prawy bok wewnÄ…trz (do twarzy)
    cx.bezierCurveTo(px+22,py+4, px+22,py-8, px,py-10);         // wyciÄ™cie przy czole
    cx.bezierCurveTo(px-22,py-8, px-22,py+4, px-15,py+18);
    cx.bezierCurveTo(px-18,py+28, px-22,py+32, px-28,py+30);
    cx.closePath();cx.fill();
    // Subtelny highlight wzdĹ‚uĹĽ linii fali
    cx.fillStyle='rgba(255,200,140,.12)';
    cx.beginPath();cx.ellipse(px-18,py+4,3,18,-.2,0,Math.PI*2);cx.fill();
    cx.beginPath();cx.ellipse(px+18,py+4,3,18,.2,0,Math.PI*2);cx.fill();
  } else if(hairId===2){
    // v1.9.7: DREDY â€” styl jak w kreatorze postaci. Proste pionowe pasma z jasnym koĹ„cem (tan).
    // Czapka â€” rectangle + arc top (jak KrĂłtka, ale ciemniejsza)
    const capCol='#221206';
    const tipCol='#c8a060'; // ten sam jasny tan co w kreatorze
    cx.fillStyle=capCol;
    cx.fillRect(px-22,py-22,44,12);
    cx.beginPath();cx.arc(px,py-22,22,Math.PI,0);cx.fill();
    // 9 pionowych pasm wzdĹ‚uĹĽ caĹ‚ej szerokoĹ›ci czapki
    for(let i=0;i<9;i++){
      const dx=px-22+i*5.5+0.75;
      const dl=30+(i%3)*5; // 30, 35, 40 px varying
      // Ciemna czÄ™Ĺ›Ä‡ pasma (top 72%)
      cx.fillStyle=capCol;
      cx.fillRect(dx,py-10,4,dl*0.72);
      // Jasna koĹ„cĂłwka (bottom 28%) â€” tak jak w kreatorze
      cx.fillStyle=tipCol;
      cx.fillRect(dx,py-10+dl*0.72,4,dl*0.28);
      // Subtelny zaokrÄ…glony dĂłĹ‚ (maĹ‚a kropka)
      cx.beginPath();cx.arc(dx+2,py-10+dl,2,0,Math.PI*2);cx.fill();
    }
    // Subtelne ciemne linie miÄ™dzy pasmami (sugestia przedziaĹ‚kĂłw)
    cx.fillStyle='rgba(0,0,0,.35)';
    for(let i=1;i<9;i++){
      const dx=px-22+i*5.5;
      cx.fillRect(dx-0.5,py-10,1,4);
    }
  } else if(hairId===3){
    // ĹYSY â€” subtelny poĹ‚ysk na czaszce + cieĹ„ przy uszach (definicja)
    cx.fillStyle='rgba(255,255,255,.07)';cx.beginPath();cx.ellipse(px-4,py-14,14,5,-.25,0,Math.PI*2);cx.fill();
    cx.fillStyle='rgba(0,0,0,.12)';cx.beginPath();cx.ellipse(px,py+2,28,5,0,0,Math.PI*2);cx.fill();
  } else if(hairId===4){
    // v1.9.7: AFRO â€” duĹĽa pufa NA GĂ“RZE gĹ‚owy, NIE zasĹ‚ania oczu
    // Pozycja: centrum py-25 (powyĹĽej linii oczu), promieĹ„ max 30 (bottom przy py-5, tuĹĽ nad oczami py)
    const ag=cx.createRadialGradient(px-6,py-38,4,px,py-25,30);
    ag.addColorStop(0,lightCol);
    ag.addColorStop(0.65,baseCol);
    ag.addColorStop(1,'#0a0402');
    cx.fillStyle=ag;
    cx.beginPath();cx.ellipse(px,py-24,30,22,0,0,Math.PI*2);cx.fill();
    // KrawÄ™dĹş dolna (gdzie afro spotyka czoĹ‚o) â€” delikatny cieĹ„
    cx.fillStyle='rgba(0,0,0,.2)';
    cx.beginPath();cx.ellipse(px,py-4,22,3,0,0,Math.PI*2);cx.fill();
    // Tekstura â€” 3 subtelne fale kÄ™dzierzawych wĹ‚osĂłw na gĂłrze (zamiast bÄ…bli)
    cx.fillStyle='rgba(0,0,0,.2)';
    cx.beginPath();cx.arc(px-12,py-32,4,Math.PI,0);cx.fill();
    cx.beginPath();cx.arc(px,py-38,5,Math.PI,0);cx.fill();
    cx.beginPath();cx.arc(px+12,py-32,4,Math.PI,0);cx.fill();
    // Subtelny highlight u gĂłry
    cx.fillStyle='rgba(255,200,140,.18)';
    cx.beginPath();cx.ellipse(px-4,py-36,10,3,-.2,0,Math.PI*2);cx.fill();
  } else if(hairId===5){
    // IROKEZ â€” czyste, smukĹ‚e pasmo z gĹ‚adkim profilem, boki golone (ciemny cieĹ„)
    // Boki â€” subtelny cieĹ„ ogolonych wĹ‚osĂłw
    cx.fillStyle='rgba(0,0,0,.22)';
    cx.beginPath();cx.ellipse(px,py-6,26,20,0,Math.PI,Math.PI*2);cx.fill();
    // Linia fade po bokach
    cx.fillStyle='rgba(20,10,5,.35)';
    cx.beginPath();cx.ellipse(px,py-2,24,4,0,0,Math.PI*2);cx.fill();
    // Ĺšrodkowy mohawk â€” wysoki, gĹ‚adki bezier
    const mg=cx.createLinearGradient(0,py-38,0,py);
    mg.addColorStop(0,lightCol);mg.addColorStop(1,baseCol);
    cx.fillStyle=mg;
    cx.beginPath();
    cx.moveTo(px-9,py);
    cx.bezierCurveTo(px-11,py-22, px-10,py-36, px-2,py-38);
    cx.lineTo(px+2,py-38);
    cx.bezierCurveTo(px+10,py-36, px+11,py-22, px+9,py);
    cx.closePath();cx.fill();
    // Highlight wzdĹ‚uĹĽ lewej krawÄ™dzi mohawk
    cx.fillStyle='rgba(255,180,100,.22)';
    cx.beginPath();
    cx.moveTo(px-7,py-2);
    cx.bezierCurveTo(px-9,py-22, px-8,py-34, px-3,py-36);
    cx.lineTo(px-2,py-34);
    cx.bezierCurveTo(px-6,py-22, px-7,py-4, px-5,py-2);
    cx.closePath();cx.fill();
  } else if(hairId===6){
    // BOKSER (buzz) â€” bardzo krĂłtka uniform, gradient czaszki + linia fade (bez kropek)
    cx.fillStyle=_hairGrad(py-26,py-2);
    cx.beginPath();
    cx.moveTo(px-25,py-2);
    cx.bezierCurveTo(px-30,py-16, px-22,py-26, px,py-26);
    cx.bezierCurveTo(px+22,py-26, px+30,py-16, px+25,py-2);
    cx.closePath();cx.fill();
    // Linia fade (klasyczna dla buzz)
    cx.fillStyle='rgba(255,255,255,.08)';
    cx.beginPath();cx.ellipse(px-2,py-20,12,3,-.15,0,Math.PI*2);cx.fill();
    // Subtelny cieĹ„ przy hairline
    cx.fillStyle='rgba(0,0,0,.18)';
    cx.beginPath();cx.ellipse(px,py-3,25,2,0,0,Math.PI*2);cx.fill();
  } else if(hairId===7){
    // LOCZKI â€” Ĺ›redniej dĹ‚ugoĹ›ci kÄ™dzierzawe z gĹ‚adkÄ… "obĹ‚okowÄ…" sylwetkÄ…
    cx.fillStyle=_hairGrad(py-32,py+8);
    // Kontur loczkĂłw â€” falisty bezier (jak obĹ‚ok)
    cx.beginPath();
    cx.moveTo(px-26,py+4);
    cx.bezierCurveTo(px-32,py-8,  px-30,py-22, px-22,py-26);
    cx.bezierCurveTo(px-18,py-32, px-8,py-34,  px,py-32);
    cx.bezierCurveTo(px+8,py-34,  px+18,py-32, px+22,py-26);
    cx.bezierCurveTo(px+30,py-22, px+32,py-8,  px+26,py+4);
    cx.bezierCurveTo(px+22,py+10, px+18,py+6,  px+14,py-2);
    cx.bezierCurveTo(px+8,py-2,   px-8,py-2,   px-14,py-2);
    cx.bezierCurveTo(px-18,py+6,  px-22,py+10, px-26,py+4);
    cx.closePath();cx.fill();
    // 3 dyskretne "fale" loczkĂłw (zamiast 12 bÄ…bli)
    cx.fillStyle='rgba(0,0,0,.22)';
    cx.beginPath();cx.arc(px-14,py-22,5,Math.PI,0,false);cx.fill();
    cx.beginPath();cx.arc(px,py-26,5,Math.PI,0,false);cx.fill();
    cx.beginPath();cx.arc(px+14,py-22,5,Math.PI,0,false);cx.fill();
    // Highlight
    cx.fillStyle='rgba(255,180,100,.18)';
    cx.beginPath();cx.ellipse(px-6,py-24,10,3,-.2,0,Math.PI*2);cx.fill();
  } else if(hairId===8){
    // v1.9.7: QUIFF â€” KOMPLETNY REDESIGN. Klasyczny pomp z asymetrycznym sweep + ostre linie bokĂłw (fade)
    // Boki â€” niskie, "fade" wyciÄ™ty pod uchem (zamiast bulgi)
    cx.fillStyle=_hairGrad(py-14,py-2);
    cx.beginPath();
    cx.moveTo(px-22,py-2);
    cx.lineTo(px-22,py-10);
    cx.quadraticCurveTo(px-22,py-14, px-16,py-14);   // ostry Ĺ‚uk lewy
    cx.lineTo(px+16,py-14);
    cx.quadraticCurveTo(px+22,py-14, px+22,py-10);   // ostry Ĺ‚uk prawy
    cx.lineTo(px+22,py-2);
    cx.closePath();cx.fill();
    // Pomp â€” wysoka, ASYMETRYCZNA fala (peak lekko po lewej, sweep do prawej tyĹ‚u)
    cx.fillStyle=_hairGrad(py-36,py-14);
    cx.beginPath();
    cx.moveTo(px-16,py-14);
    cx.lineTo(px-15,py-26);                                  // prawie pionowy lewy bok
    cx.quadraticCurveTo(px-12,py-36, px-2,py-36);            // peak po lewej (najwyĹĽszy punkt)
    cx.bezierCurveTo(px+8,py-36, px+14,py-30, px+16,py-22);  // gĹ‚adki sweep do prawej tyĹ‚u
    cx.lineTo(px+16,py-14);
    cx.closePath();cx.fill();
    // Tekstura pasm wzdĹ‚uĹĽ quiffu â€” pokazuje ĹĽe to gĹ‚adko zaczesane
    cx.strokeStyle='rgba(0,0,0,.35)';cx.lineWidth=0.8;
    for(let i=0;i<5;i++){
      cx.beginPath();
      cx.moveTo(px-14+i*7,py-14);
      cx.bezierCurveTo(px-13+i*6, py-24, px-6+i*5, py-32, px-2+i*4, py-34);
      cx.stroke();
    }
    // PoĹ‚ysk ĹĽelu wzdĹ‚uĹĽ peaku
    cx.fillStyle='rgba(255,200,140,.32)';
    cx.beginPath();
    cx.moveTo(px-12,py-28);
    cx.bezierCurveTo(px-10,py-34, px-2,py-35, px+4,py-33);
    cx.lineTo(px+2,py-30);
    cx.bezierCurveTo(px-6,py-30, px-10,py-26, px-12,py-28);
    cx.closePath();cx.fill();
    // CieĹ„ ostrego fade'u (pod uchem)
    cx.fillStyle='rgba(0,0,0,.25)';
    cx.fillRect(px-22,py-3,44,2);
  } else if(hairId===9){
    // v1.9.8: BUZZ â€” bardzo krĂłtki uniform, scalp widoczny, military style
    // CieĹ„ skin (zaciemnione od wĹ‚osĂłw)
    cx.fillStyle='rgba(0,0,0,.35)';
    cx.beginPath();cx.ellipse(px,py-10,24,15,0,Math.PI,Math.PI*2);cx.fill();
    // Equally distributed pattern stubble (dot grid, nie random)
    cx.fillStyle='rgba(60,30,15,.85)';
    for(let row=0;row<5;row++){
      for(let col=0;col<8;col++){
        const sx=px-21+col*6+(row%2)*3;
        const sy=py-22+row*4;
        // Mask within head ellipse
        const dx=(sx-px)/24, dy=(sy-(py-10))/15;
        if(dx*dx+dy*dy<=1.0){
          cx.fillRect(sx,sy,1.4,1.4);
        }
      }
    }
    // Hairline (linia czoĹ‚a)
    cx.fillStyle='rgba(0,0,0,.5)';
    cx.fillRect(px-22,py-3,44,1.5);
    // High fade (przejĹ›cie jaĹ›niejsze przy dolnej krawÄ™dzi)
    cx.fillStyle='rgba(255,255,255,.06)';
    cx.fillRect(px-22,py-1,44,1);
  }
  // â”€â”€ FACE FEATURES (po wĹ‚osach ĹĽeby zawsze widoczne) â”€â”€
  // Oczy
  cx.fillStyle='rgba(255,255,255,.9)';cx.beginPath();cx.arc(px-9,py,4,0,Math.PI*2);cx.fill();
  cx.beginPath();cx.arc(px+9,py,4,0,Math.PI*2);cx.fill();
  cx.fillStyle='#1a1a2a';cx.beginPath();cx.arc(px-9,py,2.4,0,Math.PI*2);cx.fill();
  cx.beginPath();cx.arc(px+9,py,2.4,0,Math.PI*2);cx.fill();
  // Highlight w oczach
  cx.fillStyle='rgba(255,255,255,.9)';
  cx.beginPath();cx.arc(px-9.6,py-0.6,0.8,0,Math.PI*2);cx.fill();
  cx.beginPath();cx.arc(px+8.4,py-0.6,0.8,0,Math.PI*2);cx.fill();
  // Usta
  cx.strokeStyle='#8a5040';cx.lineWidth=2;cx.beginPath();cx.arc(px,py+10,6,0.2,Math.PI-0.2);cx.stroke();
  const lblEl=document.getElementById('barber-preview-lbl');
  if(lblEl)lblEl.textContent=lbl;
};

function renderHospital(){
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŹĄ Szpital</h2><p class="sub">Wylecz swoje zdrowie za pieniÄ…dze.</p>
    <div style="margin-bottom:20px">
      <p style="color:#aaa;font-size:17px;margin-bottom:8px">Aktualne zdrowie: <strong style="color:#e74c3c">${Math.floor(G.health||0)}/${typeof getMaxStat==='function'?getMaxStat('health'):100}</strong></p>
      <p style="color:#667;font-size:14px">Koszt peĹ‚nego leczenia: ${Math.floor((100-G.health)*8)} zĹ‚</p>
    </div>
    <div class="shopgrid">
      <div class="sitem"><h3>đź’Š Leczenie podstawowe</h3><p>+30 zdrowie</p><div class="pr">${Math.floor((100-G.health)*3)} zĹ‚</div><button class="bbtn" onclick="heal(30)" ${G.health>=100||G.money<Math.floor((100-G.health)*3)?'disabled':''}>Lecz</button></div>
      <div class="sitem"><h3>đźŹĄ PeĹ‚ne leczenie</h3><p>Zdrowie 100%</p><div class="pr">${Math.floor((100-G.health)*8)} zĹ‚</div><button class="bbtn" onclick="heal(100)" ${G.health>=100||G.money<Math.floor((100-G.health)*8)?'disabled':''}>PeĹ‚ne leczenie</button></div>
      <div class="sitem"><h3>đź§ Terapia psychologiczna</h3><p>+50 nastrĂłj (regeneracja zmÄ™czonego umysĹ‚u)</p><div class="pr">200 zĹ‚</div><button class="bbtn" onclick="therapy()" ${G.money<200?'disabled':''}>Terapia</button></div>
    </div>
    <div class="res" id="shop-res">${G.health>=100?'JesteĹ› zdrowy!':'Wybierz leczenie.'}</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}

function renderRestauracja(){
  const MENU=[
    {name:'Burgery z frytkami',emoji:'đźŤ”',hunger:70,energy:10,health:2,price:35},
    {name:'Zestaw obiadowy',emoji:'đźŤ±',hunger:90,energy:20,health:8,price:60},
    {name:'Spaghetti',emoji:'đźŤť',hunger:80,energy:15,health:5,price:50},
    {name:'SaĹ‚atka',emoji:'đźĄ—',hunger:40,energy:5,health:15,price:25},
    {name:'RosĂłĹ‚',emoji:'đźŤ˛',hunger:50,energy:10,health:20,price:40},
    // Pizza usuniÄ™ta â€” jest teraz tylko w Pizzerii (osobny budynek)
  ];
  let html=`<h2>đźŤ˝ Restauracja</h2><p class="sub">Zjedz peĹ‚ny posiĹ‚ek lub pracuj na zmywaku.</p>
  <div class="shopgrid">`;
  MENU.forEach((item,i)=>{
    const canBuy=G.money>=item.price;
    html+=`<div class="sitem">
      <h3>${item.emoji} ${item.name}</h3>
      <p>+${item.hunger} gĹ‚Ăłd Â· +${item.health} zdrowie</p>
      <div class="pr">${item.price} zĹ‚</div>
      <button class="bbtn" ${canBuy?'':`disabled`} onclick="buyRestaurantFood(${i})">ZamĂłw</button>
    </div>`;
  });
  html+=`</div>
  <div class="res" id="rest-res"></div>
  <div style="margin-top:14px;border-top:1px solid #1a2535;padding-top:12px">
    <h3 style="color:#1abc9c;margin-bottom:8px">đź’Ľ Praca</h3>
    <button class="dbtn" onclick="closeOverlay();startZmywakMG()">đź§˝ Pracuj na zmywaku</button>
  </div>
  <button class="cbtn" style="margin-top:14px" onclick="closeOverlay()">â† WrĂłÄ‡</button>`;
  document.getElementById('ov-content').innerHTML=html;
  window.buyRestaurantFood=(i)=>{
    const item=MENU[i];const _p=applyShopDiscount(item.price); // F3-FIX: negocjacje
    if(G.money<_p)return;
    G.money-=_p;
    G.hunger=eatFood(item.hunger);
    G.health=clampStat('health', G.health+item.health);
    G.energy=clampStat('energy', G.energy+item.energy);
    /* v2.1.26: XP przywrĂłcone z capem (1Ă— na minutÄ™ real + tylko gdy gracz NIE przejedzony) */
    addXPFoodCapped(3);
    updateHUD();
    document.getElementById('rest-res').textContent=`âś… ZamĂłwiono: ${item.emoji} ${item.name}!`;
    renderRestauracja();
  };
}

// Pizzeria â€” dziaĹ‚a jak Restauracja: moĹĽna jeĹ›Ä‡ (rĂłĹĽne pizze) lub pracowaÄ‡ (kucharz pizzy)
function renderPizzeria(){
  const PIZZAS=[
    {name:'Margherita',     emoji:'đźŤ•', desc:'Sos pomidorowy, mozzarella, bazylia',  hunger:50,energy:5, mood:0, health:0, price:25},
    {name:'Pepperoni',      emoji:'đźŤ•', desc:'Pikantne pepperoni, podwĂłjny ser',     hunger:60,energy:8, mood:0, health:0, price:30},
    {name:'Hawajska',       emoji:'đźŤ•', desc:'Szynka, ananas, ser â€” kontrowersja',   hunger:55,energy:10,mood:5, health:2, price:32},
    {name:'Capricciosa',    emoji:'đźŤ•', desc:'Szynka, pieczarki, oliwki, karczochy', hunger:60,energy:10,mood:0, health:5, price:35},
    {name:'Quattro Formaggi',emoji:'đźŤ•',desc:'Cztery sery â€” najedzona uczta',         hunger:70,energy:12,mood:0, health:0, price:40},
    {name:'Salami',         emoji:'đźŤ•', desc:'Klasyka â€” salami i ser',                hunger:55,energy:7, mood:0, health:0, price:28},
    {name:'Diavola',        emoji:'đźŚ¶ď¸Ź',desc:'Ostra papryczka, salami, +nastrĂłj',    hunger:60,energy:8, mood:8, health:0, price:33},
    {name:'Funghi',         emoji:'đźŤ„', desc:'Pieczarki, ser, Ĺ›wieĹĽe zioĹ‚a',          hunger:55,energy:6, mood:3, health:5, price:30},
  ];
  let html=`<h2>đźŤ• Pizzeria</h2><p class="sub">Zjedz pizzÄ™ lub pracuj jako kucharz.</p>
  <div class="shopgrid">`;
  PIZZAS.forEach((item,i)=>{
    const canBuy=G.money>=item.price;
    const effects=[`+${item.hunger} gĹ‚Ăłd`];
    if(item.energy)effects.push(`+${item.energy} energia`);
    if(item.health)effects.push(`+${item.health} zdrowie`);
    if(item.mood)effects.push(`+${item.mood} nastrĂłj`);
    html+=`<div class="sitem">
      <h3>${item.emoji} ${item.name}</h3>
      <p style="font-size:11px;color:#778;margin-bottom:4px">${item.desc}</p>
      <p style="color:#7ec87e;font-size:11px;margin-bottom:6px">${effects.join(' Â· ')}</p>
      <div class="pr">${item.price} zĹ‚</div>
      <button class="bbtn" ${canBuy?'':`disabled`} onclick="buyPizzeriaPizza(${i})">ZamĂłw</button>
    </div>`;
  });
  html+=`</div>
  <div class="res" id="pizz-res"></div>
  <div style="margin-top:14px;border-top:1px solid #1a2535;padding-top:12px">
    <h3 style="color:#e67e22;margin-bottom:8px">đź’Ľ Praca</h3>
    <button class="dbtn" onclick="closeOverlay();openJobOverlay('pizza')">đźŤ• Pracuj jako kucharz pizzy</button>
  </div>
  <button class="cbtn" style="margin-top:14px" onclick="closeOverlay()">â† WrĂłÄ‡</button>`;
  document.getElementById('ov-content').innerHTML=html;
  window.buyPizzeriaPizza=(i)=>{
    const item=PIZZAS[i];const _p=applyShopDiscount(item.price); // F3-FIX: negocjacje
    if(G.money<_p)return;
    G.money-=_p;
    G.hunger=eatFood(item.hunger);
    if(item.energy) G.energy=clampStat('energy', G.energy+item.energy);
    if(item.health) G.health=clampStat('health', G.health+item.health);
    if(item.mood) G.stress=clamp(G.stress+item.mood,0,100); // nastrĂłj â†‘ = G.stress â†‘
    /* v2.1.26: XP przywrĂłcone z capem */
    addXPFoodCapped(3);
    progressQuest('eat');updateHUD();
    document.getElementById('pizz-res').textContent=`âś… ZamĂłwiono: ${item.emoji} ${item.name}!`;
    renderPizzeria();
  };
}

// Salon samochodowy
function renderSalon(){
  // #17 NERF: prÄ™dkoĹ›ci aut zmniejszone (Bugatti byĹ‚o 4Ă— = absurd; v2.1.192: 2.25Ă— â†’ 2.20Ă— = rozsÄ…dne)
  /* v2.1.51 Amper: salon â€” wszystkie auta bez wymogĂłw (tylko cena), oprĂłcz dwĂłch ikon: Ferrari i Bugatti Chiron zachowujÄ… wymogi prestiĹĽowe. */
  const cars=[
    {name:'Maluch',speed:1.15,price:3000,desc:'Stare ale jedzie. +15% prÄ™dkoĹ›Ä‡.',emoji:'đźš—', req:{}},
    {name:'Seat Ibiza',speed:1.25,price:8000,desc:'Solidny miejski wĂłz. +25% prÄ™dkoĹ›Ä‡.',emoji:'đźš™', req:{}},
    {name:'BMW E46',speed:1.40,price:25000,desc:'PrestiĹĽ i szybkoĹ›Ä‡. +40% prÄ™dkoĹ›Ä‡. +5 sĹ‚awa.',emoji:'đźŹŽď¸Ź', req:{}},
    {name:'Audi RS6',speed:1.55,price:80000,desc:'Niemiecka rakieta. +55% prÄ™dkoĹ›Ä‡. +10 sĹ‚awa.',emoji:'đźŹ', req:{}},
    /* v2.1.148: Tesla Model S Plaid â€” eco luxury miÄ™dzy Audi a Porsche */
    {name:'Tesla Model S Plaid',speed:1.65,price:120000,desc:'Elektryczna rakieta. +65% prÄ™dkoĹ›Ä‡. +12 sĹ‚awa. Eco vibe.',emoji:'âšˇ', req:{}},
    {name:'Porsche 911',speed:1.70,price:150000,desc:'Klasyk Stuttgart. +70% prÄ™dkoĹ›Ä‡. +15 sĹ‚awa.',emoji:'đźŹŽ', req:{}},
    {name:'Lamborghini',speed:1.85,price:300000,desc:'Italiana ekstrawagancja. +85% prÄ™dkoĹ›Ä‡. +25 sĹ‚awa.',emoji:'đźŹŽď¸Ź', req:{}},
    {name:'Ferrari',speed:2.00,price:450000,desc:'Cavallino Rampante. Ă—2 prÄ™dkoĹ›Ä‡. +30 sĹ‚awa.',emoji:'đźŽ', req:{level:12,fame:65,fans:50000}},
    /* v2.1.148: Rolls-Royce Phantom â€” luxury limuzyna dla Prestige+ graczy */
    {name:'Rolls-Royce Phantom',speed:1.90,price:700000,desc:'Brytyjska elegancja. Ă—1.9 prÄ™dkoĹ›Ä‡. +40 sĹ‚awa. Status na ulicy.',emoji:'đź‘‘', req:{level:14,fame:75,fans:75000}},
    {name:'Bugatti Chiron',speed:2.20,price:1200000,desc:'HipersamochĂłd najwyĹĽszej klasy. Ă—2.20 prÄ™dkoĹ›Ä‡. +50 sĹ‚awa.',emoji:'âšˇ', req:{level:15,fame:80,fans:100000}},
  ];
  const carPalette=[
    {name:'Czerwony',c:'#c0392b'},{name:'Niebieski',c:'#2471a3'},{name:'Czarny',c:'#1c2833'},
    {name:'BiaĹ‚y',c:'#d5d8dc'},{name:'Szary',c:'#707b7c'},{name:'Zielony',c:'#1e8449'},
    {name:'Ĺ»ĂłĹ‚ty',c:'#d4ac0d'},{name:'PomaraĹ„czowy',c:'#d35400'},{name:'Fioletowy',c:'#6c3483'},
  ];
  const carDefC={'Maluch':'#c0392b','Seat Ibiza':'#2471a3','BMW E46':'#1c2833'};
  const curColor=G.car?(G.car.color||(carDefC[G.car.name]||'#c0392b')):'#c0392b';
  document.getElementById('ov-content').innerHTML=`
    <h2>đźš— Salon Samochodowy</h2>
    <p class="sub">SamochĂłd zwiÄ™ksza prÄ™dkoĹ›Ä‡ poruszania i prestiĹĽ. Szybszy samochĂłd = szybsze dostawy w pracy Kuriera!</p>
    <div style="background:#0e1830;border-left:3px solid #f1c40f;padding:8px 12px;margin-bottom:12px;border-radius:4px;font-size:13px;color:#cdd">
      đź’ˇ <b>Sterowanie:</b> na ulicy naciĹ›nij klawisz <kbd style="background:#1a2845;border:1px solid #f1c40f;color:#f1c40f;padding:1px 6px;border-radius:3px;font-family:monospace">V</kbd> aby <b>wsiÄ…Ĺ›Ä‡ / wysiÄ…Ĺ›Ä‡</b> z auta.
    </div>
    <p style="color:#667;font-size:14px;margin-bottom:12px">Aktualnie: ${G.car?'đźš— '+G.car.name+' <span style="display:inline-block;width:14px;height:14px;background:'+G.car.color+';border-radius:3px;vertical-align:middle;margin-left:4px"></span>':'Brak samochodu (poruszasz siÄ™ pieszo)'}</p>
    ${G.car?`<div style="background:#0a1220;border-radius:10px;padding:12px;margin-bottom:14px">
      <div style="font-size:13px;color:#aaa;margin-bottom:8px">đźŽ¨ Kolor lakieru (bezpĹ‚atna zmiana):</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">${carPalette.map(p=>`<button onclick="window.setCarColor('${p.c}')" title="${p.name}" style="width:32px;height:32px;background:${p.c};border-radius:50%;border:${curColor===p.c?'3px solid #fff':'2px solid #333'};cursor:pointer"></button>`).join('')}</div>
    </div>`:''}
    <div class="shopgrid">
      ${cars.map(car=>{
        const r=car.req||{};
        const reqOk=(!r.level||G.level>=r.level)&&(!r.fame||(G.fame||0)>=r.fame)&&(!r.fans||(G.fans||0)>=r.fans);
        const reqStr=[];
        if(r.level) reqStr.push(`lvl ${r.level}${G.level>=r.level?'âś“':'âťŚ'}`);
        if(r.fame) reqStr.push(`${r.fame} sĹ‚awy${(G.fame||0)>=r.fame?'âś“':'âťŚ'}`);
        if(r.fans) reqStr.push(`${r.fans.toLocaleString('pl')} fanĂłw${(G.fans||0)>=r.fans?'âś“':'âťŚ'}`);
        const owned=(G._ownedCars||[]).includes(car.name);
        const isCurrent=G.car&&G.car.name===car.name;
        return `<div class="sitem"><h3>${car.emoji} ${car.name}</h3><p>${car.desc}</p>
          ${reqStr.length?`<p style="font-size:11px;color:${reqOk?'#7ec87e':'#e74c3c'};margin-bottom:6px">đź“‹ ${reqStr.join(' Â· ')}</p>`:''}
          <div class="pr">${car.price.toLocaleString('pl')} zĹ‚</div>
          ${isCurrent?'<div class="owned">âś… Aktualny</div>':owned?'<div style="color:#c8a520;font-size:11px">đź“¦ W garaĹĽu</div>':''}
          <button class="bbtn" onclick="buyCar('${car.name}',${car.speed},${car.price})" ${isCurrent||!reqOk||G.money<car.price?'disabled':''}>${isCurrent?'Aktualne':owned?'PrzesiÄ…dĹş siÄ™':'Kup'}</button></div>`;
      }).join('')}
    </div>
    <div class="res" id="shop-res">Wybierz samochĂłd.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}
window.setCarColor=(col)=>{if(G.car){G.car.color=col;notify('đźŽ¨ Lakier zmieniony!');renderSalon();};};

// Sala Koncertowa
function renderSalaKoncertowa(){
  const scena=getRaperST('scena');
  /* v2.1.37 [Amper]: koncerty wymagajÄ… fanĂłw lojalnych (G.fans), nie obserwujÄ…cych */
  const totalFans=(G.fans||0);
  // v1.8.18: MaĹ‚a Scena fansReq 100â†’30 (pierwsze doĹ›wiadczenie powinno byÄ‡ dostÄ™pne wczeĹ›nie),
  // Klub 500â†’300, Arena 2000â†’1500 (nadal gated, ale spĂłjne z nowÄ… niĹĽszÄ… derivacjÄ… fanĂłw z followersĂłw).
  /* v2.1.50 Amper: NERF zarobkĂłw koncertowych ~55%. WczeĹ›niej Arena 5-15k przy 4000 sĹ‚uchaczy dawaĹ‚a 13k+ z mnoĹĽnikami â€” niespĂłjne z rozwojem gracza. Nowe ranges + standardowe mnoĹĽniki (fame/follower/scena/drip/friendship) skalujÄ… rozsÄ…dnie. */
  const venues=[
    {name:'MaĹ‚a Scena',cost:500,fameReq:10,scenaReq:1,fansReq:30,earnMin:200,earnMax:700,desc:'Max 200 osĂłb. Pierwsze doĹ›wiadczenie.'},
    {name:'Klub Muzyczny',cost:1500,fameReq:25,scenaReq:2,fansReq:300,earnMin:700,earnMax:2200,desc:'Do 1000 osĂłb. Prawdziwa impreza.'},
    {name:'Arena',cost:5000,fameReq:55,scenaReq:4,fansReq:1500,earnMin:2500,earnMax:7000,desc:'TysiÄ…ce fanĂłw. Legendarny koncert.'},
  ];
  /* v2.1.90 Amper: licznik koncertĂłw dziĹ› + payout info (1:100% / 2:50% / 3:75% / 4+:BLOKADA). */
  const _todayConc = (G._concertsCounter && G._concertsCounter.day === G.day) ? G._concertsCounter.count : 0;
  const _todayPayout = _todayConc===0?'100%':_todayConc===1?'50%':_todayConc===2?'75%':'BLOKADA';
  const _todayColor = _todayConc===0?'#27ae60':_todayConc<3?'#f39c12':'#e74c3c';
  /* v2.1.112: S3/S4 â€” pokazuj aktywne bonusy holiday/festival/outfit ĹĽeby gracz wiedziaĹ‚ co stackuje przed koncertem. */
  const _bonusChips=[];
  if(G.activeHoliday){
    const _h=G.activeHoliday;
    if(_h.id==='sylwester') _bonusChips.push('đźŽ† Sylwester: koncerty Ă—2.0 + 100 fanĂłw');
    else if(_h.id==='majowka') _bonusChips.push('đźŚ· MajĂłwka: koncerty Ă—1.5');
  }
  if(G.activeFestival && G.activeFestival.effect){
    if(G.activeFestival.effect.concertFameMult) _bonusChips.push(`đźŽµ ${G.activeFestival.name||'Festiwal'}: sĹ‚awa koncertu Ă—${G.activeFestival.effect.concertFameMult}`);
  }
  const _outfitMap={music:'+5%',designer_concert:'+15%',smoking:'+10%',suit:'+5%',sport:'+3%',sport_pro:'+5%',luxury:'+12%',zimowa:'+2%',jeansowa:'+4%',tracksuit:'+2%',leather_jacket:'+6%',designer_hoodie:'+8%'}; /* v2.1.148 hotfix: 3 nowe outfity concert mult tooltip */
  const _outfit=G.outfit?.top;
  if(_outfit && _outfitMap[_outfit]) _bonusChips.push(`đź‘• Outfit ${_outfit}: ${_outfitMap[_outfit]} zarobkĂłw`);
  if(scena>=2) _bonusChips.push(`đźŽ­ Scena ${scena}: koncerty ${[null,null,'Ă—1.08','Ă—1.15','Ă—1.25','Ă—1.25'][scena]||'+25%'}`);
  if(G.managementDeal) _bonusChips.push('đź’Ľ Management Kamila: Ă—1.2 zarobkĂłw');
  if(G._repBoost75) _bonusChips.push('đź‘‘ Rep75: +15% fanĂłw koncertu');
  /* v2.1.207 [Amper]: ROZBUDOWANE chipy â€” brakowaĹ‚y: drip, friendship Marcin, prestige, mood, mogul, tour magnate, streak, diamond hands. */
  /* v2.1.210 [Amper]: drip + PU poĹ‚Ä…czone w jeden czytelny chip â€” gracz widzi "Drip 200/200 + PU" zamiast "drip Ă—1.5 effective 300". Liczba dripu ZAWSZE max 200. */
  const _dripBase=(G.drip||0);
  const _hasPU=(typeof getRaperST==='function' && getRaperST('autopromocja')>=4);
  const _dripCapPct=_hasPU?30:20;
  const _dripBonus=Math.min(_dripCapPct,Math.floor((typeof getEffectiveDrip==='function'?getEffectiveDrip():_dripBase)*0.1));
  if(_dripBase>0){
    const _puLabel=_hasPU?' + Ulepszenie "Personal brand"':'';
    _bonusChips.push(`đź’Ž Drip ${_dripBase}/200${_puLabel}: +${_dripBonus}% zarobkĂłw + fanĂłw (cap +${_dripCapPct}%)`);
  }
  const _marcinF=(typeof getFriendshipBonus==='function')?getFriendshipBonus('marcin'):1;
  if(_marcinF>1.05) _bonusChips.push(`đźŽ¤ Marcin friendship: Ă—${Math.min(1.5,_marcinF).toFixed(2)} zarobkĂłw`);
  const _moneyMult=G.prestigeBonus?.moneyMult||1;
  if(_moneyMult>1.0) _bonusChips.push(`â­ Prestige money: Ă—${_moneyMult.toFixed(2)} (rank ${G.prestige||0})`);
  if(typeof getRaperST==='function' && getRaperST('biznes')>=5) _bonusChips.push('đź’Ľ Mogul (Biznes 5): Ă—1.3 zarobkĂłw');
  const _tourMag=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('tour_magnate'):1;
  if(_tourMag>1.0) _bonusChips.push(`đźŚŤ Tour Magnate: Ă—${_tourMag.toFixed(2)} zarobkĂłw`);
  const _diamond=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('diamond_hands'):1;
  if(_diamond>1.0) _bonusChips.push(`đź’Ž Diamond Hands: Ă—${_diamond.toFixed(2)} zarobkĂłw`);
  const _streak=(typeof streakBonusMult==='function')?streakBonusMult():1;
  if(_streak>1.0) _bonusChips.push(`đź”Ą Login streak: Ă—${_streak.toFixed(2)} zarobkĂłw`);
  const _moodMult=(G.stress||0)>=80?1.10:((G.stress||0)<20?0.95:1);
  if(_moodMult>1.0) _bonusChips.push(`đź„ NastrĂłj wysoki (â‰Ą80): Ă—1.10 zarobkĂłw`);
  else if(_moodMult<1.0) _bonusChips.push(`đźž Niski nastrĂłj (<20): Ă—0.95 zarobkĂłw (debuff)`);
  const _bonusHtml=_bonusChips.length>0?
    `<div style="background:#0a1f10;border:1px solid #27ae60;border-radius:8px;padding:10px 14px;margin-bottom:14px;font-size:12px;color:#7ec87e;line-height:1.6">
      âś¨ <b>AKTYWNE BONUSY KONCERTU:</b><br>${_bonusChips.map(c=>`<span style="display:inline-block;background:#0a3a1a;border:1px solid #1a5a2a;padding:3px 8px;border-radius:4px;margin:2px 4px 2px 0;font-size:11px">${c}</span>`).join('')}
    </div>`:'';
  /* v2.1.204 [Amper]: estimateConcertEarn â€” pokazuje gracza realistic finalny zarobek z aktualnymi mnoĹĽnikami.
     User feedback: UI mĂłwi "2500-7000 zĹ‚" Arena, ale faktyczny payout 50689 zĹ‚. Dodajemy estymacjÄ™. */
  function _estimateConcertEarn(earnMin, earnMax){
    const fame_mult = Math.max(0.3, Math.min(1.0, (G.fame||0)/100)); /* v2.1.213+: clamp 1.0 — UI estimate spójne z faktyczną formułą koncertu (L22686) */
    const follower_mult = Math.min(1.5, Math.max(0.5, (G.followers||0)/10000));
    const venue_mult = earnMax>=15000?1.10:earnMax>=3000?1.05:1.0;
    // Outfit
    const outMap = {music:1.05, designer_concert:1.15, smoking:1.10, suit:1.05, sport:1.03, sport_pro:1.05, luxury:1.12, zimowa:1.02, jeansowa:1.04, tracksuit:1.02, leather_jacket:1.06, designer_hoodie:1.08};
    const outfitMult = outMap[G.outfit?.top] || 1.0;
    // Scena
    const scenaMult = scena>=4?1.25:scena>=3?1.15:scena>=2?1.08:1.0;
    const scenaEnergyMult = (typeof getScenaEnergyBonus==='function')?getScenaEnergyBonus():1.0;
    // Drip â€” v2.1.209: cap +20% bez PU, +30% z PU Personal brand (effective drip Ă— 1.5 max 300)
    const dripV = (typeof getEffectiveDrip==='function')?getEffectiveDrip():(G.drip||0);
    const dripMult = 1 + Math.min(0.30, dripV*0.001);
    // Management
    const mgmtMult = G.managementDeal ? Math.min(1.2, G.managementBonus||1) : 1.0;
    // Holiday
    let holMult = 1.0;
    if(G.activeHoliday){
      if(G.activeHoliday.id==='sylwester') holMult = 2.0;
      else if(G.activeHoliday.id==='majowka') holMult = 1.5;
    }
    // Marcin friendship
    const marcinMult = (typeof getFriendshipBonus==='function')?Math.min(1.5, getFriendshipBonus('marcin')):1.0;
    // Prestige money mult
    const prestigeMult = G.prestigeBonus?.moneyMult || 1.0;
    // Mogul (biznes 5)
    const mogulMult = (typeof getRaperST==='function' && getRaperST('biznes')>=5)?1.3:1.0;
    // Tour Magnate prestige skill
    const tourMagMult = (typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('tour_magnate'):1.0;
    // Mood (stress >=80 / <20)
    const moodMult = (G.stress||0)>=80?1.10:((G.stress||0)<20?0.95:1.0);
    // perfMult â€” assume good play (accuracy 80%, maxCombo 25, hype 80)
    const perfMultLow  = 0.6 * (1+10*0.002) * 1.05;  // weak play
    const perfMultHigh = 0.95* (1+50*0.002) * 1.20;  // strong play
    const baseMult = fame_mult * follower_mult * venue_mult * outfitMult * scenaMult * scenaEnergyMult * dripMult * mgmtMult * holMult * marcinMult * prestigeMult * mogulMult * tourMagMult * moodMult;
    const estLow  = Math.min(100000, Math.floor(earnMin * baseMult * perfMultLow));
    const estHigh = Math.min(100000, Math.floor(earnMax * baseMult * perfMultHigh));
    return {low:estLow, high:estHigh};
  }
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŽ¤ Sala Koncertowa</h2>
    <p class="sub">Wynajmij scenÄ™ i zagraj koncert. Im wiÄ™ksza sĹ‚awa i wiÄ™cej fanĂłw, tym wiÄ™kszy zarobek!</p>
    <p style="color:#667;font-size:14px;margin-bottom:8px">SĹ‚awa: <strong style="color:#9b59b6">${Math.floor(G.fame||0)}/100</strong> Â· Scena: ${scena}/5 Â· Fani: ${totalFans} Â· Koncerty: ${G.events.performed}</p>
    ${_bonusHtml}
    <div style="background:#0a1220;border:1px solid #2a3a4a;border-radius:8px;padding:10px 14px;margin-bottom:14px;font-size:13px;color:#cdd;line-height:1.6">
      đźŽ¤ <b style="color:${_todayColor}">Koncerty dziĹ›: ${_todayConc}/3</b> â€” nastÄ™pny payout: <b style="color:${_todayColor}">${_todayPayout}</b>
      <div style="font-size:11px;color:#8aa;margin-top:4px">Limit: <b>3 koncerty/dzieĹ„</b>. Pierwszy 100%, drugi 50%, trzeci 75% (publicznoĹ›Ä‡ wraca). Po 3 â€” czekaj do jutra.</div>
    </div>
    ${scena<1?`<div style="background:#1a0a0a;border:1px solid #5a1a1a;border-radius:8px;padding:12px;margin-bottom:14px;font-size:13px;color:#e74c3c">đź”’ Odblokuj <strong>Scena 1</strong> w drzewku umiejÄ™tnoĹ›ci rapera ĹĽeby graÄ‡ koncerty!</div>`:''}
    <div class="shopgrid">
      ${venues.map(v=>{
        const blocked=G.fame<v.fameReq||G.money<v.cost||scena<v.scenaReq||totalFans<v.fansReq;
        const lockReason=scena<v.scenaReq?`Scena ${v.scenaReq} wymagane`:totalFans<v.fansReq?`${v.fansReq} fanĂłw wymagane`:'';
        /* v2.1.204 [Amper]: pokaĹĽ gracza estymacja finalnego zarobku z aktywnymi mnoĹĽnikami. */
        const _est=_estimateConcertEarn(v.earnMin, v.earnMax);
        return`<div class="sitem" style="width:200px">
          <h3>đźŽµ ${v.name}</h3>
          <p>${v.desc}</p>
          <p style="color:#667;font-size:11px">SĹ‚awa: ${v.fameReq} Â· Scena: ${v.scenaReq} Â· Fani: ${v.fansReq}</p>
          <div class="pr">Wynajem: ${v.cost} zĹ‚</div>
          <div style="color:#888;font-size:10px;margin-bottom:2px">Baza: ${v.earnMin.toLocaleString('pl')}â€“${v.earnMax.toLocaleString('pl')} zĹ‚</div>
          <div style="color:#27ae60;font-size:12px;font-weight:700;margin-bottom:2px">đź’° TwĂłj szacunek: ${_est.low.toLocaleString('pl')}â€“${_est.high.toLocaleString('pl')} zĹ‚</div>
          <div style="color:#778;font-size:9px;margin-bottom:8px">Niski: sĹ‚aba gra (60% acc, maĹ‚y combo) Â· Wysoki: perfect (100% acc, combo 50+, hype 100)</div>
          ${lockReason?`<div style="color:#e74c3c;font-size:11px;margin-bottom:6px">đź”’ ${lockReason}</div>`:''}
          <button class="bbtn" onclick="performConcert('${v.name}',${v.cost},${v.fameReq},${v.earnMin},${v.earnMax})" ${blocked?'disabled':''}>Zarezerwuj</button>
        </div>`;
      }).join('')}
    </div>
    <div class="res" id="shop-res">Wybierz event.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}

// Biuro NieruchomoĹ›ci
function renderBiuroNieruchomosci(){
  /* v2.1.51 Amper: ceny mieszkaĹ„ podniesione ~3-4Ă— â€” wczeĹ›niej za 60k zĹ‚ gracz miaĹ‚ juĹĽ penthouse co kompletnie nie pasowaĹ‚o do dochodĂłw z koncertĂłw po znerfowaniu. */
  /* v2.1.172: Traphouse usuniÄ™ty z listy â€” jest startowym/bazowym domem, nie wymaga zakupu. */
  const apts=[
    {id:'basic',name:'Mieszkanie Podstawowe',cost:15000,desc:'Czyste, spokojne. Lepszy odpoczynek.',bonusText:'+5% regeneracja energii',req:{level:2}},
    {id:'premium',name:'Apartament Premium',cost:60000,desc:'Przestronne, stylowe. Kuchnia z wyspÄ…, regaĹ‚ z trofeami.',bonusText:'+15% regeneracja energii, +3 nastrĂłj/doba (komfort)',req:{level:4,fans:2000}},
    {id:'luxury',name:'Penthouse Luksusowy',cost:250000,desc:'Najlepsze w mieĹ›cie. Basen, sauna, jacuzzi, ognisko, panorama.',bonusText:'+25% regeneracja energii, +6 nastrĂłj/doba, +15 sĹ‚awa, wszystkie luksusowe udogodnienia',req:{level:7,fans:10000,fame:50}},
    /* v2.1.171: Mansion â€” najwyĹĽszy tier 5, w prestiĹĽowej dzielnicy obok Biura NieruchomoĹ›ci */
    {id:'mansion',name:'Rezydencja',cost:1500000,desc:'Luksusowa rezydencja w prestiĹĽowej dzielnicy miasta. Marmurowa fasada, kolumny joĹ„skie, balkon, prywatne studio.',bonusText:'+40% regen energii, +10 nastrĂłj/doba, +30 sĹ‚awa przy zakupie, prywatne studio (nagrania w peĹ‚nej jakoĹ›ci, bez utraty)',req:{level:15,fans:100000,fame:90}},
    /* v2.1.215 [Amper]: Mega Villa — Tier 3 Legendary apartament. Wymaga posiadania Penthouse i Mansion. */
    {id:'mega_villa',name:'Mega Villa',cost:3000000,desc:'Absolutny szczyt luksusu — mega villa z basenem, kortem tenisowym, prywatnym studio, helipadem. Status absolutnie elitarny.',bonusText:'+50% regen energii, +20 nastrój/doba, +30 sławy przy zakupie, +2 sławy/dzień gry pasywnie (recognized brand)',req:{level:18,fans:300000,fame:250,mustOwnMansion:true,mustOwnPenthouse:true}},
  ];
  function reqMet(req){
    if(req.level && G.level<req.level) return false;
    if(req.fans && (G.fans||0)<req.fans) return false;
    if(req.fame && (G.fame||0)<req.fame) return false;
    /* v2.1.215 [Amper]: Mega Villa wymaga POSIADANIA Penthouse i Mansion (nie tylko zamieszkania) */
    if(req.mustOwnMansion && !(G.apartment==='mansion' || (G._ownedApts||[]).includes('mansion'))) return false;
    if(req.mustOwnPenthouse && !(G.apartment==='luxury' || (G._ownedApts||[]).includes('luxury'))) return false;
    return true;
  }
  function reqText(req){
    const parts=[];
    if(req.level) parts.push(`lvl ${req.level}${G.level<req.level?' ❌':' ✅'}`);
    if(req.fans) parts.push(`${req.fans.toLocaleString('pl')} fanów${(G.fans||0)<req.fans?' ❌':' ✅'}`);
    if(req.fame) parts.push(`${req.fame} sławy${(G.fame||0)<req.fame?' ❌':' ✅'}`);
    /* v2.1.215 [Amper]: Mega Villa wymogi posiadania */
    if(req.mustOwnPenthouse){const _own=G.apartment==='luxury'||(G._ownedApts||[]).includes('luxury');parts.push(`Penthouse posiadany${_own?' ✅':' ❌'}`);}
    if(req.mustOwnMansion){const _own=G.apartment==='mansion'||(G._ownedApts||[]).includes('mansion');parts.push(`Rezydencja posiadana${_own?' ✅':' ❌'}`);}
    return parts.length?parts.join(' · '):'';
  }
  // #71 U Wynajem mieszkaĹ„ â€” pokaĹĽ posiadane (niemieszkalne) mieszkania z opcjÄ… wynajÄ™cia
  if(!G.rentals) G.rentals={};
  const _rentRates={traphouse:25,basic:80,premium:200,luxury:500,mansion:1500,mega_villa:3500}; // v2.1.172: mansion · v2.1.215: Mega Villa 3500 zł/dzień (najwyższy tier rentu)
  const _rentableNames={traphouse:'Traphouse',basic:'Mieszkanie Podstawowe',premium:'Apartament Premium',luxury:'Penthouse Luksusowy',mansion:'Rezydencja',mega_villa:'Mega Villa'};
  const ownedExtras=(G._ownedApts||[]).filter(id=>id!==G.apartment);
  let rentalsHtml='';
  if(ownedExtras.length>0){
    rentalsHtml=`
      <h3 style="color:#f1c40f;margin-top:20px;margin-bottom:8px">đź’° Wynajem posiadanych mieszkaĹ„</h3>
      <p style="color:#888;font-size:12px;margin-bottom:10px">Mieszkania w ktĂłre juĹĽ siÄ™ wprowadziĹ‚eĹ› (a teraz mieszkasz gdzie indziej) moĹĽesz wynajÄ…Ä‡ â€” przynoszÄ… pasywny dochĂłd co dobÄ™.</p>
      <div class="shopgrid">
        ${ownedExtras.map(id=>{
          const rented=G.rentals[id]===true;
          const rate=_rentRates[id]||50;
          const notice=G._rentalNotice?.[id];
          const noticeTxt = notice ? `<p style="color:#f39c12;font-size:11px;margin:4px 0">đź“ť Wypowiedzenie: koniec Dnia ${notice}</p>` : '';
          const buttonTxt = rented ? (notice ? 'âťŚ Cofnij wypowiedzenie' : 'đź“ť Wypowiedz (7 dni)') : 'đź”‘ Wynajmij';
          return `<div class="sitem" style="width:200px;border-color:${rented?(notice?'#f39c12':'#27ae60'):'#5a4020'}">
            <h3>${_rentableNames[id]||id}</h3>
            <p style="color:#aaa;font-size:12px">DochĂłd: <strong style="color:#f1c40f">${rate} zĹ‚/doba</strong></p>
            <p style="color:${rented?'#27ae60':'#888'};font-size:12px;margin:6px 0">${rented?'âś… Aktualnie wynajÄ™te':'â›” Nie wynajÄ™te'}</p>
            ${noticeTxt}
            <button class="bbtn" onclick="window.toggleRental('${id}')">${buttonTxt}</button>
          </div>`;
        }).join('')}
      </div>
    `;
  }
  // F+ 2026-05-12 #73: sekcja rachunkĂłw ZSYNCHRONIZOWANA z G.bills (jeden system zamiast 2)
  if(!G.bills) G.bills={pending:[],history:[],evicted:false};
  const _pendingBills=(G.bills.pending||[]).filter(b=>!b.paid);
  const _billsTotal=_pendingBills.reduce((s,b)=>s+b.amount,0);
  const _maxOverdue=Math.max(0,..._pendingBills.map(b=>Math.max(0,(G.day||1)-(b.dueDay||0))));
  const _billsColor = _billsTotal>0 ? (G.bills.evicted?'#e74c3c':_maxOverdue>=3?'#f39c12':'#7ec8e3') : '#27ae60';
  const _eksmisjaWarning = G.bills.evicted ? '<div style="color:#e74c3c;font-weight:bold;margin-top:4px">đźš¨ EKSMISJA AKTYWNA â€” spĹ‚aÄ‡ aby wrĂłciÄ‡</div>' : _maxOverdue>=4 ? '<div style="color:#e74c3c;font-weight:bold;margin-top:4px">âš ď¸Ź EKSMISJA JUTRO!</div>' : _maxOverdue>=3 ? '<div style="color:#f39c12;margin-top:4px">âš ď¸Ź Eksmisja za 2 dni</div>' : '';
  const _billsHtml=`
    <div style="background:#0a0a14;border:2px solid ${_billsColor};border-radius:8px;padding:14px;margin-bottom:14px">
      <h3 style="color:${_billsColor};margin:0 0 8px 0">đź“§ Rachunki za mieszkanie</h3>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="color:#aaa;font-size:12px">Do zapĹ‚aty (${_pendingBills.length} rachunkĂłw):</div>
          <div style="color:${_billsColor};font-size:22px;font-weight:bold">${_billsTotal.toLocaleString('pl')} zĹ‚</div>
          ${_maxOverdue>0?`<div style="color:#888;font-size:11px">Max zalegĹ‚ych dni: ${_maxOverdue}</div>`:''}
          ${_eksmisjaWarning}
          <div style="color:#778;font-size:10px;margin-top:6px">PeĹ‚ny menedĹĽer rachunkĂłw: Telefon â†’ đź’¸ Rachunki</div>
        </div>
        <button onclick="window.payAllBills();renderBiuroNieruchomosci()" ${_billsTotal<=0||G.money<_billsTotal?'disabled':''} style="background:${_billsTotal>0&&G.money>=_billsTotal?'#27ae60':'#2a2a2a'};color:#fff;border:none;padding:14px 24px;font-size:15px;font-weight:bold;cursor:pointer;border-radius:6px;font-family:inherit">đź’° ZapĹ‚aÄ‡ wszystkie</button>
      </div>
    </div>`;
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŹ  Biuro NieruchomoĹ›ci</h2>
    <p class="sub">Kupuj mieszkania â€” automatycznie zamieszkujesz w najlepszym posiadanym. WiÄ™ksze apartamenty wymagajÄ… wyĹĽszego statusu.</p>
    <p style="color:#667;font-size:14px;margin-bottom:12px">Aktualnie mieszkasz w: <strong style="color:#7ec8e3">${CFG.APT_NAMES[G.apartment]||G.apartment}</strong></p>
    ${_billsHtml}
    <div class="shopgrid">
      ${apts.map(a=>{
        const reqOk=reqMet(a.req);
        const reqStr=reqText(a.req);
        const ownedBefore=(G._ownedApts||[]).includes(a.id);
        const moneyOk=G.money>=a.cost;
        /* v2.1.172: Posiadane mieszkania zawsze 'Posiadane' (no PrzeprowadĹş siÄ™). Auto-best logic obsĹ‚uguje aktywacjÄ™. */
        const disabled=ownedBefore||!reqOk||!moneyOk;
        const priceLabel=ownedBefore?'<span style="color:#7ec87e">âś… Posiadane</span>':a.cost.toLocaleString('pl')+' zĹ‚';
        const btnLabel=ownedBefore?'âś… Posiadane':!reqOk?'Brak wymogĂłw':!moneyOk?'Brak kasy':'đź”‘ Kup';
        const activeMark=(G.apartment===a.id)?'<div class="owned" style="color:#27ae60;font-size:11px;margin-top:4px">đźŹ  Twoje aktualne mieszkanie</div>':'';
        return `<div class="sitem" style="width:200px"><h3>${a.name}</h3><p>${a.desc}</p><p style="color:#27ae60;font-size:11px;margin-bottom:4px">${a.bonusText}</p>${reqStr?`<p style="color:${reqOk?'#7ec87e':'#e74c3c'};font-size:11px;margin-bottom:6px">đź“‹ ${reqStr}</p>`:''}<div class="pr">${priceLabel}</div>${activeMark}<button class="bbtn" onclick="buyApartment('${a.id}',${a.cost})" ${disabled?'disabled':''}>${btnLabel}</button></div>`;
      }).join('')}
    </div>
    ${rentalsHtml}
    <div class="res" id="shop-res">Wybierz mieszkanie.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}

// F+ 2026-05-12: wypowiedzenie najmu z 7-dniowym okresem (PLAN_SESJA #73 wynajem mechanika)
window.toggleRental=(id)=>{
  if(!G.rentals) G.rentals={};
  if(!G._rentalNotice) G._rentalNotice={};
  if(G.rentals[id]===true){
    // Aktywne â€” wypowiedz z 7-dniowym terminem
    if(G._rentalNotice[id]){
      // JuĹĽ w okresie wypowiedzenia â€” odwoĹ‚aj
      delete G._rentalNotice[id];
      if(typeof showMsg==='function')showMsg('âś… Wypowiedzenie odwoĹ‚ane. Najem trwa dalej.');
    } else {
      G._rentalNotice[id]=(G.day||1)+7;
      if(typeof showMsg==='function')showMsg(`đź“ť Wypowiedzenie najmu. Najem aktywny jeszcze 7 dni â€” potem dostÄ™p wraca.`);
    }
  } else {
    G.rentals[id]=true;
    if(typeof showMsg==='function')showMsg('đź”‘ Najem aktywowany. Codziennie dostajesz czynsz.');
  }
  if(typeof renderBiuroNieruchomosci==='function') renderBiuroNieruchomosci();
  if(typeof saveGameSilent==='function') saveGameSilent();
};

// F+ 2026-05-12 #73: window.payBills usuniÄ™ty (duplikat) â€” uĹĽywamy istniejÄ…cego window.payAllBills z G.bills

// â•â•â• RADIO_TIERS (~4078) â•â•â•
const RADIO_TIERS=[
  {name:'Street Slot',req:{spotify:500,tracks:1},royPerPlay:0.6,maxPlays:200,desc:'Nocny slot dla nowych artystĂłw',slots:2},
  {name:'Prime Time',req:{spotify:2000,tracks:3,ytSubs:500},royPerPlay:1.2,maxPlays:500,desc:'Wieczorny prime time â€” 18:00-22:00',slots:1},
  {name:'Hit Parade',req:{spotify:8000,tracks:5,ytSubs:2000,streetRep:50},royPerPlay:2.5,maxPlays:1200,desc:'NajwiÄ™kszy zasiÄ™g w mieĹ›cie',slots:1},
];
function renderRadioStation(){
  const sp=G.spotify.listeners||0,tracks=G.careers.beatmaker?.tracks||0,ytSubs=G.yt?.subs||0,rep=G.streetRep||0;
  const tiersHtml=RADIO_TIERS.map((t,i)=>{
    const canSend=sp>=t.req.spotify&&tracks>=(t.req.tracks||0)&&(ytSubs>=(t.req.ytSubs||0))&&(rep>=(t.req.streetRep||0))&&G.careers.beatmaker?.beats>0;
    const locked=!canSend;
    const reqItems=[
      `đźŽµ Spotify: ${sp.toLocaleString('pl')}/${t.req.spotify.toLocaleString('pl')} sĹ‚uchaczy`,
      `đźŽ¶ Tracki beatmakera: ${tracks}/${t.req.tracks}`,
      ...(t.req.ytSubs?[`đź“ş YouTube: ${ytSubs}/${t.req.ytSubs} sub`]:[]),
      ...(t.req.streetRep?[`đźŹ† Uliczna rep: ${rep}/${t.req.streetRep}`]:[]),
      `đźŽ›ď¸Ź Bit w inwentarzu: ${G.careers.beatmaker?.beats||0}`,
    ];
    const met=r=>r.split('/').length===2&&parseInt(r.split('/')[0].replace(/\D/g,''))>=parseInt(r.split('/')[1].replace(/\D/g,''));
    return `<div class="card" style="border-color:${canSend?'#e74c3c':'#1a1a2a'}">
      <h3>đź“» ${t.name}</h3>
      <p style="color:#999;font-size:12px">${t.desc}</p>
      <div style="font-size:12px;color:#667;margin:8px 0">${reqItems.map(r=>`<div style="color:${r.includes('Bit')?G.careers.beatmaker?.beats>0?'#27ae60':'#e74c3c':r.split('/').length===2&&parseInt(r.replace(/.*:\s*/,'').split('/')[0].replace(/\D/g,''))>=parseInt(r.replace(/.*:\s*/,'').split('/')[1].replace(/\D/g,''))?'#27ae60':'#e74c3c'}">â—Ź ${r}</div>`).join('')}</div>
      <div style="font-size:11px;color:#f1c40f">đź’° ${t.royPerPlay} zĹ‚/odtw. Â· maks. ${t.maxPlays} odtworzeĹ„</div>
      <button class="dbtn" style="margin-top:8px" ${locked?'disabled':''} onclick="sendBeatToRadio(${i})">đź“¤ WyĹ›lij bit</button>
    </div>`;
  }).join('');
  document.getElementById('ov-content').innerHTML=`
    <h2>đź“» Radio Street FM</h2>
    <p class="sub">Lokalne radio â€” wyĹ›lij utwĂłr i zarabiaj na odtworzeniach. KaĹĽdy slot ma inne wymagania.</p>
    <div class="statrow">
      <div class="sbox"><div class="l">Bity na antenie</div><div class="v">${G.radio.beats}</div></div>
      <div class="sbox"><div class="l">Odtworzenia</div><div class="v">${G.radio.plays.toLocaleString('pl')}</div></div>
      <div class="sbox"><div class="l">Tantiemy</div><div class="v">${G.radio.royalties} zĹ‚</div></div>
      <div class="sbox"><div class="l">Spotify</div><div class="v">${sp.toLocaleString('pl')}</div></div>
    </div>
    <div style="background:#0a0a14;border:1px solid #2a0a0a;border-radius:8px;padding:14px;margin-bottom:14px">
      <div style="font-size:13px;color:#e74c3c;font-weight:700;margin-bottom:6px">đź“» Na antenie:</div>
      <div style="font-size:15px;color:#fff">${G.radio.beats>0?`đźŽµ ${G.radio.beats} ${G.radio.beats===1?'utwĂłr':'utwory'} â€” ${G.radio.plays.toLocaleString('pl')} odtworzeĹ„`:'(Ĺ»aden utwĂłr nie jest na antenie)'}</div>
    </div>
    <div class="cards">${tiersHtml}</div>
    <div style="margin-top:12px">
      <button class="dbtn" ${G.radio.royalties<=0?'disabled':''} onclick="collectRadioRoyalties()">đź’° Zbierz tantiemy: ${G.radio.royalties} zĹ‚</button>
    </div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}
window.sendBeatToRadio=(tierIdx)=>{
  const t=RADIO_TIERS[tierIdx||0];
  if(!t||G.careers.beatmaker?.beats<=0) return;
  const sp=G.spotify.listeners||0,tracks=G.careers.beatmaker?.tracks||0,ytSubs=G.yt?.subs||0,rep=G.streetRep||0;
  if(sp<t.req.spotify||tracks<(t.req.tracks||0)||(t.req.ytSubs&&ytSubs<t.req.ytSubs)||(t.req.streetRep&&rep<t.req.streetRep)){
    notify('âťŚ Nie speĹ‚niasz wymogĂłw dla tego slotu!');return;
  }
  G.careers.beatmaker.beats--;G.radio.beats++;
  /* v2.1.176: zapisz najwyĹĽszy royPerPlay z dotychczasowych sendĂłw â€” daily royalty uĹĽyje tieru */
  G.radio.tierRate=Math.max(G.radio.tierRate||0,t.royPerPlay);
  notify(`đź“» Bit wysĹ‚any do "${t.name}"! ${t.royPerPlay} zĹ‚/odtworzenie`);renderRadioStation();
};
window.collectRadioRoyalties=()=>{
  if(G.radio.royalties<=0) return;
  /* v2.1.96: Prestige moneyMult przez earn() (collectRadioRoyalties bypass fix) */
  const _amount=G.radio.royalties;
  if(typeof earn==='function') earn(_amount,false); else {G.money+=_amount;G.totalEarned=(G.totalEarned||0)+_amount;}
  notify('đź’° Zebrano '+_amount+' zĹ‚ tantiem z radia!');
  G.radio.royalties=0;renderRadioStation();
};

// Zakupy â€” funkcje
window.buyItem=(item,price)=>{
  /* v2.1.201 [Amper]: Street rep discount dla sklepĂłw ulicznych */
  const _repDisc=(typeof window.getStreetRepShopDiscount==='function')?window.getStreetRepShopDiscount():0;
  const finalPrice=Math.floor(price*(1-_repDisc));
  if(G.money<finalPrice){document.getElementById('shop-res').textContent='Za maĹ‚o pieniÄ™dzy!';return;}
  G.money-=finalPrice;
  price=finalPrice;
  if(item==='pizza'){G.hunger=eatFood(60);G.energy=clampStat('energy', G.energy+5);progressQuest('eat');document.getElementById('shop-res').textContent='đźŤ• +60 gĹ‚Ăłd, +5 energia';}
  else if(item==='energy'){G.energy=clampStat('energy', G.energy+50);G.hunger=clampStat('hunger', G.hunger-5);document.getElementById('shop-res').textContent='đźĄ¤ +50 energia';}
  else if(item==='meal'){G.hunger=eatFood(80);G.energy=clampStat('energy', G.energy+20);progressQuest('eat');document.getElementById('shop-res').textContent='đźŤ± +80 gĹ‚Ăłd, +20 energia';}
  else if(item==='coffee'){G.energy=clampStat('energy', G.energy+30);G.stress=clamp(G.stress+5,0,100);document.getElementById('shop-res').textContent='â• +30 energia, +5 nastrĂłj';}
  else if(item==='fruit'){G.hunger=eatFood(20);G.health=clampStat('health', G.health+5);progressQuest('eat');document.getElementById('shop-res').textContent='đźŤŽ +20 gĹ‚Ăłd, +5 zdrowie';}
  else if(item==='vitamins'){G.health=clampStat('health', G.health+15);G.stress=clamp(G.stress+10,0,100);document.getElementById('shop-res').textContent='đź’Š +15 zdrowie, +10 nastrĂłj';}
};
window.buyCamera=(name,quality,price)=>{
  /* v2.1.51 Amper: kupno dodaje do inwentarza zamiast nadpisywaÄ‡. JeĹ›li gracz juĹĽ ma â†’ tylko aktywuj. */
  if(!Array.isArray(G.camerasOwned)) G.camerasOwned=[];
  const _existing=G.camerasOwned.find(c=>c.name===name);
  if(_existing){
    G.camera=_existing;
    const r=document.getElementById('shop-res');if(r)r.textContent=`đź“ą ${name} juĹĽ w inwentarzu â€” ustawiona jako aktywna.`;
    renderMediaMarkt();return;
  }
  if(G.money<price){const r=document.getElementById('shop-res');if(r)r.textContent='Za maĹ‚o pieniÄ™dzy!';return;}
  G.money-=price;
  const _newCam={name,quality,price,origQuality:quality};
  G.camerasOwned.push(_newCam);
  G.camera=_newCam; /* nowy zakup = aktywny */
  document.getElementById('shop-res').textContent=`đź“ą Kupiono ${name}! JakoĹ›Ä‡: ${quality}% (dodano do inwentarza)`;renderMediaMarkt();
};
/* v2.1.51 Amper: setActiveCamera, sellCamera. */
window.setActiveCamera=(name)=>{
  const c=(G.camerasOwned||[]).find(x=>x.name===name);
  if(!c){showMsg('Nie posiadasz tej kamery','r');return;}
  G.camera=c;
  showMsg(`đź“ą Aktywna kamera: ${c.name} (${c.quality}%)`);
  if(typeof renderMediaMarkt==='function') renderMediaMarkt();
};
window.sellCamera=(name)=>{
  if(!Array.isArray(G.camerasOwned)) return;
  const idx=G.camerasOwned.findIndex(x=>x.name===name);
  if(idx<0) return;
  const c=G.camerasOwned[idx];
  const refund=Math.floor((c.price||0)*0.5);
  /* v2.1.68 Amper: gameConfirm zamiast natywnego confirm. */
  const _doSell=()=>{
    G.camerasOwned.splice(idx,1);
    if(refund>0){G.money+=refund;G.totalEarned=(G.totalEarned||0)+refund;}
    if(G.camera && G.camera.name===name){G.camera=G.camerasOwned[0]||null;}
    showMsg(`đź’° Sprzedano ${c.name} za ${refund.toLocaleString('pl')} zĹ‚ (50% ceny)`);
    if(typeof renderMediaMarkt==='function') renderMediaMarkt();
  };
  if(typeof gameConfirm==='function'){gameConfirm(`SprzedaÄ‡ "${c.name}" za ${refund.toLocaleString('pl')} zĹ‚ (50% ceny zakupu)?`,_doSell);}
  else _doSell();
};
window.buyPCUpgrade=()=>{
  if(G.money<800) return;G.money-=800;G.hasPCUpgrade=true;
  document.getElementById('shop-res').textContent='đź’» PC ulepszony! +15% jakoĹ›Ä‡ montaĹĽu';renderMediaMarkt();
};
window.buyMic=(name,type,quality,price)=>{
