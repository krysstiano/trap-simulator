  /* Tier 1 Rising — Premium sponsor (jednorazowy bonus, nie kontrakt) */
  {name:'Premium sponsor offer', chance:0.008, maxPerDay:1,
    cond:()=>_evPhoneSpot()&&(G.fame||0)>=100&&(G.followers||0)>=5000,
    fn:()=>{
      const pay=rnd(500,2000);
      if(typeof earn==='function') earn(pay,false); else {G.money+=pay;G.totalEarned=(G.totalEarned||0)+pay;}
      notify(`💼 Premium marka oferuje jednorazowy kontrakt — +${pay.toLocaleString('pl')} zł`);
    }
