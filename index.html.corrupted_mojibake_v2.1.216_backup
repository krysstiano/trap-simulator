        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:12px">
          <div><div style="color:#a87">SĹ‚uchacze</div><div style="color:#fff;font-weight:700">${G.soundcloud.listeners.toLocaleString('pl')}</div></div>
          <div><div style="color:#a87">Odtworzenia</div><div style="color:#fff;font-weight:700">${G.soundcloud.streams.toLocaleString('pl')}</div></div>
          <div><div style="color:#a87">Wrzucone</div><div style="color:#fff;font-weight:700">${G.soundcloud.tracksUploaded||0}</div></div>
          <div><div style="color:#a87">Tantiemy</div><div style="color:#ff5500;font-weight:700">${G.soundcloud.royalties} zĹ‚</div></div>
        </div>
      </div>
      ${G.soundcloud.royalties>0?`<button class="bbtn" style="margin-bottom:10px;background:linear-gradient(135deg,#ff5500,#cc3300);color:#fff" onclick="collectRoyalties('soundcloud')">đź’° Zbierz tantiemy (${G.soundcloud.royalties} zĹ‚)</button>`:''}
      <!-- v2.1.123: Wave 6 S50 â€” Upload z telefonu (gracz nie musi wracaÄ‡ do studio dla SoundCloud upload). Link do DAW master tab. -->
      <button class="bbtn" style="margin-bottom:10px;background:linear-gradient(135deg,#ff7733,#ff5500);color:#fff;border:1px solid #ff8855" onclick="closePhone();if(G.hasDaw){renderDAWOverlay('master');openOverlay();}else{showMsg('đźź  Najpierw kup DAW (komputer) w Sklepie Muzycznym aby wrzucaÄ‡ na SoundCloud','r',4000);}">đźź  WrzuÄ‡ track na SoundCloud â†’</button>
      ${scTracks.length>0?`
      <div style="background:#0a0502;border-radius:8px;padding:10px;margin-bottom:10px;border:1px solid #2a1408">
