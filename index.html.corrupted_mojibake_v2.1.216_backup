function drawTrees(){
  if(currentRoom!=='ulica') return;
  let trees;
  if(currentRoom==='ulica'){
    // Drzewa w ulicy zarzÄ…dza drawCityDecorations() â€” tu pomijamy
    trees=[];
  } else {
    trees=[{wx:80,wy:60},{wx:180,wy:60},{wx:350,wy:60},{wx:800,wy:60},{wx:950,wy:60},
           {wx:100,wy:650},{wx:200,wy:650},{wx:400,wy:650},{wx:700,wy:650}];
  }
  for(const t of trees){
    const sx=wx2sx(t.wx);const sy=wy2sy(t.wy||0);
    if(sx<-60||sx>1340) continue;
    X.fillStyle='rgba(0,0,0,.15)';X.beginPath();X.ellipse(sx+4,sy+62,16,6,0,0,Math.PI*2);X.fill();
    X.fillStyle='#3a2008';X.fillRect(sx-5,sy+22,10,42);
    X.fillStyle='#154015';X.beginPath();X.arc(sx,sy+18,26,0,Math.PI*2);X.fill();
    X.fillStyle='#1e5a1e';X.beginPath();X.arc(sx-5,sy+6,20,0,Math.PI*2);X.fill();
    X.fillStyle='#267026';X.beginPath();X.arc(sx+4,sy+2,18,0,Math.PI*2);X.fill();
    X.fillStyle='#30903a';X.beginPath();X.arc(sx,sy-6,14,0,Math.PI*2);X.fill();
  }
}

function drawLamp(lx,wyPos,isNight){
  const sx=wx2sx(lx),sy=wy2sy(wyPos);
  if(sx<-20||sx>1300)return;
  X.fillStyle='#2a2a2a';X.fillRect(sx-3,sy-85,6,85);
  X.fillStyle='#888';X.fillRect(sx-15,sy-87,30,8);
  X.fillStyle=isNight?'#ffe090':'#ccaa60';
  X.beginPath();X.ellipse(sx,sy-83,13,6,0,0,Math.PI*2);X.fill();
  if(isNight){
    // DuĹĽa poĹ›wiata na ziemi
    const grd=X.createRadialGradient(sx,sy,0,sx,sy,130);
    grd.addColorStop(0,'rgba(255,210,80,.13)');
    grd.addColorStop(.5,'rgba(255,200,60,.06)');
    grd.addColorStop(1,'rgba(255,180,50,0)');
    X.fillStyle=grd;X.beginPath();X.arc(sx,sy,130,0,Math.PI*2);X.fill();
    // PoĹ›wiata wokĂłĹ‚ klosza latarni
    const lamp=X.createRadialGradient(sx,sy-83,0,sx,sy-83,22);
    lamp.addColorStop(0,'rgba(255,240,160,.95)');
    lamp.addColorStop(.5,'rgba(255,220,100,.4)');
    lamp.addColorStop(1,'rgba(255,200,80,0)');
    X.fillStyle=lamp;X.beginPath();X.arc(sx,sy-83,22,0,Math.PI*2);X.fill();
  }
}
function drawLamps(){
  if(currentRoom!=='ulica') return;
  const isNight=G.timeOfDay===3;
  // F4.5 NAPRAWA: zamiast wzdluz wszystkich chodnikow co 400px (duplikat z streetLamps),
  // tylko 5 SPECJALNYCH wysokich latarni jako akcent w wybranych miejscach.
  // Ich charakterystyka: WYZSZY slup + MOCNA poswiata (radial 130px).
  // Niskie latarnie codzienne robi streetLamps w drawStreetDetails.
  const SPECIAL_LAMPS = [
    {wx:2785, wy:670},   // Plac przed SalÄ… KoncertowÄ… (chodnik S H1)
    {wx:2596, wy:2706},  // WejĹ›cie do Drip District (miÄ™dzy H2 i H3)
    {wx:700,  wy:615},   // Przed parkiem od V1 (chodnik S H1, dalej od streetLamp wx=560)
    {wx:1500, wy:2150},  // Penthouse â€” przed wejĹ›ciem (chodnik S H2, dalej od streetLamp wx=1360)
    {wx:2412, wy:1870},  // Drip North landmark (chodnik V2 wsch Ă— chodnik N H2)
  ];
  // F+ Walidacja: pomiĹ„ pozycje na jezdni (zgodnie z PLAN_SESJA "PAMIÄTAÄ† Ĺ»EBY NIE STAĹY NA ULICY")
  for(const lamp of SPECIAL_LAMPS){
    if(_isOnRoad(lamp.wx, lamp.wy)) continue;
    drawLamp(lamp.wx, lamp.wy, isNight);
  }
}

function playDangerSound(){
  if(_muted) return;
  try{const a=getAudio();if(!a) return;
    const o=a.createOscillator();const g=a.createGain();
    o.connect(g);g.connect(_sfxMasterGain||a.destination);
    o.type='sawtooth';o.frequency.setValueAtTime(220,a.currentTime);
    o.frequency.exponentialRampToValueAtTime(110,a.currentTime+0.3);
    g.gain.setValueAtTime(0.15,a.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.3);
    o.start();o.stop(a.currentTime+0.3);
  }catch(e){}
}

// â•â•â•â•â• Procedural SFX (oscillator + noise) â•â•â•â•â•
function _sfxNoise(dur,filterType,filterFreq,vol){
  if(_muted)return;
  try{const a=getAudio();if(!a)return;
    const buf=a.createBuffer(1,Math.max(1,Math.floor(a.sampleRate*dur)),a.sampleRate);
    const d=buf.getChannelData(0);
    for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
    const src=a.createBufferSource();src.buffer=buf;
    const f=a.createBiquadFilter();f.type=filterType;f.frequency.value=filterFreq;
    const g=a.createGain();
    g.gain.setValueAtTime(vol,a.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+dur);
    src.connect(f);f.connect(g);g.connect(_sfxMasterGain||a.destination);
    src.start();
  }catch(e){}
}
// v1.8.15: GLOBALNY guard debounce dla wszystkich SFX
// User: "SFX czasami odpalajÄ… siÄ™ kilkukrotnie, brzmi jak naĹ‚oĹĽone na siebie"
window._sfxLast = window._sfxLast || {};
function _sfxGuard(name, ms=180){
  const _now=Date.now();
  if(window._sfxLast[name] && (_now-window._sfxLast[name])<ms) return false;
  window._sfxLast[name]=_now;
  return true;
}
function sfxCash(){
  if(!_sfxGuard('cash',300)) return;
  bgmDuck();
  if(_muted)return;
  try{const a=getAudio();if(!a)return;const t=a.currentTime;
    [[1320,0],[1760,0.07]].forEach(([f,d])=>{
      const o=a.createOscillator();const g=a.createGain();
      o.type='triangle';o.frequency.setValueAtTime(f,t+d);
      g.gain.setValueAtTime(0,t+d);g.gain.linearRampToValueAtTime(0.12,t+d+0.01); // gĹ‚oĹ›noĹ›Ä‡ 0.18â†’0.12 (cichszy)
      g.gain.exponentialRampToValueAtTime(0.001,t+d+0.45);
      o.connect(g);g.connect(_sfxMasterGain||a.destination);o.start(t+d);o.stop(t+d+0.5);
    });
    setTimeout(()=>_sfxNoise(0.2,'highpass',4000,0.05),60);
  }catch(e){}
}
function sfxRep(){
  if(!_sfxGuard('rep',200)) return;
  bgmDuck();
  if(_muted)return;
  try{const a=getAudio();if(!a)return;const t=a.currentTime;
    const o=a.createOscillator();const g=a.createGain();
    o.type='sine';o.frequency.setValueAtTime(120,t);
    o.frequency.exponentialRampToValueAtTime(50,t+0.18);
    g.gain.setValueAtTime(0.14,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.22); /* v1.9.15: 0.32â†’0.14 spĂłjnie z innymi SFX (rep byĹ‚ 2-3Ă— gĹ‚oĹ›niejszy) */
    o.connect(g);g.connect(_sfxMasterGain||a.destination);o.start(t);o.stop(t+0.25);
    setTimeout(()=>_sfxNoise(0.18,'bandpass',900,0.10),120);
  }catch(e){}
}
function sfxSparks(){
  if(!_sfxGuard('sparks',150)) return;
  bgmDuck();
  if(_muted)return;
  _sfxNoise(0.25,'highpass',5000,0.14);
  setTimeout(()=>_sfxNoise(0.15,'highpass',6500,0.10),60);
  setTimeout(()=>_sfxNoise(0.10,'highpass',4500,0.07),140);
}
function sfxBubble(){
  if(!_sfxGuard('bubble',100)) return;
  bgmDuck();
  if(_muted)return;
  try{const a=getAudio();if(!a)return;const t=a.currentTime;
    const o=a.createOscillator();const g=a.createGain();
    o.type='sine';o.frequency.setValueAtTime(800,t);
    o.frequency.exponentialRampToValueAtTime(2400,t+0.07);
    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.14,t+0.005);
    g.gain.exponentialRampToValueAtTime(0.001,t+0.09);
    o.connect(g);g.connect(_sfxMasterGain||a.destination);o.start(t);o.stop(t+0.1);
  }catch(e){}
}
function sfxMetal(){
  if(!_sfxGuard('metal',150)) return;
  bgmDuck();
  if(_muted)return;
  try{const a=getAudio();if(!a)return;const t=a.currentTime;
    const o=a.createOscillator();const g=a.createGain();
    o.type='square';o.frequency.setValueAtTime(660,t);
    o.frequency.exponentialRampToValueAtTime(540,t+0.4);
    g.gain.setValueAtTime(0.14,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.5);
    const f=a.createBiquadFilter();f.type='highpass';f.frequency.value=400;
    o.connect(f);f.connect(g);g.connect(_sfxMasterGain||a.destination);o.start(t);o.stop(t+0.55);
    const o2=a.createOscillator();const g2=a.createGain();
    o2.type='triangle';o2.frequency.setValueAtTime(990,t);
    g2.gain.setValueAtTime(0.06,t);g2.gain.exponentialRampToValueAtTime(0.001,t+0.3);
    o2.connect(g2);g2.connect(_sfxMasterGain||a.destination);o2.start(t);o2.stop(t+0.35);
  }catch(e){}
}
/* v2.1.116: Wave 5 S40 â€” sfxStep byĹ‚ dead code (zdefiniowany ale nigdy nie wywoĹ‚any â€” uĹĽywamy playStep). UsuniÄ™ty. */
let _ovenNode=null;
function sfxOvenStart(){
  if(_muted)return;
  try{
    if(_ovenNode){try{_ovenNode.src.stop();}catch(e){}_ovenNode=null;}
    const a=getAudio();if(!a)return;const dur=20;
    const buf=a.createBuffer(1,a.sampleRate*dur,a.sampleRate);
    const d=buf.getChannelData(0);let last=0;
    for(let i=0;i<d.length;i++){const w=Math.random()*2-1;last=last*0.9+w*0.1;d[i]=last*3;}
    const src=a.createBufferSource();src.buffer=buf;src.loop=true;
    const f=a.createBiquadFilter();f.type='bandpass';f.frequency.value=2800;f.Q.value=0.7;
    const g=a.createGain();
    g.gain.setValueAtTime(0,a.currentTime);g.gain.linearRampToValueAtTime(0.05,a.currentTime+0.4);
    src.connect(f);f.connect(g);g.connect(_sfxMasterGain||a.destination);src.start();
    _ovenNode={src,g,a};
  }catch(e){}
}
function sfxOvenStop(){
  if(!_ovenNode)return;
  try{const{src,g,a}=_ovenNode;
    g.gain.linearRampToValueAtTime(0,a.currentTime+0.3);
    setTimeout(()=>{try{src.stop();}catch(e){}},350);
  }catch(e){}
  _ovenNode=null;
}
function sfxSparkle(){
  if(!_sfxGuard('sparkle',200)) return;
  bgmDuck();
  if(_muted)return;
  try{const a=getAudio();if(!a)return;const t=a.currentTime;
    [1046,1318,1568,2093].forEach((f,i)=>{
      const o=a.createOscillator();const g=a.createGain();
