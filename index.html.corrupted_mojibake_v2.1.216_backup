function startRestMG(type,_dur,_eg,_mg,label,onDone){
  if(_restTimer)return;
  G._resting=true;
  _restOnDone=onDone||null;
  // v1.8.18: 2.5Ă— szybsza regeneracja (user: "spanie/odpoczywanie zdecydowanie za dĹ‚ugo")
  // max ticks: sofa=300 (60s), bench/pond=150 (30s) â€” czas bez zmian, ale tempo wyĹĽsze
  const maxTicks=type==='sofa'?300:150;
  const energyPerTick=type==='sofa'?0.65:0.30;
  const moodPerTick=type==='sofa'?0.15:0.07; /* v2.1.200: sofa 0.5â†’0.15, bench 0.25â†’0.07 (Agent E+F audyt) â€” wczeĹ›niej sofa dawaĹ‚a +0.5/200ms = 150/min mood (cap 100 w 40s), bench +75/min (cap w 80s). Teraz sofa +45/min (cap w 2min), bench +21/min (cap w 5min). SpĂłjne z sleep 0.6â†’0.15 fix i tickDecay 1.0 (10/min). Mood nadal regeneruje ale wymaga aktywnego uĹĽycia. */
  const hungerPerTick=0.05;
  const wrap=document.getElementById('wrap');
  let existing=document.getElementById('rest-overlay');
  if(existing)existing.remove();
  const ov=document.createElement('div');
  ov.id='rest-overlay';
  ov.style.cssText='position:absolute;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(4,10,22,.96);border:1px solid #2a4a6a;border-radius:10px;padding:16px 30px;z-index:25;min-width:340px;text-align:center;pointer-events:all;';
  const icons={sofa:'đź›‹',bench:'đźŞ‘',pond:'đźź'};
  ov.innerHTML=`
    <div style="font-size:15px;color:#7ec8e3;font-weight:700;margin-bottom:6px">${icons[type]||'âŹł'} ${label}</div>
    <div style="background:#0a1220;border-radius:6px;height:12px;overflow:hidden;width:100%;margin-bottom:8px">
      <div id="rest-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#3498db,#7ec8e3);border-radius:6px;transition:width .18s;"></div>
    </div>
    <div id="rest-status" style="font-size:13px;color:#aaa;margin-bottom:10px;line-height:1.6">âšˇ â€” Â· đźŤ” â€”</div>
    <button onclick="stopRest()" style="background:transparent;border:1px solid #2a4a6a;color:#556;font-family:inherit;font-size:12px;padding:6px 20px;cursor:pointer;border-radius:4px;transition:all .15s;" onmouseover="this.style.borderColor='#7ec8e3';this.style.color='#7ec8e3'" onmouseout="this.style.borderColor='#2a4a6a';this.style.color='#556'">WstaĹ„ [Esc]</button>
  `;
  wrap.appendChild(ov);
  let ticks=0;
  _restTimer=setInterval(()=>{
    if(!G._resting){stopRest();return;}
    ticks++;
    G.energy=clampStat('energy', G.energy+energyPerTick);
    G.stress=clamp(G.stress+moodPerTick,0,100);
    G.hunger=clampStat('hunger', G.hunger-hungerPerTick);
    updateHUD();
    const bar=document.getElementById('rest-bar');
    if(bar)bar.style.width=(ticks/maxTicks*100)+'%';
    const st=document.getElementById('rest-status');
    if(st)st.innerHTML=`âšˇ <b style="color:#3498db">${Math.floor(G.energy)}%</b> &nbsp;Â·&nbsp; đźŤ” <b style="color:#27ae60">${Math.floor(G.hunger)}%</b>`;
    // auto-stop: energy full, hunger critical, or max time reached
    // v2.1.25: minimum 30 ticks (6s) PRZED auto-stop (ĹĽeby okno nie zamykaĹ‚o siÄ™ natychmiast gdy energy=100)
    // v2.1.26: XP z capem (1Ă— na minutÄ™ real per type)
    if(ticks>=30 && (G.energy>=100||G.hunger<=2||ticks>=maxTicks)){
      const msgs={sofa:'đź›‹ OdpoczÄ™Ĺ‚eĹ› na sofie!',bench:'đźŚł Relaks na Ĺ‚awce!',pond:'đźź SpokĂłj przy stawie!'};
      addXPCapped(2, 'rest_finalize_'+type, 60000);
      if(_restOnDone){_restOnDone();_restOnDone=null;}
      notify(msgs[type]||'OdpoczÄ™Ĺ‚eĹ›!');
      stopRest();
    }
  },200);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
