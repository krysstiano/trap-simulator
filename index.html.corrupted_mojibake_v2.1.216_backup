      {label:'đźŽ¤ Wskocz (+800 zĹ‚, -25 energii, +50-200 fanĂłw)', fn:()=>{earn(800,false);G.energy=clampStat('energy', G.energy-25);const f=rnd(50,200);G.followers+=f;if(typeof addFame==='function')addFame(3);else G.fame=clamp(G.fame+3,0,500);notify(`đźŽ¤ Niespodziewany gig zaliczony! +800 zĹ‚, +${f} fanĂłw`);}},
      {label:'âťŚ OdrzuÄ‡ (-2 sĹ‚awy)', fn:()=>{G.fame=Math.max(0,G.fame-2);notify('âťŚ Klub znalazĹ‚ kogoĹ› innego. -2 sĹ‚awy.','r');}}
    ]
  )}
];
function showEventChoice(title, desc, choices){
  document.getElementById('event-choice')?.remove();
  const m=document.createElement('div');
  m.id='event-choice';
  m.style.cssText='position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#0a0f1a;border:2px solid #f1c40f;border-radius:14px;padding:24px 28px;z-index:280;box-shadow:0 0 50px rgba(241,196,15,.4);max-width:520px;font-family:inherit';
  m.innerHTML=`
    <div style="font-size:20px;color:#f1c40f;font-weight:900;margin-bottom:10px;text-align:center">${title}</div>
    <div style="color:#ccc;font-size:14px;line-height:1.5;margin-bottom:20px">${desc}</div>
    <div style="display:flex;flex-direction:column;gap:8px">
      ${choices.map((c,i)=>`<button onclick="window._evChoice(${i})" style="background:#0a1a2a;border:1px solid #2a4a6a;color:#7ec8e3;padding:11px 16px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;text-align:left;transition:all .15s" onmouseover="this.style.background='#1a3a5a';this.style.borderColor='#7ec8e3'" onmouseout="this.style.background='#0a1a2a';this.style.borderColor='#2a4a6a'">${c.label}</button>`).join('')}
    </div>
  `;
  document.body.appendChild(m);
  window._evChoice=(idx)=>{choices[idx].fn();m.remove();};
}

