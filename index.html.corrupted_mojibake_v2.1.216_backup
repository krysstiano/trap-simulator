      <div style="font-size:64px;margin-bottom:12px;text-shadow:0 0 30px #e67e22aa">đź’Ş</div>
      <h1 style="font-size:34px;background:linear-gradient(135deg,#e67e22,#c0392b);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:4px;margin:0 0 8px 0;font-family:'Russo One',Impact,sans-serif">WITAJ NA SILOWNI</h1>
      <p style="color:#aac;font-size:14px;margin:0 0 20px 0;font-style:italic">Twoj rozwoj fizyczny zaczyna sie tutaj</p>

      <div style="text-align:left;background:rgba(20,30,50,0.5);border:1px solid #2a3a4a;border-radius:10px;padding:16px;margin-bottom:14px">
        <h3 style="color:#e67e22;margin:0 0 8px 0;font-size:16px">đź’Ş FORMA (sila)</h3>
        <ul style="margin:0;padding-left:18px;color:#dde;font-size:13px;line-height:1.7">
          <li>Trenowana na ĹAWCE i WYCIÄ„GU</li>
          <li>WpĹ‚yw na zarobki podczas pracy fizycznej i atrakcyjnosc u NPC</li>
          <li>Forma 100 â†’ +10 do max zdrowia/energii/glodu (cinematic milestone!)</li>
          <li>Forma 100 â†’ -5% wolniejszy spadek energii</li>
        </ul>
      </div>

      <div style="text-align:left;background:rgba(20,30,50,0.5);border:1px solid #2a3a4a;border-radius:10px;padding:16px;margin-bottom:14px">
        <h3 style="color:#00bcd4;margin:0 0 8px 0;font-size:16px">đźŹ KONDYCJA (wytrzymalosc)</h3>
        <ul style="margin:0;padding-left:18px;color:#dde;font-size:13px;line-height:1.7">
          <li>Trenowana na BIEZNI</li>
          <li>WpĹ‚yw na predkosc poruszania sie postaci</li>
          <li>Kondycja 100 â†’ +10 do max zdrowia/energii/glodu</li>
          <li>Kondycja 100 â†’ -5% wolniejszy spadek zdrowia</li>
        </ul>
      </div>

      <div style="text-align:left;background:rgba(20,30,50,0.5);border:1px solid #2a3a4a;border-radius:10px;padding:16px;margin-bottom:14px">
        <h3 style="color:#f1c40f;margin:0 0 8px 0;font-size:16px">đźŹ‹ STROJE TRENINGOWE</h3>
        <ul style="margin:0;padding-left:18px;color:#dde;font-size:13px;line-height:1.7">
          <li>Stroj sportowy (~150 zl) â†’ +20% przyrostow</li>
          <li>Stroj treningowy PRO (~700 zl) â†’ +25% + DODATKOWA seria sily i cardio</li>
          <li>Pamietaj zalozyc stroj przed treningiem!</li>
        </ul>
      </div>

      <div style="text-align:left;background:rgba(50,20,20,0.5);border:1px solid #5a2a2a;border-radius:10px;padding:16px;margin-bottom:18px">
        <h3 style="color:#e74c3c;margin:0 0 8px 0;font-size:16px">âš ď¸Ź BRAK TRENINGU = SPADEK</h3>
        <ul style="margin:0;padding-left:18px;color:#dde;font-size:13px;line-height:1.7">
          <li>Po 2 dniach bez treningu â€” SMS od Gym Bro đź’Ş</li>
          <li>Po 3+ dniach â€” forma i kondycja spadaja o 10-20% dziennie!</li>
          <li>1 sesja siĹ‚owni resetuje cykl. Trzymaj forme regularnie!</li>
        </ul>
      </div>

      <button id="gym-tut-close" style="background:linear-gradient(135deg,#e67e22,#c0392b);border:none;color:#fff;font-size:18px;font-weight:700;padding:14px 36px;border-radius:8px;cursor:pointer;letter-spacing:2px;box-shadow:0 4px 16px rgba(230,126,34,0.4);transition:transform 0.2s">ROZUMIEM, DO ROBOTY! đź’Ş</button>
    </div>
    <style>@keyframes fadeInScale{from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)}}</style>
  `;
  document.body.appendChild(ov);
  // SAFETY: brak auto-close. Tylko klik przycisku zamyka.
  const btn = document.getElementById('gym-tut-close');
  if(btn){
    btn.onmouseover = ()=>{ btn.style.transform='scale(1.05)'; };
    btn.onmouseout = ()=>{ btn.style.transform='scale(1)'; };
    btn.onclick = ()=>{
