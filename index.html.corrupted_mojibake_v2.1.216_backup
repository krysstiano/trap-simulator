  </div>
</div>
<div id="quest-widget" style="position:absolute;top:70px;right:14px;width:220px;background:rgba(8,12,22,.96);border:1px solid #2a3a50;border-radius:8px;padding:8px 10px;z-index:14;font-size:11px;color:#aaa;display:none;pointer-events:all;box-shadow:0 4px 14px rgba(0,0,0,.5)">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;cursor:pointer;user-select:none" onclick="toggleQuestWidget()" title="Kliknij, aby rozwinÄ…Ä‡/zwinÄ…Ä‡ listÄ™ celĂłw">
    <span style="color:#7ec8e3;font-weight:700">đź“‹ Cele</span>
