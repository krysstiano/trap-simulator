}

// Networking â€” extra NPC kontakty (proste +1 per lvl + bonus z PU)
function getNetworkingExtraContacts(){
  return _sk('networking') + _pu('networking') + _evo('networking')*2;
}

// === CHARYZMA â€” bonus zarobkĂłw z NPC ===
// F3-FIX-D: Magnetyzm evo daje 2x napiwki (+1.0 = +100%) + bonus z networking evo +20%
function getCharyzmaBonus(){
  let mult = 1 + _sk('charyzma')*0.10 + _pu('charyzma')*0.30;
  if(_evo('charyzma')) mult += 1.0; // Magnetyzm: 2x napiwki = +100%
  if(_evo('networking')) mult *= 1.20; // Influencer Network: +20% z kaĹĽdej interakcji NPC
  return mult;
}

// === ODPORNOSC â€” multiplier obraĹĽeĹ„ (mniejsze = lepsze) ===
// Cap 0.05 (zamiast 0.10) â€” zeby Evo (Niezniszczalny) bylo MNIEJSZE niz PU3
// PU3: 1-0.30-0.60 = 0.10 (cap nie blokuje)
// Evo: 1-0.30-0.60-0.50 = -0.40 â†’ cap 0.05 (5% min)
function getOdpornoscMult(){
  const lvl=_sk('odpornosc'), pu=_pu('odpornosc'), evo=_evo('odpornosc');
  let m = 1 - lvl*0.10 - pu*0.20 - evo*0.50;
  return Math.max(0.05, m);
}

// === APETYT â€” multiplier spadku gĹ‚odu ===
function getApetytMult(){
  const lvl=_sk('apetyt'), pu=_pu('apetyt'), evo=_evo('apetyt');
  let m = 1 - lvl*0.08 - pu*0.15 - evo*0.50;
  return Math.max(0.05, m);
}

// === SILA â€” bonus formy z treningu ===
function getSilaBonus(){
  return 1 + _sk('sila')*0.05 + _pu('sila')*0.15 + _evo('sila')*0.50;
}

// === Praca dorywczy + kariera bonus prace mnozniki ===
// pizza/supermarket/carwash/construction/kurier/zmywak â€” +20%/lvl skill, +30/60/100% PU
// v2.1.104: WSZYSTKIE evo prac DOROWICZYCH +50% (wczeĹ›niej Brygadzista/Multi-zlecenie miaĹ‚y +100% co czyniĹ‚o Construction/Kurier OP).
// User rule: prace dorywcze BEZ cooldownĂłw/limitĂłw â€” balansowaÄ‡ przez evo nerf zamiast blokowaÄ‡ grind (memory feedback_no_job_cooldowns).
// v2.1.118: Wave 6 S52 â€” sport/sport_pro outfit aplikuje +3%/+5% do PRAC FIZYCZNYCH (construction/kurier â€” to teĹĽ wysiĹ‚ek fizyczny). S53 Holiday: Sylwester +10%, Walentynki +5%.
function getPracaBonus(key){
  const evoBonus = _evo(key) ? 0.5 : 0;
  let bonus = 1 + _sk(key)*0.20 + _pu(key)*0.30 + evoBonus;
  /* Sport/sport_pro outfit aplikuje do prac fizycznych (construction, kurier, carwash). */
  if(G.outfit?.top && ['construction','kurier','carwash'].includes(key)){
    if(G.outfit.top==='sport_pro') bonus*=1.05;
    else if(G.outfit.top==='sport') bonus*=1.03;
  }
  /* Holiday bonus: niektĂłre Ĺ›wiÄ™ta dajÄ… moraĹ‚-boost do prac. */
  if(G.activeHoliday){
    if(G.activeHoliday.id==='sylwester') bonus*=1.10; /* sylwester = wszyscy w dobrym humorze */
    else if(G.activeHoliday.id==='walentynki') bonus*=1.05; /* miĹ‚y dzieĹ„ */
  }
  return bonus;
}
// kariera (youtuber/beatmaker/gamer/influencer/soundeng) â€” lvl-1 (bo 1 = unlock), +30/60/100% PU, +50% evo
// Plus bonusy z LOGIKA + SKUPIENIE (skill+PU+evo, kumulacja)
function getKarieraBonus(key){
  let mult = 1 + Math.max(0,_sk(key)-1)*0.15 + _pu(key)*0.30 + _evo(key)*0.50;
  // F3-AUDYT: LOGIKA â€” skill (5%/pkt) + PU (15%/pkt) + evo +25% kumulacja
  mult *= (1 + _sk('logika')*0.05 + _pu('logika')*0.15 + _evo('logika')*0.25);
  // F3-AUDYT: SKUPIENIE â€” skill (5%/pkt) + PU (15%/pkt) + evo +25% kumulacja
  mult *= (1 + _sk('skupienie')*0.05 + _pu('skupienie')*0.15 + _evo('skupienie')*0.25);
  return mult;
}

// â•â•â• Dynamiczny max stat (forma=100 daje +10, kondycja=100 daje +10) â•â•â•
// DziaĹ‚a dla: health, energy, hunger (3 staty z dynamicznym max)
// Inne staty (fame, stress, fitness, forma) majÄ… swoje sztywne maxy gdzie indziej
function getMaxStat(name){
  if(!G) return 100;
  /* v2.1.194: forma ZAWSZE max 100 (user feedback "ujednoliÄ‡ z kondycjÄ…"). WczeĹ›niej Evo Sila +10 i Evo Dieta +5 dawaĹ‚y max 115 â€” dziaĹ‚aĹ‚o, ale dawaĹ‚o znikome bonusy (3-7pp w drobnych formuĹ‚ach). Teraz spĂłjnoĹ›Ä‡ z kondycjÄ… + UI bench (L24947) `/100` hardcoded juĹĽ pasuje. Evo Sila i Evo Dieta zachowujÄ… inne bonusy (getSilaBonus +50%, getDietaEnergyBonus +25%). */
  if(name === 'forma'){
    return 100;
  }
  if(name === 'fitness'){
    /* v2.1.193: usuniÄ™ty ghost evo bonus +max fitness (user feedback "115 nie istnieje w grze").
       WczeĹ›niej Evo Dieta +5 i Evo Bieg +10 â†’ teoretyczny max 115, ale gameplay capowaĹ‚ fitness na 100.
       Teraz: kondycja ZAWSZE max 100. Evo Bieg zachowuje +0.30 do P.spd (w formule prÄ™dkoĹ›ci), Evo Dieta zachowuje swoje pozostaĹ‚e efekty (energy bonus / hunger). */
    return 100;
  }
  if(!['health','energy','hunger'].includes(name)) return 100;
  let bonus = 0;
  if((G.forma||0) >= 100) bonus += 10;     // bonus +10 z formy=100
  if((G.fitness||0) >= 100) bonus += 10;   // bonus +10 z kondycji=100
  return 100 + bonus;
}
// Clamp do dynamicznego max (zastÄ™puje sztywne clamp(val, 0, 100) dla 3 statĂłw)
function clampStat(name, val){
  return Math.max(0, Math.min(getMaxStat(name), val));
}

/* v2.1.26: PRZEJEDZENIE â€” wszystko natychmiastowe, gracz widzi info, decay 3pkt/min real.
   Konsekwencje (NATYCHMIAST przy przekroczeniu progu, nie per-tick):
     0-15:  zdrowo, brak efektĂłw
     15-40 (lekkie): -3 forma, -3 kondycja jednorazowo gdy wchodzi w przedziaĹ‚
     40-70 (Ĺ›rednie): dodatkowo -5 forma, -5 kondycja, -5 nastrĂłj
     70+  (powaĹĽne): dodatkowo -10 forma, -10 kondycja, -5 zdrowie, -5 nastrĂłj
   Decay: 3 pkt na 1 minutÄ™ real (znacznie szybciej niĹĽ v2.1.23). */
function eatFood(amount){
  if(!amount || amount <= 0) return G.hunger || 0;
  const maxH = getMaxStat('hunger');
  const cur = G.hunger || 0;
  const newH = cur + amount;
  const prevOvereat = G.overeat || 0;
  if(newH > maxH){
    G.overeat = prevOvereat + (newH - maxH);
    /* Penalty za marnowanie jedzenia przy gĹ‚Ăłd>80 */
    if(cur > 80) G.overeat += 2;
    /* NATYCHMIASTOWE efekty przy przekroczeniu progĂłw */
    const newOvereat = G.overeat;
    /* PrĂłg 15 (lekkie) */
    if(prevOvereat < 15 && newOvereat >= 15){
      G.forma = (G.forma||0) - 3;
      G.fitness = (G.fitness||0) - 3;
      if(typeof showMsg==='function') showMsg('đź¬ Przejedzenie â€” czujesz lekki dyskomfort. -3 forma, -3 kondycja','r',4500);
    }
    /* PrĂłg 40 (Ĺ›rednie) */
    if(prevOvereat < 40 && newOvereat >= 40){
      G.forma = (G.forma||0) - 5;
      G.fitness = (G.fitness||0) - 5;
      G.stress = Math.max(0, (G.stress||0) - 5);
      if(typeof showMsg==='function') showMsg('đź¤˘ Przejedzenie ĹšREDNIE â€” robi siÄ™ ciÄ™ĹĽko. -5 forma, -5 kondycja, -5 nastrĂłj','r',5500);
    }
    /* PrĂłg 70 (powaĹĽne) */
    if(prevOvereat < 70 && newOvereat >= 70){
      G.forma = (G.forma||0) - 10;
      G.fitness = (G.fitness||0) - 10;
      G.health = clampStat('health', (G.health||0) - 5);
      G.stress = Math.max(0, (G.stress||0) - 5);
      if(typeof showMsg==='function') showMsg('đź¤® PRZEJEDZENIE POWAĹ»NE â€” fatalnie! -10 forma, -10 kondycja, -5 zdrowie. IdĹş pobiegaj!','r',7000);
    }
    /* Clamp dolne â€” forma/kondycja max -50 */
    if(G.forma < -50) G.forma = -50;
    if(G.fitness < -50) G.fitness = -50;
    /* OSTRZEĹ»ENIE jeĹ›li gracz dostaĹ‚ JAKIEKOLWIEK przejedzenie (poniĹĽej 15) */
    if(prevOvereat === 0 && newOvereat > 0 && newOvereat < 15){
      if(typeof showMsg==='function') showMsg(`đźŤ” ZjadĹ‚eĹ› za duĹĽo â€” masz +${Math.floor(newOvereat)} przejedzenia. Przy 15+ zacznÄ… siÄ™ kary dla formy/kondycji.`,'f',5000);
    }
  }
  return Math.max(0, Math.min(maxH, newH));
}

/* v2.1.26: XP cap helper â€” limit 1Ă— XP per source per minutÄ™ real.
   Stosowane do jedzenia (gdy gracz NIE przejedzony) i odpoczynku (Ĺ‚awki/staw/akwarium). */
function addXPCapped(amount, source, capMs){
  if(!amount || amount <= 0) return false;
  if(typeof capMs !== 'number') capMs = 60000; /* domyĹ›lnie 1 minuta */
  if(!G._xpCapTimers) G._xpCapTimers = {};
  const last = G._xpCapTimers[source] || 0;
  const _now = Date.now();
  if(_now - last < capMs) return false; /* cap aktywny â€” bez XP */
  G._xpCapTimers[source] = _now;
  if(typeof addXP === 'function') addXP(amount);
  return true;
}

/* v2.1.26: helper dla XP z jedzenia â€” pomija gdy gracz ma przejedzenie â‰Ą15 */
function addXPFoodCapped(amount){
  if((G.overeat || 0) >= 15) return false; /* przejedzony = brak XP */
  return addXPCapped(amount, 'food', 60000);
}

// â•â•â• Skill access helpers â€” wspierajÄ… OBA formaty (legacy number + new object) â•â•â•
// Stary format: G.skills.kondycja = 3
// Nowy format:  G.skills.kondycja = {lvl: 3, powerUps: 0, evolution: false}
// Helpers dziaĹ‚ajÄ… z obu wersji â€” lazy migration przy zapisie

function getSkillLvl(key){
  if(!G||!G.skills) return 0;
  const s = G.skills[key];
  if(s == null) return 0;
  if(typeof s === 'number') return s;
  return s.lvl || 0;
}
function getSkillPowerUps(key){
  if(!G||!G.skills) return 0;
  const s = G.skills[key];
  if(s == null || typeof s === 'number') return 0;
  return s.powerUps || 0;
}
function hasSkillEvolution(key){
  if(!G||!G.skills) return false;
  const s = G.skills[key];
  if(s == null || typeof s === 'number') return false;
  return !!s.evolution;
}
// Set skill level â€” auto-konwertuje number â†’ object przy zapisie
function setSkillLvl(key, lvl){
  if(!G.skills) G.skills = {};
  const s = G.skills[key];
  if(s == null || typeof s === 'number'){
    G.skills[key] = { lvl: lvl, powerUps: 0, evolution: false };
  } else {
    s.lvl = lvl;
  }
}
function setSkillPowerUps(key, count){
  if(!G.skills) G.skills = {};
  const s = G.skills[key];
  if(s == null || typeof s === 'number'){
    G.skills[key] = { lvl: (typeof s === 'number' ? s : 0), powerUps: count, evolution: false };
  } else {
    s.powerUps = count;
  }
}
function setSkillEvolution(key, evo){
  if(!G.skills) G.skills = {};
  const s = G.skills[key];
  if(s == null || typeof s === 'number'){
    G.skills[key] = { lvl: (typeof s === 'number' ? s : 0), powerUps: 0, evolution: !!evo };
  } else {
    s.evolution = !!evo;
  }
}
// Migration helper â€” wywoĹ‚uj w load do konwersji wszystkich number â†’ object
function migrateSkillsToObjectFormat(){
  if(!G||!G.skills) return 0;
  let migrated = 0;
  for(const key in G.skills){
    if(typeof G.skills[key] === 'number'){
      G.skills[key] = { lvl: G.skills[key], powerUps: 0, evolution: false };
      migrated++;
    }
  }
  return migrated;
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  KAFELKI
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
const tiles = {};
function makeTile(id,fn){
  const oc=document.createElement('canvas');oc.width=T;oc.height=T;
  fn(oc.getContext('2d'));tiles[id]=oc;
}
function initTiles(){
  makeTile('grass',c=>{
    // Soczysty zielony trawnik miejski.
    const g=c.createLinearGradient(0,0,T,T);
    g.addColorStop(0,'#256025');g.addColorStop(.5,'#225825');g.addColorStop(1,'#205220');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    for(let i=0;i<14;i++){
      c.fillStyle=`rgba(20,40,18,${0.04+sr(i*.7)*.06})`;
      c.beginPath();c.ellipse(sr(i*5)*T,sr(i*5+1)*T,5+sr(i*5+2)*8,3+sr(i*5+3)*5,0,0,Math.PI*2);c.fill();
    }
    for(let i=0;i<90;i++){
      const dark=sr(i*3+.1)<.4;
      c.fillStyle=dark?'#1c421c':(sr(i*3+.5)<.5?'#2d6a2d':'#377a37');
      const x=sr(i*3)*T,y=sr(i*3+1)*T,h=sr(i*3+.3)*4+2;
      c.fillRect(x,y,1,h);
      if(sr(i*3+.7)<.3){c.fillStyle='#3f853f';c.fillRect(x+1,y,1,h-1);}
    }
  });
  makeTile('gdark',c=>{
    c.fillStyle='#1a3a1a';c.fillRect(0,0,T,T);
    for(let i=0;i<30;i++){c.fillStyle='#142e14';c.fillRect(sr(i*7)*T,sr(i*7+1)*T,2,2);}
  });
  makeTile('urban',c=>{
    // Miejski "podjazd/parking" â€” ciemny beton z teksturÄ… ĹĽwiru
    const g=c.createLinearGradient(0,0,T,T);
    g.addColorStop(0,'#2a2c30');g.addColorStop(.5,'#262830');g.addColorStop(1,'#22252c');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    // Plamy oleju / staroĹ›ci
    for(let i=0;i<8;i++){
      c.fillStyle=`rgba(0,0,0,${0.12+sr(i*.6)*.12})`;
      c.beginPath();c.ellipse(sr(i*5)*T,sr(i*5+1)*T,3+sr(i*5+2)*5,2+sr(i*5+3)*4,sr(i)*Math.PI,0,Math.PI*2);c.fill();
    }
    // Drobny ĹĽwir
    for(let i=0;i<24;i++){
      c.fillStyle=`rgba(${100+sr(i*3)*40},${95+sr(i*3+.1)*30},${85+sr(i*3+.2)*30},${0.3+sr(i*.4)*.3})`;
      c.fillRect(sr(i)*T,sr(i+.3)*T,1,1);
    }
    // Cieniejsze "kÄ™pki trawy" w szczelinach (subtelnie zielone â€” ĹĽeby byĹ‚o wiadomo ĹĽe to "miasto z trochÄ… zieleni")
    for(let i=0;i<6;i++){
      c.fillStyle=`rgba(40,80,40,${0.3+sr(i*.7)*.2})`;
      c.fillRect(sr(i*4)*T,sr(i*4+1)*T,1,sr(i*4+2)*2+1);
    }
    // Linie betonu â€” dwie subtelne pÄ™kniÄ™cia
    c.strokeStyle='rgba(0,0,0,.25)';c.lineWidth=.5;
    c.beginPath();c.moveTo(sr(7)*T,sr(8)*T);c.lineTo(sr(7)*T+12,sr(8)*T+10);c.stroke();
  });
  makeTile('side',c=>{
    // 4 pĹ‚yty chodnikowe z rĂłĹĽnymi tonami (concrete)
    const cols=['#a8a098','#9c948c','#a4998f','#a09689'];
    const sub=T/2;
    for(let r=0;r<2;r++)for(let cc=0;cc<2;cc++){
      const idx=(r*2+cc+Math.floor(sr(r*3+cc*.7)*4))%4;
      c.fillStyle=cols[idx];
      c.fillRect(cc*sub,r*sub,sub,sub);
      // Cienie krawÄ™dzi pĹ‚yty
      c.fillStyle='rgba(0,0,0,.10)';
      c.fillRect(cc*sub,r*sub,sub,1);
      c.fillRect(cc*sub,r*sub,1,sub);
    }
    // Szczeliny miÄ™dzy pĹ‚ytami
    c.strokeStyle='rgba(50,45,40,.55)';c.lineWidth=1.5;
    c.beginPath();c.moveTo(T/2,0);c.lineTo(T/2,T);c.stroke();
    c.beginPath();c.moveTo(0,T/2);c.lineTo(T,T/2);c.stroke();
    // Drobne plamki / staroĹ›Ä‡
    for(let i=0;i<8;i++){
      c.fillStyle=`rgba(0,0,0,${0.05+sr(i*.4)*.1})`;
      c.beginPath();c.arc(sr(i*5)*T,sr(i*5+.3)*T,sr(i*5+.5)*1.5+0.5,0,Math.PI*2);c.fill();
    }
  });
  makeTile('road',c=>{
    // Base asfalt z gradientem
    const g=c.createLinearGradient(0,0,T,T);
    g.addColorStop(0,'#2c2c2c');g.addColorStop(.5,'#272727');g.addColorStop(1,'#2a2a2a');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    // Asfalt grain â€” jasne i ciemne kropki
    for(let i=0;i<40;i++){
      const dark=sr(i*.7)<.5;
      c.fillStyle=dark?`rgba(15,15,15,${0.4+sr(i*.9)*.3})`:`rgba(60,60,60,${0.18+sr(i*.4)*.2})`;
      c.fillRect(sr(i)*T,sr(i+.2)*T,1,1);
    }
    // Ĺšrednie kamyki
    for(let i=0;i<10;i++){
      c.fillStyle=`rgba(85,85,85,${0.25+sr(i*.13)*.2})`;
      c.fillRect(sr(i*.3)*T,sr(i*.4)*T,2,2);
    }
    // Cracks â€” drobne pÄ™kniÄ™cia (czarne linie)
    for(let i=0;i<3;i++){
      c.strokeStyle=`rgba(8,8,8,${0.5+sr(i)*.25})`;c.lineWidth=0.8;
      c.beginPath();
      const x0=sr(i*5)*T,y0=sr(i*5+.5)*T;
      c.moveTo(x0,y0);
      c.lineTo(x0+sr(i*5+.2)*16-8,y0+sr(i*5+.6)*16-8);
      c.lineTo(x0+sr(i*5+.4)*24-12,y0+sr(i*5+.8)*22-11);
      c.stroke();
    }
  });
  makeTile('roadm',c=>{
    c.fillStyle='#2a2a2a';c.fillRect(0,0,T,T);
    c.strokeStyle='#e0c040';c.lineWidth=3;c.setLineDash([18,14]);
    c.beginPath();c.moveTo(T/2,0);c.lineTo(T/2,T);c.stroke();c.setLineDash([]);
  });
  makeTile('wood',c=>{
    c.fillStyle='#7a5028';c.fillRect(0,0,T,T);
    const cols=['#8a6030','#9a7040','#7a5828','#906838'];
    for(let i=0;i<4;i++){c.fillStyle=cols[i];c.fillRect(0,i*12+1,T,11);}
    c.strokeStyle='rgba(0,0,0,.15)';c.lineWidth=1;
    for(let y=12;y<T;y+=12){c.beginPath();c.moveTo(0,y);c.lineTo(T,y);c.stroke();}
  });
  makeTile('wallp',c=>{
    c.fillStyle='#1e2e3e';c.fillRect(0,0,T,T);
    c.fillStyle='#18273a';
    for(let y=0;y<T;y+=6){for(let x=0;x<T;x+=6){if((Math.floor(x/6)+Math.floor(y/6))%2===0)c.fillRect(x,y,6,6);}}
  });
  makeTile('park',c=>{
    // Baza taka sama jak trawa ale jaĹ›niejsza/ĹĽywsza â€” park jest zadbany
    c.fillStyle='#2a6a2a';c.fillRect(0,0,T,T);
    // RĂłĹĽnorodna trawa parkowa
    for(let i=0;i<55;i++){c.fillStyle=sr(i*4+.2)<.35?'#22582a':'#347034';c.fillRect(sr(i*4)*T,sr(i*4+1)*T,2,sr(i*4+2)*3+2);}
    // Kwiaty / maĹ‚e biaĹ‚e punkty
    for(let i=0;i<5;i++){c.fillStyle='rgba(255,255,220,0.6)';c.beginPath();c.arc(sr(i*7+.1)*T,sr(i*7+.2)*T,1.5,0,Math.PI*2);c.fill();}
    // Ĺ»ĂłĹ‚te/rĂłĹĽowe kwiatki
    for(let i=0;i<3;i++){c.fillStyle=i%2===0?'rgba(255,220,60,.7)':'rgba(255,160,160,.6)';c.beginPath();c.arc(sr(i*11+.3)*T,sr(i*11+.4)*T,2,0,Math.PI*2);c.fill();}
  });
  makeTile('sand',c=>{
    c.fillStyle='#c8b070';c.fillRect(0,0,T,T);
    for(let i=0;i<20;i++){c.fillStyle=`rgba(0,0,0,${sr(i*.3)*.08})`;c.fillRect(sr(i)*T,sr(i+.1)*T,3,3);}
  });
  makeTile('water',c=>{
    const g=c.createLinearGradient(0,0,T,T);g.addColorStop(0,'#1a4a8a');g.addColorStop(1,'#1a3060');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    c.strokeStyle='rgba(100,160,220,.3)';c.lineWidth=1;
    for(let y=4;y<T;y+=8){c.beginPath();c.moveTo(0,y);c.lineTo(T,y);c.stroke();}
  });
  makeTile('hosp',c=>{c.fillStyle='#f0f0f0';c.fillRect(0,0,T,T);c.strokeStyle='#ddd';c.lineWidth=1;c.strokeRect(0,0,T,T);});
  makeTile('gym',c=>{
    // Rubber floor â€” dark gray with grip diamond pattern
    c.fillStyle='#1e1e1e';c.fillRect(0,0,T,T);
    c.fillStyle='#2a2a2a';
    for(let y=4;y<T;y+=8){for(let x=4;x<T;x+=8){c.fillRect(x,y,4,4);}}
    c.strokeStyle='rgba(255,80,0,.08)';c.lineWidth=1;
    c.beginPath();c.moveTo(0,T/2);c.lineTo(T,T/2);c.stroke();
  });
  makeTile('tile_beige',c=>{
    // Beige tiles â€” restauracja, fryzjer
    c.fillStyle='#d4c8b0';c.fillRect(0,0,T,T);
    c.strokeStyle='rgba(0,0,0,.12)';c.lineWidth=1;
    c.strokeRect(2,2,T/2-3,T/2-3);c.strokeRect(T/2+1,2,T/2-3,T/2-3);
    c.strokeRect(2,T/2+1,T/2-3,T/2-3);c.strokeRect(T/2+1,T/2+1,T/2-3,T/2-3);
  });
  makeTile('stage',c=>{
    c.fillStyle='#1a0a2a';c.fillRect(0,0,T,T);
    c.fillStyle='#3a1a6a';c.fillRect(2,2,T-4,T/2);
    for(let i=0;i<5;i++){c.fillStyle=`hsla(${i*60},100%,60%,.5)`;c.fillRect(i*(T/5),0,T/5,T);}
  });
  // Premium â€” jasny dÄ…b z teksturÄ… drewna
  makeTile('parquet',c=>{
    c.fillStyle='#c8b090';c.fillRect(0,0,T,T);
    c.fillStyle='#b8a080';c.fillRect(0,T/2,T,1);c.fillRect(T/2,0,1,T);
    for(let i=0;i<6;i++){c.fillStyle=`rgba(120,90,60,${0.10+sr(i*7)*0.18})`;c.fillRect(sr(i*3)*T,sr(i*3+1)*T,T*0.4,1);}
    c.strokeStyle='rgba(80,60,40,.25)';c.lineWidth=1;c.strokeRect(0,0,T/2,T/2);c.strokeRect(T/2,T/2,T/2,T/2);
  });
  // Casino carpet â€” bordowy dywan z zĹ‚otym wzorem
  makeTile('casino_carpet',c=>{
    c.fillStyle='#5a0a18';c.fillRect(0,0,T,T);
    // ZĹ‚oty wzĂłr rombowy
    c.fillStyle='rgba(200,165,32,.3)';
    c.beginPath();c.moveTo(T/2,4);c.lineTo(T-4,T/2);c.lineTo(T/2,T-4);c.lineTo(4,T/2);c.closePath();c.fill();
    // Subtelne ozdoby
    c.fillStyle='rgba(241,196,15,.15)';
    c.beginPath();c.arc(T/2,T/2,3,0,Math.PI*2);c.fill();
    c.strokeStyle='rgba(120,20,40,.5)';c.lineWidth=1;c.strokeRect(0,0,T,T);
  });
  // Penthouse â€” biaĹ‚y marmur z ĹĽyĹ‚ami
  makeTile('marble',c=>{
    c.fillStyle='#e8e2d4';c.fillRect(0,0,T,T);
    const g=c.createLinearGradient(0,0,T,T);g.addColorStop(0,'rgba(200,190,170,.4)');g.addColorStop(.5,'rgba(255,255,250,.1)');g.addColorStop(1,'rgba(180,170,150,.3)');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    c.strokeStyle='rgba(160,140,110,.4)';c.lineWidth=1;
    c.beginPath();c.moveTo(0,T*0.3);c.bezierCurveTo(T*0.3,T*0.5,T*0.6,T*0.2,T,T*0.4);c.stroke();
    c.beginPath();c.moveTo(T*0.2,T);c.bezierCurveTo(T*0.4,T*0.7,T*0.7,T*0.9,T,T*0.6);c.stroke();
    c.strokeStyle='rgba(200,170,80,.15)';c.beginPath();c.moveTo(0,T*0.7);c.lineTo(T,T*0.5);c.stroke();
  });
  // Park â€” klomb kwiatowy (gÄ™sty)
  makeTile('flowerbed',c=>{
    c.fillStyle='#3a2a18';c.fillRect(0,0,T,T);
    for(let i=0;i<28;i++){c.fillStyle=sr(i*5)<.4?'#5a3a20':'#2a1a08';c.fillRect(sr(i*3)*T,sr(i*3+1)*T,3,3);}
    // GÄ™ste kwiatki
    for(let i=0;i<14;i++){
      const cx=sr(i*7)*T, cy=sr(i*7+0.3)*T;
      const colors=['#e74c3c','#f39c12','#f1c40f','#9b59b6','#e91e63','#fff'];
      c.fillStyle=colors[i%6];
      c.beginPath();c.arc(cx,cy,2.2,0,Math.PI*2);c.fill();
      c.fillStyle='#f1c40f';c.beginPath();c.arc(cx,cy,0.8,0,Math.PI*2);c.fill();
    }
    // LiĹ›cie
    c.fillStyle='#1a5a2a';
    for(let i=0;i<8;i++){c.beginPath();c.ellipse(sr(i*9)*T,sr(i*9+.2)*T,2.5,1.2,sr(i)*Math.PI,0,Math.PI*2);c.fill();}
  });
  // Penthouse â€” ciemne Ĺ›ciany z zĹ‚otym akcentem
  makeTile('wallp_lux',c=>{
    c.fillStyle='#2a1a08';c.fillRect(0,0,T,T);
    c.fillStyle='#3a2810';c.fillRect(0,0,T,T*0.5);
    c.strokeStyle='#7a5a20';c.lineWidth=1;c.strokeRect(2,2,T-4,T-4);
    c.fillStyle='rgba(200,170,80,.18)';c.fillRect(0,T*0.5-1,T,2);
  });
  /* v2.0.11: VIP carpet â€” gold pattern na czarnym tle (premium) */
  makeTile('vip_carpet',c=>{
    c.fillStyle='#1a0606';c.fillRect(0,0,T,T);
    /* zĹ‚oty diamentowy wzĂłr */
    c.fillStyle='rgba(200,165,32,.18)';
    c.beginPath();
    c.moveTo(T/2,4);c.lineTo(T-4,T/2);c.lineTo(T/2,T-4);c.lineTo(4,T/2);
    c.closePath();c.fill();
    /* maĹ‚a gold kropka w Ĺ›rodku */
    c.fillStyle='rgba(255,215,0,.35)';
    c.beginPath();c.arc(T/2,T/2,2,0,Math.PI*2);c.fill();
    /* gradient subtle */
    c.fillStyle='rgba(0,0,0,.15)';c.fillRect(0,0,T,T*0.3);
  });
  /* v2.0.11: VIP marble â€” czarno-gold marble */
  makeTile('vip_marble',c=>{
    /* v2.0.19 fix: wracamy do estetyki starego marble (czarno-zĹ‚oty, ĹĽyĹ‚y) ALE z tileable design.
       Problem starego: linear gradient (0,0)â†’(T,T) i ĹĽyĹ‚y koĹ„czÄ…ce siÄ™ na krawÄ™dziach â†’ widoczne ciÄ™cia
       miÄ™dzy tilesami. Fix: RADIAL gradient od center (krawÄ™dzie tile jednolicie ciemne, znikajÄ… granice)
       + ĹĽyĹ‚y wewnÄ…trz tile (z paddingiem 10-15% od krawÄ™dzi, nie dotykajÄ… brzegu = nie widaÄ‡ ciÄ™Ä‡). */
    const g=c.createRadialGradient(T/2,T/2,T*0.1,T/2,T/2,T*0.75);
    g.addColorStop(0,'#241808');
    g.addColorStop(0.6,'#140e06');
    g.addColorStop(1,'#0a0a0a');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    /* gold veins WEWNÄ„TRZ tile (padding 10-15% od krawÄ™dzi) */
    c.strokeStyle='rgba(200,165,32,.28)';c.lineWidth=0.8;
    c.beginPath();
    c.moveTo(T*0.12, T*0.42);
    c.bezierCurveTo(T*0.32, T*0.55, T*0.68, T*0.25, T*0.88, T*0.50);
    c.stroke();
    c.beginPath();
    c.moveTo(T*0.28, T*0.85);
    c.bezierCurveTo(T*0.42, T*0.62, T*0.58, T*0.78, T*0.72, T*0.18);
    c.stroke();
  });
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  DEKORACYJNE BLOKI â€” kolizja + rysowanie (dane wspĂłlne)
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
const DB_DECORATIVE=[
  // NORTH wy=133 â€” Z1: Traphouse(90-250) + DB(275-425) + DB(450-600) + DB maĹ‚y(625-660) + V1 chodnik(672)
  // RĂłwne gapy 25px miÄ™dzy wszystkimi blokami; maĹ‚y blok w wolnej przestrzeni przy V1
  {wx:275,wy:133,w:150,h:155,c:'#28201a'},
  {wx:450,wy:133,w:150,h:155,c:'#1e2a1e'},
  {wx:625,wy:133,w:35,h:155,c:'#1c2832'},
  // NORTH wy=133 â€” Z2: muzyczny(1080-1228) + silownia(1248-1396) + DB(1416-1456) + mediamarkt(1476-1624) + studio(1644-1792) + DB(1812-2092)
  {wx:1812,wy:133,w:280,h:155,c:'#181e28'},
  // NORTH wy=133 â€” Z3: DB(2510-2660 = 150) + ubrania(2680-2828) + DB(2848-2998 = 150) + salon(3010-3158) + DB(3178-3328 = 150)
  // Symetryczne gapy 20px po obu stronach kaĹĽdego budynku
  {wx:2510,wy:133,w:150,h:155,c:'#222a1e'},   // przed ubrania (gap 20)
