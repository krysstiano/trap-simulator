      <span class="chip" style="background:rgba(231,126,34,.2);color:#e67e22;margin-left:6px">đźŤ´ GĹ‚Ăłd: ${Math.floor(G.hunger||0)}/${typeof getMaxStat==='function'?getMaxStat('hunger'):100}</span>
      <span class="chip" style="background:rgba(241,196,15,.2);color:#f1c40f;margin-left:6px">âšˇ Energia: ${Math.floor(G.energy||0)}/${typeof getMaxStat==='function'?getMaxStat('energy'):100}</span>
    </p>
    <div style="text-align:center;color:#c8a520;font-size:13px;letter-spacing:3px;text-transform:uppercase;margin:8px 0 6px;font-weight:700">đźŤ· DRINKI</div>
    <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;margin:6px 0 18px">
      ${drinks.map(d=>`<div onclick="window.casinoBuyDrink('${d.id}',${d.cost},${d.mood},${d.energy})" style="cursor:pointer;background:linear-gradient(150deg,${d.bg},rgba(8,12,24,0.7));border:1px solid ${d.accent}66;border-radius:14px;padding:18px 14px;width:140px;text-align:center;transition:all .25s cubic-bezier(0.22,0.61,0.36,1);backdrop-filter:blur(8px);box-shadow:0 8px 24px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);position:relative;overflow:hidden" onmouseover="this.style.transform='translateY(-4px) scale(1.03)';this.style.boxShadow='0 14px 36px rgba(0,0,0,.55),0 0 22px ${d.accent}40,inset 0 1px 0 rgba(255,255,255,.08)';this.style.borderColor='${d.accent}'" onmouseout="this.style.transform='';this.style.boxShadow='0 8px 24px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04)';this.style.borderColor='${d.accent}66'">
        <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,${d.accent}80,transparent)"></div>
