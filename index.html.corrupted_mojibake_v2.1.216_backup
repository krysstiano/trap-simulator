  /* v2.1.213 [Amper]: Tier 1-2 milestone events (Faza C fame redesign). Wszystkie z phoneSpot wymogiem + fame tier gating. */
  /* Tier 1 Rising (fame 100+) — Documentary one-time event */
  {name:'Documentary offer', chance:0.005, maxPerDay:1,
