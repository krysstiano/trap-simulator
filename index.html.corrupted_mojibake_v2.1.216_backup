}

// Hazard (UKRYTE) â€” szansa kasyno (przyszĹ‚oĹ›Ä‡)
function getHazardLuckBonus(){
  return 1 + _sk('hazard')*0.10 + _pu('hazard')*0.20 + _evo('hazard')*0.50;
}

// Kreatywnosc â€” jakoĹ›Ä‡ projektĂłw (skill +30%, PU +15/30/50%, Evo: nieoczekiwany hit osobno)
function getKreatywnoscQualityBonus(){
  return 1 + _sk('kreatywnosc')*0.10 + _pu('kreatywnosc')*0.15 + _evo('kreatywnosc')*0.25;
}

// Logika â€” bonus zarobkĂłw karier dziaĹ‚a wewnÄ…trz getKarieraBonus (linia 1340), brak osobnej funkcji
// (poprzednia getLogikaSpeedBonus usuniÄ™ta v2.1.29 jako dead code)

// Skupienie â€” bonus jakoĹ›ci aktywnoĹ›ci (skill +15%, PU +15/30/45%, Evo +25%)
function getSkupienieFocusBonus(){
  return 1 + _sk('skupienie')*0.05 + _pu('skupienie')*0.15 + _evo('skupienie')*0.25;
}

// v2.1.196: PU faktycznie +15/30/45% cumulative (NIE 50%). Evo +30%, skill +5%/pkt max 15% (max:3).
// Foto â€” bonus zasiÄ™gu IG
function getFotoQualityBonus(){
  return 1 + _sk('foto')*0.05 + _pu('foto')*0.15 + _evo('foto')*0.30;
}

// Flow â€” score freestyle (skill +25%, PU +15/30/50%, Evo +50%)
function getFlowFreestyleBonus(){
