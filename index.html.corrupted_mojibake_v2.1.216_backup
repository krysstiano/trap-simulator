window.heal=(amount)=>{
  /* v2.1.113: Wave 2 W13 â€” cooldown 30 min gry miÄ™dzy heal calls (anti-spam, gracz musi czekaÄ‡ miÄ™dzy wizytami). */
  const _nowAbs=(G.day||1)*1440 + (gameMin||0);
  const _lastAbs=G._lastHealAbs||-9999;
  if(_nowAbs-_lastAbs<30){
    const _m=Math.ceil(30-(_nowAbs-_lastAbs));
    document.getElementById('shop-res').textContent=`âŹł Lekarz potrzebuje ${_m} min gry ĹĽeby przygotowaÄ‡ nastÄ™pny zabieg`;return;
  }
  const cost=amount===30?Math.floor((100-G.health)*3):Math.floor((100-G.health)*8);
  if(G.money<cost){document.getElementById('shop-res').textContent='Za maĹ‚o pieniÄ™dzy!';return;}
  G.money-=cost;
  G.health=amount===30?clampStat('health', G.health+30):100;
  G._lastHealAbs=_nowAbs;
  document.getElementById('shop-res').textContent=`đź’Š Wyleczono! Zdrowie: ${Math.floor(G.health||0)}/${typeof getMaxStat==='function'?getMaxStat('health'):100}`;renderHospital();
};
window.therapy=()=>{
  // v1.8.55: cooldown 1Ă—/dzieĹ„ gry (poprzednio gracz mĂłgĹ‚ spamiÄ‡ aĹĽ do nastroju 100, pĹ‚acÄ…c po 200 zĹ‚)
  if(G._lastTherapyDay===G.day){if(typeof showMsg==='function') showMsg('đź§ JuĹĽ dziĹ› byĹ‚eĹ› u terapeuty â€” wrĂłÄ‡ jutro','r');return;}
  if(G.money<200) return;G.money-=200;G.stress=clamp(G.stress+50,0,100);G._lastTherapyDay=G.day;
  document.getElementById('shop-res').textContent='đź§ Terapia zakoĹ„czona! +50 nastrĂłj';renderHospital();
};
window.buyCar=(name,speed,price)=>{
  if(G.car&&G.car.name===name){notify('JuĹĽ masz ten samochĂłd!');return;}
  G._ownedCars=G._ownedCars||[];
  const firstTime=!G._ownedCars.includes(name);
  // JeĹ›li ma juĹĽ w garaĹĽu â€” przesiada siÄ™ bez pĹ‚acenia
  if(firstTime){
    if(G.money<price){notify('Za maĹ‚o pieniÄ™dzy!');return;}
    G.money-=price;
    G._ownedCars.push(name);
  }
  G.car={name,speed,price};
  // F+ 2026-05-12: auto auto-wsiada gracza ĹĽeby byĹ‚o widaÄ‡ ĹĽe auto kupione (bugfix: gracze nie widzieli auta po zakupie)
  G._inCar=true;
  // Bonusy sĹ‚awy tylko za pierwszy zakup
  if(firstTime){
    const fameBonus={'BMW E46':5,'Audi RS6':10,'Tesla Model S Plaid':12,'Porsche 911':15,'Lamborghini':25,'Ferrari':30,'Rolls-Royce Phantom':40,'Bugatti Chiron':50}[name]||0; /* v2.1.148: Tesla +12, Rolls +40 */
    /* v2.1.99: Prestige fameMult przez addFame() (Wave 1 K6 cars first-buy bypass fix) */
    if(fameBonus){if(typeof addFame==='function')addFame(fameBonus);else G.fame=clamp(G.fame+fameBonus,0,500);notify(`đźš— ${name} kupiony! +${fameBonus} sĹ‚awy`);}
    notify(`đźš— Wsiadasz do ${name}. Po wyjĹ›ciu na ulicÄ™ uĹĽyj auta â€” boost prÄ™dkoĹ›ci. WyjdĹş na parkingu by zaparkowaÄ‡.`);
    // CINEMATIC dla zakupu auta â€” luxury auta (BMW+) dramatycznie, podstawowe lakonicznie
    const carEmoji={'Maluch':'đźš—','Seat Ibiza':'đźš™','BMW E46':'đźŹŽď¸Ź','Audi RS6':'đźŹ','Porsche 911':'đźŹŽ','Lamborghini':'đźŹŽď¸Ź','Ferrari':'đźŽ','Bugatti Chiron':'âšˇ'}[name]||'đźš—';
    const isLux=['BMW E46','Audi RS6','Porsche 911','Lamborghini','Ferrari','Bugatti Chiron'].includes(name);
    showMilestoneCinematic({
      emoji:carEmoji,
      title:'NOWE AUTO',
      subtitle:name,
      tagline:isLux?`PrÄ™dkoĹ›Ä‡ Ă—${speed} Â· +${fameBonus} sĹ‚awy Â· NaciĹ›nij V aby wsiÄ…Ĺ›Ä‡`:`PrÄ™dkoĹ›Ä‡ Ă—${speed} Â· NaciĹ›nij V aby wsiÄ…Ĺ›Ä‡`,
      accentColor:isLux?'#c8a520':'#7ec8e3',
      accent2:isLux?'#e91e8c':'#3498db',
      duration:isLux?4500:3500,
    });
  } else {
    notify(`đźš— ${name} â€” przesiadasz siÄ™`);
  }
  renderSalon();
};
window.performConcert=(name,cost,fameReq,earnMin,earnMax)=>{
  // v1.8.18: jawne komunikaty zamiast silent return (user nie wiedziaĹ‚ czemu rezerwacja nie dziaĹ‚a).
  if(G.money<cost){showMsg(`đźŽ¤ Brak ${cost-G.money} zĹ‚ na wynajem sceny`,'r');return;}
  if(G.fame<fameReq){showMsg(`đźŽ¤ Za maĹ‚o sĹ‚awy (${Math.floor(G.fame||0)}/${fameReq})`,'r');return;}
  /* v2.1.89 Amper: HARD DAILY LIMIT 3 koncerty/dzieĹ„ + jasny komunikat PRZED graniem.
     Sprawdzane przed cooldownem i kosztem ĹĽeby gracz nie traciĹ‚ kasy na blokowany koncert. */
  const _concDay = (G._concertsCounter && G._concertsCounter.day === G.day) ? G._concertsCounter.count : 0;
  if(_concDay >= 3){
    showMsg(`đźŽ¤ Maks 3 koncerty dziennie â€” publicznoĹ›Ä‡ potrzebuje odpoczynku. WrĂłÄ‡ jutro.`,'r',5000);
    return;
  }
  /* v2.1.87 Amper: BUGFIX cooldownu koncertĂłw â€” absolutny timestamp (gameMin "wraps" przy G.day++).
     Cooldown 240 min gry (~1 min real) â€” krĂłtki ale wymusza odstÄ™p miÄ™dzy koncertami. */
  const _nowAbs=(G.day||1)*1440 + (gameMin||0);
  const _lastAbs=G._lastConcertAbs||-9999;
  if(_nowAbs-_lastAbs<240){
    const _h=Math.ceil((240-(_nowAbs-_lastAbs))/60);
    showMsg(`đźŽ¤ Niedawno graĹ‚eĹ› koncert â€” odpocznij ${_h}h przed kolejnym`,'r');return;
  }
  /* v2.1.90 Amper: JASNE OSTRZEĹ»ENIE z aktualnymi % payoutu (50%/75%). */
  if(_concDay === 1){
    if(typeof showMsg==='function') showMsg(`âš ď¸Ź Drugi koncert dziĹ› â€” publicznoĹ›Ä‡ zmÄ™czona. Payout 50%.`,'w',4000);
  } else if(_concDay === 2){
    if(typeof showMsg==='function') showMsg(`âš ď¸Ź Trzeci (ostatni) koncert dziĹ› â€” publicznoĹ›Ä‡ wraca. Payout 75%. NastÄ™pny dopiero jutro.`,'w',4000);
  }
  G._lastConcertAbs=_nowAbs;
  G._lastConcertMin=gameMin||0; /* legacy field zachowane dla kompat */
  G.money-=cost;
  closeOverlay();
  startConcertMG(name,cost,fameReq,earnMin,earnMax);
};

function startConcertMG(name,cost,fameReq,earnMin,earnMax){
  const panel=document.getElementById('mg-job');
  // Reset inline display="none" pozostawione przez closeMG/_jobMgCleanup zeby CSS .on (display:flex) zadzialal
  panel.style.display='';
  panel.classList.add('on');
  _jobPanelSession++;
  // Defensywnie: zapewnij ze mg-job-content istnieje (poprzedni job mogl je usunac)
  if(!document.getElementById('mg-job-content')){
    panel.innerHTML='<div id="mg-job-content" style="display:flex;flex-direction:column;align-items:center;width:100%"></div>';
  }
  // v1.8.16: HIT_WINDOW zwiÄ™kszone z 90 do 180ms + synchronizacja wizualna (note dochodzi do hit zone)
  const LANES=4,DURATION=30000,NOTE_INTERVAL=700,HIT_WINDOW=180,NOTE_TRAVEL=900;
  const LANE_KEYS=['a','s','d','f'],LANE_COLORS=['#e74c3c','#3498db','#2ecc71','#f39c12'];
  const LANE_LABELS=['A','S','D','F'];
  let notes=[],combo=0,maxCombo=0,hits=0,misses=0,hype=0,score=0,playing=true,animId=null;
  let gameStart=Date.now(),lastNote=0;
  // Wybierz losowy utwĂłr z BGM_LIST jako muzykÄ™ koncertu
  const concertTrackIdx=Math.floor(Math.random()*BGM_LIST.length);
  const concertTrack=BGM_LIST[concertTrackIdx];
  // Pauzuj gĹ‚Ăłwny BGM podczas koncertu
  const _bgmWasPlaying=bgmEnabled && bgmAudio && !bgmAudio.paused;
  if(bgmAudio) bgmAudio.pause();
  // v1.9.12: StwĂłrz/reuse audio dla koncertu â€” cache per URL (poprzednio nowy fetch przy kaĹĽdym koncercie)
  let concertAudio=null;
  try{
    if(!window._concertAudioCache) window._concertAudioCache={};
    if(!window._concertAudioCacheUsage) window._concertAudioCacheUsage={};
    if(window._concertAudioCache[concertTrack.url]){
      concertAudio=window._concertAudioCache[concertTrack.url];
      concertAudio.currentTime=0;
      window._concertAudioCacheUsage[concertTrack.url]=Date.now(); /* v2.1.111: W56 update LRU timestamp on use */
    } else {
      concertAudio=new Audio(concertTrack.url);
      concertAudio.crossOrigin='anonymous'; // set tylko przy tworzeniu (re-set = re-fetch)
      window._concertAudioCache[concertTrack.url]=concertAudio;
      window._concertAudioCacheUsage[concertTrack.url]=Date.now();
      // v1.9.15: LRU cache cap 3 (poprzednio unbounded â€” ~6MB/track Ă— 11 tracks = potencjalnie >60MB w pamiÄ™ci)
      // v2.1.111: Wave 5 W56 â€” prawdziwy LRU (timestamp-based) zamiast FIFO. WczeĹ›niej _cKeys[0] = first-inserted, niezaleĹĽnie od uĹĽycia.
      const _cKeys=Object.keys(window._concertAudioCache);
      if(_cKeys.length>3){
        /* ZnajdĹş klucz z najstarszym timestampem (least recently used) */
        let _oldest=_cKeys[0];
        let _oldestTime=window._concertAudioCacheUsage[_oldest]||0;
        for(const k of _cKeys){
          const t=window._concertAudioCacheUsage[k]||0;
          if(t<_oldestTime){_oldest=k;_oldestTime=t;}
        }
        try{window._concertAudioCache[_oldest].pause();}catch(e){}
        delete window._concertAudioCache[_oldest];
        delete window._concertAudioCacheUsage[_oldest];
      }
    }
    // v1.9.15: Volume clamped do [0,1] + respektuje bgmEnabled
    concertAudio.volume=bgmEnabled?Math.min(1,Math.max(0.25,bgmVolume*2)):0;
    concertAudio.play().catch(()=>{
      /* v2.1.116: Wave 5 S42 â€” concert audio fail z visible komunikatem (wczeĹ›niej silent). */
      if(typeof showMsg==='function') showMsg('đź”‡ Nie udaĹ‚o siÄ™ zaĹ‚adowaÄ‡ podkĹ‚adu (sieÄ‡). Koncert leci bez muzyki.','w',3000);
    });
  }catch(e){}

  const CROWD_SIZE=earnMax>=15000?'đźŹźď¸Ź Arena':earnMax>=3000?'đźŽŞ Klub':'đźŽ¤ MaĹ‚a scena';
  const CROWD_COUNT=earnMax>=15000?5000:earnMax>=3000?500:50;

  const warnBars=[];
  if((G.stress||0)<30) warnBars.push('<div style="width:100%;background:rgba(200,50,50,.15);border:1px solid #c0392b;border-radius:4px;padding:4px 10px;color:#e74c3c;font-size:11px">đź“ Niski nastrĂłj â€” Hype odpĹ‚ywa szybciej</div>');
  if((G.sleepDebt||0)>=3) warnBars.push('<div style="width:100%;background:rgba(100,50,200,.12);border:1px solid #6c3483;border-radius:4px;padding:4px 10px;color:#9b59b6;font-size:11px">đź´ NiedobĂłr snu ('+G.sleepDebt+'/5) â€” JakoĹ›Ä‡ obniĹĽona</div>');
  document.getElementById('mg-job-content').innerHTML=`
    <div id="cg-wrap" style="display:flex;flex-direction:column;align-items:center;gap:6px;width:100%;max-width:560px;user-select:none">
      ${warnBars.join('')}
      <div style="display:flex;justify-content:space-between;width:100%;align-items:center;padding:0 4px">
        <div style="color:#9b59b6;font-size:15px;font-weight:700">${CROWD_SIZE} â€” ${name}</div>
        <div style="color:#f1c40f;font-size:14px">Score: <span id="cg-score">0</span></div>
      </div>
      <div style="width:100%;text-align:center;color:#7ec8e3;font-size:12px;font-style:italic">đźŽµ Now playing: ${concertTrack.name}</div>
      <!-- Hype meter -->
      <div style="width:100%;height:14px;background:#0a0a14;border-radius:7px;overflow:hidden;position:relative">
        <div id="cg-hype" style="height:100%;width:0%;background:linear-gradient(90deg,#9b59b6,#e91e8c);transition:width .1s;border-radius:7px"></div>
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:10px;color:#fff;font-weight:700">HYPE</div>
      </div>
      <!-- Stage visual -->
      <div style="width:100%;height:90px;background:linear-gradient(180deg,#0a0014 0%,#1a0028 40%,#2a0040 100%);border-radius:8px;position:relative;overflow:hidden;border:1px solid #3a0060">
        <!-- Spotlights -->
        <div class="spotlight-anim" style="position:absolute;top:0;left:20%;width:80px;height:90px;background:radial-gradient(ellipse at 50% 0,rgba(255,200,0,.22),transparent 70%);pointer-events:none;transform-origin:top center"></div>
        <div class="spotlight-anim" style="position:absolute;top:0;left:50%;width:80px;height:90px;background:radial-gradient(ellipse at 50% 0,rgba(255,100,200,.22),transparent 70%);pointer-events:none;transform-origin:top center;animation-delay:.7s"></div>
        <div class="spotlight-anim" style="position:absolute;top:0;left:70%;width:80px;height:90px;background:radial-gradient(ellipse at 50% 0,rgba(100,200,255,.22),transparent 70%);pointer-events:none;transform-origin:top center;animation-delay:1.4s"></div>
        <!-- Crowd figures -->
        <div id="cg-crowd" style="position:absolute;bottom:4px;left:0;right:0;display:flex;justify-content:space-around;padding:0 10px;font-size:14px;opacity:0.8">${Array.from({length:Math.min(25,Math.floor(CROWD_COUNT/10)+8)},(_,i)=>`<span style="filter:hue-rotate(${i*37}deg)">đź‘¤</span>`).join('')}</div>
        <!-- Stage floor -->
        <div style="position:absolute;bottom:0;left:0;right:0;height:12px;background:linear-gradient(0deg,#5a3a00,#8a6a20);border-top:2px solid #c8a520"></div>
        <!-- Artist -->
        <div style="position:absolute;bottom:12px;left:50%;transform:translateX(-50%);font-size:24px">đźŽ¤</div>
        <div id="cg-effect" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:20px;font-weight:900;opacity:0;transition:opacity .1s;pointer-events:none"></div>
      </div>
      <!-- Note lanes -->
      <div style="width:100%;height:200px;position:relative;background:#060a10;border-radius:8px;border:1px solid #1a1a2a;overflow:hidden">
        <!-- Lane dividers -->
        ${LANE_COLORS.map((_,i)=>`<div style="position:absolute;left:${i*25+0.5}%;width:0.5%;height:100%;background:rgba(255,255,255,.05);top:0"></div>`).join('')}
        <!-- Hit zones -->
        ${LANE_COLORS.map((c,i)=>`<div id="cg-hz-${i}" style="position:absolute;bottom:20px;left:${i*25+1}%;width:23%;height:40px;border:2px solid ${c}44;border-radius:6px;background:${c}11"></div>`).join('')}
        <!-- Notes container -->
        <div id="cg-notes" style="position:absolute;inset:0;pointer-events:none"></div>
        <!-- Lane buttons (click) -->
        ${LANE_COLORS.map((c,i)=>`<div onclick="window._cgHit&&window._cgHit(${i})" style="position:absolute;bottom:0;left:${i*25}%;width:25%;height:70px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:4px">
          <div id="cg-btn-${i}" style="width:44px;height:44px;border-radius:50%;background:${c}33;border:3px solid ${c}66;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:${c};transition:all .08s">${LANE_LABELS[i]}</div>
        </div>`).join('')}
      </div>
      <div style="display:flex;gap:20px;font-size:13px;color:#888">
        <span>Combo: <b id="cg-combo" style="color:#f1c40f">0x</b></span>
        <span>TrafieĹ„: <b id="cg-hits" style="color:#2ecc71">0</b></span>
        <span>SpĂłĹşnieĹ„: <b id="cg-miss" style="color:#e74c3c">0</b></span>
        <span>Czas: <b id="cg-time" style="color:#3498db">${Math.ceil(DURATION/1000)}s</b></span>
      </div>
      <p style="color:#666;font-size:12px">Klawiatura: A/S/D/F lub klikaj przyciski</p>
      <button class="cbtn" id="cg-quit" onclick="if(window._cgQuit)window._cgQuit()">â† Przerwij</button>
    </div>`;

  function spawnNote(){
    const lane=Math.floor(Math.random()*LANES);
    const el=document.createElement('div');
    el.dataset.lane=lane;el.dataset.time=Date.now()+NOTE_TRAVEL;
    el.style.cssText=`position:absolute;width:${23}%;left:${lane*25+1}%;top:-24px;height:24px;border-radius:6px;background:${LANE_COLORS[lane]};box-shadow:0 0 8px ${LANE_COLORS[lane]};transition:top .02s linear`;
    document.getElementById('cg-notes').appendChild(el);
    notes.push(el);
  }

  function updateNotes(){
    const elapsed=Date.now()-gameStart;
    const frac=elapsed/DURATION;
    // v1.8.16: note CENTER dociera do hit zone CENTER (top=148) gdy tLeft=0
    // Hit zone: bottom:20, height:40 â†’ top=140..180, center=160. Note height=24 â†’ center top=148.
    const noteTargetTop=148;
    notes.forEach((n,i)=>{
      const nt=+n.dataset.time;
      const tLeft=nt-Date.now();
      const pct=1-(tLeft/NOTE_TRAVEL);
      n.style.top=Math.max(-24,pct*(noteTargetTop+24)-24)+'px';
      if(tLeft<-280){// missed (notatka znacznie minÄ™Ĺ‚a hit zone)
        n.remove();notes.splice(i,1);
        combo=0;misses++;
        hype=Math.max(0,hype-8);
        const el=document.getElementById('cg-miss');if(el)el.textContent=misses;
        const cb=document.getElementById('cg-combo');if(cb)cb.textContent='0x';
        showHypeEffect('âťŚ',0);
      }
    });
    // Hype drain â€” low mood drains faster
    const moodDrain=G.stress<30?0.07:G.stress<60?0.055:0.04;
    hype=Math.max(0,hype-moodDrain);
    document.getElementById('cg-hype').style.width=hype+'%';
    // Crowd animation: bounce when hype>60, max emoji when hype>=90
    const crowdEl=document.getElementById('cg-crowd');
    if(crowdEl){
      if(hype>=90){if(!crowdEl.classList.contains('crowd-hype')){crowdEl.classList.add('crowd-hype');}
        crowdEl.querySelectorAll('span').forEach(s=>{if(s.textContent==='đź‘¤')s.textContent='đź™Ś';});}
      else if(hype>=60){crowdEl.classList.add('crowd-hype');
        crowdEl.querySelectorAll('span').forEach(s=>{if(s.textContent==='đź™Ś')s.textContent='đź‘¤';});}
      else{crowdEl.classList.remove('crowd-hype');
        crowdEl.querySelectorAll('span').forEach(s=>{if(s.textContent==='đź™Ś')s.textContent='đź‘¤';});}
    }
    // Spawn
    if(Date.now()-lastNote>NOTE_INTERVAL*(0.7+0.3*(1-frac))){spawnNote();lastNote=Date.now();}
    // Timer
    const rem=Math.max(0,Math.ceil((DURATION-elapsed)/1000));
    const tEl=document.getElementById('cg-time');if(tEl)tEl.textContent=rem+'s';
    if(elapsed>=DURATION){endConcert();return;}
    animId=requestAnimationFrame(updateNotes);
  }

  function showHypeEffect(text,color){
    const ef=document.getElementById('cg-effect');if(!ef)return;
    ef.textContent=text;ef.style.color=color||'#f1c40f';ef.style.opacity='1';
    setTimeout(()=>{if(ef)ef.style.opacity='0';},400);
  }

  window._cgHit=(lane)=>{
    if(!playing) return;
    const now=Date.now();
    const btn=document.getElementById('cg-btn-'+lane);
    if(btn){btn.style.background=LANE_COLORS[lane]+'88';btn.style.transform='scale(0.9)';setTimeout(()=>{if(btn){btn.style.background=LANE_COLORS[lane]+'33';btn.style.transform='scale(1)';}},80);}
    let hit=false;
    for(let i=notes.length-1;i>=0;i--){
      const n=notes[i];if(+n.dataset.lane!==lane) continue;
      const tLeft=+n.dataset.time-now;
      if(Math.abs(tLeft)<HIT_WINDOW){
        n.remove();notes.splice(i,1);
        hits++;combo++;maxCombo=Math.max(maxCombo,combo);
        const mult=hype>=100?2:1+combo*0.05;
        score+=Math.floor(100*mult);
        hype=Math.min(100,hype+(tLeft<30?12:8));
        const el=document.getElementById('cg-hits');if(el)el.textContent=hits;
        const cb=document.getElementById('cg-combo');if(cb)cb.textContent=combo+'x';
        const sc=document.getElementById('cg-score');if(sc)sc.textContent=score.toLocaleString('pl');
        showHypeEffect(combo>=10?'đź”Ą '+combo+'x COMBO!':combo>=5?'đź’Ą '+combo+'x':combo>1?combo+'x':'âś…',LANE_COLORS[lane]);
        if(hype>=100) showHypeEffect('đźŚź CROWD GOES WILD!','#f1c40f');
        hit=true;break;
      }
    }
    if(!hit){combo=0;const cb=document.getElementById('cg-combo');if(cb)cb.textContent='0x';}
  };

  function endConcert(){
    playing=false;cancelAnimationFrame(animId);
    window.removeEventListener('keydown',onKey);
    // Stop concert audio + restore main BGM
    if(concertAudio){try{concertAudio.pause();}catch(e){}concertAudio=null;} /* v1.9.12: NIE czyĹ›Ä‡ src â€” zachowaj w cache window._concertAudioCache */
    if(_bgmWasPlaying && bgmAudio){try{bgmAudio.play().catch(()=>{});}catch(e){}}
    const accuracy=hits+misses>0?Math.round(hits/(hits+misses)*100):0;
    const fame_mult=Math.min(1.0,G.fame/100); /* v2.1.212: clamp 1.0 — fame >100 NIE eksploduje koncert. */
    // follower_mult max 1.5 (byĹ‚o 2.0) â€” top fan count nie powinien podwajaÄ‡ zarobkĂłw
    const follower_mult=clamp(G.followers/10000,0.5,1.5);
    // v1.9.10: perfMult â€” hype skaluje pĹ‚ynnie zamiast cliff (50â†’1.05, 80â†’1.15, 100â†’1.2). WczeĹ›niej tylko hype=100 dawaĹ‚o bonus.
    const _hypeMult=hype>=100?1.2:hype>=80?1.15:hype>=50?1.05:1;
    const perfMult=accuracy/100*(1+maxCombo*0.002)*_hypeMult;
    /* v2.1.124: Wave 7 S58 â€” venue size mult (MaĹ‚a 1.0Ă—, Klub 1.05Ă—, Arena 1.10Ă— â€” wczeĹ›niej tylko dekoracyjne crowd_size, teraz subtle wpĹ‚yw na payout). */
    const _venueMult = earnMax>=15000?1.10:earnMax>=3000?1.05:1.0;
    let earn=Math.floor(rnd(earnMin,earnMax)*Math.max(0.3,fame_mult)*follower_mult*Math.max(0.05,perfMult)*_venueMult);
    /* v2.1.83 Amper: NERF mnoĹĽnikĂłw koncertĂłw â€” max stack Ă—9 â†’ ~Ă—3-4 (faktycznie po wszystkich nerfach: outfit Ă—1.05-1.10 Ă— scena Ă—1.15-1.25 Ă— drip Ă—1.10 Ă— management Ă—1.2 Ă— holiday Ă—1.5-2.0 = ~3.5-4.5Ă—). v2.1.122 BUFF Sylwester Ă—2.0/MajĂłwka Ă—1.5 + outfit do match UI = max stack ~5-6. v2.1.123: docs poprawione. */
    if(G.outfit.top==='music') earn=Math.floor(earn*1.05);
    /* v2.1.102: BUFF kod do match UI (Wave 5 W51/W52) â€” UI obiecuje designer_concert +15%, smoking +10%. v2.1.83 zrobiĹ‚ nerf BEZ aktualizacji UI. Decyzja: BUFF kod ĹĽeby pasowaĹ‚ do obietnicy UI (NIE zamiataÄ‡ pod dywan). */
    else if(G.outfit.top==='designer_concert') earn=Math.floor(earn*1.15); // BUFF v2.1.102 (matching UI "+15%")
    else if(G.outfit.top==='smoking') earn=Math.floor(earn*1.10); // BUFF v2.1.102 (matching UI "+10%")
    else if(G.outfit.top==='suit') earn=Math.floor(earn*1.05);
    /* v2.1.102: Wave 7 W70 â€” Sport/Luxury/Zimowa/Jeansowa outfits brakowaĹ‚y case'Ăłw concert mult. ZAIMPLEMENTUJ (NIE zamiataÄ‡). */
    else if(G.outfit.top==='sport') earn=Math.floor(earn*1.03); // maĹ‚y bonus â€” sport casual na koncercie
    else if(G.outfit.top==='sport_pro') earn=Math.floor(earn*1.05);
    else if(G.outfit.top==='luxury') earn=Math.floor(earn*1.12); // luxury drip â€” concert bonus
    else if(G.outfit.top==='zimowa') earn=Math.floor(earn*1.02); // zimowa â€” odrobinka jeĹ›li koncert w mrozie
    else if(G.outfit.top==='jeansowa') earn=Math.floor(earn*1.04); // street vibe
    /* v2.1.148: 3 nowe outfity koncert bonusy */
    else if(G.outfit.top==='tracksuit') earn=Math.floor(earn*1.02); // casual
    else if(G.outfit.top==='leather_jacket') earn=Math.floor(earn*1.06); // rock vibe
    else if(G.outfit.top==='designer_hoodie') earn=Math.floor(earn*1.08); // premium streetwear
    /* v2.1.216 [Amper]: Crown of Hip-Hop (Tier 4 GOAT exclusive outfit) +20% concert earn */
    else if(G.outfit.top==='crown_of_hh') earn=Math.floor(earn*1.20);
    if(G.managementDeal) earn=Math.floor(earn*Math.min(1.2,G.managementBonus||1)); // cap 1.2
    const scenaBonus=getRaperST('scena');
    if(scenaBonus>=4) earn=Math.floor(earn*1.25);      // v2.1.83: 1.4â†’1.25
    else if(scenaBonus>=3) earn=Math.floor(earn*1.15); // v2.1.83: 1.25â†’1.15
    else if(scenaBonus>=2) earn=Math.floor(earn*1.08); // v2.1.83: 1.10â†’1.08
    // F3-FIX: SCENA skill (drzewko gl) â€” bonus zarobkow koncertu (max +25% przy lvl 5)
    earn=Math.floor(earn*getScenaEnergyBonus());
    /* v2.1.209 [Amper]: PU "Personal brand" (Autopromocja 4) rozszerza cap z +20% do +30%.
       Bez PU: drip 200 = +20% max. Z PU: cap rozszerzony do +30% max (getEffectiveDrip mnoĹĽy Ă—1.5 wewnÄ™trznie). */
    const dripMultC=1+Math.min(0.30,(typeof getEffectiveDrip==='function'?getEffectiveDrip():(G.drip||0))*0.001);
    earn=Math.floor(earn*dripMultC);
    // v1.8.96: Holiday MajĂłwka/Sylwester (v2.1.83 nerf â€” patrz holidayBonus function)
    const holConcertMult=typeof holidayBonus==='function'?holidayBonus('concert'):1;
    if(holConcertMult>1) earn=Math.floor(earn*holConcertMult);
    /* v1.8.97: PrzyjaĹşĹ„ z Marcinem (organizator koncertĂłw) â€” bonus zarobkĂłw koncertowych.
       v2.1.183 (Agent NPC audit): usuniÄ™ty dead code `getFriendshipBonus('crew')` â€” kontakt 'crew' NIGDY nie byĹ‚ inkrementowany w `addFriendship('crew',...)` ani `G.npcFriendship.crew +=`, zawsze zwracaĹ‚ 1.0. G.crew (lokalna ekipa DJ/grafik/hype) to osobny system nie uĹĽywajÄ…cy friendship. Marcin bonus jest jedyny. */
    const _marcinFM=typeof getFriendshipBonus==='function'?getFriendshipBonus('marcin'):1;
    if(_marcinFM>1) earn=Math.floor(earn*Math.min(1.5,_marcinFM)); // v2.1.83: cap 2.0â†’1.5
    /* v2.1.90 Amper: SPAM PENALTY zaktualizowane â€” koncert 1: 100%, koncert 2: 50%, koncert 3: 75%, koncert 4+: BLOKADA (sprawdzone w performConcert). */
    if(!G._concertsCounter || G._concertsCounter.day !== G.day){
      G._concertsCounter = {day: G.day, count: 0};
    }
    G._concertsCounter.count++;
    if(G._concertsCounter.count === 2){
      earn = Math.floor(earn * 0.5);
      if(typeof showMsg==='function') showMsg(`âš ď¸Ź 2. koncert dziĹ› â€” publicznoĹ›Ä‡ zmÄ™czona: 50% payoutu`,'r',3500);
    } else if(G._concertsCounter.count === 3){
      earn = Math.floor(earn * 0.75);
      if(typeof showMsg==='function') showMsg(`âš ď¸Ź 3. koncert dziĹ› â€” publicznoĹ›Ä‡ wraca: 75% payoutu`,'r',3500);
    }
    /* v1.9.29: BUG FIX â€” Prestige moneyMult aplikowany TYLKO przez earn(), koncert wczeĹ›niej bezpoĹ›rednie G.money+= pomijaĹ‚. */
    const _prestigeMC=G.prestigeBonus?.moneyMult||1;
    if(_prestigeMC>1) earn=Math.floor(earn*_prestigeMC);
    /* v2.1.163: Prestige Skill "Tour Magnate" +15% concert earnings */
    const _tourMagnateMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('tour_magnate'):1;
    if(_tourMagnateMult>1) earn=Math.floor(earn*_tourMagnateMult);
    /* v2.1.176: AUDYT â€” koncerty byĹ‚y pozbawione mogul/streak/diamondHands/mood mults ktĂłre earn() normalnie aplikuje (audit Agent 1). Teraz spĂłjne z innymi income sources. */
    const _mogul=(typeof getRaperST==='function' && getRaperST('biznes')>=5)?1.3:1;
    const _streak=typeof streakBonusMult==='function'?streakBonusMult():1;
    const _diamondMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('diamond_hands'):1;
    const _moodMult=G.stress>=80?1.10:(G.stress<20?0.95:1);
    earn=Math.floor(earn*_mogul*_streak*_diamondMult*_moodMult);
    /* v2.1.216 [Amper]: Tier 4 GOAT mult ×1.2 dla earn — osobny tier benefit (NIE drip), aplikowany przed hard cap */
    if(typeof getFameTier==='function' && getFameTier()===4) earn=Math.floor(earn*1.20);
    /* v2.1.127: hard cap per-concert 100k zĹ‚ (anti Sylwester+Arena+Prestige10+Friendship stack exploit). Late game gracz nie dostaje 200k+ z 1 koncertu. */
    if(earn>100000) earn=100000;
    G.money+=earn;G.totalEarned=(G.totalEarned||0)+earn;
    let repFanMult=1+(G.streetRep||0)*0.003; // up to +30% fans at max rep
    /* v1.9.51: _repBoost75 "Koncerty wiÄ™cej fanĂłw" â€” wczeĹ›niej flag ustawiany ale nigdy nie czytany w concert fans formula (ghost feature, audyt street rep) */
    if(G._repBoost75) repFanMult*=1.15;
    /* v2.1.205 [Amper]: USUNIÄTY hard cap fansGained z v2.1.204 (user feedback "nie chcÄ™ cap, wolÄ™ liniowy progres").
       Zmniejszone wspĂłĹ‚czynniki bazowe (5Ă— mniej follower scaling, 2Ă— mniej level scaling) â€” late game gracz dostaje sensowne wartoĹ›ci BEZ twardego limitu.
       Stary: (25 + followersĂ—0.025) Ă— ceil(level/2) â€” 500k followers Ă— level 20 dawaĹ‚o ~12525 Ă— 10 = 125k przed innymi mnoĹĽnikami.
       Nowy: (25 + followersĂ—0.005) Ă— ceil(level/4) â€” 500k Ă— 20 dawaĹ‚o ~2525 Ă— 5 = ~12600 przed mnoĹĽnikami. ~10Ă— mniej. Liniowy progres bez cap.
       v2.1.206 [Amper]: dripĂ—fans z 0.002 â†’ 0.001 (match earn drip = +0.1%/pkt, drip 200 = +20%). SpĂłjnoĹ›Ä‡ opisu zarobki+fani.
       v1.9.51: getEffectiveDrip dla fanĂłw koncertu (Autopromocja 4 bonus). */
    const _dripFan=typeof getEffectiveDrip==='function'?getEffectiveDrip():(G.drip||0);
    /* v2.1.209 [Amper]: PU rozszerza cap fanĂłw koncertu z +20% do +30% (analogicznie do earn). */
    let fansGained=Math.floor((25+G.followers*.005)*Math.max(0.3,perfMult)*Math.ceil(G.level/4)*(1+Math.min(0.30,_dripFan*0.001))*repFanMult);
    if(scenaBonus>=5) fansGained+=500; // Arena shows: +500 fanĂłw (byĹ‚o 1000)
    if(typeof G.fans!=='number') G.fans=0;
    /* v2.1.34: koncert daje LOJALNYCH fanĂłw (chodzÄ… na koncerty = engaged) */
    addFans(fansGained); /* v2.1.141: koncert fans */
    // v1.8.96: Hip-Hop Festival â€” bonus sĹ‚awy z koncertu
    let fameFestMult=typeof festivalEffect==='function'?(festivalEffect('concertFameMult')||1):1;
    /* v2.1.120: Wave 5 W48 â€” TourĂ—Festival combo cap. Podczas tour festival fame mult zredukowany do 1.3 (nie 2.0) â€” anti-stack OP. */
    if(G._tourActive && fameFestMult>1.3) fameFestMult=1.3;
    // v1.8.97: Prestige fameMult â€” REALNIE aplikowany (poprzednio flaga ustawiana ale nigdy nie czytana)
    const famePrestige=G.prestigeBonus?.fameMult||1;
    G.fame=clamp((G.fame||0)+Math.floor((5+accuracy/10)*fameFestMult*famePrestige),0,500);
    G.events.performed++;G.events.revenue+=earn;G.stress=clamp(G.stress-20,0,100);
    /* v2.1.201 [Amper]: tracker Areny â€” uĹĽywany do questa Anity */
    if(name==='Arena') G._arenaPlayed=(G._arenaPlayed||0)+1;
    // v1.8.65: World Tour â€” Ĺ›ledĹş statystyki trasy i przesuĹ„ siÄ™ do nastÄ™pnego miasta
    // v1.9.23: BUG FIX EXPLOIT â€” przejĹ›cie do nastÄ™pnego miasta przez nextPeriod() (poprzednio G.day++ bypassowaĹ‚ bills/royalties/festivals/decay = darmowy multi-day tour bez czynszu)
    if(G._tourActive){
      const t=G._tourActive;
      t.totalEarned=(t.totalEarned||0)+earn;
      t.totalFans=(t.totalFans||0)+fansGained;
      t.day++;
      G.timeOfDay=3;
      if(typeof nextPeriod==='function') nextPeriod();
    }
    if(typeof _trackConcert==='function')_trackConcert();
    addXP(50+Math.floor(accuracy/2));addRaperXP(30+Math.floor(accuracy*.5));
    progressQuest('concert');
    // CINEMATIC â€” pierwszy w ĹĽyciu koncert (debiut sceniczny)
    /* v2.1.140: dodano `G._firstConcertShown` flag â€” analogicznie do `_firstBeatShown`/`_debutAlbumShown`/`_firstArenaDone`.
       WczeĹ›niej tylko check `G.events.performed===1` â€” corner case: save corruption / manual edit / exploit mĂłgĹ‚ zresetowaÄ‡ performed do 1, cinematic znĂłw fires.
       Plus PEWNOĹšÄ† ĹĽe cinematic JEST PO performed++ (L21005) â€” fires po zakoĹ„czeniu pierwszego koncertu, nie przed.
       User feedback historyczny: "cinematic startuje przy ROZPOCZÄCIU minigame" â€” bug nie istnieje od v2.1.50 fix, flag dodatkowa ochrona. */
    if(G.events.performed===1 && !G._firstConcertShown && typeof showMilestoneCinematic==='function'){
      G._firstConcertShown=true;
      showMilestoneCinematic({
        emoji:'đźŽ¤',title:'PIERWSZY KONCERT',subtitle:'Debiut sceniczny',
        tagline:`${name} Â· +${fansGained} fanĂłw Â· Pierwsza scena za sobÄ…`,
        accentColor:'#9b59b6',accent2:'#e91e8c',duration:4500
      });
    }
    /* v2.1.50 Amper: CINEMATIC dla pierwszej Areny â€” odblokowanie endgame kariery koncertowej. */
    if(name==='Arena' && !G._firstArenaDone && typeof showMilestoneCinematic==='function'){
      G._firstArenaDone=true;
      showMilestoneCinematic({
        emoji:'đźŹź',title:'PIERWSZA ARENA',subtitle:'TysiÄ…ce fanĂłw wykrzykujÄ… Twoje teksty',
        tagline:`${(G.fans||0).toLocaleString('pl')} fanĂłw Â· +${earn.toLocaleString('pl')} zĹ‚ Â· Liga zawodowa rapu`,
        accentColor:'#f1c40f',accent2:'#e91e8c',duration:5000
      });
    }
    /* v2.1.203 [Amper]: CINEMATIC Festiwal â€” przeniesiony tu z PRZED startConcertMG (blokowaĹ‚ minigre). */
    if(name==='Festiwal' && !G._firstFestivalDone && typeof showMilestoneCinematic==='function'){
      G._firstFestivalDone=true;
      showMilestoneCinematic({
        emoji:'đźŽŞ',title:'PIERWSZY FESTIWAL',subtitle:'Wielka scena, tĹ‚um, Ĺ›wiatĹ‚a',
        tagline:`Marcin podpisaĹ‚ CiÄ™ na festiwal. To inny poziom â€” outdoor, publicznoĹ›Ä‡ liczona w tysiÄ…cach. +${earn.toLocaleString('pl')} zĹ‚, +${fansGained} fanĂłw.`,
        accentColor:'#e67e22',accent2:'#9b59b6',duration:5000
      });
    }
    /* v2.1.203 [Amper]: CINEMATIC World Tour â€” przeniesiony tu z runTourDay (blokowaĹ‚ minigre). Fires tylko dla day 1 (start trasy). */
    if(name.indexOf('World Tour')===0 || name.indexOf('đźŚŤ')===0){
      if(G._tourActive && G._tourActive.day===1 && !G._firstTourStarted && typeof showMilestoneCinematic==='function'){
        G._firstTourStarted=true;
        const _city=(G._tourActive.cities||[])[0]||'Warszawa';
        showMilestoneCinematic({
          emoji:'đźŚŤ',title:'WORLD TOUR ROZPOCZÄTY',subtitle:'5 miast Â· Twoja muzyka brzmi globalnie',
          tagline:`Warszawa â†’ Berlin â†’ Londyn â†’ NYC â†’ Tokio. Pierwszy przystanek (${_city}) za sobÄ….`,
          accentColor:'#3498db',accent2:'#f1c40f',duration:5500
        });
      }
    }
    /* v2.1.50 Amper: CINEMATIC dla pierwszego Klubu â€” milestone mid-game. */
    if(name==='Klub Muzyczny' && !G._firstClubDone && typeof showMilestoneCinematic==='function'){
      G._firstClubDone=true;
      showMilestoneCinematic({
        emoji:'đźŽµ',title:'PIERWSZY KLUB',subtitle:'WyrosĹ‚eĹ› z maĹ‚ej sceny',
        tagline:`PublicznoĹ›Ä‡ liczona w setkach. Twoja muzyka brzmi w gĹ‚oĹ›nikach klubowych.`,
        accentColor:'#9b59b6',accent2:'#3498db',duration:4500
      });
    }
    if(accuracy>=70) confetti(accuracy>=90?40:20);
    showGain('+'+earn.toLocaleString('pl')+' zĹ‚ đźŽ¤','#9b59b6');
    const grade=accuracy>=90?'â­ DOSKONAĹY':accuracy>=70?'đźŽ¤ Ĺšwietny':accuracy>=50?'đź‘Ť Dobry':'đź¤ MoĹĽe lepiej';
    document.getElementById('mg-job-content').innerHTML=`
      <div style="text-align:center;padding:20px;max-width:480px">
        <div style="font-size:36px;margin-bottom:8px">${accuracy>=80?'đźŚź':'đźŽ¤'}</div>
        <h2 style="color:#9b59b6;margin-bottom:4px">${grade}</h2>
        <p style="color:#aaa;font-size:14px;margin-bottom:16px">${name} â€” ${accuracy}% accuracy</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px">
          <div style="background:#0a1018;padding:10px;border-radius:6px"><div style="color:#f1c40f;font-size:18px;font-weight:700">${score.toLocaleString('pl')}</div><div style="color:#666;font-size:11px">Score</div></div>
          <div style="background:#0a1018;padding:10px;border-radius:6px"><div style="color:#2ecc71;font-size:18px;font-weight:700">+${earn.toLocaleString('pl')} zĹ‚</div><div style="color:#666;font-size:11px">Zarobek</div></div>
          <div style="background:#0a1018;padding:10px;border-radius:6px"><div style="color:#3498db;font-size:18px;font-weight:700">${maxCombo}x</div><div style="color:#666;font-size:11px">Max Combo</div></div>
          <div style="background:#0a1018;padding:10px;border-radius:6px"><div style="color:#e91e8c;font-size:18px;font-weight:700">+${fansGained}</div><div style="color:#666;font-size:11px">Nowi fani</div></div>
        </div>
        ${G._tourActive
          ? (G._tourActive.day >= G._tourActive.cities.length
              ? `<button class="cbtn" onclick="document.getElementById('mg-job').classList.remove('on');document.getElementById('mg-job-content').innerHTML='';runTourDay()">đźŚŤ ZakoĹ„cz trasÄ™ i odbierz nagrodÄ™ â†’</button>`
              : `<button class="cbtn" onclick="document.getElementById('mg-job').classList.remove('on');document.getElementById('mg-job-content').innerHTML='';runTourDay()">đźŚŤ NastÄ™pne miasto: ${G._tourActive.cities[G._tourActive.day]} (${G._tourActive.day+1}/${G._tourActive.cities.length}) â†’</button>`)
          : `<button class="cbtn" onclick="document.getElementById('mg-job').classList.remove('on');document.getElementById('mg-job-content').innerHTML='';openShopOverlay('sala')">â† WrĂłÄ‡ do sali</button>`}
      </div>`;
  }

  function onKey(e){
    if(!playing) return;
    /* v2.1.110: Wave 2 K18 / Wave 7 W71 â€” Escape handler dla concert MG (memory leak fix). */
    if(e.key==='Escape' || e.key==='Esc'){
      e.preventDefault();
      if(typeof window._cgQuit==='function') window._cgQuit();
      return;
    }
    const idx=LANE_KEYS.indexOf(e.key.toLowerCase());
    if(idx>=0){e.preventDefault();window._cgHit(idx);}
  }
  window.addEventListener('keydown',onKey);
  window._cgQuit=()=>{
    playing=false;cancelAnimationFrame(animId);window.removeEventListener('keydown',onKey);
    if(concertAudio){try{concertAudio.pause();}catch(e){}concertAudio=null;} /* v1.9.12: NIE czyĹ›Ä‡ src â€” zachowaj w cache window._concertAudioCache */
    if(_bgmWasPlaying && bgmAudio){try{bgmAudio.play().catch(()=>{});}catch(e){}}
    panel.classList.remove('on');document.getElementById('mg-job-content').innerHTML='';
    /* v2.1.104: Wave 7 K65 â€” concert cancel REFUND 50% wynajmu sceny (gracz dostaje pĂłĹ‚ zwrotu, organizator zatrzymuje pĂłĹ‚ za rezerwacjÄ™).
       WczeĹ›niej gracz traciĹ‚ 100% kosztu bez ĹĽadnej rekompensaty â€” exploit/balance issue (user feedback). */
    if(typeof cost==='number' && cost>0){
      const _refund=Math.floor(cost*0.5);
      if(typeof earn==='function') earn(_refund,false); else {G.money+=_refund;G.totalEarned=(G.totalEarned||0)+_refund;}
      if(typeof notify==='function') notify(`đźŽ¤ Koncert przerwany. Zwrot 50% wynajmu: +${_refund} zĹ‚. Organizator zatrzymaĹ‚ ${cost-_refund} zĹ‚ za rezerwacjÄ™.`);
    }
  };

  lastNote=Date.now();spawnNote();
  animId=requestAnimationFrame(updateNotes);
}
const APT_REQS={traphouse:{},basic:{level:2},premium:{level:4,fans:2000},luxury:{level:7,fans:10000,fame:50},mansion:{level:15,fans:100000,fame:90},mega_villa:{level:18,fans:300000,fame:250,mustOwnMansion:true,mustOwnPenthouse:true}}; /* v2.1.159: Mansion · v2.1.215: Mega Villa req (Tier 3 Legendary) */
/* v2.1.172: Helper â€” auto-set G.apartment do najlepszego posiadanego (player nie musi siÄ™ "przeprowadzaÄ‡") */
const _APT_TIER_ORDER=['traphouse','basic','premium','luxury','mansion','mega_villa']; /* v2.1.215: Mega Villa tier 6 */
window._getBestOwnedApt=()=>{
  const owned=new Set(G._ownedApts||[]);owned.add('traphouse'); /* traphouse zawsze dostÄ™pny */
  let best='traphouse';
  for(const id of _APT_TIER_ORDER) if(owned.has(id)) best=id;
  return best;
};
window._setActiveAptToBest=()=>{
  /* Eksmisja override: jeĹ›li evicted, G.apartment musi pozostaÄ‡ 'traphouse' do spĹ‚aty rachunkĂłw */
  if(G.bills?.evicted){G.apartment='traphouse';return;}
  G.apartment=window._getBestOwnedApt();
};
window.buyApartment=(id,cost)=>{
  G._ownedApts=G._ownedApts||[];
  /* v2.1.172: Traphouse to startowy/bazowy dom â€” niemoĹĽliwy do "zakupu" (filter w renderBiuroNieruchomosci ukrywa go z listy, ale tu defensive guard). */
  if(id==='traphouse'){notify('đźŹšď¸Ź Traphouse jest twoim startowym mieszkaniem â€” nie wymaga zakupu.');return;}
  /* v2.1.172: Posiadane mieszkania nie wymagajÄ… "PrzeprowadĹş siÄ™" â€” system auto-aktywuje najlepsze (_setActiveAptToBest). */
  if(G._ownedApts.includes(id)){notify(`đźŹ  JuĹĽ posiadasz ${CFG.APT_NAMES[id]||id} â€” bonus aktywny gdy to twoje najlepsze mieszkanie.`);return;}
  // Wymagania sprawdzamy zawsze (poziom/fanĂłw/sĹ‚awy)
  const req=APT_REQS[id]||{};
  if(req.level && G.level<req.level){showMsg(`đź”’ Wymagany poziom ${req.level} (masz ${G.level}).`,'r');return;}
  if(req.fans && (G.fans||0)<req.fans){showMsg(`đź”’ Wymaga ${req.fans.toLocaleString('pl')} fanĂłw (masz ${(G.fans||0).toLocaleString('pl')}).`,'r');return;}
  if(req.fame && (G.fame||0)<req.fame){showMsg(`đź”’ Wymaga ${req.fame} sĹ‚awy (masz ${G.fame||0}).`,'r');return;}
  if(G.money<cost){showMsg('âš ď¸Ź Brak kasy.','r');return;}
  if(cost>0) G.money-=cost;
  G._ownedApts.push(id);
  /* v2.1.172: Auto-aktywacja najlepszego posiadanego (zamiast manualnego "PrzeprowadĹş siÄ™") */
  window._setActiveAptToBest();
  /* v2.1.99: Prestige fameMult przez addFame() (Wave 1 K6 apartment luxury first-buy bypass fix) */
  if(id==='luxury'){if(typeof addFame==='function')addFame(15);else G.fame=clamp(G.fame+15,0,500);}
  if(id==='mansion'){if(typeof addFame==='function')addFame(30);else G.fame=clamp(G.fame+30,0,500);} /* v2.1.159: Mansion first-buy +30 fame */
  if(id==='mega_villa'){if(typeof addFame==='function')addFame(30);else G.fame=clamp(G.fame+30,0,500);} /* v2.1.215: Mega Villa first-buy +30 fame (po diminishing Tier 3 ÷4 = +7 final, ale fame 250 = Tier 2 ÷2 = +15 final) */
  // CINEMATIC dla zakupu mieszkania
  const aptCfg={
    basic:{emoji:'đźŹ ',c:'#7ec8e3',c2:'#3498db',tag:'Pierwszy wĹ‚asny dach nad gĹ‚owÄ…'},
    premium:{emoji:'đźŹ˘',c:'#9b59b6',c2:'#e91e8c',tag:'Apartament w lepszej dzielnicy'},
    luxury:{emoji:'đźŹ™ď¸Ź',c:'#c8a520',c2:'#f1c40f',tag:'Penthouse na szczycie miasta Â· +15 sĹ‚awy'},
    mansion:{emoji:'đźŹ°',c:'#f1c40f',c2:'#e91e8c',tag:'Rezydencja w prestiĹĽowej dzielnicy Â· +30 sĹ‚awy'},
    /* v2.1.215 [Amper]: Mega Villa cinematic — Tier 3 Legendary endgame apartment */
    mega_villa:{emoji:'🏖',c:'#f5deb3',c2:'#ffd700',tag:'Mega Villa — szczyt luksusu · +30 sławy · +2 fame/dzień pasywnie'},
  }[id]||{emoji:'đźŹ ',c:'#7ec8e3',c2:'#3498db',tag:''};
  showMilestoneCinematic({
    emoji:aptCfg.emoji,
    title:'NOWE MIESZKANIE',
    subtitle:CFG.APT_NAMES[id]||id,
    tagline:aptCfg.tag,
    accentColor:aptCfg.c,
    accent2:aptCfg.c2,
    duration:id==='luxury'?5000:4000,
  });
  renderBiuroNieruchomosci();
};

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  PRACE DORYWCZE
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let _jobPanelSession=0;

// Ekran startowy pracy â€” wspĂłlny dla wszystkich mini-gier
function showJobIntro(config, onStart){
  const el=document.getElementById('mg-job');
  el.style.display='';el.classList.add('on'); // CSS .on kontroluje display:flex
  const {icon,name,wage,difficulty,diffColor,desc,bgColor}=config;
  const lvl=Math.max(0,G.skills&&G.skills[config.skillKey]||0);
  const bonusPct=Math.round(lvl*20);
  // v1.8.19: redesign â€” premium intro karta z glassmorphism
  el.innerHTML=`
  <div style="display:flex;flex-direction:column;align-items:center;gap:22px;padding:40px 36px;width:100%;max-width:560px;margin-top:40px;background:linear-gradient(150deg,rgba(18,24,44,0.85),rgba(10,14,28,0.92));border:1px solid rgba(126,200,227,0.18);border-radius:20px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 20px 60px rgba(0,0,0,.55),0 0 40px rgba(126,200,227,.08),inset 0 1px 0 rgba(255,255,255,0.05);position:relative;overflow:hidden">
    <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent 0%,${diffColor||'#27ae60'} 50%,transparent 100%);opacity:.7"></div>
    <div class="emoji-float" style="font-size:72px;line-height:1;filter:drop-shadow(0 4px 20px rgba(0,0,0,.5))">${icon}</div>
    <h2 style="color:#fff;font-size:28px;margin:0;letter-spacing:.5px;font-weight:800;text-align:center">${name}</h2>
    <div style="display:flex;gap:18px;flex-wrap:wrap;justify-content:center">
      <div style="background:rgba(39,174,96,0.10);border:1px solid rgba(39,174,96,0.25);border-radius:12px;padding:12px 18px;text-align:center;min-width:110px">
        <div style="color:#7a8aa0;font-size:11px;text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:4px">đź’° Zarobek</div>
        <div style="color:#27ae60;font-weight:800;font-size:18px">~${wage} zĹ‚</div>
      </div>
      <div style="background:rgba(${diffColor==='#27ae60'?'39,174,96':diffColor==='#f1c40f'?'241,196,15':'231,76,60'},0.10);border:1px solid rgba(${diffColor==='#27ae60'?'39,174,96':diffColor==='#f1c40f'?'241,196,15':'231,76,60'},0.25);border-radius:12px;padding:12px 18px;text-align:center;min-width:110px">
        <div style="color:#7a8aa0;font-size:11px;text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:4px">âšˇ TrudnoĹ›Ä‡</div>
        <div style="color:${diffColor||'#f1c40f'};font-weight:800;font-size:18px">${difficulty}</div>
      </div>
      ${lvl>0?`<div style="background:rgba(155,89,182,0.10);border:1px solid rgba(155,89,182,0.25);border-radius:12px;padding:12px 18px;text-align:center;min-width:110px">
        <div style="color:#7a8aa0;font-size:11px;text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:4px">đźŽŻ Bonus skill</div>
        <div style="color:#9b59b6;font-weight:800;font-size:18px">+${bonusPct}%</div>
      </div>`:''}
    </div>
    <div style="color:#9aa6b8;font-size:14px;text-align:center;max-width:420px;line-height:1.6">${desc}</div>
    <button id="job-intro-start" style="background:linear-gradient(145deg,#2eaf5a,#1a7838);border:1px solid rgba(46,175,90,0.7);color:#fff;padding:14px 56px;cursor:pointer;border-radius:10px;font-size:18px;font-weight:700;letter-spacing:1px;transition:all .2s cubic-bezier(0.22,0.61,0.36,1);box-shadow:0 6px 18px rgba(39,174,96,.35),inset 0 1px 0 rgba(255,255,255,0.15)">â–¶ Zacznij!</button>
    <button onclick="if(window._jobMgCleanup)window._jobMgCleanup();else{const e=document.getElementById('mg-job');e.classList.remove('on');e.style.display='none';}" style="background:transparent;border:1px solid rgba(126,200,227,0.15);color:#7a8aa0;padding:9px 24px;cursor:pointer;border-radius:8px;font-size:13px;transition:all .18s">âś• Anuluj</button>
  </div>`;
  document.getElementById('job-intro-start').onclick=()=>onStart();
  document.getElementById('job-intro-start').onmouseenter=function(){this.style.transform='translateY(-2px)';this.style.boxShadow='0 10px 28px rgba(39,174,96,.45),inset 0 1px 0 rgba(255,255,255,0.18)';};
  document.getElementById('job-intro-start').onmouseleave=function(){this.style.transform='';this.style.boxShadow='0 6px 18px rgba(39,174,96,.35),inset 0 1px 0 rgba(255,255,255,0.15)';};
  window._jobMgCleanup=()=>{el.classList.remove('on');el.style.display='none';el.innerHTML='<div id="mg-job-content"></div>';};
}

function openJobOverlay(id){
  _jobPanelSession++; // kaĹĽde nowe otwarcie = nowa sesja â€” stare timery sprawdzajÄ… sesjÄ™ przed zamkniÄ™ciem
  switch(id){
    case 'pizza': startPizzaJob();return;
    case 'supermarket': startSupermarketMG();return;
    case 'carwash': startCarwashMG();return;
    case 'construction': startConstructionMG();return;
    case 'kurier': startKurierMG();return;
    case 'zmywak': startZmywakMG();return;
  }
  openOverlay();
}
// Helper â€” zamknij panel tylko jeĹ›li sesja nie zmieniĹ‚a siÄ™ od uruchomienia
function closeJobPanelAfter(ms){
  const tok=_jobPanelSession;const p=document.getElementById('mg-job');
  setTimeout(()=>{if(_jobPanelSession===tok&&p)p.classList.remove('on');},ms);
}

function startPizzaJob(){
  showJobIntro({icon:'đźŤ•',name:'Pizzeria â€” Kucharz',wage:'15â€“30',difficulty:'Ĺatwa',diffColor:'#27ae60',
    desc:'Przygotuj pizzÄ™ wg zamĂłwienia! Dobierz skĹ‚adniki z listy â€” im dokĹ‚adniej tym wyĹĽszy napiwek. Skill pizzy = bonus do zarobku.',
    skillKey:'pizza'},()=>{
    const intro=document.getElementById('mg-job');intro.classList.remove('on');intro.style.display='none';
    _startPizzaGame();
  });
}
function _startPizzaGame(){
  sfxOvenStart();
  const INGREDIENTS=[
    {id:'sos',  em:'đźŤ…',name:'Sos pomidorowy'},
    {id:'ser',  em:'đź§€',name:'Ser'},
    {id:'grzyb',em:'đźŤ„',name:'Pieczarki'},
    {id:'pap',  em:'đź«‘',name:'Papryka'},
    {id:'cebula',em:'đź§…',name:'Cebula'},
    {id:'boczek',em:'đźĄ“',name:'Boczek'},
    {id:'chili', em:'đźŚ¶ď¸Ź',name:'Chili'},
    {id:'oliwki',em:'đź«’',name:'Oliwki'},
  ];
  // Jednolite mini-SVG ikony (na zamĂłwieniu, w buttonach, w wynikach) â€” spĂłjne ze SVG na pizzy
  const ingInlineIcon=(id,size=24)=>{
    const v=`width="${size}" height="${size}" viewBox="0 0 32 32" style="vertical-align:middle"`;
    switch(id){
      case 'sos':    return `<svg ${v}><circle cx="16" cy="16" r="13" fill="#c03010"/><circle cx="16" cy="16" r="7" fill="#e04020" opacity=".6"/></svg>`;
      case 'ser':    return `<svg ${v}><rect x="5" y="8" width="22" height="16" rx="3" fill="#f5c842"/><rect x="9" y="11" width="6" height="6" rx="1" fill="#e0b030" opacity=".5"/></svg>`;
      case 'grzyb':  return `<svg ${v}><ellipse cx="16" cy="13" rx="13" ry="9" fill="#f5f5f5" stroke="#ccc" stroke-width="1"/><rect x="12" y="20" width="8" height="11" rx="2" fill="#ececec"/></svg>`;
      case 'pap':    return `<svg ${v}><ellipse cx="16" cy="20" rx="9" ry="11" fill="#e82020"/><ellipse cx="13" cy="17" rx="4" ry="7" fill="#f04040"/><rect x="14" y="3" width="5" height="6" rx="2" fill="#1a8020"/></svg>`;
      case 'cebula': return `<svg ${v}><ellipse cx="16" cy="17" rx="13" ry="9" fill="none" stroke="#9060b0" stroke-width="3"/><ellipse cx="16" cy="17" rx="7" ry="4" fill="none" stroke="#b080d0" stroke-width="2"/></svg>`;
      case 'boczek': return `<svg ${v}><rect x="2" y="11" width="28" height="10" rx="3" fill="#c04030"/><rect x="4" y="14" width="24" height="5" rx="1" fill="#f09060" opacity=".7"/></svg>`;
      case 'chili':  return `<svg ${v}><ellipse cx="14" cy="20" rx="5" ry="13" fill="#c0392b" transform="rotate(-12,14,20)"/><path d="M16 6 Q22 1 19 0" stroke="#27ae60" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>`;
      case 'oliwki': return `<svg ${v}><ellipse cx="16" cy="16" rx="9" ry="13" fill="#5a8a3a"/><ellipse cx="16" cy="16" rx="6" ry="10" fill="#7aaa4a"/><ellipse cx="14" cy="14" rx="2" ry="3" fill="rgba(180,220,140,.5)"/></svg>`;
      default:       return INGREDIENTS.find(i=>i.id===id)?.em||'?';
    }
  };
  // SVG shapes for ingredients (better than emoji on pizza surface)
  const ingSVG=(id,x,y)=>{
    switch(id){
      case 'sos':    return `<circle cx="${x}" cy="${y}" r="14" fill="#c03010" opacity=".9"/><circle cx="${x}" cy="${y}" r="8" fill="#e04020" opacity=".6"/>`;
      case 'ser':    return `<rect x="${x-11}" y="${y-8}" width="22" height="16" rx="3" fill="#f5c842"/><rect x="${x-8}" y="${y-5}" width="6" height="6" rx="1" fill="#e0b030" opacity=".5"/>`;
      case 'grzyb':  return `<ellipse cx="${x}" cy="${y-3}" rx="13" ry="9" fill="#f5f5f5" stroke="#ddd" stroke-width="1"/><rect x="${x-4}" y="${y+5}" width="8" height="10" rx="2" fill="#ececec"/>`;
      case 'pap':    return `<ellipse cx="${x}" cy="${y+3}" rx="8" ry="14" fill="#e82020"/><ellipse cx="${x-3}" cy="${y-2}" rx="4" ry="9" fill="#f04040"/><rect x="${x-2}" y="${y-15}" width="5" height="7" rx="2" fill="#1a8020"/>`;
      case 'cebula': return `<ellipse cx="${x}" cy="${y}" rx="13" ry="9" fill="none" stroke="#9060b0" stroke-width="3"/><ellipse cx="${x}" cy="${y}" rx="7" ry="4" fill="none" stroke="#b080d0" stroke-width="2"/>`;
      case 'boczek': return `<rect x="${x-14}" y="${y-5}" width="28" height="10" rx="3" fill="#c04030"/><rect x="${x-12}" y="${y-2}" width="24" height="5" rx="1" fill="#f09060" opacity=".7"/>`;
      case 'chili':  return `<ellipse cx="${x-2}" cy="${y+4}" rx="5" ry="15" fill="#c0392b" transform="rotate(-15,${x},${y})"/><circle cx="${x-2}" cy="${y-12}" r="4" fill="#c0392b"/><path d="M${x+1} ${y-14} Q${x+10} ${y-22} ${x+6} ${y-24}" stroke="#27ae60" stroke-width="2.5" fill="none" stroke-linecap="round"/>`;
      case 'oliwki': return `<ellipse cx="${x}" cy="${y}" rx="9" ry="13" fill="#5a8a3a"/><ellipse cx="${x}" cy="${y}" rx="6" ry="10" fill="#7aaa4a"/><ellipse cx="${x-2}" cy="${y-2}" rx="2" ry="3" fill="rgba(180,220,140,.5)"/>`;
      default:       return `<text x="${x}" y="${y}" font-size="22" text-anchor="middle" dominant-baseline="middle">?</text>`;
    }
  };
  // Wszystkie buttony uĹĽywajÄ… tej samej grafiki co zamĂłwienie i pizza
  const ingBtn=(id)=>ingInlineIcon(id,36);
  let orderCompleted=0;
  function makeOrder(){
    // Sos ALWAYS in order, randomly x1 or x2
    const sosCount=Math.random()<0.38?2:1;
    const sosPart=Array(sosCount).fill('sos');
    // Other ingredients (never sos again)
    const numUniq=rnd(2,4);
    const others=[...INGREDIENTS.filter(i=>i.id!=='sos')].sort(()=>Math.random()-.5).slice(0,numUniq);
    const otherPart=[];
    others.forEach(ing=>{if(Math.random()<.32) otherPart.push(ing.id,ing.id);else otherPart.push(ing.id);});
    return [...sosPart,...otherPart];
  }
  let order=makeOrder();let selected=[];let sliding=false;

  const renderPizza=()=>{
    // Place ingredients at positions around the pizza circle
    const r=170; // pizza radius for display
    const cx_p=280,cy_p=280; // pizza center
    const ingPositions=INGREDIENTS.map((_,i)=>{
      const angle=(i/INGREDIENTS.length)*Math.PI*2-Math.PI/2;
      return {x:cx_p+Math.cos(angle)*r,y:cy_p+Math.sin(angle)*r};
    });
    // Count selected
    const selCount={};selected.forEach(id=>{selCount[id]=(selCount[id]||0)+1;});
    const orderCount={};order.forEach(id=>{orderCount[id]=(orderCount[id]||0)+1;});
    document.getElementById('mg-pizza-content').innerHTML=`
      <div style="display:flex;align-items:flex-start;gap:30px;padding:10px">
        <!-- Order panel -->
        <div style="background:#1a0a04;border:1px solid #3a1a0a;border-radius:10px;padding:18px;min-width:220px;flex-shrink:0">
          <div style="color:#f1c40f;font-size:14px;font-weight:700;margin-bottom:12px;text-transform:uppercase;letter-spacing:1px">đź“‹ ZamĂłwienie #${orderCompleted+1}</div>
          ${Object.entries(orderCount).sort(([a],[b])=>a==='sos'?-1:b==='sos'?1:0).map(([id,cnt])=>{
            const ing=INGREDIENTS.find(i=>i.id===id);
            const got=(selCount[id]||0);
            const ok=got>=cnt;
            return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:16px;color:${ok?'#27ae60':'#e67e22'}">
              ${ingInlineIcon(id,28)} ${ing.name}${cnt>1?` <b>Ă—${cnt}</b>`:''}
              <span style="margin-left:auto;font-size:20px">${ok?'âś…':got>0?`(${got}/${cnt})`:'â—‹'}</span>
            </div>`;
          }).join('')}
        </div>

        <!-- Pizza canvas area -->
        <div style="position:relative;width:560px;height:560px;flex-shrink:0" id="pizza-area">
          <svg width="560" height="560" style="position:absolute;top:0;left:0">
            <!-- Shadow -->
            <ellipse cx="284" cy="285" rx="175" ry="175" fill="rgba(0,0,0,.3)"/>
            <!-- Pizza dough -->
            <circle cx="280" cy="280" r="172" fill="#c8901a"/>
            <!-- Sauce base -->
            <circle cx="280" cy="280" r="150" fill="#b03020" opacity=".6"/>
            <!-- Selected toppings -->
            ${selected.map((id,si)=>{
              const a=(si/Math.max(selected.length,1))*Math.PI*2;
              const dr=40+Math.floor(si*37+si*si*7)%90;
              const tx=280+Math.cos(a)*dr,ty=280+Math.sin(a)*dr;
              return ingSVG(id,tx,ty);
            }).join('')}
            <!-- Crust ring -->
            <circle cx="280" cy="280" r="172" fill="none" stroke="#8a5a10" stroke-width="12"/>
          </svg>
          <!-- Ingredient buttons around the pizza -->
          ${INGREDIENTS.map((ing,i)=>{
            const angle=(i/INGREDIENTS.length)*Math.PI*2-Math.PI/2;
            const br=230;const bx=280+Math.cos(angle)*br-32;const by=280+Math.sin(angle)*br-32;
            const cnt=(selCount[ing.id]||0);
            const inOrd=orderCount[ing.id]||0;
            const maxed=cnt>=(inOrd>0?inOrd*2:2);
            return `<div onclick="addIngr('${ing.id}')" style="position:absolute;left:${bx}px;top:${by}px;width:64px;height:64px;background:${cnt>0?'#1a3a1a':'#0d1525'};border:2px solid ${cnt>0?'#27ae60':'#1a2535'};border-radius:10px;cursor:${maxed?'not-allowed':'pointer'};display:flex;flex-direction:column;align-items:center;justify-content:center;transition:all .1s;opacity:${maxed?.5:1}" title="${ing.name}${cnt>0?' ('+cnt+')':''}">
              ${ingBtn(ing.id)}
              ${cnt>0?`<div style="font-size:10px;color:#27ae60;margin-top:2px">Ă—${cnt}</div>`:''}
            </div>`;
          }).join('')}
        </div>

        <!-- Right panel -->
        <div style="display:flex;flex-direction:column;gap:10px;padding-top:10px">
          <div style="background:#0a1220;border:1px solid #1a2a3a;border-radius:8px;padding:12px;font-size:14px;color:#aaa">
            <div style="margin-bottom:6px">SkĹ‚adniki: <strong style="color:#fff">${selected.length}</strong></div>
            <div>Pizze zrobione: <strong style="color:#27ae60">${orderCompleted}</strong></div>
          </div>
          <button class="dbtn" style="padding:14px 0;font-size:16px" onclick="submitPizzaNew()">đźŤ• Wydaj pizzÄ™!</button>
          <button onclick="undoIngr()" ${selected.length===0?'disabled':''} style="padding:9px 0;font-size:13px;background:#2a1a0a;border:1px solid #5a3a18;color:#c89060;border-radius:6px;cursor:${selected.length===0?'not-allowed':'pointer'};font-family:inherit;opacity:${selected.length===0?.4:1}">â†¶ Cofnij ostatni${selected.length>0?' ('+INGREDIENTS.find(i=>i.id===selected[selected.length-1])?.name+')':''}</button>
          <button onclick="clearAllIngr()" ${selected.length===0?'disabled':''} style="padding:7px 0;font-size:12px;background:#2a0a0a;border:1px solid #5a1a1a;color:#e07070;border-radius:6px;cursor:${selected.length===0?'not-allowed':'pointer'};font-family:inherit;opacity:${selected.length===0?.4:1}">đź—‘ Zacznij od nowa</button>
          <button class="cbtn" onclick="closeMG()">â† WrĂłÄ‡</button>
        </div>
      </div>
      <div id="pizza-res" style="margin-top:10px;text-align:center;font-size:16px;color:#7ec87e;min-height:24px"></div>
    `;
  };

  window.addIngr=(id)=>{
    const maxed=(selected.filter(s=>s===id).length>=4);if(maxed) return;
    selected.push(id);playClick();renderPizza();
  };
  window.undoIngr=()=>{
    if(selected.length===0) return;
    selected.pop();playClick();renderPizza();
  };
  window.clearAllIngr=()=>{
    if(selected.length===0) return;
    selected=[];playClick();renderPizza();
  };

  window.submitPizzaNew=()=>{
    if(sliding) return;
    const orderCount={};order.forEach(id=>{orderCount[id]=(orderCount[id]||0)+1;});
    const selCount={};selected.forEach(id=>{selCount[id]=(selCount[id]||0)+1;});
    // Walidacja PRZED wydaniem â€” nie pozwĂłl wydaÄ‡ zĹ‚ej pizzy
    const wrongIngs=Object.entries(selCount).filter(([id,cnt])=>!orderCount[id]).map(([id])=>INGREDIENTS.find(i=>i.id===id)?.name).filter(Boolean);
    const tooMany=Object.entries(selCount).filter(([id,cnt])=>orderCount[id]&&cnt>orderCount[id]).map(([id,cnt])=>`${INGREDIENTS.find(i=>i.id===id)?.name} (Ă—${cnt}, zamĂłwione Ă—${orderCount[id]})`);
    const missing=Object.entries(orderCount).filter(([id,cnt])=>(selCount[id]||0)<cnt).map(([id,cnt])=>`${INGREDIENTS.find(i=>i.id===id)?.name}${cnt>1?' Ă—'+cnt:''}`);
    const r=document.getElementById('pizza-res');
    if(wrongIngs.length>0){
      if(r) r.innerHTML=`<span style="color:#e74c3c;font-weight:700">âťŚ BĹ‚Ä™dne skĹ‚adniki: ${wrongIngs.join(', ')}.</span> <span style="color:#aaa">Cofnij i sprawdĹş zamĂłwienie.</span>`;
      return;
    }
    if(tooMany.length>0){
      if(r) r.innerHTML=`<span style="color:#e67e22;font-weight:700">âš ď¸Ź Za duĹĽo: ${tooMany.join(', ')}.</span> <span style="color:#aaa">Cofnij nadmiar.</span>`;
      return;
    }
    if(missing.length>0){
      if(r) r.innerHTML=`<span style="color:#f1c40f;font-weight:700">âš ď¸Ź Brakuje: ${missing.join(', ')}.</span> <span style="color:#aaa">DorzuÄ‡ skĹ‚adniki.</span>`;
      return;
    }
    sliding=true;
    let correct=0,total=0;
    Object.entries(orderCount).forEach(([id,cnt])=>{total+=cnt;correct+=Math.min(selCount[id]||0,cnt);});
    const pct=Math.floor((correct/Math.max(total,1))*100); // bez extra (walidacja blokuje)
    let msg='';let pay=0;
    // #84 NERF -30% â€” gracz prosiĹ‚ wiÄ™kszy grind. Pizza byĹ‚a ~60zĹ‚/min, teraz ~42zĹ‚/min
    if(pct>=85){msg='âś… IDEALNA! Klient zachwycony!';pay=rnd(17,28);sfxSparkle();}
    // v1.8.43: range "good" rozszerzony 10-15 â†’ 13-20 â€” bardziej proporcjonalnie do perfect 17-28.
    else if(pct>=60){msg='âš ď¸Ź Ujdzie. Klient nie narzeka.';pay=rnd(13,20);sfxCash();}
    else{msg='âťŚ ZĹ‚a pizza! Kara umowna.';pay=-rnd(3,7);}
    if(pay>0) pay=Math.floor(pay*getPracaBonus('pizza')); // F3-FIX-B: skill+PU+evo
    if(G.managementDeal) pay=pay>0?Math.floor(pay*G.managementBonus):pay;
    G.money+=pay;G.energy=clampStat('energy', G.energy-3); // v1.8.59: pizza 6â†’3 (-70% od oryginaĹ‚u 10)
    if(pay>0) G.totalEarned=(G.totalEarned||0)+pay;
    if(r) r.textContent=`${msg} ${pay>=0?'+':''}${pay} zĹ‚`;
    // BALANS #65: pizza +1 â†’ +1 co 3 pizzÄ™ (rep nie powinno rosnÄ…Ä‡ tak szybko)
    if(orderCompleted%3===0) G.streetRep=clamp(G.streetRep+1,0,100);
    if(pct>=60){addXP(15);}
    else addXP(5);
    // v1.8.44: progressQuest WSZYSTKICH ukoĹ„czonych pizz (nawet sĹ‚abych) â€” wczeĹ›niej tylko pct>=60 blokowaĹ‚o quest gdy gracz miaĹ‚ sĹ‚abszÄ… wydajnoĹ›Ä‡
    progressQuest('pizza');
    orderCompleted++;
    /* v1.9.19: cap 10 pizz per session (poprzednio unbounded grind ~140 zĹ‚/min indefinitely) */
    if(orderCompleted>=10){
      setTimeout(()=>{
        document.getElementById('mg-pizza').classList.remove('on');
        if(typeof showMsg==='function') showMsg(`đźŤ• Koniec zmiany! ${orderCompleted} pizz przygotowanych. WrĂłÄ‡ pĂłĹşniej po nastÄ™pnÄ… zmianÄ™.`,'g',5000);
      },400);
      return;
    }
    // v1.8.49: spĂłjny timing 0.35s cubic-bezier dla obu kierunkĂłw (poprzednio 0.4s in i 0.3s out â€” jerk)
    const area=document.getElementById('pizza-area');
    if(area){area.style.transition='transform .35s cubic-bezier(.22,.61,.36,1)';area.style.transform='translateX(800px)';}
    setTimeout(()=>{
      order=makeOrder();selected=[];sliding=false;renderPizza();
      const area2=document.getElementById('pizza-area');
      if(area2){area2.style.transform='translateX(-800px)';area2.style.transition='none';
        setTimeout(()=>{area2.style.transition='transform .35s cubic-bezier(.22,.61,.36,1)';area2.style.transform='translateX(0)';},20);}
    },400);
  };

  renderPizza();
  document.getElementById('mg-pizza').classList.add('on');
}

function startSupermarketMG(){
  showJobIntro({icon:'đź›’',name:'Supermarket â€” Kasjer',wage:'20â€“40',difficulty:'Ĺšrednia',diffColor:'#f1c40f',
    desc:'Skanuj produkty z taĹ›my zanim dotrÄ… do kasy. SPACJA lub klik = skanuj. SzybkoĹ›Ä‡ to bonus do wypĹ‚aty!',
    skillKey:'supermarket'},()=>_startSupermarketGame());
}
function _startSupermarketGame(){
  const el=document.getElementById('mg-job');
  el.style.display='';el.classList.add('on');
  el.innerHTML='';
  window._smSessionToken=(window._smSessionToken||0)+1;

  const PRODUCTS=[
    {name:'Mleko',price:3.49,color:'#e0e8f0',emoji:'đźĄ›'},
    {name:'Chleb',price:4.29,color:'#d4a060',emoji:'đźŤž'},
    {name:'MasĹ‚o',price:7.99,color:'#f8e060',emoji:'đź§'},
    {name:'Ser',price:12.50,color:'#f0c040',emoji:'đź§€'},
    {name:'Jajka',price:9.99,color:'#f0e0a0',emoji:'đźĄš'},
    {name:'Jogurt',price:2.99,color:'#e8f0e8',emoji:'đźĄ›'},
    {name:'Woda',price:1.49,color:'#c0d8f0',emoji:'đź’§'},
    {name:'Cola',price:4.99,color:'#503010',emoji:'đźĄ¤'},
    {name:'Frytki',price:5.49,color:'#e8b040',emoji:'đźŤź'},
    {name:'Pizza mroĹĽona',price:8.99,color:'#e06040',emoji:'đźŤ•'},
    {name:'Piwo',price:3.49,color:'#f0c820',emoji:'đźŤş'},
    {name:'Czekolada',price:4.29,color:'#5a2808',emoji:'đźŤ«'},
  ];

  let gameActive=true,timeLeft=90;
  let customersServed=0,totalEarned=0;
  let currentItems=[],scannedCount=0,conveyorX=0,customerStartTime=0;
  let scanFlash=0,flashColor='#27ae60';

  function newCustomer(){
    const count=4+Math.floor(Math.random()*3);
    currentItems=[];
    for(let i=0;i<count;i++){
      const p=PRODUCTS[Math.floor(Math.random()*PRODUCTS.length)];
      currentItems.push({...p,x:700+i*110,scanned:false});
    }
    scannedCount=0;
    customerStartTime=Date.now();
    conveyorX=0;
  }

  // Wrapper z premium look
  const wrap=document.createElement('div');
  wrap.style.cssText='display:flex;flex-direction:column;align-items:center;gap:10px;padding:16px;width:100%;max-width:780px';
  el.appendChild(wrap);

  const title=document.createElement('div');
  title.innerHTML=`
    <h2 style="color:#2ecc71;font-size:26px;margin:0 0 4px;font-weight:900;text-shadow:0 0 12px rgba(46,204,113,.4);text-align:center">đź›’ Supermarket â€” Kasjer</h2>
    <div style="font-size:13px;color:#aac;text-align:center">Skanuj produkty z taĹ›my: <b style="color:#f1c40f">SPACJA</b> lub <b style="color:#f1c40f">KLIK</b> gdy produkt w ĹĽĂłĹ‚tej strefie skanera</div>`;
  wrap.appendChild(title);

  const infoRow=document.createElement('div');
  infoRow.style.cssText='display:flex;gap:14px;margin:4px 0;background:linear-gradient(135deg,rgba(15,30,50,.8),rgba(8,16,30,.8));border:1px solid rgba(46,204,113,.3);border-radius:10px;padding:10px 18px;font-family:"Segoe UI",sans-serif';
  infoRow.innerHTML=`
    <div style="display:flex;flex-direction:column;align-items:center;min-width:60px"><div style="font-size:10px;color:#778;letter-spacing:1px">CZAS</div><div style="font-size:18px;color:#f39c12;font-weight:900">âŹ± <span id="sm-time">90</span>s</div></div>
    <div style="width:1px;background:#2a3a55"></div>
    <div style="display:flex;flex-direction:column;align-items:center;min-width:80px"><div style="font-size:10px;color:#778;letter-spacing:1px">KLIENCI</div><div style="font-size:18px;color:#3498db;font-weight:900">đź‘Ą <span id="sm-cust">0</span> / 5</div></div>
    <div style="width:1px;background:#2a3a55"></div>
    <div style="display:flex;flex-direction:column;align-items:center;min-width:90px"><div style="font-size:10px;color:#778;letter-spacing:1px">ZAROBEK</div><div style="font-size:18px;color:#27ae60;font-weight:900">đź’° <span id="sm-earn">0</span> zĹ‚</div></div>
    <div style="flex:1;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700"><span id="sm-msg" style="color:#f1c40f"></span></div>`;
  wrap.appendChild(infoRow);

  const cvs=document.createElement('canvas');
  cvs.width=760;cvs.height=320;
  cvs.style.cssText='border:2px solid #2a4a3a;border-radius:10px;display:block;cursor:pointer;box-shadow:0 6px 24px rgba(46,204,113,.2)';
  wrap.appendChild(cvs);
  const cx=cvs.getContext('2d');

  const exitBtn=document.createElement('button');
  exitBtn.textContent='âś• WyjdĹş';
  exitBtn.style.cssText='margin-top:8px;background:linear-gradient(135deg,#3a0a0a,#1a0a0a);border:1px solid #5a1a1a;color:#e74c3c;padding:10px 26px;cursor:pointer;border-radius:6px;font-size:14px;font-weight:700;font-family:inherit';
  exitBtn.onclick=()=>{gameActive=false;cleanup();};
  wrap.appendChild(exitBtn);

  function cleanup(){
    gameActive=false;
    if(window._smTimer){clearInterval(window._smTimer);window._smTimer=null;}
    if(window._smRaf){cancelAnimationFrame(window._smRaf);window._smRaf=null;}
    document.removeEventListener('keydown',smKeyHandler);
    el.classList.remove('on');el.style.display='none';
    el.innerHTML='<div id="mg-job-content"></div>';
    if(totalEarned>0||customersServed>0){
      const finalPay=totalEarned;
      earn(finalPay);
      addXP(customersServed*15);
      G.energy=clampStat('energy', G.energy-3); // v1.8.59: supermarket 6â†’3 (-70% od oryginaĹ‚u 10)
      progressQuest('supermarket');
      notify(`đź›’ Supermarket: obsĹ‚uĹĽono ${customersServed} klientĂłw, +${finalPay} zĹ‚!`);
      updateHUD();
    }
  }

  function tryScanning(){
    if(!gameActive||currentItems.length===0)return;
    // Find first unscanned item that's in the scan zone (x < 240)
    const toScan=currentItems.find(it=>!it.scanned&&it.x<240);
    if(toScan){
      toScan.scanned=true;scannedCount++;
      scanFlash=15;flashColor='#27ae60';
      // Check if all scanned
      if(scannedCount>=currentItems.length){
        const elapsed=(Date.now()-customerStartTime)/1000;
        const speedBonus=Math.max(0,Math.floor(5-elapsed*0.5)); // max +5 za szybkoĹ›Ä‡
        // F3-FIX-B: getPracaBonus uwzglednia skill+PU+evo (nie tylko skill jak wczesniej)
        /* v2.1.117: Wave 6 W61 â€” Supermarket buff base 5â†’15 zĹ‚ (gracz dostaje ~3Ă— wiÄ™cej, wyrĂłwnuje z pizza/kurier). */
        const pay=Math.floor((15+speedBonus*1.5+currentItems.length*1.2)*getPracaBonus('supermarket'));
        /* v2.1.120: Wave 6 N19 â€” rep konsystencja: +1 rep co 5 obsĹ‚uĹĽonych klientĂłw (parallel z pizza/kurier). */
        G._smCustomersServed=(G._smCustomersServed||0)+1;
        if(G._smCustomersServed%5===0){G.streetRep=Math.min(100,(G.streetRep||0)+1);if(typeof addNotif==='function')addNotif('đź›’ +1 rep uliczna (kolejni stali klienci znajÄ… CiÄ™)');}
        totalEarned+=pay;customersServed++;
        const el2=document.getElementById('sm-earn');if(el2)el2.textContent=totalEarned;
        const el3=document.getElementById('sm-cust');if(el3)el3.textContent=customersServed;
        const smMsg=document.getElementById('sm-msg');if(smMsg){smMsg.textContent=`+${pay} zĹ‚! Nowy klient...`;setTimeout(()=>{if(smMsg)smMsg.textContent='';},1500);}
        scanFlash=30;flashColor='#f1c40f';
        // Win condition: 5 customers
        if(customersServed>=5&&gameActive){
          gameActive=false;
          cx.fillStyle='rgba(0,0,0,.85)';cx.fillRect(0,0,760,320);
          cx.font='bold 30px "Segoe UI",Arial';cx.textAlign='center';
          cx.lineWidth=4;cx.strokeStyle='rgba(0,0,0,.85)';
          cx.strokeText('âś… Zmiana zakoĹ„czona!',380,140);
          cx.fillStyle='#27ae60';cx.fillText('âś… Zmiana zakoĹ„czona!',380,140);
          cx.font='bold 18px "Segoe UI",Arial';
          cx.strokeText(`ObsĹ‚uĹĽono ${customersServed} klientĂłw`,380,180);
          cx.fillStyle='#7ec8e3';cx.fillText(`ObsĹ‚uĹĽono ${customersServed} klientĂłw`,380,180);
          cx.font='bold 22px "Segoe UI",Arial';
          cx.strokeText(`+${totalEarned} zĹ‚`,380,220);
          cx.fillStyle='#f1c40f';cx.fillText(`+${totalEarned} zĹ‚`,380,220);
          cx.textAlign='left';
          const _smToken=window._smSessionToken;setTimeout(()=>{if(window._smSessionToken===_smToken)cleanup();},2500);return;
        }
        setTimeout(()=>{if(gameActive)newCustomer();},1000);
      }
    } else {
      scanFlash=8;flashColor='#e74c3c'; // nothing in zone
    }
  }

  const smKeyHandler=(e)=>{
    if(e.code==='Space'){e.preventDefault();tryScanning();}
  };
  document.addEventListener('keydown',smKeyHandler);

  cvs.addEventListener('click',()=>tryScanning());

  window._smTimer=setInterval(()=>{
    if(!gameActive)return;
    timeLeft--;
    const te=document.getElementById('sm-time');if(te)te.textContent=timeLeft;
    if(timeLeft<=0){gameActive=false;cleanup();}
  },1000);

  newCustomer();

  function draw(){
    if(!gameActive&&el.style.display==='none')return;
    // TĹ‚o â€” gradient sklepu
    const bg=cx.createLinearGradient(0,0,0,320);
    bg.addColorStop(0,'#0a1a14');bg.addColorStop(1,'#050a08');
    cx.fillStyle=bg;cx.fillRect(0,0,760,320);
    // Sklep â€” pĂłĹ‚ki w tle (dekoracja)
    for(let s=0;s<3;s++){
      const sy=20+s*40;
      cx.fillStyle='rgba(40,60,50,.3)';cx.fillRect(20,sy,720,30);
      cx.fillStyle='rgba(60,80,70,.2)';cx.fillRect(20,sy,720,4);
    }

    // Conveyor belt â€” premium look
    const beltY=200,beltH=70;
    const beltGrad=cx.createLinearGradient(0,beltY,0,beltY+beltH);
    beltGrad.addColorStop(0,'#2a3545');beltGrad.addColorStop(.5,'#1a2535');beltGrad.addColorStop(1,'#0a1525');
    cx.fillStyle=beltGrad;cx.fillRect(0,beltY,560,beltH);
    // Belt lines (moving)
    conveyorX=(conveyorX+1.5)%40;
    cx.strokeStyle='rgba(60,80,100,.5)';cx.lineWidth=2;
    for(let bx=-40+conveyorX;bx<560;bx+=40){
      cx.beginPath();cx.moveTo(bx,beltY);cx.lineTo(bx,beltY+beltH);cx.stroke();
    }
    // Belt edges
    cx.fillStyle='#0a0e18';cx.fillRect(0,beltY-3,560,3);
    cx.fillStyle='#0a0e18';cx.fillRect(0,beltY+beltH,560,3);

    // SCAN ZONE â€” ĹĽĂłĹ‚ta strefa skanera (wyraĹşnie widoczna)
    const scanX=120,scanW=120;
    cx.fillStyle='rgba(241,196,15,.10)';cx.fillRect(scanX,beltY,scanW,beltH);
    cx.strokeStyle='rgba(241,196,15,.7)';cx.lineWidth=2;cx.setLineDash([6,4]);
    cx.strokeRect(scanX,beltY,scanW,beltH);
    cx.setLineDash([]);
    // SCAN ZONE label
    cx.shadowBlur=0;cx.shadowColor='transparent';
    cx.font='bold 13px "Segoe UI",Arial';cx.textAlign='center';
    cx.lineWidth=3;cx.lineJoin='round';cx.strokeStyle='rgba(0,0,0,.85)';
    cx.strokeText('đź”´ STREFA SKANERA',scanX+scanW/2,beltY-8);
    cx.fillStyle='#f1c40f';cx.fillText('đź”´ STREFA SKANERA',scanX+scanW/2,beltY-8);

    // Scan flash effect
    if(scanFlash>0){
      const alpha=scanFlash/30;
      cx.fillStyle=`${flashColor}${Math.floor(alpha*100).toString(16).padStart(2,'0')}`;
      cx.fillRect(scanX,beltY,scanW,beltH);
      scanFlash--;
    }

    // Move items
    currentItems.forEach(item=>{
      if(!item.scanned&&item.x>50){
        item.x-=1.5; // conveyor speed
      }
    });

    // Draw items on belt â€” premium look
    currentItems.forEach(item=>{
      if(item.scanned){
        if(item.x>10){item.x-=2;}
        cx.globalAlpha=0.3;
      } else {
        cx.globalAlpha=1.0;
      }
      if(item.x>-60&&item.x<760){
        const itemY=beltY+10;
        // CieĹ„ pod produktem
        cx.fillStyle='rgba(0,0,0,.4)';cx.fillRect(item.x-32,itemY+48,64,4);
        // Box produktu
        cx.fillStyle=item.color;
        cx.fillRect(item.x-35,itemY,70,50);
        // Highlight (top)
        cx.fillStyle='rgba(255,255,255,.18)';cx.fillRect(item.x-35,itemY,70,4);
        // Border
        cx.strokeStyle='rgba(0,0,0,.6)';cx.lineWidth=1.5;cx.strokeRect(item.x-35,itemY,70,50);
        // Emoji
        cx.font='28px Arial';cx.textAlign='center';cx.textBaseline='middle';
        cx.fillText(item.emoji,item.x,itemY+22);
        // Price â€” czytelny stroke
        cx.font='bold 11px "Segoe UI",Arial';cx.textBaseline='alphabetic';
        cx.lineWidth=2.5;cx.strokeStyle='rgba(0,0,0,.9)';
        cx.strokeText(item.price.toFixed(2)+' zĹ‚',item.x,itemY+47);
        cx.fillStyle='#fff';cx.fillText(item.price.toFixed(2)+' zĹ‚',item.x,itemY+47);
        cx.globalAlpha=1.0;
      }
    });
    cx.globalAlpha=1.0;

    // Cashier panel â€” premium kasa
    const kasaX=580,kasaY=140,kasaW=170,kasaH=170;
    const kasaGrad=cx.createLinearGradient(kasaX,kasaY,kasaX,kasaY+kasaH);
    kasaGrad.addColorStop(0,'#1a2a3a');kasaGrad.addColorStop(1,'#0a1525');
    cx.fillStyle=kasaGrad;cx.fillRect(kasaX,kasaY,kasaW,kasaH);
    cx.strokeStyle='#3a5a7a';cx.lineWidth=2;cx.strokeRect(kasaX,kasaY,kasaW,kasaH);
    // TytuĹ‚ "KASA"
    cx.font='bold 11px "Segoe UI",Arial';cx.textAlign='center';
    cx.lineWidth=2.5;cx.strokeStyle='rgba(0,0,0,.9)';
    cx.strokeText('đź’µ KASA',kasaX+kasaW/2,kasaY+18);
    cx.fillStyle='#7ec8e3';cx.fillText('đź’µ KASA',kasaX+kasaW/2,kasaY+18);
    // WyĹ›wietlacz
    cx.fillStyle='#0a3a1a';cx.fillRect(kasaX+10,kasaY+28,kasaW-20,52);
    cx.strokeStyle='#27ae60';cx.lineWidth=1;cx.strokeRect(kasaX+10,kasaY+28,kasaW-20,52);
    const total=currentItems.filter(i=>i.scanned).reduce((s,i)=>s+i.price,0);
    cx.fillStyle='#7ec87e';cx.font='bold 13px "Courier New",monospace';
    cx.fillText(`${scannedCount}/${currentItems.length} szt.`,kasaX+kasaW/2,kasaY+48);
    cx.font='bold 18px "Courier New",monospace';
    cx.fillText(`${total.toFixed(2)} zĹ‚`,kasaX+kasaW/2,kasaY+72);
    // Kasjer (bardziej szczegĂłĹ‚owa figura)
    const kxC=kasaX+kasaW/2;
    // TuĹ‚Ăłw
    cx.fillStyle='#27ae60';cx.fillRect(kxC-22,kasaY+105,44,55);
    // Krawat / fartuch
    cx.fillStyle='#1a7a3a';cx.fillRect(kxC-4,kasaY+108,8,40);
    // GĹ‚owa
    cx.fillStyle='#e0b080';cx.beginPath();cx.arc(kxC,kasaY+98,18,0,Math.PI*2);cx.fill();
    // WĹ‚osy
    cx.fillStyle='#5a3a18';cx.beginPath();cx.arc(kxC,kasaY+90,16,Math.PI,0);cx.fill();
    // Oczy
    cx.fillStyle='#000';cx.fillRect(kxC-7,kasaY+96,2,2);cx.fillRect(kxC+5,kasaY+96,2,2);
    // UĹ›miech
    cx.strokeStyle='#000';cx.lineWidth=1;cx.beginPath();cx.arc(kxC,kasaY+103,4,0,Math.PI);cx.stroke();
    cx.textAlign='left';cx.textBaseline='alphabetic';

    // Instrukcja u doĹ‚u
    cx.font='bold 12px "Segoe UI",Arial';cx.textAlign='center';
    cx.lineWidth=2.5;cx.strokeStyle='rgba(0,0,0,.85)';
    cx.strokeText('âŚ¨ď¸Ź SPACJA lub đź–± KLIK gdy produkt w ĹĽĂłĹ‚tej strefie',380,300);
    cx.fillStyle='#aac';cx.fillText('âŚ¨ď¸Ź SPACJA lub đź–± KLIK gdy produkt w ĹĽĂłĹ‚tej strefie',380,300);
    cx.textAlign='left';

    if(gameActive)window._smRaf=requestAnimationFrame(draw);
  }

  window._jobMgCleanup=()=>{
    gameActive=false;
    if(window._smTimer){clearInterval(window._smTimer);window._smTimer=null;}
    if(window._smRaf){cancelAnimationFrame(window._smRaf);window._smRaf=null;}
    document.removeEventListener('keydown',smKeyHandler);
    el.classList.remove('on');el.style.display='none';
    el.innerHTML='<div id="mg-job-content"></div>';
  };

  draw();
}

function startKurierMG(){
  showJobIntro({icon:'đźš˛',name:'Kurier rowerowy',wage:'20â€“50',difficulty:'Ĺatwa',diffColor:'#27ae60',
    desc:'Dostarczaj paczki WASD/strzaĹ‚kami. Im wiÄ™cej paczek w czasie â€” tym wyĹĽszy zarobek. Deszcz = bonus +25%.',
    skillKey:'kurier'},()=>_startKurierGame());
}
function _startKurierGame(){
  closeOverlay();
  const panel=document.getElementById('mg-job');panel.classList.add('on');
  panel.innerHTML='<div id="mg-job-content"></div>';
  document.getElementById('mg-job-content').innerHTML=`
    <div style="display:flex;flex-direction:column;align-items:center;gap:8px;width:100%">
      <h2 style="color:#f39c12;margin:0">đźš˛ Kurier rowerowy</h2>
      <p style="color:#667;font-size:13px;margin:0">WASD / strzaĹ‚ki â€” jedĹş do paczek đź“¦ i dostarczaj je!</p>
      <div style="display:flex;gap:28px;font-size:15px;color:#aaa">
        <span>âŹ± <strong id="kt-time" style="color:#f1c40f">60</strong>s</span>
        <span>đź“¦ Dostarczone: <strong id="kt-pkgs" style="color:#27ae60">0</strong> / 4</span>
        <span id="kt-msg" style="color:#7ec8e3;font-weight:700"></span>
      </div>
      <canvas id="kurier-cv" width="700" height="400" style="border:2px solid #1a2a3a;border-radius:8px;background:#1e2e1e"></canvas>
      <button class="cbtn" onclick="if(window._jobMgCleanup)window._jobMgCleanup()">â† PorzuÄ‡ trasÄ™</button>
    </div>`;
  const cv=document.getElementById('kurier-cv');const ctx=cv.getContext('2d');
  const W=700,H=400,RW=34;
  const hR=[75,200,325],vR=[75,220,380,530,630];
  const carBoost=G.car?G.car.speed||1:1;
  const pl={x:75,y:200,spd:2.4*Math.max(1,carBoost*.7+.3),r:11};
  const pts=[{x:220,y:75},{x:380,y:325},{x:530,y:200},{x:220,y:325}];
  pts.forEach(p=>p.done=false);
  let timeLeft=60,delivered=0,over=false,_startTs=Date.now();
  const KK={};
  const kd=e=>{KK[e.key]=true;['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)&&e.preventDefault();};
  const ku=e=>delete KK[e.key];
  document.addEventListener('keydown',kd);document.addEventListener('keyup',ku);
  const tmr=setInterval(()=>{if(over)return;timeLeft=Math.max(0,60-Math.floor((Date.now()-_startTs)/1000));const el=document.getElementById('kt-time');if(el)el.textContent=timeLeft;if(timeLeft<=0){over=true;clearInterval(tmr);_finKurier(delivered);}},200);
  let raf;
  const bldgs=[
    {x:5,y:5,w:62,h:60,c:'#162030'},{x:92,y:8,w:120,h:55,c:'#1a1828'},
    {x:240,y:5,w:130,h:60,c:'#1c1a20'},{x:400,y:10,w:120,h:53,c:'#162030'},
    {x:548,y:6,w:74,h:60,c:'#1a2018'},{x:654,y:8,w:40,h:56,c:'#1c1a20'},
    {x:92,y:93,w:120,h:98,c:'#1a1828'},{x:240,y:93,w:130,h:98,c:'#1c1a20'},
    {x:400,y:93,w:120,h:98,c:'#162030'},{x:548,y:90,w:74,h:100,c:'#1a2018'},
    {x:92,y:218,w:120,h:96,c:'#162030'},{x:240,y:218,w:130,h:96,c:'#1a1828'},
    {x:400,y:218,w:120,h:96,c:'#1c1a20'},{x:548,y:218,w:74,h:96,c:'#1a2018'},
    {x:5,y:350,w:62,h:44,c:'#1c1a20'},{x:238,y:350,w:130,h:44,c:'#162030'},
    {x:398,y:350,w:122,h:44,c:'#1a1828'},{x:652,y:350,w:42,h:44,c:'#1a2018'},
  ];
  const loop=()=>{
    if(!document.getElementById('kurier-cv')){cancelAnimationFrame(raf);return;}
    ctx.clearRect(0,0,W,H);ctx.fillStyle='#1e2e1e';ctx.fillRect(0,0,W,H);
    ctx.fillStyle='#2a2a2a';hR.forEach(y=>ctx.fillRect(0,y-RW/2,W,RW));vR.forEach(x=>ctx.fillRect(x-RW/2,0,RW,H));
    ctx.strokeStyle='rgba(220,190,20,.35)';ctx.setLineDash([16,12]);ctx.lineWidth=2;
    hR.forEach(y=>{ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();});
    vR.forEach(x=>{ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();});
    ctx.setLineDash([]);
    bldgs.forEach(b=>{ctx.fillStyle=b.c;ctx.fillRect(b.x,b.y,b.w,b.h);ctx.strokeStyle='rgba(60,100,160,.2)';ctx.lineWidth=1;ctx.strokeRect(b.x,b.y,b.w,b.h);});
    const now=Date.now();
    pts.forEach((p,i)=>{
      if(p.done)return;
      const pulse=0.8+Math.sin(now*.005+i)*0.2;
      // v1.8.49: alpha 0.35â†’0.55 â€” paczki bardziej widoczne przy szybkim dostarczeniu
      ctx.save();ctx.globalAlpha=pulse*.55;ctx.fillStyle='#f1c40f';ctx.beginPath();ctx.arc(p.x,p.y,24,0,Math.PI*2);ctx.fill();ctx.restore();
      ctx.fillStyle='#c8880a';ctx.fillRect(p.x-13,p.y-13,26,26);
      ctx.strokeStyle='#f1c40f';ctx.lineWidth=2;ctx.strokeRect(p.x-13,p.y-13,26,26);
      ctx.fillStyle='#f1c40f';ctx.font='bold 12px "Segoe UI"';ctx.textAlign='center';ctx.fillText('#'+(i+1),p.x,p.y+4);
    });ctx.textAlign='left';
    if(!over){
      if(KK['ArrowLeft']||KK['a']||KK['A'])pl.x-=pl.spd;
      if(KK['ArrowRight']||KK['d']||KK['D'])pl.x+=pl.spd;
      if(KK['ArrowUp']||KK['w']||KK['W'])pl.y-=pl.spd;
      if(KK['ArrowDown']||KK['s']||KK['S'])pl.y+=pl.spd;
      pl.x=Math.max(pl.r,Math.min(W-pl.r,pl.x));pl.y=Math.max(pl.r,Math.min(H-pl.r,pl.y));
      pts.forEach(p=>{if(p.done)return;if(Math.hypot(pl.x-p.x,pl.y-p.y)<26){p.done=true;delivered++;const d=document.getElementById('kt-pkgs');if(d)d.textContent=delivered;const m=document.getElementById('kt-msg');if(m){m.textContent='âś… Dostarczona!';setTimeout(()=>{if(m)m.textContent='';},700);}if(delivered>=4){over=true;clearInterval(tmr);_finKurier(delivered);}}});
    }
    ctx.fillStyle='rgba(0,0,0,.18)';ctx.beginPath();ctx.ellipse(pl.x+2,pl.y+6,11,4,0,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle='#444';ctx.lineWidth=3;ctx.beginPath();ctx.arc(pl.x-7,pl.y+4,9,0,Math.PI*2);ctx.stroke();ctx.beginPath();ctx.arc(pl.x+9,pl.y+4,9,0,Math.PI*2);ctx.stroke();
    ctx.strokeStyle='#e74c3c';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(pl.x-7,pl.y+4);ctx.lineTo(pl.x+1,pl.y-5);ctx.lineTo(pl.x+9,pl.y+4);ctx.stroke();ctx.beginPath();ctx.moveTo(pl.x+1,pl.y-5);ctx.lineTo(pl.x-2,pl.y-9);ctx.stroke();
    ctx.fillStyle=SKIN_COLS[P.skin]||'#e0a870';ctx.beginPath();ctx.arc(pl.x,pl.y-12,6,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=P.cloth||'#2a5080';ctx.fillRect(pl.x-6,pl.y-11,12,8);
    if(!over)raf=requestAnimationFrame(loop);
  };
  raf=requestAnimationFrame(loop);
  function _finKurier(count){
    clearInterval(tmr);cancelAnimationFrame(raf);document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku);
    // BALANS #63: 20â†’12 zĹ‚/paczka + bonus za czas 0.4â†’0.25 â€” kurier zarabiaĹ‚ ~100zĹ‚/min, teraz ~50zĹ‚/min (zgodne z innymi Tier 1)
    // BALANS #65: kurier rep z count*2 â†’ count*0.5 (zaokrÄ…glone do 0/1) â€” dawaĹ‚ +8 rep/trasa, teraz +1-2/trasa
    // #84 NERF -30% â€” kurier byĹ‚ ~50zĹ‚/min, teraz ~33zĹ‚/min (gracz prosiĹ‚ wiÄ™kszy grind)
    let pay=0;if(count>0){pay=Math.floor(count*8+timeLeft*0.18);pay=Math.floor(pay*getPracaBonus('kurier')); /*F3-FIX-B*/ if(G._repBoost25)pay=Math.floor(pay*1.2);if(G.weather===2||G.weather===5)pay=Math.floor(pay*1.25);earn(pay);G.energy=clampStat('energy', G.energy-count*2);G.hunger=clampStat('hunger', G.hunger-count*5);addXP(count*12);
      // v1.8.61: kurier rep â€” +1 co 5 ukoĹ„czonych tras (zamiast 1 per trasa).
      G._kurierTrips=(G._kurierTrips||0)+1;
      if(G._kurierTrips%5===0) G.streetRep=clamp(G.streetRep+1,0,100);
    }
    progressQuest('kurier'); // v1.8.44: zawsze progressuje quest (nawet count=0 = czas minÄ…Ĺ‚, gracz wciÄ…ĹĽ prĂłbowaĹ‚)
    updateHUD();
    const c2=ctx;c2.fillStyle='rgba(0,0,0,.82)';c2.fillRect(0,0,W,H);
    c2.fillStyle=count>0?'#27ae60':'#e74c3c';c2.font='bold 30px "Segoe UI"';c2.textAlign='center';
    c2.fillText(count>0?`đźŹ ${count}/4 paczek Â· +${pay} zĹ‚`:'âŹ± Czas minÄ…Ĺ‚!',W/2,H/2-20);
    c2.fillStyle='#7ec8e3';c2.font='18px "Segoe UI"';
    c2.fillText(count>=4?'Wszystkie paczki dostarczone!':count>0?`Dostarczone ${count}/4`:'Nie dostarczono ĹĽadnej paczki',W/2,H/2+15);
    c2.textAlign='left';
    // Show next route button in HTML
    const btnDiv=document.createElement('div');
    btnDiv.style.cssText='display:flex;gap:12px;margin-top:10px;';
    btnDiv.innerHTML=`
      <button onclick="this.closest('div').remove();startKurierMG();" style="flex:1;background:#0a2a0a;border:2px solid #27ae60;color:#27ae60;padding:12px;cursor:pointer;border-radius:6px;font-size:15px;font-weight:700;">đźš˛ NastÄ™pna trasa [SPACJA]</button>
      <button onclick="window._jobMgCleanup&&window._jobMgCleanup();" style="flex:1;background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:12px;cursor:pointer;border-radius:6px;font-size:15px;">âś• ZakoĹ„cz</button>
    `;
    const panelContent=document.getElementById('mg-job-content');
    if(panelContent)panelContent.appendChild(btnDiv);
    // Also allow space to start next route
    const _nextKey=e=>{
      if(e.code==='Space'){e.preventDefault();document.removeEventListener('keydown',_nextKey);btnDiv.remove();startKurierMG();}
    };
    document.addEventListener('keydown',_nextKey);
    window._jobMgCleanup=()=>{
      document.removeEventListener('keydown',_nextKey);
      panel.classList.remove('on');panel.style.display='none';document.getElementById('mg-job-content').innerHTML='';updateHUD();
    };
  }
  window._jobMgCleanup=()=>{over=true;clearInterval(tmr);cancelAnimationFrame(raf);document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku);panel.classList.remove('on');panel.style.display='none';document.getElementById('mg-job-content').innerHTML='';updateHUD();};
}

function startCarwashMG(){
  showJobIntro({icon:'đźš—',name:'Myjnia â€” Karcher',wage:'25â€“50',difficulty:'Ĺšrednia',diffColor:'#f1c40f',
    desc:'6 etapĂłw: Piana â†’ Szorowanie â†’ Mycie ciĹ›nieniowe â†’ SpĹ‚ukiwanie â†’ Woskowanie â†’ NabĹ‚yszczanie. UkoĹ„cz wszystko dla peĹ‚nego bonusu!',
    skillKey:'carwash'},()=>_startCarwashGame());
}
function _startCarwashGame(){
  closeOverlay();
  const panel=document.getElementById('mg-job');panel.classList.add('on');
  // PrzywrĂłÄ‡ mg-job-content (showJobIntro zastÄ…piĹ‚o innerHTML panelan)
  panel.innerHTML='<div id="mg-job-content" style="display:flex;flex-direction:column;align-items:center;width:100%"></div>';
  const STAGE_NAMES=['đź§´ Aktywna Piana','đź§˝ Szorowanie','đź’¦ Mycie ciĹ›nieniowe','đź’§ SpĹ‚ukiwanie','đźŞś Woskowanie','âś¨ NabĹ‚yszczanie'];
  /* v2.1.175: rĂłĹĽne mechaniki dla kaĹĽdego etapu â€” user "mycie ciĹ›nieniowe â‰ spĹ‚ukiwanie, woskowanie â‰ nabĹ‚yszczanie" */
  const STAGE_INST=['Trzymaj SPACJÄ â€” nakĹ‚adaj pianÄ™ karczerem!','PrzeciÄ…gaj myszÄ… po aucie â€” szoruj! (wymaga ruchu)','Wciskaj rytmicznie SPACJÄ â€” wysokie ciĹ›nienie!','Trzymaj SPACJÄ â€” spĹ‚ucz wodÄ…!','PrzeciÄ…gaj myszÄ… po aucie â€” nakĹ‚adaj wosk!','RĂłb KĂ“ĹKA myszÄ… â€” nabĹ‚yszczaj auto!'];
  document.getElementById('mg-job-content').innerHTML=`
    <div style="display:flex;flex-direction:column;align-items:center;gap:8px;width:100%">
      <h2 style="color:#3498db;margin:0;font-family:"Segoe UI",sans-serif">đźš— Myjnia â€” Profesjonalne mycie</h2>
      <div style="display:flex;gap:4px;margin-bottom:2px;flex-wrap:wrap;justify-content:center" id="cw-stages">
        ${STAGE_NAMES.map((n,i)=>`<span id="cws-${i}" style="padding:3px 8px;border-radius:12px;font-size:11px;font-family:"Segoe UI",sans-serif;background:${i===0?'#1a3a5a':'#101820'};color:${i===0?'#3498db':'#444'};border:1px solid ${i===0?'#3498db':'#222'}">${n}</span>`).join('')}
      </div>
      <span id="cw-inst" style="color:#7ec8e3;font-weight:700;font-family:"Segoe UI",sans-serif;font-size:14px">...</span>
      <div style="width:660px;height:10px;background:#0a1220;border-radius:5px;overflow:hidden">
        <div id="cw-prog" style="height:100%;width:0%;background:linear-gradient(90deg,#1a6aa0,#3498db,#5dade2);transition:width .08s;border-radius:5px"></div>
      </div>
      <div style="color:#7ec8e3;font-size:13px;font-family:"Segoe UI",sans-serif;margin-top:2px">âŹ± Czas: <span id="cw-time" style="color:#f1c40f;font-weight:700">150s</span></div>
      <canvas id="cw-cv" width="660" height="280" style="border-radius:8px;cursor:crosshair"></canvas>
      <button class="cbtn" onclick="if(window._jobMgCleanup)window._jobMgCleanup()">â† PorzuÄ‡</button>
    </div>`;
  const cv=document.getElementById('cw-cv');const ctx=cv.getContext('2d');const W=660,H=280;
  const carX=80,carY=60,carW=500,carH=145;
  // 6 etapĂłw: 0=aktywna piana, 1=szorowanie, 2=mycie ciĹ›nieniowe, 3=spĹ‚ukiwanie, 4=woskowanie, 5=nabĹ‚yszczanie
  let stage=0,over=false,raf,transitioning=false;
  let spaceHeld=false,mousePos={x:-1,y:-1},prevMouse={x:-1,y:-1};
  let particles=[];
  let foamLevel=0,scrubProgress=0,washProgress=0,rinseProgress=0,waxProgress=0,shineProgress=0;
  let foamAlpha=0,waxAlpha=0,shineTime=0,karcherX=0;

  function setStage(s){
    stage=s;transitioning=false;
    const inst=document.getElementById('cw-inst');if(inst){inst.textContent=STAGE_INST[s]||'';inst.style.color=s>=4?'#f1c40f':'#7ec8e3';}
    for(let i=0;i<6;i++){
      const el=document.getElementById('cws-'+i);if(!el)continue;
      if(i<s){el.style.background='#0a3a1a';el.style.color='#27ae60';el.style.borderColor='#27ae60';}
      else if(i===s){el.style.background='#1a3a5a';el.style.color='#3498db';el.style.borderColor='#3498db';}
      else{el.style.background='#101820';el.style.color='#444';el.style.borderColor='#222';}
    }
    const pr=document.getElementById('cw-prog');if(pr)pr.style.width='0%';
  }
  function addParticles(type,x,y,count){
    for(let i=0;i<count;i++){
      const angle=(Math.random()-0.5)*Math.PI*(type==='karcher'?0.5:2);
      const spd=type==='karcher'?3+Math.random()*4:0.5+Math.random()*2;
      particles.push({x,y,vx:Math.cos(angle)*spd,vy:Math.sin(angle)*spd-1,life:1,type,r:type==='wax'?2+Math.random()*3:type==='foam'?3+Math.random()*4:2+Math.random()*2});
    }
  }

  const keydown=e=>{if(e.code==='Space'){e.preventDefault();spaceHeld=true;
    /* v2.1.175: tap counter dla Etap 2 (mycie ciĹ›nieniowe â€” RAPID TAP) */
    if(stage===2 && !e.repeat){
      window._cwLastTap=Date.now();
      washProgress=Math.min(100,washProgress+6); /* ~17 tapĂłw do 100% */
      const jx=carX-20+karcherX;if(jx>carX&&jx<carX+carW){addParticles('karcher',jx,carY+70,5);foamAlpha=Math.max(0,foamAlpha-0.03);}
    }
  }};
  const keyup=e=>{if(e.code==='Space')spaceHeld=false;};
  document.addEventListener('keydown',keydown);document.addEventListener('keyup',keyup);
  cv.addEventListener('mousemove',e=>{
    const r=cv.getBoundingClientRect();
    prevMouse.x=mousePos.x;prevMouse.y=mousePos.y;
    mousePos={x:(e.clientX-r.left)*(W/r.width),y:(e.clientY-r.top)*(H/r.height)};
  });
  setStage(0);
  // v1.8.44: time limit 150s â€” gracz nie utknie w minigrze. Po czasie partial payout proporcjonalny do progresu.
  let _cwStartTime=Date.now();
  let _cwTimerInt=setInterval(()=>{
    if(over){clearInterval(_cwTimerInt);return;}
    const _el=Math.floor((Date.now()-_cwStartTime)/1000);
    const _rem=Math.max(0,150-_el);
    const _te=document.getElementById('cw-time');if(_te)_te.textContent=_rem+'s';
    if(_rem<=0){clearInterval(_cwTimerInt);if(!over){
      // Partial payout proporcjonalny do stage
      let _partPay=Math.floor(75*(stage/6)*getPracaBonus('carwash'));
      if(_partPay>0)earn(_partPay);
      G.energy=clampStat('energy', G.energy-4);addXP(Math.floor(20*stage/6)); // v1.8.59: carwash timeout 8â†’4 (-70% od oryginaĹ‚u 12)
      progressQuest('carwash');
      over=true;cancelAnimationFrame(raf);
      document.removeEventListener('keydown',keydown);document.removeEventListener('keyup',keyup);
      ctx.fillStyle='rgba(0,0,0,.85)';ctx.fillRect(0,0,W,H);
      ctx.fillStyle='#e74c3c';ctx.font='bold 26px "Segoe UI",sans-serif';ctx.textAlign='center';
      ctx.fillText('âŹ± Czas minÄ…Ĺ‚ â€” '+stage+'/6 etapĂłw',W/2,H/2-15);
      ctx.fillStyle='#f1c40f';ctx.font='bold 22px "Segoe UI",sans-serif';
      ctx.fillText(_partPay>0?`+${_partPay} zĹ‚ (proporcjonalnie)`:'Brak wypĹ‚aty',W/2,H/2+18);
      ctx.textAlign='left';closeJobPanelAfter(3000);
    }}
  },1000);

  const draw=()=>{
    if(!document.getElementById('cw-cv')){cancelAnimationFrame(raf);return;}
    ctx.clearRect(0,0,W,H);
    // TĹ‚o â€” myjnia
    ctx.fillStyle='#0a1018';ctx.fillRect(0,0,W,H);
    ctx.fillStyle='#0d1520';ctx.fillRect(20,8,620,264);
    ctx.strokeStyle='#0a1825';ctx.lineWidth=1;
    for(let i=0;i<4;i++){ctx.beginPath();ctx.moveTo(0,230+i*10);ctx.lineTo(W,230+i*10);ctx.stroke();}
    ctx.fillStyle='#080e16';ctx.fillRect(310,245,40,15);

    // Auto â€” nadwozie
    ctx.fillStyle=shineProgress>60?'#4a6a9a':'#3a5a8a';ctx.fillRect(carX,carY+40,carW,carH-40);
    ctx.fillStyle='#2d4a78';ctx.beginPath();ctx.moveTo(carX+60,carY+40);ctx.lineTo(carX+140,carY+5);ctx.lineTo(carX+380,carY+5);ctx.lineTo(carX+450,carY+40);ctx.closePath();ctx.fill();
    ctx.fillStyle='rgba(100,190,255,.32)';ctx.beginPath();ctx.moveTo(carX+150,carY+8);ctx.lineTo(carX+220,carY+36);ctx.lineTo(carX+320,carY+36);ctx.lineTo(carX+380,carY+8);ctx.closePath();ctx.fill();
    ctx.fillStyle='#ffe870';ctx.fillRect(carX,carY+58,12,20);ctx.fillStyle='rgba(255,232,112,.3)';ctx.fillRect(carX-8,carY+50,8,36);
    ctx.fillStyle='#e03020';ctx.fillRect(carX+carW-12,carY+58,12,20);
    [carX+110,carX+carW-110].forEach(wx=>{
      ctx.fillStyle='#080808';ctx.beginPath();ctx.arc(wx,carY+carH+10,32,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='#1a1a1a';ctx.beginPath();ctx.arc(wx,carY+carH+10,20,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle='#2a2a2a';ctx.lineWidth=2;
      for(let i=0;i<5;i++){const a=i/5*Math.PI*2;ctx.beginPath();ctx.moveTo(wx+Math.cos(a)*8,carY+carH+10+Math.sin(a)*8);ctx.lineTo(wx+Math.cos(a)*18,carY+carH+10+Math.sin(a)*18);ctx.stroke();}
    });
    // NakĹ‚adki
    if(foamAlpha>0.01){
      ctx.fillStyle=`rgba(220,240,255,${foamAlpha*0.7})`;ctx.fillRect(carX,carY,carW,carH+5);
      for(let i=0;i<Math.floor(foamAlpha*22);i++){const bx=carX+Math.sin(i*137.5)*carW/2+carW/2;const by=carY+Math.cos(i*97.3)*carH/2+carH/2;ctx.fillStyle='rgba(255,255,255,0.4)';ctx.beginPath();ctx.arc(bx,by,3+i%4,0,Math.PI*2);ctx.fill();}
    }
    if(waxAlpha>0.01){ctx.fillStyle=`rgba(255,220,80,${waxAlpha*0.25})`;ctx.fillRect(carX,carY,carW,carH+5);}
    if(shineProgress>30){
      shineTime+=0.05;
      for(let i=0;i<4;i++){const sx=carX+100+i*100+Math.sin(shineTime+i)*20,sy=carY+20+Math.cos(shineTime*0.7+i)*15;
        ctx.fillStyle=`rgba(255,255,200,${0.35*shineProgress/100})`;ctx.beginPath();ctx.arc(sx,sy,4,0,Math.PI*2);ctx.fill();
        ctx.strokeStyle=`rgba(255,255,200,${0.5*shineProgress/100})`;ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(sx-8,sy);ctx.lineTo(sx+8,sy);ctx.moveTo(sx,sy-8);ctx.lineTo(sx,sy+8);ctx.stroke();}
    }

    // Etap 0 â€” Aktywna Piana (SPACE)
    if(stage===0){
      if(spaceHeld){
        karcherX=(karcherX+3)%(carW+80);const jx=carX-20+karcherX;
        ctx.strokeStyle='rgba(220,240,255,0.85)';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(20,80);ctx.lineTo(jx,carY+70);ctx.stroke();
        ctx.strokeStyle='rgba(255,255,255,0.4)';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(20,80);ctx.lineTo(jx,carY+50);ctx.stroke();
        ctx.fillStyle='#2a2a2a';ctx.fillRect(0,70,25,20);ctx.fillStyle='#1a3a5a';ctx.fillRect(25,75,10,10);
        if(jx>carX&&jx<carX+carW){addParticles('foam',jx,carY+70,5);foamLevel=Math.min(100,foamLevel+0.4);foamAlpha=foamLevel/100;}
        const pr=document.getElementById('cw-prog');if(pr)pr.style.width=foamLevel+'%';
        if(foamLevel>=100&&!transitioning){transitioning=true;setTimeout(()=>setStage(1),400);}
      } else {
        ctx.fillStyle='#2a2a2a';ctx.fillRect(0,70,25,20);ctx.fillStyle='#1a3a5a';ctx.fillRect(25,75,10,10);
        ctx.fillStyle='rgba(220,240,255,0.12)';ctx.beginPath();ctx.moveTo(30,80);ctx.lineTo(80,95);ctx.lineTo(80,115);ctx.lineTo(30,100);ctx.closePath();ctx.fill();
      }
    }
    // Etap 1 â€” Szorowanie (wymaga ruchu myszy)
    if(stage===1){
      const{x:mx,y:my}=mousePos;const spd=Math.hypot(mx-prevMouse.x,my-prevMouse.y);
      if(mx>carX-5&&mx<carX+carW+5&&my>carY-5&&my<carY+carH+5){
        if(spd>3){
          scrubProgress=Math.min(100,scrubProgress+0.5);addParticles('foam',mx,my,2);
          ctx.strokeStyle='rgba(255,255,255,0.65)';ctx.lineWidth=2;ctx.beginPath();ctx.arc(mx,my,28,0,Math.PI*2);ctx.stroke();
          ctx.fillStyle='rgba(255,255,255,0.12)';ctx.beginPath();ctx.arc(mx,my,28,0,Math.PI*2);ctx.fill();
          if(prevMouse.x>0){ctx.strokeStyle='rgba(220,240,255,0.25)';ctx.lineWidth=8;ctx.beginPath();ctx.moveTo(prevMouse.x,prevMouse.y);ctx.lineTo(mx,my);ctx.stroke();}
        } else {
          ctx.strokeStyle='rgba(255,255,255,0.25)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(mx,my,28,0,Math.PI*2);ctx.stroke();
        }
      }
      const pr=document.getElementById('cw-prog');if(pr)pr.style.width=scrubProgress+'%';
      if(scrubProgress>=100&&!transitioning){transitioning=true;setTimeout(()=>setStage(2),300);}
    }
    // v2.1.175 Etap 2 â€” Mycie ciĹ›nieniowe (RAPID TAP SPACE â€” odrĂłĹĽnienie od spĹ‚ukiwania/piany ktĂłre uĹĽywajÄ… hold)
    if(stage===2){
      karcherX=(karcherX+5)%(carW+80);const jx=carX-20+karcherX;
      /* StaĹ‚a animacja karczera + decay washProgress jeĹ›li nie tap */
      ctx.strokeStyle='rgba(50,150,255,0.4)';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(20,80);ctx.lineTo(jx,carY+70);ctx.stroke();
      ctx.fillStyle='#2a2a2a';ctx.fillRect(0,70,25,20);
      /* Progress decay slowly when not tapping */
      if(!window._cwLastTap || Date.now()-window._cwLastTap>1500) washProgress=Math.max(0,washProgress-0.15);
      /* Visual tap indicator */
      ctx.font='bold 14px "Segoe UI",sans-serif';ctx.fillStyle='rgba(50,150,255,0.85)';ctx.textAlign='center';
      ctx.fillText('Wciskaj SPACJÄ rytmicznie!',W/2,H-12);ctx.textAlign='left';
      const pr=document.getElementById('cw-prog');if(pr)pr.style.width=washProgress+'%';
      if(washProgress>=100&&!transitioning){transitioning=true;setTimeout(()=>setStage(3),400);}
    }
    // Etap 3 â€” SpĹ‚ukiwanie (SPACE)
    if(stage===3){
      if(spaceHeld){
        karcherX=(karcherX+4)%(carW+80);const jx=carX-20+karcherX;
        ctx.strokeStyle='rgba(100,210,255,0.75)';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(20,50);ctx.lineTo(jx,carY+60);ctx.stroke();
        ctx.fillStyle='#2a2a2a';ctx.fillRect(0,40,25,20);
        if(jx>carX&&jx<carX+carW){addParticles('karcher',jx,carY+60,3);foamAlpha=Math.max(0,foamAlpha-0.005);rinseProgress=Math.min(100,rinseProgress+0.35);}
        const pr=document.getElementById('cw-prog');if(pr)pr.style.width=rinseProgress+'%';
        if(rinseProgress>=100&&!transitioning){transitioning=true;setTimeout(()=>setStage(4),400);}
      } else {ctx.fillStyle='#2a2a2a';ctx.fillRect(0,40,25,20);}
    }
    // Etap 4 â€” Woskowanie (ruch myszy)
    if(stage===4){
      const{x:mx,y:my}=mousePos;const spd=Math.hypot(mx-prevMouse.x,my-prevMouse.y);
      if(mx>carX-5&&mx<carX+carW+5&&my>carY-5&&my<carY+carH+5){
        if(spd>2){waxProgress=Math.min(100,waxProgress+0.4);waxAlpha=waxProgress/100;addParticles('wax',mx,my,2);
          ctx.strokeStyle='rgba(255,220,80,0.65)';ctx.lineWidth=2;ctx.beginPath();ctx.arc(mx,my,24,0,Math.PI*2);ctx.stroke();
          ctx.fillStyle='rgba(255,220,80,0.12)';ctx.beginPath();ctx.arc(mx,my,24,0,Math.PI*2);ctx.fill();
        } else {ctx.strokeStyle='rgba(255,220,80,0.2)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(mx,my,24,0,Math.PI*2);ctx.stroke();}
      }
      const pr=document.getElementById('cw-prog');if(pr)pr.style.width=waxProgress+'%';
      if(waxProgress>=100&&!transitioning){transitioning=true;setTimeout(()=>setStage(5),300);}
    }
    // v2.1.175 Etap 5 â€” NabĹ‚yszczanie (CIRCULAR motion â€” odrĂłĹĽnienie od woskowania/szorowania ktĂłre sÄ… prostym drag)
    if(stage===5){
      const{x:mx,y:my}=mousePos;const spd=Math.hypot(mx-prevMouse.x,my-prevMouse.y);
      if(mx>carX-5&&mx<carX+carW+5&&my>carY-5&&my<carY+carH+5){
        /* Detect circular motion via angular change */
        if(!window._cwShineHistory) window._cwShineHistory=[];
        window._cwShineHistory.push({x:mx,y:my,t:Date.now()});
        if(window._cwShineHistory.length>20) window._cwShineHistory.shift();
        let circleCount=0;
        if(window._cwShineHistory.length>=8){
          /* Sum angle deltas â€” full circle ~2Ď€ */
          let lastAng=null,totalAng=0;
          const cx2=window._cwShineHistory.reduce((s,p)=>s+p.x,0)/window._cwShineHistory.length;
          const cy2=window._cwShineHistory.reduce((s,p)=>s+p.y,0)/window._cwShineHistory.length;
          for(const p of window._cwShineHistory){
            const ang=Math.atan2(p.y-cy2,p.x-cx2);
            if(lastAng!==null){
              let d=ang-lastAng;
              if(d>Math.PI)d-=Math.PI*2;else if(d<-Math.PI)d+=Math.PI*2;
              totalAng+=Math.abs(d);
            }
            lastAng=ang;
          }
          circleCount=totalAng/(Math.PI*2);
        }
        if(spd>3 && circleCount>0.3){
          shineProgress=Math.min(100,shineProgress+0.7);addParticles('wax',mx,my,3);
          ctx.strokeStyle='rgba(255,255,200,0.9)';ctx.lineWidth=2;ctx.beginPath();ctx.arc(mx,my,22,0,Math.PI*2);ctx.stroke();
          ctx.fillStyle='rgba(255,255,200,0.6)';ctx.beginPath();ctx.arc(mx,my,4,0,Math.PI*2);ctx.fill();
        } else if(spd>3){
          /* Ruch tak ale nie kĂłĹ‚ka â€” minimal progress + visual hint */
          shineProgress=Math.min(100,shineProgress+0.15);
          ctx.strokeStyle='rgba(255,255,200,0.3)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(mx,my,22,0,Math.PI*2);ctx.stroke();
        } else {ctx.strokeStyle='rgba(255,255,200,0.2)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(mx,my,22,0,Math.PI*2);ctx.stroke();}
      }
      /* Visual hint: draw circle indicator */
      ctx.font='bold 13px "Segoe UI",sans-serif';ctx.fillStyle='rgba(255,220,80,0.85)';ctx.textAlign='center';
      ctx.fillText('đź”„ RĂłb KĂ“ĹKA myszÄ… po aucie!',W/2,H-12);ctx.textAlign='left';
      const pr=document.getElementById('cw-prog');if(pr)pr.style.width=shineProgress+'%';
      if(shineProgress>=100&&!transitioning){transitioning=true;setTimeout(()=>_finCW(),400);}
    }
    // CzÄ…steczki
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.1;p.life-=0.04;
      if(p.life<=0){particles.splice(i,1);continue;}
      if(p.type==='foam'){ctx.fillStyle=`rgba(220,240,255,${p.life*0.7})`;ctx.beginPath();ctx.arc(p.x,p.y,p.r*p.life,0,Math.PI*2);ctx.fill();}
      else if(p.type==='wax'){ctx.fillStyle=`rgba(255,220,80,${p.life*0.6})`;ctx.beginPath();ctx.arc(p.x,p.y,p.r*p.life,0,Math.PI*2);ctx.fill();}
      else{ctx.fillStyle=`rgba(100,180,255,${p.life*0.8})`;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();}
    }
    // Info
    ctx.font='bold 12px "Segoe UI",sans-serif';ctx.fillStyle='rgba(126,200,227,0.85)';ctx.textAlign='right';
    ctx.fillText(`Etap ${Math.min(stage+1,6)}/6: ${STAGE_NAMES[stage]||''}`,W-10,18);ctx.textAlign='left';
    if(!over)raf=requestAnimationFrame(draw);
  };
  raf=requestAnimationFrame(draw);

  function _finCW(){
    over=true;cancelAnimationFrame(raf);
    document.removeEventListener('keydown',keydown);document.removeEventListener('keyup',keyup);
    // F3-FIX-B: getPracaBonus uwzglednia skill+PU+evo
    let pay=Math.floor(75*getPracaBonus('carwash'));
    if(G.managementDeal)pay=Math.floor(pay*Math.min(1.2,G.managementBonus||1.2));
    // F3-FIX-D: EVOLUTION carwash 'Premium Service' â€” co 5 myc premium auto +500 zl
    G._cwCount=(G._cwCount||0)+1;
    if(_evo('carwash') && G._cwCount%5===0){
      pay+=500;
      addNotif('đźš—đź’Ž Premium auto! +500 zĹ‚ (Evolution Detailer â€” co 5 myÄ‡)');
      if(typeof showMsg==='function') showMsg('đźš—đź’Ž Premium klient zostawiĹ‚ 500 zĹ‚ napiwku!','g');
    }
    earn(pay);
    G.energy=clampStat('energy', G.energy-5);addXP(20);progressQuest('carwash'); // v1.8.59: carwash 9â†’5 (-70% od oryginaĹ‚u 15)
    /* v2.1.120: Wave 6 N19 â€” rep konsystencja: +1 rep co 5 myÄ‡ (parallel z pizza/kurier). */
    if(G._cwCount%5===0){G.streetRep=Math.min(100,(G.streetRep||0)+1);if(typeof addNotif==='function')addNotif('đźš— +1 rep uliczna (po 5 myciach â€” ludzie znajÄ… CiÄ™)');}
    ctx.fillStyle='rgba(0,0,0,.85)';ctx.fillRect(0,0,W,H);
    ctx.fillStyle='#27ae60';ctx.font='bold 28px "Segoe UI",sans-serif';ctx.textAlign='center';
    ctx.fillText('đźš—âś¨ Auto umyte perfekcyjnie!',W/2,H/2-22);
    ctx.fillStyle='#f1c40f';ctx.font='bold 26px "Segoe UI",sans-serif';
    ctx.fillText(`+${pay} zĹ‚`,W/2,H/2+14);
    ctx.fillStyle='#7ec8e3';ctx.font='15px "Segoe UI",sans-serif';
    ctx.fillText(`Skill myjni: ${skill} | XP: +20`,W/2,H/2+44);
    ctx.textAlign='left';
    notify(`đźš— Myjnia zakoĹ„czona! +${pay} zĹ‚`);
    closeJobPanelAfter(3000);
  }
  window._jobMgCleanup=()=>{over=true;cancelAnimationFrame(raf);document.removeEventListener('keydown',keydown);document.removeEventListener('keyup',keyup);panel.classList.remove('on');panel.style.display='none';document.getElementById('mg-job-content').innerHTML='';};
}

function startConstructionMG(){
  showJobIntro({icon:'đźŹ—ď¸Ź',name:'Plac Budowy',wage:'30â€“60',difficulty:'Trudna',diffColor:'#e74c3c',
    desc:'3 etapy: ukĹ‚adanie cegieĹ‚ (timing), mieszanie betonu (klikaj szybko), montaĹĽ belek (SPACJA). KaĹĽdy etap punktowany!',
    skillKey:'construction'},()=>_startConstructionGame());
}
function _startConstructionGame(){
  closeOverlay();
  const panel=document.getElementById('mg-job');panel.classList.add('on');
  panel.innerHTML='<div id="mg-job-content"></div>';
  // 3 zadania: cegĹ‚y (timing), beton (klikanie), belki (trzymaj+pozycja)
  const TASKS=[
    {id:'brick',name:'đź§± Mur â€” UkĹ‚adaj cegĹ‚y!',hint:'Kliknij gdy wskaĹşnik w zielonej strefie',total:8},
    {id:'cement',name:'đźŹ— Beton â€” Mieszaj cement!',hint:'Klikaj szybko ĹĽeby wymieszaÄ‡ beton',total:20},
    {id:'beam',name:'đź”© Belka â€” Ustaw na miejscu!',hint:'Trzymaj SPACJÄ ĹĽeby podnosiÄ‡ (puĹ›Ä‡ = opada). ENTER lub przycisk = zatwierdĹş pozycjÄ™.',total:3},
  ];
  let taskIdx=0,taskDone=0,totalScore=0,over=false,raf;
  /* v2.1.175: speed 3.5â†’5.5 â€” user "wskaĹşnik powinien lataÄ‡ trochÄ™ szybciej" */
  let pos=0,dir=1,speed=5.5;
  let clickCount=0,clickCombo=0,lastClickTime=0;
  let beamY=270,beamTarget=100,beamLifted=false,beamPlaced=0;
  let spaceHeld=false,beamSuccessFlash=0;
  const TRACK=440,GL=170,GR=270;
  // Particle systems â€” iskry przy belce, pyĹ‚ przy cegle, krople przy betonie
  const particles=[];
  function emitSparks(x,y,n,color){
    for(let i=0;i<n;i++){
      const a=Math.random()*Math.PI*2,sp=2+Math.random()*4;
      particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-1,life:30+Math.random()*20,max:50,col:color||'#f1c40f',type:'spark'});
    }
  }
  function emitDust(x,y,n){
    for(let i=0;i<n;i++){
      particles.push({x:x+(Math.random()-0.5)*15,y:y+(Math.random()-0.5)*5,vx:(Math.random()-0.5)*1.5,vy:-1-Math.random()*1.2,life:25+Math.random()*15,max:40,col:'#c8b090',type:'dust',size:2+Math.random()*2});
    }
  }
  function emitDrops(x,y,n){
    for(let i=0;i<n;i++){
      particles.push({x,y,vx:(Math.random()-0.5)*3,vy:-2-Math.random()*2,life:20+Math.random()*10,max:30,col:'#8a7a50',type:'drop',size:1.5+Math.random()*1.5});
    }
  }

  document.getElementById('mg-job-content').innerHTML=`
    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;max-width:700px">
      <h2 style="color:#f1c40f;margin:0">đźŹ— Plac Budowy</h2>
      <div style="display:flex;gap:6px" id="con-tasks">
        <span id="cont-0" style="padding:4px 12px;border-radius:12px;font-size:12px;background:#2a1a0a;color:#f1c40f;border:1px solid #f1c40f">đź§± Mur</span>
        <span id="cont-1" style="padding:4px 12px;border-radius:12px;font-size:12px;background:#101820;color:#444;border:1px solid #222">đźŹ— Beton</span>
        <span id="cont-2" style="padding:4px 12px;border-radius:12px;font-size:12px;background:#101820;color:#444;border:1px solid #222">đź”© Belki</span>
      </div>
      <div id="con-inst" style="color:#7ec8e3;font-size:13px;font-weight:700">Kliknij gdy wskaĹşnik w zielonej strefie</div>
      <div style="display:flex;gap:20px;font-size:14px;color:#aaa">
        <span id="con-progress">0/8</span>
        <span id="con-score" style="color:#f1c40f">â­ 0 pkt</span>
        <span id="con-combo" style="color:#e67e22"></span>
        <span style="color:#7ec8e3">âŹ± <span id="con-time" style="color:#f1c40f;font-weight:700">180s</span></span>
      </div>
      <canvas id="con-cv" width="660" height="240" style="border:2px solid #2a2a0a;border-radius:8px;cursor:pointer"></canvas>
      <div id="con-result" style="font-size:15px;font-weight:700;min-height:22px;color:#fff"></div>
      <div style="display:flex;gap:10px;align-items:center">
        <button id="con-btn" class="dbtn" style="width:220px;font-size:17px;padding:12px" onclick="window._conAction&&window._conAction()">âšˇ Akcja!</button>
      </div>
      <button class="cbtn" onclick="if(window._jobMgCleanup)window._jobMgCleanup()">â† PorzuÄ‡</button>
    </div>`;

  const cv=document.getElementById('con-cv');const ctx=cv.getContext('2d');const W=660,H=240;
  ctx.imageSmoothingEnabled=false;
  const floors=[]; // budynek roĹ›nie

  const kd=e=>{
    if(e.code==='Space'){e.preventDefault();spaceHeld=true;}
    if((e.key==='z'||e.key==='Z')&&taskIdx===2){e.preventDefault();window._conUndo&&window._conUndo();}
    if(e.code==='Enter'&&taskIdx===2){e.preventDefault();window._conAction&&window._conAction();}
  };
  const ku=e=>{if(e.code==='Space')spaceHeld=false;};
  document.addEventListener('keydown',kd);document.addEventListener('keyup',ku);

  // v1.8.44: time limit 180s dla construction. Po czasie partial payout proporcjonalny do progresu.
  let _conStartTime=Date.now();
  let _conTimerInt=setInterval(()=>{
    if(over){clearInterval(_conTimerInt);return;}
    const _el=Math.floor((Date.now()-_conStartTime)/1000);
    const _rem=Math.max(0,180-_el);
    const _te=document.getElementById('con-time');if(_te)_te.textContent=_rem+'s';
    if(_rem<=0){clearInterval(_conTimerInt);if(!over){
      const _frac=taskIdx/3 + (taskDone/(TASKS[taskIdx]?.total||1))/3;
      let _partPay=Math.floor(95*_frac*getPracaBonus('construction'));
      if(_partPay>0)earn(_partPay);
      G.energy=clampStat('energy', G.energy-5);addXP(Math.floor(25*_frac)); // v1.8.59: construction timeout 10â†’5 (-70% od oryginaĹ‚u 15)
      progressQuest('construction');
      over=true;cancelAnimationFrame(raf);
      document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku);
      ctx.fillStyle='rgba(0,0,0,.85)';ctx.fillRect(0,0,W,H);
      ctx.fillStyle='#e74c3c';ctx.font='bold 22px "Segoe UI",sans-serif';ctx.textAlign='center';
      ctx.fillText('âŹ± Czas minÄ…Ĺ‚!',W/2,H/2-15);
      ctx.fillStyle='#f1c40f';ctx.font='bold 18px "Segoe UI",sans-serif';
      ctx.fillText(_partPay>0?`+${_partPay} zĹ‚ (proporcjonalnie)`:'Brak wypĹ‚aty',W/2,H/2+15);
      ctx.textAlign='left';closeJobPanelAfter(3000);
    }}
  },1000);

  // Undo dla belki â€” usuwa ostatnio poĹ‚oĹĽonÄ… belkÄ™
  window._conUndo=()=>{
    if(taskIdx!==2||beamPlaced<=0||over)return;
    floors.pop();
    beamPlaced--;taskDone--;
    beamY=270; // reset belki na dĂłĹ‚
    updateProgress();
    const res=document.getElementById('con-result');
    if(res){res.style.color='#f1c40f';res.textContent='â†© Belka cofniÄ™ta â€” sprĂłbuj ponownie!';}
    const undo=document.getElementById('con-undo');
    if(undo)undo.style.display=beamPlaced>0?'':'none';
  };

  function setTask(i){
    /* v2.1.175: stage 1 wskaĹşnik szybszy â€” speed 3.5â†’5.5 base + i*0.5 (5.5/6.0/6.5) */
    taskIdx=i;taskDone=0;clickCount=0;clickCombo=0;beamPlaced=0;beamY=270;pos=0;dir=1;speed=5.5+i*0.5;
    const undoBtn=document.getElementById('con-undo');if(undoBtn)undoBtn.style.display='none';
    for(let j=0;j<3;j++){
      const el=document.getElementById('cont-'+j);if(!el)return;
      if(j<i){el.style.background='#0a3a1a';el.style.color='#27ae60';el.style.borderColor='#27ae60';}
      else if(j===i){el.style.background='#2a1a0a';el.style.color='#f1c40f';el.style.borderColor='#f1c40f';}
      else{el.style.background='#101820';el.style.color='#444';el.style.borderColor='#222';}
    }
    const inst=document.getElementById('con-inst');if(inst)inst.textContent=TASKS[i].hint;
    const btn=document.getElementById('con-btn');
    if(btn)btn.textContent=i===0?'đź§± PoĹ‚ĂłĹĽ cegĹ‚Ä™!':i===1?'đź”¨ Mieszaj!':'đź”© ZatwierdĹş pozycjÄ™ [Enter]';
    updateProgress();
  }

  function updateProgress(){
    const prog=document.getElementById('con-progress');
    if(prog)prog.textContent=`${taskDone}/${TASKS[taskIdx]?.total||0}`;
  }

  function addFloor(quality){
    const h=16+quality/5;const hue=18+quality;
    floors.push({y:H-50-floors.length*(h+2),h,color:`hsl(${hue},50%,${20+quality/5}%)`,w:180+quality*2.5,q:quality});
  }

  window._conAction=()=>{
    if(over)return;
    const task=TASKS[taskIdx];
    if(taskDone>=task.total)return; // nie pozwol klikac po ukonczeniu etapu
    if(taskIdx===0){// CegĹ‚y â€” timing
      const center=pos+5;const dist=Math.abs(center-(TRACK/2));
      let pts=0,lbl='',col='';
      if(dist<30){pts=25;lbl='đź’Ż PERFEKCJA! +25pkt';col='#f1c40f';}
      else if(dist<70){pts=15;lbl='âś… Dobra robota! +15pkt';col='#27ae60';}
      else if(dist<120){pts=6;lbl='âš ď¸Ź Ujdzie +6pkt';col='#f39c12';}
      else{pts=0;lbl='âťŚ Chybiony!';col='#e74c3c';}
      totalScore+=pts;taskDone++;addFloor(pts);speed=Math.min(10,speed+0.5);
      // PyĹ‚ przy uĹ‚oĹĽeniu cegĹ‚y, iskry przy perfekcji
      const bxCenter=W/2;emitDust(bxCenter,H-50-floors.length*18,8);
      if(pts>=25){emitSparks(bxCenter,H-60-floors.length*18,12,'#f1c40f');sfxSparkle();}
      else sfxBrick();
      const res=document.getElementById('con-result');if(res){res.style.color=col;res.textContent=lbl;}
      updateProgress();
      if(taskDone>=task.total){setTimeout(()=>setTask(1),400);}
    } else if(taskIdx===1){// Beton â€” szybkie klikanie
      const now=Date.now();
      if(now-lastClickTime<300)clickCombo=Math.min(clickCombo+1,5);else clickCombo=0;
      lastClickTime=now;
      const pts=1+clickCombo;totalScore+=pts;clickCount++;taskDone++;
      // Krople betonu z miksera
      emitDrops(W/2+55+30,80+18,clickCombo>=3?6:2);
      const combo=document.getElementById('con-combo');if(combo)combo.textContent=clickCombo>=3?`đź”Ą Combo x${clickCombo}!`:'';
      const res=document.getElementById('con-result');if(res){res.style.color=clickCombo>=3?'#e67e22':'#27ae60';res.textContent=clickCombo>=3?`đź”Ą Combo! +${pts}pkt`:`+${pts}pkt`;}
      updateProgress();
      if(taskDone>=task.total){setTimeout(()=>setTask(2),400);}
    } else if(taskIdx===2){// Belka â€” pozycja
      if(beamY>beamTarget+40){// za nisko (belka nie podniesiona)
        const res=document.getElementById('con-result');if(res){res.style.color='#e74c3c';res.textContent='âťŚ Belka za nisko! Trzymaj SPACJÄ dĹ‚uĹĽej';}
      } else if(beamY<beamTarget-35){// za wysoko (za dĹ‚ugo trzymano spacjÄ™)
        const res=document.getElementById('con-result');if(res){res.style.color='#e67e22';res.textContent='âš ď¸Ź Belka za wysoko!';}
      } else {
        const diff=Math.abs(beamY-beamTarget);
        const pts=diff<15?20:diff<30?12:6;totalScore+=pts;beamPlaced++;taskDone++;beamSuccessFlash=30;
        addFloor(pts);
        // Iskry przy spawaniu belki â€” duĹĽo dla idealnego, mniej dla dobrego
        const bxC=W/2;emitSparks(bxC-80,beamY+11,pts>=20?20:12,'#ffe066');
        emitSparks(bxC+80,beamY+11,pts>=20?20:12,'#ffe066');
        if(pts>=20)emitSparks(bxC,beamY+11,15,'#fff');
        sfxSparks();sfxMetal();
        if(pts>=20)setTimeout(()=>sfxSparkle(),200);
        beamY=270;
        const undoBtn=document.getElementById('con-undo');if(undoBtn)undoBtn.style.display='';
        const res=document.getElementById('con-result');
        if(res){res.style.color=pts>=20?'#f1c40f':pts>=12?'#27ae60':'#f39c12';res.textContent=pts>=20?'âšˇ Idealnie! +20pkt':pts>=12?'âś… Dobra! +12pkt':'đź‘· Ujdzie +6pkt';}
        updateProgress();
        if(taskDone>=task.total){over=true;cancelAnimationFrame(raf);_finConstruction();}
      }
    }
  };

  const draw=()=>{
    if(!document.getElementById('con-cv')){cancelAnimationFrame(raf);return;}
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#0a0e0a';ctx.fillRect(0,0,W,H);
    // Sky gradient
    const sky=ctx.createLinearGradient(0,0,0,H);sky.addColorStop(0,'#0a1018');sky.addColorStop(1,'#1a2a10');ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
    // Ground
    ctx.fillStyle='#1a1008';ctx.fillRect(0,H-40,W,40);
    ctx.fillStyle='#2a1810';ctx.fillRect(0,H-42,W,4);
    // Building
    const bx=W/2-100;
    floors.forEach(f=>{
      ctx.fillStyle=f.color;ctx.fillRect(bx+(200-f.w)/2,f.y,f.w,f.h);
      ctx.strokeStyle='rgba(200,150,30,.2)';ctx.lineWidth=1;ctx.strokeRect(bx+(200-f.w)/2,f.y,f.w,f.h);
      // Brick lines
      for(let i=8;i<f.w;i+=22){ctx.strokeStyle='rgba(0,0,0,.15)';ctx.beginPath();ctx.moveTo(bx+(200-f.w)/2+i,f.y);ctx.lineTo(bx+(200-f.w)/2+i,f.y+f.h);ctx.stroke();}
    });
    // Foundation
    ctx.fillStyle='#3a2a10';ctx.fillRect(bx,H-42,200,4);

    if(taskIdx===0){// Timing bar
      ctx.fillStyle='#0a1020';ctx.fillRect(110,20,TRACK,44);
      ctx.fillStyle='rgba(39,174,96,.22)';ctx.fillRect(110+GL,20,GR-GL,44);
      ctx.strokeStyle='#27ae60';ctx.lineWidth=2;ctx.strokeRect(110+GL,20,GR-GL,44);
      ctx.shadowBlur=0;ctx.font='bold 14px "Segoe UI",Arial,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.strokeStyle='rgba(0,0,0,.5)';ctx.lineWidth=2;ctx.lineJoin='round';ctx.strokeText('PERFEKCJA',110+TRACK/2,42);
      ctx.fillStyle='#27ae60';ctx.fillText('PERFEKCJA',110+TRACK/2,42);ctx.textAlign='left';ctx.textBaseline='alphabetic';
      pos+=dir*speed;if(pos>=TRACK-10||pos<=0)dir=-dir;
      ctx.fillStyle='#e74c3c';ctx.shadowBlur=10;ctx.shadowColor='#e74c3c';ctx.fillRect(110+pos,24,10,36);ctx.shadowBlur=0;
    } else if(taskIdx===1){// Cement mixer animation
      const cx2=W/2,cy=80,r=55;
      ctx.fillStyle='#444';ctx.beginPath();ctx.arc(cx2,cy,r,0,Math.PI*2);ctx.fill();
      const angle=clickCount*0.5;
      ctx.fillStyle='#666';ctx.beginPath();ctx.moveTo(cx2,cy);ctx.arc(cx2,cy,r-8,angle,angle+Math.PI*0.8);ctx.closePath();ctx.fill();
      ctx.fillStyle='#8a7a50';ctx.beginPath();ctx.moveTo(cx2,cy);ctx.arc(cx2,cy,r-8,angle+Math.PI,angle+Math.PI*1.8);ctx.closePath();ctx.fill();
      ctx.strokeStyle='#888';ctx.lineWidth=3;ctx.beginPath();ctx.arc(cx2,cy,r,0,Math.PI*2);ctx.stroke();
      ctx.fillStyle='#555';ctx.fillRect(cx2+r-5,cy-5,35,10);ctx.fillRect(cx2+r+30,cy-18,5,36);
      // Pour line
      if(clickCombo>=2){ctx.strokeStyle='rgba(150,130,80,0.7)';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(cx2+r+32,cy+18);ctx.bezierCurveTo(cx2+r+32,cy+50,bx+100,H-80,bx+100,H-42);ctx.stroke();}
      ctx.font='bold 15px "Segoe UI",Arial';ctx.fillStyle='#ccc';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(`${taskDone}/${TASKS[1].total} = wymieszano`,W/2,cy+r+22);ctx.textAlign='left';ctx.textBaseline='alphabetic';
    } else if(taskIdx===2){// Beam
      if(!over){
        if(spaceHeld)beamY=Math.max(40,beamY-3);   // SPACE wciĹ›niÄ™ta â€” belka jedzie w gĂłrÄ™
        else beamY=Math.min(270,beamY+1.6);          // SPACE puszczona â€” grawitacja, belka opada
      }
      // Target zone
      ctx.strokeStyle='rgba(39,174,96,.5)';ctx.lineWidth=2;ctx.setLineDash([8,4]);ctx.strokeRect(bx-10,beamTarget,220,25);ctx.setLineDash([]);
      ctx.fillStyle='rgba(39,174,96,.1)';ctx.fillRect(bx-10,beamTarget,220,25);
      ctx.shadowBlur=0;ctx.font='bold 13px "Segoe UI",Arial,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.strokeStyle='rgba(0,0,0,.5)';ctx.lineWidth=2;ctx.lineJoin='round';ctx.strokeText('DOCELOWE MIEJSCE',bx+100,beamTarget+12);
      ctx.fillStyle='#27ae60';ctx.fillText('DOCELOWE MIEJSCE',bx+100,beamTarget+12);ctx.textAlign='left';ctx.textBaseline='alphabetic';
      // Crane cable
      ctx.strokeStyle='#555';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(bx+100,0);ctx.lineTo(bx+100,beamY);ctx.stroke();
      // Beam
      const bc=beamSuccessFlash>0?'#f1c40f':'#aaa';ctx.fillStyle=bc;ctx.fillRect(bx-10,beamY,220,22);
      ctx.fillStyle=beamSuccessFlash>0?'#f1c40f':'#888';
      for(let i=15;i<220;i+=30){ctx.fillRect(bx-10+i,beamY,8,22);}
      ctx.strokeStyle='#666';ctx.lineWidth=1;ctx.strokeRect(bx-10,beamY,220,22);
      if(beamSuccessFlash>0)beamSuccessFlash--;
      // Crane arm
      ctx.fillStyle='#333';ctx.fillRect(bx+60,-5,80,20);
      ctx.fillStyle='#444';ctx.fillRect(W-80,0,30,H/3);ctx.fillRect(W-80,H/3*0.8,-(W-bx-80),12);
      // Flash poĹ›wiaty po sukcesie
      if(beamSuccessFlash>0){
        const fa=beamSuccessFlash/30;
        ctx.fillStyle=`rgba(255,220,80,${fa*0.18})`;ctx.fillRect(0,0,W,H);
      }
    }
    // Update + render czÄ…steczek (iskier/pyĹ‚u/kropli)
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.type==='spark'){p.vy+=0.18;p.vx*=0.985;}
      else if(p.type==='dust'){p.vy+=0.05;p.vx*=0.97;}
      else if(p.type==='drop'){p.vy+=0.35;}
      p.life--;
      const a=Math.max(0,p.life/p.max);
      if(p.type==='spark'){
        ctx.shadowBlur=6;ctx.shadowColor=p.col;
        ctx.fillStyle=p.col;ctx.globalAlpha=a;
        ctx.beginPath();ctx.arc(p.x,p.y,1.8,0,Math.PI*2);ctx.fill();
        ctx.shadowBlur=0;
      } else if(p.type==='dust'){
        ctx.fillStyle=p.col;ctx.globalAlpha=a*0.6;
        ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();
      } else if(p.type==='drop'){
        ctx.fillStyle=p.col;ctx.globalAlpha=a;
        ctx.fillRect(p.x-1,p.y-p.size,2,p.size*2);
      }
      ctx.globalAlpha=1;
      if(p.life<=0||p.y>H+5)particles.splice(i,1);
    }
    const sco=document.getElementById('con-score');if(sco)sco.textContent=`â­ ${totalScore} pkt`;
    if(!over)raf=requestAnimationFrame(draw);
  };
  raf=requestAnimationFrame(draw);
  setTask(0);

  function _finConstruction(){
    cancelAnimationFrame(raf);
    document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku);
    // #84 NERF -30% â€” construction byĹ‚ ~22zĹ‚/min, teraz ~15zĹ‚/min (zgodne â€” najwolniejsza praca)
    let pay=Math.floor(20+totalScore*0.35); // max ~20+56=76 zĹ‚
    pay=Math.floor(pay*getPracaBonus('construction')); // F3-FIX-B
    if(G.managementDeal)pay=Math.floor(pay*Math.min(1.2,G.managementBonus));
    earn(pay);
    G.energy=clampStat('energy', G.energy-7);G.hunger=clampStat('hunger', G.hunger-15); // v1.8.59: construction 14â†’7 (-70% od oryginaĹ‚u 22)
    addXP(22);G.streetRep=clamp(G.streetRep+1,0,100);progressQuest('construction'); // BALANS #65: +5â†’+1
    const res=document.getElementById('con-result');
    if(res)res.innerHTML=`<span style="color:#f1c40f;font-size:18px">đźŹ— Budowa ukoĹ„czona! ${totalScore}pkt Â· +${pay} zĹ‚ đźŽ‰</span>`;
    const btn=document.getElementById('con-btn');if(btn)btn.disabled=true;
    notify(`đźŹ— Budowa: ${floors.length} piÄ™ter, +${pay} zĹ‚!`);
    closeJobPanelAfter(3200);
  }
  window._jobMgCleanup=()=>{over=true;cancelAnimationFrame(raf);document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku);panel.classList.remove('on');panel.style.display='none';document.getElementById('mg-job-content').innerHTML='';};
}

function startZmywakMG(){
  showJobIntro({icon:'đź§˝',name:'Restauracja â€” Zmywak',wage:'10â€“30',difficulty:'Ĺatwa',diffColor:'#27ae60',
    desc:'Nabierz pĹ‚ynu z dozownika i przeciÄ…gaj gÄ…bkÄ… po brudnych plamach. Umyj wszystko zanim minie czas!',
    skillKey:'zmywak'},()=>_startZmywakGame());
}
function _startZmywakGame(){
  closeOverlay();
  const el=document.getElementById('mg-job');
  el.style.display='';el.classList.add('on');
  // Session token â€” chroni przed sytuacjÄ… gdy stary timer cleanup'uje nowÄ… minigrÄ™
  // (gracz: skoĹ„czyĹ‚ pracÄ™ â†’ szybko "WyjdĹş" â†’ nowa praca â†’ stary closeJobPanelAfter zamykaĹ‚ nowe okno)
  _jobPanelSession=(_jobPanelSession||0)+1;
  const _sessId=_jobPanelSession;

  let timeLeft=70, earned=0, gameActive=true;
  let soapLevel=100;
  let spongeX=350,spongeY=200;
  let mouseDown=false,hasSoap=false;
  let totalWashed=0,faucetOn=false;
  /* v2.1.175: combo system + bonus points */
  let combo=0, comboLastTime=0, comboMax=0, bonusPoints=0, perfectFlashTime=0;
  let perfectFlashLabel='';
  const fx=560,fy=110; // faucet position (used in draw + mousedown)
  // Particle FX â€” baĹ„ki, krople wody, sparkles
  const fx_particles=[];
  function emitBubbles(x,y,n){for(let i=0;i<n;i++){fx_particles.push({x:x+(Math.random()-0.5)*16,y,vx:(Math.random()-0.5)*0.8,vy:-1.2-Math.random()*1.5,life:60+Math.random()*30,max:90,size:2+Math.random()*3,type:'bubble'});}}
  function emitWaterDrops(x,y,n){for(let i=0;i<n;i++){fx_particles.push({x,y,vx:(Math.random()-0.5)*2.5,vy:1+Math.random()*2,life:25+Math.random()*15,max:40,size:1.5+Math.random()*1.5,type:'water'});}}
  function emitCleanSparkle(x,y){for(let i=0;i<10;i++){const a=Math.random()*Math.PI*2,sp=1+Math.random()*2.5;fx_particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:25+Math.random()*15,max:40,size:1+Math.random()*1.5,type:'sparkle'});}}

  const ITEM_TYPES=[
    {type:'talerz',label:'Talerz',draw:(cx,x,y,r)=>{
      // Talerz â€” biaĹ‚a pĹ‚yta z pierĹ›cieniami
      cx.fillStyle='#f0ece4';cx.beginPath();cx.ellipse(x,y,r,r*.35,0,0,Math.PI*2);cx.fill();
      cx.strokeStyle='#d8d0c0';cx.lineWidth=3;cx.beginPath();cx.ellipse(x,y,r,r*.35,0,0,Math.PI*2);cx.stroke();
      cx.strokeStyle='#e0d8c8';cx.lineWidth=2;cx.beginPath();cx.ellipse(x,y,r*.75,r*.27,0,0,Math.PI*2);cx.stroke();
      cx.strokeStyle='#ddd4c0';cx.lineWidth=1;cx.beginPath();cx.ellipse(x,y,r*.35,r*.13,0,0,Math.PI*2);cx.stroke();
    },spots:6},
    {type:'garnek',label:'Garnek',draw:(cx,x,y,r)=>{
      // Garnek â€” walec z pokrywkÄ… i uchwytami
      const bw=r*1.6,bh=r*0.9;
      cx.fillStyle='#7a7a8a';cx.beginPath();cx.roundRect?cx.roundRect(x-bw/2,y-bh/2,bw,bh,4):cx.rect(x-bw/2,y-bh/2,bw,bh);cx.fill();
      cx.fillStyle='#8a8a9a';cx.fillRect(x-bw/2,y-bh/2,bw,bh*.35);// Jasna gĂłrna czÄ™Ĺ›Ä‡
      cx.fillStyle='#606070';cx.fillRect(x-bw/2,y+bh*.4,bw,bh*.12);// Dolna krawÄ™dĹş
      // Pokrywka
      cx.fillStyle='#9a9aaa';cx.beginPath();cx.ellipse(x,y-bh/2,bw/2+2,8,0,0,Math.PI*2);cx.fill();
      cx.fillStyle='#aaa';cx.beginPath();cx.arc(x,y-bh/2-8,5,0,Math.PI*2);cx.fill();// GaĹ‚ka
      // Uchwyty
      cx.fillStyle='#555';cx.fillRect(x-bw/2-10,y-6,10,12);cx.fillRect(x+bw/2,y-6,10,12);
      cx.strokeStyle='#666';cx.lineWidth=1;cx.strokeRect(x-bw/2-10,y-6,10,12);cx.strokeRect(x+bw/2,y-6,10,12);
    },spots:8},
    {type:'patelnia',label:'Patelnia',draw:(cx,x,y,r)=>{
      // Patelnia â€” ciemna elipsa z rÄ…czkÄ… po PRAWEJ (skierowana na zewnÄ…trz)
      cx.fillStyle='#2a2a2a';cx.beginPath();cx.ellipse(x,y,r,r*.38,0,0,Math.PI*2);cx.fill();
      cx.fillStyle='#1a1a1a';cx.beginPath();cx.ellipse(x,y,r*.85,r*.32,0,0,Math.PI*2);cx.fill();
      cx.strokeStyle='#444';cx.lineWidth=2;cx.beginPath();cx.ellipse(x,y,r*.85,r*.32,0,0,Math.PI*2);cx.stroke();
      // RÄ…czka po prawej (z dala od garnka)
      cx.fillStyle='#3a3a3a';cx.fillRect(x+r,y-5,32,10);
      cx.fillStyle='#4a2a0a';cx.fillRect(x+r+4,y-6,28,12);// Drewniany uchwyt
      cx.strokeStyle='#2a1a0a';cx.lineWidth=1;cx.strokeRect(x+r+4,y-6,28,12);
    },spots:7},
    {type:'szklanka',label:'Szklanka',draw:(cx,x,y,r)=>{
      // Szklanka â€” trapez z przezroczystego szkĹ‚a
      const hw=r*.45,th=r*.75;
      cx.fillStyle='rgba(160,200,240,.35)';
      cx.beginPath();cx.moveTo(x-hw*.7,y-th);cx.lineTo(x-hw,y+th*.6);cx.lineTo(x+hw,y+th*.6);cx.lineTo(x+hw*.7,y-th);cx.closePath();cx.fill();
      cx.strokeStyle='rgba(180,220,255,.9)';cx.lineWidth=2.5;
      cx.beginPath();cx.moveTo(x-hw*.7,y-th);cx.lineTo(x-hw,y+th*.6);cx.lineTo(x+hw,y+th*.6);cx.lineTo(x+hw*.7,y-th);cx.closePath();cx.stroke();
      // PoĹ‚ysk
      cx.strokeStyle='rgba(220,240,255,.5)';cx.lineWidth=1.5;
      cx.beginPath();cx.moveTo(x-hw*.5,y-th*.8);cx.lineTo(x-hw*.7,y+th*.3);cx.stroke();
      // ZawartoĹ›Ä‡ (woda)
      cx.fillStyle='rgba(80,140,220,.25)';
      cx.beginPath();cx.moveTo(x-hw*.85,y+th*.1);cx.lineTo(x-hw,y+th*.6);cx.lineTo(x+hw,y+th*.6);cx.lineTo(x+hw*.85,y+th*.1);cx.closePath();cx.fill();
    },spots:4},
    {type:'kubek',label:'Kubek',draw:(cx,x,y,r)=>{
      // Kubek â€” walcowaty z rÄ…czkÄ… (prawdziwÄ…)
      const kw=r*.75,kh=r*.9;
      cx.fillStyle='#c03828';cx.fillRect(x-kw/2,y-kh/2,kw,kh);
      cx.fillStyle='#d04030';cx.fillRect(x-kw/2,y-kh/2,kw,kh*.3);// jasna gĂłra
      cx.fillStyle='#a02818';cx.fillRect(x-kw/2,y+kh*.35,kw,kh*.15);// ciemny dĂłĹ‚
      // RÄ…czka (Ĺ‚uk po prawej, WEWNÄ„TRZ prawej krawÄ™dzi)
      cx.strokeStyle='#a02818';cx.lineWidth=5;cx.lineCap='round';
      cx.beginPath();cx.arc(x+kw/2+8,y,kh*.3,Math.PI*1.5,Math.PI*.5);cx.stroke();
      // ParÄ™ (para z kubka)
      cx.strokeStyle='rgba(200,200,200,.4)';cx.lineWidth=1.5;cx.lineCap='round';
      cx.beginPath();cx.moveTo(x-8,y-kh/2-4);cx.quadraticCurveTo(x-14,y-kh/2-12,x-8,y-kh/2-20);cx.stroke();
      cx.beginPath();cx.moveTo(x+4,y-kh/2-4);cx.quadraticCurveTo(x+10,y-kh/2-12,x+4,y-kh/2-20);cx.stroke();
    },spots:4},
    {type:'widelec',label:'Widelec',draw:(cx,x,y,r)=>{
      // Widelec â€” metalowy, pionowy
      cx.strokeStyle='#c8c8c8';cx.lineWidth=4;cx.lineCap='round';
      // Trzon
      cx.beginPath();cx.moveTo(x,y+r*.6);cx.lineTo(x,y-r*.1);cx.stroke();
      // ZagiÄ™cie â€” bark
      cx.strokeStyle='#b8b8b8';cx.lineWidth=3;
      cx.beginPath();cx.moveTo(x-r*.22,y-r*.1);cx.lineTo(x+r*.22,y-r*.1);cx.stroke();
      // 4 zÄ™by
      cx.lineWidth=2.5;
      for(let i=-1.5;i<=1.5;i++){
        cx.strokeStyle='#d0d0d0';
        cx.beginPath();cx.moveTo(x+i*r*.12,y-r*.1);cx.lineTo(x+i*r*.12,y-r*.7);cx.stroke();
        cx.beginPath();cx.arc(x+i*r*.12,y-r*.7,2,Math.PI,0);cx.stroke();
      }
      // PoĹ‚ysk
      cx.strokeStyle='rgba(255,255,255,.5)';cx.lineWidth=1;
      cx.beginPath();cx.moveTo(x-2,y+r*.5);cx.lineTo(x-2,y-r*.1);cx.stroke();
    },spots:3},
  ];

  // Generate 5 random items â€” rozmieszczone rĂłwnomiernie, dozownik teraz po LEWEJ
  const positions=[{x:95,y:195},{x:210,y:195},{x:330,y:195},{x:450,y:195},{x:570,y:195}];
  const items=positions.map((pos,i)=>{
    const tp=ITEM_TYPES[i%ITEM_TYPES.length];
    const spots=[];
    const r=42;
    for(let j=0;j<tp.spots;j++){
      const angle=Math.random()*Math.PI*2;
      const dist=Math.random()*18+4;
      spots.push({x:pos.x+Math.cos(angle)*dist,y:pos.y+Math.sin(angle)*dist*0.45,dirty:true,r:9});
    }
    return {...pos,r,type:tp,spots,cleaned:0,done:false};
  });
  const totalSpots=items.reduce((a,it)=>a+it.spots.length,0);
  const soapDispX=22,soapDispY=180; // Dozownik przeniesiony na LEWÄ„ stronÄ™ (poza sink)

  el.innerHTML='';
  el.innerHTML=`
    <div style="margin-bottom:6px">
      <h2 style="color:#1abc9c;font-size:21px;display:inline">đź§˝ Zmywak â€” Myj naczynia!</h2>
      <span style="font-size:12px;color:#aab;margin-left:12px"><b style="color:#27ae60">1.</b> Klik đź§´ PĹYN â†’ <b style="color:#27ae60">2.</b> Klik đź’§ WODA (bonus +50%) â†’ <b style="color:#27ae60">3.</b> PrzeciÄ…gaj gÄ…bkÄ… po brudnych plamach</span>
    </div>
    <div style="display:flex;gap:24px;margin-bottom:8px;font-size:15px;color:#aaa;">
      <span>âŹ± <b id="zmwk-time">70</b>s</span>
      <span>đź§´ PĹ‚yn: <b id="zmwk-soap">100</b>%</span>
      <span>âś… Umyte: <b id="zmwk-clean">0</b></span>
      <span id="zmwk-msg" style="color:#f1c40f"></span>
    </div>
    <canvas id="zmwk-cvs" width="700" height="280" style="border-radius:8px;cursor:none;display:block;"></canvas>
    <button onclick="window._jobMgCleanup&&window._jobMgCleanup()" style="margin-top:10px;background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">âś• WyjdĹş</button>
  `;
  const cvs=document.getElementById('zmwk-cvs');
  const cx=cvs.getContext('2d');

  function cleanup(){
    gameActive=false;
    if(window._zmwkTimer){clearInterval(window._zmwkTimer);window._zmwkTimer=null;}
    if(earned>0){earn(earned);showMsg(`đź«§ Zmywak: zarobiono ${earned} zĹ‚!`);addXP(earned/5);updateHUD();progressQuest('zmywak');earned=0;}
  }

  window._zmwkTimer=setInterval(()=>{
    if(!gameActive)return;
    timeLeft--;
    const te=document.getElementById('zmwk-time');if(te)te.textContent=timeLeft;
    if(timeLeft<=0){
      gameActive=false;
      const cleaned=items.reduce((a,it)=>a+it.spots.filter(s=>!s.dirty).length,0);
      earned=Math.floor((cleaned/totalSpots)*35); // #84 NERF -30%
      /* v2.1.175: COMBO bonus â€” dodaj bonusPoints jako extra zĹ‚ */
      earned+=bonusPoints;
      // v1.8.43: BUG FIX â€” przy time-out skill bonus NIE byĹ‚ aplikowany (tylko przy peĹ‚nej zmianie line 17746).
      earned=Math.floor(earned*getPracaBonus('zmywak'));
      const nightBonus=G.timeOfDay===3;if(nightBonus)earned=Math.floor(earned*1.3);
      if(G.managementDeal)earned=Math.floor(earned*G.managementBonus);
      /* v2.1.177: round do najbliĹĽszego 5 zĹ‚ â€” user feedback: "zĹ‚amane kwoty" przez combo + multiplier kombinacje. */
      earned=Math.round(earned/5)*5;
      G.energy=clampStat('energy', G.energy-3); // v1.8.59: zmywak timeout 6â†’3 (-70% od oryginaĹ‚u 10)
      if(comboMax>=5 && typeof showMsg==='function') showMsg(`đź”Ą Max combo ${comboMax}Ă— â€” bonus +${bonusPoints} zĹ‚!`,'g',4000);
      cleanup();
    }
  },1000);

  cvs.addEventListener('mousemove',e=>{
    const rect=cvs.getBoundingClientRect();
    spongeX=(e.clientX-rect.left)*(700/rect.width);
    spongeY=(e.clientY-rect.top)*(280/rect.height);
    if(mouseDown&&hasSoap&&soapLevel>0&&gameActive){
      items.forEach(it=>{
        if(it.done)return;
        it.spots.forEach(s=>{
          if(!s.dirty)return;
          const dx=spongeX-s.x,dy=(spongeY-s.y)/0.5;
          // #83 Kran ON â†’ 50% mniejsze zuĹĽycie mydĹ‚a + wiÄ™kszy zasiÄ™g gÄ…bki (woda + mydĹ‚o)
          const reach=faucetOn?s.r+18:s.r+14;
          if(Math.hypot(dx,dy)<reach){
            s.dirty=false;it.cleaned++;totalWashed++;
            emitCleanSparkle(s.x,s.y);
            emitBubbles(spongeX,spongeY-8,faucetOn?5:3);
            sfxBubble();
            soapLevel=Math.max(0,soapLevel-(faucetOn?1.25:2.5));
            const se=document.getElementById('zmwk-soap');if(se)se.textContent=Math.round(soapLevel);
            /* v2.1.175: COMBO â€” szybkie czyszczenie pod rzÄ…d = bonus */
            const _now=Date.now();
            if(_now-comboLastTime<1000) combo++; else combo=1;
            comboLastTime=_now;
            comboMax=Math.max(comboMax,combo);
            if(combo>=3) bonusPoints+=combo; /* combo >=3 daje bonus points */
            const ce=document.getElementById('zmwk-clean');if(ce)ce.textContent=totalWashed + (combo>=3?` đź”Ą x${combo}`:'');
            /* Perfect plate detection â€” gdy wszystkie spoty 1 itemu doczyszczone w combo */
            if(it.spots.every(sp=>!sp.dirty) && !it.perfectShown){
              it.perfectShown=true;
              perfectFlashTime=40;
              perfectFlashLabel=`âś¨ PERFEKT! ${it.type.label}`;
              bonusPoints+=5; /* extra +5 punktĂłw za perfect plate */
            }
            if(soapLevel<=0)hasSoap=false;
          }
        });
        if(it.spots.every(s=>!s.dirty))it.done=true;
      });
    }
  });

  cvs.addEventListener('mousedown',e=>{
    mouseDown=true;
    const rect=cvs.getBoundingClientRect();
    const mx=(e.clientX-rect.left)*(700/rect.width),my=(e.clientY-rect.top)*(280/rect.height);
    if(Math.hypot(mx-soapDispX,my-soapDispY)<32){
      hasSoap=true;soapLevel=Math.min(100,soapLevel+30);
      const se=document.getElementById('zmwk-soap');if(se)se.textContent=Math.round(soapLevel);
      const msg=document.getElementById('zmwk-msg');
      if(msg){msg.textContent='Nabrano pĹ‚ynu!';setTimeout(()=>{if(msg)msg.textContent='';},1200);}
    }
    // #83 Kran â€” odkrÄ™ca/zakrÄ™ca wodÄ™. Woda+mydĹ‚o = lepsze mycie (+50% szybkoĹ›Ä‡, mniejsze zuĹĽycie mydĹ‚a)
    if(Math.hypot(mx-fx,my-(fy-22))<28){
      faucetOn=!faucetOn;
      const msg=document.getElementById('zmwk-msg');
      if(msg){msg.textContent=faucetOn?'đź’§ Kran ON â€” szybkie mycie!':'đź’§ Kran zakrÄ™cony';setTimeout(()=>{if(msg)msg.textContent='';},1400);}
    }
  });
  cvs.addEventListener('mouseup',()=>{mouseDown=false;});
  cvs.addEventListener('mouseleave',()=>{mouseDown=false;});

  function draw(){
    if(!gameActive&&el.style.display==='none')return;
    /* v2.1.175: combo decay â€” reset combo jeĹ›li >1s bez czyszczenia */
    if(combo>0 && Date.now()-comboLastTime>1200){combo=0;}
    // #83 TĹ‚o kuchni â€” kafelki Ĺ›cian
    const bg=cx.createLinearGradient(0,0,0,280);
    bg.addColorStop(0,'#1a2230');bg.addColorStop(1,'#0e1622');
    cx.fillStyle=bg;cx.fillRect(0,0,700,280);
    // Subtelna siatka kafelkĂłw Ĺ›cian
    cx.strokeStyle='rgba(255,255,255,.03)';cx.lineWidth=1;
    for(let y=0;y<110;y+=22){cx.beginPath();cx.moveTo(0,y);cx.lineTo(700,y);cx.stroke();}
    for(let x=0;x<700;x+=44){cx.beginPath();cx.moveTo(x,0);cx.lineTo(x,110);cx.stroke();}
    // #83 Blat granitowy nad zlewem
    const blat=cx.createLinearGradient(0,100,0,115);
    blat.addColorStop(0,'#3a3a45');blat.addColorStop(1,'#5a5a65');
    cx.fillStyle=blat;cx.fillRect(20,100,610,12);
    cx.strokeStyle='#222';cx.lineWidth=1;cx.strokeRect(20,100,610,12);
    // #83 Sink â€” stalowy, z gĹ‚Ä™bszym wyglÄ…dem
    const sinkG=cx.createLinearGradient(30,110,30,250);
    sinkG.addColorStop(0,'#0c1a26');sinkG.addColorStop(.5,'#0a1828');sinkG.addColorStop(1,'#08141e');
    cx.fillStyle=sinkG;cx.fillRect(30,110,600,140);
    // Stalowa krawÄ™dĹş sink
    cx.strokeStyle='#3a4a5a';cx.lineWidth=3;cx.strokeRect(30,110,600,140);
    cx.strokeStyle='#5a6a7a';cx.lineWidth=1;cx.strokeRect(31,111,598,138);
    // Woda w zlewie (lekko niebieska)
    cx.fillStyle='rgba(40,90,140,0.20)';cx.fillRect(32,112,596,136);
    // Water shimmer
    for(let i=0;i<4;i++){
      cx.strokeStyle=`rgba(80,160,230,${0.08+Math.sin(Date.now()/1000+i)*0.04})`;
      cx.lineWidth=1;cx.beginPath();cx.moveTo(32,130+i*20);cx.lineTo(628,130+i*20);cx.stroke();
    }
    // #83 OdpĹ‚yw
    cx.fillStyle='#222';cx.beginPath();cx.arc(330,235,8,0,Math.PI*2);cx.fill();
    cx.fillStyle='#444';for(let i=0;i<6;i++){const a=i*Math.PI/3;cx.fillRect(330+Math.cos(a)*4-1,235+Math.sin(a)*4-1,2,2);}
    // #83 Faucet (bateria) â€” wiÄ™ksza, profesjonalna
    // Mocowanie do blatu
    cx.fillStyle='#7a9aaa';cx.fillRect(fx-9,fy-12,18,12);
    // Pionowa rura
    const pipeG=cx.createLinearGradient(fx-7,fy-42,fx+7,fy-42);
    pipeG.addColorStop(0,'#6a8a9a');pipeG.addColorStop(.5,'#9ac0d8');pipeG.addColorStop(1,'#6a8a9a');
    cx.fillStyle=pipeG;cx.fillRect(fx-7,fy-44,14,42);
    // Spout horizontal (zakrzywiony)
    cx.fillStyle='#8ab0c8';cx.beginPath();
    cx.moveTo(fx-7,fy-44);cx.lineTo(fx-7,fy-52);cx.lineTo(fx-3,fy-56);cx.lineTo(fx+3,fy-56);cx.lineTo(fx+7,fy-52);cx.lineTo(fx+7,fy-44);cx.closePath();cx.fill();
    // Knob (gaĹ‚ka) â€” duĹĽa, klikalna
    cx.fillStyle=faucetOn?'#27ae60':'#3a4a5a';
    cx.beginPath();cx.arc(fx,fy-50,7,0,Math.PI*2);cx.fill();
    cx.strokeStyle='#fff';cx.lineWidth=1.5;cx.beginPath();cx.arc(fx,fy-50,7,0,Math.PI*2);cx.stroke();
    // Hint click â€” ramka pulsujÄ…ca gdy zakrÄ™cony
    if(!faucetOn){
      const pulse=0.4+Math.sin(Date.now()/300)*0.3;
      cx.strokeStyle=`rgba(255,220,80,${pulse})`;cx.lineWidth=2;
      cx.beginPath();cx.arc(fx,fy-50,11,0,Math.PI*2);cx.stroke();
    }
    // Water stream â€” gdy odkrÄ™cony
    if(faucetOn){
      const wt=Date.now();
      cx.fillStyle='rgba(100,180,255,0.55)';
      cx.beginPath();cx.moveTo(fx-3,fy);cx.lineTo(fx-5+Math.sin(wt*.01),fy+28);cx.lineTo(fx+5+Math.sin(wt*.01),fy+28);cx.lineTo(fx+3,fy);cx.fill();
      cx.fillStyle='rgba(150,210,255,0.4)';
      cx.beginPath();cx.ellipse(fx+Math.sin(wt*.01),fy+30,7,3.5,0,0,Math.PI*2);cx.fill();
      if(Math.random()<0.35)emitWaterDrops(fx,fy+30,2);
    }
    // #83 Etykieta kranu â€” JASNA logika
    cx.font='bold 12px "Segoe UI",Arial';cx.textAlign='center';
    cx.strokeStyle='rgba(0,0,0,.85)';cx.lineWidth=3;
    cx.strokeText(faucetOn?'đź’§ WODA â€” ON':'đź’§ WODA â€” OFF',fx,fy-66);
    cx.fillStyle=faucetOn?'#7ee87e':'#aab8c4';
    cx.fillText(faucetOn?'đź’§ WODA â€” ON':'đź’§ WODA â€” OFF',fx,fy-66);
    cx.font='10px "Segoe UI",Arial';
    const subText=faucetOn?'+50% szybkoĹ›Ä‡, -50% mydĹ‚o':'Klik = odkrÄ™Ä‡';
    cx.strokeText(subText,fx,fy-78);
    cx.fillStyle='#c0d0e0';cx.fillText(subText,fx,fy-78);
    cx.textAlign='left';
    // Draw items
    items.forEach(it=>{
      const {type,x,y,r,spots,done}=it;
      type.draw(cx,x,y,r);
      spots.forEach(s=>{
        if(s.dirty){
          cx.fillStyle='rgba(100,60,15,0.7)';
          cx.beginPath();cx.ellipse(s.x,s.y,s.r*0.9,s.r*0.45,0,0,Math.PI*2);cx.fill();
        }
      });
      if(done){
        cx.fillStyle='rgba(40,200,100,0.35)';
        cx.beginPath();cx.ellipse(x,y,r*1.1,r*.45,0,0,Math.PI*2);cx.fill();
        cx.fillStyle='#27ae60';cx.font='bold 16px Arial';cx.textAlign='center';
        cx.fillText('âś“',x,y+5);cx.textAlign='left';
      }
      cx.fillStyle='#cdd';cx.font='bold 12px "Segoe UI",Arial,sans-serif';cx.textAlign='center';
      cx.strokeStyle='rgba(0,0,0,.65)';cx.lineWidth=2.5;cx.strokeText(it.type.label,x,y+r+18);
      cx.fillText(it.type.label,x,y+r+18);cx.textAlign='left';
    });
    // Soap dispenser (dish soap bottle)
    const sdx=soapDispX,sdy=soapDispY;
    cx.fillStyle='#1a7a3a';cx.fillRect(sdx-14,sdy-50,28,60);
    cx.fillStyle='#2a9a5a';cx.beginPath();cx.arc(sdx,sdy-50,10,Math.PI,0);cx.fill();
    cx.fillStyle='#aaa';cx.fillRect(sdx-4,sdy-64,8,14);cx.fillRect(sdx-2,sdy-68,4,6);
    cx.fillStyle='#7ec8e3';cx.font='bold 12px "Segoe UI",Arial';cx.textAlign='center';
    cx.strokeStyle='rgba(0,0,0,.7)';cx.lineWidth=2.5;cx.strokeText('PĹYN',sdx,sdy+22);
    cx.fillText('PĹYN',sdx,sdy+22);
    cx.fillStyle='#9ab0c0';cx.font='9px "Segoe UI",Arial';
    cx.strokeText('Klik = nabierz',sdx,sdy+34);
    cx.fillText('Klik = nabierz',sdx,sdy+34);
    cx.fillStyle='#27ae60';cx.font='bold 13px "Segoe UI",Arial';
    cx.strokeText(`${Math.round(soapLevel)}%`,sdx,sdy-10);
    cx.fillText(`${Math.round(soapLevel)}%`,sdx,sdy-10);cx.textAlign='left';
    // Soap fill meter on bottle
    const fillH=Math.round(soapLevel/100*56);
    cx.fillStyle=`rgba(40,180,80,0.4)`;cx.fillRect(sdx-12,sdy-48+56-fillH,24,fillH);
    // Sponge
    cx.fillStyle=hasSoap?'#c8e840':'#d4a020';
    cx.beginPath();
    if(cx.roundRect)cx.roundRect(spongeX-16,spongeY-11,32,22,5);
    else cx.rect(spongeX-16,spongeY-11,32,22);
    cx.fill();
    // Sponge texture
    cx.fillStyle='rgba(0,0,0,.15)';
    for(let i=0;i<4;i++)for(let j=0;j<2;j++){cx.fillRect(spongeX-12+i*8,spongeY-7+j*8,5,5);}
    if(hasSoap&&soapLevel>0){
      cx.fillStyle='rgba(200,240,60,.25)';cx.beginPath();cx.arc(spongeX,spongeY,24,0,Math.PI*2);cx.fill();
      // Soap bubbles
      for(let i=0;i<3;i++){
        cx.strokeStyle='rgba(200,255,100,.5)';cx.lineWidth=1;
        cx.beginPath();cx.arc(spongeX+Math.sin(Date.now()/500+i)*15,spongeY-18+i*4,4+i,0,Math.PI*2);cx.stroke();
      }
    }
    if(soapLevel<=0){
      cx.fillStyle='rgba(180,40,40,.9)';cx.font='bold 13px "Segoe UI",Arial';cx.textAlign='center';
      cx.fillText('âš  Brak pĹ‚ynu! Kliknij dozownik â†’',340,268);cx.textAlign='left';
    }
    // Update + render particles (baĹ„ki, krople, sparkle)
    for(let i=fx_particles.length-1;i>=0;i--){
      const p=fx_particles[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.type==='bubble'){p.vy*=0.98;p.x+=Math.sin(Date.now()/300+i)*0.4;}
      else if(p.type==='water'){p.vy+=0.35;}
      else if(p.type==='sparkle'){p.vx*=0.92;p.vy*=0.92;}
      p.life--;
      const a=Math.max(0,p.life/p.max);
      if(p.type==='bubble'){
        cx.strokeStyle=`rgba(200,255,180,${a*0.85})`;cx.lineWidth=1.2;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.stroke();
        cx.fillStyle=`rgba(255,255,255,${a*0.4})`;
        cx.beginPath();cx.arc(p.x-p.size*0.3,p.y-p.size*0.3,p.size*0.3,0,Math.PI*2);cx.fill();
      } else if(p.type==='water'){
        cx.fillStyle=`rgba(120,200,255,${a*0.85})`;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.fill();
      } else if(p.type==='sparkle'){
        cx.shadowBlur=4;cx.shadowColor='#ffe066';
        cx.fillStyle=`rgba(255,240,120,${a})`;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.fill();
        cx.shadowBlur=0;
      }
      if(p.life<=0)fx_particles.splice(i,1);
    }
    /* v2.1.175: Perfect-plate flash + combo indicator */
    if(perfectFlashTime>0){
      perfectFlashTime--;
      const fa=perfectFlashTime/40;
      cx.fillStyle=`rgba(255,220,80,${fa*0.18})`;cx.fillRect(0,0,700,280);
      cx.font='bold 22px "Segoe UI",Arial';cx.textAlign='center';
      cx.strokeStyle='rgba(0,0,0,.85)';cx.lineWidth=4;cx.strokeText(perfectFlashLabel,350,80);
      cx.fillStyle=`rgba(255,220,80,${fa})`;cx.fillText(perfectFlashLabel,350,80);cx.textAlign='left';
    }
    if(combo>=3){
      cx.font='bold 18px "Segoe UI",Arial';cx.textAlign='center';
      cx.strokeStyle='rgba(0,0,0,.85)';cx.lineWidth=3;cx.strokeText(`đź”Ą COMBO Ă—${combo}`,350,260);
      cx.fillStyle='#f1c40f';cx.fillText(`đź”Ą COMBO Ă—${combo}`,350,260);cx.textAlign='left';
    }
    // Win check
    if(items.every(it=>it.done)&&gameActive){
      gameActive=false;
      earned=32; // #84 NERF: peĹ‚na zmiana = 32 zĹ‚ (poprzednio 45)
      /* v2.1.175: COMBO bonus dodany do peĹ‚nej zmiany */
      earned+=bonusPoints;
      earned=Math.floor(earned*getPracaBonus('zmywak')); // F3-FIX-B
      const nightBonus=G.timeOfDay===3;if(nightBonus)earned=Math.floor(earned*1.3);
      if(G.managementDeal)earned=Math.floor(earned*G.managementBonus);
      /* v2.1.177: round do najbliĹĽszego 5 zĹ‚ â€” czystszy odbiĂłr dla gracza */
      earned=Math.round(earned/5)*5;
      G.energy=clampStat('energy', G.energy-3); // v1.8.59: zmywak 6â†’3 (-70% od oryginaĹ‚u 10)
      /* v2.1.120: Wave 6 N19 â€” rep konsystencja zmywak: +1 rep co 5 ukoĹ„czonych peĹ‚nych zmian. */
      G._zmCount=(G._zmCount||0)+1;
      if(G._zmCount%5===0){G.streetRep=Math.min(100,(G.streetRep||0)+1);if(typeof addNotif==='function')addNotif('đź«§ +1 rep uliczna (5 peĹ‚nych zmian â€” szanujÄ… CiÄ™ w kuchni)');}
      cx.fillStyle='rgba(0,0,0,.75)';cx.fillRect(0,0,700,280);
      cx.fillStyle='#27ae60';cx.font='bold 26px "Segoe UI",Arial';cx.textAlign='center';
      cx.fillText(`Wszystko czyste! +${earned} zĹ‚`,350,120);
      if(comboMax>=3){
        cx.fillStyle='#f1c40f';cx.font='bold 18px "Segoe UI",Arial';
        cx.fillText(`đź”Ą Max combo: ${comboMax}Ă— Â· bonus +${bonusPoints} zĹ‚`,350,156);
      }
      cx.textAlign='left';
      /* v2.1.183 (Agent minigame audit): missing progressQuest('zmywak') w peĹ‚nym clear path. WczeĹ›niej tylko timeout (L23683) wywoĹ‚ywaĹ‚, wiÄ™c storyline NIE zaliczaĹ‚ prawidĹ‚owego sukcesu zmywaka. Earn jest pĹ‚acony przez cleanup() L23982. */
      if(typeof progressQuest==='function') progressQuest('zmywak');
      closeJobPanelAfter(3200);cleanup();return; // v1.8.44: 2200â†’3200ms (spĂłjnoĹ›Ä‡ z carwash/construction)
    }
    if(gameActive) requestAnimationFrame(draw);
  }
  draw();

  window._jobMgCleanup=()=>{
    gameActive=false;
    // SprawdĹş session token â€” jeĹ›li juĹĽ startuje nowa minigra (np. zmywak po szybkim restarcie),
    // ten cleanup nie powinien zamykaÄ‡ NOWEGO okna
    if(_jobPanelSession!==_sessId) return;
    if(window._zmwkTimer){clearInterval(window._zmwkTimer);window._zmwkTimer=null;}
    el.classList.remove('on');el.style.display='none';
    el.innerHTML='<div id="mg-job-content"></div>';
    // Reset kursora â€” canvas miaĹ‚ cursor:none, po wyjĹ›ciu wymuszamy default na body
    document.body.style.cursor='';
    if(earned>0){earn(earned);addXP(5);updateHUD();}
  };
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  POND FISHING MINIGAME â€” v2.1.201 [Amper]
//  WybĂłr: kontemplacja (rest) lub Ĺ‚owienie (interaktywny QTE).
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
window._showPondChoice=()=>{
  const ovrId='pond-choice-overlay';
  let ov=document.getElementById(ovrId);
  if(ov) ov.remove();
  ov=document.createElement('div');
  ov.id=ovrId;
  ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;font-family:inherit';
  const _fishCount=((G._fishingToday&&G._fishingToday.day===G.day)?G._fishingToday.count:0);
  const _fishLimit=5;
  const _fishCanFish=_fishCount<_fishLimit;
  ov.innerHTML=`<div style="background:#050f1c;border:2px solid #3498db;border-radius:12px;max-width:420px;width:100%;padding:20px;color:#fff">
    <div style="font-size:14px;color:#3498db;letter-spacing:1px;margin-bottom:10px">đźŚŠ STAW MIEJSKI</div>
    <div style="font-size:12px;color:#aaa;margin-bottom:14px">Co chcesz robiÄ‡?</div>
    <button onclick="(function(){var o=document.getElementById('pond-choice-overlay');if(o)o.remove();window._doPondRest&&window._doPondRest();})()" style="display:block;width:100%;text-align:left;background:#0a1528;border:1px solid #3498db;color:#fff;padding:12px;margin-bottom:8px;border-radius:6px;cursor:pointer;font-family:inherit">
      <b>đź§ Kontemplacja</b><br><span style="font-size:11px;color:#778">Odpoczynek przy stawie â€” +15 energii, +5 sytoĹ›ci, maĹ‚y XP bonus (1/min real)</span>
    </button>
    <button onclick="(function(){var o=document.getElementById('pond-choice-overlay');if(o)o.remove();window._startFishingMG&&window._startFishingMG();})()" ${!_fishCanFish?'disabled':''} style="display:block;width:100%;text-align:left;background:${_fishCanFish?'#0a1f1a':'#0a0a0a'};border:1px solid ${_fishCanFish?'#27ae60':'#222'};color:${_fishCanFish?'#fff':'#444'};padding:12px;margin-bottom:8px;border-radius:6px;cursor:${_fishCanFish?'pointer':'not-allowed'};font-family:inherit">
      <b>đźŽŁ Ĺowienie ryb</b> ${_fishCanFish?`<span style="color:#27ae60;font-size:11px">(${_fishCount}/${_fishLimit} dziĹ›)</span>`:`<span style="color:#e74c3c;font-size:11px">đź”’ Dzisiejszy limit ${_fishLimit}/${_fishLimit}</span>`}<br><span style="font-size:11px;color:#778">QTE minigame â€” zĹ‚ap rybÄ™ gdy pojawi siÄ™ "BRANIE!". ZĹ‚ota/srebrna/zwykĹ‚a â†’ 20-200 zĹ‚ + XP</span>
    </button>
    <button onclick="(function(){var o=document.getElementById('pond-choice-overlay');if(o)o.remove();})()" style="display:block;width:100%;background:#1a0a0a;border:1px solid #5a1a1a;color:#c0392b;padding:8px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px">â† WrĂłÄ‡</button>
  </div>`;
  document.body.appendChild(ov);
};
window._doPondRest=()=>{
  if(typeof startRestMG==='function') startRestMG('pond',15,5,15,'đźź Kontemplujesz staw...',()=>{if(typeof addXPCapped==='function') addXPCapped(3,'rest_pond',60000);});
};
window._startFishingMG=()=>{
  if(!G._fishingToday||G._fishingToday.day!==G.day){G._fishingToday={day:G.day,count:0};}
  if(G._fishingToday.count>=5){if(typeof showMsg==='function') showMsg('đźŽŁ Limit ryb dziĹ› (5/5). WrĂłÄ‡ jutro.','r');return;}
  const ovrId='fishing-overlay';
  let ov=document.getElementById(ovrId);
  if(ov) ov.remove();
  ov=document.createElement('div');
  ov.id=ovrId;
  ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;font-family:inherit';
  ov.innerHTML=`<div style="background:#050f1c;border:2px solid #3498db;border-radius:12px;max-width:480px;width:100%;padding:24px;color:#fff;text-align:center">
    <div style="font-size:14px;color:#3498db;letter-spacing:1px;margin-bottom:8px">đźŽŁ ĹOWIENIE RYB</div>
    <div id="fishing-status" style="font-size:18px;color:#aaa;margin:14px 0;min-height:60px;display:flex;align-items:center;justify-content:center;flex-direction:column">
      <div style="font-size:48px;margin-bottom:6px">đźŽŁ</div>
      <div>Czekasz na branie...</div>
    </div>
    <div id="fishing-water" style="width:100%;height:80px;background:linear-gradient(180deg,#0a3a5a,#062030);border-radius:8px;position:relative;overflow:hidden;margin-bottom:14px;border:1px solid #1a4a6a">
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 20px,rgba(255,255,255,.05) 20px,rgba(255,255,255,.05) 40px);animation:fishing-wave 3s linear infinite"></div>
    </div>
    <button id="fishing-strike-btn" disabled style="display:block;width:100%;background:#1a1a1a;border:2px solid #333;color:#444;padding:16px;border-radius:8px;font-family:inherit;font-size:18px;font-weight:700;cursor:not-allowed;margin-bottom:10px">âŹł Poczekaj...</button>
    <div style="font-size:10px;color:#778;line-height:1.5">Gdy pojawi siÄ™ "BRANIE!" â€” kliknij przycisk w 0.6s. Im szybciej, tym wiÄ™ksza szansa na rzadkÄ… rybÄ™.</div>
    <button id="fishing-quit-btn" onclick="(function(){if(window._fishingCleanup)window._fishingCleanup();var o=document.getElementById('fishing-overlay');if(o)o.remove();})()" style="display:block;width:100%;background:#1a0a0a;border:1px solid #5a1a1a;color:#c0392b;padding:8px;margin-top:8px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px">â† Wycofaj wÄ™dkÄ™</button>
  </div>
  <style>@keyframes fishing-wave{0%{background-position:0 0}100%{background-position:40px 0}}</style>`;
  document.body.appendChild(ov);
  let strikeActive=false,strikeStartTime=0,resolveTimeout=null,strikeWindow=null;
  const FISH=[
    {name:'MaĹ‚e pĹ‚otki',emoji:'đźź',weight:30,minPrice:20,maxPrice:50,xp:5,color:'#7ec8e3'},
    {name:'Karp',emoji:'đź ',weight:25,minPrice:45,maxPrice:100,xp:8,color:'#3498db'},
    {name:'Szczupak',emoji:'đźˇ',weight:18,minPrice:90,maxPrice:170,xp:12,color:'#9b59b6'},
    {name:'ZĹ‚ota karaĹ›',emoji:'âś¨',weight:5,minPrice:200,maxPrice:400,xp:25,color:'#f1c40f'},
  ];
  function pickFish(speedMs){
    let pool=FISH.slice();
    if(speedMs>500){pool=pool.filter(f=>f.weight>=18);} /* slow = tylko plebs */
    else if(speedMs<200){pool=pool;} /* fast = full chance na rare */
    const total=pool.reduce((s,f)=>s+f.weight,0);
    let r=Math.random()*total;
    for(const f of pool){r-=f.weight; if(r<=0) return f;}
    return pool[0];
  }
  function resolveSuccess(){
    const reactMs=Date.now()-strikeStartTime;
    const fish=pickFish(reactMs);
    const price=rnd(fish.minPrice,fish.maxPrice);
    if(typeof earn==='function') earn(price,false); else {G.money+=price; G.totalEarned=(G.totalEarned||0)+price;}
    if(typeof addXP==='function') addXP(fish.xp);
    G._fishingToday.count=(G._fishingToday.count||0)+1;
    /* Achievement tracker */
    G._fishCaught=(G._fishCaught||0)+1;
    const st=document.getElementById('fishing-status');
    if(st) st.innerHTML=`<div style="font-size:48px;margin-bottom:6px">${fish.emoji}</div><div style="color:${fish.color};font-weight:700">${fish.name}!</div><div style="font-size:13px;color:#27ae60;margin-top:6px">+${price} zĹ‚ Â· +${fish.xp} XP Â· reakcja ${reactMs}ms</div>`;
    const btn=document.getElementById('fishing-strike-btn');
    if(btn){btn.disabled=true;btn.style.background='#1a1a1a';btn.style.borderColor='#333';btn.style.color='#444';btn.textContent='âś… ZĹ‚owiona!';}
    if(typeof saveGameSilent==='function') saveGameSilent();
    setTimeout(()=>{
      const o=document.getElementById('fishing-overlay');if(o)o.remove();
      window._fishingCleanup=null;
    },1800);
  }
  function resolveFail(){
    const st=document.getElementById('fishing-status');
    if(st) st.innerHTML=`<div style="font-size:48px;margin-bottom:6px">đź’¨</div><div style="color:#e74c3c">SpĂłĹşniĹ‚eĹ› siÄ™!</div><div style="font-size:12px;color:#778;margin-top:4px">Ryba uciekĹ‚a. Nie liczy siÄ™ do limitu.</div>`;
    const btn=document.getElementById('fishing-strike-btn');
    if(btn){btn.disabled=true;btn.style.background='#1a0a0a';btn.style.borderColor='#5a1a1a';btn.style.color='#c0392b';btn.textContent='đź’¨ UciekĹ‚a';}
    setTimeout(()=>{
      const o=document.getElementById('fishing-overlay');if(o)o.remove();
      window._fishingCleanup=null;
    },1800);
  }
  function startStrike(){
    if(!document.getElementById('fishing-overlay')) return; /* user closed */
    strikeActive=true;
    strikeStartTime=Date.now();
    const st=document.getElementById('fishing-status');
    if(st) st.innerHTML=`<div style="font-size:48px;margin-bottom:6px;animation:fishing-bobber .25s linear infinite">đź”´</div><div style="color:#f1c40f;font-weight:900;font-size:22px">BRANIE!</div>`;
    const btn=document.getElementById('fishing-strike-btn');
    if(btn){btn.disabled=false;btn.style.background='#0a1f0a';btn.style.borderColor='#27ae60';btn.style.color='#27ae60';btn.style.cursor='pointer';btn.textContent='đźŽŁ PODSEKAJ!';
      btn.onclick=()=>{
        if(!strikeActive) return;
        strikeActive=false;
        if(resolveTimeout){clearTimeout(resolveTimeout);resolveTimeout=null;}
        resolveSuccess();
      };
    }
    resolveTimeout=setTimeout(()=>{
      if(strikeActive){strikeActive=false; resolveFail();}
    },600);
  }
  /* Random wait 2-5s before strike */
  strikeWindow=setTimeout(startStrike, 2000+Math.random()*3000);
  window._fishingCleanup=()=>{
    if(strikeWindow){clearTimeout(strikeWindow);strikeWindow=null;}
    if(resolveTimeout){clearTimeout(resolveTimeout);resolveTimeout=null;}
    window._fishingCleanup=null;
  };
  /* CSS keyframe for bobber */
  if(!document.getElementById('fishing-keyframes')){
    const styleEl=document.createElement('style');
    styleEl.id='fishing-keyframes';
    styleEl.textContent='@keyframes fishing-bobber{0%{transform:translateY(0)}50%{transform:translateY(-6px)}100%{transform:translateY(0)}}';
    document.head.appendChild(styleEl);
  }
};

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  SKATEPARK MINIGAME
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function startSkateparkMG(){
  const el=document.getElementById('mg-job');
  el.style.display='flex';el.classList.add('on');
  el.innerHTML='';

  const TRICKS=[
    {name:'Ollie',combo:['Space'],pts:10,color:'#f1c40f'},
    {name:'Kickflip',combo:['Space','ArrowLeft'],pts:20,color:'#e67e22'},
    {name:'Heelflip',combo:['Space','ArrowRight'],pts:20,color:'#e74c3c'},
    {name:'360 Flip',combo:['Space','ArrowUp','ArrowLeft'],pts:35,color:'#9b59b6'},
    {name:'Hardflip',combo:['Space','ArrowDown','ArrowRight'],pts:35,color:'#3498db'},
    {name:'Impossible',combo:['Space','ArrowUp','ArrowDown'],pts:50,color:'#1abc9c'},
    {name:'Nollie',combo:['Space','ArrowUp'],pts:25,color:'#e74c3c'},
    {name:'Pop Shove-it',combo:['ArrowLeft','Space'],pts:18,color:'#27ae60'},
  ];

  function arrowKey(k){return{Space:'SPACJA',ArrowUp:'â†‘',ArrowDown:'â†“',ArrowLeft:'â†',ArrowRight:'â†’'}[k]||k;}

  let gameActive=true,timeLeft=25,score=0,combo=0,maxCombo=0;
  let currentTrick=null,inputSeq=[];
  let skaterX=80,skaterVX=4,skaterY=200,inAir=false,airTime=0;
  let flashText='',flashAlpha=0,flashColor='#f1c40f';
  let particles=[];
  let danceTimer=0;

  el.innerHTML=`
    <div style="display:flex;gap:24px;align-items:center;margin-bottom:6px">
      <h2 style="color:#f1c40f;font-size:22px;margin:0">đź›ą Skatepark</h2>
      <span style="font-size:13px;color:#667">SPACJA + strzaĹ‚ki = tricki!</span>
      <span style="margin-left:auto;color:#aaa">âŹ± <b id="sk-time">25</b>s &nbsp; â­ <b id="sk-score">0</b> &nbsp; đź”Ą Combo <b id="sk-combo">0</b>x</span>
    </div>
    <canvas id="sk-cvs" width="700" height="330" style="border:1px solid #2a2a0a;border-radius:8px;display:block;"></canvas>
    <div id="sk-trick" style="font-size:14px;color:#7ec8e3;margin-top:6px;min-height:20px;text-align:center;"></div>
    <div id="sk-input" style="font-size:20px;min-height:26px;text-align:center;letter-spacing:6px;margin-top:2px;"></div>
    <button onclick="window._jobMgCleanup&&window._jobMgCleanup()" style="margin-top:8px;background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">âś• WyjdĹş</button>
  `;

  const cvs=document.getElementById('sk-cvs');
  const cx=cvs.getContext('2d');

  function pickTrick(){
    currentTrick=TRICKS[Math.floor(Math.random()*TRICKS.length)];
    inputSeq=[];
    const td=document.getElementById('sk-trick');
    if(td)td.innerHTML=`Trick: <b style="color:${currentTrick.color}">${currentTrick.name}</b> &nbsp; ${currentTrick.combo.map(arrowKey).join(' + ')}`;
    updateInputDisp();
  }

  function updateInputDisp(){
    const id=document.getElementById('sk-input');
    if(!id||!currentTrick)return;
    const done=inputSeq.map(arrowKey).join(' ');
    const rem=currentTrick.combo.slice(inputSeq.length).map(arrowKey).join(' ');
    id.innerHTML=`<span style="color:#27ae60">${done}</span><span style="color:#2a3a2a"> ${rem}</span>`;
  }

  function spawnParticles(x,y,color){
    for(let i=0;i<12;i++){
      particles.push({x,y,vx:(Math.random()-0.5)*8,vy:-Math.random()*10-2,alpha:1,color});
    }
  }

  function doTrick(){
    if(!currentTrick)return;
    const bonus=1+Math.floor(combo*0.12);
    score+=currentTrick.pts*bonus;
    combo++;maxCombo=Math.max(maxCombo,combo);
    inAir=true;airTime=0;
    flashText=`${currentTrick.name}! +${currentTrick.pts*bonus}`;
    flashAlpha=1;flashColor=currentTrick.color;
    spawnParticles(skaterX,skaterY-20,currentTrick.color);
    const sc=document.getElementById('sk-score');if(sc)sc.textContent=score;
    const cc=document.getElementById('sk-combo');if(cc)cc.textContent=combo+'x';
    danceTimer=20;
    setTimeout(pickTrick,700);
  }

  pickTrick();

  const skHandler=e=>{
    if(!gameActive)return;
    const key=e.code;
    if(!['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(key))return;
    e.preventDefault();
    if(!currentTrick)return;
    const expected=currentTrick.combo[inputSeq.length];
    if(key===expected){
      inputSeq.push(key);
      updateInputDisp();
      if(inputSeq.length===currentTrick.combo.length)doTrick();
    } else {
      combo=0;inputSeq=[];
      const cc=document.getElementById('sk-combo');if(cc)cc.textContent='0x';
      updateInputDisp();
      if(key===currentTrick.combo[0]){inputSeq.push(key);updateInputDisp();}
    }
  };
  document.addEventListener('keydown',skHandler);

  window._skTimer=setInterval(()=>{
    if(!gameActive)return;
    timeLeft--;
    const te=document.getElementById('sk-time');if(te)te.textContent=timeLeft;
    if(timeLeft<=0){gameActive=false;endSkate();}
  },1000);

  function endSkate(){
    // v1.8.61: rep cap 30â†’4 (skate byĹ‚ OP â€” 30 rep za 1 minutÄ™ vs 1 rep z kuriera)
    // v1.8.96: Street Art Week / Halloween â€” bonus rep
    /* v2.1.201 [Amper]: BUFF Skatepark reward â€” z -10 energii ROI ujemne. Teraz: rep cap 4â†’6, dodano cash tips od publicznoĹ›ci, follower gain, sĹ‚awa za big combo (â‰Ą10x).
       Skatepark to street performance â€” publicznoĹ›Ä‡ daje napiwki i nagrywa filmiki. */
    const _repFestMult=typeof festivalEffect==='function'?(festivalEffect('repMult')||1):1;
    const _repHolMult=typeof holidayBonus==='function'?holidayBonus('rep'):1;
    /* v1.9.27: BUG FIX â€” skate jest outdoor, weather wpĹ‚ywa (analogicznie do freestyle) */
    const _weatherMultSk=G.weather===2?0.5:G.weather===5?0.4:G.weather===3?0.7:G.weather===0?1.15:1.0;
    if(_weatherMultSk<1) addNotif(`â” ${G.weather===5?'Burza':G.weather===2?'Deszcz':'Ĺšnieg'} na skateparku â€” mniej widzĂłw (${Math.round((1-_weatherMultSk)*100)}% mniej napiwkĂłw)`);
    const repGain=Math.min(10,Math.round(Math.min(6,Math.floor(score/60))*_repFestMult*_repHolMult*_weatherMultSk));
    G.streetRep=clamp((G.streetRep||0)+repGain,0,100);
    G.energy=clampStat('energy', G.energy-10);
    // v2.1.201: cash tips + follower gain â€” publicznoĹ›Ä‡ lubi tricki
    const _tipMult = G._repBoost50?1.1:G._repBoost75?1.2:1.0;
    const moneyTips = Math.max(0, Math.floor(score/45 * _weatherMultSk * _tipMult));
    const followerGain = Math.max(0, Math.floor(score/40 * _weatherMultSk));
    if(moneyTips>0){ if(typeof earn==='function') earn(moneyTips,false); else {G.money+=moneyTips;G.totalEarned=(G.totalEarned||0)+moneyTips;} }
    if(followerGain>0){ G.followers=(G.followers||0)+followerGain; }
    let fameGain=0;
    if(maxCombo>=15){ fameGain=2; if(typeof addFame==='function')addFame(2);else G.fame=clamp(G.fame+2,0,500); }
    else if(maxCombo>=10){ fameGain=1; if(typeof addFame==='function')addFame(1);else G.fame=clamp(G.fame+1,0,500); }
    addXP(Math.floor(score/5));
    progressQuest('gym');if(typeof _trackGym==='function')_trackGym();
    const _bonusLine = (moneyTips>0||followerGain>0||fameGain>0) ? ` Â· +${moneyTips} zĹ‚ napiwkĂłw Â· +${followerGain} obs.${fameGain>0?` Â· +${fameGain} sĹ‚awy (mega combo!)`:''}` : '';
    notify(`đź›ą Skate zakoĹ„czony! Score: ${score}, Max Combo: ${maxCombo}x. +${repGain} rep uliczna${_bonusLine}`);
    updateHUD();
    cx.fillStyle='rgba(0,0,0,.8)';cx.fillRect(0,0,700,330);
    cx.fillStyle='#f1c40f';cx.font='bold 30px Arial';cx.textAlign='center';
    cx.fillText(`Score: ${score}  |  Max Combo: ${maxCombo}x`,350,140);
    cx.fillStyle='#27ae60';cx.font='20px Arial';
    cx.fillText(`+${repGain} rep Â· +${moneyTips} zĹ‚ Â· +${followerGain} obs.${fameGain>0?` Â· +${fameGain} sĹ‚awy!`:''}`,350,180);cx.textAlign='left';
    closeJobPanelAfter(3000);
  }

  // Ramp layout
  const ramp1X=450,ramp1W=220,ramp1H=110; // right ramp
  const rail1X=120,rail1Y=200,rail1W=140; // left rail

  let lastTime=performance.now();
  function draw(now){
    if(!gameActive&&!el.style.display)return;
    const dt=Math.min((now-lastTime)/16,3);lastTime=now;

    cx.fillStyle='#0a0a04';cx.fillRect(0,0,700,330);
    // Sky gradient
    const sg=cx.createLinearGradient(0,0,0,220);
    sg.addColorStop(0,'#0a0a18');sg.addColorStop(1,'#1a1a08');
    cx.fillStyle=sg;cx.fillRect(0,0,700,220);
    // Ground
    cx.fillStyle='#18180e';cx.fillRect(0,220,700,110);
    // Ground line
    cx.strokeStyle='#2a2a18';cx.lineWidth=2;cx.beginPath();cx.moveTo(0,220);cx.lineTo(700,220);cx.stroke();
    // Ground cracks
    for(let i=0;i<5;i++){
      cx.strokeStyle='rgba(60,60,40,.4)';cx.lineWidth=1;
      cx.beginPath();cx.moveTo(80+i*120,220);cx.lineTo(80+i*120+20,230);cx.stroke();
    }
    // Left rail (grind rail)
    cx.fillStyle='#5a5a3a';cx.fillRect(rail1X,rail1Y,rail1W,6);
    cx.fillStyle='#3a3a1a';cx.fillRect(rail1X,rail1Y+6,rail1W,4);
    // Rail supports
    [rail1X+10,rail1X+70,rail1X+130].forEach(rx=>{cx.fillStyle='#3a3a1a';cx.fillRect(rx,rail1Y+10,6,220-rail1Y-10);});
    cx.fillStyle='#888';cx.font='10px Arial';cx.textAlign='center';cx.fillText('RAIL',rail1X+rail1W/2,rail1Y-4);cx.textAlign='left';

    // Right quarter-pipe ramp
    cx.fillStyle='#2a2a1a';
    cx.beginPath();cx.moveTo(ramp1X,220);cx.lineTo(ramp1X+ramp1W,220);cx.lineTo(ramp1X+ramp1W,220-ramp1H);cx.closePath();cx.fill();
    cx.strokeStyle='#4a4a2a';cx.lineWidth=2;
    cx.beginPath();cx.moveTo(ramp1X,220);cx.quadraticCurveTo(ramp1X+ramp1W,220,ramp1X+ramp1W,220-ramp1H);cx.stroke();
    // Ramp wood lines
    for(let i=1;i<4;i++){
      cx.strokeStyle='rgba(80,80,40,.5)';cx.lineWidth=1;cx.beginPath();
      const t=i/4;cx.moveTo(ramp1X+t*ramp1W,220);cx.lineTo(ramp1X+ramp1W,220-ramp1H*t);cx.stroke();
    }

    // Skater physics
    skaterX+=skaterVX*dt;
    if(skaterX>ramp1X+ramp1W-10){skaterVX=-Math.abs(skaterVX)*0.95;}
    if(skaterX<30){skaterVX=Math.abs(skaterVX);}
    // Ground height at skater position
    let gndY=220;
    if(skaterX>=ramp1X&&skaterX<=ramp1X+ramp1W){
      const t=(skaterX-ramp1X)/ramp1W;
      gndY=220-ramp1H*t; // ramp rises to the right
    } else if(skaterX>=rail1X&&skaterX<=rail1X+rail1W){
      gndY=rail1Y+2;
    }
    if(inAir){
      airTime+=dt;
      const h=Math.sin(airTime/16*Math.PI)*80;
      skaterY=gndY-h;
      if(airTime>=16){inAir=false;skaterY=gndY;airTime=0;}
    } else {
      skaterY=gndY;
    }

    // Draw skateboard
    const bw=32,bh=6;
    const bx=skaterX-bw/2,by=skaterY+20;
    // Board shape (slight kick at tail)
    cx.fillStyle='#8a4418';
    cx.beginPath();
    cx.moveTo(bx,by+bh);cx.lineTo(bx,by+2);cx.lineTo(bx+bw,by);cx.lineTo(bx+bw,by+bh);cx.closePath();cx.fill();
    // Board graphic
    cx.fillStyle=currentTrick?currentTrick.color:'#c06020';
    cx.fillRect(bx+4,by+1,bw-8,3);
    // Trucks
    cx.fillStyle='#888';cx.fillRect(bx+4,by+bh,8,3);cx.fillRect(bx+bw-12,by+bh,8,3);
    // Wheels
    cx.fillStyle='#555';
    cx.beginPath();cx.arc(bx+8,by+bh+4,4,0,Math.PI*2);cx.fill();
    cx.beginPath();cx.arc(bx+bw-8,by+bh+4,4,0,Math.PI*2);cx.fill();
    cx.fillStyle='#333';
    cx.beginPath();cx.arc(bx+8,by+bh+4,2,0,Math.PI*2);cx.fill();
    cx.beginPath();cx.arc(bx+bw-8,by+bh+4,2,0,Math.PI*2);cx.fill();

    // Skater body
    const sk=skaterX,sy=skaterY;
    const rotate=inAir?(Math.sin(airTime/16*Math.PI*2)*0.6):0;
    cx.save();cx.translate(sk,sy);cx.rotate(rotate);
    // Legs
    if(danceTimer>0){danceTimer--;
      const la=Math.sin(danceTimer*0.4)*30*Math.PI/180;
      cx.strokeStyle='#1a3a8a';cx.lineWidth=6;
      cx.beginPath();cx.moveTo(-4,8);cx.lineTo(-4+Math.sin(la)*12,22);cx.lineTo(-4+Math.sin(la)*12+8,34);cx.stroke();
      cx.beginPath();cx.moveTo(4,8);cx.lineTo(4-Math.sin(la)*12,22);cx.lineTo(4-Math.sin(la)*12-8,34);cx.stroke();
    } else {
      cx.fillStyle='#1a3a8a';
      cx.fillRect(-6,8,6,14);cx.fillRect(1,8,6,14);
    }
    // Shoes
    cx.fillStyle='#0a0a0a';cx.fillRect(-9,20,10,5);cx.fillRect(1,20,10,5);
    // Torso
    cx.fillStyle='#c03020';cx.fillRect(-9,-4,18,14);
    // Hood/hoodie draw lines
    cx.strokeStyle='#a02010';cx.lineWidth=1;cx.beginPath();cx.moveTo(0,-4);cx.lineTo(0,10);cx.stroke();
    // Arms
    const armSwing=inAir?Math.sin(airTime/8)*40:skaterVX>0?15:-15;
    cx.strokeStyle='#c03020';cx.lineWidth=7;
    cx.beginPath();cx.moveTo(-9,0);cx.lineTo(-9-Math.cos(armSwing*Math.PI/180)*14,0-Math.sin(armSwing*Math.PI/180)*14);cx.stroke();
    cx.beginPath();cx.moveTo(9,0);cx.lineTo(9+Math.cos(armSwing*Math.PI/180)*14,0+Math.sin(armSwing*Math.PI/180)*14);cx.stroke();
    // Head
    cx.fillStyle='#e0a860';cx.beginPath();cx.arc(0,-12,9,0,Math.PI*2);cx.fill();
    // Hood
    cx.fillStyle='#c03020';cx.beginPath();cx.arc(0,-14,10,Math.PI,Math.PI*2);cx.fill();
    cx.restore();

    // Particles
    particles=particles.filter(p=>{
      p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=0.5*dt;p.alpha-=0.04*dt;
      if(p.alpha<=0)return false;
      cx.fillStyle=p.color;cx.globalAlpha=p.alpha;
      cx.beginPath();cx.arc(p.x,p.y,3,0,Math.PI*2);cx.fill();
      cx.globalAlpha=1;
      return true;
    });

    // Flash text
    if(flashAlpha>0){
      flashAlpha-=0.025*dt;
      cx.globalAlpha=Math.max(0,flashAlpha);
      cx.fillStyle=flashColor;
      cx.font=`bold ${28+flashAlpha*12}px Arial`;cx.textAlign='center';
      cx.shadowColor=flashColor;cx.shadowBlur=12;
      cx.fillText(flashText,350,80);
      cx.shadowBlur=0;cx.textAlign='left';cx.globalAlpha=1;
    }

    // Trick hint at bottom
    if(currentTrick&&gameActive){
      cx.fillStyle='rgba(0,0,0,.5)';cx.fillRect(0,300,700,30);
      cx.fillStyle='rgba(100,200,255,0.6)';cx.font='13px Arial';cx.textAlign='center';
      cx.fillText(`${currentTrick.combo.map(arrowKey).join(' + ')}  â†’  ${currentTrick.name}`,350,320);cx.textAlign='left';
    }

    if(gameActive||flashAlpha>0) requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);

  window._jobMgCleanup=()=>{
    gameActive=false;
    if(window._skTimer){clearInterval(window._skTimer);window._skTimer=null;}
    document.removeEventListener('keydown',skHandler);
    el.classList.remove('on');el.style.display='none';
    el.innerHTML='<div id="mg-job-content"></div>';
  };
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  FREESTYLE MINIGAME đźŽ¤
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function startFreestyleMG(){
  // Skill gate â€” Flow 1 gives bonus, but game is open to beginners
  const flowLevel=getRaperST('flow');
  const el=document.getElementById('mg-job');
  el.style.display='';el.classList.add('on');
  el.innerHTML='';
  // v1.8.64: safety â€” wyczyĹ›Ä‡ bufor admina ĹĽeby trafienie "snowy"/"amper" w freestyle nie uruchomiĹ‚o panelu
  // (gĹ‚Ăłwna ochrona to !_busyMG check w globalnym keydown, ten reset usuwa teĹĽ stare litery sprzed minigry)
  try{ _adminSeq=''; }catch(_){}

  const WORDS=['drip','flow','beats','swag','bars','trap','wave','grind','hustle','cold',
    'melodia','rytm','sĹ‚awa','ulica','hajs','noc','raj','bĂłl','moc','ekipa',
    'freestyle','mikrofon','studio','label','stream','viral','koncert','single','track','album',
    'raper','tekst','hook','wers','beton','blok','Ĺ‚aĹ„cuch','fame',
    'rhyme','verse','beat','stage','crowd','money','dope',
    // Game-themed
    'amper','puch43','snowy','traper','traphouse','penthouse','vibe','clout','street','ghetto',
    // Trap/rap extras
    'autotune','808','sub','drumkit','adlib','remix','mixtape','cypher','gold','platyna',
    'biling','flexin','cash','grands','squad','homies','fresh','ice','chain','rolex',
    // v1.8.64: dodane
    'rollie','vvs','diamond','iced out','focusrite','nt1'];

  // v1.8.97: Flow 1 "Podstawowy rytm" â€” freestyle trwa +10% dĹ‚uĹĽej (33s zamiast 30)
  const _flowDur=(typeof getRaperST==='function' && getRaperST('flow')>=1)?33:30;
  let gameActive=true,timeLeft=_flowDur,score=0,combo=0,wordsCorrect=0;
  let curWord='',typed='',wordStartTime=0;

  function pickWord(){
    let w;
    do {
      // v1.8.64: minimalny smaczek â€” ~2% szansy na sĹ‚owo z bonus poola (snowy/amper)
      if(Math.random()<0.02){
        w = Math.random()<0.5 ? 'snowy' : 'amper';
      } else {
        w = WORDS[Math.floor(Math.random()*WORDS.length)];
      }
    } while(w===curWord);
    return w;
  }

  function nextWord(){
    curWord=pickWord();typed='';wordStartTime=Date.now();
    renderWord();
  }

  function renderWord(){
    const wa=document.getElementById('fs-wordarea');
    if(!wa) return;
    let html='';
    for(let i=0;i<curWord.length;i++){
      if(i<typed.length){
        html+=`<span style="font-size:52px;font-weight:900;letter-spacing:6px;color:#27ae60">${curWord[i].toUpperCase()}</span>`;
      } else if(i===typed.length){
        html+=`<span style="font-size:52px;font-weight:900;letter-spacing:6px;color:#fff;border-bottom:3px solid #f1c40f">${curWord[i].toUpperCase()}</span>`;
      } else {
        html+=`<span style="font-size:52px;font-weight:900;letter-spacing:6px;color:#334">${curWord[i].toUpperCase()}</span>`;
      }
    }
    wa.innerHTML=html;
  }

  el.innerHTML=`
    <h2 style="color:#e91e8c;font-size:22px;margin-bottom:4px">đźŽ¤ Freestyle na ulicy</h2>
    <div style="font-size:13px;color:#667;margin-bottom:10px">Wpisz sĹ‚owo na klawiaturze! Szybko i bezbĹ‚Ä™dnie = wiÄ™cej punktĂłw!</div>
    ${flowLevel<1?'<div style="font-size:12px;color:#f1c40f;margin-bottom:8px;">đź’ˇ Odblokuj Flow w drzewku aby zwiÄ™kszyÄ‡ nagrody!</div>':''}
    <div style="display:flex;gap:24px;margin-bottom:12px;font-size:15px;color:#aaa;">
      <span>âŹ± <b id="fs-time">30</b>s</span>
      <span>đź”Ą Score: <b id="fs-score">0</b></span>
      <span>đźŽµ Combo: <b id="fs-combo">0x</b></span>
      <span>âś… <b id="fs-words">0</b> sĹ‚Ăłw</span>
    </div>
    <div style="width:680px;min-height:110px;background:#050c18;border:2px solid #e91e8c;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;padding:10px;">
      <div id="fs-wordarea"></div>
    </div>
    <div id="fs-feed" style="font-size:20px;color:#f1c40f;min-height:28px;text-align:center;font-weight:700;margin-bottom:8px;"></div>
    <button id="fs-exit" style="background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">âś• WyjdĹş</button>
  `;
  document.getElementById('fs-exit').onclick=()=>{gameActive=false;cleanup();};
  nextWord();

  const timer=setInterval(()=>{
    if(!gameActive){clearInterval(timer);return;}
    timeLeft-=0.1;
    const bt=document.getElementById('fs-time');if(bt)bt.textContent=Math.ceil(timeLeft);
    if(timeLeft<=0){gameActive=false;clearInterval(timer);cleanup();}
  },100);

  window._fsKeydown=(e)=>{
    if(!gameActive) return;
    if(e.key.length===1&&!e.ctrlKey&&!e.altKey&&!e.metaKey){
      e.preventDefault();
      const expected=curWord[typed.length];
      if(!expected) return;
      if(e.key.toLowerCase()===expected.toLowerCase()){
        typed+=e.key;
        if(typed.length===curWord.length){
          // Word completed!
          const elapsed=(Date.now()-wordStartTime)/1000;
          const speedBonus=Math.max(1,Math.round(5/Math.max(0.5,elapsed)));
          const flowMult=flowLevel>=2?1.15:1;
          const pts=Math.round((10+combo*2)*speedBonus*flowMult);
          score+=pts;combo++;wordsCorrect++;
          document.getElementById('fs-score').textContent=score;
          document.getElementById('fs-combo').textContent=combo+'x';
          document.getElementById('fs-words').textContent=wordsCorrect;
          const msgs=['đź”Ą FIRE!','đź’Ż ON POINT!','âšˇ BARS!','đźŽ¤ FLOW!','âś… DOPE!','đź’Ş FRESH!','đź¤ HARD!'];
          const fd=document.getElementById('fs-feed');if(fd)fd.textContent=msgs[Math.floor(Math.random()*msgs.length)];
          nextWord();
        } else {
          renderWord();
        }
      } else {
        // Wrong key â€” break combo, shake effect
        combo=0;
        document.getElementById('fs-combo').textContent='0x';
        const fd=document.getElementById('fs-feed');if(fd)fd.textContent='đź’€ BĹ‚Ä…d!';
        const wa=document.getElementById('fs-wordarea');
        if(wa){
          wa.style.animation='none';
          requestAnimationFrame(()=>{wa.style.animation='fs-shake .2s';});
        }
      }
    }
  };
  document.addEventListener('keydown',window._fsKeydown);

  function cleanup(){
    clearInterval(timer);
    if(window._fsKeydown){document.removeEventListener('keydown',window._fsKeydown);window._fsKeydown=null;}
    // Award rewards
    let raperXP=0,fansGained=0,followers=0,repGain=0,mainXP=0;
    // WpĹ‚yw pogody na freestyle (deszcz/burza/Ĺ›nieg = mniej publiki)
    const weatherMult = G.weather===2 ? 0.5 :  // deszcz
                       G.weather===5 ? 0.4 :   // burza
                       G.weather===3 ? 0.7 :   // Ĺ›nieg
                       G.weather===0 ? 1.15 :  // sĹ‚oĹ„ce â€” bonus
                       1.0;
    if(weatherMult<1) addNotif(`â” ${G.weather===5?'Burza':G.weather===2?'Deszcz':'Ĺšnieg'} â€” mniej osĂłb na ulicy (${Math.round((1-weatherMult)*100)}% nagrĂłd mniej)`);
    // F3-FIX-D: FLOW + SKUPIENIE (Master Mind +25% jakoĹ›ci aktywnoĹ›ci)
    score = Math.floor(score * getFlowFreestyleBonus() * getSkupienieFocusBonus());
    // v1.8.96: Talent Contest â€” bonus freestyle
    const _fsBoost=typeof festivalEffect==='function'?(festivalEffect('freestyleBoost')||1):1;
    if(_fsBoost>1){ score=Math.floor(score*_fsBoost); }
    if(score>0){
      if(!G.careers.raper) G.careers.raper={level:0,freestyles:0,tracks:0,xp:0,skillPts:0};
      G.careers.raper.freestyles=(G.careers.raper.freestyles||0)+1;
      // #78 NERF 10Ă— â€” gracz dostawaĹ‚ ~266 raperXP / 106 fanĂłw / 133 follow / 88 rep za 30s freestyle (absurd)
      // Teraz: ~26 raperXP / 10 fanĂłw / 13 follow / 8 rep â€” wymaga ~10 freestyle aby wbiÄ‡ poziom raper
      raperXP=Math.floor(score*weatherMult/100);addRaperXP(raperXP);
      /* v2.1.33: stare dwa liczniki (fansGained score/250 + followers score/200) byĹ‚y dodawane oba do casual po refaktorze v2.1.31.
         Zostawiona wiÄ™ksza formuĹ‚a (score/200) jako pojedyncza â€” odpowiada "13 follow / 30s" z komentarza #78 NERF. */
      /* v2.1.112: Wave 1 S2 â€” viral bonus visible feedback (wczeĹ›niej cichy bonus, gracz nie wiedziaĹ‚ ĹĽe Flow 4 aktywowaĹ‚). */
      const _viralRoll = flowLevel>=4 && Math.random()<0.10;
      fansGained=Math.floor(score*weatherMult/200)+(_viralRoll?50:0);
      /* v2.1.34: uliczny freestyle = lojalni fani (zatrzymali siÄ™, sĹ‚uchajÄ…) */
      if(fansGained>0){addFans(fansGained);} /* v2.1.141: freestyle ulica fans */
      if(_viralRoll){if(typeof addNotif==='function')addNotif('đź”Ą VIRAL FREESTYLE! Flow 4 evolution: +50 lojalnych fanĂłw!');if(typeof showMsg==='function')showMsg('đź”Ą Viral freestyle! +50 fanĂłw bonus!','g',3500);}
      followers=fansGained; /* alias dla komunikatĂłw */
      mainXP=Math.floor(score/80);addXP(mainXP);  // XP bez pogody â€” score/8â†’score/80
      repGain=Math.floor(score*weatherMult/300);
      G.streetRep=Math.min(100,(G.streetRep||0)+repGain);
      progressQuest('freestyle');
    }
    // Grade + high score
    const grade=score>=500?'S':score>=300?'A':score>=150?'B':score>=75?'C':score>0?'D':'F';
    const gradeCol={'S':'#f1c40f','A':'#e91e8c','B':'#3498db','C':'#2ecc71','D':'#aaa','F':'#555'}[grade];
    const prevHigh=G.careers.raper?G.careers.raper.freestyleHighScore||0:0;
    const isNewRecord=score>prevHigh&&score>0;
    if(isNewRecord){if(!G.careers.raper)G.careers.raper={level:0,freestyles:0,tracks:0,xp:0,skillPts:0};G.careers.raper.freestyleHighScore=score;}
    if(grade==='S'||grade==='A') confetti(grade==='S'?50:25);
    const rewardsHtml=score>0?`
      <div style="background:#0a1220;border:1px solid #1a3a5a;border-radius:10px;padding:12px 16px;margin-bottom:16px;text-align:left">
        <div style="font-size:12px;color:#556;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Nagrody</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:14px">
          <div style="color:#e8a020">đźŽ¤ +${raperXP} XP rapera</div>
          <div style="color:#2ecc71">â­ +${mainXP} XP</div>
          <div style="color:#3498db">đź‘Ą +${fansGained} fanĂłw</div>
          <div style="color:#9b59b6">đź“± +${followers} followersĂłw</div>
          ${repGain>0?`<div style="color:#e91e8c">đźŹ† +${repGain} rep ulicy</div>`:''}
        </div>
      </div>`:'<div style="color:#667;font-size:14px;margin-bottom:16px">Brak punktĂłw â€” brak nagrody.</div>';
    el.innerHTML=`
      <div style="text-align:center;padding:22px 24px">
        <div style="font-size:18px;color:#e91e8c;font-weight:700;margin-bottom:2px">đźŽ¤ Freestyle zakoĹ„czony!</div>
        ${isNewRecord?`<div style="font-size:11px;color:#f1c40f;letter-spacing:2px;font-weight:700;margin-bottom:2px">â… NOWY REKORD! â…</div>`:''}
        <div style="font-size:88px;font-weight:900;color:${gradeCol};line-height:1;text-shadow:0 0 28px ${gradeCol}99;margin:8px 0 4px">${grade}</div>
        <div style="font-size:30px;font-weight:700;color:#fff;margin-bottom:2px">${score} pkt</div>
        <div style="font-size:13px;color:#778;margin-bottom:4px">${wordsCorrect} sĹ‚Ăłw Â· max combo ${combo}x</div>
        ${prevHigh>0&&!isNewRecord?`<div style="font-size:11px;color:#445;margin-bottom:12px">Rekord: ${prevHigh} pkt</div>`:'<div style="margin-bottom:12px"></div>'}
        ${rewardsHtml}
        <div style="display:flex;gap:10px;justify-content:center">
          <button onclick="var _e=document.getElementById('mg-job');_e.style.display='none';_e.classList.remove('on');_e.innerHTML='';startFreestyleMG();" style="background:#0a1528;border:1px solid #e91e8c;color:#e91e8c;padding:10px 22px;border-radius:6px;cursor:pointer;font-size:15px;font-weight:700">đź”„ Jeszcze raz</button>
          <button onclick="var _e=document.getElementById('mg-job');_e.style.display='none';_e.classList.remove('on');_e.innerHTML='';" style="background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:10px 22px;border-radius:6px;cursor:pointer;font-size:15px">âś• WyjdĹş</button>
        </div>
      </div>
    `;
  }

  window._jobMgCleanup=()=>{gameActive=false;clearInterval(timer);if(window._fsKeydown)document.removeEventListener('keydown',window._fsKeydown);el.style.display='none';el.classList.remove('on');el.innerHTML='';};
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  BREAKDANCE MINIGAME
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function startBreakdanceMG(){
  const el=document.getElementById('mg-job');
  el.style.display='flex';el.classList.add('on');
  el.innerHTML='';
  window._bbSessionToken=(window._bbSessionToken||0)+1;

  const MOVES=[
    {name:'Toprock',seq:['ArrowLeft','ArrowRight'],pts:15,color:'#e74c3c'},
    {name:'6-Step',seq:['ArrowDown','ArrowLeft','ArrowDown','ArrowRight'],pts:30,color:'#9b59b6'},
    {name:'Freeze',seq:['ArrowUp','ArrowUp'],pts:20,color:'#3498db'},
    {name:'Windmill',seq:['ArrowLeft','ArrowDown','ArrowRight','ArrowUp'],pts:50,color:'#f1c40f'},
    {name:'Headspin',seq:['ArrowUp','ArrowLeft','ArrowDown','ArrowRight'],pts:60,color:'#e67e22'},
    {name:'Flare',seq:['ArrowRight','ArrowDown','ArrowLeft'],pts:40,color:'#27ae60'},
  ];

  let gameActive=true,timeLeft=30,score=0,combo=0,maxCombo=0;
  let currentMove=null,inputSeq=[],dancePhase=0;
  let lastFlash='',flashTimer=0;

  const title=document.createElement('div');
  title.innerHTML='<h2 style="color:#e74c3c;font-size:22px;margin-bottom:4px">đź’ Breakdance Battle</h2><div style="font-size:13px;color:#667;margin-bottom:8px">Wpisz sekwencje strzaĹ‚ek aby wykonaÄ‡ ruchy! Im wiÄ™cej combo, tym wiÄ™cej fanĂłw!</div>';
  el.appendChild(title);

  const info=document.createElement('div');
  info.style.cssText='display:flex;gap:24px;margin-bottom:8px;font-size:15px;color:#aaa;';
  info.innerHTML='<span>âŹ± <b id="bb-time">30</b>s</span><span>â­ Score: <b id="bb-score">0</b></span><span>đź”Ą Combo: <b id="bb-combo">0x</b></span>';
  el.appendChild(info);

  const cvs=document.createElement('canvas');
  cvs.width=700;cvs.height=300;
  cvs.style.cssText='border:1px solid #2a0a2a;border-radius:8px;display:block;';
  el.appendChild(cvs);
  const cx=cvs.getContext('2d');

  const moveDiv=document.createElement('div');
  moveDiv.id='bb-move';
  moveDiv.style.cssText='font-size:14px;color:#e74c3c;margin-top:6px;min-height:22px;text-align:center;';
  el.appendChild(moveDiv);

  const inputDiv=document.createElement('div');
  inputDiv.id='bb-input';
  inputDiv.style.cssText='font-size:18px;color:#f1c40f;min-height:28px;text-align:center;letter-spacing:4px;';
  el.appendChild(inputDiv);

  const exitBtn=document.createElement('button');
  exitBtn.textContent='âś• WyjdĹş';
  exitBtn.style.cssText='margin-top:8px;background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;';
  exitBtn.onclick=()=>{gameActive=false;cleanup();};
  el.appendChild(exitBtn);

  function arrowChar(k){return{ArrowUp:'â†‘',ArrowDown:'â†“',ArrowLeft:'â†',ArrowRight:'â†’'}[k]||k;}

  function pickMove(){
    currentMove=MOVES[Math.floor(Math.random()*MOVES.length)];
    inputSeq=[];
    const md=document.getElementById('bb-move');
    if(md)md.innerHTML=`Ruch: <b style="color:${currentMove.color}">${currentMove.name}</b> &nbsp; ${currentMove.seq.map(arrowChar).join(' ')}`;
    updateInputDisplay();
  }

  function updateInputDisplay(){
    const id=document.getElementById('bb-input');
    if(!id||!currentMove)return;
    const done=inputSeq.map(arrowChar).join(' ');
    const remaining=currentMove.seq.slice(inputSeq.length).map(arrowChar).join(' ');
    id.innerHTML=`<span style="color:#27ae60">${done}</span> <span style="color:#334">${remaining}</span>`;
  }

  function doMove(){
    if(!currentMove)return;
    const pts=currentMove.pts*(1+Math.floor(combo*0.15));
    score+=pts;combo++;maxCombo=Math.max(maxCombo,combo);
    dancePhase=10;
    const sc=document.getElementById('bb-score');if(sc)sc.textContent=score;
    const cc=document.getElementById('bb-combo');if(cc)cc.textContent=combo+'x';
    lastFlash=`${currentMove.name}! +${pts}`;flashTimer=40;
    setTimeout(pickMove,600);
  }

  pickMove();

  const bbHandler=(e)=>{
    if(!gameActive)return;
    const key=e.code;
    if(!['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(key))return;
    e.preventDefault();
    if(!currentMove)return;
    const expected=currentMove.seq[inputSeq.length];
    if(key===expected){
      inputSeq.push(key);
      updateInputDisplay();
      if(inputSeq.length===currentMove.seq.length)doMove();
    } else {
      combo=0;inputSeq=[];
      const cc=document.getElementById('bb-combo');if(cc)cc.textContent='0x';
      updateInputDisplay();
      if(key===currentMove.seq[0]){inputSeq.push(key);updateInputDisplay();}
    }
  };
  document.addEventListener('keydown',bbHandler);

  window._bbTimer=setInterval(()=>{
    if(!gameActive)return;
    timeLeft--;
    const te=document.getElementById('bb-time');if(te)te.textContent=timeLeft;
    if(timeLeft<=0){gameActive=false;endBboy();}
  },1000);

  function endBboy(){
    // v1.8.61: rep cap 25â†’4 (breakdance byĹ‚ OP)
    // v1.8.96: Street Art Week / Halloween â€” bonus rep
    const _bRepFestMult=typeof festivalEffect==='function'?(festivalEffect('repMult')||1):1;
    const _bRepHolMult=typeof holidayBonus==='function'?holidayBonus('rep'):1;
    /* v1.9.27: BUG FIX â€” breakdance outdoor, weather wpĹ‚ywa */
    const _weatherMultBb=G.weather===2?0.5:G.weather===5?0.4:G.weather===3?0.7:G.weather===0?1.15:1.0;
    if(_weatherMultBb<1) addNotif(`â” ${G.weather===5?'Burza':G.weather===2?'Deszcz':'Ĺšnieg'} â€” breakdance bez publiki (${Math.round((1-_weatherMultBb)*100)}% mniej rep)`);
    const repGain=Math.min(8,Math.round(Math.min(4,Math.floor(score/95))*_bRepFestMult*_bRepHolMult*_weatherMultBb));
    const moodGain=Math.min(30,Math.floor(score/10));
    const followerGain=rnd(0,Math.floor((G.streetRep||0)/4+maxCombo));
    G.streetRep=clamp((G.streetRep||0)+repGain,0,100);
    G.stress=clamp(G.stress+moodGain,0,100);
    G.energy=clampStat('energy', G.energy-8);
    /* v2.1.34: uliczny breakdance = lojalni fani (zatrzymali siÄ™ obejrzeÄ‡ show) */
    addFans(followerGain||0); /* v2.1.141: breakdance fans */
    addXP(Math.floor(score/8));
    notify(`đź’ Breakdance! Score: ${score}, max combo x${maxCombo}. +${repGain} rep, +${followerGain} fanĂłw!`);
    updateHUD();
    cx.fillStyle='rgba(0,0,0,0.8)';cx.fillRect(0,0,700,300);
    cx.fillStyle='#e74c3c';cx.font='bold 30px Arial';cx.textAlign='center';
    cx.fillText(`Score: ${score} | Combo: x${maxCombo}`,350,140);
    cx.fillStyle='#f1c40f';cx.font='20px Arial';
    cx.fillText(`+${repGain} rep â€˘ +${followerGain} fanĂłw`,350,180);cx.textAlign='left';
    const _bbToken=window._bbSessionToken;setTimeout(()=>{if(window._bbSessionToken===_bbToken)cleanup();},3000);
  }

  function cleanup(){
    gameActive=false;
    if(window._bbTimer){clearInterval(window._bbTimer);window._bbTimer=null;}
    document.removeEventListener('keydown',bbHandler);
    el.style.display='none';el.classList.remove('on');el.innerHTML='';
  }

  function draw(){
    if(!gameActive&&el.style.display==='none')return;
    cx.fillStyle='#0a040e';cx.fillRect(0,0,700,300);
    // Dance floor pattern
    for(let x=0;x<700;x+=40){for(let y=220;y<300;y+=40){
      cx.fillStyle=(Math.floor(x/40)+Math.floor(y/40))%2===0?'#120a18':'#0e0814';
      cx.fillRect(x,y,40,40);
    }}
    cx.strokeStyle='#1a0a2a';cx.lineWidth=1;
    for(let x=0;x<700;x+=40){cx.beginPath();cx.moveTo(x,220);cx.lineTo(x,300);cx.stroke();}
    for(let y=220;y<300;y+=40){cx.beginPath();cx.moveTo(0,y);cx.lineTo(700,y);cx.stroke();}
    // Crowd (silhouettes)
    for(let i=0;i<12;i++){
      const cx2=50+i*55,cy2=200;
      cx.fillStyle=`rgba(${50+i*10},${20+i*5},${80+i*8},0.7)`;
      cx.beginPath();cx.arc(cx2,cy2-15,10,0,Math.PI*2);cx.fill();
      cx.fillRect(cx2-6,cy2-5,12,20);
    }
    // Dancer
    if(dancePhase>0)dancePhase--;
    const da=dancePhase>0?(Math.sin(dancePhase*0.8)*15)*(1+combo*0.05):0;
    cx.save();cx.translate(350,200);cx.rotate(da*Math.PI/180);
    cx.fillStyle='#e8c060';cx.beginPath();cx.arc(0,-50,14,0,Math.PI*2);cx.fill();
    cx.fillStyle='#e74c3c';cx.fillRect(-12,-36,24,36);
    // Arms
    const armAngle=dancePhase>0?Math.sin(dancePhase*1.2)*40:Math.sin(Date.now()/400)*15;
    cx.strokeStyle='#c03030';cx.lineWidth=8;
    cx.beginPath();cx.moveTo(-12,-20);cx.lineTo(-12-Math.cos((armAngle)*Math.PI/180)*28,-20-Math.sin((armAngle)*Math.PI/180)*28);cx.stroke();
    cx.beginPath();cx.moveTo(12,-20);cx.lineTo(12+Math.cos((armAngle)*Math.PI/180)*28,-20-Math.sin((-armAngle)*Math.PI/180)*28);cx.stroke();
    // Legs
    const legA=dancePhase>0?Math.sin(dancePhase*1.5)*30:Math.sin(Date.now()/300)*20;
    cx.strokeStyle='#1a3a8a';cx.lineWidth=8;
    cx.beginPath();cx.moveTo(-6,0);cx.lineTo(-6+Math.sin(legA*Math.PI/180)*18,28);cx.lineTo(-6+Math.sin(legA*Math.PI/180)*18+8,46);cx.stroke();
    cx.beginPath();cx.moveTo(6,0);cx.lineTo(6-Math.sin(legA*Math.PI/180)*18,28);cx.lineTo(6-Math.sin(legA*Math.PI/180)*18-8,46);cx.stroke();
    cx.restore();
    // Flash text
    if(flashTimer>0){
      flashTimer--;
      cx.fillStyle=`rgba(241,196,15,${flashTimer/40})`;
      cx.font=`bold ${24+flashTimer/2}px Arial`;cx.textAlign='center';
      cx.fillText(lastFlash,350,80);cx.textAlign='left';
    }
    if(gameActive) requestAnimationFrame(draw);
  }
  draw();

  window._jobMgCleanup=()=>{gameActive=false;if(window._bbTimer){clearInterval(window._bbTimer);window._bbTimer=null;}document.removeEventListener('keydown',bbHandler);el.classList.remove('on');el.style.display='none';el.innerHTML='<div id="mg-job-content"></div>';};
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  SIĹOWNIA MINIGAMES
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function startBenchPressMG(weight,equip){
  // equip: 'bench' (Ĺ‚awka) lub 'cable' (wyciÄ…g) â€” rozdzielenie nazw w nagĹ‚Ăłwkach
  const equipName = equip==='cable' ? 'WyciÄ…g' : 'Ĺawka';
  const equipEmoji = equip==='cable' ? 'đźŹ‹â€Ťâ™‚ď¸Ź' : 'đźŹ‹';
  /* v2.1.175: 8s real-time cooldown USUNIÄTY (user: "Nie powinno byc cooldownu miÄ™dzy sesjami na siĹ‚owni"). Daily limit 2 sesje wystarczy. */
  if(!weight){
    const el=document.getElementById('mg-job');
    el.style.display='flex';el.classList.add('on');
    if(!G._gymSets||G._gymSets.day!==G.day) G._gymSets={day:G.day,count:0,cardio:0,strength:0};
    if(typeof G._gymSets.strength!=='number') G._gymSets.strength=0;
    const doneSets=G._gymSets.strength;
    const isProTop=(G.outfit&&G.outfit.top==='sport_pro');
    const maxSets=isProTop?3:2;
    if(doneSets>=maxSets){
      el.innerHTML=`<div style="text-align:center;padding:20px"><div style="font-size:36px;margin-bottom:12px">đź´</div><h2 style="color:#e74c3c">Dzienny limit osiÄ…gniÄ™ty!</h2><p style="color:#aaa">JuĹĽ wyÄ‡wiczyĹ‚eĹ› ${maxSets} sesje siĹ‚owe (Ĺ‚awka/wyciÄ…g) dzisiaj. WrĂłÄ‡ jutro!</p><button onclick="closeMG()" class="cbtn">WyjdĹş</button></div>`;
      return;
    }
    const _forma=G.forma||0;
    const _declineReduce=Math.round(_forma*0.005*100);
    const _gainBoost=Math.round(_forma*0.003*100);
    el.innerHTML=`
      <h2 style="color:#e67e22;font-size:24px;margin-bottom:8px">${equipEmoji} ${equipName} â€” Wybierz ciÄ™ĹĽar</h2>
      <p style="color:#667;font-size:13px;margin-bottom:6px">Spamuj SPACJÄ aby wypeĹ‚niÄ‡ pasek siĹ‚y i wycisnÄ…Ä‡!</p>
      <p style="color:#${doneSets>=maxSets-1?'e74c3c':'27ae60'};font-size:13px;margin-bottom:8px">Sesje siĹ‚y dzisiaj: ${doneSets}/${maxSets}</p>
      <p style="color:#7ec87e;font-size:12px;margin-bottom:8px;background:#0a1f0a;border:1px solid #2a5a2a;border-radius:6px;padding:8px 14px;display:inline-block;text-align:left;line-height:1.5">
        đź’Ş Twoja siĹ‚a (Forma): <strong>${_forma}/100</strong> â†’ spadek mocy <strong>â’${_declineReduce}%</strong>, przyrost na press <strong>+${_gainBoost}%</strong><br>
        <span style="color:#aac">â–¸ WiÄ™kszy ciÄ™ĹĽar = trudniej (spamuj szybciej!) ALE wiÄ™kszy przyrost FORMY</span><br>
        <span style="color:#aac">â–¸ MaĹ‚a siĹ‚a + duĹĽy ciÄ™ĹĽar = ekstremalnie trudno. Trenuj od lekkich!</span><br>
        <span style="color:#aac">â–¸ Ĺawka i wyciÄ…g dajÄ… tylko FORMÄ (na bieĹĽni roĹ›nie kondycja)</span>
      </p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-bottom:20px">
        ${[20,40,60,80,100,120].map(w=>`<button onclick="startBenchPressMG(${w},'${equip||'bench'}')" style="background:#0a200a;border:1px solid #e67e22;color:#e67e22;font-size:18px;font-weight:700;padding:14px 22px;cursor:pointer;border-radius:6px;width:100px;">${w}<br><span style="font-size:11px;color:#a86030">kg</span></button>`).join('')}
      </div>
      <button onclick="closeMG()" style="background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">âś• WyjdĹş</button>
    `;
    window._jobMgCleanup=()=>{el.classList.remove('on');el.style.display='none';el.innerHTML='<div id="mg-job-content"></div>';};
    return;
  }

  // Check daily limit (siĹ‚a osobno od cardio)
  if(!G._gymSets||G._gymSets.day!==G.day) G._gymSets={day:G.day,count:0,cardio:0,strength:0};
  if(typeof G._gymSets.strength!=='number') G._gymSets.strength=0;
  const gymMax=(G.outfit&&G.outfit.top==='sport_pro')?3:2;
  if(G._gymSets.strength>=gymMax){
    notify('đź’Ş Dzienny limit Ĺ‚awki/wyciÄ…gu osiÄ…gniÄ™ty ('+gymMax+' sesje). WrĂłÄ‡ jutro!','r');closeMG();
    return;
  }

  const el=document.getElementById('mg-job');
  el.style.display='flex';el.classList.add('on');
  el.innerHTML='';

  // PROGRESJA: WiÄ™ksza waga = trudniej (mocniejsze opadanie + mniejszy zysk per spacja).
  // WyĹĽsza FORMA gracza = Ĺ‚atwiej. MaĹ‚a forma + duĹĽy ciÄ™ĹĽar = ekstremalnie trudne â€” moĹĽliwa PORAĹ»KA.
  const formaPlayer=G.forma||0;
  // fitFactor: spadek mocy. Max forma 100 â†’ -50% decline. MaĹ‚a forma â†’ peĹ‚ne opadanie.
  const fitFactor=Math.max(0.50, 1 - formaPlayer*0.005);
  // strengthMult: przyrost mocy. Max forma 100 â†’ +30% gain
  const strengthMult=1 + formaPlayer*0.003;
  // PROGRESJA TRUDNOĹšCI ZNACZNIE WIÄKSZA: bazowy decline 50% wyĹĽszy + skalowanie z wagÄ… bardziej agresywne
  // 20kgâ†’0.008, 60kgâ†’0.013, 120kgâ†’0.022 (byĹ‚o 0.006/0.011/0.018)
  const declineRate=(0.005+weight*0.00015)*fitFactor;
  // Przyrost na press WYRAĹąNIE mniejszy â€” gracz MUSI spamowaÄ‡, nie tylko klikaÄ‡
  const gainPerPress=Math.max(0.05, (0.18-weight*0.0010)*strengthMult); // 0.16/0.12/0.06 base (byĹ‚o 0.20/0.16/0.08)
  const repsNeeded=Math.min(8, 4+Math.floor(weight/25)); // 4-8 reps
  const sportBonus=(G.outfit&&G.outfit.top==='sport')?0.01:0;

  let power=0;      // 0-1 power level
  let reps=0;
  let gameActive=true;
  let lifting=false;   // is the bar going up (power >=0.8)
  let justCompleted=false;
  let flashText='';let flashAlpha=0;
  let barH=220; // barbell Y position (220=low, 100=high)
  let screenShake=0;
  // Particles â€” krople potu, iskry przy repie
  const bp_particles=[];
  function bp_emitSweat(x,y){bp_particles.push({x:x+(Math.random()-0.5)*8,y,vx:(Math.random()-0.5)*0.6,vy:0.5+Math.random()*1,life:30+Math.random()*20,max:50,size:1.2+Math.random()*0.8,type:'sweat'});}
  function bp_emitRepSparks(x,y){for(let i=0;i<14;i++){const a=Math.random()*Math.PI*2,sp=2+Math.random()*3;bp_particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-1,life:25+Math.random()*15,max:40,size:1.5+Math.random()*1,type:'spark'});}}

  el.innerHTML=`
    <div style="display:flex;gap:24px;align-items:center;margin-bottom:6px">
      <h2 style="color:#e67e22;font-size:22px;margin:0">${equipEmoji} ${equipName} â€” ${weight}kg</h2>
      <span style="color:#667;font-size:13px">SPAMUJ SPACJÄ aby wycisnÄ…Ä‡!</span>
      <span style="margin-left:auto;color:#aaa">đź’Ş <b id="bp-reps">0</b>/${repsNeeded} powtĂłrzeĹ„</span>
    </div>
    <div style="width:700px;height:18px;background:#0a1a0a;border-radius:9px;overflow:hidden;margin-bottom:8px;position:relative">
      <div id="bp-power" style="height:100%;width:0%;background:linear-gradient(90deg,#c03010,#e67e22,#f1c40f);border-radius:9px;transition:width .05s;"></div>
      <div style="position:absolute;left:80%;top:0;width:2px;height:100%;background:rgba(255,255,255,.4)"></div>
    </div>
    <div style="font-size:12px;color:#667;margin-bottom:8px;text-align:center">Pasek musi przekroczyÄ‡ biaĹ‚Ä… liniÄ™ na kaĹĽdym powtĂłrzeniu Â· Forma: ${formaPlayer}%</div>
    <canvas id="bp-cvs" width="700" height="260" style="border:1px solid #2a1a0a;border-radius:8px;display:block;"></canvas>
    <button onclick="window._jobMgCleanup&&window._jobMgCleanup()" style="margin-top:10px;background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">âś• WyjdĹş</button>
  `;

  const cvs=document.getElementById('bp-cvs');
  const cx=cvs.getContext('2d');

  function cleanup(won){
    gameActive=false;
    if(window._bpKeydown){document.removeEventListener('keydown',window._bpKeydown);window._bpKeydown=null;}
    if(won){
      G._gymSets.strength=(G._gymSets.strength||0)+1;
      G._gymSets.count=(G._gymSets.count||0)+1;
      // Stroje treningowe: sport (+20%) i sport_pro (+25% + dodatkowa seria)
      const isSport=(G.outfit&&G.outfit.top==='sport');
      const isPro=(G.outfit&&G.outfit.top==='sport_pro');
      const energyCost=(isSport||isPro)?10:14; // oba dajÄ… -30% energii
      G.energy=clampStat('energy', G.energy-energyCost);
      // Ĺawka/wyciÄ…g DAJE TYLKO FORMÄ (nie kondycjÄ™). WiÄ™ksze obciÄ…ĹĽenie = wiÄ™kszy przyrost.
      // 20kgâ†’4-7%, 60kgâ†’8-13%, 120kgâ†’14-22%
      const formaBase=Math.round(3+weight*0.08);
      let formaGainBP=formaBase+rnd(0,Math.ceil(weight/25));
      // Bonus stroju: PRO +25%, Sportowy +20%
      const gainMult = isPro ? 1.25 : isSport ? 1.20 : 1.0;
      // F3-FIX-B: SILA skill+PU+evo (max ~+125% przy 5 lvl + PU3 + evo)
      const totalMult = gainMult * getSilaBonus();
      if(totalMult > 1) formaGainBP = Math.round(formaGainBP * totalMult);
      G.forma=Math.min(getMaxStat('forma'),(G.forma||0)+formaGainBP); // F3-FIX-D: respektuje sila/dieta evo
      // v2.1.23: trening spala kalorie z przejedzenia (5 pkt overeat down per session)
      if(G.overeat>0) G.overeat=Math.max(0,G.overeat-5);
      // Mechanika "use it or lose it" â€” zapisz dzien ostatniej sesji silowni (reset cyklu Gym Bro)
      G._lastGymDay = G.day;
      // Cinematic milestone â€” pierwsze osiagniecie 100 formy (lub powrot do 100 = comeback)
      if(typeof checkFormaComeback === 'function') checkFormaComeback();
      if(G.forma>=100 && typeof showMilestoneCinematic==='function' && typeof _milestoneShown==='function' && !_milestoneShown('forma100')){
        showMilestoneCinematic({
          emoji:'đź’Ş', title:'SZCZYT FORMY', subtitle:'Twoja sila osiagnela maksimum',
          tagline:'+10 do maksymalnego zdrowia, energii i glodu',
          accentColor:'#e67e22', accent2:'#c0392b', duration:5000
        });
      }
      const xpGain=8+Math.floor(weight/10);
      addXP(xpGain);
      G.streetRep=clamp((G.streetRep||0)+2,0,100);
      progressQuest('gym');if(typeof _trackGym==='function')_trackGym();
      const bonusLabel = isPro ? ' đźĄ‹(PRO +25%)' : isSport ? ' đźŹ‹(sportowy +20%)' : '';
      const sesjaMax = isPro ? 3 : 2;
      notify(`đź’Ş ${reps} powtĂłrzeĹ„ Ă— ${weight}kg! +${formaGainBP}% forma${bonusLabel}, +${xpGain} XP. Sesja siĹ‚y ${G._gymSets.strength}/${sesjaMax}`);
      updateHUD();
    }
    el.style.display='none';el.classList.remove('on');el.innerHTML='<div id="mg-job-content"></div>';
  }

  window._bpKeydown=(e)=>{
    if(e.code!=='Space'||!gameActive)return;
    e.preventDefault();
    power=Math.min(1,power+(gainPerPress+sportBonus));
    // if power crosses 0.8, lifting = true
    if(power>=0.8&&!lifting){lifting=true;}
  };
  document.addEventListener('keydown',window._bpKeydown);

  let lastTime=performance.now();
  function draw(now){
    if(!gameActive&&el.style.display==='none')return;
    const dt=Math.min((now-lastTime)/16,3);lastTime=now;

    // Decline power over time
    if(!lifting){
      power=Math.max(0,power-declineRate*fitFactor*dt);
    } else {
      // When lifting: bar goes up, then comes down â€” count rep
      barH=Math.max(100,barH-6*dt);
      if(barH<=100){
        // Rep complete
        reps++;lifting=false;power=0.2;barH=220;
        flashText=`REP ${reps}!`;flashAlpha=1;
        bp_emitRepSparks(350,110);
        screenShake=8+weight/15;
        sfxRep();
        const re=document.getElementById('bp-reps');if(re)re.textContent=reps;
        if(reps>=repsNeeded){
          gameActive=false;
          cx.fillStyle='rgba(0,0,0,.8)';cx.fillRect(0,0,700,260);
          cx.fillStyle='#27ae60';cx.font='bold 30px Arial';cx.textAlign='center';
          cx.fillText(`đź’Ş ${reps} powtĂłrzeĹ„ ukoĹ„czone!`,350,120);
          cx.fillStyle='#f1c40f';cx.font='20px Arial';
          cx.fillText(`${weight}kg Ă— ${reps} reps`,350,160);cx.textAlign='left';
          window._bpSessionToken=(window._bpSessionToken||0)+1;const _bpTok=window._bpSessionToken;setTimeout(()=>{if(window._bpSessionToken===_bpTok)cleanup(true);},2200);return;
        }
      }
    }
    // When power drops from lifting zone back to 0.8 without completing, reset
    if(lifting&&barH===220&&power<0.8){lifting=false;}

    // Update power bar
    const pb=document.getElementById('bp-power');
    if(pb)pb.style.width=(power*100)+'%';

    // Screen shake
    let shx=0,shy=0;
    if(screenShake>0){shx=(Math.random()-0.5)*screenShake;shy=(Math.random()-0.5)*screenShake;screenShake=Math.max(0,screenShake-0.6*dt);}
    cx.save();cx.translate(shx,shy);
    // Draw
    cx.fillStyle='#0a0804';cx.fillRect(0,0,700,260);
    // Gym background
    cx.fillStyle='#181008';cx.fillRect(0,0,700,260);
    // Walls with texture
    cx.fillStyle='#101008';cx.fillRect(0,0,700,140);
    for(let i=0;i<5;i++){cx.fillStyle='rgba(40,30,10,.3)';cx.fillRect(i*140,0,140,140);}
    // Floor
    cx.fillStyle='#181818';cx.fillRect(0,200,700,60);
    cx.fillStyle='#222';cx.fillRect(0,200,700,4);

    // Pozycja srodka postaci (dla bp_emitSweat â€” uzywane PO if/else, musi byc w outer scope)
    let lx = 350, ly = 200;
    if(equip==='cable'){
      // === WYCIÄ„G GĂ“RNY (lat pulldown) ===
      // Maszyna â€” pionowa konstrukcja z blokiem na gĂłrze + stos obciÄ…ĹĽeĹ„ po prawej
      // WieĹĽa metalowa
      cx.fillStyle='#3a3a44';cx.fillRect(150,90,16,160);
      cx.fillStyle='#5a5a65';cx.fillRect(152,90,4,160); // highlight
      cx.fillStyle='#3a3a44';cx.fillRect(534,90,16,160);
      cx.fillStyle='#5a5a65';cx.fillRect(536,90,4,160);
      // Belka pozioma na gĂłrze
      cx.fillStyle='#2a2a30';cx.fillRect(150,90,400,12);
      cx.fillStyle='#4a4a55';cx.fillRect(150,90,400,3); // highlight gĂłrny
      // Logo
      cx.fillStyle='#e67e22';cx.font='bold 10px Arial';cx.textAlign='center';
      cx.fillText('CABLE PRO',350,99);cx.textAlign='left';
      // Bloczek na gĂłrze (krÄ…ĹĽek)
      cx.fillStyle='#1a1a22';cx.beginPath();cx.arc(350,108,8,0,Math.PI*2);cx.fill();
      cx.fillStyle='#5a5a65';cx.beginPath();cx.arc(350,108,5,0,Math.PI*2);cx.fill();
      cx.fillStyle='#0a0a0e';cx.beginPath();cx.arc(350,108,2,0,Math.PI*2);cx.fill();

      // === STOS OBCIÄ„Ĺ»EĹ (po prawej) â€” animowany ===
      // Stos jest "zaczepiony" do liny przez sworzeĹ„. Im bliĹĽej lifting, tym wyĹĽej stos siÄ™ unosi.
      const stackBase=240;
      const liftAmount=Math.max(0,power-0.3)*60; // stos podnosi siÄ™ gdy power > 0.3
      const stackY=stackBase-liftAmount;
      // Rama stosu (po prawej)
      cx.fillStyle='#2a2a30';cx.fillRect(560,110,30,140);
      cx.strokeStyle='#1a1a22';cx.lineWidth=2;cx.strokeRect(560,110,30,140);
      // PĹ‚yty obciÄ…ĹĽeĹ„ â€” kazda 10kg, dynamiczna liczba (do 12 plyt = 120kg)
      const totalPlates=Math.ceil(weight/10);
      const liftedPlates=totalPlates; // wszystkie sa zlote (gracz wybral wage)
      const plateH=10, plateGap=2; // 12 plyt * 12px = 144px (rama 140px â€” minimalna nadwyzka OK)
      for(let i=0;i<totalPlates;i++){
        const py=stackBase-plateH-i*(plateH+plateGap);
        const isLifted=i<liftedPlates;
        const yPos=isLifted?(py-liftAmount):py;
        cx.fillStyle=isLifted?'#c8a520':'#5a5a55';
        cx.fillRect(563,yPos,24,plateH);
        cx.fillStyle='rgba(255,255,255,.2)';cx.fillRect(563,yPos,24,2);
        cx.fillStyle='rgba(0,0,0,.3)';cx.fillRect(563,yPos+plateH-2,24,2);
        // SworzeĹ„ (Ĺ›rodek)
        cx.fillStyle='#1a1a1a';cx.fillRect(573,yPos+plateH/2-2,4,4);
      }
      // Etykieta z aktualnym ciÄ™ĹĽarem â€” przesuniÄ™ta WYĹ»EJ nad ramÄ™ stosu (poprzednio y=108 nakĹ‚adaĹ‚a siÄ™ na gĂłrnÄ… pĹ‚ytÄ™)
      cx.fillStyle='#f1c40f';cx.font='bold 12px Arial';cx.textAlign='center';
      cx.fillText(`${weight}kg`,575,82);cx.textAlign='left';

      // === LINKA ===
      // Od bloku gĂłrnego do drÄ…ĹĽka (przez prawÄ… stronÄ™ â†’ stos obciÄ…ĹĽeĹ„)
      const handleY=180+Math.round((1-power)*40); // im wyĹĽszy power, tym wyĹĽej drÄ…ĹĽek
      cx.strokeStyle='#1a1a22';cx.lineWidth=2;
      // Pionowa od bloku do drÄ…ĹĽka
      cx.beginPath();cx.moveTo(350,116);cx.lineTo(350,handleY);cx.stroke();
      // Pozioma po belce do prawej krawÄ™dzi
      cx.beginPath();cx.moveTo(350,108);cx.lineTo(550,108);cx.stroke();
      // Pionowa w dĂłĹ‚ do stosu obciÄ…ĹĽeĹ„
      cx.beginPath();cx.moveTo(550,108);cx.lineTo(550,stackY);cx.stroke();
      // KarabiĹ„czyk na drÄ…ĹĽku
      cx.fillStyle='#5a5a65';cx.fillRect(348,handleY-2,4,6);

      // === DRÄ„Ĺ»EK PULL-DOWN ===
      cx.fillStyle='#aaa';cx.fillRect(280,handleY,140,8);
      // KoĹ„cĂłwki gumowe (uchwyty)
      cx.fillStyle='#1a1a1a';cx.fillRect(275,handleY-3,10,14);
      cx.fillStyle='#1a1a1a';cx.fillRect(415,handleY-3,10,14);
      cx.fillStyle='#3a3a3a';cx.fillRect(275,handleY-3,10,2);
      cx.fillStyle='#3a3a3a';cx.fillRect(415,handleY-3,10,2);

      // === ĹAWECZKA SIEDZÄ„CA POD WYCIÄ„GIEM ===
      cx.fillStyle='#3a1a08';cx.fillRect(310,235,80,12);
      cx.fillStyle='#5a2810';cx.fillRect(310,235,80,3);
      cx.fillStyle='#2a1008';cx.fillRect(312,247,8,15);cx.fillRect(380,247,8,15);
      // PodpĂłrki na nogi/uda
      cx.fillStyle='#2a1008';cx.fillRect(305,225,10,18);cx.fillRect(385,225,10,18);

      // === POSTAÄ† â€” siedzÄ…ca, ciÄ…gnie drÄ…ĹĽek w dĂłĹ‚ ===
      lx=350; ly=232;
      // TuĹ‚Ăłw
      cx.fillStyle='#3498db';cx.fillRect(lx-14,ly-30,28,28);
      // Biceps highlight
      cx.fillStyle='rgba(255,255,255,.15)';cx.fillRect(lx-12,ly-28,4,12);cx.fillRect(lx+8,ly-28,4,12);
      // GĹ‚owa
      cx.fillStyle='#e0a860';cx.beginPath();cx.arc(lx,ly-44,13,0,Math.PI*2);cx.fill();
      // WĹ‚osy â€” krĂłtkie
      cx.fillStyle='#3a2a18';cx.beginPath();cx.arc(lx,ly-44,13,Math.PI*1.1,Math.PI*1.9);cx.fill();
      // Twarz â€” straining gdy ciÄ…gnie
      if(power>0.6){
        cx.fillStyle='rgba(0,0,0,.85)';
        cx.fillRect(lx-5,ly-44,3,3);cx.fillRect(lx+2,ly-44,3,3);
        // Otwarte usta (efekt wysiĹ‚ku)
        cx.fillStyle='#5a1a1a';cx.fillRect(lx-3,ly-37,6,2);
      } else {
        cx.fillStyle='rgba(0,0,0,.75)';
        cx.fillRect(lx-5,ly-43,3,3);cx.fillRect(lx+2,ly-43,3,3);
      }
      // RÄ™ce â€” ciÄ…gnÄ… drÄ…ĹĽek z gĂłry w dĂłĹ‚
      // Pozycja rÄ…k zaleĹĽna od position drÄ…ĹĽka (handleY) i power
      const armPullDown=power; // 0=rÄ™ce wysoko, 1=rÄ™ce na barki
      const handPos={l:{x:lx-35,y:handleY+4},r:{x:lx+35,y:handleY+4}};
      // Ramiona (od barkĂłw do Ĺ‚okci)
      cx.strokeStyle='#3498db';cx.lineWidth=8;cx.lineCap='round';
      const elbowL={x:lx-30,y:ly-24+armPullDown*10};
      const elbowR={x:lx+30,y:ly-24+armPullDown*10};
      cx.beginPath();cx.moveTo(lx-13,ly-26);cx.lineTo(elbowL.x,elbowL.y);cx.stroke();
      cx.beginPath();cx.moveTo(lx+13,ly-26);cx.lineTo(elbowR.x,elbowR.y);cx.stroke();
      // Przedramiona (od Ĺ‚okci do dĹ‚oni na drÄ…ĹĽku)
      cx.beginPath();cx.moveTo(elbowL.x,elbowL.y);cx.lineTo(handPos.l.x,handPos.l.y);cx.stroke();
      cx.beginPath();cx.moveTo(elbowR.x,elbowR.y);cx.lineTo(handPos.r.x,handPos.r.y);cx.stroke();
      // DĹ‚onie chwyciĹ‚y drÄ…ĹĽek
      cx.fillStyle='#e0a860';
      cx.beginPath();cx.arc(handPos.l.x,handPos.l.y,4,0,Math.PI*2);cx.fill();
      cx.beginPath();cx.arc(handPos.r.x,handPos.r.y,4,0,Math.PI*2);cx.fill();
      // Nogi (siedzi z kolanami zgiÄ™tymi pod Ĺ‚aweczkÄ…)
      cx.fillStyle='#1a3a8a';cx.fillRect(lx-12,ly-2,10,30);cx.fillRect(lx+2,ly-2,10,30);
      // Buty
      cx.fillStyle='#0a0a0a';cx.fillRect(lx-15,ly+26,12,5);cx.fillRect(lx+3,ly+26,12,5);

      // Weight text na pasku mocy (gĂłra ekranu juĹĽ ma)
    } else {
      // === ĹAWKA (bench press) ===
      // Bench
      cx.fillStyle='#3a1a08';cx.fillRect(220,190,260,20);
      cx.fillStyle='#5a2810';cx.fillRect(260,210,180,12);
      cx.fillStyle='#2a1008';cx.fillRect(230,210,14,40);cx.fillRect(456,210,14,40);
      // Barbell bar
      const bbH=barH;
      cx.fillStyle='#aaa';cx.fillRect(120,bbH,460,10);
      cx.fillStyle='#555';cx.fillRect(118,bbH-4,18,18);cx.fillRect(564,bbH-4,18,18);
      const plateCount=Math.ceil(weight/20);
      for(let i=0;i<Math.min(plateCount,5);i++){
        const pw=8+i*2;const ph=20+Math.min(i,3)*8;
        const pc=`hsl(${i*30+200},60%,${40+i*5}%)`;
        cx.fillStyle=pc;cx.fillRect(136+i*pw,bbH-ph/2+5,pw,ph);
        cx.fillStyle=pc;cx.fillRect(566-i*pw-pw,bbH-ph/2+5,pw,ph);
      }
      cx.fillStyle='#f1c40f';cx.font='bold 13px Arial';cx.textAlign='center';
      cx.fillText(`${weight}kg`,350,bbH+9);cx.textAlign='left';
      // Lifter body
      lx=350; ly=185;
      cx.fillStyle='#e0a860';cx.beginPath();cx.arc(lx,ly-30,14,0,Math.PI*2);cx.fill();
      cx.fillStyle='#3498db';cx.fillRect(lx-13,ly-16,26,36);
      if(power>0.7){
        cx.fillStyle='rgba(0,0,0,.8)';cx.fillRect(lx-6,ly-28,5,5);cx.fillRect(lx+1,ly-28,5,5);
        cx.strokeStyle='rgba(0,0,0,.8)';cx.lineWidth=2;cx.beginPath();cx.arc(lx,ly-20,4,0,Math.PI);cx.stroke();
      } else {
        cx.fillStyle='rgba(0,0,0,.7)';cx.fillRect(lx-6,ly-27,5,4);cx.fillRect(lx+1,ly-27,5,4);
      }
      const armStretch=lifting?0.8:power;
      const armY=ly-16+Math.round((1-armStretch)*20);
      cx.strokeStyle=`hsl(${120*armStretch},60%,40%)`;cx.lineWidth=7;
      cx.beginPath();cx.moveTo(lx-13,ly-8);cx.lineTo(lx-18,armY);cx.lineTo(lx-15,bbH+10);cx.stroke();
      cx.beginPath();cx.moveTo(lx+13,ly-8);cx.lineTo(lx+18,armY);cx.lineTo(lx+15,bbH+10);cx.stroke();
      cx.fillStyle='#1a3a8a';cx.fillRect(lx-12,ly+20,24,22);
      cx.fillStyle='#0a0a0a';cx.fillRect(lx-14,ly+40,13,8);cx.fillRect(lx+2,ly+40,13,8);
    }

    // Power bar glow when high
    if(power>0.7){
      cx.fillStyle=`rgba(241,196,15,${(power-0.7)*0.3})`;cx.fillRect(0,0,700,260);
    }
    // Flash text
    if(flashAlpha>0){
      flashAlpha-=0.03*dt;
      cx.globalAlpha=flashAlpha;
      cx.fillStyle='#f1c40f';cx.font=`bold ${30+flashAlpha*10}px Arial`;cx.textAlign='center';
      cx.shadowColor='#e67e22';cx.shadowBlur=15;
      cx.fillText(flashText,350,70);
      cx.shadowBlur=0;cx.textAlign='left';cx.globalAlpha=1;
    }
    // Krople potu â€” emit gdy power > 0.5 lub lifting
    if((power>0.5||lifting)&&Math.random()<0.18+power*0.3){bp_emitSweat(lx,ly-40);}
    // Update + render particles
    for(let i=bp_particles.length-1;i>=0;i--){
      const p=bp_particles[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.type==='sweat'){p.vy+=0.12;}
      else if(p.type==='spark'){p.vy+=0.2;p.vx*=0.985;}
      p.life--;
      const a=Math.max(0,p.life/p.max);
      if(p.type==='sweat'){
        cx.fillStyle=`rgba(150,200,255,${a*0.85})`;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.fill();
        cx.fillStyle=`rgba(255,255,255,${a*0.5})`;
        cx.beginPath();cx.arc(p.x-p.size*0.3,p.y-p.size*0.3,p.size*0.3,0,Math.PI*2);cx.fill();
      } else if(p.type==='spark'){
        cx.shadowBlur=6;cx.shadowColor='#f1c40f';
        cx.fillStyle=`rgba(255,220,80,${a})`;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.fill();
        cx.shadowBlur=0;
      }
      if(p.life<=0||p.y>270)bp_particles.splice(i,1);
    }
    cx.restore();
    // Hint
    cx.fillStyle=`rgba(40,220,100,${0.5+Math.sin(now/400)*0.5})`;
    cx.font='bold 16px Arial';cx.textAlign='center';
    cx.fillText('SPACJA',350,248);cx.textAlign='left';

    if(gameActive||flashAlpha>0) requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);

  window._jobMgCleanup=()=>{
    gameActive=false;
    if(window._bpKeydown){document.removeEventListener('keydown',window._bpKeydown);window._bpKeydown=null;}
    el.classList.remove('on');el.style.display='none';el.innerHTML='<div id="mg-job-content"></div>';
  };
}

function startTreadmillMG(speed){
  /* v2.1.175: 8s real-time cooldown USUNIÄTY â€” user feedback. */
  if(!G._gymSets||G._gymSets.day!==G.day) G._gymSets={day:G.day,count:0,cardio:0,strength:0};
  if(!speed){
    const el=document.getElementById('mg-job');
    el.style.display='flex';el.classList.add('on');
    const cardioMax=(G.outfit&&G.outfit.top==='sport_pro')?3:2;
    if((G._gymSets.cardio||0)>=cardioMax){
      el.innerHTML=`<div style="text-align:center;padding:20px"><div style="font-size:36px;margin-bottom:12px">đź´</div><h2 style="color:#e74c3c">Dzienny limit osiÄ…gniÄ™ty!</h2><p style="color:#aaa">JuĹĽ wyÄ‡wiczyĹ‚eĹ› ${cardioMax} sesje cardio (bieĹĽnia) dzisiaj. WrĂłÄ‡ jutro!</p><button onclick="closeMG()" class="cbtn">WyjdĹş</button></div>`;
      return;
    }
    const _fit=G.fitness||0;
    const _drainRed=Math.round(_fit*0.04*10)/10;
    const _gainBoost=Math.round(_fit*0.003*100);
    el.innerHTML=`
      <h2 style="color:#3498db;font-size:24px;margin-bottom:10px">đźŹ BieĹĽnia â€” Wybierz tempo</h2>
      <p style="color:#667;font-size:14px;margin-bottom:6px">Szybsze tempo = trudniej, ale wiÄ™kszy przyrost KONDYCJI</p>
      <p style="color:#${(G._gymSets.cardio||0)>=cardioMax-1?'e74c3c':'3498db'};font-size:13px;margin-bottom:8px">Sesje cardio dzisiaj: ${G._gymSets.cardio||0}/${cardioMax}</p>
      <p style="color:#00bcd4;font-size:12px;margin-bottom:8px">Kondycja: ${_fit}/100 â†’ PrÄ™dkoĹ›Ä‡: ${(2.0+_fit/100*0.5).toFixed(2)} (z drzewka kondycji max +0.3 â†’ top 2.8)</p>
      <p style="color:#7ec87e;font-size:12px;margin-bottom:16px;background:#0a1f0a;border:1px solid #2a5a2a;border-radius:6px;padding:8px 14px;display:inline-block;text-align:left;line-height:1.5">
        đźŹ Twoja kondycja: <strong>${_fit}/100</strong> â†’ spadek staminy <strong>â’${_drainRed}/s</strong>, przyrost <strong>+${_gainBoost}%</strong><br>
        <span style="color:#aac">â–¸ WiÄ™ksze tempo = trudniej (spamuj szybciej!) ALE wiÄ™kszy przyrost KONDYCJI</span><br>
        <span style="color:#aac">â–¸ MaĹ‚a kondycja + sprint = ekstremalnie trudno</span><br>
        <span style="color:#aac">â–¸ BieĹĽnia daje tylko KONDYCJÄ (na Ĺ‚awce/wyciÄ…gu roĹ›nie forma)</span>
      </p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-bottom:20px">
        ${[{n:'Spacer',v:1,kmh:'~5'},{n:'Trucht',v:2,kmh:'~9'},{n:'Bieg',v:3,kmh:'~14'},{n:'Sprint',v:4,kmh:'~18'}].map(s=>`<button onclick="startTreadmillMG(${s.v})" style="background:#0a0a20;border:1px solid #3498db;color:#3498db;font-size:16px;font-weight:700;padding:16px 20px;cursor:pointer;border-radius:6px;width:120px;">${s.n}<br><span style='font-size:12px;color:#556'>${s.kmh} km/h</span></button>`).join('')}
      </div>
      <button onclick="closeMG()" style="background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">âś• WyjdĹş</button>
    `;
    window._jobMgCleanup=()=>{el.classList.remove('on');el.style.display='none';el.innerHTML='<div id="mg-job-content"></div>';};
    return;
  }
  // Check daily limit before starting (cardio osobno od strength) â€” sport_pro daje +1 sesja
  const _cardioMax=(G.outfit&&G.outfit.top==='sport_pro')?3:2;
  if((G._gymSets.cardio||0)>=_cardioMax){
    notify(`đźŹ Dzienny limit bieĹĽni osiÄ…gniÄ™ty (${_cardioMax} sesje). WrĂłÄ‡ jutro!`,'r');closeMG();return;
  }

  const el=document.getElementById('mg-job');
  el.style.display='flex';el.classList.add('on');
  el.innerHTML='';

  // INVERTED mechanic: stamina bar starts full and FALLS. Spam SPACE to hold it up. Reach 0 = fail.
  // WiÄ™ksze tempo = wiÄ™kszy drain, mniejszy gain. WyĹĽsza kondycja gracza = Ĺ‚atwiej.
  // BieĹĽnia: 15 sekund (skrĂłcone z 45) â€” krĂłtsza ale intensywniejsza
  let gameActive=true,timeLeft=15,spaceDown=false,stamina=100;
  const fitness=G.fitness||0;
  const fitBonus=Math.floor(fitness/10);
  const sportBonus=(G.outfit&&G.outfit.top==='sport')?2:0;
  const speedNames=['','Spacer','Trucht','Bieg','Sprint'];
  // Fitness 100 â†’ drain reduction (mniejszy bonus ĹĽeby byĹ‚o trudniej dla 0 kondycji)
  const drainReduction=fitness*0.04;
  const staminaMult=1+fitness*0.003;
  // v2.1.175 PROGRESJA TRUDNOĹšCI REBALANS: user "spacer/trucht/bieg za Ĺ‚atwe vs Sprint".
  // drainPerSec rozszerzony za duĹĽej za niskie prÄ™dkoĹ›ci â€” wszystkie wymagajÄ… realnego wysiĹ‚ku.
  // Spacer 20 / Trucht 28 / Bieg 36 / Sprint 44 (przed: 18/25/32/39).
  const drainPerSec=Math.max(10, 12+speed*8-drainReduction);
  // gainPerPress mniej forgiving na wolniejszych â€” gracz musi spamowaÄ‡ zawsze.
  // Spacer 6.5 / Trucht 5.0 / Bieg 3.5 / Sprint 2.0 (przed: 8.2/6.4/4.6/2.8)
  const gainPerPress=Math.max(2.0, (8-speed*1.5)*staminaMult);

  const title=document.createElement('div');
  title.innerHTML=`<h2 style="color:#3498db;font-size:22px;margin-bottom:6px">đźŹ BieĹĽnia â€” ${speedNames[speed]}</h2><div style="color:#667;font-size:13px;margin-bottom:10px">Pasek opada! Wciskaj SPACJÄ aby utrzymaÄ‡ tempo â€” nie pozwĂłl mu spaĹ›Ä‡ do zera!</div>`;
  el.appendChild(title);

  const info=document.createElement('div');
  info.style.cssText='display:flex;gap:30px;margin-bottom:10px;font-size:16px;color:#aaa;';
  info.innerHTML=`<span>âŹ± <b id="tm-time">${timeLeft}</b>s</span><span>đź’¨ Stamina: <b id="tm-stam">100</b>%</span>`;
  el.appendChild(info);

  const cvs=document.createElement('canvas');
  cvs.width=700;cvs.height=260;
  cvs.style.cssText='border:1px solid #0a1a3a;border-radius:8px;display:block;';
  el.appendChild(cvs);
  const cx=cvs.getContext('2d');

  const barWrap=document.createElement('div');
  barWrap.style.cssText='width:700px;height:20px;background:#0a0a1a;border-radius:10px;margin-top:8px;overflow:hidden;';
  barWrap.innerHTML='<div id="tm-stambar" style="height:100%;width:100%;background:linear-gradient(90deg,#e74c3c,#f39c12,#27ae60);border-radius:10px;transition:width .08s;"></div>';
  el.appendChild(barWrap);

  const exitBtn=document.createElement('button');
  exitBtn.textContent='âś• WyjdĹş';
  exitBtn.style.cssText='margin-top:12px;background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;';
  exitBtn.onclick=()=>{gameActive=false;cleanup(false);};
  el.appendChild(exitBtn);

  function cleanup(won){
    gameActive=false;
    if(window._tmTimer){clearInterval(window._tmTimer);window._tmTimer=null;}
    if(window._tmKeydown){document.removeEventListener('keydown',window._tmKeydown);window._tmKeydown=null;}
    if(window._tmKeyup){document.removeEventListener('keyup',window._tmKeyup);window._tmKeyup=null;}
    el.style.display='none';el.classList.remove('on');el.innerHTML='';
    if(won){
      if(!G._gymSets||G._gymSets.day!==G.day) G._gymSets={day:G.day,count:0,cardio:0,strength:0};
      G._gymSets.count=(G._gymSets.count||0)+1;G._gymSets.cardio=(G._gymSets.cardio||0)+1;
      // Stroje treningowe: sport (+20%) i sport_pro (+25% + dodatkowa seria)
      const isSport=(G.outfit&&G.outfit.top==='sport');
      const isPro=(G.outfit&&G.outfit.top==='sport_pro');
      const energyCost=(isSport||isPro)?8:12;
      G.energy=clampStat('energy', G.energy-energyCost);
      G.stress=clamp(G.stress+12,0,100);
      // BieĹĽnia DAJE TYLKO KONDYCJÄ (G.fitness). WiÄ™ksze tempo = wiÄ™kszy przyrost.
      // Spacer x1â†’3-5, Trucht x2â†’5-8, Bieg x3â†’8-12, Sprint x4â†’12-18
      let fitGain=2+speed*2+rnd(0,Math.ceil(speed*1.5));
      // Bonus stroju: PRO +25%, Sportowy +20%
      const gainMult = isPro ? 1.25 : isSport ? 1.20 : 1.0;
      if(gainMult > 1) fitGain = Math.round(fitGain * gainMult);
      /* v2.1.104: Wave 7 K69 â€” Treadmill aplikuje skill BIEG (wczeĹ›niej tylko outfit liczyĹ‚ siÄ™, skill bieg byĹ‚ ignorowany w gym mimo ĹĽe bench uĹĽywa getSilaBonus).
         UĹĽywam getBiegSpeedBonus() (1 + skĂ—0.05 + puĂ—0.10 + evoĂ—0.20) â€” max ~1.65Ă— przy max bieg + PU3 + Maraton evo. */
      const biegMult = typeof getBiegSpeedBonus==='function' ? getBiegSpeedBonus() : 1;
      if(biegMult > 1) fitGain = Math.round(fitGain * biegMult);
      G.fitness=Math.min((G.fitness||0)+fitGain,getMaxStat('fitness')); /* v2.1.193: getMaxStat zawsze 100 â€” Evo Dieta/Bieg +max usuniÄ™te jako ghost (user feedback "115 nie istnieje"). Math.min zachowany dla bezpieczeĹ„stwa nawet gdy cap pewny. */
      // v2.1.23: bieĹĽnia spala kalorie szybciej â€” 8 pkt overeat down per session (kardio > siĹ‚owe)
      if(G.overeat>0) G.overeat=Math.max(0,G.overeat-8);
      // Mechanika "use it or lose it" â€” zapisz dzien ostatniej sesji silowni (reset cyklu Gym Bro)
      G._lastGymDay = G.day;
      // Cinematic milestone â€” pierwsze osiagniecie 100 kondycji (lub powrot do 100 = comeback)
      if(typeof checkFitnessComeback === 'function') checkFitnessComeback();
      if(G.fitness>=100 && typeof showMilestoneCinematic==='function' && typeof _milestoneShown==='function' && !_milestoneShown('fitness100')){
        showMilestoneCinematic({
          emoji:'đźŹ', title:'PELNA KONDYCJA', subtitle:'Twoja wytrzymalosc osiagnela maksimum',
          tagline:'+10 do maksymalnego zdrowia, energii i glodu',
          accentColor:'#00bcd4', accent2:'#3498db', duration:5000
        });
      }
      const xpGain=8+speed*3;
      addXP(xpGain);
      progressQuest('gym');if(typeof _trackGym==='function')_trackGym();
      /* v2.1.195: fitness 0.30â†’0.38, skill bieg max 3 */
      const _skBgM=Math.min(3,(typeof _sk==='function')?_sk('bieg'):0);
      const _puBgM=(typeof _pu==='function')?_pu('bieg'):0;
      const _evoBgM=(typeof _evo==='function')?_evo('bieg'):0;
      const _kondLvlM=(G.skills&&getSkillLvl('kondycja'))||0;
      const newSpd=(2.0+(G.fitness||0)/100*0.38+Math.min(5,_kondLvlM)*0.04+_skBgM*0.04+_puBgM*0.10+_evoBgM*0.30).toFixed(2);
      const bonusLabel = isPro ? ' đźĄ‹(PRO +25%)' : isSport ? ' đźŹ‹(sportowy +20%)' : '';
      const cardioMax2 = isPro ? 3 : 2;
      notify(`đźŹ BieĹĽnia (${speedNames[speed]}) zakoĹ„czona! +${fitGain} kondycja${bonusLabel} â†’ ${Math.floor(G.fitness||0)}/${typeof getMaxStat==='function'?getMaxStat('fitness'):100}, prÄ™dkoĹ›Ä‡ ${newSpd}, +${xpGain} XP. Sesja cardio ${G._gymSets.cardio}/${cardioMax2}`);
      updateHUD();
    } else {
      notify('đź®â€Ťđź’¨ BieĹĽnia â€” zabrakĹ‚o siĹ‚! Wciskaj SPACJÄ szybciej.');
    }
  }

  window._tmKeydown=(e)=>{
    if(e.code==='Space'&&gameActive&&!spaceDown){
      spaceDown=true;e.preventDefault();
      stamina=Math.min(100,stamina+gainPerPress);
      const sb=document.getElementById('tm-stambar');if(sb)sb.style.width=stamina+'%';
      const st=document.getElementById('tm-stam');if(st)st.textContent=Math.round(stamina);
    }
  };
  window._tmKeyup=(e)=>{if(e.code==='Space')spaceDown=false;};
  document.addEventListener('keydown',window._tmKeydown);
  document.addEventListener('keyup',window._tmKeyup);

  window._tmTimer=setInterval(()=>{
    if(!gameActive)return;
    timeLeft--;
    const te=document.getElementById('tm-time');if(te)te.textContent=timeLeft;
    if(timeLeft<=0&&gameActive){gameActive=false;cleanup(true);}
  },1000);

  let bgX=0,legPhase=0,lastDrainTime=performance.now();
  // Track press tempo â€” ostatnie czasy spacji dla obliczenia BPM/tempa
  let pressTimes=[]; // ostatnie wciĹ›niÄ™cia
  let actualSpeed=0; // 0-4+ â€” rzeczywista prÄ™dkoĹ›Ä‡ biegu na podstawie tempa
  // Override _tmKeydown ĹĽeby trackowaÄ‡ pressTimes
  const origKd=window._tmKeydown;
  window._tmKeydown=(e)=>{
    if(e.code==='Space'&&gameActive&&!spaceDown){
      pressTimes.push(performance.now());
      // zostaw tylko ostatnie 2 sekundy
      const now=performance.now();
      pressTimes=pressTimes.filter(t=>now-t<2000);
    }
    if(origKd) origKd(e);
  };
  document.removeEventListener('keydown',origKd);
  document.addEventListener('keydown',window._tmKeydown);
  function draw(now){
    if(!gameActive&&el.style.display==='none')return;
    const dt=Math.min((now-lastDrainTime)/1000,0.1);lastDrainTime=now;
    if(gameActive){
      stamina=Math.max(0,stamina-drainPerSec*dt);
      const sb=document.getElementById('tm-stambar');if(sb)sb.style.width=stamina+'%';
      const st=document.getElementById('tm-stam');if(st)st.textContent=Math.round(stamina);
      if(stamina<=0){if(window._tmTimer){clearInterval(window._tmTimer);window._tmTimer=null;}cleanup(false);return;}
    }
    // Oblicz tempo presses/sek z ostatnich 2s
    pressTimes=pressTimes.filter(t=>now-t<2000);
    const pps=pressTimes.length/2; // presses per second
    // Target speed: spacer=1 wymaga ~1pps, sprint=4 wymaga ~4pps
    // pps 0 â†’ speed 0.2 (postaÄ‡ stoi/chodzi b. wolno)
    // pps speed*1 (cel) â†’ speed = speed (target tempo)
    // pps wyĹĽsze â†’ speed > target
    const targetSpeed=Math.min(speed*1.5, pps*0.9+0.3);
    actualSpeed+=(targetSpeed-actualSpeed)*0.08; // smooth lerp
    if(stamina<=0) actualSpeed*=0.95;

    // === TĹO ===
    cx.fillStyle='#0a0e18';cx.fillRect(0,0,700,260);
    // Subtelne tĹ‚o "siĹ‚ownia"
    cx.fillStyle='rgba(255,255,255,.02)';
    for(let i=0;i<8;i++) cx.fillRect(0,i*32,700,1);

    const staminaRatio=stamina/100;

    // === BIEĹ»NIA ===
    // Tylna podstawka (wsporniki silnika)
    cx.fillStyle='#1a1a22';cx.fillRect(80,205,540,30);
    cx.fillStyle='#2a2a35';cx.fillRect(85,210,530,2);
    // Konsola sterujÄ…ca u gĂłry (LCD displej + przyciski)
    cx.fillStyle='#2a2a35';cx.fillRect(220,55,260,42);
    cx.strokeStyle='#1a1a22';cx.lineWidth=2;cx.strokeRect(220,55,260,42);
    // LCD wyĹ›wietlacz
    cx.fillStyle='#0a1a0a';cx.fillRect(245,62,210,28);
    cx.strokeStyle='#3a3a40';cx.lineWidth=1;cx.strokeRect(245,62,210,28);
    // LCD wyĹ›wietla prÄ™dkoĹ›Ä‡, tempo, czas
    cx.fillStyle='#5fff7f';cx.font='bold 13px "Courier New",monospace';cx.textAlign='left';
    // F+ Audyt 2026-05-11: mnoĹĽnik 3â†’5 (realistyczne km/h: Spacer~5, Trucht~9, Bieg~14, Sprint~18)
    cx.fillText(`SPD ${(actualSpeed*5).toFixed(1)} km/h`,252,75);
    cx.fillText(`PPS ${pps.toFixed(1)}/s`,252,87);
    cx.fillStyle='#5fff7f';cx.font='bold 13px "Courier New",monospace';cx.textAlign='right';
    cx.fillText(`${timeLeft}s`,452,75);
    cx.fillText(`${Math.round(staminaRatio*100)}%`,452,87);
    cx.textAlign='left';
    // Przyciski po bokach konsoli (start/stop, +/-)
    cx.fillStyle='#5a1a1a';cx.fillRect(225,68,12,8);cx.fillStyle='#e74c3c';cx.fillRect(227,70,8,4);
    cx.fillStyle='#1a3a1a';cx.fillRect(225,80,12,8);cx.fillStyle='#27ae60';cx.fillRect(227,82,8,4);
    cx.fillStyle='#3a3a40';cx.fillRect(465,68,12,8);cx.fillRect(465,80,12,8);

    // Pas biegowy (czarny gumowy z subtelnym wzorem)
    cx.fillStyle='#0a0a14';cx.fillRect(125,160,450,55);
    // Cap szybkosci pasa biegowego â€” sprint nie moze byc absurdalnie szybki (cytat #4 z planu)
    bgX=(bgX-Math.min(actualSpeed,3)*8)%30;
    // Linie poziome (tekstura pasa)
    cx.strokeStyle='#2a2a3a';cx.lineWidth=1;
    for(let x=bgX;x<450;x+=30){
      cx.beginPath();cx.moveTo(125+x,160);cx.lineTo(125+x,215);cx.stroke();
    }
    // KrawÄ™dzie pasa
    cx.fillStyle='#3a3a44';cx.fillRect(125,158,450,3); // gĂłrna krawÄ™dĹş metal
    cx.fillStyle='#1a1a22';cx.fillRect(125,213,450,3); // dolna krawÄ™dĹş
    // Boczne osĹ‚ony
    cx.fillStyle='#3a3a3a';cx.fillRect(115,155,12,68);cx.fillRect(573,155,12,68);
    cx.fillStyle='#2a2a30';cx.fillRect(115,155,12,3);cx.fillRect(573,155,12,3);
    // Logo na bocznej osĹ‚onie
    cx.fillStyle='#5a5a65';cx.font='bold 8px Arial';cx.textAlign='center';
    cx.fillText('PRO',121,200);cx.fillText('PRO',579,200);cx.textAlign='left';

    // Handrailes â€” solidne metalowe rurki
    cx.strokeStyle='#5a5a65';cx.lineWidth=5;
    // Lewy
    cx.beginPath();cx.moveTo(120,90);cx.lineTo(120,160);cx.stroke();
    cx.beginPath();cx.moveTo(120,90);cx.lineTo(218,55);cx.stroke();
    // Prawy
    cx.beginPath();cx.moveTo(580,90);cx.lineTo(580,160);cx.stroke();
    cx.beginPath();cx.moveTo(580,90);cx.lineTo(482,55);cx.stroke();
    // Highlights na rurkach
    cx.strokeStyle='#8a8a95';cx.lineWidth=1.5;
    cx.beginPath();cx.moveTo(120,92);cx.lineTo(120,158);cx.stroke();
    cx.beginPath();cx.moveTo(580,92);cx.lineTo(580,158);cx.stroke();

    // === POSTAÄ† BIEGNÄ„CA ===
    // Phase animacji zaleĹĽy od actualSpeed (im szybciej tym szybszy bieg)
    // CAP na actualSpeed (cytat #4 z planu): sprint nie moze miec absurdalnej animacji
    const animSpeed=Math.min(actualSpeed,2.5);
    legPhase+=0.05+animSpeed*0.12;
    const rx=350,ry=145;
    const tiltAngle=staminaRatio>0.3?Math.min(0.15,animSpeed*0.04):(0.3-staminaRatio)*1.5;
    const armPhase=legPhase+Math.PI; // rÄ™ce przeciwnie do nĂłg
    // Bounce przy biegu (subtle)
    const bounce=Math.abs(Math.sin(legPhase))*Math.min(3,animSpeed*0.8);
    cx.save();cx.translate(rx,Math.round(ry-bounce));
    // === RÄCE â€” zgiÄ™te w Ĺ‚okciach, wymachy (Math.round dla pixel-perfect â€” cytat #3) ===
    const armSwingL=Math.round(Math.sin(armPhase)*22*Math.min(1,animSpeed/2));
    const armSwingR=Math.round(Math.sin(armPhase+Math.PI)*22*Math.min(1,animSpeed/2));
    const skinC=staminaRatio>0.3?'#e8c060':'#c09050';
    const cloth=staminaRatio>0.3?'#3498db':'#1a5a8a';
    const cloth2=staminaRatio>0.3?'#5fb3e8':'#3a7aa8'; // jasniejszy odcieĹ„ rÄ™kawĂłw
    cx.strokeStyle=cloth;cx.lineWidth=8;cx.lineCap='round';
    // Lewa rÄ™ka â€” od ramienia (-12,-10), zgiÄ™ta w Ĺ‚okciu
    cx.beginPath();
    cx.moveTo(-12,-10);
    cx.lineTo(-12-Math.cos(armPhase)*4, -10+armSwingL*0.4); // Ĺ‚okieÄ‡
    cx.lineTo(-12+Math.sin(armPhase)*8, -10+armSwingL); // dĹ‚oĹ„
    cx.stroke();
    // Prawa rÄ™ka
    cx.beginPath();
    cx.moveTo(12,-10);
    cx.lineTo(12+Math.cos(armPhase+Math.PI)*4, -10+armSwingR*0.4);
    cx.lineTo(12-Math.sin(armPhase)*8, -10+armSwingR);
    cx.stroke();
    // DĹ‚onie (maĹ‚e punkty)
    cx.fillStyle=skinC;
    cx.beginPath();cx.arc(-12+Math.sin(armPhase)*8,-10+armSwingL,3.5,0,Math.PI*2);cx.fill();
    cx.beginPath();cx.arc(12-Math.sin(armPhase)*8,-10+armSwingR,3.5,0,Math.PI*2);cx.fill();
    // === TUĹĂ“W (sportowa koszulka) ===
    cx.fillStyle=cloth;
    cx.fillRect(-14,-14,28,38);
    // Highlight na Ĺ›rodku tuĹ‚owia (sportowy nadruk)
    cx.fillStyle='rgba(255,255,255,.4)';cx.fillRect(-3,-5,6,15);
    // === GĹOWA z opaskÄ… ===
    cx.save();cx.rotate(tiltAngle);
    cx.fillStyle=skinC;cx.beginPath();cx.arc(0,-30,14,0,Math.PI*2);cx.fill();
    // WĹ‚osy/opaska sportowa
    cx.fillStyle='#1a1a22';cx.fillRect(-12,-42,24,4);
    // Opaska sportowa (czerwona)
    cx.fillStyle='#e74c3c';cx.fillRect(-12,-39,24,2);
    // Oczy
    cx.fillStyle='#0a0a14';cx.beginPath();cx.arc(-4,-30,1.5,0,Math.PI*2);cx.fill();
    cx.beginPath();cx.arc(4,-30,1.5,0,Math.PI*2);cx.fill();
    // Skupiona mina (linia)
    cx.strokeStyle='#5a3a30';cx.lineWidth=1;
    cx.beginPath();cx.moveTo(-3,-23);cx.lineTo(3,-23);cx.stroke();
    cx.restore();
    // === NOGI â€” animowany bieg ===
    const lk=Math.sin(legPhase)*22*Math.min(1.2,actualSpeed/2);
    const rk=Math.sin(legPhase+Math.PI)*22*Math.min(1.2,actualSpeed/2);
    cx.strokeStyle=cloth;cx.lineWidth=9;cx.lineCap='round';
    // Lewa noga â€” udo + Ĺ‚ydka
    cx.beginPath();
    cx.moveTo(-7,24);
    cx.lineTo(-7+lk*0.6,40+Math.abs(lk)*0.3); // kolano
    cx.lineTo(-7+lk,55+Math.abs(lk)*0.5); // stopa
    cx.stroke();
    // Prawa noga
    cx.beginPath();
    cx.moveTo(7,24);
    cx.lineTo(7+rk*0.6,40+Math.abs(rk)*0.3);
    cx.lineTo(7+rk,55+Math.abs(rk)*0.5);
    cx.stroke();
    // Buty (biaĹ‚e trampki)
    cx.fillStyle='#fff';
    cx.fillRect(-11+lk,53+Math.abs(lk)*0.5,8,4);
    cx.fillRect(3+rk,53+Math.abs(rk)*0.5,8,4);
    cx.fillStyle='#e74c3c';
    cx.fillRect(-11+lk,57+Math.abs(lk)*0.5,8,1); // czerwony pasek pod butem
    cx.fillRect(3+rk,57+Math.abs(rk)*0.5,8,1);
    cx.restore();

    // === HUD ===
    // Hint / warning
    if(stamina<30){
      const alpha=0.5+Math.sin(now/150)*0.5;
      cx.fillStyle=`rgba(231,76,60,${alpha*0.25})`;cx.fillRect(0,0,700,260);
      cx.fillStyle=`rgba(231,76,60,${alpha})`;cx.font='bold 22px Arial';cx.textAlign='center';
      cx.fillText('âš  SPACJA! Tracisz tempo!',350,30);cx.textAlign='left';
    } else if(pps<speed*0.5){
      cx.fillStyle='rgba(255,200,80,0.9)';cx.font='bold 18px Arial';cx.textAlign='center';
      cx.fillText('Spamuj SPACJÄ szybciej!',350,30);cx.textAlign='left';
    } else if(actualSpeed>speed*1.2){
      cx.fillStyle='rgba(40,220,100,0.9)';cx.font='bold 18px Arial';cx.textAlign='center';
      cx.fillText('đź”Ą Ĺšwietne tempo!',350,30);cx.textAlign='left';
    } else {
      cx.fillStyle='rgba(40,180,255,0.9)';cx.font='bold 18px Arial';cx.textAlign='center';
      cx.fillText('Biegnij â€” spamuj SPACJÄ',350,30);cx.textAlign='left';
    }
    // Speed indicator pasek na dole
    cx.fillStyle='#1a1a22';cx.fillRect(150,238,400,12);
    cx.fillStyle='#3498db';cx.fillRect(150,238,Math.min(400,actualSpeed/(speed*1.5)*400),12);
    cx.strokeStyle='#3a3a44';cx.lineWidth=1;cx.strokeRect(150,238,400,12);
    cx.fillStyle='#7ec8e3';cx.font='bold 11px Arial';cx.textAlign='center';
    cx.fillText(`Tempo cel: x${speed} (PPS ${pps.toFixed(1)})`,350,247);cx.textAlign='left';
    if(gameActive) requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
  window._jobMgCleanup=()=>{gameActive=false;if(window._tmTimer){clearInterval(window._tmTimer);window._tmTimer=null;}if(window._tmKeydown){document.removeEventListener('keydown',window._tmKeydown);window._tmKeydown=null;}if(window._tmKeyup){document.removeEventListener('keyup',window._tmKeyup);window._tmKeyup=null;}el.classList.remove('on');el.style.display='none';el.innerHTML='<div id="mg-job-content"></div>';};
}

function renderTarg(){
