function adminTeleport(){
  if(currentRoom!=='ulica'){document.getElementById('adm-msg').textContent='âš ď¸Ź Najpierw wyjdĹş na ulicÄ™';return;}
  const sel=document.getElementById('adm-tp').value.split(',');
  const tx=parseInt(sel[0]),ty=parseInt(sel[1]);
  if(isFinite(tx)&&isFinite(ty)){
    P.wx=tx;P.wy=ty;
