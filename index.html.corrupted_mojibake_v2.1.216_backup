  if(typeof renderMusicShop==='function')renderMusicShop();
};
window.buyOutfit=(id,name,price)=>{
  if(G.outfit.top===id){document.getElementById('shop-res').textContent='JuĹĽ masz ten outfit!';return;}
  // F3-FIX-D: applyOutfitDiscount = NEGOCJACJE + DRIP_MASTER evo "Trendsetter" (-20% extra)
  const _outfitPrice=applyOutfitDiscount(price);
  // Bonusy sĹ‚awy/rep dawane TYLKO gdy gracz pierwszy raz kupuje outfit (anti-exploit)
  G._ownedOutfits=G._ownedOutfits||[];
  const firstTime=!G._ownedOutfits.includes(id);
  // v1.9.16: BUG FIX â€” opĹ‚ata TYLKO przy pierwszym zakupie outfitu (zgodnie z buyCar pattern). WczeĹ›niej zmiana outfit kosztowaĹ‚a peĹ‚nÄ… cenÄ™ za kaĹĽdym razem.
  if(firstTime){
    if(G.money<_outfitPrice) return;
    if(_outfitPrice>0) G.money-=_outfitPrice;
    G._ownedOutfits.push(id);
  }
  G.outfit.top=id;
  const outfitColors={default:null,street:'#1a1a2a',suit:'#2a3050',sport:'#1a5030',music:'#4a0a5a',luxury:'#3a1a0a',polo:'#3a8a5a',jeansowa:'#2a4a7a',zimowa:'#3a3a4a',smoking:'#000000',designer_concert:'#1a0a3a',tracksuit:'#1a3a4a',leather_jacket:'#1a0a0a',designer_hoodie:'#2a1a3a'}; /* v2.1.148 hotfix: 3 nowe outfity colors */
  P.cloth=outfitColors[id]||G.cloth;
  if(firstTime){
    // F3-FIX: DRIP_MASTER skill â€” bonus sĹ‚awy z outfitĂłw (max +25% przy lvl 5)
    const _dripMult=getDripFameBonus();
    /* v2.1.99: Prestige fameMult przez addFame() (Wave 1 K6 outfit first-buy bypass fix â€” 5 outfitĂłw) */
    if(id==='luxury'){const f=Math.round(10*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);notify(`đź’Ž Luxury drip! +${f} sĹ‚awa (pierwszy zakup)`);}
    else if(id==='suit'){const f=Math.round(5*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);notify(`đź‘” Garnitur zaĹ‚oĹĽony! +${f} sĹ‚awa (pierwszy zakup)`);}
    else if(id==='street'){const r=Math.round(3*_dripMult); G.streetRep=clamp(G.streetRep+r,0,100);notify(`đź§Ą Streetwear! +${r} rep uliczna (pierwszy zakup)`);}
    // F5.4 E3: nowe ubrania z bonusami pierwszego zakupu
    else if(id==='polo'){const f=Math.round(1*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);notify(`đź§µ Polo zaĹ‚oĹĽone! +${f} sĹ‚awa (pierwszy zakup)`);}
    else if(id==='jeansowa'){const r=Math.round(2*_dripMult); G.streetRep=clamp(G.streetRep+r,0,100);notify(`đźĄľ Kurtka jeansowa! +${r} rep uliczna (pierwszy zakup)`);}
    else if(id==='smoking'){const f=Math.round(15*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);notify(`đźŽ© Smoking zaĹ‚oĹĽony! +${f} sĹ‚awa (pierwszy zakup)`);}
    else if(id==='designer_concert'){const f=Math.round(5*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);notify(`đźŚź Designerski koncertowy! +${f} sĹ‚awa (pierwszy zakup)`);}
    /* v2.1.148: 3 nowe outfity first-buy bonuses */
    else if(id==='tracksuit'){const r=Math.round(2*_dripMult); G.streetRep=clamp(G.streetRep+r,0,100);notify(`đźĄ‹ Dresik! +${r} rep uliczna (pierwszy zakup)`);}
    else if(id==='leather_jacket'){const f=Math.round(5*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);const r=Math.round(2*_dripMult); G.streetRep=clamp(G.streetRep+r,0,100);notify(`đź§Ą Kurtka skĂłrzana! +${f} sĹ‚awa + +${r} rep (pierwszy zakup)`);}
    else if(id==='designer_hoodie'){const f=Math.round(8*_dripMult); if(typeof addFame==='function')addFame(f);else G.fame=clamp(G.fame+f,0,500);G.drip=Math.min(200,(G.drip||0)+10);notify(`đź‘• Designer hoodie! +${f} sĹ‚awa + +10 drip (pierwszy zakup)`);}
  }
  document.getElementById('shop-res').textContent=`âś… ZaĹ‚oĹĽono: ${name}`;
  renderClothingShop();
};
