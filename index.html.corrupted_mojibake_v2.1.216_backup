  DB_DECORATIVE.forEach(b=>drawDB(b.wx,b.wy,b.w,b.h,b.c,b.sky));

  // â”€â”€ Dzielnica Dripu â€” tablica wejĹ›ciowa â”€â”€
  (()=>{
    // Dwie tabliczki â€” nad LV (lewa strona) i nad GUCCI (prawa strona). WyrĂłwnane centralnie nad sklepami.
    const signWidth=210;
    const signCenters=[
      {wx:2596}, // Ĺ›rodek LV (wx:2496+w:200/2 = 2596)
      {wx:3244}  // Ĺ›rodek GUCCI (wx:3144+w:200/2 = 3244)
    ];
    for(const s of signCenters){
      const signX=sx2(s.wx-signWidth/2), signY=sy2(2593);
      if(signX>-220&&signX<1400&&signY>-50&&signY<800){
        // CieĹ„
        X.fillStyle='rgba(0,0,0,.4)';X.fillRect(signX+4,signY+4,signWidth,36);
        // Marmurowa tablica
        const sg=X.createLinearGradient(signX,signY,signX,signY+36);
        sg.addColorStop(0,'#f5edd8');sg.addColorStop(1,'#d8c8a0');
        X.fillStyle=sg;X.fillRect(signX,signY,signWidth,36);
        X.strokeStyle='#c8a520';X.lineWidth=2;X.strokeRect(signX,signY,signWidth,36);
        // Tekst
        X.shadowBlur=0;X.shadowColor='transparent';
        X.font='bold 14px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
        X.fillStyle='#1a1200';X.fillText('đź’Ž DZIELNICA DRIPU',signX+signWidth/2,signY+24);
        X.textAlign='left';
      }
    }
  })();

  // USUNIÄTE 2026-05-15 v2.1.20: legacy "drawTL" sygnalizatory pieszych ze starych wersji gry
  // (4 stare sygnalizatory w rogach 5 skrzyĹĽowaĹ„ = 20 sztuk) â€” niefunkcjonalne (wĹ‚asny tlCycle
  // niezsynchronizowany z getTrafficLight()), wizualnie redundantne wobec _drawPedSignalSmall
  // na pedCorners Â±170 w drawTrafficLights(). User: "stare elementy ze starych wersji gry".

  // Latarnie rysuje drawLamps() â€” tu nie duplikujemy

  // â”€â”€ Park â€” ozdoby na wierzchu (tĹ‚o z kafelkĂłw buildMaps, NIE zakrywaÄ‡ obiektĂłw) â”€â”€
  {
    // Animowana powierzchnia stawu (na water-tiles)
    const pcx=sx2(1187),pcy=sy2(778);
    if(pcx>-80&&pcx<1380&&pcy>-80&&pcy<840){
      const wt=t/1800;
      X.fillStyle='#1a6aa0';X.beginPath();X.ellipse(pcx-6,pcy-6,28,18,-.3,0,Math.PI*2);X.fill();
      X.fillStyle=`rgba(255,255,255,${0.08+Math.sin(wt)*0.04})`;X.beginPath();X.ellipse(pcx-10,pcy-10,13,7,-.5,0,Math.PI*2);X.fill();
      // Kamyki wokĂłĹ‚ stawu
      X.fillStyle='#666';
      for(let a=0;a<8;a++){const aa=a/8*Math.PI*2;X.beginPath();X.ellipse(pcx+Math.cos(aa)*70,pcy+Math.sin(aa)*50,4,3,aa,0,Math.PI*2);X.fill();}
    }
    // Krzewy (bushes) WEWNÄ„TRZ parku (x:0-672, y:864-1248) â€” miÄ™dzy obiektami parku
    const bushes=[
      // GĂłrna krawÄ™dĹş parku
      {wx:30,wy:880},{wx:660,wy:880},
      // Dolna krawÄ™dĹş
      {wx:30,wy:1220},{wx:660,wy:1220},
      // Krzewy w Ĺ›rodku parku â€” wokĂłĹ‚ fontanny, na trawie
      {wx:200,wy:1050},{wx:480,wy:1050},
      {wx:120,wy:1080},{wx:560,wy:1090},
    ];
    bushes.forEach(b=>{
      const bsx=sx2(b.wx),bsy=sy2(b.wy);
      if(bsx<-30||bsx>1310||bsy<-30||bsy>790)return;
      // Krzew â€” ciemna baza + jasne kulki
      X.fillStyle='#1a5a1a';X.beginPath();X.arc(bsx,bsy,12,0,Math.PI*2);X.fill();
      X.fillStyle='#2a7a2a';X.beginPath();X.arc(bsx-5,bsy-4,8,0,Math.PI*2);X.fill();
      X.fillStyle='#2a7a2a';X.beginPath();X.arc(bsx+5,bsy-5,7,0,Math.PI*2);X.fill();
      X.fillStyle='#339933';X.beginPath();X.arc(bsx,bsy-8,7,0,Math.PI*2);X.fill();
    });
  }

  // (Ĺ›cieĹĽki miÄ™dzy budynkami usuniÄ™te â€” chodnik pĹ‚ynnie przechodzi miÄ™dzy blokami)

  // â”€â”€ Drzewa â€” tylko w bezpiecznych miejscach (poza budynkami, latarniami, jezdniami) â”€â”€
  // Budynki: NORTH wy=128-288 (przy chodniku), CENTRAL wy=672-827, SOUTH wy=2208-2363
  // Jezdnie: H1 wy=384-576, H2 wy=1920-2112
  // Latarnie: wy=340,610,1880,2150
  // Strefa parku: wx=1104-1440, wy=720-1056 (drzewa w parku rysujemy osobno)
  // Drzewa â€” TYLKO w bezpiecznych obszarach (poza chodnikami V1/V2/V3, budynkami, DB).
  // KaĹĽda pozycja zweryfikowana programowo dbg_trees_audit.mjs.
  // Bezpieczne strefy wx (poza chodnikami):
  //   Z1: 0-672 (z wyjÄ…tkiem parku x:0-672 wy:864-1248)
  //   Z2: 1056-2112 (poza chodnikami V1, V2)
  //   Z3: 2496-3360 (poza V2, V3)
  //   Z4: 3744-4320 (poza V3)
  const trees=[
    // â”€â”€ NORTH (wy=40-90, nad budynkami wy=128) â”€â”€
    {wx:80,wy:60},{wx:240,wy:75},{wx:430,wy:55},{wx:600,wy:70},  // Z1 nad Traphouse + DB
    {wx:1130,wy:65},{wx:1320,wy:75},{wx:1500,wy:55},{wx:1700,wy:70},{wx:1900,wy:60},{wx:2070,wy:75}, // Z2
    {wx:2570,wy:65},{wx:2740,wy:75},{wx:2910,wy:55},{wx:3080,wy:70},{wx:3250,wy:60}, // Z3
    {wx:3810,wy:65},{wx:3980,wy:75},{wx:4180,wy:60},{wx:4280,wy:70}, // Z4
    // â”€â”€ Pas miÄ™dzy rzÄ™dami DB (Z2/Z3/Z4 majÄ… peĹ‚nÄ… siatkÄ™ DB â€” drzewa tylko po prawej krawÄ™dzi mapy) â”€â”€
    // Z4 prawa krawÄ™dĹş â€” pojedyncze drzewa za ostatnim DB
    {wx:4280,wy:1070},{wx:4280,wy:1285},{wx:4280,wy:1775},{wx:4280,wy:2400},
    // â”€â”€ Pas miÄ™dzy ROW D a H2 chodnik â€” Z1 (0-672, brak budynkĂłw po H1 chodniku) â”€â”€
    {wx:50,wy:1760},{wx:200,wy:1775},{wx:400,wy:1755},{wx:560,wy:1770},
    // â”€â”€ Pas miÄ™dzy SOUTH budynki i ROW E â€” Z1 (0-672) â”€â”€
    {wx:50,wy:2395},{wx:230,wy:2400},{wx:600,wy:2395},
  ];
  const windSway=Math.sin(t*.0004)*1.5+Math.sin(t*.0007)*0.8;
  // Sezon kolorystyczny dla drzew: wiosna jasno-zielone, lato ĹĽywe, jesieĹ„ rdzawe, zima czarno-biaĹ‚e
  const season=getSeason?getSeason():{id:'summer'};
  const seasonId=season?.id||'summer';
  const treeCols={
    spring:{trunk:'#5a3818',c1:'#347036',c2:'#469838',c3:'#5cb540',c4:'#88d878'},
    summer:{trunk:'#4a3010',c1:'#0a3a0a',c2:'#1a5a1a',c3:'#2a7a2a',c4:'#4aa84a'},
    autumn:{trunk:'#5a3018',c1:'#a04020',c2:'#c46818',c3:'#e09020',c4:'#f0b840'},
    winter:{trunk:'#3a2010',c1:'#5a5a5a',c2:'#888888',c3:'#cccccc',c4:'#ffffff'}
  };
  const tc=treeCols[seasonId]||treeCols.summer;
  const shadowDir={0:{dx:-9,dy:4},1:{dx:0,dy:6},2:{dx:11,dy:5},3:{dx:0,dy:3}}[G.timeOfDay]||{dx:0,dy:6};
  const shadowAlpha={0:0.28,1:0.22,2:0.30,3:0.10}[G.timeOfDay]||0.22;
  trees.forEach(tr=>{
    const tx=sx2(tr.wx),ty=sy2(tr.wy);
    if(tx<-30||tx>1330||ty<-30||ty>760)return;
    const sw=windSway+Math.sin(t*.0005+tr.wx*.001)*1.0; // per-tree phase
    // CieĹ„ drzewa â€” eliptyczny pod pniem, kierunek zaleĹĽy od pory dnia
    X.save();X.fillStyle=`rgba(0,0,0,${shadowAlpha})`;
    X.beginPath();X.ellipse(tx+shadowDir.dx,ty+18+shadowDir.dy,12,4,0,0,Math.PI*2);X.fill();
    X.restore();
    // PieĹ„
    X.fillStyle=tc.trunk;X.fillRect(tx-2,ty+6,5,14);
    // Drobne tekstury pnia
    X.fillStyle='rgba(0,0,0,0.25)';X.fillRect(tx-2,ty+8,1,10);X.fillRect(tx+2,ty+10,1,8);
    // Korona â€” wielowarstwowa z subtle highlight
    if(seasonId==='winter'){
      // Zima: goĹ‚e gaĹ‚Ä™zie + Ĺ›nieg
      X.strokeStyle='#3a2010';X.lineWidth=1.5;
      X.beginPath();
      for(let i=0;i<5;i++){
        const a=(i/5)*Math.PI*2,r=10;
        X.moveTo(tx,ty+2);X.lineTo(tx+Math.cos(a)*r+sw*.5,ty+Math.sin(a)*r-2);
      }
      X.stroke();
      // Ĺšnieg na koronie
      X.fillStyle='rgba(240,250,255,0.85)';
      X.beginPath();X.ellipse(tx+sw*.3,ty-3,11,7,0,0,Math.PI*2);X.fill();
      X.fillStyle='#fff';
      X.beginPath();X.ellipse(tx-2+sw*.3,ty-5,5,3,0,0,Math.PI*2);X.fill();
    } else {
      // Trzy warstwy korony â€” wyraĹşny gradient
      X.fillStyle=tc.c1;X.beginPath();X.arc(tx+sw,ty,14,0,Math.PI*2);X.fill();
      X.fillStyle=tc.c2;X.beginPath();X.arc(tx-3+sw,ty-3,10,0,Math.PI*2);X.fill();
      X.fillStyle=tc.c3;X.beginPath();X.arc(tx-4+sw*.9,ty-5,6,0,Math.PI*2);X.fill();
      // Highlight (lewy-gĂłra) â€” symuluje Ĺ›wiatĹ‚o z lewej
      X.fillStyle=tc.c4+(seasonId==='autumn'?'cc':'aa');
      X.beginPath();X.arc(tx-5+sw*.7,ty-6,3,0,Math.PI*2);X.fill();
      // Subtelne kropki â€” liĹ›cie wystajÄ…ce
      for(let i=0;i<3;i++){
        const a=(i/3)*Math.PI*2+t*0.0003+tr.wx*0.001;
        X.fillStyle=tc.c3;
        X.beginPath();X.arc(tx+Math.cos(a)*11+sw*.4,ty+Math.sin(a)*8,1.5,0,Math.PI*2);X.fill();
      }
      // Owoce jesieniÄ… (jabĹ‚ka)
      if(seasonId==='autumn'){
        X.fillStyle='#c81818';
        X.beginPath();X.arc(tx+5+sw*.3,ty-2,1.5,0,Math.PI*2);X.fill();
        X.beginPath();X.arc(tx-2+sw*.3,ty+3,1.5,0,Math.PI*2);X.fill();
      }
    }
  });

  // â”€â”€ Dzielnica Dripu â€” zĹ‚ote filary wejĹ›ciowe i napis â”€â”€
  {
    const _dp=(dpx,dpy)=>{
      const spx=sx2(dpx),spy=sy2(dpy);
      if(spx<-20||spx>1310||spy<62||spy>800)return;
      X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(spx+3,spy+6,8,3,0,0,Math.PI*2);X.fill();
      X.fillStyle='#1a1200';X.fillRect(spx-7,spy-2,14,8);
      const cg=X.createLinearGradient(spx-3,spy-16,spx+3,spy-16);
      cg.addColorStop(0,'#a07810');cg.addColorStop(.4,'#f1d060');cg.addColorStop(1,'#c8a520');
      X.fillStyle=cg;X.fillRect(spx-3,spy-16,6,18);
      X.fillStyle='#f1d060';X.beginPath();X.moveTo(spx,spy-22);X.lineTo(spx+5,spy-17);X.lineTo(spx,spy-12);X.lineTo(spx-5,spy-17);X.closePath();X.fill();
      X.fillStyle='#e91e8c';X.beginPath();X.arc(spx,spy-17,2,0,Math.PI*2);X.fill();
      if(G.timeOfDay>=2){const gl=X.createRadialGradient(spx,spy-17,0,spx,spy-17,20);gl.addColorStop(0,'rgba(255,215,60,.45)');gl.addColorStop(1,'rgba(255,180,0,0)');X.fillStyle=gl;X.beginPath();X.arc(spx,spy-17,20,0,Math.PI*2);X.fill();}
    };
    // Filary przy wejĹ›ciu do Dzielnicy Dripu (od strony V2, wxâ‰2497)
    _dp(2497,2836);_dp(2497,3116); // wschĂłd V2 â€” wejĹ›cie do district
    // Filary przy wyjĹ›ciu (od strony V3, wxâ‰3450)
    _dp(3450,2836);_dp(3450,3116);
    // Napis usuniÄ™ty â€” byĹ‚ na Ĺ›rodku drogi H3 (bug #13). Tabliczki nad sklepami wystarczÄ….
  }

  // â”€â”€ PrzejĹ›cia dla pieszych â€” zebra prostopadĹ‚a do kierunku jazdy â”€â”€
  // crosswalkV: strefa wÄ…ska E-W przy H-road â€” pasy POZIOME (peĹ‚na szer. strefy Ă— 14px) co 25px wzdĹ‚uĹĽ H-road
  function crosswalkV(wxL,wxR,wyA,wyB){
    const sx1=sx2(wxL),sw=sx2(wxR)-sx2(wxL);
    if(sx1+sw<-10||sx1>1340)return;
    const sy1=sy2(wyA),fullH=sy2(wyB)-sy2(wyA);
    if(sy1+fullH<-10||sy1>780)return;
    X.fillStyle='rgba(20,20,20,0.38)';X.fillRect(sx1,sy1,sw,fullH);
    X.fillStyle='#c8c4be';
    const crossH=wyB-wyA;
    const N=Math.floor(crossH/25);
    const off=Math.round((crossH-N*25+11)/2);
    for(let i=0;i<N;i++){
      const wy=wyA+off+i*25;
      const sy=sy2(wy);
      if(sy+14>-10&&sy<780)X.fillRect(sx1,sy,sw,14);
    }
  }
  // crosswalkH: strefa wÄ…ska N-S przy V-road â€” pasy PIONOWE (14px Ă— peĹ‚na wys. strefy) co 25px wzdĹ‚uĹĽ V-road
  function crosswalkH(wyT,wyB,wxA,wxB){
    const sy1=sy2(wyT),fullH=sy2(wyB)-sy2(wyT);
    if(sy1+fullH<-10||sy1>780)return;
    const sx1=sx2(wxA),fullW=sx2(wxB)-sx2(wxA);
    if(sx1+fullW<-10||sx1>1340)return;
    X.fillStyle='rgba(20,20,20,0.38)';X.fillRect(sx1,sy1,fullW,fullH);
    X.fillStyle='#c8c4be';
    const crossW=wxB-wxA;
    const N=Math.floor(crossW/25);
    const off=Math.round((crossW-N*25+11)/2);
    for(let i=0;i<N;i++){
      const wx=wxA+off+i*25;
      const sx=sx2(wx);
      if(sx+14>-10&&sx<1340)X.fillRect(sx,sy1,14,fullH);
    }
  }
  // V1(768-960) Ă— H1(384-576)
  // north/south crossings: horizontal stripes (crosswalkH), east/west crossings: vertical stripes (crosswalkV)
  crosswalkH(346,384,768,960);   // north â€” horizontal stripes spanning V1 width
  crosswalkH(576,620,768,960);   // south â€” horizontal stripes spanning V1 width
  crosswalkV(718,768,384,576);   // west  â€” vertical stripes spanning H1 height
  crosswalkV(960,1010,384,576);  // east  â€” vertical stripes spanning H1 height
  // V2 Ă— H1
  crosswalkH(346,384,2208,2400); crosswalkH(576,620,2208,2400);
  crosswalkV(2158,2208,384,576); crosswalkV(2400,2450,384,576);
  // V3 Ă— H1
  crosswalkH(346,384,3456,3648); crosswalkH(576,620,3456,3648);
  crosswalkV(3406,3456,384,576); crosswalkV(3648,3698,384,576);
  // V1 Ă— H2(1920-2112)
  crosswalkH(1878,1920,768,960); crosswalkH(2112,2156,768,960);
  crosswalkV(718,768,1920,2112); crosswalkV(960,1010,1920,2112);
  // V2 Ă— H2
  crosswalkH(1878,1920,2208,2400); crosswalkH(2112,2156,2208,2400);
  crosswalkV(2158,2208,1920,2112); crosswalkV(2400,2450,1920,2112);
  // V3 Ă— H2
  crosswalkH(1878,1920,3456,3648); crosswalkH(2112,2156,3456,3648);
  crosswalkV(3406,3456,1920,2112); crosswalkV(3648,3698,1920,2112);
  // V1 Ă— H3(2880-3072)
  crosswalkH(2838,2880,768,960); crosswalkH(3072,3116,768,960);
  crosswalkV(718,768,2880,3072); crosswalkV(960,1010,2880,3072);
  // V2 Ă— H3
  crosswalkH(2838,2880,2208,2400); crosswalkH(3072,3116,2208,2400);
  crosswalkV(2158,2208,2880,3072); crosswalkV(2400,2450,2880,3072);
  // V3 Ă— H3 â€” peĹ‚ne 4 przejĹ›cia (V3 idzie peĹ‚nym pionem)
  crosswalkH(2838,2880,3456,3648); crosswalkH(3072,3116,3456,3648);
  crosswalkV(3406,3456,2880,3072); crosswalkV(3648,3698,2880,3072);

  // â”€â”€ Pasy ruchu â€” przerywana linia Ĺ›rodkowa â€” RYSOWANA JAKO PROSTOKÄ„TY (zablokowana do world coords) â”€â”€
  // Kolor BIAĹY (poprzednio ĹĽĂłĹ‚ty rgba(255,220,0)). Wykluczone strefy: V-roads + crosswalki + H-roads + crosswalki.
  X.fillStyle='rgba(255,255,255,0.7)';
  const vRoads=[[768,960],[2208,2400],[3456,3648]];
  const hRoads=[[384,576],[1920,2112],[2880,3072],[3264,3456]];
  // F+ 2026-05-12 #66 NAPRAWA DZIURY: blokady ograniczone do PASĂ“W ZEBRA + 4px margin
  // WczeĹ›niej Â±130px buffor tworzyĹ‚ DZIURÄ 80px miÄ™dzy ostatnim paskiem ruchu a pasem zebra.
  // Teraz pas ruchu koĹ„czy siÄ™ ~5px przed krawÄ™dziÄ… pasa zebra â€” wizualnie spĂłjne.
  // V skrzyĹĽowania (V1=864, V2=2304, V3=3552): pasy zebra W (-146..-96), E (+96..+146)
  // peĹ‚ny zakres blokady = [centroid-150, centroid+150]
  const vBlocked=[[714,1014],[2154,2454],[3402,3702]];
  // H skrzyĹĽowania (H1=480, H2=2016, H3=2976): pasy zebra N (-134..-96), S (+96..+144)
  // peĹ‚ny zakres blokady = [centroid-138, centroid+148]
  const hBlocked=[[342,628],[1878,2164],[2838,3124]];
  function drawHDash(wy,wxMax){
    const sy=sy2(wy);if(sy<-5||sy>765)return;
    const wx0=Math.floor(cam.x/40)*40;
    for(let wx=wx0;wx<cam.x+1284;wx+=40){
      if(wxMax&&wx>wxMax)break;
      const ssx=sx2(wx);if(ssx>1280)break;
      // Skip jeĹ›li pasek (20px szer) NACHODZI na blok
      if(vBlocked.some(([a,b])=>wx+20>=a&&wx<=b))continue;
      if(ssx+20>0)X.fillRect(ssx,sy-1,20,3);
    }
  }
  function drawVDash(wx,wyMax){
    const ssx=sx2(wx);if(ssx<-5||ssx>1285)return;
    const wy0=Math.floor(cam.y/40)*40;
    for(let wy=wy0;wy<cam.y+662;wy+=40){
      if(wyMax&&wy>wyMax)break;
      const sy=sy2(wy);if(sy>720)break;
      // Skip jeĹ›li pasek (20px wys) NACHODZI na blok
      if(hBlocked.some(([a,b])=>wy+20>=a&&wy<=b))continue;
      if(sy+20>62)X.fillRect(ssx-1,sy,3,20);
    }
  }
  drawHDash(480);drawHDash(2016);drawHDash(2976);  // H1/H2/H3 â€” peĹ‚na szerokoĹ›Ä‡
  drawVDash(864);drawVDash(2304);drawVDash(3552);        // V3 idzie peĹ‚nym pionem

  // â”€â”€ Ciemniejsze krawÄ™dzie jezdni (gradient gĹ‚Ä™bi) â”€â”€
  function roadEdgeDark(wyTop,wyBot,wxMax){
    const st=sy2(wyTop),sb=sy2(wyBot),eh=14;
    if(sb<62||st>720)return;
    const x0=0,x1=wxMax?Math.min(1280,sx2(wxMax)):1280;
    if(x1<=0)return;
    // GĂłrna krawÄ™dĹş
    const gt=X.createLinearGradient(0,st,0,st+eh);
    gt.addColorStop(0,'rgba(0,0,0,.25)');gt.addColorStop(1,'rgba(0,0,0,0)');
    X.fillStyle=gt;X.fillRect(x0,st,x1,eh);
    // Dolna krawÄ™dĹş
    const gb=X.createLinearGradient(0,sb-eh,0,sb);
    gb.addColorStop(0,'rgba(0,0,0,0)');gb.addColorStop(1,'rgba(0,0,0,.25)');
    X.fillStyle=gb;X.fillRect(x0,sb-eh,x1,eh);
  }
  function vRoadEdgeDark(wxL,wxR,wyMax){
    const sl=sx2(wxL),sr2=sx2(wxR),ew=12;
    if(sr2<0||sl>1280)return;
    const y0=62,y1=wyMax?Math.min(720,sy2(wyMax)):720;
    if(y1<=y0)return;
    const gl=X.createLinearGradient(sl,0,sl+ew,0);
    gl.addColorStop(0,'rgba(0,0,0,.22)');gl.addColorStop(1,'rgba(0,0,0,0)');
    X.fillStyle=gl;X.fillRect(sl,y0,ew,y1-y0);
    const gr2=X.createLinearGradient(sr2-ew,0,sr2,0);
    gr2.addColorStop(0,'rgba(0,0,0,0)');gr2.addColorStop(1,'rgba(0,0,0,.22)');
    X.fillStyle=gr2;X.fillRect(sr2-ew,y0,ew,y1-y0);
  }
  roadEdgeDark(384,576);roadEdgeDark(1920,2112);roadEdgeDark(2880,3072);
  vRoadEdgeDark(768,960);vRoadEdgeDark(2208,2400);vRoadEdgeDark(3456,3648);

  // â”€â”€ Detale chodnika: studzienki kanalizacyjne + pÄ™kniÄ™cia â”€â”€
  {
    // Studzienki (manhole covers) â€” poziome chodniki H-roads
    const sidewalkBands=[
      {wyC:335,wxMin:0,wxMax:4320},   // H1 north sidewalk center
      {wyC:622,wxMin:0,wxMax:4320},   // H1 south sidewalk center
      {wyC:1870,wxMin:0,wxMax:4320},  // H2 north
      {wyC:2158,wxMin:0,wxMax:4320},  // H2 south
      {wyC:2830,wxMin:2496,wxMax:3648},// H3 north (Drip District only)
      {wyC:3118,wxMin:2496,wxMax:3648},// H3 south
    ];
    X.save();
    X.globalAlpha=0.35;
    for(const {wyC,wxMin,wxMax} of sidewalkBands){
      const manholeSy=sy2(wyC);
      if(manholeSy<62||manholeSy>780) continue;
      // Place manhole covers every ~280px world units
      for(let mwx=wxMin+140;mwx<wxMax;mwx+=280){
        const manholeSx=sx2(mwx);
        if(manholeSx<-12||manholeSx>1292) continue;
        // Outer ring
        X.fillStyle='#8a8a8a';
        X.beginPath();X.ellipse(manholeSx,manholeSy,9,4,0,0,Math.PI*2);X.fill();
        // Inner dark circle
        X.fillStyle='#606060';
        X.beginPath();X.ellipse(manholeSx,manholeSy,7,3,0,0,Math.PI*2);X.fill();
        // Cross detail
        X.strokeStyle='#505050';X.lineWidth=1;
        X.beginPath();X.moveTo(manholeSx-6,manholeSy);X.lineTo(manholeSx+6,manholeSy);X.stroke();
        X.beginPath();X.moveTo(manholeSx,manholeSy-3);X.lineTo(manholeSx,manholeSy+3);X.stroke();
      }
    }
    X.globalAlpha=1;
    X.restore();
  }

  // â”€â”€ Detale chodnika: opadĹ‚e liĹ›cie â”€â”€
  {
    const leafColors=['#c87020','#c8a018','#a83018','#8a5018','#b86820','#d4c010'];
    const leafBands=[
      {wyC:335,wxMin:0,wxMax:4320,step:62},
      {wyC:622,wxMin:0,wxMax:4320,step:58},
      {wyC:1870,wxMin:0,wxMax:4320,step:65},
      {wyC:2158,wxMin:0,wxMax:4320,step:60},
      {wyC:2830,wxMin:2496,wxMax:3648,step:55},
      {wyC:3118,wxMin:2496,wxMax:3648,step:57},
    ];
    X.save();
    for(const {wyC,wxMin,wxMax,step} of leafBands){
      for(let lwx=wxMin+20;lwx<wxMax;lwx+=step){
        const h=sr(lwx*.07+wyC*.031+3.7);
        if(h>0.72) continue; // ~28% chance of leaf at each position
        const lsx=sx2(lwx+sr(lwx*.13+5.1)*20-10);
        const lsy=sy2(wyC+sr(lwx*.17+wyC*.041+2.2)*14-7);
        if(lsx<-6||lsx>1286||lsy<-4||lsy>724) continue;
        const col=leafColors[Math.floor(sr(lwx*.19+wyC*.023+1.1)*leafColors.length)];
        const angle=sr(lwx*.11+wyC*.061+4.4)*Math.PI;
        const rw=sr(lwx*.23+1.8)*4+3;
        const rh=rw*0.42;
        X.globalAlpha=0.38+sr(lwx*.31+wyC*.013+7.7)*0.27;
        X.fillStyle=col;
        X.save();
        X.translate(lsx,lsy);X.rotate(angle);
        X.beginPath();X.ellipse(0,0,rw,rh,0,0,Math.PI*2);X.fill();
        X.restore();
      }
    }
    X.globalAlpha=1;
    X.restore();
  }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  MINI MAPA
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// Mapowanie aktualnego storyline-stepu na lokalizacje na mapie (minimap quest marker)
// Dla firstjob: wraca {multi:true, targets:[...]} â€” wiele lokalizacji, gracz sam wybiera
// Dla pozostaĹ‚ych: pojedyncza lokalizacja {wx,wy,em,hint}
function _storylineTargetLoc(){
  if(!G.mainQuest||typeof STORYLINE_QUESTS==='undefined')return null;
  const idx=G.mainQuest.currentStep||0;
  if(idx>=STORYLINE_QUESTS.length)return null;
  const id=STORYLINE_QUESTS[idx]?.id;
  // Pierwsza praca â€” gracz sam wybiera spoĹ›rĂłd 6 moĹĽliwoĹ›ci. Brak konkretnej strzaĹ‚ki.
  if(id==='firstjob'){
    return {multi:true, targets:[
      {wx:400,wy:2280,em:'đź›’',hint:'Supermarket'},
      {wx:1154,wy:2280,em:'đźš—',hint:'Myjnia'},
      {wx:1474,wy:2280,em:'đźŤ´',hint:'Restauracja (zmywak)'},
      {wx:1874,wy:2280,em:'đźŹ—',hint:'Budowa'},
      {wx:2694,wy:2280,em:'đźš´',hint:'Kurier'},
      {wx:2994,wy:2280,em:'đźŤ•',hint:'Pizzeria'},
    ]};
  }
  // Stale lokalizacje dla pozostalych krokow
  const targets={
    freestyle:{wx:2475,wy:670,em:'đźŽ¤',hint:'Freestyle Spot'},
    mic:      {wx:1154,wy:210,em:'đźŽ™',hint:'Sklep Muzyczny'},
    track:    {wx:1714,wy:210,em:'đźŽµ',hint:'Studio nagraĹ„'},
    concert:  {wx:2785,wy:750,em:'đźŽŞ',hint:'Sala Koncertowa'},
    album:    {wx:1714,wy:210,em:'đź’ż',hint:'Studio nagraĹ„'},
    legend:   {wx:2785,wy:750,em:'đźŹź',hint:'Sala Koncertowa'},
  };
  return targets[id]||null;
}

function drawMiniMap(){
  if(currentRoom!=='ulica'){
    const w=document.getElementById('minimap-wrap');if(w&&w.style.display!=='none')w.style.display='none';
    return;
  }
  // PokaĹĽ wrap (header DOM)
  const w=document.getElementById('minimap-wrap');if(w&&w.style.display==='none')w.style.display='block';
  // Reset shadow/composite â€” minimapa zawsze widoczna
  X.save();
  X.shadowBlur=0;X.shadowColor='transparent';X.globalCompositeOperation='source-over';X.globalAlpha=1;
  // Obszar mapy WEWNÄ„TRZ wrapa (poniĹĽej DOM headerĐ° ktĂłry ma 18px)
  const mx=10,my=654,mw=228,mh=60;
  const wW=ROOMS.ulica.wT*T,wH=ROOMS.ulica.hT*T;
  const mpx=v=>mx+Math.round(v/wW*mw),mpy=v=>my+Math.round(v/wH*mh);
  // v1.8.38: drastyczne rozjaĹ›nienie. DOM wrap background ustawiony na transparent â€”
  // canvas drawing teraz widoczny w peĹ‚ni bez blendowania z 97% solid wrap-bg.
  // TĹ‚o mapy â€” JASNY granat (czytelne na kaĹĽdym tle gry)
  X.fillStyle='#2c3e5a';
  X.fillRect(mx,my,mw,mh);
  // Roads horizontal â€” BARDZO jasne szare (kontrast z tĹ‚em)
  X.fillStyle='#c8c8d2';
  X.fillRect(mx,my+Math.round(mh*8/75),mw,Math.max(2,Math.round(mh*4/75)));
  X.fillRect(mx,my+Math.round(mh*40/75),mw,Math.max(2,Math.round(mh*4/75)));
  X.fillRect(mx,my+Math.round(mh*60/75),mw,Math.max(2,Math.round(mh*4/75)));
  // Roads vertical â€” analogicznie jasne
  /* v2.1.185: BUG FIX wT=100, NIE 90 â€” wczeĹ›niejszy /90 przesuwaĹ‚ vertical roads 10-12px w prawo,
     budynki (apt_premium) i strefa Dripu nakĹ‚adaĹ‚y siÄ™ na Ĺşle rysowane drogi â†’ "rĂłĹĽowy prostokÄ…t na Ĺ›rodku ulicy".
     V1 c=16-19 â†’ 16/100=0.16 (vs 16/90=0.178), V2 c=46-49 â†’ 0.46, V3 c=72-75 â†’ 0.72. */
  X.fillStyle='#c0c0ca';
  X.fillRect(mx+Math.round(mw*16/100),my,Math.max(2,Math.round(mw*4/100)),mh);
  X.fillRect(mx+Math.round(mw*46/100),my,Math.max(2,Math.round(mw*4/100)),mh);
  X.fillRect(mx+Math.round(mw*72/100),my,Math.max(2,Math.round(mw*4/100)),mh);
  // Park â€” jaĹ›niejszy zielony
  const parkX1=mpx(96), parkY1=mpy(864), parkX2=mpx(672), parkY2=mpy(1200);
  const parkGrad=X.createLinearGradient(parkX1,parkY1,parkX1,parkY2);
  parkGrad.addColorStop(0,'#48b058');parkGrad.addColorStop(1,'#2a8038');
  X.fillStyle=parkGrad;X.fillRect(parkX1,parkY1,parkX2-parkX1,parkY2-parkY1);
  X.strokeStyle='rgba(180,255,180,.8)';X.lineWidth=1;X.strokeRect(parkX1+.5,parkY1+.5,parkX2-parkX1-1,parkY2-parkY1-1);
  X.font='9px sans-serif';X.fillStyle='rgba(255,255,255,.8)';X.textAlign='center';X.textBaseline='middle';
  X.fillText('đźŚł',(parkX1+parkX2)/2,(parkY1+parkY2)/2);
  X.textAlign='left';X.textBaseline='alphabetic';
  /* v2.1.173: DZIELNICA DRIPU jako pojedyncza strefa (zamiast 8 indywidualnych stripĂłw na 2 rzÄ™dach ktĂłre wyglÄ…daĹ‚y jak paski OBOK drogi H3).
     Strefa obejmuje 2 rzÄ™dy sklepĂłw (north wy=2629, south wy=3168) ale BEZ rysowania osobnych stripĂłw na kaĹĽdy sklep â€” czyĹ›ciej. */
  const dripZ_x1=mpx(2496), dripZ_y1=mpy(2629), dripZ_x2=mpx(3354), dripZ_y2=mpy(3323);
  /* Rysuj 2 strzemiona (north + south rows) z labelem miÄ™dzy ĹĽeby NIE zachodziĹ‚o na drogÄ™ H3 (wy 2880-3072) */
  X.fillStyle='rgba(240,208,64,.85)';
  /* North row: wy 2629-2784 */
  const dripN_y1=mpy(2629), dripN_y2=mpy(2784);
  X.fillRect(dripZ_x1,dripN_y1,dripZ_x2-dripZ_x1,Math.max(2,dripN_y2-dripN_y1));
  /* South row: wy 3168-3323 */
  const dripS_y1=mpy(3168), dripS_y2=mpy(3323);
  X.fillRect(dripZ_x1,dripS_y1,dripZ_x2-dripZ_x1,Math.max(2,dripS_y2-dripS_y1));
  X.strokeStyle='rgba(255,230,120,.6)';X.lineWidth=.5;
  X.strokeRect(dripZ_x1+.25,dripN_y1+.25,dripZ_x2-dripZ_x1-.5,Math.max(2,dripN_y2-dripN_y1)-.5);
  X.strokeRect(dripZ_x1+.25,dripS_y1+.25,dripZ_x2-dripZ_x1-.5,Math.max(2,dripS_y2-dripS_y1)-.5);
  /* v2.1.173: STREFA PRAC DORYWCZYCH (south row jobs wy=2208) jako single zone */
  const jobsZ_x1=mpx(326), jobsZ_x2=mpx(3450), jobsZ_y1=mpy(2208), jobsZ_y2=mpy(2363);
  X.fillStyle='rgba(140,192,96,.85)';
  X.fillRect(jobsZ_x1,jobsZ_y1,jobsZ_x2-jobsZ_x1,Math.max(2,jobsZ_y2-jobsZ_y1));
  X.strokeStyle='rgba(180,220,140,.6)';X.lineWidth=.5;
  X.strokeRect(jobsZ_x1+.25,jobsZ_y1+.25,jobsZ_x2-jobsZ_x1-.5,Math.max(2,jobsZ_y2-jobsZ_y1)-.5);
  // Buildings â€” kolor per strefa (kolorystyka wskazuje rolÄ™)
  const parkObjs=['fountain','pond','skate','bboying','bench','bench2','park_lamp1','park_lamp2','park_lamp3','park_lamp4','park_bush1','park_bush2','park_bush3','park_trash','park_monument','park_bench2'];
  const drip=['lv','chanel','hermes','gucci','balenciaga','bottega','dior','prada'];
  const jobs=['supermarket','carwash','construction','kurier','pizzeria','restauracja','warsztat']; /* v2.1.173: dodano warsztat (byĹ‚ blue) */
  const apts=['traphouse','apt_basic','apt_premium','apt_penthouse','apt_mansion','apt_mega_villa']; /* v2.1.167: Mansion · v2.1.215: Mega Villa w minimap */
  // Budynki â€” pomijamy NPC, freestyle (rysujemy je osobno z innym wyglÄ…dem)
  ROOMS.ulica.objects.forEach(obj=>{
    if(obj.id.startsWith('npc_')) return;
    if(obj.id.startsWith('apt1_')||obj.id.startsWith('apt2_')||obj.id.startsWith('apt4_')) return;
    if(parkObjs.includes(obj.id)) return;
    if(obj.id==='freestyle_spot') return;
    if(obj.id==='parking') return; /* parking rysowany osobno poniĹĽej z dedykowanym wyglÄ…dem */
    /* v2.1.173: drip i jobs juĹĽ narysowane jako strefy powyĹĽej â€” nie duplikujemy paseczkĂłw */
    if(drip.includes(obj.id)) return;
    if(jobs.includes(obj.id)) return;
    const bx=mpx(obj.wx),by=mpy(obj.wy);
    const bw=Math.max(2,Math.round(obj.w/wW*mw)),bh=Math.max(2,Math.round(obj.h/wH*mh));
    let col='#6a9ad8'; // jaĹ›niejszy niebieski default
    if(apts.includes(obj.id)) col='#c478e0'; // jaĹ›niejszy fiolet
    X.fillStyle=col;X.fillRect(bx,by,bw,bh);
  });
  // Freestyle spot â€” pulsujÄ…ca rĂłĹĽowa kropka
  const fs=ROOMS.ulica.objects.find(o=>o.id==='freestyle_spot');
  if(fs){
    const fx=mpx(fs.wx+fs.w/2),fy=mpy(fs.wy+fs.h/2);
    const tt=Date.now()/300;
    const pls=0.6+Math.sin(tt)*0.4;
    // Halo
    X.fillStyle=`rgba(233,30,140,${0.3*pls})`;
    X.beginPath();X.arc(fx,fy,4+pls,0,Math.PI*2);X.fill();
    // GĹ‚Ăłwne kĂłĹ‚ko
    X.fillStyle='#e91e8c';
    X.beginPath();X.arc(fx,fy,2.2,0,Math.PI*2);X.fill();
    X.strokeStyle='#fff';X.lineWidth=.5;X.stroke();
  }
  // NPCs â€” ĹĽĂłĹ‚to-zĹ‚ote maĹ‚e trĂłjkÄ…ty (inne niĹĽ prostokÄ…tne budynki)
  ROOMS.ulica.objects.forEach(obj=>{
    if(!obj.id.startsWith('npc_')) return;
    const nx=mpx(obj.wx+(obj.w||34)/2),ny=mpy(obj.wy+(obj.h||56)/2);
    if(nx<mx||nx>mx+mw||ny<my||ny>my+mh) return;
    // MaĹ‚a trĂłjkÄ…tna ikona (osoba)
    X.fillStyle='#e8c850';
    X.beginPath();
    X.moveTo(nx,ny-2.5);X.lineTo(nx+2,ny+1.5);X.lineTo(nx-2,ny+1.5);X.closePath();X.fill();
    X.strokeStyle='rgba(0,0,0,.5)';X.lineWidth=.5;X.stroke();
  });
  /* v2.1.65 Amper: PARKING â€” szary prostokÄ…t z "đź…żď¸Ź". WczeĹ›niej nie byĹ‚ widoczny na minimapie. */
  const parkObj=ROOMS.ulica.objects.find(o=>o.id==='parking');
  if(parkObj){
    const pkx=mpx(parkObj.wx), pky=mpy(parkObj.wy);
    const pkw=Math.max(3,Math.round(parkObj.w/wW*mw));
    const pkh=Math.max(2,Math.round(parkObj.h/wH*mh));
    X.fillStyle='#3a3a48';X.fillRect(pkx,pky,pkw,pkh);
    X.strokeStyle='rgba(255,255,255,.4)';X.lineWidth=.5;X.strokeRect(pkx+.25,pky+.25,pkw-.5,pkh-.5);
    /* Litera P na Ĺ›rodku parkingu */
    X.font='bold 7px sans-serif';X.fillStyle='#fff';X.textAlign='center';X.textBaseline='middle';
    X.fillText('P',pkx+pkw/2,pky+pkh/2);
    X.textAlign='left';X.textBaseline='alphabetic';
  }
  /* v2.1.65 Amper: ZAPARKOWANE AUTO â€” pulsujÄ…cy ĹĽĂłĹ‚ty marker. Widoczne gdy gracz wysiadĹ‚ (na parkingu lub poza). */
  if(G.car && G._carParkedAt && !G._inCar){
    const acx=clamp(mpx(G._carParkedAt.wx),mx+2,mx+mw-2);
    const acy=clamp(mpy(G._carParkedAt.wy),my+2,my+mh-2);
    const _pulse=0.6+Math.sin(Date.now()/350)*0.4;
    /* Halo */
    X.fillStyle=`rgba(241,196,15,${0.3*_pulse})`;
    X.beginPath();X.arc(acx,acy,6+_pulse*2,0,Math.PI*2);X.fill();
    /* GĹ‚Ăłwne kĂłĹ‚ko */
    X.fillStyle='#f1c40f';
    X.beginPath();X.arc(acx,acy,3,0,Math.PI*2);X.fill();
    X.strokeStyle='#000';X.lineWidth=.7;X.stroke();
    /* Litera C/đźš— â€” bardzo maĹ‚e */
    X.font='bold 4px sans-serif';X.fillStyle='#000';X.textAlign='center';X.textBaseline='middle';
    X.fillText('C',acx,acy+0.5);
    X.textAlign='left';X.textBaseline='alphabetic';
  }
  // Quest target marker
  const tgt=_storylineTargetLoc();
  if(tgt){
    const targets=tgt.multi?tgt.targets:[tgt];
    const t=Date.now()/250;
    const pulse=0.5+Math.sin(t)*0.5;
    for(const target of targets){
      const tx=clamp(mpx(target.wx),mx+3,mx+mw-3);
      const ty=clamp(mpy(target.wy),my+3,my+mh-3);
      X.strokeStyle=`rgba(241,196,15,${0.4+pulse*0.6})`;X.lineWidth=1.5;
      X.beginPath();X.arc(tx,ty,3+pulse*3,0,Math.PI*2);X.stroke();
      X.fillStyle='#f1c40f';
      X.beginPath();X.moveTo(tx,ty-3);X.lineTo(tx+2.5,ty);X.lineTo(tx,ty+3);X.lineTo(tx-2.5,ty);X.closePath();X.fill();
      X.strokeStyle='rgba(255,255,255,.9)';X.lineWidth=.7;X.stroke();
    }
  }
  // Player dot â€” wiÄ™kszy z mocniejszym halo
  const px=clamp(mpx(P.wx),mx+2,mx+mw-2),py=clamp(mpy(P.wy),my+2,my+mh-2);
  const pgT=Math.sin(Date.now()/600)*0.5+0.5;
  // Halo zewnÄ™trzne
  X.fillStyle=`rgba(126,200,227,${0.20+pgT*0.20})`;
  X.beginPath();X.arc(px,py,7+pgT*2,0,Math.PI*2);X.fill();
  // Halo wewnÄ™trzne
  X.fillStyle=`rgba(126,200,227,${0.4+pgT*0.3})`;
  X.beginPath();X.arc(px,py,4,0,Math.PI*2);X.fill();
  // Player dot
  X.fillStyle='#fff';X.beginPath();X.arc(px,py,2.8,0,Math.PI*2);X.fill();
  X.fillStyle='#3498db';X.beginPath();X.arc(px,py,2,0,Math.PI*2);X.fill();
  // Direction arrow
  if(P.moving){
    const dx={left:-1,right:1,up:0,down:0}[P.dir]||0;
    const dy={left:0,right:0,up:-1,down:1}[P.dir]||0;
    if(dx||dy){
      X.fillStyle='#fff';
      X.beginPath();
      X.moveTo(px+dx*6,py+dy*6);
      X.lineTo(px+dx*3-dy*2,py+dy*3+dx*2);
      X.lineTo(px+dx*3+dy*2,py+dy*3-dx*2);
      X.closePath();X.fill();
    }
  }
  X.restore();
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  PANEL POSTACI â€” statystyki i drzewko umiejÄ™tnoĹ›ci
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function toggleCharPanel(){
  const cp=document.getElementById('char-panel');
  if(cp.style.display==='flex'){cp.style.display='none';return;}
  renderCharPanel();cp.style.display='flex';
}

