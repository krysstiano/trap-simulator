    const _gymDone=(G._gymSets&&((G._gymSets.strength||0)+(G._gymSets.cardio||0))>0)||(G.fitness||0)>0||(G.forma||0)>0;
    const _studioVisited=G.studioOwned||(G.visitedRooms&&G.visitedRooms.studio)||(G.careers?.raper?.tracks||0)>0;
    const postCats=[
      {label:'đź“¸ Kulisy studia',desc:'PokaĹĽ jak wyglÄ…da praca za kulisami',bonus:{followers:rnd(20,80),fame:1},cost:{energy:5},req:()=>_studioVisited,reqTxt:'Najpierw odwiedĹş studio'},
      {label:'đźŽµ Teaser nowego bitu',desc:'WrzuÄ‡ urywek nowego projektu',bonus:{followers:rnd(40,120),fame:2},cost:{energy:8},req:()=>G.careers.beatmaker.beats>0||G.careers.beatmaker.beatsSold>0,reqTxt:'Musisz najpierw zrobiÄ‡ bit'},
      {label:'đźŚ† Lifestyle',desc:'Codzienne ĹĽycie, wyjĹ›cie, miasto',bonus:{followers:rnd(10,50),fame:1},cost:{energy:3},req:null}, // zawsze dostÄ™pne â€” generic
      {label:'đźŽ¤ Po koncercie',desc:'Relacja z koncertu â€” tylko jeĹ›li graĹ‚eĹ›',bonus:{followers:rnd(60,180),fame:3},cost:{energy:10},req:()=>G.events.performed>0,reqTxt:'Najpierw zagraj koncert'},
      {label:'đź’Ş Motywacja',desc:'Inspiruj innych â€” grind mindset',bonus:{followers:rnd(15,60),fame:1},cost:{energy:4},req:()=>_gymDone,reqTxt:'Najpierw potreniuj na siĹ‚owni'},
      {label:`đźŽ¶ Promuj singiel${latestTrack?' "'+latestTrack.name+'"':''}`,desc:'+20% streamĂłw dla najnowszego tracku, wiÄ™cej sĹ‚uchaczy',bonus:{followers:rnd(50,150),fame:2},cost:{energy:12},req:()=>hasTracks,reqTxt:'Musisz najpierw wydaÄ‡ singiel',trackBoost:true},
    ];
    const posts=G.igPosts||[];
    const growing=posts.filter(p=>(p.growStage||5)<5);
    const autoST=getRaperST('autopromocja');
    ph.innerHTML=`<div class="ph-screen">
      <div style="text-align:center;padding:10px;border-bottom:1px solid #1a2535;margin-bottom:10px">
        <div style="font-size:22px;font-weight:700;margin-bottom:4px;color:#fff">@${(G.name||'user').toLowerCase()}</div>
        <div style="font-size:14px;color:#c13584;font-weight:700">${(G.followers||0).toLocaleString('pl')} obserwujÄ…cych</div>
        <div style="font-size:12px;color:#667;margin-top:2px">${posts.length} postĂłw${growing.length>0?` Â· <span style="color:#f1c40f">âŹł ${growing.length} post${growing.length>1?'y':''} roĹ›nie</span>`:''}</div>
      </div>
      ${autoST<1?`<div style="font-size:12px;color:#f1c40f;background:#1a1200;border:1px solid #3a2a00;border-radius:6px;padding:8px 10px;margin-bottom:8px">đź’ˇ Odblokuj <strong>Autopromocja 1</strong> w drzewku Rapera aby zdobywaÄ‡ +10% wiÄ™cej obserwujÄ…cych!</div>`:''}
      <details style="background:#0a0e1a;border:1px solid #1a2535;border-radius:6px;margin-bottom:10px">
        <summary style="font-size:12px;color:#c13584;font-weight:700;padding:8px 10px;cursor:pointer">đź“ Jak zwiÄ™kszaÄ‡ zasiÄ™g / followers? (kliknij)</summary>
        <div style="padding:6px 10px 10px;font-size:11px;color:#9aa;line-height:1.55">
          <div style="margin-bottom:5px"><b style="color:#e8a7c8">đź“· Posty IG (1/dzieĹ„)</b> â€” bazowo 10â€“180 followersĂłw per post; kategorie z wymaganiami dajÄ… wiÄ™cej</div>
          <div style="margin-bottom:5px"><b style="color:#c13584">đźŽ¤ Freestyle</b> â€” fani casual + followers na podstawie score; viral bonus z Flow 4+</div>
          <div style="margin-bottom:5px"><b style="color:#9b59b6">đźŽŞ Koncerty</b> â€” duĹĽy boost followersĂłw + sĹ‚awy; im wiÄ™ksza scena, tym wiÄ™cej</div>
          <div style="margin-bottom:5px"><b style="color:#27ae60">đź“˘ Autopromocja (drzewko Rapera)</b> â€” +10% / +25% / +40% (lvl 1/3/5) do follower-gainĂłw z postĂłw</div>
          <div style="margin-bottom:5px"><b style="color:#c8a520">đź’Ž Drip / prestiĹĽ (Dzielnica Dripu)</b> â€” IG posty +0.5%/pkt (drip 200 = +100% zasiÄ™g), teĹĽ zwiÄ™ksza promo z trendĂłw</div>
          <div style="margin-bottom:5px"><b style="color:#3498db">đź’Ş Forma fizyczna (G.forma)</b> â€” +0.5% follower-gain per pkt formy (postsy IG zwracajÄ… lepsze wyniki)</div>
          <div style="margin-bottom:5px"><b style="color:#e74c3c">đźŚź SĹ‚awa (fame)</b> â€” wyĹĽsza sĹ‚awa = wiÄ™cej lojalnych fanĂłw + lepsze trendy w mediach</div>
          <div style="margin-bottom:5px"><b style="color:#1da1f2">đź¦ Twitter (1 tweet/dzieĹ„)</b> â€” viral memy: 15% szans na +200 followersĂłw</div>
          <div style="margin-bottom:5px"><b style="color:#1db954">đźŽµ Streamy / royalty</b> â€” premiery singli i albumĂłw w studio dajÄ… cykliczne przyrosty sĹ‚uchaczy + IG</div>
          <div><b style="color:#f39c12">đźŹ† Milestone'y fanĂłw</b> â€” 1k/10k/100k dajÄ… jednorazowe bonusy kasy + sĹ‚awy</div>
        </div>
      </details>
      <div style="font-size:13px;color:#667;margin-bottom:8px">${canPost?`đź“· Co wrzucasz dziĹ›? (Dz. ${G.day})`:`âŹł Post wrzucony Dz. ${G.lastIGPostDay}. NastÄ™pny: Dz. ${G.lastIGPostDay+1}+ (idĹş spaÄ‡)`}</div>
      ${canPost?`<div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px">
        ${postCats.map((c,i)=>{const blocked=c.req&&!c.req();return`<button onclick="${blocked?'':'window.igPost('+i+')'}" ${blocked?'disabled':''} style="background:${blocked?'#0a0a0a':'#0a1a2a'};border:1px solid ${blocked?'#222':'#1a2a4a'};color:${blocked?'#444':'#c13584'};padding:8px 12px;border-radius:6px;cursor:${blocked?'not-allowed':'pointer'};font-size:13px;text-align:left">${c.label}<div style="font-size:11px;color:${blocked?'#e74c3c':'#667'};margin-top:2px">${blocked?'đź”’ '+c.reqTxt:c.desc}</div></button>`;}).join('')}
      </div>`:''}
      <div style="font-size:12px;color:#445;margin-bottom:6px">Ostatnie posty:</div>
      ${posts.slice(-5).reverse().map(p=>{
        const stage=p.growStage||5;const growing=stage<5;
