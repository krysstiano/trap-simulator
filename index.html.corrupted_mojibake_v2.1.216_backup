  networking: {label:'Networking',max:3,cat:'ekonomia',desc:'WiÄ™cej kontaktĂłw NPC, szybsze znajomoĹ›ci',emoji:'đź¤ť',perLvl:1,op:'+',eff:'kontaktĂłw NPC',unit:'',
    powerUps:_PU('Wymiana wizytĂłwek (+1 kontakt)', 'LinkedIn pro (+2 kontakty)', 'Insider network (+3 kontakty)'),
    evolution:_EVO('Influencer Network', 'Wszyscy NPC dajÄ… bonus +20% z kaĹĽdej interakcji')},

  // â”€â”€â”€ đźŽ¨ STYL & SCENA â”€â”€â”€
  drip_master: {label:'Drip Master',max:5,cat:'styl',desc:'WiÄ™ksza sĹ‚awa przy pierwszym zaĹ‚oĹĽeniu nowego outfitu',emoji:'đź’Ž',perLvl:5,op:'+',eff:'sĹ‚awa outfitĂłw',
    powerUps:_PU('Akcesoria (+30% sĹ‚awa)', 'Designer brand (+60% sĹ‚awa)', 'Limited edition (+90% sĹ‚awa)'),
    evolution:_EVO('Trendsetter', 'Wszystkie ubrania -20% ceny')},
  scena: {label:'Scena',max:5,cat:'styl',desc:'WiÄ™ksze zarobki z koncertĂłw',emoji:'đźŽ­',perLvl:5,op:'+',eff:'zarobki koncertĂłw',
    powerUps:_PU('Charisma (+15% zarobki)', 'Pyrotechnika (+30% zarobki)', 'Encore (+45% zarobki)'),
    evolution:_EVO('Showman', '+50% wszystkich zarobkĂłw z koncertĂłw (kumulacja)')},
  flow: {label:'Flow',max:5,cat:'styl',desc:'WyĹĽszy score w freestyle',emoji:'đźŽ¤',perLvl:5,op:'+',eff:'score freestyle',
    powerUps:_PU('Pewne rymy (+15% score)', 'Multisylaby (+30% score)', 'NieskrÄ™powany flow (+45% score)'),
    evolution:_EVO('Battle King', '+50% score freestyle (kumulacja)')},
  foto: {label:'Foto',max:3,cat:'styl',desc:'WiÄ™kszy zasiÄ™g postĂłw na Instagramie',emoji:'đź“¸',perLvl:5,op:'+',eff:'zasiÄ™g postĂłw',
    powerUps:_PU('Naturalne Ĺ›wiatĹ‚o (+15% zasiÄ™g)', 'Filtry pro (+30% zasiÄ™g)', 'Studio backdrop (+45% zasiÄ™g)'),
    evolution:_EVO('Visual Artist', 'Posty +30% zasiÄ™g (kumulacja z power-ups)')},

  // â”€â”€â”€ đźŹ FIZYCZNE â”€â”€â”€
  sila: {label:'SiĹ‚a',max:5,cat:'fizyczne',desc:'WiÄ™kszy bonus formy z treningu siĹ‚owego',emoji:'đź’Ş',perLvl:5,op:'+',eff:'forma z treningu',
    powerUps:_PU('EksplozywnoĹ›Ä‡ (+15% forma)', 'Hipertrofia (+30% forma)', 'Stalowa siĹ‚a (+45% forma)'),
    evolution:_EVO('Athletyk', '+50% przyrostu Formy na Ĺ‚awce (kumulacja z PU)')},
  bieg: {label:'Bieg',max:3,cat:'fizyczne',desc:'StaĹ‚a prÄ™dkoĹ›Ä‡ ruchu gracza',emoji:'đźŹ',perLvl:2,op:'+',eff:'prÄ™dkoĹ›Ä‡ gracza',
    powerUps:_PU('WytrwaĹ‚oĹ›Ä‡ (+5% prÄ™dkoĹ›Ä‡)', 'Drugi oddech (+10% prÄ™dkoĹ›Ä‡)', 'MaratoĹ„czyk (+15% prÄ™dkoĹ›Ä‡)'),
    evolution:_EVO('Maraton', '+15% prÄ™dkoĹ›Ä‡ pieszego (kumulacja z PU)')},
  medytacja: {label:'Medytacja',max:3,cat:'fizyczne',desc:'Lepsza regeneracja energii podczas snu',emoji:'đź§',perLvl:5,op:'+',eff:'regen energii',
    powerUps:_PU('Spokojny sen (+15% regen)', 'GĹ‚Ä™boka faza (+30% regen)', 'REM mistrz (+45% regen)'),
    evolution:_EVO('WewnÄ™trzny spokĂłj', 'Sen daje 2Ă— wiÄ™cej energii (kumulacja)')},
  dieta: {label:'Zdrowa dieta',max:3,cat:'fizyczne',desc:'WiÄ™cej energii z domowego gotowania',emoji:'đźĄ—',perLvl:5,op:'+',eff:'energia z gotowania',
    powerUps:_PU('Witaminy (+15% energia)', 'BiaĹ‚ko premium (+30% energia)', 'Superfood (+45% energia)'),
    evolution:_EVO('Nutricionist', '+25% energii z gotowania (kumulacja z PU)')},
};

function renderCharPanel(){
  const sk=G.skills||{};const sp=G.skillPoints||0;
  // F3.5: kategorie z kolorami akcentu (epicki UI)
  const catData={
    praca:    {label:'đź’Ľ Prace Dorywcze',    color:'#3498db', grad:'linear-gradient(135deg,#1a3a5a,#0a1a3a)'},
    kariera:  {label:'đźŽ¤ Kariery',            color:'#9b59b6', grad:'linear-gradient(135deg,#3a1a4a,#1a0a3a)'},
    zycie:    {label:'âť¤ď¸Ź Ĺ»ycie i Przetrwanie', color:'#27ae60', grad:'linear-gradient(135deg,#0a3a1a,#0a2a0a)'},
    intelekt: {label:'đź§  Intelekt',            color:'#f1c40f', grad:'linear-gradient(135deg,#3a3a0a,#2a2a0a)'},
    ekonomia: {label:'đź’° Ekonomia',            color:'#e67e22', grad:'linear-gradient(135deg,#3a2a0a,#2a1a0a)'},
    styl:     {label:'đźŽ¨ Styl & Scena',       color:'#e91e8c', grad:'linear-gradient(135deg,#3a0a2a,#2a0a1a)'},
    fizyczne: {label:'đźŹ Fizyczne',            color:'#e74c3c', grad:'linear-gradient(135deg,#3a1a1a,#2a0a0a)'},
  };
  // Aktywna kategoria zachowana w G (default praca)
  if(!G._charPanelCat || !catData[G._charPanelCat]) G._charPanelCat = 'praca';
  const activeCat = G._charPanelCat;
  const activeData = catData[activeCat];
  // Liczniki postepu per kategoria (do badge na tabach) â€” pomijaj hidden skills
  const catProgress = {};
  for(const cat of Object.keys(catData)){
    const skills = Object.entries(SKILL_DEF).filter(([k,v])=>v.cat===cat && !v.hidden);
    let totalLvl=0, maxLvl=0, evos=0;
    for(const [k,def] of skills){
      totalLvl += getSkillLvl(k);
      maxLvl += def.max;
      if(hasSkillEvolution(k)) evos++;
    }
    catProgress[cat] = { totalLvl, maxLvl, count: skills.length, evos };
  }
  // Backward compat â€” istniejÄ…cy kod uĹĽywa cats jako label-only
  const cats = {};
  for(const [k,v] of Object.entries(catData)) cats[k] = v.label;
  let html=`
  <div style="display:flex;gap:30px;flex-wrap:wrap;align-items:flex-start">
    <div style="min-width:200px">
      <div style="background:#0a1220;border:1px solid #1a2a3a;border-radius:8px;padding:16px;margin-bottom:14px">
        <div style="font-size:18px;color:#7ec8e3;font-weight:700;margin-bottom:8px">đź‘¤ ${G.name}</div>
        <div style="font-size:14px;color:#aaa;line-height:1.8">
          <div>Poziom: <b style="color:#f1c40f">${G.level}</b></div>
          <div>XP: ${G.xp} / ${Math.floor(150*Math.pow(1.8,G.level-1))}</div>
          <div>SĹ‚awa: ${Math.floor(G.fame||0)}%</div>
          <div>Kondycja: ${Math.floor(G.fitness||0)}/${typeof getMaxStat==='function'?getMaxStat('fitness'):100}</div>
          <div>Rep uliczna: ${Math.floor(G.streetRep||0)}/100</div>
          <div>ĹÄ…cznie zarobione: ${(G.totalEarned||0).toLocaleString('pl')} zĹ‚</div>
          ${G.mic?`<div>Mikrofon: ${G.mic.name}</div>`:''}
          ${G.audioInterface?`<div>Interfejs: ${G.audioInterface.name}</div>`:''}
          ${G.headphones?`<div>SĹ‚uchawki: ${G.headphones.name}</div>`:''}
        </div>
      </div>
      <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:8px;padding:14px">
        <div style="color:#f1c40f;font-size:15px;font-weight:700;margin-bottom:4px">đźŽŻ Punkty umiejÄ™tnoĹ›ci</div>
        <div style="font-size:28px;color:#f1c40f;font-weight:900">${sp}</div>
        <div style="font-size:12px;color:#556;margin-top:4px">+2 punkty za kaĹĽdy poziom</div>
      </div>
    </div>
    <div style="flex:1;min-width:400px">
      <h2 style="margin-bottom:8px;background:linear-gradient(135deg,#f1c40f,#e67e22);-webkit-background-clip:text;background-clip:text;color:transparent;font-size:22px;letter-spacing:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">đźŚł DRZEWKO UMIEJÄTNOĹšCI</h2>
      <p style="color:#789;font-size:11px;margin:0 0 14px 0;font-style:italic">Wybierz kategoriÄ™ i rozwijaj â€˘ 3 fazy: Skill â†’ Power-ups â†’ Evolution đź‘‘</p>
      <!-- F3-FIX-C: Tabs kompaktowe (mniejszy font/padding zeby wszystkie 7 sie miescily) -->
      <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:14px;border-bottom:2px solid #1a2a3a;padding-bottom:8px">
        ${Object.entries(catData).map(([k,d])=>{
          const isActive = k === activeCat;
          const prog = catProgress[k];
          // SkroÄ‡ label do samego emoji + skrĂłconej nazwy
          return `<button onclick="window.switchCharPanelCat('${k}')" style="background:${isActive ? d.grad : '#0a1220'};border:1px solid ${isActive ? d.color : '#1a2a3a'};color:${isActive ? '#fff' : '#778'};padding:5px 8px;border-radius:6px 6px 0 0;cursor:pointer;font-size:10px;font-weight:700;letter-spacing:0.3px;transition:all 0.2s;flex:1 1 auto;min-width:90px;${isActive ? `box-shadow:0 -2px 8px ${d.color}60;` : ''}">
            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${d.label}</div>
            <div style="font-size:9px;color:${isActive ? d.color : '#556'};margin-top:1px">${prog.totalLvl}/${prog.maxLvl}${prog.evos > 0 ? ` Â· ${prog.evos}đź‘‘` : ''}</div>
          </button>`;
        }).join('')}
      </div>
      <!-- Aktywna kategoria â€” header z gradientem -->
      <div style="background:${activeData.grad};border:1px solid ${activeData.color};border-radius:8px;padding:12px;margin-bottom:14px;text-align:center">
        <h3 style="margin:0;color:${activeData.color};font-size:18px;letter-spacing:2px;font-weight:900">${activeData.label}</h3>
        <p style="margin:4px 0 0 0;color:#aac;font-size:11px">${Object.entries(SKILL_DEF).filter(([k,v])=>v.cat===activeCat && !v.hidden).length} umiejÄ™tnoĹ›ci w tej kategorii</p>
      </div>`;

  // Renderuj TYLKO aktywnÄ… kategoriÄ™. Filtr !v.hidden zostawiony, ale obecnie ĹĽaden skill nie ma hidden:true (bieg/hazard widoczne)
  for(const [catKey,catLabel] of Object.entries(cats).filter(([k])=>k===activeCat)){
    const catSkills=Object.entries(SKILL_DEF).filter(([k,v])=>v.cat===catKey && !v.hidden);
    html+=`<div style="margin-bottom:18px"><div style="display:flex;gap:10px;flex-wrap:wrap">`;
    for(const [key,def] of catSkills){
      const cur=getSkillLvl(key);const max=def.max;const canUp=sp>0&&cur<max;
      const pct=cur/max*100;
      const isMaxed = cur >= max;
      const pu = getSkillPowerUps(key); // 0-3
      const evo = hasSkillEvolution(key);
      // Determine border color â€” wzbogacone wg postepu
      const borderCol = evo ? '#f1c40f' : pu === 3 ? '#a020c0' : pu > 0 ? '#9b59b6' : cur > 0 ? '#2a4a6a' : '#1a2a3a';
      // F3-FIX-C: dynamiczne "Aktualnie X / NastÄ™pny Y" z perLvl/op/eff
      // F3-AUDYT: pole 'unit' (domyslnie '%', dla networking '' bo to liczba kontaktow)
      let currentEffStr = '', nextEffStr = '';
      if(def.perLvl !== undefined){
        const op = def.op || '+';
        const eff = def.eff || '';
        const unit = def.unit !== undefined ? def.unit : '%';
        const curVal = cur * def.perLvl;
        const nxtVal = Math.min(cur + 1, max) * def.perLvl;
        currentEffStr = `<div style="font-size:11px;color:${cur>0?'#27ae60':'#556'};margin-bottom:2px">Aktualnie: <b>${cur===0?'brak':op+curVal+unit}</b> ${eff}</div>`;
        if(!isMaxed){
          nextEffStr = `<div style="font-size:11px;color:#9bc8e3;margin-bottom:6px">NastÄ™pny: <b>${op}${nxtVal}${unit}</b> (po +1 pkt)</div>`;
        } else {
          nextEffStr = `<div style="font-size:11px;color:#f1c40f;margin-bottom:6px">âś“ MAX: ${op}${max*def.perLvl}${unit} ${eff}</div>`;
        }
      }
      html+=`<div style="background:#0a1220;border:1px solid ${borderCol};border-radius:8px;padding:12px;width:230px">
        <div style="font-size:22px;margin-bottom:4px">${def.emoji}${evo?' đź‘‘':''}</div>
        <div style="font-size:13px;font-weight:700;color:${cur>0?'#7ec8e3':'#aaa'};margin-bottom:4px">${def.label}</div>
        <div style="font-size:11px;color:#556;margin-bottom:6px;line-height:1.4">${def.desc}</div>
        ${currentEffStr}${nextEffStr}
        <div style="background:#0a0a14;border-radius:4px;height:6px;margin-bottom:6px;overflow:hidden"><div style="width:${pct}%;height:100%;background:${isMaxed?'#f1c40f':'#3498db'};border-radius:4px"></div></div>
        <div style="font-size:11px;color:#667;margin-bottom:6px">Skill: ${cur}/${max} pkt</div>
        <button onclick="window.spendSkill('${key}')" style="width:100%;background:${canUp?'#1a3a6a':'#0a0a14'};border:1px solid ${canUp?'#3498db':'#1a2a3a'};color:${canUp?'#7ec8e3':'#334'};padding:6px;border-radius:4px;cursor:${canUp?'pointer':'not-allowed'};font-size:12px;margin-bottom:6px">${isMaxed?'âś“ MAX':canUp?'+ Ulepsz (1 pkt)':'Brak pkt'}</button>
        ${(isMaxed && def.powerUps) ? `
          <div style="border-top:1px solid #1a2a3a;padding-top:6px;margin-top:6px">
            <div style="font-size:10px;color:#a060c0;font-weight:700;margin-bottom:4px">âšˇ POWER-UPS ${pu}/3</div>
            ${def.powerUps.map((p,i)=>{
              const owned = i < pu;
              const canBuy = !owned && i === pu && (G.money||0) >= p.cost;
              const statusIcon = owned?'âś…':canBuy?'đź”“':'đź”’';
              const nameCol = owned?'#27ae60':canBuy?'#9b59b6':'#445';
              const btnHtml = owned ? `<span style="font-size:9px;color:#27ae60;font-weight:700">KUPIONE</span>` :
                `<button ${canBuy?'':'disabled'} onclick="window.buyPowerUp('${key}',${i})" style="background:${canBuy?'#3a1a5a':'#0a0a14'};border:1px solid ${canBuy?'#9b59b6':'#1a2a3a'};color:${canBuy?'#cf9be8':'#334'};padding:2px 6px;border-radius:3px;cursor:${canBuy?'pointer':'not-allowed'};font-size:9px;white-space:nowrap">${p.cost} zĹ‚</button>`;
              return `<div style="display:flex;align-items:center;gap:4px;margin-bottom:4px;font-size:10px">
                <span style="flex-shrink:0">${statusIcon}</span>
                <span style="color:${nameCol};flex:1;line-height:1.3;word-break:break-word" title="${p.name}">${p.name}</span>
                <span style="flex-shrink:0">${btnHtml}</span>
              </div>`;
            }).join('')}
          </div>` : ''}
        ${(isMaxed && def.evolution && pu === 3 && !evo) ? `
          <div style="border-top:1px solid #1a2a3a;padding-top:6px;margin-top:6px">
            <div style="font-size:10px;color:#f1c40f;font-weight:700;margin-bottom:4px">đź‘‘ EVOLUTION</div>
            <div style="font-size:10px;color:#aac;margin-bottom:4px">${def.evolution.name}: ${def.evolution.desc}</div>
            <button onclick="window.buyEvolution('${key}')" ${(G.money||0)>=def.evolution.cost && sp>=def.evolution.skillPointCost ? '' : 'disabled'} style="width:100%;background:${(G.money||0)>=def.evolution.cost && sp>=def.evolution.skillPointCost ? '#5a3a1a' : '#0a0a14'};border:1px solid ${(G.money||0)>=def.evolution.cost && sp>=def.evolution.skillPointCost ? '#f1c40f' : '#1a2a3a'};color:${(G.money||0)>=def.evolution.cost && sp>=def.evolution.skillPointCost ? '#f1c40f' : '#334'};padding:4px;border-radius:3px;cursor:${(G.money||0)>=def.evolution.cost && sp>=def.evolution.skillPointCost ? 'pointer' : 'not-allowed'};font-size:10px;font-weight:700">EWOLUUJ (${def.evolution.cost} zĹ‚ + ${def.evolution.skillPointCost} pkt)</button>
          </div>` : ''}
        ${evo ? `<div style="border-top:1px solid #5a3a1a;padding-top:6px;margin-top:6px;background:rgba(241,196,15,0.1);border-radius:4px;padding:6px">
            <div style="font-size:10px;color:#f1c40f;font-weight:700">đź‘‘ EWOLUOWANE</div>
            <div style="font-size:10px;color:#dde">${def.evolution.name}</div>
          </div>` : ''}
      </div>`;
    }
    html+=`</div></div>`;
  }
  html+=`</div></div><button class="cbtn" style="margin-top:14px" onclick="toggleCharPanel()">âś• Zamknij</button>`;
  document.getElementById('char-panel-content').innerHTML=html;

  window.spendSkill=(key)=>{
    if((G.skillPoints||0)<=0) return;
    const def=SKILL_DEF[key];if(!def) return;
    const cur=getSkillLvl(key);if(cur>=def.max) return;
    G.skillPoints--;
    setSkillLvl(key, cur+1); // helper auto-konwertuje number â†’ object
    // Career unlock side-effects
    if(key==='youtuber'&&cur===0) G.careers.youtuber.unlocked=true;
    if(key==='beatmaker'&&cur===0) G.careers.beatmaker.unlocked=true;
    if(key==='gamer'&&cur===0) G.careers.gamer.unlocked=true;
    if(key==='influencer'&&cur===0) G.careers.influencer.unlocked=true;
    if(key==='soundeng'&&cur===0) G.careers.soundeng.unlocked=true;
    if(key==='raper'&&cur===0){
      if(!G.careers.raper) G.careers.raper={level:0,freestyles:0,tracks:0,xp:0,skillPts:0};
      G.careers.raper.unlocked=true;
      G.careers.raper.skillPts=(G.careers.raper.skillPts||0)+1; // bonus startowy 1 pkt na drzewko rapera
      notify(`đźŽ¤ KARIERA RAPERA ODBLOKOWANA! OtwĂłrz Telefon â†’ đźŽ¤ Raper aby rozwinÄ…Ä‡ drzewko (Flow, Teksty, Scena, Mikser, Biznes...). Otrzymujesz +1 punkt umiejÄ™tnoĹ›ci rapera.`);
      renderCharPanel();
      return;
    }
    notify(`âś… Ulepszono: ${def.label} â†’ ${cur+1}/${def.max}`);
    renderCharPanel();
  };

  // F3.5: switch miÄ™dzy kategoriami (epicki UI tabs)
  window.switchCharPanelCat = (cat) => {
    G._charPanelCat = cat;
    renderCharPanel();
  };

  // Power-ups â€” kupowane za $$ po wymaksowaniu skill
  window.buyPowerUp = (key, idx) => {
    const def = SKILL_DEF[key]; if(!def || !def.powerUps) return;
    const cur = getSkillLvl(key);
    if(cur < def.max) { notify('âťŚ Najpierw wymaksuj umiejÄ™tnoĹ›Ä‡!','r'); return; }
    const pu = getSkillPowerUps(key);
    if(idx !== pu) { notify('âťŚ Power-upy musisz kupowaÄ‡ po kolei','r'); return; }
    if(pu >= 3) { notify('âś“ Wszystkie power-upy wykupione','i'); return; }
    const cost = def.powerUps[idx].cost;
    if((G.money||0) < cost) { notify(`âťŚ Brakuje pieniÄ™dzy (${cost} zĹ‚)`,'r'); return; }
    G.money -= cost;
    setSkillPowerUps(key, pu + 1);
    notify(`âšˇ Power-up ${idx+1}/3 zakupiony: ${def.powerUps[idx].name} (-${cost} zĹ‚)`,'g');
    if(typeof updateHUD === 'function') updateHUD();
    renderCharPanel();
  };

  // Evolution â€” najwyĹĽszy etap (1Ă— per skill, droga, daje unique mechanic)
  window.buyEvolution = (key) => {
    const def = SKILL_DEF[key]; if(!def || !def.evolution) return;
    const cur = getSkillLvl(key);
    if(cur < def.max) { notify('âťŚ Najpierw wymaksuj skill','r'); return; }
    if(getSkillPowerUps(key) < 3) { notify('âťŚ Najpierw wykupij wszystkie 3 power-upy','r'); return; }
    if(hasSkillEvolution(key)) { notify('âś“ JuĹĽ ewoluowane','i'); return; }
    const evo = def.evolution;
    if((G.money||0) < evo.cost) { notify(`âťŚ Brakuje pieniÄ™dzy (${evo.cost} zĹ‚)`,'r'); return; }
    if((G.skillPoints||0) < evo.skillPointCost) { notify(`âťŚ Brakuje punktĂłw umiejÄ™tnoĹ›ci (${evo.skillPointCost})`,'r'); return; }
    G.money -= evo.cost;
    G.skillPoints -= evo.skillPointCost;
    setSkillEvolution(key, true);
    // Cinematic milestone dla ewolucji!
    if(typeof showMilestoneCinematic === 'function'){
      showMilestoneCinematic({
        emoji:'đź‘‘', title:'EVOLUTION', subtitle:`${def.label} â†’ ${evo.name}`,
        tagline:evo.desc, accentColor:'#f1c40f', accent2:'#e67e22', duration:5000
      });
    }
    if(typeof updateHUD === 'function') updateHUD();
    renderCharPanel();
  };
}

function updateHUDFace(){
  const fc=document.getElementById('hud-face');if(!fc) return;
  const cx=fc.getContext('2d');const W=54,H=54;cx.clearRect(0,0,W,H);
  const skinColors={light:'#e0a870',medium:'#c07840',dark:'#703818'};
  const sc=skinColors[P.skin||G.skin]||'#e0a870';
  cx.fillStyle='#0a1a2a';cx.beginPath();cx.arc(27,27,27,0,Math.PI*2);cx.fill();
  // Shirt
  cx.fillStyle=P.cloth||'#2a5080';cx.fillRect(8,39,38,18);
  // Neck
  cx.fillStyle=sc;cx.fillRect(21,32,12,10);
  // Head
  cx.fillStyle=sc;cx.fillRect(14,18,26,20);cx.beginPath();cx.arc(27,21,13,Math.PI,0);cx.fill();
  // Eyes
  cx.fillStyle='rgba(0,0,0,.75)';cx.fillRect(19,21,5,5);cx.fillRect(30,21,5,5);
  // Usta â€” odzwierciedlajÄ… nastrĂłj (G.stress = mood, 100=relaks)
  cx.strokeStyle='rgba(0,0,0,.65)';cx.lineWidth=1.8;cx.beginPath();
  const mood=G.stress||50;
  if(mood>=70){// uĹ›miech
    cx.arc(27,28,5,0.2,Math.PI-0.2);
  } else if(mood>=40){// neutralne
    cx.moveTo(22,31);cx.lineTo(32,31);
  } else {// smutek/zmÄ™czenie
    cx.arc(27,34,5,Math.PI+0.2,2*Math.PI-0.2);
  }
  cx.stroke();
  // Hair
  if(P.hair===0){
    cx.fillStyle='#3a2010';
    cx.beginPath();cx.arc(27,17,13,Math.PI,0);cx.fill();cx.fillRect(14,17,26,7);
  } else if(P.hair===1){
    cx.fillStyle='#1a1008';
    cx.beginPath();cx.arc(27,17,13,Math.PI,0);cx.fill();cx.fillRect(14,17,26,7);
    cx.fillRect(11,17,5,28);cx.fillRect(38,17,5,28);
  } else if(P.hair===2){
    // Dreads: dark brown skullcap covering top of head, thick strands hanging down from cap edge
    cx.fillStyle='#4a2808';
    cx.beginPath();cx.arc(27,17,13,Math.PI,0);cx.fill();cx.fillRect(14,17,26,8);
    // 8 thick dread strands hanging from cap edge
    const strandPositions=[14,17,20,23,26,29,32,35];
    for(let i=0;i<8;i++){
      const dx=strandPositions[i];
      const dl=8+(i%4)*2;
      cx.fillStyle='#6b3a10';cx.beginPath();cx.roundRect(dx,25,3,dl*.75,1);cx.fill();
      cx.fillStyle='#c8a060';cx.beginPath();cx.roundRect(dx,25+dl*.75,3,dl*.25+1,1);cx.fill();
      // rounded tip
      cx.fillStyle='#c8a060';cx.beginPath();cx.arc(dx+1.5,25+dl+1,1.5,0,Math.PI*2);cx.fill();
    }
  }
  // P.hair===3: bald â€” no hair drawn
}

// â”€â”€ INTERACTION HIGHLIGHT â€” subtle glow wokol najblizszego interaktywnego obiektu â”€â”€
/* v1.9.89/v1.9.92: Cinematic highlight â€” fade-in/out + radar sweep + smooth pierĹ›cienie */
function drawCinemHighlight(){
  if(!window._cinemCam || !window._cinemCam.active) return;
  const hl=window._cinemCam.highlight;
  if(!hl) return;
  /* v1.9.92: opacity sterowane animacjÄ… z openCinematicFlythrough */
  const op = window._cinemCam.hlOpacity;
  if(!op || op<0.02) return;
  const sx=hl.wx-cam.x, sy=hl.wy-cam.y;
  const r=hl.r||140;
  const t=Date.now()/600;
  const pulse=0.5+Math.sin(t)*0.5;
  X.save();
  /* v1.9.92: ciemne tĹ‚o z miÄ™kkÄ… dziurÄ… (radial gradient zamiast hard cutoff) */
  /* Najpierw soft mask â€” radial gradient od full opacity na brzegu do clear w centrum */
  const maskG=X.createRadialGradient(sx,sy,r*0.5,sx,sy,Math.max(1280,720));
  maskG.addColorStop(0,`rgba(0,0,0,0)`);
  maskG.addColorStop(0.15,`rgba(0,0,0,${0.15*op})`);
  maskG.addColorStop(0.5,`rgba(0,0,0,${0.55*op})`);
  maskG.addColorStop(1,`rgba(0,0,0,${0.7*op})`);
  X.fillStyle=maskG;
  X.fillRect(0,0,1280,720);
  /* v1.9.92: 3 pulsujÄ…ce pierĹ›cienie z desync phase (kaĹĽdy pulsuje w innym tempie) */
  for(let i=0;i<3;i++){
    const phase=t+i*0.7;
    const localPulse=0.5+Math.sin(phase)*0.5;
    const ringR=r+i*26+localPulse*22;
    const alpha=(0.6-i*0.18)*(0.7+localPulse*0.3)*op;
    X.strokeStyle=`rgba(200,165,32,${alpha})`;
    X.lineWidth=(3.5-i*0.7);
    X.shadowColor='rgba(241,196,15,.6)';
    X.shadowBlur=12;
    X.beginPath();X.arc(sx,sy,ringR,0,Math.PI*2);X.stroke();
  }
  X.shadowBlur=0;
  /* v1.9.92: RADAR SWEEP â€” rozszerzajÄ…cy siÄ™ pierĹ›cieĹ„ ktĂłry wybiega na zewnÄ…trz (3-sec loop) */
  const sweepT = (Date.now()%3000)/3000; /* 0..1 cyclic */
  const sweepR = r + sweepT*120;
  const sweepAlpha = (1-sweepT)*0.7*op;
  X.strokeStyle=`rgba(241,196,15,${sweepAlpha})`;
  X.lineWidth=2.5;
  X.beginPath();X.arc(sx,sy,sweepR,0,Math.PI*2);X.stroke();
  /* Drugi sweep z offsetem fazowym 1.5s */
  const sweep2T = ((Date.now()+1500)%3000)/3000;
  const sweep2R = r + sweep2T*120;
  const sweep2Alpha = (1-sweep2T)*0.5*op;
  X.strokeStyle=`rgba(255,220,100,${sweep2Alpha})`;
  X.lineWidth=2;
  X.beginPath();X.arc(sx,sy,sweep2R,0,Math.PI*2);X.stroke();
  /* v1.9.92: Glow w centrum â€” wiÄ™kszy radial gradient ĹĽĂłĹ‚ty */
  const g=X.createRadialGradient(sx,sy,0,sx,sy,r);
  g.addColorStop(0,`rgba(241,196,15,${0.22*op})`);
  g.addColorStop(0.5,`rgba(241,196,15,${0.08*op})`);
  g.addColorStop(1,`rgba(241,196,15,0)`);
  X.fillStyle=g;
  X.beginPath();X.arc(sx,sy,r,0,Math.PI*2);X.fill();
  /* v1.9.92: 4 punkty kierunkowe (north/east/south/west) jako markery */
  X.fillStyle=`rgba(255,220,100,${0.8*op*(0.6+pulse*0.4)})`;
  const dirs=[[0,-r-12],[r+12,0],[0,r+12],[-r-12,0]];
  for(const [dx,dy] of dirs){
    X.beginPath();X.arc(sx+dx,sy+dy,3.5,0,Math.PI*2);X.fill();
  }
  X.restore();
}

function drawInteractionHighlight(){
  if(overlayOpen()||phoneOpen()||npcDlgOpen())return;
  if(typeof getNear!=='function')return;
  const nearId=getNear();
  if(!nearId)return;
  const obj=ROOMS[currentRoom]?.objects.find(o=>o.id===nearId);
  if(!obj)return;
  const sx=wx2sx(obj.wx), sy=wy2sy(obj.wy);
  // Tylko gdy obiekt jest na ekranie
  if(sx+obj.w<-50||sx>1330||sy+obj.h<-50||sy>770)return;
  const t=Date.now()/350;
  const pulse=0.5+Math.sin(t)*0.5;
  X.save();
  // Outer glow
  X.shadowBlur=12+pulse*6;
  X.shadowColor='rgba(126,200,227,.85)';
  X.strokeStyle=`rgba(126,200,227,${0.55+pulse*0.35})`;
  X.lineWidth=2;
  if(X.roundRect){
    X.beginPath();X.roundRect(sx-3,sy-3,obj.w+6,obj.h+6,5);X.stroke();
  } else {
    X.strokeRect(sx-3,sy-3,obj.w+6,obj.h+6);
  }
  X.shadowBlur=0;
  // Cztery rogi-akcenty (corner brackets) â€” bardziej "selected" feel
  const cl=10;
  X.strokeStyle=`rgba(241,196,15,${0.7+pulse*0.3})`;
  X.lineWidth=2.5;
  // TL
  X.beginPath();X.moveTo(sx-3,sy-3+cl);X.lineTo(sx-3,sy-3);X.lineTo(sx-3+cl,sy-3);X.stroke();
  // TR
  X.beginPath();X.moveTo(sx+obj.w+3-cl,sy-3);X.lineTo(sx+obj.w+3,sy-3);X.lineTo(sx+obj.w+3,sy-3+cl);X.stroke();
  // BL
  X.beginPath();X.moveTo(sx-3,sy+obj.h+3-cl);X.lineTo(sx-3,sy+obj.h+3);X.lineTo(sx-3+cl,sy+obj.h+3);X.stroke();
  // BR
  X.beginPath();X.moveTo(sx+obj.w+3-cl,sy+obj.h+3);X.lineTo(sx+obj.w+3,sy+obj.h+3);X.lineTo(sx+obj.w+3,sy+obj.h+3-cl);X.stroke();
  X.restore();
}

// â”€â”€ QUEST COMPASS â€” edge-of-screen arrow wskazujacy cel storyline â”€â”€
// #80: WskaĹşnik "[V] WsiÄ…dĹş do auta" gdy gracz na ulicy z autem ale nie wsiadĹ‚
function drawQuestCompass(){
  if(currentRoom!=='ulica') return;
  const tgt=_storylineTargetLoc();
  if(!tgt) return;
  // Multi-target (firstjob): nie wskazujemy konkretnej pracy â€” gracz sam wybiera spoĹ›rĂłd 6.
  // PeĹ‚na mapa pokazuje wszystkie 6 pinĂłw, ale na ekranie nie ma strzaĹ‚ki.
  if(tgt.multi) return;
  // Pozycja celu na ekranie
  const tsx=tgt.wx-cam.x;
  const tsy=tgt.wy-cam.y+62; // 62 = HUD offset
  const W=1280, H=720;
  const margin=32;
  // Czy cel jest na ekranie (z marginesem) â€” jesli tak, pokaz tylko subtle ring
  const onScreen=tsx>=margin&&tsx<=W-margin&&tsy>=62+margin&&tsy<=H-margin;
  if(onScreen){
    // Pulsujacy ring wokol celu na ekranie
    const t=Date.now()/300;
    const pulse=0.5+Math.sin(t)*0.5;
    X.save();
    X.strokeStyle=`rgba(241,196,15,${0.45+pulse*0.45})`;
    X.lineWidth=2.5;
    X.beginPath();X.arc(tsx,tsy,18+pulse*8,0,Math.PI*2);X.stroke();
    X.strokeStyle=`rgba(255,255,255,${0.25+pulse*0.3})`;
    X.lineWidth=1.5;
    X.beginPath();X.arc(tsx,tsy,28+pulse*4,0,Math.PI*2);X.stroke();
    // #68: usuniÄ™to emoji nad celem gdy onScreen â€” obiekt juĹĽ ma wĹ‚asnÄ… ikonÄ™ (np. đźŽ¤ w drawFreestyleSpot),
    // dublowanie powodowaĹ‚o "2 mikrofony". Ring+pulse wystarczÄ… do zidentyfikowania celu.
    X.restore();
    return;
  }
  // Cel poza ekranem â€” strzalka na krawedzi
  // Wektor od srodka ekranu do celu
  const cx=W/2, cy=(62+H)/2;
  const dx=tsx-cx, dy=tsy-cy;
  // Kierunek
  const ang=Math.atan2(dy,dx);
  // Punkt na krawedzi (z marginesem)
  const halfW=W/2-margin, halfH=(H-62)/2-margin;
  const tan=Math.tan(ang);
  let ex,ey;
  if(Math.abs(dx*halfH)>Math.abs(dy*halfW)){
    // Lewa lub prawa
    ex=dx>0?halfW:-halfW;
    ey=ex*tan;
  } else {
    ey=dy>0?halfH:-halfH;
    ex=ey/tan;
  }
  const ax=cx+ex, ay=cy+ey;
  // Dystans w kafelkach
  const dist=Math.round(Math.hypot(tgt.wx-(P.wx+P.w/2),tgt.wy-(P.wy+P.h/2))/T);
  // Rysuj strzalke
  X.save();
  X.translate(ax,ay);
  X.rotate(ang);
  // Tlo
  const t=Date.now()/300;
  const pulse=0.5+Math.sin(t)*0.5;
  X.fillStyle=`rgba(241,196,15,${0.85+pulse*0.15})`;
  X.strokeStyle='rgba(0,0,0,.6)';
  X.lineWidth=1.5;
  X.beginPath();
  X.moveTo(20,0);
  X.lineTo(0,-12);
  X.lineTo(0,-5);
  X.lineTo(-22,-5);
  X.lineTo(-22,5);
  X.lineTo(0,5);
  X.lineTo(0,12);
  X.closePath();
  X.fill();X.stroke();
  X.restore();
  // Emoji + dystans (bez rotacji)
  X.save();
  X.font='bold 18px "Segoe UI",Arial';
  X.textAlign='center';X.textBaseline='middle';
  // Pozycja tekstu obok strzalki, w kierunku do srodka
  const lx=ax-Math.cos(ang)*30, ly=ay-Math.sin(ang)*30;
  X.fillStyle='rgba(0,0,0,.85)';
  X.beginPath();
  if(X.roundRect)X.roundRect(lx-22,ly-12,44,24,12);else X.fillRect(lx-22,ly-12,44,24);
  X.fill();
  X.strokeStyle='rgba(241,196,15,.7)';X.lineWidth=1;X.stroke();
  X.fillStyle='#f1c40f';
  X.fillText(tgt.em||'đźŽŻ',lx,ly);
  // Dystans pod strzalka
  X.font='bold 11px "Segoe UI",Arial';
  X.fillStyle='rgba(0,0,0,.85)';
  const dx_lbl=ax+Math.cos(ang)*32, dy_lbl=ay+Math.sin(ang)*32;
  X.fillRect(dx_lbl-22,dy_lbl-9,44,18);
  X.fillStyle='#fff';
  X.fillText(`${dist}m`,dx_lbl,dy_lbl);
  X.textAlign='left';X.textBaseline='alphabetic';
  X.restore();
}

// â”€â”€ STORYLINE PILL â€” top-center indicator pokazujacy aktualny krok storyline â”€â”€
// HTML overlay version â€” zawsze ostry tekst (canvas pikseluje przez transform:scale na #wrap)
// Element w document.body (NIE w #wrap) zeby nie skalowal sie z canvas â€” patrz feedback_position_fixed_scale.md
// v1.8.77: uniwersalny check czy jakikolwiek UI blokujÄ…cy jest otwarty â€”
// uĹĽywany do ukrywania kontekstowych overlay'i (storyline pill, smart hint, quest widget)
function _uiIsBlocking(){
  if(typeof _paused!=='undefined' && _paused) return true;
  const menu=document.getElementById('menu');
  if(menu && menu.style.display!=='none') return true;
  if(typeof mgOpen==='function' && mgOpen()) return true;
  if(typeof phoneOpen==='function' && phoneOpen()) return true;
  if(typeof overlayOpen==='function' && overlayOpen()) return true;
  if(typeof npcDlgOpen==='function' && npcDlgOpen()) return true;
  if(document.getElementById('fullmap-overlay')) return true;
  if(document.getElementById('help-panel')) return true;
  if(document.getElementById('char-panel')?.style.display==='flex') return true;
  if(document.getElementById('admin-panel')?.style.display==='block') return true;
  if(document.getElementById('welcome-popup')) return true;
  if(document.getElementById('storyline-details')) return true;
  if(document.getElementById('creator')?.style.display==='flex') return true;
  if(document.getElementById('intro-cinematic')) return true;
  return false;
}
function drawStorylinePill(){
  let pill=document.getElementById('storyline-pill');
  if(!G.mainQuest||typeof STORYLINE_QUESTS==='undefined'){
    if(pill)pill.style.display='none';
    return;
  }
  const idx=G.mainQuest.currentStep||0;
  const total=STORYLINE_QUESTS.length;
  if(idx>=total){
    if(pill)pill.style.display='none';
    return;
  }
  const cur=STORYLINE_QUESTS[idx];
  if(!cur)return;
  // v1.8.41: storyline pill widoczny TYLKO po faktycznym starcie gry.
  if(!window._gameStarted){if(pill)pill.style.display='none';return;}
  // v1.8.77: ukryj pasek gdy DOWOLNY blokujÄ…cy UI jest otwarty (telefon, drzewko, minigra, dialog, mapa, etc.)
  if(_uiIsBlocking()){if(pill)pill.style.display='none';return;}
  if(!pill){
    pill=document.createElement('div');
    pill.id='storyline-pill';
    // Wieksze + lepsze tlo â€” pozycja USTAWIANA DYNAMICZNIE ponizej HUD
    pill.style.cssText='position:fixed;left:50%;transform:translateX(-50%);background:rgba(8,12,24,.94);border:2px solid #c8a520;color:#fff;padding:8px 18px;border-radius:18px;font-family:inherit;font-size:15px;font-weight:700;z-index:25;cursor:pointer;display:flex;align-items:center;gap:12px;box-shadow:0 4px 18px rgba(0,0,0,.6),0 0 16px rgba(200,165,32,.4);transition:transform .2s,box-shadow .2s;letter-spacing:.3px;-webkit-font-smoothing:antialiased';
    pill.title='Kliknij â€” zobacz peĹ‚nÄ… liniÄ™ fabularnÄ… (gĹ‚ĂłwnÄ… + boczne)';
    pill.onclick=()=>showStorylineDetails();
    pill.onmouseenter=()=>{pill.style.transform='translateX(-50%) translateY(-2px)';pill.style.boxShadow='0 8px 22px rgba(0,0,0,.7),0 0 28px rgba(200,165,32,.7)';};
    pill.onmouseleave=()=>{pill.style.transform='translateX(-50%)';pill.style.boxShadow='0 4px 18px rgba(0,0,0,.6),0 0 16px rgba(200,165,32,.4)';};
    document.body.appendChild(pill);
  }
  pill.style.display='flex';
  // Pozycja: tuz pod HUD (uwzglednia transform:scale na #wrap przez getBoundingClientRect)
  const hudEl=document.getElementById('hud');
  const hudBottom=hudEl?Math.round(hudEl.getBoundingClientRect().bottom):62;
  pill.style.top=(hudBottom+10)+'px';
  // Update content tylko gdy sie zmienilo (avoid DOM thrash)
  const newContent=`<span style="font-size:20px;line-height:1">${cur.em}</span><span>${cur.name}</span><span style="color:#c8a520;font-size:13px;font-weight:900;letter-spacing:.5px;background:rgba(200,165,32,.15);padding:3px 8px;border-radius:8px">${idx}/${total}</span>`;
  if(pill._lastContent!==newContent){
    pill.innerHTML=newContent;
    pill._lastContent=newContent;
  }
}

function showStorylineDetails(){
  document.getElementById('storyline-details')?.remove();
  document.getElementById('storyline-details-bd')?.remove();
  const bd=document.createElement('div');
  bd.id='storyline-details-bd';
  bd.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);z-index:299;cursor:pointer';
  bd.onclick=()=>{bd.remove();document.getElementById('storyline-details')?.remove();};
  document.body.appendChild(bd);
  const m=document.createElement('div');
  m.id='storyline-details';
  m.style.cssText='position:fixed;top:78px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#0a0a1a,#1a0a2a);border:2px solid #c8a520;border-radius:14px;padding:22px 30px 18px;width:720px;max-width:94vw;max-height:calc(100vh - 96px);overflow-y:auto;z-index:300;color:#fff;font-family:inherit;box-shadow:0 8px 40px rgba(0,0,0,.7),0 0 60px rgba(200,165,32,.4);-webkit-font-smoothing:antialiased';
  m.onclick=e=>e.stopPropagation();
  const idx=G.mainQuest?.currentStep||0;
  const completed=G.mainQuest?.completed||[];
  const stepsHtml=STORYLINE_QUESTS.map((q,i)=>{
    const isDone=completed.includes(q.id);
    const isCurrent=i===idx&&!isDone;
    const isLocked=i>idx;
    const c=isDone?{bg:'rgba(39,174,96,.13)',border:'#27ae60',text:'#7ec87e',lbl:'âś“ UKOĹCZONE'}:isCurrent?{bg:'rgba(200,165,32,.18)',border:'#c8a520',text:'#fff',lbl:'đźŽŻ AKTUALNY KROK'}:{bg:'rgba(40,40,55,.4)',border:'#3a3a4a',text:'#889',lbl:'đź”’ ZABLOKOWANE'};
    const r=q.reward||{};
    const rewardTxt=[r.money?`đź’° ${r.money} zĹ‚`:'',r.xp?`â­ ${r.xp} XP`:'',r.fame?`đźŚź ${r.fame} sĹ‚awy`:'',r.skillPts?`đźŽŻ ${r.skillPts} pkt skill`:''].filter(Boolean).join(' Â· ');
    return `<div style="background:${c.bg};border:1.5px solid ${c.border};border-radius:8px;padding:10px 14px;margin-bottom:8px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px">
        <span style="font-size:20px;${isLocked?'filter:grayscale(.7);opacity:.6':''}">${q.em}</span>
        <span style="color:${c.text};font-weight:800;font-size:14px">${i+1}. ${q.name}</span>
        <span style="margin-left:auto;font-size:9px;color:${c.border};font-weight:900;letter-spacing:1px">${c.lbl}</span>
      </div>
      <div style="font-size:12px;color:#aab;line-height:1.45;margin-left:32px">${q.desc}</div>
      <div style="font-size:11px;color:#c8a520;margin-left:32px;margin-top:4px;font-weight:700">Nagroda: ${rewardTxt}</div>
    </div>`;
  }).join('');
  m.innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <div style="font-size:20px;font-weight:900;color:#c8a520;letter-spacing:.5px">đźŽŻ Linia fabularna kariery</div>
      <button onclick="document.getElementById('storyline-details-bd')?.remove();document.getElementById('storyline-details')?.remove();" style="background:transparent;border:1px solid #2a3a50;color:#aaa;width:32px;height:32px;border-radius:6px;cursor:pointer;font-size:16px;font-family:inherit">âś•</button>
    </div>
    <div style="font-size:13px;color:#aab;line-height:1.6;margin-bottom:14px;padding:11px 14px;background:rgba(0,0,0,.3);border-radius:6px;border-left:3px solid #c8a520">
      <b style="color:#c8a520">Co to jest?</b> ĹaĹ„cuch <b>${STORYLINE_QUESTS.length} opcjonalnych misji</b> prowadzÄ…cych CiÄ™ od poczÄ…tkujÄ…cego do legendy rap-sceny. KaĹĽdy krok daje nagrody (kasa, sĹ‚awa, XP, skill pointy). <b style="color:#7ec8e3">Nie musisz tego robiÄ‡</b> â€” moĹĽesz graÄ‡ po swojemu. Pasek u gĂłry to tylko podpowiedĹş "co dalej" w gĹ‚Ăłwnej fabule. MoĹĽesz robiÄ‡ cokolwiek innego (YouTube, Beatmaker, Gamer, Prace) i ignorowaÄ‡ ten pasek.
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#aab;margin-bottom:10px;padding:0 4px">
      <div>PostÄ™p: <strong style="color:#fff">${idx}/${STORYLINE_QUESTS.length} ukoĹ„czonych</strong></div>
      <div style="font-size:11px;color:#778">Klik poza okno = zamknij</div>
    </div>
    ${stepsHtml}
    <div style="margin-top:20px;padding-top:14px;border-top:1px solid #2a3a50">
      <div style="font-size:16px;font-weight:900;color:#9b59b6;margin-bottom:8px;letter-spacing:.5px">đźŚź Boczne linie fabularne</div>
      <div style="font-size:12px;color:#aab;margin-bottom:10px;line-height:1.5">RĂłwnolegĹ‚e Ĺ›cieĹĽki rozwoju â€” kaĹĽda z wĹ‚asnym progresem. MoĹĽesz je realizowaÄ‡ w dowolnej kolejnoĹ›ci.</div>
      ${Object.entries(SIDE_STORYLINES).map(([sid,line])=>{
        const prog=G.sideQuests?.[sid]||{step:0};
        const done=prog.step;
        const total=line.quests.length;
        const cur=line.quests[done];
        const pct=Math.floor((done/total)*100);
        return `<div style="background:rgba(40,40,55,.3);border:1px solid ${line.color}55;border-left:3px solid ${line.color};border-radius:6px;padding:9px 12px;margin-bottom:6px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
            <span style="font-weight:800;color:${line.color};font-size:13px">${line.name}</span>
            <span style="margin-left:auto;font-size:11px;color:#aab">${done}/${total}</span>
          </div>
          <div style="background:rgba(0,0,0,.4);height:4px;border-radius:2px;overflow:hidden;margin-bottom:5px">
            <div style="background:${line.color};height:100%;width:${pct}%;transition:width .3s"></div>
          </div>
          <div style="font-size:11px;color:#889">${done>=total?'âś“ Wszystkie kroki ukoĹ„czone!':`Kolejny: ${cur?.em||''} ${cur?.name||''}`}</div>
        </div>`;
      }).join('')}
    </div>
    <button onclick="document.getElementById('storyline-details-bd')?.remove();document.getElementById('storyline-details')?.remove();" style="width:100%;margin-top:12px;background:linear-gradient(135deg,#0a3a5a,#1a4a6a);border:1px solid #7ec8e3;color:#7ec8e3;padding:11px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700">Zamknij</button>
  `;
  document.body.appendChild(m);
}
window.showStorylineDetails=showStorylineDetails;

// â”€â”€ MISJA GĹĂ“WNA â€” pasek postÄ™pu â”€â”€
function drawMissionBar(){
  const mm=G.mainMission;
  if(!mm||(!mm.active&&!mm.failed)) return;
  /* v2.1.37 [Amper]: overlay 'Pierwsze 1000 fanĂłw' = G.fans lojalnych */
  const totalFans=(G.fans||0);
  const target=1000;
  const pct=Math.min(1,totalFans/target);
  const daysElapsed=G.day-(mm.startDay||1);
  const daysLeft=Math.max(0,(mm.daysLimit||30)-daysElapsed);
  const barW=280,barH=14,bx=1280-barW-10,by=92;
  // TĹ‚o
  X.fillStyle='rgba(0,4,12,.82)';X.beginPath();if(X.roundRect)X.roundRect(bx-4,by-4,barW+8,barH+28,4);else X.fillRect(bx-4,by-4,barW+8,barH+28);X.fill();
  // NagĹ‚Ăłwek
  X.shadowBlur=0;X.font='bold 12px "Segoe UI",Arial,sans-serif';X.fillStyle='#7ec8e3';X.textAlign='left';
  X.fillText(`đźŽŻ MISJA: ${totalFans}/${target} fanĂłw`,bx,by+8);
  // Dni
  const dayColor=daysLeft<=5?'#e74c3c':daysLeft<=10?'#f39c12':'#aaa';
  X.fillStyle=dayColor;X.textAlign='right';
  X.fillText(mm.active?`${daysLeft} dni`:'âťŚ',bx+barW,by+8);
  // Pasek postÄ™pu
  X.fillStyle='rgba(255,255,255,.08)';X.fillRect(bx,by+10,barW,barH);
  // WypeĹ‚nienie â€” gradient zielonyâ†’ĹĽĂłĹ‚tyâ†’czerwony
  const fillColor=pct>=1?'#2ecc71':pct>=0.5?'#f1c40f':'#3498db';
  const fg=X.createLinearGradient(bx,by,bx+barW*pct,by);
  fg.addColorStop(0,'#1a6a3a');fg.addColorStop(1,fillColor);
  X.fillStyle=fg;X.fillRect(bx,by+10,Math.max(2,barW*pct),barH);
  // Milestone markery
  const ms_pts=[100,250,500,1000];
  for(const mf of ms_pts){
    const mx=bx+barW*mf/target;
    X.fillStyle=totalFans>=mf?'#f1c40f':'rgba(255,255,255,.3)';
    X.fillRect(mx-1,by+9,2,barH+2);
  }
  // Kontur paska
  X.strokeStyle='rgba(255,255,255,.15)';X.lineWidth=1;X.strokeRect(bx,by+10,barW,barH);
  if(mm.failed){
    X.fillStyle='#e74c3c';X.font='bold 12px "Segoe UI",Arial,sans-serif';X.textAlign='center';
    X.fillText('âťŚ MISJA NIEUDANA',bx+barW/2,by+9);
  }
  X.textAlign='left';
}

// â”€â”€ PRZEJĹšCIE MIÄDZY POKOJAMI â€” fade to black â”€â”€
let _roomFade=0,_roomFadeDir=0,_roomFadePending=null;
function startRoomFade(id,wx,wy){
  if(_blockedByCarEnter(id)) return;
  _roomFadePending={id,wx,wy};_roomFadeDir=-1;_roomFade=0;
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  GAME LOOP
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function loop(){
  try{
  X.clearRect(0,0,1280,720);
  const menuEl=document.getElementById('menu');
  const isMenu=menuEl.style.display==='flex'||menuEl.style.display==='';
  const isCreator=document.getElementById('creator').style.display==='flex';
  if(isMenu||isCreator){requestAnimationFrame(loop);return;}

  if(!_paused) weatherTick++;
  const nowT=Date.now();
  // Admin: mnoĹĽnik tempa upĹ‚ywu czasu (G._adminTimeMult). Default 1Ă—, 0Ă— = pause.
  const _tMul = (typeof G._adminTimeMult==='number') ? G._adminTimeMult : 1;
  // v2.1.30: Bazowy tempo 4.0Ă— szybsze niĹĽ real-time (1 dzieĹ„ gry = 6 min real). Admin _tMul mnoĹĽy to dalej.
  const _BASE_TIME_SCALE = 4.0;
  // v1.8.33: BUG FIX â€” podczas spania loop NIE inkrementuje gameMin (sleepInterval ma wĹ‚asne tempo
  // 10 game min per 200ms). Inaczej spanie przez pĂłĹ‚noc powodowaĹ‚o podwĂłjne G.day++ (raz tu, raz w wakeUp).
  const _isSleeping = (typeof sleepInterval !== 'undefined') && sleepInterval;
  if(!_paused && _tMul>0 && !_isSleeping) gameMin+=((nowT-lastClockReal)/1000)*_BASE_TIME_SCALE*_tMul;
  lastClockReal=nowT;
  // â”€â”€ Sync gameMin â†’ G.timeOfDay (pora dnia zmienia siÄ™ sama bez spania) â”€â”€
  // Mapowanie: 06â€“11=Rano(0) Â· 12â€“17=PoĹ‚udnie(1) Â· 18â€“22=WieczĂłr(2) Â· 23â€“05=Noc(3)
  // Gdy zegar przekroczy 24:00 â€” odpalamy peĹ‚nÄ… logikÄ™ nextPeriod() raz, by zaliczyÄ‡ nowy dzieĹ„
  // v1.8.33: podczas spania NIE odpalamy nextPeriod tu â€” wakeUp() sam zaliczy dzieĹ„ (zapobiega double-increment).
  if(gameMin>=1440 && !_isSleeping){
    const days=Math.floor(gameMin/1440);
    gameMin=gameMin%1440;
    /* v2.1.131: reset gameMin-based cooldowns po modulo (analogicznie do wakeUp linia 10075-10084).
       Bez tego: gracz grajÄ…cy non-stop bez snu po pĂłĹ‚nocy ma _lastXMin>gameMin â†’ cooldown lock permanent.
       4 cooldowny dotkniÄ™te: eatTable (240min), biblioteka (120min), helipad (30min), quickCook (300min).
       Inne (freestyle/cook/beatSell/beatPack/concert) teĹĽ resetowane dla spĂłjnoĹ›ci. */
    G._lastFreestyleMin=-9999;
    G._lastCookMin=-9999;
    G._lastEatTableMin=-9999;
    G._lastBibliotekaMin=-9999;
    G._lastBeatSellMin=-9999;
    G._lastBeatPackMin=-9999;
    G._lastConcertMin=-9999;
    G._lastQuickCookMin=-9999;
    G._lastHeliMin=-9999;
    for(let i=0;i<days;i++){
      // Ustawiamy timeOfDay=3 by nextPeriod() zaliczyĹ‚ przejĹ›cie nocâ†’rano (G.day++)
      G.timeOfDay=3;
      nextPeriod(); // robi: timeOfDay=0, day++, hunger -15, dzienny bonus, weekly, royalties, sleepDebt, raper bonusy
    }
  }
  const _hr=Math.floor(gameMin/60)%24;
  const _newTOD=(_hr>=23||_hr<6)?3:(_hr>=18)?2:(_hr>=12)?1:0;
  if(_newTOD!==G.timeOfDay){G.timeOfDay=_newTOD;}

  // v1.8.13: kaĹĽda draw funkcja w osobnym try/catch â€” crash jednej nie zatrzymuje innych
  const _safe=(fn,label)=>{try{fn();}catch(e){if(!window._loopErrLogged)window._loopErrLogged={};if(!window._loopErrLogged[label]){console.error('[loop:'+label+']',e);window._loopErrLogged[label]=true;}}};
  const room=ROOMS[currentRoom];
  /* v1.9.92: cinematic zoom â€” transform Ĺ›wiata gdy cam.zoom != 1. HUD/minimap/vignette poza zoomem. */
  const _cinemZoomActive = Math.abs((cam.zoom||1)-1)>0.005;
  if(_cinemZoomActive){
    X.save();
    /* Punkt zoom = Ĺ›rodek viewportu (640, 391 = 62+329) */
    X.translate(640, 391);
    X.scale(cam.zoom, cam.zoom);
    X.translate(-640, -391);
  }
  _safe(()=>drawTileMap(room),'drawTileMap');
  if(currentRoom==='ulica'){_safe(()=>drawLamps(),'drawLamps');_safe(()=>drawTrees(),'drawTrees');}
  _safe(()=>drawCityDecorations(),'drawCityDecorations');
  _safe(()=>drawRoomDecorations(),'drawRoomDecorations');
  _safe(()=>drawShadows(),'drawShadows');
  _safe(()=>drawObjects(room),'drawObjects');
  if(currentRoom==='ulica'){_safe(()=>drawParkLife(),'drawParkLife');_safe(()=>drawCityLife(),'drawCityLife');_safe(()=>drawBirds(),'drawBirds');}
  _safe(()=>drawPlayerCar(),'drawPlayerCar');
  _safe(()=>drawPlayer(),'drawPlayer');
  _safe(()=>emitAmbientSmoke(),'emitAmbientSmoke');_safe(()=>emitFootDust(),'emitFootDust');
  _safe(()=>updateAndDrawParticles(),'updateAndDrawParticles');
  _safe(()=>drawWetSurfaces(),'drawWetSurfaces');
  _safe(()=>drawNightGlows(),'drawNightGlows');
  _safe(()=>drawNeonSigns(),'drawNeonSigns');
  _safe(()=>drawAtmosphericFog(),'drawAtmosphericFog');
  _safe(()=>drawLightingOverlay(),'drawLightingOverlay');
  /* v1.9.92: highlight cinematic w tej samej transformacji co Ĺ›wiat â€” pierĹ›cieĹ„ podÄ…ĹĽa za budynkiem przy zoomie */
  _safe(()=>drawCinemHighlight(),'drawCinemHighlight');
  /* v1.9.92: restore transform PRZED HUD/minimap/vignette â€” to NIE sÄ… zoomowane */
  if(_cinemZoomActive) X.restore();
  _safe(()=>drawMiniMap(),'drawMiniMap');
  _safe(()=>drawSeasonOverlay(),'drawSeasonOverlay');
  _safe(()=>drawWeatherFX(),'drawWeatherFX');
  _safe(()=>drawInteractionHighlight(),'drawInteractionHighlight');
  /* v1.9.92: drawCinemHighlight wywoĹ‚ywane przed X.restore() â€” wyĹĽej w pÄ™tli */
  _safe(()=>drawVignette(),'drawVignette');
  _safe(()=>drawLevelUpBurstFX(),'drawLevelUpBurstFX');
  _safe(()=>drawQuestCompass(),'drawQuestCompass');
  _safe(()=>drawStorylinePill(),'drawStorylinePill');
  // v1.8.77: usuĹ„ wyĹ›wietlajÄ…cy siÄ™ smart-hint pop-up gdy gracz otworzy blokujÄ…cy UI (telefon, drzewko, etc.)
  // Hint zostaje w historii (WskazĂłwki w telefonie), wiÄ™c nic nie ginie â€” po prostu nie zasĹ‚ania ekranu.
  _safe(()=>{if(typeof _uiIsBlocking==='function' && _uiIsBlocking()){
    // v1.8.77: smart-hint, v1.8.88: tutorial-popup teĹĽ chowamy gdy gracz ma otwarte okno
    document.getElementById('smart-hint')?.remove();
    document.getElementById('tutorial-popup')?.remove();
  }},'hideOverlaysWhenBlocked');
  // drawMissionBar() usuniÄ™te â€” quest widget juĹĽ pokazuje gĹ‚ĂłwnÄ… misjÄ™
  // â”€â”€ Fade przejĹ›cia miÄ™dzy pokojami â”€â”€
  if(_roomFadeDir!==0){
    if(_roomFadeDir===-1){
      _roomFade=Math.min(1,_roomFade+0.11);
      if(_roomFade>=1){changeRoom(_roomFadePending.id,_roomFadePending.wx,_roomFadePending.wy);_roomFadeDir=1;}
    } else {
      _roomFade=Math.max(0,_roomFade-0.09);
      if(_roomFade<=0){_roomFadeDir=0;_roomFadePending=null;}
    }
    if(_roomFade>0){X.fillStyle=`rgba(0,0,0,${_roomFade})`;X.fillRect(0,62,1280,658);}
  }
  _safe(()=>updatePlayer(),'updatePlayer');
  _safe(()=>maybeSoundStep(),'maybeSoundStep');
  _safe(()=>updateHUD(),'updateHUD');
  _safe(()=>updateHUDFace(),'updateHUDFace');
  _safe(()=>tickDecay(),'tickDecay');
  _safe(()=>tutorialTick(),'tutorialTick');
  _safe(()=>checkSmartHints(),'checkSmartHints');
  /* v2.1.45 [Amper]: trigger auto-submit z gameLoop â€” wewnÄ™trzny throttle (60s normalny, 10s gdy Ĺ›wieĹĽa wygrana w kasynie) odpowiada za rate-limit. WczeĹ›niej leciaĹ‚ tylko z nextPeriod() (~1.5min) â†’ wygrane Ampera nie nadÄ…ĹĽaĹ‚y. */
  _safe(()=>{if(typeof maybeAutoSubmitScores==='function') maybeAutoSubmitScores();},'maybeAutoSubmitScores');
  }catch(e){
    console.error('[gameLoop] frame crashed:',e);
  }
  requestAnimationFrame(loop);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  INIT
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
initTiles();
buildMaps();
// Auto-init save: przywrĂłÄ‡ handle pliku, sprĂłbuj wczytaÄ‡ save (z localStorage lub pliku)
(async()=>{
  await _restoreFileHandle();
  // JeĹ›li localStorage pusty ale jest powiÄ…zany plik, sprĂłbuj wczytaÄ‡ z pliku
  if(!localStorage.getItem(SAVE_KEY) && _saveFileHandle){
    const txt=await readFromFileHandle();
    if(txt){
      try{
        const parsed=JSON.parse(txt);
        if(parsed&&parsed.G) localStorage.setItem(SAVE_KEY,txt);
      }catch{}
    }
  }
  refreshContinueButton();
  refreshMenuFsButton();
  /* v1.9.26: Sync sliders SFX/BGM przy boot z localStorage (poprzednio HTML value=100/13 hardcoded, gracz widziaĹ‚ 100% mimo zapisanego 40%) */
  try{
    const _sfxSl=document.getElementById('sfx-vol-slider');
    const _sfxLbl=document.getElementById('sfx-vol-label');
    if(_sfxSl){_sfxSl.value=Math.round((_sfxVolume||1)*100);}
    if(_sfxLbl){_sfxLbl.textContent=Math.round((_sfxVolume||1)*100)+'%';}
    const _bgmSl=document.getElementById('bgm-vol-slider');
    const _bgmLbl=document.getElementById('bgm-vol-label');
    if(_bgmSl){_bgmSl.value=Math.round((bgmVolume||0.13)*100);}
    if(_bgmLbl){_bgmLbl.textContent=Math.round((bgmVolume||0.13)*100)+'%';}
  }catch(e){}
})();
// Zapis tuĹĽ przed zamkniÄ™ciem karty/odĹ›wieĹĽeniem â€” synchronicznie (beforeunload nie czeka na debounce)
window.addEventListener('beforeunload',()=>{
  if(document.getElementById('menu').style.display==='none') saveGameSilentNow();
});
// Zapis przy kaĹĽdej utracie widocznoĹ›ci karty + v1.8.83: auto-pauza
document.addEventListener('visibilitychange',()=>{
  const inGame=document.getElementById('menu').style.display==='none';
  if(!inGame) return;
  if(document.hidden){
    saveGameSilent();
    // v1.8.83: pauza gry gdy karta/okno w tle â€” czas i NPC stojÄ…, gracz nie traci postÄ™pu w tle
    if(typeof _paused!=='undefined' && !_paused && typeof togglePause==='function'){
      togglePause();
      window._autoPausedByVisibility=true;
    }
    /* v1.9.24: pauza BGM gdy karta w tle (poprzednio muzyka leciaĹ‚a dalej mimo auto-pauzy gry) */
    try{if(typeof bgmAudio!=='undefined' && bgmAudio && !bgmAudio.paused){bgmAudio.pause();window._bgmAutoPaused=true;}}catch(e){}
  } else {
    /* v1.9.24: wznĂłw BGM jeĹ›li auto-pauzowane */
    try{if(window._bgmAutoPaused && typeof bgmAudio!=='undefined' && bgmAudio){window._bgmAutoPaused=false;bgmAudio.play().catch(()=>{});}}catch(e){}
    // Karta wraca â€” jeĹ›li pauza byĹ‚a ustawiona AUTOMATYCZNIE przez nas, wznĂłw. JeĹ›li przez gracza (Esc) â€” zostawiÄ‡ w pauzie.
    if(window._autoPausedByVisibility){
      window._autoPausedByVisibility=false;
      if(typeof _paused!=='undefined' && _paused && typeof togglePause==='function') togglePause();
    }
  }
});
