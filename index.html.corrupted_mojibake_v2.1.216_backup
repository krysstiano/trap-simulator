        G._kebabBought=(G._kebabBought||0)+1; // v1.8.47: kaĹĽdy zakup u Zbyszka liczy siÄ™ do side questu "StaĹ‚y klient"
        if(typeof addFriendship==='function')addFriendship('zbyszek',1);
        progressQuest('eat');notify('đźŤ˛ Zupa Zbyszka! +30 gĹ‚Ăłd, +5 nastrĂłj'+(_zFM>1?' ('+_soupPrice+' zĹ‚ â€” zniĹĽka przyjaĹşni)':''));updateHUD();openNPCDialogue('vendor');
      }},
