// v1.8.88: kategorie patchnotĂłw â€” wpis moĹĽe mieÄ‡ WIELE kategorii (cats:[...] array).
// Stary format `cat:'X'` jest backward compatible. Filtrowanie po klikniÄ™ciu taba.
const PATCH_CATS={
  'beta-tester':{emoji:'đź›',label:'Beta tester',color:'#9b59b6'},
  'feature':    {emoji:'âś¨',label:'Nowe funkcje',color:'#27ae60'},
  'critical':   {emoji:'đźš¨',label:'Krytyczne bĹ‚Ä™dy',color:'#c0392b'},
  'bugfix':     {emoji:'đź”§',label:'Bugfixy',color:'#e74c3c'},
  'balance':    {emoji:'âš–ď¸Ź',label:'Balans',color:'#f39c12'},
  'visual':     {emoji:'đźŽ¨',label:'Wizualne / UI',color:'#e91e8c'},
  'optimization':{emoji:'âšˇ',label:'Optymalizacja',color:'#16a085'},
  'gameplay':   {emoji:'đźŽ®',label:'Rozgrywka',color:'#3498db'},
  'kasyno':     {emoji:'đźŽ°',label:'Kasyno',color:'#c8a520'},
  'online':     {emoji:'đźŚŤ',label:'Online / Tablica wynikĂłw',color:'#7ec8e3'},
  'system':     {emoji:'âš™ď¸Ź',label:'System / techniczne',color:'#778'},
};
// Helper: zwraca tablicÄ™ kategorii wpisu (obsĹ‚uguje stary `cat:'X'` i nowy `cats:[...]`)
function _patchEntryCats(p){
  if(Array.isArray(p.cats)) return p.cats;
  if(p.cat) return [p.cat];
  return [];
}
// v1.8.89: helper zwraca tablicÄ™ reporterĂłw (beta-testerĂłw ktĂłrzy zgĹ‚osili)
function _patchEntryReporters(p){
  if(Array.isArray(p.reporters)) return p.reporters;
  if(p.reporter) return [p.reporter];
  return [];
}
// Deterministyczny kolor z nicku (hash â†’ HSL)
function _reporterColor(nick){
  if(!nick) return '#9b59b6';
  let h=0;
  for(let i=0;i<nick.length;i++) h=(h*31+nick.charCodeAt(i))&0xffff;
  const hue=h%360;
  return `hsl(${hue},65%,55%)`;
}
let _patchFilterCat='all';
function showPatchNotes(){
  // Kolory i etykiety per typ wpisu
  const TYPE={
    add:     {bg:'#1c8045',fg:'#fff',lbl:'NOWE',  emoji:'âś¨',accent:'#27ae60'},
    feature: {bg:'#1c8045',fg:'#fff',lbl:'NOWE',  emoji:'âś¨',accent:'#27ae60'},
    fix:     {bg:'#a73026',fg:'#fff',lbl:'NAPRAWA',emoji:'đź”§',accent:'#e74c3c'},
    change:  {bg:'#b87510',fg:'#fff',lbl:'ZMIANA',emoji:'đź”„',accent:'#f39c12'},
  };
  // PodkreĹ›lanie waĹĽnych sĹ‚Ăłw/liczb w opisie. KOLEJNOĹšÄ† KRYTYCZNA:
  // 1) cudzysĹ‚owy MUSZÄ„ byÄ‡ pierwsze (zanim dodamy span ze style),
  //    inaczej regex Ĺ‚apie cudzysĹ‚owy ze STYLE jako "tekst".
  // 2) wszystkie style uĹĽywajÄ… APOSTROFĂ“W, nie cudzysĹ‚owĂłw.
  const highlight=(d)=>{
    let s=d;
    /* v2.1.21 KRYTYCZNE: escape `<` i `>` PIERWSZE â€” bez tego wpisy z `<style>`, `<br>` itp.
       konsumowaĹ‚y kolejne wpisy jako CSS/HTML content (user widziaĹ‚ tylko do v2.0.3 z 444 wpisĂłw).
       Plus zachowaj <br><br> z PATCH_NOTES (markdown-like line breaks uĹĽywane w starych wpisach). */
    s=s.replace(/<br\s*\/?>/gi,'LINEBREAK'); /* zachowaj <br> */
    s=s.replace(/<b\b([^>]*)>([^<]*)<\/b>/gi,'BOLD_OPEN$2BOLD_CLOSE'); /* zachowaj <b> tags */
    s=s.replace(/</g,'&lt;').replace(/>/g,'&gt;'); /* escape reszty */
    s=s.replace(/LINEBREAK/g,'<br>');
    s=s.replace(/BOLD_OPEN([^]*)BOLD_CLOSE/g,'<b>$1</b>');
    /* Markdown **bold** â†’ <b> (uĹĽywane w wielu wpisach) */
    s=s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');
    /* Backticks `code` â†’ <code> ĹĽeby wyglÄ…daĹ‚o jak inline code */
    s=s.replace(/`([^`]+)`/g,"<code style='background:rgba(126,200,227,.12);color:#7ec8e3;padding:1px 5px;border-radius:3px;font-family:monospace;font-size:12px'>$1</code>");
    // 1) CudzysĹ‚owy â†’ niebieskie
    s=s.replace(/"([^"]+)"/g,
      "<span style='color:#7ec8e3;font-weight:600'>&quot;$1&quot;</span>");
    // 2) SĹ‚owa kluczowe wielkÄ… literÄ…
    s=s.replace(/\b(NERF|BUFF|BUG|ROOT|CRITICAL|REBUILD|FIX|NAPRAWA)\b/g,
      "<span style='color:#e91e8c;font-weight:700'>$1</span>");
    // 3) Liczby z jednostkami zĹ‚/min/sek/%/Ă— â€” wymagajÄ… BOUNDARY po jednostce
    s=s.replace(/(\d+[\d,.]*\s*(?:zĹ‚|min|sek|%|Ă—))(?![a-zÄ…Ä™Ĺ‚ĹşĹĽĹ›Ä‡Ĺ„Ăł])/gi,
      "<span style='color:#f1c40f;font-weight:700'>$1</span>");
    return s;
  };
  // v1.8.88: filtrowanie obsĹ‚uguje wpisy z wieloma kategoriami (cats:[...])
  // v1.8.88: filtrowanie obsĹ‚uguje wpisy z wieloma kategoriami (cats:[...])
  const filtered=_patchFilterCat==='all'
    ? PATCH_NOTES
    : PATCH_NOTES.filter(p=>_patchEntryCats(p).includes(_patchFilterCat));
  // Najnowszy wpis = "NAJNOWSZE" badge (najnowszy w PEĹNEJ liĹ›cie, nie w filtrowanej)
  const newestVer=PATCH_NOTES[0]?.ver;
  const html=filtered.map((p)=>{
    const isLatest=p.ver===newestVer;
    const itemsCount=p.items.length;
    const entryCats=_patchEntryCats(p);
    const catChips=entryCats.map(cid=>{
      const cd=PATCH_CATS[cid];if(!cd)return '';
      return `<span style="background:${cd.color}22;color:${cd.color};border:1px solid ${cd.color}55;font-size:10px;font-weight:700;letter-spacing:.5px;padding:3px 8px;border-radius:10px;display:inline-flex;align-items:center;gap:3px">${cd.emoji} ${cd.label.toUpperCase()}</span>`;
    }).join(' ');
    // v1.8.89: chip(y) reportera(Ăłw) â€” prominentne, gradient, wiÄ™kszy
    const reporters=_patchEntryReporters(p);
    const reporterChips=reporters.map(nick=>{
      const col=_reporterColor(nick);
      return `<span style="background:linear-gradient(135deg,${col},${col}cc);color:#fff;font-size:11px;font-weight:900;letter-spacing:1px;padding:4px 11px;border-radius:14px;display:inline-flex;align-items:center;gap:5px;box-shadow:0 2px 8px ${col}99,inset 0 1px 0 rgba(255,255,255,.2);text-shadow:0 1px 2px rgba(0,0,0,.5);text-transform:uppercase">đź‘¤ ${nick}</span>`;
    }).join(' ');
    const catChip=reporterChips+(reporterChips&&catChips?' ':'')+catChips;
    const primaryCat=entryCats[0]?PATCH_CATS[entryCats[0]]:null;
    const borderColor=primaryCat?primaryCat.color:'#c8a520';
    return `
    <div style="margin-bottom:18px;background:linear-gradient(180deg,#0c1424,#0a1018);border:1px solid #1f2a3a;border-left:4px solid ${borderColor};border-radius:10px;padding:0;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.4)">
      <div style="background:linear-gradient(90deg,rgba(200,165,32,.10),rgba(126,200,227,.05) 50%,transparent);padding:14px 18px;border-bottom:1px solid #1a2a3a">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px">
          <span style="background:linear-gradient(135deg,#f1c40f,#d4a017);color:#000;font-size:13px;font-weight:900;letter-spacing:.5px;padding:4px 10px;border-radius:14px;text-shadow:0 1px 0 rgba(255,255,255,.3);box-shadow:0 2px 6px rgba(241,196,15,.4)">${p.ver}</span>
          ${catChip}
          ${isLatest?`<span style="background:linear-gradient(135deg,#e91e8c,#c01070);color:#fff;font-size:10px;font-weight:900;letter-spacing:1px;padding:3px 8px;border-radius:10px;animation:pulseBadge 2s ease-in-out infinite">â­ NAJNOWSZE</span>`:''}
          <span style="color:#556;font-size:11px;margin-left:auto;background:rgba(0,0,0,.3);padding:3px 8px;border-radius:10px">đź“… ${p.date}</span>
        </div>
        <div style="color:#fff;font-size:15px;font-weight:700;line-height:1.3;margin-top:6px">${p.title}</div>
        <div style="color:#778;font-size:11px;margin-top:4px">${itemsCount} ${itemsCount===1?'zmiana':itemsCount<5?'zmiany':'zmian'}</div>
      </div>
      <div style="padding:12px 18px;display:flex;flex-direction:column;gap:8px">
        ${p.items.map(it=>{
          const T=TYPE[it.t]||{bg:'#445',fg:'#fff',lbl:'INFO',emoji:'Â·',accent:'#778'};
          return `
          <div style="display:flex;gap:12px;align-items:flex-start;font-size:14px;line-height:1.6;background:rgba(28,38,55,.6);padding:10px 12px;border-radius:6px;border-left:3px solid ${T.accent}">
            <span style="background:${T.bg};color:${T.fg};font-weight:900;font-size:10px;letter-spacing:.5px;padding:4px 8px;border-radius:4px;flex-shrink:0;min-width:70px;text-align:center;display:inline-flex;align-items:center;justify-content:center;gap:4px;box-shadow:0 1px 3px rgba(0,0,0,.4);margin-top:1px"><span>${T.emoji}</span><span>${T.lbl}</span></span>
            <span style="color:#f0f3f8;flex:1">${highlight(it.d)}</span>
          </div>
          `;
        }).join('')}
      </div>
    </div>
  `;}).join('');
  // v1.8.88: counts per category â€” wpisy mogÄ… mieÄ‡ WIELE kategorii (cats:[...])
  const counts={all:PATCH_NOTES.length};
  for(const k of Object.keys(PATCH_CATS)){
    counts[k]=PATCH_NOTES.filter(p=>_patchEntryCats(p).includes(k)).length;
  }
  const filterTabs=`
    <button onclick="_patchFilterCat='all';showPatchNotes()" style="background:${_patchFilterCat==='all'?'#f1c40f':'rgba(20,28,42,.5)'};border:1px solid ${_patchFilterCat==='all'?'#f1c40f':'#2a3a4a'};color:${_patchFilterCat==='all'?'#000':'#aab'};padding:5px 10px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit">Wszystkie (${counts.all})</button>
    ${Object.entries(PATCH_CATS).map(([k,c])=>`<button onclick="_patchFilterCat='${k}';showPatchNotes()" style="background:${_patchFilterCat===k?c.color:'rgba(20,28,42,.5)'};border:1px solid ${_patchFilterCat===k?c.color:'#2a3a4a'};color:${_patchFilterCat===k?'#000':(counts[k]>0?c.color:'#445')};padding:5px 10px;border-radius:6px;font-size:11px;font-weight:700;cursor:${counts[k]>0?'pointer':'default'};font-family:inherit;opacity:${counts[k]>0?1:.45}" ${counts[k]===0?'disabled':''}>${c.emoji} ${c.label} (${counts[k]})</button>`).join('')}`;
  document.getElementById('ov-content').innerHTML=`
    <style>
      @keyframes pulseBadge{0%,100%{box-shadow:0 0 0 0 rgba(233,30,140,.6)}50%{box-shadow:0 0 0 6px rgba(233,30,140,0)}}
    </style>
    <h2 style="background:linear-gradient(90deg,#f1c40f,#e91e8c);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-size:32px;margin-bottom:6px">đź“ś Patch Notes</h2>
    <p class="sub" style="margin-bottom:14px">Historia zmian, ulepszeĹ„ i napraw w Trap Simulator</p>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">${filterTabs}</div>
    <div style="display:flex;gap:8px;font-size:11px;color:#aab;margin-bottom:14px;flex-wrap:wrap;background:rgba(20,28,42,.5);padding:8px 12px;border-radius:8px;border:1px solid #1f2a3a">
      <span style="font-weight:700;color:#f1c40f;margin-right:6px">LEGENDA:</span>
      <span style="display:inline-flex;align-items:center;gap:4px"><span style="background:#1c8045;color:#fff;padding:2px 7px;border-radius:4px;font-weight:900;font-size:9px">âś¨ NOWE</span> nowa funkcja</span>
      <span style="display:inline-flex;align-items:center;gap:4px"><span style="background:#b87510;color:#fff;padding:2px 7px;border-radius:4px;font-weight:900;font-size:9px">đź”„ ZMIANA</span> ulepszenie / balans</span>
      <span style="display:inline-flex;align-items:center;gap:4px"><span style="background:#a73026;color:#fff;padding:2px 7px;border-radius:4px;font-weight:900;font-size:9px">đź”§ NAPRAWA</span> bugfix</span>
    </div>
    <div style="max-height:62vh;overflow-y:auto;padding-right:14px;scrollbar-width:thin;scrollbar-color:#3a4a6a transparent">
      ${filtered.length===0?`<div style="text-align:center;padding:40px 20px;color:#778"><div style="font-size:36px;margin-bottom:10px">đź“­</div>Brak wpisĂłw w tej kategorii.<br><small>SprĂłbuj inny filtr lub "Wszystkie".</small></div>`:html}
    </div>
    <button class="cbtn" onclick="closeOverlay();document.getElementById('menu').style.display='flex'" style="margin-top:14px">â† WrĂłÄ‡ do menu</button>
  `;
  document.getElementById('menu').style.display='none';
  openOverlay();
}
window.showPatchNotes=showPatchNotes;

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  WIADOMOĹšCI
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function playNotifSound(type){
  if(_muted) return;
  try{const a=getAudio();
    const o=a.createOscillator();const g=a.createGain();
    o.connect(g);g.connect(_sfxMasterGain||a.destination);
    if(type==='r'){
      o.type='sawtooth';o.frequency.setValueAtTime(300,a.currentTime);
      o.frequency.exponentialRampToValueAtTime(150,a.currentTime+0.15);
      g.gain.setValueAtTime(0.12,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.2);
    }else{
      o.type='sine';o.frequency.setValueAtTime(880,a.currentTime);
      o.frequency.exponentialRampToValueAtTime(1100,a.currentTime+0.06);
      g.gain.setValueAtTime(0.07,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.18);
    }
    o.start(a.currentTime);o.stop(a.currentTime+0.22);
  }catch(e){}
}
function showMsg(t,type,duration){
  /* v1.9.96: NIC nie pojawia siÄ™ w trakcie cinematic flythrough */
  if(G && G._cinematicActive){
    if(!window._cinemQueuedMsgs) window._cinemQueuedMsgs=[];
    window._cinemQueuedMsgs.push({t,type,duration});
    return;
  }
  const el=document.getElementById('msg');el.textContent=t;
  el.style.background=type==='r'?'rgba(28,6,6,.97)':'rgba(6,18,6,.97)';
  el.style.borderColor=type==='r'?'#4a1a1a':'#1a4a1a';
  el.style.color=type==='r'?'#e07070':'#7ec87e';
  el.classList.remove('show','hide');
  el.style.display='block';
  requestAnimationFrame(()=>{el.classList.add('show');});
  clearTimeout(el._t);
  /* v1.9.89: ukryj tutorial popup gdy toast widoczny (anti-overlap) */
  const tut=document.getElementById('tutorial-popup');
  if(tut){tut.dataset._tutHidden='1';tut.style.opacity='0';tut.style.bottom='-260px';}
  // v1.8.15: zwiÄ™kszone z 3500ms do 6000ms (user: "popup znika za szybko, nie zdÄ…ĹĽam przeczytaÄ‡")
  // v1.9.82: default 8000ms â€” gracz wciÄ…ĹĽ przegapiaĹ‚. Custom duration nadpisywalny.
  const ms = duration || 8000;
  el._t=setTimeout(()=>{el.classList.remove('show');el.classList.add('hide');setTimeout(()=>{
    el.style.display='none';el.classList.remove('hide');
    /* v1.9.89: przywrĂłÄ‡ tutorial popup po znikniÄ™ciu toasta */
    const tut2=document.getElementById('tutorial-popup');
    if(tut2 && tut2.dataset._tutHidden==='1'){tut2.dataset._tutHidden='';tut2.style.bottom='80px';tut2.style.opacity='1';}
  },300);},ms);
  playNotifSound(type);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  ADMIN PANEL
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function openAdminPanel(){
  const ap=document.getElementById('admin-panel');
  document.getElementById('adm-money').value=G.money;
  document.getElementById('adm-followers').value=G.followers;
  document.getElementById('adm-health').value=G.health;
  document.getElementById('adm-energy').value=G.energy;
  document.getElementById('adm-hunger').value=G.hunger;
  document.getElementById('adm-fame').value=G.fame;
  document.getElementById('adm-stress').value=G.stress;
  document.getElementById('adm-rep').value=G.streetRep;
  document.getElementById('adm-level').value=G.level;
  document.getElementById('adm-day').value=G.day;
  document.getElementById('adm-ytsubs').value=G.yt.subs;
  document.getElementById('adm-sp').value=G.skillPoints||0;
  /* v2.1.32: nowe pola */
  document.getElementById('adm-forma').value=Math.round(G.forma||0);
  document.getElementById('adm-fitness').value=Math.round(G.fitness||0);
  document.getElementById('adm-overeat').value=Math.round(G.overeat||0);
  document.getElementById('adm-sleepdebt').value=G.sleepDebt||0;
  document.getElementById('adm-xp').value=G.xp||0;
  document.getElementById('adm-prestige').value=G.prestige||0;
  document.getElementById('adm-loan').value=(G.bank&&G.bank.loan)||0;
  document.getElementById('adm-ytviews').value=(G.yt&&G.yt.views)||0;
  document.getElementById('adm-spfllisteners').value=(G.spotify&&G.spotify.listeners)||0;
  document.getElementById('adm-tidalisteners').value=(G.tidal&&G.tidal.listeners)||0;
  // Fani podziaĹ‚y
  /* v2.1.34: fani i hejterzy to plain liczby, obserwujÄ…cy w polu adm-followers */
  document.getElementById('adm-fans').value=G.fans||0;
  document.getElementById('adm-haters').value=G.haters||0;
  // Czas
  document.getElementById('adm-hour').value=Math.floor(gameMin/60)%24;
  document.getElementById('adm-min').value=Math.floor(gameMin%60);
  document.getElementById('adm-tmul').value=String(G._adminTimeMult||1);
  document.getElementById('adm-weather').value=String(G.weather||0);
  /* v2.1.189: force prÄ™dkoĹ›Ä‡ slider pre-populate â€” 0 = OFF, 2.0-8.0 = wymuszone */
  const _spdCapInput=document.getElementById('adm-speed-cap');
  const _spdCapVal=document.getElementById('adm-speed-cap-val');
  const _curCap=(typeof G._adminSpeedCap==='number' && G._adminSpeedCap>=2.0)?G._adminSpeedCap:0;
  if(_spdCapInput){_spdCapInput.value=_curCap.toFixed(1);}
  if(_spdCapVal){_spdCapVal.textContent=_curCap>=2.0?_curCap.toFixed(1):'OFF';}
  // Freeze button stan
  const fbtn=document.getElementById('adm-freeze-btn');
  if(fbtn){
    if(G._adminFreezeStat){fbtn.textContent='âť„ď¸Ź ZamroĹş statystyki: WĹ';fbtn.style.color='#3498db';fbtn.style.borderColor='#3498db';}
    else {fbtn.textContent='âť„ď¸Ź ZamroĹş statystyki: WYĹ';fbtn.style.color='#aaa';fbtn.style.borderColor='#555';}
  }
  ap.style.display='block';
}
function applyAdmin(){
  const v=id=>parseInt(document.getElementById(id).value)||0;
  G.money=Math.max(0,v('adm-money'));
  /* v2.1.31: G.followers ustawiamy NA KOĹCU (po fans.hardcore/casual) â€” setter aktualizuje casual ĹĽeby suma = wartoĹ›Ä‡ z UI */
  G.health=clamp(v('adm-health'),0,100);
  G.energy=clamp(v('adm-energy'),0,100);
  G.hunger=clamp(v('adm-hunger'),0,100);
  G.fame=clamp(v('adm-fame'),0,500);
  G.stress=clamp(v('adm-stress'),0,100);
  G.streetRep=clamp(v('adm-rep'),0,100);
  /* v2.1.116: Wave 5 S44 â€” admin upper bounds (level max 100, xp max 99999999, prestige max 10). */
  const lvl=Math.max(1,Math.min(100,v('adm-level')));
  G.level=lvl;G.xp=0;
  G.day=Math.max(1,v('adm-day'));
  G.yt.subs=Math.max(0,v('adm-ytsubs'));
  G.yt.views=Math.max(G.yt.views,G.yt.subs*100);
  G.skillPoints=Math.max(0,v('adm-sp'));
  /* v2.1.32: nowe pola statystyk */
  G.forma=Math.max(0,Math.min(getMaxStat('forma'),v('adm-forma')));
  G.fitness=Math.max(0,Math.min(getMaxStat('fitness'),v('adm-fitness')));
  G.overeat=Math.max(0,Math.min(100,v('adm-overeat')));
  G.sleepDebt=Math.max(0,Math.min(5,v('adm-sleepdebt')));
  G.xp=Math.max(0,Math.min(99999999,v('adm-xp'))); /* v2.1.116: S44 upper bound */
  G.prestige=Math.max(0,Math.min(10,v('adm-prestige')));
  if(!G.bank) G.bank={loan:0,investments:[]};
  G.bank.loan=Math.max(0,v('adm-loan'));
  if(!G.yt) G.yt={subs:0,views:0,videos:[],adsense:0};
  G.yt.views=Math.max(0,v('adm-ytviews'));
  if(!G.spotify) G.spotify={listeners:0,streams:0,royalties:0};
  G.spotify.listeners=Math.max(0,v('adm-spfllisteners'));
  if(!G.tidal) G.tidal={listeners:0,streams:0,royalties:0};
  G.tidal.listeners=Math.max(0,v('adm-tidalisteners'));
  /* v2.1.34: trzy niezaleĹĽne plain liczniki */
  G.followers=Math.max(0,v('adm-followers'));
  G.fans=Math.max(0,v('adm-fans'));
  G.haters=Math.max(0,v('adm-haters'));
  updateHUD();
  document.getElementById('adm-msg').textContent='âś… Zastosowano!';
  setTimeout(()=>{const m=document.getElementById('adm-msg');if(m)m.textContent='';},2000);
}
function adminSetTime(){
  const h=clamp(parseInt(document.getElementById('adm-hour').value)||0,0,23);
  const m=clamp(parseInt(document.getElementById('adm-min').value)||0,0,59);
  gameMin=h*60+m;
  // Re-eval timeOfDay opcjonalnie â€” zwykle aktualizowane w pÄ™tli
  document.getElementById('adm-msg').textContent=`âŹ° Ustawiono ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
  setTimeout(()=>{const x=document.getElementById('adm-msg');if(x)x.textContent='';},1500);
}
function adminSetTimeMult(){
  const v=parseFloat(document.getElementById('adm-tmul').value);
  G._adminTimeMult=isFinite(v)?v:1;
  document.getElementById('adm-msg').textContent=`âŹ© Tempo: ${G._adminTimeMult}Ă—${G._adminTimeMult===0?' (PAUZA)':''}`;
  setTimeout(()=>{const x=document.getElementById('adm-msg');if(x)x.textContent='';},1500);
}
function adminSetWeather(){
  const w=parseInt(document.getElementById('adm-weather').value);
  G.weather=clamp(w,0,5);
  const names=['â€ď¸Ź SĹ‚onecznie','âď¸Ź Pochmurno','đźŚ§ď¸Ź Deszcz','âť„ď¸Ź Ĺšnieg','đźŚ«ď¸Ź MgĹ‚a','â›ď¸Ź Burza'];
  document.getElementById('adm-msg').textContent=`Pogoda: ${names[w]||'?'}`;
  setTimeout(()=>{const x=document.getElementById('adm-msg');if(x)x.textContent='';},1500);
}
/* v2.1.189: speed force override â€” 0/<2.0 = OFF (use formula), 2.0-8.0 = wymuĹ› konkretne P.spd. */
function adminSetSpeedCap(v){
  const x=parseFloat(v);
  const el=document.getElementById('adm-speed-cap-val');
  if(!isFinite(x) || x<2.0){
    G._adminSpeedCap=0;
    if(el) el.textContent='OFF';
