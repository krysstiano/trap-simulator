  <button class="mbtn" id="mloadfile" style="display:none;border-color:#3498db;color:#7ec8e3" onclick="loadSaveFromFile()">đź“‚  Wczytaj save z pliku</button>
  <button class="mbtn" id="mtrash" style="border-color:#aa6020;color:#f1c40f" onclick="openTrashBin()">đź—‘  Kosz (usuniÄ™te save'y)</button>
  <button class="mbtn" onclick="showHelp()">?  Sterowanie</button>
