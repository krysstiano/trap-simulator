      ${_tidalTracks.length>0?`<div style="margin-top:12px"><div style="font-size:11px;color:#00e4ff;letter-spacing:1px;margin-bottom:6px">đźŚŠ TOP UTWORY (HiFi):</div>${_tidalTracks.map(t=>`<div style="background:#050a1a;border-radius:6px;padding:6px 10px;margin-bottom:4px;font-size:12px;display:flex;justify-content:space-between"><span style="color:#fff">${(t.name||'?').slice(0,28)}</span><span style="color:#00e4ff">${Math.floor((t.streams||0)*0.3).toLocaleString('pl')} odsĹ‚uchaĹ„</span></div>`).join('')}</div>`:''}
    </div>`;
  } else if(app==='youtube'){
    ph.innerHTML=`<div class="ph-screen">
      <div style="background:#1a0a0a;border-radius:8px;padding:14px;margin-bottom:10px">
