function addFriendship(npcId, amount){
  if(!G.npcFriendship) G.npcFriendship={};
  // v1.8.21: Networking skill boost â€” szybsze znajomoĹ›ci (+1 per lvl, +PU, +evoĂ—2)
  const _netBonus=(typeof getNetworkingExtraContacts==='function')?getNetworkingExtraContacts():0;
  if(_netBonus>0 && amount>0) amount += Math.max(1, Math.floor(_netBonus));
  const old=G.npcFriendship[npcId]||0;
  const nu=Math.min(100, old+amount);
  G.npcFriendship[npcId]=nu;
  // PrĂłg odblokowania
  if(old<25 && nu>=25) addNotif(`đź’š ${npcId.toUpperCase()} â€” przyjaĹşĹ„ 25! Odblokowane lepsze opcje`);
  if(old<50 && nu>=50) addNotif(`đź’› ${npcId.toUpperCase()} â€” przyjaĹşĹ„ 50! Bonusy aktywne`);
  if(old<75 && nu>=75) addNotif(`đź§ˇ ${npcId.toUpperCase()} â€” przyjaĹşĹ„ 75! VIP traktowanie`);
  if(old<100 && nu>=100) showMsg(`âť¤ď¸Ź ${npcId.toUpperCase()} â€” MAKSYMALNA PRZYJAĹąĹ! Najlepsze nagrody.`);
}
function getFriendshipBonus(npcId){
  const f=G.npcFriendship?.[npcId]||0;
  if(f>=100) return 1.5;
  if(f>=75) return 1.3;
  if(f>=50) return 1.15;
  if(f>=25) return 1.05;
  return 1.0;
}
