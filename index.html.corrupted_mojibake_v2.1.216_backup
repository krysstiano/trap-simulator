      <!-- v2.1.120: S49 â€” peĹ‚na lista filmĂłw zamiast last 5 -->
      ${G.yt.videos.length>0?`<div style="margin-top:12px"><div style="font-size:11px;color:#ff4444;letter-spacing:1px;margin-bottom:6px">đźŽ¬ WSZYSTKIE FILMY (${G.yt.videos.length}):</div>${G.yt.videos.slice().reverse().slice(0,12).map(v=>`<div style="background:#0a0a0a;border-radius:6px;padding:8px 10px;margin-bottom:6px;font-size:13px"><div style="color:#fff">đźŽ¬ ${v.title}</div><div style="color:#666">${(v.views||0).toLocaleString('pl')} views Â· ${v.quality}% jakoĹ›ci Â· ${v.date||'?'}</div></div>`).join('')}${G.yt.videos.length>12?`<div style="text-align:center;color:#778;font-size:11px;margin-top:4px">i jeszcze ${G.yt.videos.length-12}...</div>`:''}</div>`:''}
    </div>`;
  } else if(app==='instagram'){
    // v1.8.98: Autopromocja 2 "Content creator" â€” 2 posty dziennie (poprzednio nie zaimplementowane)
    const _maxPosts=(typeof getRaperST==='function' && getRaperST('autopromocja')>=2)?2:1;
    if(G._igPostDay!==G.day){G._igPostDay=G.day;G._igPostCount=0;}
    const canPost=(G._igPostCount||0)<_maxPosts;
    const hasTracks=(G.studioTracks||[]).length>0;
    const latestTrack=hasTracks?G.studioTracks[G.studioTracks.length-1]:null;
