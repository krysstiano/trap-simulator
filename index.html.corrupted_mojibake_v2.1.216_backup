    <button onclick="adminClearBills()" style="background:#1a0a2a;border:1px solid #e91e8c;color:#e91e8c;padding:6px;border-radius:6px;font-size:11px;cursor:pointer">đź“§ SpĹ‚aÄ‡ rach.</button>
    <button onclick="adminResetCasino()" style="background:#3a1a0a;border:1px solid #f39c12;color:#f39c12;padding:6px;border-radius:6px;font-size:11px;cursor:pointer">đźŽ° Reset kasyno</button>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">
