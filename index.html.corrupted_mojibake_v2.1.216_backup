    {wx:20,wy:2620,w:150,h:140,c:'#202830'},{wx:188,wy:2620,w:150,h:140,c:'#281c1e'},
    {wx:356,wy:2620,w:150,h:140,c:'#1e2820'},{wx:520,wy:2620,w:144,h:140,c:'#28201e'},
    {wx:1060,wy:2620,w:150,h:140,c:'#1e2035'},{wx:1228,wy:2620,w:150,h:140,c:'#281e18'},
    {wx:1396,wy:2620,w:150,h:140,c:'#201e30'},{wx:1564,wy:2620,w:150,h:140,c:'#1e2820'},
    {wx:1732,wy:2620,w:150,h:140,c:'#281e1e'},{wx:1950,wy:2620,w:148,h:140,c:'#1e2028'},
    {wx:3750,wy:2620,w:150,h:140,c:'#282030'},{wx:3920,wy:2620,w:150,h:140,c:'#1e2a1e'},
    {wx:4090,wy:2620,w:150,h:140,c:'#281c1e'},
