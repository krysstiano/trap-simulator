// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  GFX EFFECTS â€” dynamic lighting / shadows / glows / vignette / particles
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// Color tint overlay zaleĹĽny od pory dnia + pogody. Subtelne â€” zachowuje czytelnoĹ›Ä‡.
// Daje "kinowy" feel: rano sepia, dzieĹ„ cool clear, wieczĂłr warm orange, noc blue.
// Smooth lighting â€” interpolacja keyframe-based zamiast skokĂłw per timeOfDay
const LIGHT_KEYFRAMES=[
  {min:0,    r:26,g:42,b:90,  a:0.42}, // 00:00 noc
  {min:300,  r:26,g:42,b:90,  a:0.42}, // 05:00 noc
  {min:360,  r:80,g:60,b:80,  a:0.32}, // 06:00 Ĺ›wit rozpoczyna
  {min:420,  r:244,g:184,b:120,a:0.18}, // 07:00 rano blask
  {min:540,  r:255,g:230,b:180,a:0.06}, // 09:00 jasny poranek
  {min:660,  r:255,g:255,b:255,a:0.0 }, // 11:00 dzieĹ„
  {min:1020, r:255,g:255,b:255,a:0.0 }, // 17:00 dzieĹ„
  {min:1080, r:255,g:230,b:160,a:0.10}, // 18:00 popoĹ‚udnie ciepĹ‚e
  {min:1140, r:224,g:120,b:64, a:0.20}, // 19:00 zachĂłd sĹ‚oĹ„ca
  {min:1200, r:140,g:60,b:90,  a:0.32}, // 20:00 zmierzch
  {min:1320, r:42,g:42,b:90,   a:0.40}, // 22:00 wczesna noc
  {min:1440, r:26,g:42,b:90,   a:0.42}, // 24:00 noc
];
function getSmoothLight(){
  const m=Math.max(0,Math.min(1440,gameMin||0));
  for(let i=0;i<LIGHT_KEYFRAMES.length-1;i++){
    const a=LIGHT_KEYFRAMES[i],b=LIGHT_KEYFRAMES[i+1];
    if(m>=a.min&&m<=b.min){
      const t=(b.min===a.min)?0:(m-a.min)/(b.min-a.min);
      return {
        r:Math.round(a.r+(b.r-a.r)*t),
        g:Math.round(a.g+(b.g-a.g)*t),
        b:Math.round(a.b+(b.b-a.b)*t),
        alpha:a.a+(b.a-a.a)*t
      };
    }
  }
  return {r:26,g:42,b:90,alpha:0.42};
}
function drawLightingOverlay(){
  if(currentRoom!=='ulica') return;
  const w=G.weather||0;
  let L=getSmoothLight();
  let tint=`rgb(${L.r},${L.g},${L.b})`,alpha=L.alpha;
  // Pogoda nakĹ‚ada siÄ™ TYLKO jeĹ›li daje wiÄ™kszÄ… gÄ™stoĹ›Ä‡
  if(w===1&&alpha<0.15){tint='#7a8090';alpha=0.15;} // pochmurno
  else if((w===2||w===5)&&alpha<0.30){tint='#3a4055';alpha=0.30;} // deszcz/burza
  else if(w===4&&alpha<0.10){tint='#9aa0a8';alpha=0.10;} // F4.4 FIX: mgĹ‚a zmniejszona z 0.22 do 0.10 (gracz widzi miasto, atmosferyczna a nie blokujaca)
  else if(w===3&&alpha<0.15){tint='#c8d4e8';alpha=0.15;} // Ĺ›nieg
  if(alpha<=0.01)return;
  X.save();
  X.globalCompositeOperation='multiply';
  X.fillStyle=tint;X.globalAlpha=alpha;
  X.fillRect(0,62,1280,658);
  X.restore();
}

// Soft shadows pod obiektami â€” ellipse u stĂłp. Kierunek/dĹ‚ugoĹ›Ä‡ zaleĹĽy od pory dnia.
// Tylko dla duĹĽych obiektĂłw (budynki) i NPC. Tile + drobne obiekty pomijamy (perf).
function drawShadows(){
  if(currentRoom!=='ulica')return;
  // v1.8.15: SMOOTH cienie â€” interpolacja miÄ™dzy keyframami pory dnia (zamiast instant switch o 6:00).
  // UĹĽywamy gameMin (0-1440) do liniowej interpolacji miÄ™dzy 4 fazami.
  const m=Math.max(0,Math.min(1440,gameMin||0));
  const SHADOW_KEYS=[
    {min:0,    dx:0, dy:4, sx:0.7, sy:0.25, a:0.10}, // noc
    {min:330,  dx:0, dy:4, sx:0.7, sy:0.25, a:0.10}, // przed Ĺ›witem
    {min:390,  dx:-12,dy:6, sx:1.6, sy:0.45, a:0.28}, // Ĺ›wit
    {min:660,  dx:0, dy:8, sx:1.0, sy:0.35, a:0.22}, // dzieĹ„
    {min:1020, dx:0, dy:8, sx:1.0, sy:0.35, a:0.22}, // popoĹ‚udnie
    {min:1140, dx:14,dy:6, sx:1.7, sy:0.5,  a:0.30}, // zachĂłd
    {min:1260, dx:0, dy:4, sx:0.7, sy:0.25, a:0.10}, // zmierzch
    {min:1440, dx:0, dy:4, sx:0.7, sy:0.25, a:0.10}, // noc
  ];
  let o={dx:0,dy:8,sx:1.0,sy:0.35,a:0.22};
  for(let i=0;i<SHADOW_KEYS.length-1;i++){
    const a=SHADOW_KEYS[i], b=SHADOW_KEYS[i+1];
    if(m>=a.min && m<=b.min){
      const t=(b.min===a.min)?0:(m-a.min)/(b.min-a.min);
      o={dx:a.dx+(b.dx-a.dx)*t, dy:a.dy+(b.dy-a.dy)*t, sx:a.sx+(b.sx-a.sx)*t, sy:a.sy+(b.sy-a.sy)*t, a:a.a+(b.a-a.a)*t};
      break;
    }
  }
  const room=ROOMS.ulica;
  X.save();X.globalAlpha=o.a;X.fillStyle='#000';
  for(const obj of room.objects){
    if(obj.id.startsWith('npc_'))continue; // npc cienie rysuje drawNPC
    if(obj.w<60||obj.h<60)continue; // tylko duĹĽe
    if(['fountain','pond','skate','bboying','bench','bench2','park_lamp1','park_lamp2','park_lamp3','park_lamp4','park_bush1','park_bush2','park_bush3','park_trash','freestyle_spot','save','wardrobe','apt_cust','phone_home'].includes(obj.id))continue;
    const sx=wx2sx(obj.wx),sy=wy2sy(obj.wy);
    if(sx<-80||sx>1320)continue;
    // CieĹ„ u podstawy: cx,cy = Ĺ›rodek dolnej krawÄ™dzi
    const cx=sx+obj.w/2+o.dx,cy=sy+obj.h+o.dy;
    const rx=obj.w*o.sx*0.3,ry=obj.h*o.sy*0.15;
    X.beginPath();X.ellipse(cx,cy,rx,ry,0,0,Math.PI*2);X.fill();
  }
  // Cienie dla DB_DECORATIVE (wiÄ™kszych)
  for(const b of DB_DECORATIVE){
    if(b.w<80)continue;
    const sx=wx2sx(b.wx),sy=wy2sy(b.wy);
    if(sx<-80||sx>1320)continue;
    const cx=sx+b.w/2+o.dx,cy=sy+b.h+o.dy;
    const rx=b.w*o.sx*0.3,ry=b.h*o.sy*0.10;
    X.beginPath();X.ellipse(cx,cy,rx,ry,0,0,Math.PI*2);X.fill();
  }
  X.restore();
}

// Glow lamp ulicznych w nocy + ciepĹ‚e Ĺ›wiatĹ‚a okien budynkĂłw
function drawNightGlows(){
  if(currentRoom!=='ulica')return;
  const t=G.timeOfDay;
  // F+ 2026-05-12 #62: smooth fade intensywnoĹ›ci lamp zamiast skokĂłw dyskretnych
  // CiÄ…gĹ‚a wartoĹ›Ä‡ godziny (0-24) â†’ intensity 0..1 z pĹ‚ynnymi przejĹ›ciami przy zmianach pory dnia
  const _hr=(typeof gameMin==='number')?(gameMin/60)%24:(t>=2?20:14);
  let intensity=0;
  if(_hr>=17.5&&_hr<18){intensity=((_hr-17.5)/0.5)*0.40;}        // 17:30-18:00 fade in dzieĹ„â†’wieczĂłr
  else if(_hr>=18&&_hr<22.5){intensity=0.40;}                     // wieczĂłr stabilne
  else if(_hr>=22.5&&_hr<23){intensity=0.40+((_hr-22.5)/0.5)*0.60;} // 22:30-23:00 fade wieczĂłrâ†’noc
  else if(_hr>=23||_hr<5.5){intensity=1.0;}                       // noc
  else if(_hr>=5.5&&_hr<6){intensity=1.0-((_hr-5.5)/0.5);}        // 5:30-06:00 fade nocâ†’rano
  if(intensity<=0.02)return;
  X.save();X.globalCompositeOperation='lighter';
  // Lamp positions â€” re-utilize z drawLamps logic
  const lampRows=[{wy:378},{wy:670},{wy:1918},{wy:2204},{wy:2878,maxX:3750},{wy:3164,maxX:3750}];
  const vRoadZones=[[768,960],[2208,2400],[3456,3648]];
  const now=Date.now();
  for(const row of lampRows){
    for(let x=160;x<4400;x+=400){
      if(row.maxX&&x>row.maxX)break;
      if(vRoadZones.some(([a,b])=>x>a-60&&x<b+60))continue;
      const sx=wx2sx(x),sy=wy2sy(row.wy);
      if(sx<-120||sx>1400||sy<-120||sy>820)continue;
      const pulse=0.88+Math.sin(now*0.0018+x*0.013)*0.12;
      // KLOSZ jest na pozycji (sx+9, sy-50) â€” szczyt latarni, koniec wysiÄ™gnika
      const lampX=sx+9, lampY=sy-50;
      // Warstwa 1: jasny rdzeĹ„ przy kloszu
      const r1=14*intensity*pulse;
      const g1=X.createRadialGradient(lampX,lampY,0,lampX,lampY,r1);
      g1.addColorStop(0,`rgba(255,250,210,${0.95*intensity})`);
      g1.addColorStop(1,'rgba(255,225,150,0)');
      X.fillStyle=g1;X.beginPath();X.arc(lampX,lampY,r1,0,Math.PI*2);X.fill();
      // Warstwa 2: korona wokĂłĹ‚ klosza (mniejsza ĹĽeby nie siÄ™gaĹ‚a w poĹ‚owy sĹ‚upa)
      const r2=30*intensity*pulse;
      const g2=X.createRadialGradient(lampX,lampY,3,lampX,lampY,r2);
      g2.addColorStop(0,`rgba(255,225,140,${0.45*intensity})`);
      g2.addColorStop(0.5,`rgba(255,200,100,${0.18*intensity})`);
      g2.addColorStop(1,'rgba(255,180,80,0)');
      X.fillStyle=g2;X.beginPath();X.arc(lampX,lampY,r2,0,Math.PI*2);X.fill();
      // Warstwa 3: stoĹĽek Ĺ›wiatĹ‚a na chodnik POD lampÄ… (na szerokoĹ›Ä‡)
      const r3=70*intensity*pulse;
      const coneY=sy+5; // chodnik
      const g3=X.createRadialGradient(lampX-5,coneY,0,lampX-5,coneY,r3);
      g3.addColorStop(0,`rgba(255,210,130,${0.22*intensity})`);
      g3.addColorStop(0.4,`rgba(255,200,120,${0.12*intensity})`);
      g3.addColorStop(1,'rgba(255,180,80,0)');
      X.fillStyle=g3;X.beginPath();X.ellipse(lampX-5,coneY,r3,r3*0.4,0,0,Math.PI*2);X.fill();
      // Smuga Ĺ›wiatĹ‚a stoĹĽkowa od klosza w dĂłĹ‚ (jak prawdziwa lampa Ĺ›wieci)
      const beamG=X.createLinearGradient(lampX,lampY,lampX,coneY);
      beamG.addColorStop(0,`rgba(255,235,160,${0.30*intensity})`);
      beamG.addColorStop(0.6,`rgba(255,215,130,${0.12*intensity})`);
      beamG.addColorStop(1,'rgba(255,200,100,0)');
      X.fillStyle=beamG;
      X.beginPath();
      X.moveTo(lampX-3,lampY+3);X.lineTo(lampX+3,lampY+3);
      X.lineTo(lampX+22,coneY);X.lineTo(lampX-25,coneY);X.closePath();X.fill();
    }
  }
  // Per-window glow w nocy â€” okna Ĺ›wiecÄ… lokalnie, nie caĹ‚y budynek
  if(t===3){
    const room=ROOMS.ulica;
    for(const obj of room.objects){
      if(obj.w<80||obj.h<80)continue;
      if(obj.id.startsWith('npc_'))continue;
      if(['fountain','pond','skate','bboying','freestyle_spot'].includes(obj.id))continue;
      const sx=wx2sx(obj.wx),sy=wy2sy(obj.wy);
      if(sx<-120||sx>1400)continue;
      // Wybierz "okna" deterministycznie â€” siatka 2-4 na budynek
      const wCols=Math.min(4,Math.max(2,Math.floor(obj.w/40)));
      const wRows=2;
      for(let r=0;r<wRows;r++){
        for(let c=0;c<wCols;c++){
          // Deterministyczne flicker â€” ~70% okien Ĺ›wieci
          const lit=(((obj.wx*7+obj.wy*13+r*31+c*17)%10)<7);
          if(!lit)continue;
          const wx=sx+(c+0.5)*(obj.w/wCols);
          const wy=sy+(r===0?obj.h*0.30:obj.h*0.55);
          // MaĹ‚a pulsacja
          const ph=0.92+Math.sin(now*0.0015+obj.wx*0.01+r*c)*0.08;
          const r1=14*ph;
          const g1=X.createRadialGradient(wx,wy,0,wx,wy,r1);
          g1.addColorStop(0,'rgba(255,235,170,0.55)');
          g1.addColorStop(0.5,'rgba(255,210,130,0.18)');
          g1.addColorStop(1,'rgba(255,200,120,0)');
          X.fillStyle=g1;X.beginPath();X.arc(wx,wy,r1,0,Math.PI*2);X.fill();
        }
      }
    }
    // Reflektory aut (dodatek): kaĹĽde auto ma snop Ĺ›wiatĹ‚a do przodu
    if(typeof cityCars!=='undefined'){
      for(const car of cityCars){
        const sx=wx2sx(car.wx),sy=wy2sy(car.wy);
        if(sx<-120||sx>1400||sy<-100||sy>820)continue;
        // F6 E1: kierunek wg BASE (nie aktualnej dx, ĹĽeby auto stojÄ…ce na czerwonym nie obracaĹ‚o siÄ™)
        const dir=((car.baseSpd||car.dx)>=0)?1:-1;
        const headX=sx+(dir>0?44:8);
        const headY=sy+10;
        const beamLen=70,beamW=24;
        const g=X.createRadialGradient(headX,headY,2,headX+dir*beamLen,headY,beamW);
        g.addColorStop(0,'rgba(255,250,200,0.55)');
        g.addColorStop(0.4,'rgba(255,235,160,0.20)');
        g.addColorStop(1,'rgba(255,235,160,0)');
        X.fillStyle=g;
        X.beginPath();
        X.moveTo(headX,headY-3);
        X.lineTo(headX+dir*beamLen,headY-beamW/2);
        X.lineTo(headX+dir*beamLen,headY+beamW/2);
        X.lineTo(headX,headY+3);
        X.closePath();X.fill();
      }
    }
  }
  X.restore();
}

// Wet asphalt â€” kiedy deszcz/burza, drogi majÄ… cienkie warstwy odbiciowe (lekkie bĹ‚yszczenie).
// Subtelny wertykalny gradient na drodze oraz kaĹ‚uĹĽe w wieczĂłr/noc.
function drawWetSurfaces(){
  if(currentRoom!=='ulica')return;
  const w=G.weather||0;
  if(w!==2&&w!==5)return; // tylko deszcz i burza
  const t=G.timeOfDay;
  const intensity=w===5?0.55:0.35;
  // H1 / H2 / H3 droga â€” wy bands
  const roadBands=[[384,576],[1920,2112],[2880,3072]];
  X.save();X.globalCompositeOperation='screen';
  for(const [y0,y1] of roadBands){
    const sy0=wy2sy(y0),sy1=wy2sy(y1);
    if(sy1<62||sy0>720)continue;
    // Vertical gradient â€” ciemny do jasnego (odbicia)
    const g=X.createLinearGradient(0,sy0,0,sy1);
    g.addColorStop(0,`rgba(80,90,110,${0.06*intensity})`);
    g.addColorStop(0.5,`rgba(140,150,170,${0.16*intensity})`);
    g.addColorStop(1,`rgba(80,90,110,${0.06*intensity})`);
    X.fillStyle=g;X.fillRect(0,Math.max(62,sy0),1280,Math.min(720,sy1)-Math.max(62,sy0));
  }
  X.restore();
  // KaĹ‚uĹĽe â€” drobne plamy odbiciowe (pre-deterministyczne pozycje)
  X.save();X.globalCompositeOperation='lighter';
  const puddles=[
    {wx:600,wy:480},{wx:1100,wy:495},{wx:1700,wy:475},{wx:2300,wy:485},
    {wx:1300,wy:2010},{wx:1900,wy:2030},{wx:2500,wy:2020},
    {wx:2700,wy:2960},{wx:3200,wy:2985}
  ];
  for(const p of puddles){
    const sx=wx2sx(p.wx),sy=wy2sy(p.wy);
    if(sx<-30||sx>1310||sy<32||sy>760)continue;
    const sh=t>=2?'rgba(180,200,230,0.20)':'rgba(150,170,200,0.14)';
    X.fillStyle=sh;X.beginPath();X.ellipse(sx,sy,12,5,0,0,Math.PI*2);X.fill();
    // Droplets ripple â€” animowane okrÄ™gi
    const t1=(Date.now()*0.0006+p.wx*0.001)%1;
    X.strokeStyle=`rgba(180,200,230,${(1-t1)*0.4})`;X.lineWidth=1;
    X.beginPath();X.ellipse(sx,sy,6+t1*8,3+t1*3,0,0,Math.PI*2);X.stroke();
  }
  X.restore();
  // Wet road â€” subtle dark layer dodajÄ…cy "polor"
  X.save();X.globalCompositeOperation='multiply';
  for(const [y0,y1] of roadBands){
    const sy0=Math.max(62,wy2sy(y0)),sy1=Math.min(720,wy2sy(y1));
    if(sy1<62||sy0>720)continue;
    X.fillStyle=`rgba(40,45,55,${0.18*intensity})`;
    X.fillRect(0,sy0,1280,sy1-sy0);
  }
  X.restore();
}

// Atmospheric fog â€” subtelna mgĹ‚a unosi siÄ™ po ulicy rano i wieczorem (low layer).
// Animowana â€” przesuwa siÄ™ w lewo/prawo.
function drawAtmosphericFog(){
  if(currentRoom!=='ulica')return;
  const t=G.timeOfDay;
  const w=G.weather||0;
  // Mocniejsza przy mgle (w=4) i delikatna rano/wieczĂłr
  let intensity=0;
  if(w===4) intensity=0.6;
  else if(t===0) intensity=0.18; // rano
  else if(t===2) intensity=0.10; // wieczĂłr
  if(intensity<=0)return;
  const now=Date.now();
  X.save();
  // 3 pasy mgĹ‚y poruszajÄ…ce siÄ™ z rĂłĹĽnym tempem
  const drift1=(now*0.015)%1280;
  const drift2=(now*0.022)%1280;
  const drift3=(now*0.010)%1280;
  // Ground layer â€” niska mgĹ‚a
  const g1=X.createLinearGradient(0,520,0,720);
  g1.addColorStop(0,`rgba(220,225,235,0)`);
  g1.addColorStop(0.5,`rgba(220,225,235,${0.12*intensity})`);
  g1.addColorStop(1,`rgba(220,225,235,${0.20*intensity})`);
  X.fillStyle=g1;X.fillRect(0,520,1280,200);
  // Drifting fog patches
  for(let i=0;i<5;i++){
    const x=((i*270-drift1)%(1280+200))-100;
    const y=400+Math.sin(now*0.0008+i)*30;
    const r=180;
    const g=X.createRadialGradient(x,y,20,x,y,r);
    g.addColorStop(0,`rgba(230,235,240,${0.10*intensity})`);
    g.addColorStop(0.5,`rgba(220,230,240,${0.06*intensity})`);
    g.addColorStop(1,'rgba(220,230,240,0)');
    X.fillStyle=g;X.beginPath();X.ellipse(x,y,r,r*0.4,0,0,Math.PI*2);X.fill();
  }
  // Lower atmospheric drift
  for(let i=0;i<4;i++){
    const x=((i*340+drift2)%(1280+300))-150;
    const y=600+Math.cos(now*0.0006+i)*20;
    const g=X.createRadialGradient(x,y,30,x,y,200);
    g.addColorStop(0,`rgba(220,225,235,${0.14*intensity})`);
    g.addColorStop(1,'rgba(220,225,235,0)');
    X.fillStyle=g;X.beginPath();X.ellipse(x,y,200,80,0,0,Math.PI*2);X.fill();
  }
  X.restore();
}

// Neon signs glow â€” sklepy majÄ… Ĺ›wiecÄ…ce szyldy w nocy z bloom + flicker
function drawNeonSigns(){
  if(currentRoom!=='ulica')return;
  const t=G.timeOfDay;
  if(t<2)return; // tylko wieczĂłr + noc
  const intensity=t===3?1.0:0.55;
  const room=ROOMS.ulica;
  const now=Date.now();
  // Mapuje obiekty na ich kolor neonu (z drawBuilding accent)
  const neonColors={
    sklep:'#f1c40f',muzyczny:'#9b59b6',silownia:'#e67e22',ubrania:'#e91e8c',
    fryzjer:'#3498db',mediamarkt:'#e74c3c',studio:'#9b59b6',szpital:'#e74c3c',
    kurier:'#f39c12',pizzeria:'#e67e22',supermarket:'#2ecc71',restauracja:'#e67e22',
    carwash:'#3498db',construction:'#f1c40f',sala_konce:'#e91e8c',targ:'#f1c40f',
    warsztat:'#e67e22',meble:'#FFDA1A',merch_studio:'#e91e63',
    biuro_nieruch:'#3498db',salon:'#27ae60',radio_st:'#e74c3c'
  };
  X.save();X.globalCompositeOperation='lighter';
  for(const obj of room.objects){
    const col=neonColors[obj.id];
    if(!col)continue;
    const sx=wx2sx(obj.wx),sy=wy2sy(obj.wy);
    if(sx<-100||sx>1380)continue;
    // Flicker effect â€” czasami "miga" jak sterowne neony
    const flickerSeed=(obj.wx*7+obj.wy*11)%100;
    const flicker=(Math.sin(now*0.001+flickerSeed)*0.5+0.5)>0.04?1.0:0.4;
    // Pozycja szyldu â€” gĂłra budynku (gdzie label jest narysowany)
    const cx=sx+obj.w/2;
    const cy=sy+obj.h*0.30; // ~tam gdzie label
    const baseR=28*intensity*flicker;
    // Bloom warstwa 1 â€” mocno wokĂłĹ‚ tekstu
    const g1=X.createRadialGradient(cx,cy,2,cx,cy,baseR);
    g1.addColorStop(0,col+'cc');
    g1.addColorStop(0.4,col+'40');
    g1.addColorStop(1,col+'00');
    X.fillStyle=g1;X.beginPath();X.arc(cx,cy,baseR,0,Math.PI*2);X.fill();
    // Bloom warstwa 2 â€” szersza poĹ›wiata
    const r2=70*intensity*flicker;
    const g2=X.createRadialGradient(cx,cy,15,cx,cy,r2);
    g2.addColorStop(0,col+'30');
    g2.addColorStop(0.5,col+'10');
    g2.addColorStop(1,col+'00');
    X.fillStyle=g2;X.beginPath();X.arc(cx,cy,r2,0,Math.PI*2);X.fill();
  }
  X.restore();
}

// Vignette â€” subtelne ciemnienie rogĂłw. Mocniejsza w nocy, prawie niewidoczna w dzieĹ„.
function drawVignette(){
  if(currentRoom!=='ulica')return; // wnÄ™trza juĹĽ majÄ… wĹ‚asnÄ… estetykÄ™
  const t=G.timeOfDay;
  const intensity={0:0.18,1:0.10,2:0.22,3:0.35}[t]||0.15;
  const w=1280,h=720;
  const cx=w/2,cy=(62+(h-62)/2);
  const g=X.createRadialGradient(cx,cy,420,cx,cy,760);
  g.addColorStop(0,'rgba(0,0,0,0)');
  g.addColorStop(0.65,`rgba(0,0,0,${intensity*0.4})`);
  g.addColorStop(1,`rgba(0,0,0,${intensity})`);
  X.save();X.fillStyle=g;X.fillRect(0,62,w,h-62);X.restore();
}

// Particle pool â€” proste czÄ…stki dla efektĂłw. ReuĹĽywany array.
const _particles=[];
function _spawnParticle(p){_particles.push(p);if(_particles.length>180)_particles.shift();}
function emitDust(wx,wy){_spawnParticle({wx,wy,vx:(Math.random()-0.5)*0.4,vy:-0.3-Math.random()*0.4,life:30,max:30,col:'rgba(190,170,140,',size:2+Math.random()*2});}
function emitSpark(wx,wy,col){
  for(let i=0;i<6;i++){
    const a=Math.random()*Math.PI*2,sp=1.2+Math.random()*1.8;
    _spawnParticle({wx,wy,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-0.6,life:24,max:24,col:(col||'rgba(255,220,140,'),size:1.5+Math.random()*1.5,grav:0.06});
  }
}
function emitSmoke(wx,wy){_spawnParticle({wx,wy:wy-Math.random()*4,vx:(Math.random()-0.5)*0.2,vy:-0.4-Math.random()*0.3,life:60,max:60,col:'rgba(120,120,130,',size:3+Math.random()*4,grow:0.05});}
function updateAndDrawParticles(){
  X.save();
  for(let i=_particles.length-1;i>=0;i--){
    const p=_particles[i];p.life--;
    p.wx+=p.vx;p.wy+=p.vy;
    if(p.grav)p.vy+=p.grav;
    if(p.grow)p.size+=p.grow;
    if(p.life<=0){_particles.splice(i,1);continue;}
    const sx=wx2sx(p.wx),sy=wy2sy(p.wy);
    if(sx<-30||sx>1310||sy<32||sy>760)continue;
    const a=p.life/p.max;
    X.fillStyle=p.col+a.toFixed(2)+')';
    X.beginPath();X.arc(sx,sy,p.size,0,Math.PI*2);X.fill();
  }
  X.restore();
}
// Auto-emit smoke z budynkĂłw komercyjnych co kilka klatek
let _smokeCounter=0;
function emitAmbientSmoke(){
  if(currentRoom!=='ulica')return;
  if(++_smokeCounter<22)return;
  _smokeCounter=0;
  // Wybierz losowy "komin" z puli
  const chimneys=[
    {wx:170,wy:135},{wx:1480,wy:135},{wx:2700,wy:680},
    {wx:1100,wy:680},{wx:1900,wy:680},{wx:3200,wy:2210}
  ];
  const c=chimneys[Math.floor(Math.random()*chimneys.length)];
  emitSmoke(c.wx,c.wy);
}
// Auto-emit kurz pod stopami biegnÄ…cego gracza
let _dustCounter=0;
function emitFootDust(){
  if(currentRoom!=='ulica')return;
  if(!P.moving)return;
  if(++_dustCounter<6)return;
  _dustCounter=0;
  emitDust(P.wx+P.w/2+(Math.random()-0.5)*8,P.wy+P.h-2);
}

function drawWeatherFX(){
  // Low health dramatic effect
  if(G.health<25&&G.health>0){
    const pulse=0.5+Math.sin(Date.now()/200)*0.5;
    X.fillStyle=`rgba(255,0,0,${0.18+pulse*0.12})`;
    X.fillRect(0,62,1280,658);
    // PulsujÄ…ce przyciemnienie
    if(pulse>0.85){X.fillStyle='rgba(0,0,0,0.15)';X.fillRect(0,62,1280,658);}
    // DĹşwiÄ™k alarmu co kilka sekund
    if(!window._lastDangerSound||Date.now()-window._lastDangerSound>4000){
      window._lastDangerSound=Date.now();
      playDangerSound();
    }
  }
  // Only show precipitation outdoors
  const outdoor=currentRoom==='ulica';
  const w=G.weather;
  if(outdoor){
    if(w===2||w===5){
      X.strokeStyle=w===5?'rgba(150,180,255,.35)':'rgba(160,190,255,.25)';X.lineWidth=1;
      for(let i=0;i<(w===5?70:40);i++){
        const rx=sr(i*3+weatherTick*.007)*1280,ry=(sr(i*3+1)*720+(weatherTick*(w===5?4:2)))%720+62;
        X.beginPath();X.moveTo(rx,ry);X.lineTo(rx+(w===5?-5:-2),ry+(w===5?16:12));X.stroke();
      }
      if(w===5&&Math.random()<.002){X.fillStyle='rgba(200,220,255,.07)';X.fillRect(0,62,1280,658);}
    }
    if(w===3){
      // PadajÄ…ce pĹ‚atki Ĺ›niegu â€” z sway i sparkle
      for(let i=0;i<70;i++){
        const seed=i*7.3;
        const baseX=sr(seed)*1280;
        const sway=Math.sin(weatherTick*0.018+i*0.5)*18;
        const rx=(baseX+sway+1280)%1280;
        const ry=(sr(seed+1)*658+(weatherTick*1.1))%658+62;
        const size=sr(seed+2)*2.2+0.9;
        const alpha=0.55+sr(seed+3)*0.35;
        X.fillStyle=`rgba(255,255,255,${alpha})`;
        X.shadowBlur=size>1.8?5:0;X.shadowColor='rgba(200,220,255,.6)';
        X.beginPath();X.arc(rx,ry,size,0,Math.PI*2);X.fill();
        // WiÄ™ksze pĹ‚atki â€” gwiazdkowe ramiona
        if(size>1.8){
          X.strokeStyle=`rgba(240,250,255,${alpha*0.7})`;X.lineWidth=0.5;
          X.beginPath();X.moveTo(rx-size*1.3,ry);X.lineTo(rx+size*1.3,ry);
          X.moveTo(rx,ry-size*1.3);X.lineTo(rx,ry+size*1.3);X.stroke();
        }
      }
      X.shadowBlur=0;
    }
  }
  /* v1.9.20: BUG FIX â€” mgĹ‚a tylko na ulicy (poprzednio leak do mieszkania/studio/siĹ‚owni) */
  if(w===4 && outdoor){X.fillStyle='rgba(180,190,200,.18)';X.fillRect(0,62,1280,658);}
  // F+ Punkt #21: pĹ‚atki kwiatĂłw spadajÄ…ce wiosnÄ… (cherry blossom / bzy)
  if(outdoor && typeof getSeason==='function' && (getSeason()?.id==='spring')){
    const petalCols=['#ffc0cb','#ff80b0','#ffd0e0','#ff70a0'];
    for(let i=0;i<22;i++){
      const seed=i*9.3;
      const baseX=sr(seed)*1280;
      const sway=Math.sin(weatherTick*0.014+i*0.6)*36;
      const rx=(baseX+sway+1280)%1280;
      const ry=(sr(seed+1)*658+(weatherTick*0.45))%658+62;
      const rotation=weatherTick*0.05+i*1.3;
      const size=1.6+sr(seed+2)*1.4;
      const col=petalCols[Math.floor(sr(seed+3)*4)];
      X.save();X.translate(rx,ry);X.rotate(rotation);
      // 5-pĹ‚atkowy kwiat
      X.fillStyle=col;
      for(let p=0;p<5;p++){
        const a=p*Math.PI*0.4;
        X.beginPath();X.ellipse(Math.cos(a)*size*0.6,Math.sin(a)*size*0.6,size*0.8,size*0.4,a,0,Math.PI*2);X.fill();
      }
      // Ĺšrodek (ĹĽĂłĹ‚ty)
      X.fillStyle='#f1c40f';X.beginPath();X.arc(0,0,size*0.4,0,Math.PI*2);X.fill();
      X.restore();
    }
  }

  // F+ Punkt #34: liĹ›cie spadajÄ…ce jesieniÄ… (particle) â€” niezaleĹĽne od pogody
  if(outdoor && typeof getSeason==='function' && (getSeason()?.id==='autumn')){
    const leafCols=['#a04020','#c46818','#e09020','#f0b840','#8a3a18'];
    for(let i=0;i<28;i++){
      const seed=i*11.7;
      const baseX=sr(seed)*1280;
      const sway=Math.sin(weatherTick*0.012+i*0.7)*32;
      const rx=(baseX+sway+1280)%1280;
      const ry=(sr(seed+1)*658+(weatherTick*0.55))%658+62;
      const rotation=weatherTick*0.04+i;
      const size=1.8+sr(seed+2)*1.6;
      const col=leafCols[Math.floor(sr(seed+3)*5)];
      X.save();X.translate(rx,ry);X.rotate(rotation);
      X.fillStyle=col;X.beginPath();X.ellipse(0,0,size,size*1.5,0,0,Math.PI*2);X.fill();
      X.strokeStyle='rgba(80,40,10,.5)';X.lineWidth=0.4;
      X.beginPath();X.moveTo(0,-size*1.5);X.lineTo(0,size*1.5);X.stroke();
      X.restore();
    }
  }
  // â”€â”€ Ĺšnieg na budynkach i blokach (akumulacja Ĺ›niegu) â”€â”€
  if(w===3&&outdoor){
    X.save();
    const SNOW_DEPTH=7; // px na ekranie
    // Dekoracyjne bloki
    DB_DECORATIVE.forEach(b=>{
      const dsx=wx2sx(b.wx),dsy=wy2sy(b.wy);
      if(dsx<-b.w-10||dsx>1340||dsy<-SNOW_DEPTH-10||dsy>790)return;
      const sg=X.createLinearGradient(dsx,dsy,dsx,dsy+SNOW_DEPTH);
      sg.addColorStop(0,'rgba(240,248,255,.9)');sg.addColorStop(1,'rgba(220,235,255,.0)');
      X.fillStyle=sg;X.fillRect(dsx,dsy,b.w,SNOW_DEPTH);
    });
    // Budynki funkcjonalne z ROOMS.ulica
    if(currentRoom==='ulica'){
      const bldgs=ROOMS.ulica.objects.filter(o=>o.w>60&&o.h>60&&!o.id.startsWith('npc_'));
      bldgs.forEach(b=>{
        const bsx=wx2sx(b.wx),bsy=wy2sy(b.wy);
        if(bsx<-b.w-10||bsx>1340||bsy<-SNOW_DEPTH-10||bsy>790)return;
        const sg2=X.createLinearGradient(bsx,bsy,bsx,bsy+SNOW_DEPTH+2);
        sg2.addColorStop(0,'rgba(240,248,255,.85)');sg2.addColorStop(1,'rgba(220,235,255,.0)');
        X.fillStyle=sg2;X.fillRect(bsx,bsy,b.w,SNOW_DEPTH+2);
        // Ĺšnieg na wystajÄ…cym gzymsie â€” maĹ‚a beleczka
        X.fillStyle='rgba(255,255,255,.6)';X.fillRect(bsx-2,bsy+SNOW_DEPTH+1,b.w+4,2);
      });
    }
    X.restore();
  }
  // â”€â”€ KaĹ‚uĹĽe deszczowe (animowane kĂłĹ‚ka-ripple) â”€â”€
  if((w===2||w===5)&&outdoor){
    X.save();
    const puddles=[
      {wx:200,wy:340},{wx:550,wy:345},{wx:900,wy:338},{wx:1300,wy:342},{wx:1700,wy:339},
      {wx:2100,wy:344},{wx:2600,wy:340},{wx:3000,wy:342},{wx:3500,wy:338},{wx:4000,wy:342},
      {wx:300,wy:630},{wx:700,wy:625},{wx:1100,wy:628},{wx:1500,wy:632},{wx:1900,wy:627},
      {wx:2300,wy:630},{wx:2800,wy:626},{wx:3200,wy:630},{wx:3700,wy:628},
    ];
    const rt=weatherTick*0.04;
    puddles.forEach((p,i)=>{
      const psx=wx2sx(p.wx),psy=wy2sy(p.wy);
      if(psx<-30||psx>1310||psy<62||psy>718)return;
      const phase=(rt+i*0.7)%(Math.PI*2);
      const r1=6+Math.sin(phase)*3,r2=12+Math.sin(phase+1)*4;
      X.strokeStyle=`rgba(150,180,220,${0.3+Math.sin(phase)*0.12})`;X.lineWidth=1;
      X.beginPath();X.ellipse(psx,psy,r1,r1*0.35,0,0,Math.PI*2);X.stroke();
      X.strokeStyle=`rgba(150,180,220,${0.18+Math.sin(phase+1)*0.08})`;X.lineWidth=0.7;
      X.beginPath();X.ellipse(psx,psy,r2,r2*0.35,0,0,Math.PI*2);X.stroke();
    });
    X.restore();
  }
  // WnÄ™trza (mieszkanie/studio/silownia/etc.) â€” pomijamy globalny tint pora-dnia,
  // bo tam Ĺ›wieci sztuczne Ĺ›wiatĹ‚o. Tylko zewnÄ…trz (ulica) reaguje na czas.
  const isInterior=currentRoom!=='ulica';
  const dc=CFG.DAY_COLORS[G.timeOfDay];
  // v1.8.18: SMOOTH alpha â€” wczeĹ›niej dyskretne 0/0.18/0.42 powodowaĹ‚o skok jasnoĹ›ci o 6:00 i 18:00.
  // Teraz: liniowa interpolacja na keyframach gameMin (0-1440) â€” Ĺ›wit 5:30-7:30, zmierzch 17:30-22:30.
  let alpha=0;
  if(!isInterior){
    const m=Math.max(0,Math.min(1440,gameMin||0));
    const NIGHT_KEYS=[
      {min:0,    a:0.42}, // gĹ‚Ä™boka noc
      {min:330,  a:0.42}, // 5:30 â€” jeszcze noc
      {min:360,  a:0.30}, // 6:00 â€” poczÄ…tek Ĺ›witu
      {min:390,  a:0.15}, // 6:30 â€” wschĂłd
      {min:420,  a:0.05}, // 7:00 â€” prawie dzieĹ„
      {min:450,  a:0.00}, // 7:30 â€” peĹ‚en dzieĹ„
      {min:1020, a:0.00}, // 17:00 â€” koniec dnia
      {min:1080, a:0.05}, // 18:00 â€” poczÄ…tek zmierzchu
      {min:1140, a:0.12}, // 19:00 â€” wieczĂłr
      {min:1260, a:0.25}, // 21:00 â€” gĹ‚Ä™bszy wieczĂłr
      {min:1320, a:0.36}, // 22:00 â€” prawie noc
      {min:1380, a:0.42}, // 23:00 â€” noc
      {min:1440, a:0.42}, // 24:00 â€” noc
    ];
    for(let i=0;i<NIGHT_KEYS.length-1;i++){
      const a=NIGHT_KEYS[i], b=NIGHT_KEYS[i+1];
      if(m>=a.min && m<=b.min){
        const t=(b.min===a.min)?0:(m-a.min)/(b.min-a.min);
        alpha=a.a+(b.a-a.a)*t;
        break;
      }
    }
  }
  if(alpha>0){X.fillStyle=`rgba(0,0,20,${alpha})`;X.fillRect(0,62,1280,658);}
  if(!isInterior){
    const sky=X.createLinearGradient(0,62,0,120);
    sky.addColorStop(0,dc.sky);sky.addColorStop(1,'rgba(0,0,0,0)');
    X.fillStyle=sky;X.fillRect(0,62,1280,62);
  }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  SAMOCHĂ“D GRACZA
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function drawPlayerCar(){
  /* v2.1.60 Amper: rysuj rĂłwnieĹĽ ZAPARKOWANE auto na pozycji G._carParkedAt â€” gracz musi wiedzieÄ‡ gdzie wysiadĹ‚.
     WczeĹ›niej auto znikaĹ‚o po wysiadce (G._inCar=false) i gracz nie miaĹ‚ wskazĂłwki gdzie wrĂłciÄ‡. */
  if(G.car && currentRoom==='ulica' && G._carParkedAt && !G._inCar){
    const _psx=wx2sx(G._carParkedAt.wx)+P.w/2;
    const _psy=wy2sy(G._carParkedAt.wy)+P.h/2;
    const carC={'Maluch':'#c0392b','Seat Ibiza':'#2471a3','BMW E46':'#1c2833'};
    const body=G.car.color||(carC[G.car.name]||'#555');
    X.save();
    X.translate(_psx,_psy);
    /* CieĹ„ */
    X.fillStyle='rgba(0,0,0,.30)';X.beginPath();X.ellipse(3,5,30,14,0,0,Math.PI*2);X.fill();
    /* Karoseria */
    const bw=60,bh=28;
    X.fillStyle=body;X.fillRect(-bw/2,-bh/2,bw,bh);
    X.fillStyle=darkenHex(body,18);X.fillRect(-bw/2+10,-bh/2+4,bw-22,bh-8);
    X.fillStyle='rgba(160,215,255,0.75)';X.fillRect(bw/2-16,-bh/2+4,11,bh-8);
    X.fillStyle='rgba(160,215,255,0.5)';X.fillRect(-bw/2+5,-bh/2+4,9,bh-8);
    X.fillStyle='#111';
    X.fillRect(bw/2-12,-bh/2-3,9,6);X.fillRect(bw/2-12,bh/2-3,9,6);
    X.fillRect(-bw/2+3,-bh/2-3,9,6);X.fillRect(-bw/2+3,bh/2-3,9,6);
    /* PulsujÄ…cy marker đźš— nad zaparkowanym autem (tylko gdy auto poza ekranem widoczne teĹĽ przez minimapÄ™) */
    const _pulse=0.7+Math.sin(Date.now()/500)*0.3;
    X.font='bold 18px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.shadowColor='#f1c40f';X.shadowBlur=12*_pulse;
    X.fillStyle=`rgba(241,196,15,${_pulse})`;
    X.fillText('đźš—',0,-32);
    X.shadowBlur=0;X.textAlign='left';X.textBaseline='alphabetic';
    X.restore();
  }
  // #17: Rysuj auto TYLKO gdy gracz wsiadĹ‚ (G._inCar) i jest na ulicy
  if(!G.car||currentRoom!=='ulica'||!G._inCar)return;
  const sx=wx2sx(P.wx)+P.w/2;
  const sy=wy2sy(P.wy)+P.h/2;
  const carC={'Maluch':'#c0392b','Seat Ibiza':'#2471a3','BMW E46':'#1c2833'};
  const body=G.car.color||(carC[G.car.name]||'#555');
  const d=P.dir; // 0=up,1=right,2=down,3=left
  X.save();
  X.translate(sx,sy);
  X.rotate([Math.PI*1.5,0,Math.PI*.5,Math.PI][d]||0);
  // Shadow
  X.fillStyle='rgba(0,0,0,.22)';X.beginPath();X.ellipse(3,5,30,14,0,0,Math.PI*2);X.fill();
  // Car body (front = right)
  const bw=60,bh=28;
  X.fillStyle=body;X.fillRect(-bw/2,-bh/2,bw,bh);
  // Roof
  X.fillStyle=darkenHex(body,18);X.fillRect(-bw/2+10,-bh/2+4,bw-22,bh-8);
  // Windshield
  X.fillStyle='rgba(160,215,255,0.75)';X.fillRect(bw/2-16,-bh/2+4,11,bh-8);
  // Rear window
  X.fillStyle='rgba(160,215,255,0.5)';X.fillRect(-bw/2+5,-bh/2+4,9,bh-8);
  // Wheels
  X.fillStyle='#111';
  X.fillRect(bw/2-12,-bh/2-3,9,6);X.fillRect(bw/2-12,bh/2-3,9,6);
  X.fillRect(-bw/2+3,-bh/2-3,9,6);X.fillRect(-bw/2+3,bh/2-3,9,6);
  // Rim highlights
  X.fillStyle='#444';
  X.fillRect(bw/2-10,-bh/2-2,5,4);X.fillRect(bw/2-10,bh/2-2,5,4);
  X.fillRect(-bw/2+5,-bh/2-2,5,4);X.fillRect(-bw/2+5,bh/2-2,5,4);
  // Headlights
  X.fillStyle='rgba(255,245,160,0.95)';
  X.fillRect(bw/2-3,-bh/2+3,3,5);X.fillRect(bw/2-3,bh/2-8,3,5);
  // Tail lights
  X.fillStyle='rgba(220,40,40,0.9)';
  X.fillRect(-bw/2,-bh/2+3,3,5);X.fillRect(-bw/2,bh/2-8,3,5);
  // Hood panel line
  X.strokeStyle=darkenHex(body,30);X.lineWidth=1;
  X.beginPath();X.moveTo(bw/2-18,-bh/2);X.lineTo(bw/2-18,bh/2);X.stroke();
  X.restore();
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  GRACZ
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// F4.6: 6 odcieni skĂłry (z 3)
const SKIN_COLS={verylight:'#f5d8b8',light:'#e0a870',medium:'#c07840',olive:'#a0703a',dark:'#704020',verydark:'#4a2818'};

function drawPlayer(){
  // #17: Ukryj gracza gdy wsiadĹ‚ do auta (postaÄ‡ "siedzi w Ĺ›rodku" â€” auto siÄ™ rysuje)
  if(G._inCar&&G.car&&currentRoom==='ulica')return;
  const sx=wx2sx(P.wx);
  // Idle: delikatne oddychanie. Walking: subtle vertical bobbing (head bouncing)
  const idleBob = !P.moving ? Math.sin(anim*0.04)*0.7 : 0;
  const walkBob = P.moving ? Math.abs(Math.sin(anim*0.22))*1.2 : 0;
  const sy=wy2sy(P.wy)+idleBob-walkBob*0.5;
  const cx=sx+P.w/2,step=P.moving?Math.sin(anim*.22)*5:0;
  if(!P.moving) anim++; // animuj idle nawet gdy stoi
  const sc=SKIN_COLS[P.skin]||SKIN_COLS.light;
  const cc=P.cloth||'#2a5080';
  const pc=P.pants||G.pants||'#1a2a3a';
  const shc=P.shoes||G.shoes||'#0a0a0a';
  // Shadow
  X.fillStyle='rgba(0,0,0,.28)';X.beginPath();X.ellipse(cx,sy+P.h-2,13,5,0,0,Math.PI*2);X.fill();
  /* v2.1.216 [Amper]: Tier 4 GOAT visual effects — złota aureola, particles, korona jeśli Crown of Hip-Hop */
  if(typeof getFameTier==='function' && getFameTier()===4){
    const _t=Date.now()/200;
    /* Złota aureola (subtle glow nad głową) */
    const _glowR=14+Math.sin(_t)*1.5;
    X.fillStyle=`rgba(200,165,32,${0.18+Math.sin(_t)*0.06})`;
    X.beginPath();X.arc(cx,sy+10,_glowR,0,Math.PI*2);X.fill();
    X.fillStyle=`rgba(255,220,100,${0.30+Math.sin(_t*1.3)*0.10})`;
    X.beginPath();X.arc(cx,sy+10,_glowR*0.6,0,Math.PI*2);X.fill();
    /* Particles wokół gracza (4 sparkle) */
    X.fillStyle=`rgba(255,220,100,${0.6+Math.sin(_t*2)*0.3})`;
    X.font='10px Arial';X.textAlign='center';
    const _r1=20,_r2=24;
    X.fillText('✨',cx+_r1*Math.cos(_t),sy+P.h/2+_r2*Math.sin(_t));
    X.fillText('✨',cx+_r1*Math.cos(_t+Math.PI),sy+P.h/2+_r2*Math.sin(_t+Math.PI));
    X.fillText('✨',cx+_r1*Math.cos(_t+Math.PI/2),sy+P.h/2+_r2*Math.sin(_t+Math.PI/2));
    X.fillText('✨',cx+_r1*Math.cos(_t-Math.PI/2),sy+P.h/2+_r2*Math.sin(_t-Math.PI/2));
    X.textAlign='left';
  }
  /* Crown of Hip-Hop outfit — visual korona nad głową */
  if(G._hasCrownOfHipHop && G.outfit?.top==='crown_of_hh'){
    X.font='16px Arial';X.textAlign='center';
    X.fillStyle='#c8a520';
    X.fillText('👑',cx,sy+2);
    X.textAlign='left';
  }
  // Legs (pants) â€” start niĹĽej zostawiajÄ…c miejsce na wyraĹşnÄ… gĹ‚owÄ™ i tuĹ‚Ăłw
  X.fillStyle=pc;
  X.fillRect(cx-10,sy+P.h*.64,10,P.h*.30-step);
  X.fillRect(cx,sy+P.h*.64+step,10,P.h*.30-step);
  // Shoes â€” proper sneaker silhouette
  function drawShoe(bx,by,facing){
    const sole=darkenHex(shc,35)||'#111';
    if(facing===0){
      X.fillStyle=shc;X.beginPath();X.ellipse(bx,by+3,8,5,0,0,Math.PI*2);X.fill();
      X.fillStyle=sole;X.fillRect(bx-7,by+7,14,2);
    } else {
      const d=facing;
      X.fillStyle=shc;X.beginPath();
      X.moveTo(bx,by+9);X.lineTo(bx,by+2);
      X.quadraticCurveTo(bx+d*4,by-1,bx+d*10,by+1);
      X.quadraticCurveTo(bx+d*14,by+1,bx+d*15,by+5);
      X.quadraticCurveTo(bx+d*15,by+10,bx+d*12,by+10);
      X.closePath();X.fill();
      X.fillStyle=sole;X.beginPath();
      X.moveTo(bx-d,by+8);X.lineTo(bx+d*13,by+8);
      X.lineTo(bx+d*16,by+11);X.lineTo(bx-d*2,by+11);
      X.closePath();X.fill();
      X.fillStyle='rgba(255,255,255,0.55)';
      X.fillRect(d>0?bx+2:bx+d*11,by,6,3);
    }
  }
  if(P.dir===1){drawShoe(cx,sy+P.h-9+step,1);drawShoe(cx-10,sy+P.h-9-step,1);}
  else if(P.dir===3){drawShoe(cx+10,sy+P.h-9+step,-1);drawShoe(cx,sy+P.h-9-step,-1);}
  else{drawShoe(cx-5,sy+P.h-9-step,0);drawShoe(cx+5,sy+P.h-9+step,0);}
  // Torso â€” zaczyna siÄ™ wyraĹşnie poniĹĽej twarzy (P.h*.47 = sy+20.7)
  X.fillStyle=cc;X.fillRect(cx-13,sy+P.h*.47,26,P.h*.20);
  // v2.1.175: outline torso ĹĽeby ciemne kolory (czarny #0a0a0a) byĹ‚y widoczne na ciemnym tle ulicy
  X.strokeStyle=lightenHex(cc,40);X.lineWidth=1;X.strokeRect(cx-13+.5,sy+P.h*.47+.5,25,P.h*.20-1);
  // Collar area
  X.fillStyle=lightenHex(cc,30);X.fillRect(cx-13,sy+P.h*.47,26,4);
  // Arms
  X.fillStyle=sc;
  const as=P.moving?step*.35:0;
  X.fillRect(cx-19,sy+P.h*.48+as,7,P.h*.20);
  X.fillRect(cx+12,sy+P.h*.48-as,7,P.h*.20);
  // Neck
  X.fillStyle=sc;X.fillRect(cx-5,sy+P.h*.40,10,P.h*.08);
  // Head
  X.fillStyle=sc;
  X.fillRect(cx-12,sy+P.h*.10,24,22);
  X.beginPath();X.arc(cx,sy+P.h*.10+4,12,Math.PI,0);X.fill();
  // Hair
  drawHairStyle(cx,sy,sc);
  // v1.8.29: Twarz â€” oczy okrÄ…gĹ‚e (nie kwadratowe = mniej creepy) + delikatny uĹ›miech
  if(P.dir===2){
    // BiaĹ‚ka oczu (subtelne)
    X.fillStyle='rgba(255,255,255,.85)';
    X.beginPath();X.arc(cx-4,sy+P.h*.26,2.4,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(cx+4,sy+P.h*.26,2.4,0,Math.PI*2);X.fill();
    // Ĺąrenice
    X.fillStyle='rgba(20,20,40,.95)';
    X.beginPath();X.arc(cx-4,sy+P.h*.26,1.4,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(cx+4,sy+P.h*.26,1.4,0,Math.PI*2);X.fill();
    // Highlight w oku â€” bardziej ĹĽywy wyraz
    X.fillStyle='rgba(255,255,255,.9)';
    X.beginPath();X.arc(cx-4.4,sy+P.h*.255,0.5,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(cx+3.6,sy+P.h*.255,0.5,0,Math.PI*2);X.fill();
    // UĹ›miech â€” szerszy, Ĺ‚agodniejszy Ĺ‚uk
    X.strokeStyle='rgba(40,15,15,.7)';X.lineWidth=1.3;X.lineCap='round';
    X.beginPath();X.arc(cx,sy+P.h*.33,3.5,0.15*Math.PI,0.85*Math.PI);X.stroke();
    X.lineCap='butt';
  } else if(P.dir===1){
    X.fillStyle='rgba(255,255,255,.85)';
    X.beginPath();X.arc(cx+5,sy+P.h*.26,2,0,Math.PI*2);X.fill();
    X.fillStyle='rgba(20,20,40,.95)';
    X.beginPath();X.arc(cx+5,sy+P.h*.26,1.1,0,Math.PI*2);X.fill();
  } else if(P.dir===3){
    X.fillStyle='rgba(255,255,255,.85)';
    X.beginPath();X.arc(cx-5,sy+P.h*.26,2,0,Math.PI*2);X.fill();
    X.fillStyle='rgba(20,20,40,.95)';
    X.beginPath();X.arc(cx-5,sy+P.h*.26,1.1,0,Math.PI*2);X.fill();
  }
  // â”€â”€ Snow accumulation na glowie/ramionach gdy pada snieg (G.weather===3) â”€â”€
  if(currentRoom==='ulica'&&(G.weather===3||G.weather===4)){
    X.save();
    X.fillStyle='rgba(255,255,255,.85)';
    // Czapka sniegu na wlosach
    X.beginPath();
    X.ellipse(cx,sy+P.h*.08,11,3.5,0,Math.PI,0);X.fill();
    // Plamki na ramionach
    X.fillRect(cx-19,sy+P.h*.48,7,2);
    X.fillRect(cx+12,sy+P.h*.48,7,2);
    X.restore();
  }
  // â”€â”€ Breath cloud (para z ust) gdy zimno: snieg/burza/mgla â”€â”€
  if(currentRoom==='ulica'&&(G.weather===3||G.weather===4||G.weather===5)){
    const breathCycle=(Date.now()%2400)/2400; // 2.4s cycle
    if(breathCycle<0.45){
      const ba=Math.sin(breathCycle/0.45*Math.PI)*0.55;
      const bs=2+breathCycle*3.5;
      const bo=2+breathCycle*8;
      const dxOff={0:0,1:bo,2:0,3:-bo}[P.dir]||0;
      const dyOff=P.dir===2?2+breathCycle*4:0;
      X.fillStyle=`rgba(220,235,250,${ba})`;
      X.beginPath();X.arc(cx+dxOff,sy+P.h*.34+dyOff,bs,0,Math.PI*2);X.fill();
      X.fillStyle=`rgba(255,255,255,${ba*0.6})`;
      X.beginPath();X.arc(cx+dxOff*0.7,sy+P.h*.34+dyOff,bs*0.6,0,Math.PI*2);X.fill();
    }
  }
  // F5.4 E1: Outfit overlay â€” krawat/kaptur/Ĺ‚aĹ„cuch/opaska
  const _outId = (G.outfit && G.outfit.top) || 'default';
  if(_outId !== 'default') drawOutfitOverlay(cx, sy, _outId, P.dir, sc);
  // Name label removed
}

// F5.4 E1: Renderowanie outfitĂłw (overlay caĹ‚ego torso + akcesoria)
// KaĹĽdy outfit ma WIDOCZNÄ„ kolorystykÄ™ (overlay torso) + unikalne akcesoria.
function drawOutfitOverlay(cx, sy, outfitId, dir, skinColor){
  const torsoX = cx - 13;
  const torsoY = sy + P.h*.47;
  const torsoW = 26;
  const torsoH = P.h*.20;        // ~9 px
  const armLeftX = cx - 19;
  const armRightX = cx + 12;
  const armY = sy + P.h*.48;
  const armH = P.h*.20;          // ~9 px
  const headY = sy + P.h*.10;
  const oc = (G.outfitColors && G.outfitColors[outfitId]) || null;

  if(outfitId === 'street'){
    // BLUZA Z KAPTUREM â€” luĹşna bluza + wyraĹşny kaptur + sznurĂłwki + LOGO box na piersi
    const hoodieCol = (oc && oc.body) || darkenHex(P.cloth, 20) || '#2a2a3a';
    const hoodCol = darkenHex(hoodieCol, 25);
    // Overlay torso
    X.fillStyle = hoodieCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // KAPTUR za karkiem
    X.fillStyle = hoodCol;
    X.beginPath();
    X.moveTo(cx-15, sy+P.h*.40);
    X.quadraticCurveTo(cx, sy+P.h*.50, cx+15, sy+P.h*.40);
    X.lineTo(cx+13, sy+P.h*.32);
    X.quadraticCurveTo(cx, sy+P.h*.36, cx-13, sy+P.h*.32);
    X.closePath();
    X.fill();
    // SznurĂłwki kaptura (biaĹ‚e paski + kuleczki na koĹ„cach)
    X.fillStyle = '#f5f5f5';
    X.fillRect(cx-3.5, torsoY+1, 1.2, 6);
    X.fillRect(cx+2.3, torsoY+1, 1.2, 6);
    X.beginPath();
    X.arc(cx-2.9, torsoY+7, 1.4, 0, Math.PI*2);
    X.arc(cx+2.9, torsoY+7, 1.4, 0, Math.PI*2);
    X.fill();
    // MaĹ‚y logo box na piersi (akcent â€” np. maĹ‚a kropka biaĹ‚a)
    X.fillStyle = lightenHex(hoodieCol, 30);
    X.fillRect(cx+5, torsoY+2, 4, 2);
    // Mankiety rÄ™kawĂłw (jaĹ›niejsza koĹ„cĂłwka)
    X.fillStyle = lightenHex(hoodieCol, 15);
    X.fillRect(armLeftX, armY+armH-2, 7, 2);
    X.fillRect(armRightX, armY+armH-2, 7, 2);
    return;
  }

  if(outfitId === 'suit'){
    // GARNITUR â€” czarna marynarka (overlay caĹ‚ego torso) + biaĹ‚a koszula + krawat
    const suitCol = (oc && oc.body) || '#0a0a1a';
    const tieCol = (oc && oc.tie) || '#8b1a2a';
    // Marynarka â€” overlay torso
    X.fillStyle = suitCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // BiaĹ‚a koszula widoczna w Ĺ›rodku (V-pas pionowy)
    X.fillStyle = '#f8f8f8';
    X.fillRect(cx-4, torsoY, 8, torsoH);
    // Klapy marynarki (V-shape) â€” czarne nakĹ‚adki na biaĹ‚ej koszuli
    X.fillStyle = suitCol;
    X.beginPath();
    X.moveTo(cx-13, torsoY);
    X.lineTo(cx-4, torsoY);
    X.lineTo(cx-1, torsoY+5);
    X.lineTo(cx-4, torsoY+torsoH);
    X.lineTo(cx-13, torsoY+torsoH);
    X.closePath();
    X.fill();
    X.beginPath();
    X.moveTo(cx+13, torsoY);
    X.lineTo(cx+4, torsoY);
    X.lineTo(cx+1, torsoY+5);
    X.lineTo(cx+4, torsoY+torsoH);
    X.lineTo(cx+13, torsoY+torsoH);
    X.closePath();
    X.fill();
    // KRAWAT (gruby, kolorowy)
    X.fillStyle = tieCol;
    X.beginPath();
    X.moveTo(cx-2, torsoY+1);
    X.lineTo(cx+2, torsoY+1);
    X.lineTo(cx+1.5, torsoY+4);
    X.lineTo(cx+3, torsoY+torsoH);
    X.lineTo(cx-3, torsoY+torsoH);
    X.lineTo(cx-1.5, torsoY+4);
    X.closePath();
    X.fill();
    // WÄ™zeĹ‚ krawatu (ciemniejszy)
    X.fillStyle = darkenHex(tieCol, 30);
    X.fillRect(cx-2, torsoY+1, 4, 2);
    // Guzik na klapach (biaĹ‚e kropki)
    X.fillStyle = '#f8f8f8';
    X.beginPath();
    X.arc(cx-6, torsoY+5, 0.8, 0, Math.PI*2);
    X.arc(cx+6, torsoY+5, 0.8, 0, Math.PI*2);
    X.fill();
    // Cienkie szwy na klapach (lighter)
    X.strokeStyle = lightenHex(suitCol, 30);
    X.lineWidth = 0.5;
    X.beginPath();
    X.moveTo(cx-13, torsoY);
    X.lineTo(cx-4, torsoY);
    X.lineTo(cx-1, torsoY+5);
    X.moveTo(cx+13, torsoY);
    X.lineTo(cx+4, torsoY);
    X.lineTo(cx+1, torsoY+5);
    X.stroke();
    return;
  }

  if(outfitId === 'sport' || outfitId === 'sport_pro'){
    // STRĂ“J SPORTOWY â€” tank top + opaska + ramiÄ…czka + akcent
    const bandCol = (oc && oc.accent) || (outfitId==='sport_pro' ? '#e74c3c' : '#3498db');
    const shirtCol = (oc && oc.body) || (outfitId==='sport_pro' ? '#1a1a1a' : '#f5f5f5');
    // Tank top overlay
    X.fillStyle = shirtCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    // RÄKAWY ODKRYTE (skin pokazuje ĹĽe tank top) â€” narysuj skin na rÄ™kawach
    X.fillStyle = skinColor;
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // RamiÄ…czka tank top (cienkie kolorowe paski na ramionach)
    X.fillStyle = bandCol;
    X.fillRect(cx-11, torsoY, 3, torsoH);
    X.fillRect(cx+8, torsoY, 3, torsoH);
    // Opaska na czole
    X.fillRect(cx-12, sy+P.h*.18, 24, 3);
    // Pas w dolnej czÄ™Ĺ›ci koszulki (akcent)
    X.fillRect(torsoX, torsoY+torsoH-2, torsoW, 2);
    if(outfitId === 'sport_pro'){
      // PRO: SWOOSH â€” krzywa z lewa do prawej (Nike style)
      X.strokeStyle = bandCol;
      X.lineWidth = 1.8;
      X.beginPath();
      X.moveTo(cx-7, torsoY+5);
      X.quadraticCurveTo(cx-2, torsoY+8, cx+8, torsoY+3);
      X.stroke();
      // MaĹ‚y kolec swoosha na koĹ„cu
      X.fillStyle = bandCol;
      X.beginPath();
      X.moveTo(cx+8, torsoY+3);
      X.lineTo(cx+5, torsoY+4);
      X.lineTo(cx+8, torsoY+5);
      X.closePath();
      X.fill();
      // Pas na opasce â€” tonalna linia
      X.fillStyle = darkenHex(bandCol, 25);
      X.fillRect(cx-12, sy+P.h*.18+1, 24, 1);
    } else {
      // Sport: 2 cienkie poziome linie na piersi (klasyczny tank top look)
      X.fillStyle = bandCol;
      X.fillRect(cx-5, torsoY+3, 10, 1);
      X.fillRect(cx-5, torsoY+5, 10, 1);
    }
    return;
  }

  if(outfitId === 'music'){
    // SCENICZNY â€” czarna skĂłrzana kurtka (overlay caĹ‚ego torso) + duĹĽy zĹ‚oty Ĺ‚aĹ„cuch + okulary
    const jacketCol = '#0a0a0a';
    const accent = (oc && oc.accent) || '#f1c40f';
    // Kurtka â€” overlay torso caĹ‚e
    X.fillStyle = jacketCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // Otwarcie kurtki (klapy V) â€” pokazuje czarne wnÄ™trze
    X.fillStyle = '#1a1a1a';
    X.beginPath();
    X.moveTo(cx-5, torsoY);
    X.lineTo(cx-1, torsoY+5);
    X.lineTo(cx-1, torsoY+torsoH);
    X.lineTo(cx-5, torsoY+torsoH);
    X.closePath();
    X.fill();
    X.beginPath();
    X.moveTo(cx+5, torsoY);
    X.lineTo(cx+1, torsoY+5);
    X.lineTo(cx+1, torsoY+torsoH);
    X.lineTo(cx+5, torsoY+torsoH);
    X.closePath();
    X.fill();
    // SkĂłrzane szwy / akcent (jaĹ›niejsze pasy)
    X.fillStyle = '#2a2a2a';
    X.fillRect(armLeftX+3, armY, 1, armH);
    X.fillRect(armRightX+3, armY, 1, armH);
    // DUĹ»Y ZĹOTY ĹAĹCUCH (gruby, na szyi, opadajÄ…cy)
    X.fillStyle = accent;
    X.beginPath();
    X.ellipse(cx, torsoY+1, 7, 1.5, 0, 0, Math.PI);
    X.fill();
    // Ogniwa Ĺ‚aĹ„cucha
    for(let i=-2; i<=2; i++){
      X.beginPath();
      X.arc(cx+i*2.8, torsoY+1, 0.9, 0, Math.PI*2);
      X.fill();
    }
    // Wisiorek (gruby krzyĹĽ lub diamond)
    X.beginPath();
    X.moveTo(cx, torsoY+4);
    X.lineTo(cx-3, torsoY+7);
    X.lineTo(cx, torsoY+10);
    X.lineTo(cx+3, torsoY+7);
    X.closePath();
    X.fill();
    // Mniejsze okulary (jeĹ›li dir=2 â€” przĂłd) â€” zakrywajÄ… oczy precyzyjnie
    if(dir === 2){
      X.fillStyle = '#000';
      // Lewe szkĹ‚o (na lewym oku)
      X.fillRect(cx-7, sy+P.h*.245, 5, 2.5);
      // Prawe szkĹ‚o
      X.fillRect(cx+2, sy+P.h*.245, 5, 2.5);
      // Mostek
      X.fillRect(cx-2, sy+P.h*.255, 4, 1);
      // MaĹ‚y refleks (bardziej subtelny)
      X.fillStyle = 'rgba(255,255,255,0.5)';
      X.fillRect(cx-6, sy+P.h*.25, 1.5, 0.8);
      X.fillRect(cx+3, sy+P.h*.25, 1.5, 0.8);
    }
    return;
  }

  if(outfitId === 'polo'){
    // KOSZULKA POLO â€” koĹ‚nierzyk + 2 guziki + paski na rÄ™kawach
    const poloCol = (oc && oc.body) || '#3a8a5a';
    const collarCol = lightenHex(poloCol, 25);
    // Overlay torso
    X.fillStyle = poloCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // KoĹ‚nierzyk (V-shape jaĹ›niejszy)
    X.fillStyle = collarCol;
    X.beginPath();
    X.moveTo(cx-7, torsoY);
    X.lineTo(cx-2, torsoY+4);
    X.lineTo(cx-2, torsoY);
    X.closePath();
    X.fill();
    X.beginPath();
    X.moveTo(cx+7, torsoY);
    X.lineTo(cx+2, torsoY+4);
    X.lineTo(cx+2, torsoY);
    X.closePath();
    X.fill();
    // Pasek z guzikami (placket)
    X.fillStyle = darkenHex(poloCol, 20);
    X.fillRect(cx-1, torsoY+1, 2, 4);
    // 2 guziki (biaĹ‚e)
    X.fillStyle = '#f5f5f5';
    X.beginPath();
    X.arc(cx, torsoY+2, 0.7, 0, Math.PI*2);
    X.arc(cx, torsoY+4, 0.7, 0, Math.PI*2);
    X.fill();
    // Mankiety rÄ™kawĂłw (ciemniejszy pasek)
    X.fillStyle = darkenHex(poloCol, 20);
    X.fillRect(armLeftX, armY+armH-1.5, 7, 1.5);
    X.fillRect(armRightX, armY+armH-1.5, 7, 1.5);
    return;
  }

  if(outfitId === 'jeansowa'){
    // KURTKA JEANSOWA â€” niebieski denim + przednie kieszenie + guziki
    const denimCol = (oc && oc.body) || '#2a4a7a';
    // Overlay torso
    X.fillStyle = denimCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // Faktura jeansu (cienkie pionowe paski jaĹ›niejsze)
    X.fillStyle = lightenHex(denimCol, 15);
    for(let i=0; i<5; i++){
      X.fillRect(torsoX+2+i*5, torsoY+1, 0.8, torsoH-2);
    }
    // 2 przednie kieszenie (klapki)
    X.fillStyle = darkenHex(denimCol, 25);
    X.fillRect(cx-9, torsoY+5, 5, 3);
    X.fillRect(cx+4, torsoY+5, 5, 3);
    // Guziki kieszeni (mosiÄ™ĹĽne)
    X.fillStyle = '#c89020';
    X.beginPath();
    X.arc(cx-6.5, torsoY+6.5, 0.6, 0, Math.PI*2);
    X.arc(cx+6.5, torsoY+6.5, 0.6, 0, Math.PI*2);
    X.fill();
    // Ĺšrodkowy zamek/guziki (3 mosiÄ™ĹĽne kropki)
    for(let i=0; i<3; i++){
      X.beginPath();
      X.arc(cx, torsoY+1.5+i*2.5, 0.7, 0, Math.PI*2);
      X.fill();
    }
    return;
  }

  if(outfitId === 'zimowa'){
    // KURTKA ZIMOWA â€” gruba puchĂłwka + kaptur z futrem + suwak
    const winterCol = (oc && oc.body) || '#3a3a4a';
    const furCol = '#d4c4a8';
    // Overlay torso (grubszy â€” wiÄ™ksza szerokoĹ›Ä‡ overlay)
    X.fillStyle = winterCol;
    X.fillRect(torsoX-2, torsoY-1, torsoW+4, torsoH+2);
    X.fillRect(armLeftX-1, armY-1, 9, armH+1);
    X.fillRect(armRightX, armY-1, 9, armH+1);
    // Poziome szwy puchĂłwki (3 segmenty)
    X.fillStyle = darkenHex(winterCol, 25);
    X.fillRect(torsoX-2, torsoY+2, torsoW+4, 0.8);
    X.fillRect(torsoX-2, torsoY+5, torsoW+4, 0.8);
    // Kaptur z futrem (na plecach)
    X.fillStyle = winterCol;
    X.beginPath();
    X.ellipse(cx, sy+P.h*.40, 16, 7, 0, 0, Math.PI);
    X.fill();
    // Futro na kapturze (jasna obwĂłdka)
    X.fillStyle = furCol;
    for(let i=-7; i<=7; i++){
      X.fillRect(cx+i*2, sy+P.h*.40-1, 1.5, 1);
    }
    // Suwak (cienka pionowa linia)
    X.fillStyle = '#888';
    X.fillRect(cx, torsoY, 1, torsoH);
    // Pull suwaka (maĹ‚a kropka)
    X.fillStyle = '#ddd';
    X.fillRect(cx-0.5, torsoY+1, 2, 1);
    return;
  }

  if(outfitId === 'smoking'){
    // SMOKING â€” czarny smoking + biaĹ‚a koszula + czarna mucha + jedwabne klapy
    const smokingCol = '#000000';
    const silkCol = '#1a1a1a';
    // Overlay torso (smoking)
    X.fillStyle = smokingCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // BiaĹ‚a koszula w Ĺ›rodku V
    X.fillStyle = '#ffffff';
    X.fillRect(cx-3, torsoY, 6, torsoH);
    // Jedwabne klapy (poĹ‚ysk â€” gradient ciemny)
    X.fillStyle = silkCol;
    X.beginPath();
    X.moveTo(cx-13, torsoY);
    X.lineTo(cx-3, torsoY);
    X.lineTo(cx-1, torsoY+5);
    X.lineTo(cx-3, torsoY+torsoH);
    X.lineTo(cx-13, torsoY+torsoH);
    X.closePath();
    X.fill();
    X.beginPath();
    X.moveTo(cx+13, torsoY);
    X.lineTo(cx+3, torsoY);
    X.lineTo(cx+1, torsoY+5);
    X.lineTo(cx+3, torsoY+torsoH);
    X.lineTo(cx+13, torsoY+torsoH);
    X.closePath();
    X.fill();
    // Refleks na jedwabiu (jaĹ›niejsza linia)
    X.fillStyle = '#3a3a3a';
    X.fillRect(cx-9, torsoY+1, 1, torsoH-2);
    X.fillRect(cx+8, torsoY+1, 1, torsoH-2);
    // CZARNA MUCHA (zamiast krawatu)
    X.fillStyle = '#000';
    X.beginPath();
    X.moveTo(cx-3, torsoY);
    X.lineTo(cx-3, torsoY+2);
    X.lineTo(cx, torsoY+1);
    X.lineTo(cx+3, torsoY+2);
    X.lineTo(cx+3, torsoY);
    X.lineTo(cx, torsoY+1);
    X.closePath();
    X.fill();
    // PomaraĹ„czowy poszetka w kieszeni piersiowej (akcent)
    X.fillStyle = (oc && oc.accent) || '#e74c3c';
    X.fillRect(cx-10, torsoY+5, 2, 2);
    return;
  }

  if(outfitId === 'designer_concert'){
    // DESIGNERSKI KONCERTOWY â€” bĹ‚yszczÄ…cy strĂłj sceniczny z wzorem geometrycznym
    const baseCol = (oc && oc.body) || '#1a0a3a';
    const accentCol = (oc && oc.accent) || '#e91e8c';
    // Overlay torso
    X.fillStyle = baseCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // Geometryczny wzĂłr (zigzag na piersi)
    X.strokeStyle = accentCol;
    X.lineWidth = 1.2;
    X.beginPath();
    X.moveTo(torsoX+2, torsoY+3);
    X.lineTo(torsoX+5, torsoY+5);
    X.lineTo(torsoX+8, torsoY+3);
    X.lineTo(torsoX+11, torsoY+5);
    X.lineTo(torsoX+14, torsoY+3);
    X.lineTo(torsoX+17, torsoY+5);
    X.lineTo(torsoX+20, torsoY+3);
    X.lineTo(torsoX+23, torsoY+5);
    X.stroke();
    // Drugi pas zigzag (niĹĽej)
    X.beginPath();
    X.moveTo(torsoX+2, torsoY+7);
    X.lineTo(torsoX+5, torsoY+8.5);
    X.lineTo(torsoX+8, torsoY+7);
    X.lineTo(torsoX+11, torsoY+8.5);
    X.lineTo(torsoX+14, torsoY+7);
    X.lineTo(torsoX+17, torsoY+8.5);
    X.lineTo(torsoX+20, torsoY+7);
    X.stroke();
    // Akcent na ramionach (poĹ‚yskujÄ…ce paski)
    X.fillStyle = accentCol;
    X.fillRect(armLeftX, armY+2, 7, 1.5);
    X.fillRect(armRightX, armY+2, 7, 1.5);
    X.fillRect(armLeftX, armY+5, 7, 1.5);
    X.fillRect(armRightX, armY+5, 7, 1.5);
    // MaĹ‚y refleks (biaĹ‚e punkty â€” efekt blasku scenicznego)
    X.fillStyle = '#ffffff';
    X.beginPath();
    X.arc(cx-7, torsoY+1, 0.7, 0, Math.PI*2);
    X.arc(cx+7, torsoY+8, 0.7, 0, Math.PI*2);
    X.arc(cx, torsoY+5, 0.7, 0, Math.PI*2);
    X.fill();
    return;
  }

  if(outfitId === 'luxury'){
    // LUKSUSOWY DRIP â€” designerska koszulka + Ĺ‚aĹ„cuch + zegarek + wzĂłr + bling
    const accent = (oc && oc.accent) || '#f1c40f';
    const shirtCol = (oc && oc.body) || P.cloth || '#2a5080';
    // Koszulka z wzorem (overlay torso z bazowym kolorem + wzĂłr)
    X.fillStyle = shirtCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // WzĂłr designerski (subtelny â€” 2 poziome zĹ‚ote linie + monogram)
    X.fillStyle = darkenHex(shirtCol, 25);
    X.fillRect(torsoX+2, torsoY+5, torsoW-4, 0.8);
    X.fillRect(torsoX+2, torsoY+7, torsoW-4, 0.8);
    // ZĹ‚oty monogram na piersi (maĹ‚a kropka)
    X.fillStyle = (oc && oc.accent) || '#f1c40f';
    X.beginPath();
    X.arc(cx-7, torsoY+3, 1, 0, Math.PI*2);
    X.fill();
    // Akcenty zĹ‚ote na ramionach (epolet)
    X.fillStyle = accent;
    X.fillRect(armLeftX, armY, 7, 2);
    X.fillRect(armRightX, armY, 7, 2);
    // GRUBY ZĹOTY ĹAĹCUCH (wiÄ™kszy niĹĽ music, podwĂłjny)
    X.beginPath();
    X.ellipse(cx, torsoY+1.5, 8, 2, 0, 0, Math.PI);
    X.fill();
    X.beginPath();
    X.ellipse(cx, torsoY+3, 6, 1.5, 0, 0, Math.PI);
    X.fill();
    // Wisiorek diament (wiÄ™kszy)
    X.beginPath();
    X.moveTo(cx, torsoY+4);
    X.lineTo(cx-3.5, torsoY+8);
    X.lineTo(cx, torsoY+12);
    X.lineTo(cx+3.5, torsoY+8);
    X.closePath();
    X.fill();
    // Refleks na diamencie (biaĹ‚e trĂłjkÄ…ty)
    X.fillStyle = '#fff';
    X.beginPath();
    X.moveTo(cx-1, torsoY+5);
    X.lineTo(cx, torsoY+8);
    X.lineTo(cx+1, torsoY+5);
    X.closePath();
    X.fill();
    // ZĹ‚oty zegarek (na lewym nadgarstku â€” wiÄ™kszy)
    X.fillStyle = accent;
    X.fillRect(armLeftX, armY+armH-3, 7, 3);
    X.fillStyle = '#fff';
    X.fillRect(armLeftX+2, armY+armH-2, 3, 1);
    // Pasek zegarka (ciemniejszy)
    X.fillStyle = darkenHex(accent, 30);
    X.fillRect(armLeftX, armY+armH-3.5, 7, 0.5);
    // PierĹ›cieĹ„ (na dĹ‚oni â€” kropka zĹ‚ota)
    X.fillStyle = accent;
    X.beginPath();
    X.arc(armLeftX+3, armY+armH+1, 1.2, 0, Math.PI*2);
    X.arc(armRightX+3, armY+armH+1, 1.2, 0, Math.PI*2);
    X.fill();
    return;
  }

  /* v2.1.148 hotfix: drawing dla 3 nowych outfitĂłw (tracksuit/leather_jacket/designer_hoodie) */
  if(outfitId === 'tracksuit'){
    // DRESIK â€” kolorowa koszulka + lampasy na rÄ™kawach
    const trackCol = (oc && oc.body) || '#1a3a4a';
    X.fillStyle = trackCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // BiaĹ‚e lampasy na rÄ™kawach (sportowy detal)
    X.fillStyle = '#f0f0f0';
    X.fillRect(armLeftX+2, armY, 1, armH);
    X.fillRect(armRightX+4, armY, 1, armH);
    // MaĹ‚y logo na piersi (kĂłĹ‚ko biaĹ‚e)
    X.fillStyle = '#f0f0f0';
    X.beginPath(); X.arc(cx-6, torsoY+4, 1.2, 0, Math.PI*2); X.fill();
    return;
  }
  if(outfitId === 'leather_jacket'){
    // KURTKA SKĂ“RZANA â€” czarna z metalicznym zamkiem
    const leatherCol = (oc && oc.body) || '#1a0a0a';
    X.fillStyle = leatherCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // Metalowy zamek (srebrne pionowe pasmo)
    X.fillStyle = '#c0c0c0';
    X.fillRect(cx-0.5, torsoY+2, 1, torsoH-3);
    // Dwa metalowe Ä‡wieki na ramionach
    X.fillStyle = '#a0a0a0';
    X.beginPath();
    X.arc(armLeftX+3, armY+1, 0.8, 0, Math.PI*2);
    X.arc(armRightX+3, armY+1, 0.8, 0, Math.PI*2);
    X.fill();
    // KoĹ‚nierz odstajÄ…cy (ciemniejszy)
    X.fillStyle = darkenHex(leatherCol, 30);
    X.fillRect(torsoX+1, torsoY, 4, 2);
    X.fillRect(torsoX+torsoW-5, torsoY, 4, 2);
    return;
  }
  if(outfitId === 'designer_hoodie'){
    // DESIGNER HOODIE â€” bluza z kapturem + logo + akcenty
    const hoodieCol = (oc && oc.body) || '#2a1a3a';
    const hoodCol = darkenHex(hoodieCol, 20);
    X.fillStyle = hoodieCol;
    X.fillRect(torsoX, torsoY, torsoW, torsoH);
    X.fillRect(armLeftX, armY, 7, armH);
    X.fillRect(armRightX, armY, 7, armH);
    // Kaptur ciemniejszy (overlay gĂłra)
    X.fillStyle = hoodCol;
    X.fillRect(torsoX+1, torsoY, torsoW-2, 3);
    // Sznurki kaptura (2 biaĹ‚e linie pionowe)
    X.fillStyle = '#f0f0f0';
    X.fillRect(cx-3, torsoY+2, 0.7, 4);
    X.fillRect(cx+2, torsoY+2, 0.7, 4);
    // BIG LOGO na piersi (designer brand) â€” prostokÄ…t z literÄ…
    X.fillStyle = '#f1c40f';
    X.fillRect(cx-4, torsoY+5, 8, 3);
    X.fillStyle = '#000';
    X.fillRect(cx-3, torsoY+6, 1, 1);
    X.fillRect(cx+2, torsoY+6, 1, 1);
    return;
  }
}

function drawHairStyle(cx,sy,sc){
  const hTop=sy+P.h*.07;
  // v1.9.5/v1.9.8: 10 fryzur
  const baseCol=['#2a1808','#1a0a05','#221206','transparent','#150a04','#2a1408','#3a2616','#3a1f10','#2a1208','#3a2818'][P.hair]||'#2a1808';
  const lightCol=['#5a3818','#3a2010','#4a2810','transparent','#2a1606','#5a3018','#6a4a30','#6a3a20','#5a2a18','#6a4838'][P.hair]||'#5a3818';
  const _hg=(y1,y2)=>{const g=X.createLinearGradient(0,y1,0,y2);g.addColorStop(0,lightCol);g.addColorStop(0.55,baseCol);g.addColorStop(1,baseCol);return g;};
  if(P.hair===0){
    // KRĂ“TKA â€” czysta kopuĹ‚a z grzywkÄ… (subtelny przedziaĹ‚)
    X.fillStyle=_hg(hTop-2,hTop+10);
    X.beginPath();
    X.moveTo(cx-11,hTop+8);
    X.bezierCurveTo(cx-13,hTop+1, cx-9,hTop-3, cx,hTop-3);
    X.bezierCurveTo(cx+9,hTop-3, cx+13,hTop+1, cx+11,hTop+8);
    X.quadraticCurveTo(cx+8,hTop+7, cx+5,hTop+8);
    X.quadraticCurveTo(cx-1,hTop+10, cx-5,hTop+8);
    X.quadraticCurveTo(cx-8,hTop+7, cx-11,hTop+8);
    X.closePath();X.fill();
    X.fillStyle='rgba(255,200,140,.18)';X.beginPath();X.ellipse(cx-1,hTop+1,6,1.5,-.1,0,Math.PI*2);X.fill();
  } else if(P.hair===1){
    // DĹUGA â€” sylwetka opadajÄ…ca do ramion z falÄ…
    X.fillStyle=_hg(hTop-2,hTop+24);
    X.beginPath();
    X.moveTo(cx-12,hTop+22);
    X.bezierCurveTo(cx-15,hTop+10, cx-14,hTop-1, cx-10,hTop-3);
    X.bezierCurveTo(cx-4,hTop-5, cx+4,hTop-5, cx+10,hTop-3);
    X.bezierCurveTo(cx+14,hTop-1, cx+15,hTop+10, cx+12,hTop+22);
    X.bezierCurveTo(cx+9,hTop+24, cx+8,hTop+18, cx+7,hTop+12);
    X.bezierCurveTo(cx+9,hTop+5, cx+9,hTop+2, cx,hTop+1);
    X.bezierCurveTo(cx-9,hTop+2, cx-9,hTop+5, cx-7,hTop+12);
    X.bezierCurveTo(cx-8,hTop+18, cx-9,hTop+24, cx-12,hTop+22);
    X.closePath();X.fill();
  } else if(P.hair===2){
    // v1.9.7: DREDY w grze â€” proste pionowe pasma z jasnymi koĹ„cĂłwkami (jak kreator)
    const capCol='#221206';
    const tipCol='#c8a060';
    X.fillStyle=capCol;
    X.fillRect(cx-11,hTop,22,5);
    X.beginPath();X.arc(cx,hTop,11,Math.PI,0);X.fill();
    // 7 pionowych pasm
    for(let i=0;i<7;i++){
      const dx=cx-11+i*3.3+0.5;
      const dl=14+(i%3)*2; // 14,16,18
      X.fillStyle=capCol;
      X.fillRect(dx,hTop+5,2.3,dl*0.72);
      X.fillStyle=tipCol;
      X.fillRect(dx,hTop+5+dl*0.72,2.3,dl*0.28);
    }
  } else if(P.hair===3){
    // Ĺysy â€” subtelny poĹ‚ysk
    X.fillStyle='rgba(255,255,255,.1)';X.beginPath();X.ellipse(cx-2,hTop-1,5,2,-.2,0,Math.PI*2);X.fill();
  } else if(P.hair===4){
    // v1.9.7: AFRO NA GĂ“RZE gĹ‚owy (nie zasĹ‚ania oczu w grze) â€” center hTop-5, ellipse szeroka
    const ag=X.createRadialGradient(cx-3,hTop-12,2,cx,hTop-6,15);
    ag.addColorStop(0,lightCol);ag.addColorStop(0.65,baseCol);ag.addColorStop(1,'#0a0402');
    X.fillStyle=ag;
    X.beginPath();X.ellipse(cx,hTop-5,15,11,0,0,Math.PI*2);X.fill();
    // Drobne fale
    X.fillStyle='rgba(0,0,0,.2)';
    X.beginPath();X.arc(cx-6,hTop-10,2,Math.PI,0);X.fill();
    X.beginPath();X.arc(cx,hTop-13,2.5,Math.PI,0);X.fill();
    X.beginPath();X.arc(cx+6,hTop-10,2,Math.PI,0);X.fill();
  } else if(P.hair===5){
    // IROKEZ â€” boki ogolone (cieĹ„), mohawk z gradientu
    X.fillStyle='rgba(0,0,0,.22)';X.beginPath();X.arc(cx,hTop+5,11,Math.PI,0);X.fill();
    const mg=X.createLinearGradient(0,hTop-15,0,hTop+5);
    mg.addColorStop(0,lightCol);mg.addColorStop(1,baseCol);
    X.fillStyle=mg;
    X.beginPath();
    X.moveTo(cx-3,hTop+4);
    X.bezierCurveTo(cx-4,hTop-8, cx-3,hTop-14, cx-1,hTop-15);
    X.lineTo(cx+1,hTop-15);
    X.bezierCurveTo(cx+3,hTop-14, cx+4,hTop-8, cx+3,hTop+4);
    X.closePath();X.fill();
    X.fillStyle='rgba(255,180,100,.22)';
    X.beginPath();X.moveTo(cx-2.5,hTop+2);X.bezierCurveTo(cx-3.5,hTop-8, cx-2.5,hTop-13, cx-1.5,hTop-14);X.lineTo(cx-0.5,hTop-13);X.bezierCurveTo(cx-2,hTop-8, cx-2,hTop+2, cx-2.5,hTop+2);X.closePath();X.fill();
  } else if(P.hair===6){
    // BOKSER â€” buzz cut, gradient czaszki bez kropek
    X.fillStyle=_hg(hTop-2,hTop+6);
    X.beginPath();
    X.moveTo(cx-10,hTop+5);
    X.bezierCurveTo(cx-12,hTop-1, cx-9,hTop-4, cx,hTop-4);
    X.bezierCurveTo(cx+9,hTop-4, cx+12,hTop-1, cx+10,hTop+5);
    X.closePath();X.fill();
    X.fillStyle='rgba(255,255,255,.08)';X.beginPath();X.ellipse(cx-1,hTop-1,5,1,-.15,0,Math.PI*2);X.fill();
  } else if(P.hair===7){
    // LOCZKI â€” obĹ‚okowa sylwetka + 3 fale loczkĂłw
    X.fillStyle=_hg(hTop-5,hTop+5);
    X.beginPath();
    X.moveTo(cx-11,hTop+4);
    X.bezierCurveTo(cx-13,hTop-3, cx-10,hTop-7, cx-4,hTop-7);
    X.bezierCurveTo(cx-1,hTop-9, cx+1,hTop-9, cx+4,hTop-7);
    X.bezierCurveTo(cx+10,hTop-7, cx+13,hTop-3, cx+11,hTop+4);
    X.quadraticCurveTo(cx+6,hTop+2, cx,hTop+2);
    X.quadraticCurveTo(cx-6,hTop+2, cx-11,hTop+4);
    X.closePath();X.fill();
    // 3 fale loczkĂłw
    X.fillStyle='rgba(0,0,0,.22)';
    X.beginPath();X.arc(cx-5,hTop-4,2,Math.PI,0,false);X.fill();
    X.beginPath();X.arc(cx,hTop-6,2,Math.PI,0,false);X.fill();
    X.beginPath();X.arc(cx+5,hTop-4,2,Math.PI,0,false);X.fill();
  } else if(P.hair===8){
    // v1.9.7: QUIFF â€” czysty pomp asymetryczny + fade boki
    // Boki â€” niskie, ostre fade
    X.fillStyle=_hg(hTop+2,hTop+6);
    X.fillRect(cx-9,hTop+2,18,4);
    // Pomp â€” wysoka asymetryczna fala (peak po lewej, sweep do prawej tyĹ‚u)
    X.fillStyle=_hg(hTop-14,hTop+2);
    X.beginPath();
    X.moveTo(cx-7,hTop+2);
    X.lineTo(cx-6,hTop-8);
    X.quadraticCurveTo(cx-4,hTop-14, cx,hTop-14);    // peak po lewej
    X.bezierCurveTo(cx+4,hTop-14, cx+6,hTop-10, cx+7,hTop-4);  // sweep do prawej
    X.lineTo(cx+7,hTop+2);
    X.closePath();X.fill();
    // Pasma tekstury (subtelne kreski wzdĹ‚uĹĽ quiffu)
    X.strokeStyle='rgba(0,0,0,.35)';X.lineWidth=0.5;
    for(let i=0;i<3;i++){
      X.beginPath();
      X.moveTo(cx-5+i*3,hTop+2);
      X.bezierCurveTo(cx-4+i*3,hTop-6, cx-2+i*3,hTop-12, cx+i*2,hTop-13);
      X.stroke();
    }
    // CieĹ„ fade'u
    X.fillStyle='rgba(0,0,0,.25)';X.fillRect(cx-9,hTop+5,18,0.8);
    // PoĹ‚ysk
    X.fillStyle='rgba(255,200,140,.3)';X.beginPath();X.ellipse(cx-2,hTop-11,3,1,-.15,0,Math.PI*2);X.fill();
  } else if(P.hair===9){
    // v1.9.8: BUZZ w grze â€” uniform stubble pattern + ostra hairline
    X.fillStyle='rgba(0,0,0,.4)';
    X.beginPath();X.ellipse(cx,hTop+1,11,7,0,Math.PI,Math.PI*2);X.fill();
    // Dot grid stubble
    X.fillStyle='rgba(60,30,15,.85)';
    for(let row=0;row<3;row++){
      for(let col=0;col<5;col++){
        const sx=cx-10+col*5+(row%2)*2.5;
        const sy=hTop-4+row*2.5;
        const dx=(sx-cx)/11,dy=(sy-(hTop+1))/7;
        if(dx*dx+dy*dy<=1.0) X.fillRect(sx,sy,0.7,0.7);
      }
    }
    // Hairline
    X.fillStyle='rgba(0,0,0,.5)';X.fillRect(cx-10,hTop+4,20,0.6);
  }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  KAMERA + RUCH
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function updateCamera(){
  const room=ROOMS[currentRoom];
  const wW=room.wT*T,wH=room.hT*T;
  /* v1.9.87/v1.9.92: cinematic camera override (Wprowadzenie aerial fly) z zoom + ease-out */
  if(window._cinemCam && window._cinemCam.active){
    const c=window._cinemCam;
    /* v1.9.99: WOLNIEJSZY ruch â€” gĹ‚adki przelot zamiast szybkiego skoku.
       Adaptacyjne tempo: dalej â†’ szybciej (0.035), bliĹĽej â†’ wolniej (0.012) â€” naturalne hamowanie.
       lerpMul z _cinemCam (panSweep daje 0.6 = jeszcze wolniej dla ciÄ…gĹ‚ego pana). */
    const dx=c.targetX-cam.x, dy=c.targetY-cam.y;
    const dist=Math.hypot(dx,dy);
    const baseLerp = dist>500 ? 0.04 : dist>150 ? 0.025 : 0.012;
    const lerpSpeed = baseLerp * (c.lerpMul||1);
    cam.x+=dx*lerpSpeed;
    cam.y+=dy*lerpSpeed;
    /* Lerp zoom â€” wolniejszy 0.04 â†’ 0.025 (pĹ‚ynniejsze) */
    const tz=c.targetZoom||1;
    cam.zoom += (tz - cam.zoom) * 0.025;
    /* v2.1.9: zoom-aware clamp dla cinematic. Pivot zoom = Ĺ›rodek viewportu (640, 391).
       Ĺšwiat widoczny: [cam.x + 640 - 640/Z, cam.x + 640 + 640/Z]. Dla Z>1 widzimy MNIEJ Ĺ›wiata
       (zoom in), wiÄ™c kamera moĹĽe iĹ›Ä‡ BLIĹ»EJ brzegu mapy.
       Min: cam.x = 640(1/Z - 1) â€” ujemne dla Z>1, ale clamp do min(0, ...) ĹĽeby nie wystawaÄ‡ poza lewy brzeg.
       Max: cam.x = wW - 640(1 + 1/Z). Pozwala budynkom przy prawej krawÄ™dzi (wx>3680) byÄ‡ w centrum przy zoom 1.6.
       PrzykĹ‚ad: BIURO wx=4004 z Z=1.6 â€” wczeĹ›niej clamp 3040 (off-center 1158px right), teraz clamp 3280 (~74px right of center). */
    const _z=Math.max(0.1, cam.zoom||1);
    const _minX=Math.min(0, 640*(1/_z-1));
    const _maxX=Math.max(0, wW - 640*(1+1/_z));
    const _minY=Math.min(0, 329*(1/_z-1));
    const _maxY=Math.max(0, wH - 329*(1+1/_z));
    cam.x=clamp(cam.x, _minX, _maxX);
    cam.y=clamp(cam.y, _minY, _maxY);
    cam._initialized=true;
    return;
  }
  /* v1.9.92: poza cinematic â€” szybki reset zoom do 1 */
  if(cam.zoom !== 1){
    cam.zoom += (1 - cam.zoom) * 0.1;
    if(Math.abs(cam.zoom-1)<0.005) cam.zoom=1;
  }
  const tx=clamp(P.wx+P.w/2-640,0,Math.max(0,wW-1280));
  const ty=clamp(P.wy+P.h/2-360,0,Math.max(0,wH-658));
  // Smooth lerp â€” kamera pĹ‚ynnie dogania pozycjÄ™ gracza zamiast skakaÄ‡.
  // WiÄ™kszy LERP_SPEED â†’ szybciej za graczem, mniejszy â†’ bardziej "filmowo".
  const LERP_SPEED=0.22;
  if(cam._initialized){
    cam.x+=(tx-cam.x)*LERP_SPEED;
    cam.y+=(ty-cam.y)*LERP_SPEED;
    // Snap do targetu gdy bardzo blisko (zapobiega "wibracji")
    if(Math.abs(tx-cam.x)<0.5)cam.x=tx;
    if(Math.abs(ty-cam.y)<0.5)cam.y=ty;
  } else {
    cam.x=tx;cam.y=ty;cam._initialized=true;
  }
}
// Snap camera natychmiastowo (np. po teleport / changeRoom)
function snapCamera(){const room=ROOMS[currentRoom];const wW=room.wT*T,wH=room.hT*T;cam.x=clamp(P.wx+P.w/2-640,0,Math.max(0,wW-1280));cam.y=clamp(P.wy+P.h/2-360,0,Math.max(0,wH-658));cam._initialized=true;}

function updatePlayer(){
  /* v1.9.89: kamera rusza nawet gdy paused â€” wymagane dla cinematic flythrough */
  if(window._cinemCam && window._cinemCam.active){
    P.moving=false; /* v2.1.21: clear ĹĽeby kroki NIE graĹ‚y gdy user trzymaĹ‚ strzaĹ‚kÄ™ przed odpaleniem przelot kamerÄ… */
    updateCamera();
    return;
  }
  if(_paused) return;
  if(overlayOpen()||phoneOpen()||mgOpen()) return;
  if(npcDlgOpen()) return;
  if(G._resting) return;
  const sleepOv=document.getElementById('sleep-overlay');
  if(sleepOv&&sleepOv.classList.contains('on')) return;
  // Cinematic active (intro/milestone/itp.) â€” blokuj ruch dopĂłki widoczny
  // DOM-first: element istnieje = aktywny | usuniÄ™ty = automatyczne odblokowanie (samoresetujÄ…cy)
  if(document.querySelector('[id$="-cinematic"]')) return;
  let dx=0,dy=0;
  if(K['ArrowUp']||K['w']||K['W']){dy=-P.spd;P.dir=0;}
  if(K['ArrowDown']||K['s']||K['S']){dy=P.spd;P.dir=2;}
  if(K['ArrowLeft']||K['a']||K['A']){dx=-P.spd;P.dir=3;}
  if(K['ArrowRight']||K['d']||K['D']){dx=P.spd;P.dir=1;}
  if(dx!==0 && dy!==0){
    const norm = 1/Math.sqrt(2);
    dx *= norm; dy *= norm;
  }
  if(G.car&&(dx!==0||dy!==0)&&currentRoom==='ulica'&&G._inCar){const boost=G.car.speed||1;dx*=boost;dy*=boost;}
  /* v2.1.26: ROLLBACK delta-time normalization. v2.1.17 wprowadziĹ‚ dt, ale powodowaĹ‚ niestabilnÄ… prÄ™dkoĹ›Ä‡.
     User: "Czasem normalna, czasem ultra wolna" + "Gracz dalej porusza sie ultra wolno. Nie byĹ‚o tak wczeĹ›niej."
     PowrĂłt do prostej P.wx += dx (jak przed v2.1.17). Browser handluje FPS przez requestAnimationFrame
     co naturalnie skaluje (60 FPS = 60 klatek/sec niezaleĹĽnie od ekranu). */
  P.moving=dx!==0||dy!==0;
  if(P.moving){anim++; if(!G._tutStat)G._tutStat={}; if(anim%10===0) G._tutStat.moved=(G._tutStat.moved||0)+1;} /* v1.9.48: throttle 1 inkrement co 10 klatek (audyt tutorial: ~60fps Ă— 30 = 0.5s; po fixie ~5s) */
  const room=ROOMS[currentRoom];
  let nx=clamp(P.wx+dx,0,room.wT*T-P.w);
  let ny=clamp(P.wy+dy,62,room.hT*T-P.h-8);
  // Building collision (only on ulica)
  if(currentRoom==='ulica'){
    const bldgs=room.objects.filter(o=>o.w>60&&o.h>60&&!o.id.startsWith('npc_')&&o.id!=='bench'&&o.id!=='bench2'&&o.id!=='pond'&&o.id!=='skate'&&o.id!=='bboying'&&o.id!=='save'&&o.id!=='wardrobe'&&o.id!=='apt_cust'&&o.id!=='phone_home'&&o.id!=='freestyle_spot');
    // Park fence collision â€” segmenty wokĂłĹ‚ parku x:0-672, y:864-1248. WejĹ›cie tylko przez bramkÄ™ c=13, r=21-22 (wy 1008-1104)
    const FT=14; // gruboĹ›Ä‡ pĹ‚otku
    const parkFence=[
      // GĂłrny pĹ‚otek: y=864 (caĹ‚a szerokoĹ›Ä‡ 0-672)
      {wx:0,wy:864-FT/2,w:672,h:FT},
      // Dolny pĹ‚otek: y=1248
      {wx:0,wy:1248-FT/2,w:672,h:FT},
      // Prawy pĹ‚otek gĂłrny (r=18-20): y=864-1008
      {wx:672-FT,wy:864,w:FT,h:1008-864},
      // Prawy pĹ‚otek dolny (r=23-25): y=1104-1248
      {wx:672-FT,wy:1104,w:FT,h:1248-1104},
    ];
    const allCollide=[...bldgs,...DB_DECORATIVE,...parkFence];
    const pw=P.w,ph=P.h;
    // Try X movement first
    const testX={wx:nx,wy:P.wy};
    for(const b of allCollide){
      if(testX.wx<b.wx+b.w&&testX.wx+pw>b.wx&&testX.wy<b.wy+b.h&&testX.wy+ph>b.wy){nx=P.wx;break;}
    }
    // Try Y movement
    const testY={wx:nx,wy:ny};
    for(const b of allCollide){
      if(testY.wx<b.wx+b.w&&testY.wx+pw>b.wx&&testY.wy<b.wy+b.h&&testY.wy+ph>b.wy){ny=P.wy;break;}
    }
  } else {
    // WewnÄ…trz pokojĂłw (mieszkanie/premium/lux/studio/silownia/merch_studio) â€” kolizja z obiektami solid (Ĺ›ciany)
    const walls=room.objects.filter(o=>o.solid);
    if(walls.length){
      const pw=P.w,ph=P.h;
      const testX={wx:nx,wy:P.wy};
      for(const b of walls){if(testX.wx<b.wx+b.w&&testX.wx+pw>b.wx&&testX.wy<b.wy+b.h&&testX.wy+ph>b.wy){nx=P.wx;break;}}
      const testY={wx:nx,wy:ny};
      for(const b of walls){if(testY.wx<b.wx+b.w&&testY.wx+pw>b.wx&&testY.wy<b.wy+b.h&&testY.wy+ph>b.wy){ny=P.wy;break;}}
    }
  }
  P.wx=nx;P.wy=ny;
  // F+ DUPLIKAT KROKĂ“W â€” usuniÄ™ty drugi dĹşwiÄ™k krokĂłw (sfxStep "noise" w tle).
  // Gracz miaĹ‚ 2 nakĹ‚adajÄ…ce siÄ™ dĹşwiÄ™ki: playStep (tup-tup, gameLoop) + sfxStep (szuru-szuru, tu).
  // Zostaje TYLKO playStep przez maybeSoundStep w gameLoop.
  // Reset licznika ĹĽeby nie eskalowaĹ‚:
  if(!P.moving) P._stepCnt=0;
  updateCamera();
  const nearId=getNear();
  const pr=document.getElementById('prompt');
  if(nearId&&!overlayOpen()&&!phoneOpen()&&!npcDlgOpen()){
    const obj=ROOMS[currentRoom].objects.find(o=>o.id===nearId);
    if(obj){
      let txt=obj.prompt;
      // Dynamic apartment label
      if(obj.act==='enter_apt'){
        const aptName=G.apartment==='mega_villa'?'Mega Villa 🏖':G.apartment==='mansion'?'Rezydencja đźŹ°':G.apartment==='luxury'?'Penthouse đź’Ž':G.apartment==='premium'?'Apartament Premium':G.apartment==='basic'?'Mieszkanie Podstawowe':'Traphouse';
        txt=`[E] WejdĹş â€” ${aptName}`;
      }
      // Studio Merch â€” wymaga 5000 fanĂłw
      if(obj.id==='merch_studio'){
        if((G.fans||0)<5000) txt=`đź”’ Studio Projektowania â€” wymaga 5000 fanĂłw (masz ${(G.fans||0).toLocaleString('pl')})`;
        else txt='[E] Studio Projektowania';
      }
      // Dynamic lock hints for career objects
      // v1.8.71: poprawne wymogi + info o alternatywnej Ĺ›cieĹĽce przez drzewko umiejÄ™tnoĹ›ci
      if(obj.act&&obj.act.startsWith('open:')){
        const cid=obj.act.slice(5);
        const carNames={youtuber:'YouTuber',beatmaker:'Beatmaker',gamer:'Gamer',influencer:'Influencer',soundeng:'Realizator DĹşwiÄ™ku'};
        if(carNames[cid]&&G.careers&&G.careers[cid]&&!G.careers[cid].unlocked){
          const totalXP=G.xp+(G.level-1)*CFG.xpPerLevel;
          // v1.8.71: influencer wymaga 500 followers (nie xpReq=200 â€” to byĹ‚o Ĺşle); reszta uĹĽywa wĹ‚aĹ›ciwych progĂłw
          if(cid==='influencer') txt=`đź”’ ${carNames[cid]} â€” wymaga 500 fanĂłw (masz ${(G.fans||0)})`;
          else if(cid==='youtuber') txt=`đź”’ ${carNames[cid]} â€” wymaga ${G.careers[cid].xpReq} XP (masz ${totalXP})`;
          else if(cid==='gamer') txt=`đź”’ ${carNames[cid]} â€” wymaga poziomu 2 (jesteĹ› lvl ${G.level})`;
          else if(cid==='beatmaker') txt=`đź”’ ${carNames[cid]} â€” wymaga poziomu 3 (jesteĹ› lvl ${G.level})`;
          else if(cid==='soundeng') txt=`đź”’ ${carNames[cid]} â€” wymaga poziomu 4 (jesteĹ› lvl ${G.level})`;
        }
      }
      if(txt){pr.textContent=txt;pr.style.display='block';}else pr.style.display='none';
    }
  } else pr.style.display='none';
}

function getNear(){
  const room=ROOMS[currentRoom];
  const px=P.wx+P.w/2,py=P.wy+P.h/2;
  // Budynki majÄ… priorytet nad NPC â€” dwa przebiegi
  // Przebieg 1: tylko budynki (wejĹ›cie do budynku waĹĽniejsze niĹĽ dialog NPC)
  for(const obj of room.objects){
    const isParkObj=['fountain','pond','skate','bboying','freestyle_spot','apt2_fountain'].includes(obj.id);
    const isDecorOnly=!obj.act || obj.id.startsWith('park_lamp')||obj.id.startsWith('park_bush')||obj.id==='park_trash';
    const isBuilding=obj.w>60&&obj.h>60&&!obj.id.startsWith('npc_')&&!isParkObj&&!isDecorOnly;
    if(!isBuilding) continue;
    /* v2.1.58 Amper: parking to obszar otwarty (nie budynek z drzwiami) â€” Ĺ‚ap interakcjÄ™ od KAĹ»DEJ strony.
       WczeĹ›niej logika facesSouth=false dawaĹ‚a detect TYLKO przy pĂłĹ‚nocnej krawÄ™dzi (gracz musiaĹ‚ staÄ‡ nad parkingiem). */
    if(obj.id==='parking'){
      const margin=30;
      if(px>obj.wx-margin && px<obj.wx+obj.w+margin && py>obj.wy-margin && py<obj.wy+obj.h+margin) return obj.id;
      continue;
    }
    if(currentRoom==='ulica'){
      const isNorthRow=obj.wy<300;
      const isH3North=obj.wy>=2500&&obj.wy<2800; // Dzielnica Dripu N â€” fasada od poĹ‚udnia (ku H3)
      const facesSouth=isNorthRow||isH3North;
      const doorY=facesSouth?(obj.wy+obj.h):(obj.wy);
      const doorMargin=80;
      const hOverlap=px>obj.wx-20&&px<obj.wx+obj.w+20;
      const vNear=facesSouth?(py>doorY-10&&py<doorY+doorMargin):(py>doorY-doorMargin&&py<doorY+10);
      if(hOverlap&&vNear) return obj.id;
    } else {
      const dx=px-(obj.wx+obj.w/2);
      const dy=py-(obj.wy+obj.h/2);
      if(Math.hypot(dx,dy)<90) return obj.id;
    }
  }
  // Przebieg 2: NPC i maĹ‚e obiekty (tylko gdy ĹĽaden budynek nie pasuje)
  for(const obj of room.objects){
    if(obj.id==='npc_fan'&&(G.fans||0)<10) continue;
    if(!obj.act) continue; // pomiĹ„ dekoracyjne (lampy, krzewy, kosz)
    const isParkObj=['fountain','pond','skate','bboying','freestyle_spot','apt2_fountain'].includes(obj.id);
    const isDecorOnly=!obj.act || obj.id.startsWith('park_lamp')||obj.id.startsWith('park_bush')||obj.id==='park_trash';
    const isBuilding=obj.w>60&&obj.h>60&&!obj.id.startsWith('npc_')&&!isParkObj&&!isDecorOnly;
    if(isBuilding) continue; // juĹĽ sprawdzone
    const dx=px-(obj.wx+obj.w/2);
    const dy=py-(obj.wy+obj.h/2);
    // Per-object actRadius (np. Zbyszek przy budce kebabu = 140 zeby zlapac z chodnika)
    const r=obj.actRadius||90;
    if(Math.hypot(dx,dy)<r) return obj.id;
  }
  return null;
}

function tryInteract(){
  /* v2.1.44 [Amper]: sanity-check anty-freeze â€” jeĹ›li #mg-job ma .on ale display:none (stuck z poprzedniej minigry), wyczyĹ›Ä‡. */
  const _mj=document.getElementById('mg-job');
  if(_mj && _mj.classList.contains('on') && _mj.style.display==='none'){
    _mj.classList.remove('on');_mj.innerHTML='';
  }
  if(overlayOpen()||phoneOpen()||mgOpen()) return;
  /* v1.9.54: guard przeciw race condition podczas fade miÄ™dzy pokojami (audyt room transitions) */
  if(typeof _roomFadeDir!=='undefined' && _roomFadeDir!==0) return;
  if(npcDlgOpen()){closeNPCDlg();return;}
  const id=getNear();if(!id) return;
  const obj=ROOMS[currentRoom].objects.find(o=>o.id===id);
  if(obj) handleAct(obj.act,obj.id);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  GODZINY OTWARCIA
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
const PLACE_HOURS={
  // Drip district / butiki
  'shop:lv':         {o:10, c:20, name:'Louis Vuitton'},
  'shop:chanel':     {o:10, c:20, name:'Chanel'},
  'shop:hermes':     {o:10, c:20, name:'HermĂ¨s'},
  'shop:gucci':      {o:10, c:20, name:'Gucci'},
  'shop:balenciaga': {o:10, c:20, name:'Balenciaga'},
  'shop:bottega':    {o:10, c:20, name:'Bottega Veneta'},
  'shop:dior':       {o:10, c:20, name:'Dior'},
  'shop:prada':      {o:10, c:20, name:'Prada'},
  // UsĹ‚ugi
  'shop:fryzjer':    {o:6,  c:20, name:'Fryzjer'},
  'shop:muzyczny':   {o:9,  c:21, name:'Sklep muzyczny'},
  'shop:salon':      {o:9,  c:19, name:'Salon samochodowy'},
  'shop:meble':      {o:9,  c:20, name:'IKEA'},
  'shop:warsztat':   {o:7,  c:19, name:'Warsztat'},
  'shop:mediamarkt': {o:9,  c:21, name:'Media Markt'},
  'shop:ubrania':    {o:9,  c:21, name:'Sklep z ubraniami'},
  'shop:biuro':      {o:9,  c:18, name:'Biuro NieruchomoĹ›ci'},
  'shop:radiostation':{o:0, c:24, name:'Radio Street'}, // radio na ĹĽywo 24h
  'shop:szpital':    {o:0,  c:24, name:'Szpital'}, // dyĹĽur 24h
  // Jedzenie â€” shifty zapewniajÄ…ce ĹĽe gracz ZAWSZE ma gdzie zjeĹ›Ä‡:
  // Sklep spoĹĽywczy 24h (zawsze otwarty, podstawowe rzeczy)
  'shop:spozywczy':  {o:0,  c:24, name:'Sklep spoĹĽywczy'}, // 24/7 â€” zawsze coĹ› dostÄ™pne
  // Restauracja popoĹ‚udniowo-wieczorna
  'shop:restauracja':{o:12, c:24, name:'Restauracja'}, // 12-24
  // Pizzeria â€” wieczorowo-nocna
  'shop:pizzeria':   {o:11, c:24, name:'Pizzeria'}, // 11-24 (jako shop)
  // Targ â€” rano-popoĹ‚udnie (Ĺ›wieĹĽe produkty)
  'shop:targ':       {o:7,  c:15, name:'Targ'}, // 7-15
  // Sala koncertowa â€” wieczĂłr
  'shop:sala':       {o:14, c:24, name:'Sala Koncertowa'},
  // Prace dorywcze
  'job:supermarket': {o:6,  c:23, name:'Supermarket'},
  'job:construction':{o:7,  c:18, name:'Plac budowy'},
  'job:kurier':      {o:8,  c:20, name:'Kurier'},
  'job:carwash':     {o:8,  c:20, name:'Myjnia'},
  'job:pizza':       {o:11, c:24, name:'Pizzeria (praca)'},
  'job:zmywak':      {o:12, c:24, name:'Zmywak'},
  'goto:silownia':   {o:6,  c:23, name:'SiĹ‚ownia'},
  // Studio/merch â€” peĹ‚nowymiarowy "internet" 24h (tworzenie)
  'goto:studio':     {o:0,  c:24, name:'Studio'},
  'goto:merch_studio':{o:0, c:24, name:'Studio Merch'},
  // NPC vendors NIE sÄ… tu â€” Zbyszek (npc:vendor) jest 24/7 (uliczny sprzedawca)
};
// Shifty jedzeniowe â€” co najmniej JEDNO miejsce zawsze otwarte (sklep spoĹĽywczy 24/7).
// PozostaĹ‚e: pizzeria 11-24, restauracja 12-24, targ 7-15, Zbyszek 24/7 (NPC) â€” pokrywajÄ… caĹ‚y dzieĹ„.
function isPlaceOpen(act){
  const key=act.split(':').slice(0,2).join(':');
  const h=PLACE_HOURS[key];
  if(!h) return {open:true};
  const hour=Math.floor(gameMin/60)%24;
  const open=(h.o<h.c)?(hour>=h.o&&hour<h.c):(hour>=h.o||hour<h.c);
  const pad=n=>String(n).padStart(2,'0');
  return {open,name:h.name,opensAt:`${pad(h.o)}:00`,closesAt:`${pad(h.c)}:00`};
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  AKCJE
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function handleAct(act,objId){
  // SprawdĹş godziny otwarcia
  const hours=isPlaceOpen(act);
  if(!hours.open){
    showMsg(`đź”’ ${hours.name} zamkniÄ™te! Otwarte ${hours.opensAt}â€“${hours.closesAt}`,'r');
    return;
  }
  if(act==='sleep'){
    startSleepAnimation();
  } else if(act==='eat'){
    if(!G._tutStat)G._tutStat={};G._tutStat.ate=(G._tutStat.ate||0)+1;
    openFridgeUI();
  } else if(act==='rest'){
    // #77 BUG FIX: Sofa Lux daje +10 nastrĂłj (z 30 â†’ 40) + lepszy komunikat #76
    const hasSofaLux=G.aptPurchases?.furniture?.includes('sofa_luxury');
    const stressGain=hasSofaLux?40:30;
    const msg=hasSofaLux?'đź›‹ Odpoczywasz na sofie LUX â€” wiÄ™ksza regeneracja...':'đź›‹ Odpoczywasz na sofie...';
    startRestMG('sofa',20,stressGain,20,msg);
    return;
  } else if(act==='relax'){
    // Komunikat zaleĹĽny od typu/lokalizacji Ĺ‚awki
    let benchMsg='đźŚł Siedzisz na Ĺ‚awce w parku...';
    if(objId){
      if(objId.startsWith('apt1_')) benchMsg='đźŞ‘ Odpoczywasz na Ĺ‚awce przed Mieszkaniem Podstawowym...';
      else if(objId.startsWith('apt2_')) benchMsg='âś¨ Relaksujesz siÄ™ na designerskiej Ĺ‚awce przy Penthousie...';
      else if(objId.startsWith('apt4_')) benchMsg='đźŞ‘ Odpoczywasz na eleganckiej Ĺ‚awce przy Apartamencie Premium...';
    }
    /* v2.1.26: XP z capem 1/min real */
    startRestMG('bench',15,10,25,benchMsg,()=>{addXPCapped(5,'rest_bench',60000);progressQuest('relax');});
    return;
  } else if(act==='park_monument'){
    showMsg('đź—ż Pomnik z 1923 roku. Lokalna legenda â€” zaĹ‚oĹĽyciel dzielnicy. Patyna zielonkawa dodaje "charakteru".');
    return;
  } else if(act==='hof_statue'){
    /* v2.1.215 [Amper]: Hall of Fame statue interakcja — pokazuje informację o nominacji */
    if(G._hasHallOfFameStatue && typeof showMsg==='function'){
      showMsg(`🏛 Twoja statua w Drip District! "${G.name}: Hall of Fame Polish Hip-Hop". Lokalne hołd dla legendy. Tylko dla najwybitniejszych.`,'g',7000);
    }
    return;
  } else if(act==='helipad_info'){
    openHelipadOverlay();
    return;
  } else if(act==='casino:bar'){
    openCasinoBar();
    return;
  } else if(act==='pond'){
    /* v2.1.201 [Amper]: Pond â€” dodano wybĂłr: kontemplacja (rest) lub Ĺ‚owienie ryb (interaktywny minigame). */
    if(typeof window._showPondChoice==='function'){ window._showPondChoice(); return; }
    /* fallback */
    startRestMG('pond',15,5,15,'đźź Kontemplujesz staw...',()=>{addXPCapped(3,'rest_pond',60000);});
    return;
  } else if(act==='fountain'){
    /* v2.1.201 [Amper]: BUFF Fountain ROI â€” z 15% szans bonus do 35%. Plus 5% jackpot (100-300 zĹ‚ cash + 3 sĹ‚awy).
       Cost 5 zĹ‚, +8 nastrĂłj gwarantowane, +2 XP gwarantowane. EV bonus z ~3 zĹ‚ na ~25-40 zĹ‚ value. */
    if(G._lastFountainDay===G.day){showMsg('â›˛ JuĹĽ wrzuciĹ‚eĹ› monetÄ™ dziĹ›. WrĂłÄ‡ jutro.','r');return;}
    if(G.money<5){showMsg('âš ď¸Ź Potrzebujesz 5 zĹ‚ na monetÄ™.','r');return;}
    G._lastFountainDay=G.day;
    G.money-=5;
    G.stress=clamp(G.stress+8,0,100);
    G._fountainWishes=(G._fountainWishes||0)+1;
    if(Math.random()<0.35){
      // Ĺ»yczenie siÄ™ speĹ‚nia â€” losowy bonus (buff v2.1.201)
      const r=Math.random();
      if(r<0.05){
        // JACKPOT â€” 5% szans (=1.75% per moneta)
        const cash=rnd(100,300);
        if(typeof earn==='function') earn(cash,false); else {G.money+=cash;G.totalEarned=(G.totalEarned||0)+cash;}
        if(typeof addFame==='function')addFame(3);else G.fame=clamp(G.fame+3,0,500);
        notify(`âś¨ JACKPOT! Fontanna speĹ‚nia hojne ĹĽyczenie â€” +${cash} zĹ‚ i +3 sĹ‚awy`);
      }
      else if(r<0.40){const fans=rnd(30,120);G.followers+=fans;notify(`â›˛ Twoje ĹĽyczenie siÄ™ speĹ‚nia! +${fans} obserwujÄ…cych`);}
      else if(r<0.70){const xp=rnd(8,22);addXP(xp);notify(`â›˛ WrzuciĹ‚eĹ› monetÄ™ â€” czujesz siÄ™ lepiej. +${xp} XP`);}
      else if(r<0.92){if(typeof addFame==='function')addFame(3);else G.fame=clamp(G.fame+3,0,500);notify('â›˛ Magia fontanny â€” +3 sĹ‚awy');}
      else {const fans=rnd(5,15); addFans(fans); notify(`â›˛ SpotkaĹ‚eĹ› prawdziwego fana przy fontannie â€” +${fans} lojalnych fanĂłw`);}
    } else {
      notify('â›˛ WrzuciĹ‚eĹ› monetÄ™. TrochÄ™ spokoju.');
    }
    addXP(2);
    return;
  } else if(act==='skate'){
    /* v2.1.138: dodano energy gate (asymetria z freestyle L8932 â€” wczeĹ›niej skatepark mĂłgĹ‚ byÄ‡ uruchomiony z 0 energii). Skatepark zuĹĽywa -10 energii w trakcie. */
    if((G.energy||0)<10){showMsg('âšˇ Za maĹ‚o energii (potrzeba 10)','r');return;}
    startSkateparkMG();return;
  } else if(act==='bboy'){
    /* v2.1.138: dodano energy gate (asymetria z freestyle L8932). Breakdance zuĹĽywa -8 energii. */
    if((G.energy||0)<8){showMsg('âšˇ Za maĹ‚o energii (potrzeba 8)','r');return;}
    startBreakdanceMG();return;
  } else if(act.startsWith('gym:')){
    const parts=act.split(':');
    const t=parts[1];
    const equip=parts[2]||'bench'; // 'bench' lub 'cable' (rozdzielenie Ĺ‚awki/wyciÄ…gu)
    if(t==='strength') startBenchPressMG(undefined,equip);
    else if(t==='cardio') startTreadmillMG();
  } else if(act==='freestyle'){
    /* v2.0.4: USUNIÄTY cooldown 60 min â€” user request. Energia (-15) i wymĂłg energii (>=15) zostajÄ… jako naturalny limit. */
    if((G.energy||0)<15){showMsg('âšˇ Za maĹ‚o energii (potrzeba 15)','r');return;}
    G.energy=Math.max(0,(G.energy||0)-15);
    G._lastFreestyleMin=gameMin||0; /* zostawione dla kompatybilnoĹ›ci save'Ăłw + ewentualnych statystyk */
    startFreestyleMG();return;
  } else if(act==='save'){
    saveGame();
  } else if(act==='phone'){
    playClick();togglePhone();
  } else if(act==='pc_menu'){
    openComputerMenu();
  } else if(act==='enter_apt'){
    if(!G._tutStat)G._tutStat={};G._tutStat.entered=(G._tutStat.entered||0)+1;
    enterApartment();
  } else if(act&&act.startsWith('enter_apt:')){
    const aptId=act.split(':')[1];
    enterSpecificApartment(aptId);
  } else if(act==='cook'){
    cookMeal();
  } else if(act==='studio_info_booth'){
    // #30A: Kabina to element wizualny â€” funkcjonalnie wszystko przez komputer (DAW)
    // v1.8.18: jaĹ›niejszy komunikat â€” mikrofon SAM nie wystarcza, potrzeba teĹĽ komputera z DAW
    const _hasMic=!!G.mic;
    const _hasDaw=!!G.hasDaw;
    let _msg='đźŽ™ Kabina nagraĹ„ â€” element studyjny. Wokale nagrywasz przez đź’» komputer (DAW â†’ Nagrywanie).';
    if(_hasMic && !_hasDaw) _msg='đźŽ™ Masz mikrofon, ale brak komputera z DAW! Kup komputer w Sklepie Muzycznym (od 2000 zĹ‚) â†’ wtedy E na đź’» komputer â†’ zakĹ‚adka Nagrywanie.';
    else if(!_hasMic) _msg='đźŽ™ Brak mikrofonu! Kup w Sklepie Muzycznym, potem do tego komputer z DAW. Wokale nagrywasz przez đź’» komputer â†’ Nagrywanie.';
    if(typeof showMsg==='function') showMsg(_msg,'g',8000);
    return;
  } else if(act==='studio_info_mixer'){
    // #30A: Mikser to element wizualny â€” funkcjonalnie wszystko przez komputer (DAW)
    if(typeof showMsg==='function') showMsg('đźŽš Mikser analogowy â€” element studyjny. Bity tworzysz przez đź’» komputer (DAW â†’ Beatmaker â†’ Sequencer).','g');
    return;
  } else if(act==='trofea'){
    showTrofea();
  } else if(act==='merch_designer'){
    renderMerchDesigner();
  } else if(act==='merch_factory'){
    renderMerchFactory();
  } else if(act==='merch_warehouse'){
    renderMerchWarehouse();
  } else if(act==='merch_report'){
    renderMerchReport();
  } else if(act==='aquarium'){
    /* v2.1.26: XP z capem 1/min real */
    startRestMG('pond',15,5,15,'đź  Patrzysz na rybki w akwarium...',()=>{addXPCapped(2,'rest_aquarium',60000);});return;
  } else if(act==='tv'){
    openTVMenu();return;
  } else if(act==='lampka_toggle'){
    G._lampkaOn=!G._lampkaOn; /* v1.9.34: BUG FIX â€” proper toggle (poprzednio undefinedâ†’falseâ†’false stuck) */
    notify(G._lampkaOn?'đź’ˇ Lampka wĹ‚Ä…czona':'đźŚ™ Lampka wyĹ‚Ä…czona');
    if(typeof saveGameSilent==='function') saveGameSilent(); // v1.8.52: zapisz stan lampki
    return;
  } else if(act==='wardrobe_change'){
    renderWardrobeChange();return;
  } else if(act==='cook_basic'){
    openCookingMenu();return;
  } else if(act==='eat_table'){
    // Anti-clicker: cooldown 4h gry + max 3x/dobÄ™
    if((G.hunger||0)>=95){notify('JuĹĽ jesteĹ› najedzony.');return;}
    // WYMAGA jedzenia: lodowka albo spizarnia musza miec cos
    const fridgeQty=(G.fridgeItems||[]).reduce((s,i)=>s+(i.qty||0),0);
    const pantryQty=Object.values(G.pantry||{}).reduce((s,v)=>s+(v||0),0);
    if(fridgeQty===0 && pantryQty===0){
      showMsg('đźŤ˝ Pusty stĂłĹ‚ â€” najpierw kup jedzenie w sklepie spoĹĽywczym đź›’ (lodĂłwka) lub skĹ‚adniki na targu (spiĹĽarnia)','r');
      return;
    }
    const _now=gameMin||0;
    if(_now-(G._lastEatTableMin||-9999)<240){
      const _m=Math.ceil(240-(_now-(G._lastEatTableMin||0)));
      showMsg(`đźŤ˝ Niedawno jadĹ‚eĹ› â€” odczekaj ${_m} min`,'r');return;
    }
    if(G._eatTableDay!==G.day){G._eatTableDay=G.day;G._eatTableCount=0;}
    if((G._eatTableCount||0)>=3){showMsg('đźŤ˝ JuĹĽ 3Ă— dziĹ› jadĹ‚eĹ› przy stole. SprĂłbuj jutro lub coĹ› ugotuj.','r');return;}
    G._lastEatTableMin=_now;
    G._eatTableCount=(G._eatTableCount||0)+1;
    // Konsumuj 1 sztuke jedzenia â€” najpierw fridge potem pantry
    let consumed='produkt';
    if(fridgeQty>0){
      // Wez pierwszy item z fridge
      const item=G.fridgeItems.find(i=>i.qty>0);
      if(item){
        item.qty--;consumed=item.id||'jedzenie';
        if(item.qty<=0)G.fridgeItems=G.fridgeItems.filter(i=>i.qty>0);
      }
    } else {
      // Wez pierwszy z pantry
      for(const k of Object.keys(G.pantry)){
        if(G.pantry[k]>0){G.pantry[k]--;consumed=k;break;}
      }
    }
    G.hunger=eatFood(22);
    G.stress=Math.min(100,(G.stress||0)+5);
    notify(`đźŤ˝ PosiĹ‚ek przy stole â€” zuĹĽyto 1Ă— ${consumed} (+22 gĹ‚Ăłd, +5 nastrĂłj). Lepsze efekty daje gotowanie đź”Ą!`);
    return;
  } else if(act==='biblioteka'){
    // Anti-clicker: cooldown 2h gry + max 4x/dobÄ™ + koszt energii
    if((G.energy||0)<10){showMsg('âšˇ Za maĹ‚o energii (potrzeba 10)','r');return;}
    const _now=gameMin||0;
    if(_now-(G._lastBibliotekaMin||-9999)<120){
      const _m=Math.ceil(120-(_now-(G._lastBibliotekaMin||0)));
      showMsg(`đź“š TwĂłj umysĹ‚ musi odpoczÄ…Ä‡ â€” wrĂłÄ‡ za ${_m} min`,'r');return;
    }
    if(G._biblioDay!==G.day){G._biblioDay=G.day;G._biblioCount=0;}
    if((G._biblioCount||0)>=4){showMsg('đź“š JuĹĽ 4Ă— czytaĹ‚eĹ› dziĹ›. Daj umysĹ‚owi odpoczÄ…Ä‡ â€” wrĂłÄ‡ jutro.','r');return;}
    G._lastBibliotekaMin=_now;
    G._biblioCount=(G._biblioCount||0)+1;
    G.energy=Math.max(0,(G.energy||0)-10);
    G.stress=Math.min(100,(G.stress||0)+12);
    addXP(10);
    notify('đź“š Czytasz ksiÄ…ĹĽkÄ™ (-10 energii, +12 nastrĂłj, +10 XP)');
    return;
  } else if(act==='pool'){
    useLuxFacility('pool');
  } else if(act==='jacuzzi'){
    useLuxFacility('jacuzzi');
  } else if(act==='sauna'){
    useLuxFacility('sauna');
  } else if(act==='firepit'){
    useLuxFacility('firepit');
  } else if(act.startsWith('goto:')){
    const[,room,wx,wy]=act.split(':');
    if(room==='merch_studio' && (G.fans||0)<5000){
      showMsg('đź”’ Studio Projektowania odblokowane przy 5000 fanach (masz '+(G.fans||0).toLocaleString('pl')+')','r');
      return;
    }
    if(room==='silownia') G._gymVisits=(G._gymVisits||0)+1; // tracker dla osiÄ…gniÄ™cia "StaĹ‚y bywalec"
    startRoomFade(room,+wx,+wy);
  } else if(act==='apt_exit'){
    // F+ 2026-05-12: spawn przed DRZWIAMI z ktĂłrych gracz wszedĹ‚ â€” Ĺ›ledzimy G._lastEnterDoor
    const exitKey=G._lastEnterDoor||G.apartment;
    const sp=APT_EXIT_SPAWNS[exitKey]||APT_EXIT_SPAWNS.traphouse;
    startRoomFade('ulica',sp.wx,sp.wy);
  } else if(act.startsWith('open:')){
    openCareerOverlay(act.slice(5));
  } else if(act.startsWith('shop:')){
    openShopOverlay(act.slice(5));
  } else if(act.startsWith('job:')){
    openJobOverlay(act.slice(4));
  } else if(act.startsWith('npc:')){
    openNPCDialogue(act.slice(4));
  } else if(act==='casino:enter' || act==='enter_casino'){
    startRoomFade('casino', 600, 540);
    // F+ 2026-05-12: bonus za pierwszÄ… wizytÄ™ w kasynie
    if(!G._firstCasinoVisit){
      G._firstCasinoVisit=true;
      /* v2.1.123: Wave 3 K33 â€” addFame() zamiast direct clamp (Prestige fameMult). */
      if(typeof addFame==='function') addFame(5); else G.fame=clamp((G.fame||0)+5,0,500);
      if(typeof addNotif==='function')addNotif('đźŽ° Pierwsza wizyta w Royal! +5 sĹ‚awy');
      if(typeof confetti==='function')setTimeout(()=>confetti(20),700);
    }
  } else if(act==='casino:slots'){
    G._casinoVip = (currentRoom==='casino_vip');
    window.openSlots();
  } else if(act==='casino:roulette'){
    G._casinoVip = (currentRoom==='casino_vip');
    window.openRoulette();
  } else if(act==='casino:blackjack'){
    G._casinoVip = (currentRoom==='casino_vip');
    window.openBlackjack();
  } else if(act==='casino:war'){
    G._casinoVip = (currentRoom==='casino_vip');
    window.openWar();
  } else if(act==='casino:baccarat'){
    G._casinoVip = true;
    window.openBaccarat();
  } else if(act==='casino:dice'){
    G._casinoVip = true;
    window.openCraps();
  } else if(act==='casino:poker'){
    G._casinoVip = true;
    window.openPoker();
  } else if(act==='casino:ridebus'){
    /* v2.1.186: Ride the Bus â€” VIP exclusive, HE ~2% (jak sloty VIP) */
    G._casinoVip = true;
    window.openRideBus();
  } else if(act==='casino:plinko'){
    /* v1.9.91: Plinko jako osobny obiekt â€” tier zaleĹĽy od pokoju (vip = wyĹĽsze stawki) */
    G._casinoVip = (currentRoom==='casino_vip');
    window.openPlinko();
  } else if(act==='casino:keno'){
    G._casinoVip = (currentRoom==='casino_vip');
    window.openKeno();
  } else if(act==='casino:wheel'){
    G._casinoVip = (currentRoom==='casino_vip');
    window.openWheel();
  } else if(act==='casino:daily_wheel'){
    /* v1.9.93: Daily free wheel â€” raz dziennie darmowy spin (regular) */
    window.openDailyWheel(false);
  } else if(act==='casino:daily_wheel_vip'){
    window.openDailyWheel(true);
  } else if(act==='casino:elevator'){
    /* v1.9.98: winda PEĹNY EKRAN â€” spawn przed przyciskami */
    G._elevatorFrom = currentRoom;
    startRoomFade('elevator', 580, 540);
  } else if(act==='elevator:lobby'){
    /* v1.9.95: powrĂłt do lobby kasyna â€” spawn obok windy w lobby */
    if(typeof showMsg==='function') showMsg('đź›— Parter â€” Casino Royal','f',2500);
    startRoomFade('casino', 1100, 520);
  } else if(act==='elevator:vip'){
    /* v2.0.0: wymaganie = 10 000 zĹ‚ ĹÄ„CZNIE WYGRANYCH (totalWon, BEZ odejmowania przegranych).
       Liczy siÄ™ sama wygrana â€” gracz pokazuje ĹĽe umie wygrywaÄ‡. */
    const cs=G.casinoStats||{};
    const totalWon=cs.totalWon||0;
    const REQ=10000;
    if(totalWon<REQ){
      const left=REQ-totalWon;
      if(typeof showMsg==='function') showMsg(`đź”’ 1 piÄ™tro VIP â€” wymaga ${REQ.toLocaleString('pl')} zĹ‚ Ĺ‚Ä…cznych wygranych w grach kasynowych. Masz: ${totalWon.toLocaleString('pl')} zĹ‚ (brakuje ${left.toLocaleString('pl')} zĹ‚). Przegrane nie liczÄ… siÄ™ â€” wystarczy ĹĽe wygrywasz!`,'r',7500);
      return;
    }
    /* v2.0.3: Pierwsze odblokowanie â€” cinematic.
       BUG FIX: _vipUnlocked ustawiane DOPIERO po klikniÄ™ciu "WEJDĹą" (nie przed cinematic).
       WczeĹ›niej: gracz mĂłgĹ‚ zamknÄ…Ä‡ kartÄ™ â†’ flag juĹĽ true â†’ nastÄ™pnym razem cinematic siÄ™ nie odpalaĹ‚.
       Plus guard ĹĽeby cinematic nie odpaliĹ‚ siÄ™ drugi raz (spam-click). */
    if(!G._vipUnlocked && !window._vipCinemActive){
      if(typeof showVipUnlockCinematic==='function'){
        window._vipCinemActive=true;
        showVipUnlockCinematic(()=>{
          window._vipCinemActive=false;
          G._vipUnlocked=true;
          if(typeof saveGameSilent==='function') saveGameSilent();
          startRoomFade('casino_vip', 1100, 520);
        });
        return;
      } else {
        G._vipUnlocked=true;
        if(typeof saveGameSilent==='function') saveGameSilent();
      }
    }
    if(typeof showMsg==='function') showMsg('đź›— 1 piÄ™tro â€” VIP Lounge','f',2500);
    startRoomFade('casino_vip', 1100, 520);
  } else if(act==='casino:cashier'){
    openCasinoCashier();
  } else if(act==='parking:info'){
    if(!G.car){
      if(typeof showMsg==='function')showMsg('đź…żď¸Ź Parking miejski â€” potrzebujesz auta. Kup je w Salonie Aut.','r');
    } else if(G._inCar){
      /* v2.1.63 Amper: in-game gameConfirm (modal w stylu gry) zamiast natywnego browser confirm().
         Gracz widzi modal pasujÄ…cy do reszty UI, z TAK/NIE w grze, BEZ przeglÄ…darkowego dialogu. */
      if(typeof gameConfirm==='function'){
        gameConfirm('đź…żď¸Ź Czy chcesz zaparkowaÄ‡ auto tutaj?\n\nAuto zostanie na parkingu i musisz tu wrĂłciÄ‡, aby je odebraÄ‡.',()=>{
          /* v1.8.41: parkowanie zapisuje konkretnÄ… pozycjÄ™ na parkingu (puste miejsce). */
          const parkObj=ROOMS.ulica.objects.find(o=>o.id==='parking');
          const slotPos=_findFreeParkingSpot(parkObj);
          G._carParkedAt=slotPos;
          G._inCar=false;
          G._carsParked=(G._carsParked||0)+1;
          if(typeof showMsg==='function') showMsg('đź…żď¸Ź ZaparkowaĹ‚eĹ› auto na parkingu. WrĂłÄ‡ tutaj, by je odebraÄ‡ (E).');
          if(typeof saveGameSilent==='function') saveGameSilent();
        });
      } else {
        /* fallback gdy gameConfirm niedostÄ™pne */
        if(!confirm('đź…żď¸Ź ZaparkowaÄ‡ auto tutaj? Auto zostanie na parkingu â€” wrĂłÄ‡ tu aby odebraÄ‡.')) return;
        const parkObj=ROOMS.ulica.objects.find(o=>o.id==='parking');
        const slotPos=_findFreeParkingSpot(parkObj);
        G._carParkedAt=slotPos;
        G._inCar=false;
        G._carsParked=(G._carsParked||0)+1;
        if(typeof showMsg==='function') showMsg('đź…żď¸Ź ZaparkowaĹ‚eĹ› auto na parkingu. WrĂłÄ‡ tutaj, by je odebraÄ‡ (E).');
      }
      return; /* asynchroniczne â€” zapis przez callback w gameConfirm */
    } else if(G._carParkedAt){
      // Auto stoi na parkingu â€” gracz odbiera je
      G._carParkedAt=null;
      G._inCar=true;
      if(typeof showMsg==='function')showMsg('đźš— WsiadĹ‚eĹ› do auta â€” szybki transport po mieĹ›cie aktywny (boost prÄ™dkoĹ›ci).');
    } else {
      // Auto przy graczu, ale w parking handlerze â€” to wsiadanie z chodnika obok
      G._inCar=true;
      if(typeof showMsg==='function')showMsg('đźš— WsiadĹ‚eĹ› do auta â€” szybki transport po mieĹ›cie aktywny (boost prÄ™dkoĹ›ci).');
    }
    if(typeof saveGameSilent==='function')saveGameSilent();
  }
}

function openHelipadOverlay(){
  const isVip=G.apartment==='luxury';
  const baseCost=isVip?0:500; // Penthouse owners â€” darmowy transport. Inni pĹ‚acÄ… 500 zĹ‚.
  const dests=[
    {id:'home',label:'đźŹ  Mieszkanie',wx:_aptSpawnFor('home'),wy:0,fn:()=>{
      const sp=APT_EXIT_SPAWNS[G.apartment]||APT_EXIT_SPAWNS.traphouse;
      _heliFly(sp.wx,sp.wy);
    }},
    {id:'park',label:'đźŚł Park',wx:400,wy:1000,fn:()=>_heliFly(400,1000)},
    {id:'silownia',label:'đźŹ‹ď¸Ź SiĹ‚ownia',wx:1325,wy:300,fn:()=>_heliFly(1325,300)},
    {id:'studio',label:'đźŽµ Studio',wx:1715,wy:300,fn:()=>_heliFly(1715,300)},
    {id:'drip',label:'đź’Ž Drip District',wx:2800,wy:2780,fn:()=>_heliFly(2800,2780)},
    {id:'casino',label:'đźŽ° Kasyno',wx:3815,wy:660,fn:()=>_heliFly(3815,660)},
    {id:'sala',label:'đźŽ¤ Sala Koncertowa',wx:2780,wy:830,fn:()=>_heliFly(2780,830)},
  ];
  function _aptSpawnFor(){return 0;}
  function _heliFly(wx,wy){
    /* v1.9.19: BUG FIX OP â€” wczeĹ›niej Penthouse owner miaĹ‚ DARMOWY UNLIMITED INSTANT teleport. Dodajemy cooldown + energy + time cost ĹĽeby helipad miaĹ‚ sens nawet dla VIP. */
    if(G.money<baseCost){if(typeof showMsg==='function')showMsg('Brak kasy na lot!','r');return;}
    if((G.energy||0)<10){if(typeof showMsg==='function')showMsg('âšˇ Za maĹ‚o energii na lot (potrzeba 10).','r');return;}
    const _lastHeli=G._lastHeliMin||-9999;
    const _now=typeof gameMin==='number'?gameMin:0;
    if(_now-_lastHeli<30){if(typeof showMsg==='function')showMsg('đźš Helikopter musi siÄ™ przygotowaÄ‡ â€” odczekaj '+Math.ceil(30-(_now-_lastHeli))+' min gry.','r');return;}
    G.money-=baseCost;
    G.energy=Math.max(0,G.energy-10);
    if(typeof gameMin==='number') gameMin+=10;
    G._lastHeliMin=gameMin;
    G._heliFlights=(G._heliFlights||0)+1;
    if(baseCost>0 && typeof spent==='function')spent(baseCost);
    closeOverlay();
    if(typeof showMsg==='function')showMsg('đźš Lecisz helikopterem...');
    setTimeout(()=>{
      if(currentRoom!=='ulica')startRoomFade('ulica',wx,wy);
      /* v1.9.19: uĹĽyj findFreeSpawn nawet gdy juĹĽ na ulicy (anti-OOB clip into wall) */
      else {const s=typeof findFreeSpawn==='function'?findFreeSpawn(wx,wy):{wx,wy};P.wx=s.wx;P.wy=s.wy;if(typeof snapCamera==='function')snapCamera();}
      if(typeof showMsg==='function')showMsg('đźš WylÄ…dowaĹ‚eĹ›. Cena: '+(baseCost>0?baseCost+' zĹ‚':'darmowy lot VIP'));
      if(isVip && typeof confetti==='function')confetti(15);
    },800);
  }
  /* v2.1.201 [Amper]: Sightseeing tours â€” 3 trasy z fame/fans/xp reward + achievement chain "Pilot's Wings". */
  const _tourCount=G._heliTours||0;
  const _todayTour=(G._lastHeliTourDay===G.day);
  const tours=[
    {id:'skyline',label:'đźŚ† Skyline Tour',cost:isVip?500:2000,desc:'Lot nad centrum â€” 15 min nad wieĹĽowcami. Foto op.',fame:3,followers:80,fans:15,xp:15},
    {id:'mountain',label:'â›°ď¸Ź Lot widokowy',cost:isVip?800:3000,desc:'Lot poza miasto â€” gĂłry + jezioro. DĹ‚uĹĽszy lot.',fame:5,followers:150,fans:30,xp:25},
    {id:'sunset',label:'đźŚ… Sunset Photo Op',cost:isVip?1500:5000,desc:'Premium lot zachodnio â€” fotka ktĂłra rozpala social media.',fame:8,followers:300,fans:60,xp:40},
  ];
  document.getElementById('ov-content').innerHTML=`
    <h2 style="color:#f1c40f;text-align:center">đźš Helipad VIP</h2>
    <p style="text-align:center;color:#aaa;margin-bottom:8px">${isVip?'<span style="color:#27ae60">âś¨ Lot DARMOWY â€” mieszkasz w Penthouse</span>':'Cena lotu: <span style="color:#f1c40f">'+baseCost+' zĹ‚</span> (Penthouse Luxury: darmowy)'}</p>
    <div style="background:#0a1a2a;border:1px solid #1a3a5a;border-radius:8px;padding:10px 14px;margin:10px auto 14px;max-width:540px;font-size:11px;color:#7ec8e3;line-height:1.5">
      đź’¬ <b style="color:#f1c40f">Pilot Marek</b>: "Wsiadaj szefie! Wieziemy CiÄ™ gdzie chcesz. Tym razem mam teĹĽ ofertÄ™ specjalnÄ… â€” <b>tour widokowy</b> dla mediĂłw spoĹ‚ecznoĹ›ciowych. ${_tourCount>=5?'JesteĹ› juĹĽ moim staĹ‚ym klientem! đźŹ†':_tourCount>0?`LataĹ‚eĹ› ze mnÄ… ${_tourCount} razy. Trzymaj siÄ™ ${_tourCount>=3?'đźĄ':'đź‘‹'}`:'Pierwszy raz? Polecam Skyline Tour na start.'}"
    </div>
    <p style="text-align:center;color:#aaa;font-size:12px;margin-bottom:6px">đź“Ť Szybki transport (-10 energii, 30 min cooldown):</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin:8px auto 16px;max-width:540px">
      ${dests.map(d=>`<button onclick="window._heliGoto('${d.id}')" style="background:#1a3a5a;border:1px solid #c8a520;color:#fff;padding:14px;cursor:pointer;border-radius:8px;font-family:inherit;font-size:14px">${d.label}</button>`).join('')}
    </div>
    <p style="text-align:center;color:#aaa;font-size:12px;margin-bottom:6px">đźŚ† Lot widokowy (1/dzieĹ„, wiÄ™kszy reward):</p>
    ${_todayTour?`<div style="text-align:center;color:#778;font-size:12px;margin-bottom:14px;background:#0a1a0a;border:1px solid #1a3a1a;border-radius:6px;padding:8px 14px;max-width:540px;margin-left:auto;margin-right:auto">âŹł Tour juĹĽ dziĹ› wziÄ™ty. WrĂłÄ‡ jutro.</div>`:`
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin:8px auto 14px;max-width:540px">
      ${tours.map(t=>{const blocked=G.money<t.cost||(G.energy||0)<15;return `<button onclick="window._heliTour('${t.id}')" ${blocked?'disabled':''} style="background:${blocked?'#0a0a0a':'#2a1f0a'};border:1px solid ${blocked?'#222':'#f1c40f'};color:${blocked?'#444':'#fff'};padding:12px;cursor:${blocked?'not-allowed':'pointer'};border-radius:8px;font-family:inherit;font-size:12px;text-align:left">
        <b>${t.label}</b><br>
        <span style="font-size:10px;color:#aaa">${t.desc}</span><br>
        <span style="font-size:10px;color:#c8a520">${t.cost.toLocaleString('pl')} zĹ‚ Â· +${t.fame} sĹ‚awy Â· +${t.followers} obs.</span>
      </button>`;}).join('')}
    </div>`}
    <div style="text-align:center"><button onclick="closeOverlay()" class="cbtn">â† Anuluj</button></div>
  `;
  window._heliGoto=(id)=>{
    const d=dests.find(x=>x.id===id);
    if(d&&d.fn)d.fn();
  };
  window._heliTour=(id)=>{
    const t=tours.find(x=>x.id===id);
    if(!t) return;
    if(G._lastHeliTourDay===G.day){if(typeof showMsg==='function')showMsg('đźš JuĹĽ dziĹ› braĹ‚eĹ› tour. WrĂłÄ‡ jutro.','r');return;}
    /* Loyalty discount: 6+ tours = -20% */
    const finalCost=((G._heliTours||0)>=5)?Math.floor(t.cost*0.80):t.cost;
    if(G.money<finalCost){if(typeof showMsg==='function')showMsg('Brak kasy na tour!','r');return;}
    if((G.energy||0)<15){if(typeof showMsg==='function')showMsg('âšˇ Za maĹ‚o energii (potrzeba 15).','r');return;}
    G.money-=finalCost;
    if(typeof spent==='function') spent(finalCost);
    G.energy=Math.max(0,G.energy-15);
    if(typeof gameMin==='number') gameMin+=30;
    G._lastHeliTourDay=G.day;
    G._heliTours=(G._heliTours||0)+1;
    if(typeof addFame==='function') addFame(t.fame); else G.fame=clamp((G.fame||0)+t.fame,0,500);
    G.followers=(G.followers||0)+t.followers;
    if(typeof addFans==='function') addFans(t.fans);
    if(typeof addXP==='function') addXP(t.xp);
    closeOverlay();
    if(typeof showMsg==='function') showMsg(`đźš ${t.label} ukoĹ„czony! +${t.fame} sĹ‚awy, +${t.followers} obs., +${t.fans} fanĂłw`,'g',5000);
    if(typeof confetti==='function') confetti(20);
    /* Achievement check â€” Pilot's Wings (5 tours) */
    if((G._heliTours||0)===5 && typeof showMsg==='function') showMsg('đźŹ† Pilot Marek: "StaĹ‚y klient! NastÄ™pny tour ze zniĹĽkÄ… 20%." (Easter egg discount na 6+ tour aktywny)','g',6000);
    if(typeof saveGameSilent==='function') saveGameSilent();
  };
  openOverlay();
}

