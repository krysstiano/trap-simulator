function openCookingMenu(){
  /* v2.1.123: Wave 5 W49 â€” absolute timestamp cooldown (gameMin wraps przy G.day++, przy 240min cooldown moĹĽe permanent lock). */
  const nowAbs=(G.day||1)*1440 + (gameMin||0);
  const lastCookAbs=G._lastCookAbs||-9999;
  if(nowAbs-lastCookAbs<240){
    const minLeft=Math.ceil(240-(nowAbs-lastCookAbs));
    showMsg(`đź”Ą PĹ‚yta jeszcze gorÄ…ca â€” odpocznij ${minLeft} min (gry)`,'r');
    return;
  }
  if(!G.pantry) G.pantry={};
  const skill=G.skills?.cooking||0;
  const pantry=G.pantry;
  const recipesHtml=HOME_RECIPES.map(r=>{
    const skillOk=skill>=r.skill;
    const ingOk=Object.entries(r.need).every(([k,v])=>(pantry[k]||0)>=v);
    const energyOk=(G.energy||0)>=r.energy;
    const canCook=skillOk&&ingOk&&energyOk;
    const ingList=Object.entries(r.need).map(([k,v])=>{
      const have=pantry[k]||0;
      const ing=HOME_INGREDIENTS.find(i=>i.id===k);
      const col=have>=v?'#7ec87e':'#e07070';
      return `<span style="color:${col}">${ing.em}${v}</span>`;
    }).join(' Â· ');
    const skillBadge=skillOk?'':`<span style="color:#e74c3c;font-size:11px"> đź”’ Skill ${r.skill}</span>`;
    const energyBadge=energyOk?'':`<span style="color:#e74c3c;font-size:11px"> âšˇ-${r.energy}</span>`;
    return `<div style="background:#0a1525;border:1px solid ${canCook?'#27ae60':'#2a3a50'};border-radius:8px;padding:12px;margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <div style="font-weight:700;color:#fff">${r.em} ${r.name}</div>
        <div style="font-size:11px;color:#778">Tier ${r.tier} Â· Skill ${r.skill}+ Â· âšˇ-${r.energy} Â· ${r.time}min${skillBadge}${energyBadge}</div>
      </div>
      <div style="font-size:12px;color:#aaa;margin-bottom:6px">SkĹ‚adniki: ${ingList}</div>
      <div style="font-size:11px;color:#7ec87e">+${r.hunger} gĹ‚Ăłd Â· +${r.health} zdrowie Â· +${r.stress} nastrĂłj Â· +${r.xp} XP Â· âšˇ zwrot energii (przy mistrzu +1 forma!)</div>
      <button class="bbtn" onclick="startCookingMG('${r.id}')" ${canCook?'':'disabled'} style="width:100%;margin-top:8px;${canCook?'':'opacity:.4'}">${canCook?'đź”Ą Gotuj':'đźš« NiedostÄ™pne'}</button>
    </div>`;
  }).join('');
  const pantryHtml=HOME_INGREDIENTS.map(i=>{
    const q=pantry[i.id]||0;
    return `<span style="background:#0a1220;border:1px solid #1a2535;border-radius:5px;padding:4px 8px;font-size:12px;color:${q>0?'#fff':'#556'}">${i.em} ${i.name}: <b>${q}</b></span>`;
  }).join(' ');
  document.getElementById('ov-content').innerHTML=`
    <h2>đź”Ą PĹ‚yta indukcyjna â€” Gotowanie</h2>
    <p class="sub">Wybierz przepis. SkĹ‚adniki kupisz w đź›’ sklepie spoĹĽywczym lub đźŹŞ na targu. Skill cooking: ${skill}/5</p>
    <div style="background:#0a1525;border-radius:8px;padding:10px;margin-bottom:14px;font-size:11px">
      <div style="color:#f1c40f;font-weight:700;margin-bottom:6px">đź“¦ SpiĹĽarnia:</div>
      <div style="display:flex;flex-wrap:wrap;gap:5px">${pantryHtml}</div>
    </div>
    <div style="max-height:380px;overflow-y:auto">${recipesHtml}</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>`;
  openOverlay();
}
function startCookingMG(recId){
  const rec=HOME_RECIPES.find(r=>r.id===recId);
  if(!rec) return;
  if(!G.pantry) G.pantry={};
  // v1.8.54: walidacja â€” odrzuÄ‡ start jeĹ›li brakuje skĹ‚adnikĂłw (zapobiega ujemnemu pantry przy edge case)
  for(const [k,v] of Object.entries(rec.need)){
    if((G.pantry[k]||0) < v){
      if(typeof showMsg==='function') showMsg('âťŚ Brak skĹ‚adnikĂłw do tego przepisu','r');
      return;
    }
  }
  // Pobierz skĹ‚adniki (v1.9.47: cleanup pantry ĹĽeby uniknÄ…Ä‡ stale negative entries â€” audyt pantry)
  for(const [k,v] of Object.entries(rec.need)){
    G.pantry[k]=(G.pantry[k]||0)-v;
    if(G.pantry[k]<=0) delete G.pantry[k];
  }
  G.energy=Math.max(0,(G.energy||0)-rec.energy);
  closeOverlay();
  // Minigra timing â€” przekrÄ™Ä‡ pokrÄ™tĹ‚o ĹĽeby trafiÄ‡ w zielone strefy
  const panel=document.getElementById('mg-job');panel.style.display='';panel.classList.add('on');
  if(!document.getElementById('mg-job-content'))panel.innerHTML='<div id="mg-job-content"></div>';
  let phase=0,score=0,attempts=0;
  const TOTAL_PHASES=4; // 4 etapy gotowania
  const phases=['Rozgrzej patelniÄ™','Dodaj skĹ‚adniki','Mieszaj','Doprawiaj'];
  function renderPhase(){
    if(phase>=TOTAL_PHASES){finishCook();return;}
    const goalPos=20+Math.random()*60; // gdzie green zone (20-80%)
    const goalW=12+Math.max(0,(5-rec.skill))*2; // szerokoĹ›Ä‡ zone â€” Ĺ‚atwiejsze przy niskim skillu
    let pos=0,dir=1.2,active=true;
    panel.innerHTML=`
      <div style="padding:24px;text-align:center;max-width:520px">
        <div style="font-size:18px;color:#e91e8c;font-weight:700;margin-bottom:6px">${rec.em} ${rec.name}</div>
        <div style="font-size:14px;color:#aaa;margin-bottom:14px">Etap ${phase+1}/${TOTAL_PHASES}: <b>${phases[phase]}</b></div>
        <div style="background:#0a1018;border:2px solid #2a3a50;border-radius:10px;padding:18px;margin-bottom:14px">
          <div id="cook-bar" style="position:relative;width:100%;height:32px;background:#0a0a14;border-radius:6px;overflow:hidden">
            <div style="position:absolute;left:${goalPos}%;width:${goalW}%;height:100%;background:linear-gradient(90deg,#1a5a1a,#27ae60,#1a5a1a);border-radius:4px"></div>
            <div id="cook-cursor" style="position:absolute;left:0%;top:-4px;width:6px;height:40px;background:#f1c40f;box-shadow:0 0 12px #f1c40f"></div>
          </div>
          <div style="margin-top:14px;color:#778;font-size:12px">SPACJA gdy ĹĽĂłĹ‚ta linia trafi w zielone</div>
          <div style="margin-top:8px;font-size:14px">Score: <b id="cook-score" style="color:#f1c40f">${score}</b> / ${TOTAL_PHASES*10}</div>
        </div>
        <button class="cbtn" onclick="window._cookQuit()">Przerwij (utrata skĹ‚adnikĂłw)</button>
      </div>`;
    const cursor=document.getElementById('cook-cursor');
    const tick=setInterval(()=>{
      if(!active) return;
      pos+=dir; if(pos>100||pos<0){dir=-dir;pos=Math.max(0,Math.min(100,pos));}
      if(cursor) cursor.style.left=pos+'%';
    },18);
    const handler=(e)=>{
      if(!active) return;
      if(e.key===' '){
        e.preventDefault();
        active=false;clearInterval(tick);
        const hit=pos>=goalPos&&pos<=goalPos+goalW;
        if(hit){score+=10;}
        else{score+=Math.max(0,5-Math.abs(pos-(goalPos+goalW/2))/8);}
        document.getElementById('cook-score').textContent=Math.floor(score);
        document.removeEventListener('keydown',handler);
        phase++;
        setTimeout(renderPhase,400);
      }
    };
    document.addEventListener('keydown',handler);
    window._cookQuit=()=>{active=false;clearInterval(tick);document.removeEventListener('keydown',handler);panel.classList.remove('on');panel.innerHTML='';notify('đźš« PrzerwaĹ‚eĹ› gotowanie. SkĹ‚adniki zmarnowane.');};
  }
  function finishCook(){
    /* v2.1.105: Cooking SKILL_DEF â€” PU/Evo aplikowane (Wave 8 K78).
       PU1 Mistrz Patelni: +8% reward scale per PU (max +24% przy PU3 â€” ~"+25% accuracy" feel)
       PU2 Knajpa MistrzĂłw: +33% chance na +1 skill bonus per PU (max ~+100% gain)
       PU3 Chef de Cuisine: +33% energy refund per PU (max +100%)
       Evo Master Chef: +1 forma przy accuracy >= 85% (osobno od fitness +1) */
    const _cookPU=(typeof _pu==='function')?_pu('cooking'):0;
    const _cookEvo=(typeof _evo==='function')?_evo('cooking'):false;
    const accuracy=Math.min(1,score/(TOTAL_PHASES*10));
    const grade=accuracy>=0.85?'â­ MISTRZOWSKI':accuracy>=0.65?'đź‘Ť Dobry':accuracy>=0.4?'đź Zjadliwy':'đź¬ Spalony';
    // v1.9.17: Nagrody skalowane przez accuracy. Floor 0.4â†’0.1 (Spalony = 10% nie 40% â€” wczeĹ›niej 0-40% accuracy dawaĹ‚o te same rewards).
    // v2.1.105: PU1 Mistrz Patelni â€” buff reward scaling (Ă—1 + PUĂ—0.08)
    const _puRewardMult=1+_cookPU*0.08;
    const eat=v=>Math.floor(v*Math.max(0.1,accuracy)*_puRewardMult);
    G.hunger=eatFood(eat(rec.hunger));
    G.health=Math.min(getMaxStat('health'),(G.health||0)+eat(rec.health));
    G.stress=Math.min(100,(G.stress||0)+eat(rec.stress));
    /* v2.1.26: XP przywrĂłcone z capem (1Ă— na minutÄ™ real + tylko gdy gracz NIE przejedzony) */
    addXPFoodCapped(eat(rec.xp));
    // BONUS gotowania: zwrot czÄ™Ĺ›ci energii + bonus formy przy mistrzowskim wykonaniu
    // F3-FIX: DIETA skill bonus +5%/pkt energii z jedzenia (max +15%)
    // v2.1.105: PU3 Chef de Cuisine â€” +33% energy refund per PU (max +100% przy PU3)
    const _enerBack=Math.round((rec.energy*0.6+8*accuracy)*getDietaEnergyBonus()*(1+_cookPU*0.33));
    G.energy=Math.min(getMaxStat('energy'),(G.energy||0)+_enerBack);
    // v1.9.17: gameMin advance â€” recipe.time wczeĹ›niej deklarowane ale nigdy nie uĹĽywane
    if(rec.time && typeof gameMin==='number') gameMin+=rec.time;
    if(accuracy>=0.85){
      /* v2.1.191: ghost cap fix â€” respektuj getMaxStat('fitness') ĹĽeby Evo Dieta/Bieg max+5/+10 NIE byĹ‚y wasted. */
      G.fitness=Math.min(getMaxStat('fitness'),(G.fitness||0)+1);
      /* v2.1.105: Evo Master Chef â€” +1 forma przy mistrzowskim posiĹ‚ku (kumulacja z bench) */
      if(_cookEvo){
        G.forma=Math.min(getMaxStat('forma'),(G.forma||0)+1);
      }
    }
    // Skill roĹ›nie tylko przy sukcesie (>=65%)
    // v1.9.17: uĹĽyj base G.skills.cooking zamiast getSkillLvl (PU stacking mĂłgĹ‚ skakaÄ‡ 2-3 lvl naraz lub stall na 5)
    if(accuracy>=0.65){
      G.skills=G.skills||{};
      /* v2.1.105: PU2 Knajpa MistrzĂłw â€” szansa na +1 dodatkowego skilla (max ~+100% przy PU3) */
      let _skillGain=1;
      if(_cookPU>0 && Math.random()<_cookPU*0.33) _skillGain=2;
      G.skills.cooking=Math.min(5,(G.skills.cooking||0)+_skillGain);
    }
    // v1.9.17: tracker dla osiÄ…gniÄ™Ä‡ (mistrz_gotowania)
    G._cooksMade=(G._cooksMade||0)+1;
    if(accuracy>=0.85) G._cooksPerfect=(G._cooksPerfect||0)+1;
    G._lastCookMin=gameMin||0;G._lastCookAbs=(G.day||1)*1440 + (gameMin||0); /* v2.1.123: W49 absolute timestamp */
    progressQuest('eat');
    panel.innerHTML=`
      <div style="padding:30px;text-align:center;max-width:480px">
        <div style="font-size:48px;margin-bottom:8px">${rec.em}</div>
        <div style="font-size:24px;color:#f1c40f;font-weight:900;margin-bottom:6px">${grade}</div>
        <div style="font-size:16px;color:#aaa;margin-bottom:14px">${rec.name} Â· ${Math.round(accuracy*100)}% jakoĹ›ci</div>
        <div style="background:#0a1018;padding:12px;border-radius:8px;text-align:left;margin-bottom:16px">
          <div style="color:#7ec87e;margin-bottom:4px">+${eat(rec.hunger)} gĹ‚Ăłd</div>
          <div style="color:#7ec87e;margin-bottom:4px">+${eat(rec.health)} zdrowie</div>
          <div style="color:#7ec87e;margin-bottom:4px">+${eat(rec.stress)} nastrĂłj</div>
          <div style="color:#7ec87e">+${eat(rec.xp)} XP${accuracy>=0.65?' Â· đźŽŻ +1 skill cooking':''}</div>
        </div>
        <button class="cbtn" onclick="document.getElementById('mg-job').classList.remove('on');document.getElementById('mg-job').innerHTML='';">â† Smacznego!</button>
      </div>`;
  }
  renderPhase();
}
window.startCookingMG=startCookingMG;
window.openCookingMenu=openCookingMenu;

