function togglePhone(){
  const ph=document.getElementById('phone');
  // v1.9.15: NIE otwieraj telefonu w trakcie minigry (np. koncert kontynuowaĹ‚ siÄ™ gdy gracz przeglÄ…daĹ‚ Spotify)
  if(!ph.classList.contains('on') && typeof mgOpen==='function' && mgOpen()){
    if(typeof showMsg==='function') showMsg('đź“± SkoĹ„cz aktualnÄ… aktywnoĹ›Ä‡ najpierw','r');
    return;
  }
  if(ph.classList.contains('on')) closePhone();
  else{ph.classList.add('on');renderPhoneHome();
    if(!G._tutStat)G._tutStat={};G._tutStat.phoneOpened=(G._tutStat.phoneOpened||0)+1;
    /* v1.8.50/v1.9.23: zdejmij czerwonÄ… kropkÄ™ "nowe powiadomienia" gdy gracz otworzyĹ‚ telefon â€” z guard re-evaluation jeĹ›li SMS LUB notifs dalej unread (v2.1.182 Agent phone audit: notifsUnread teĹĽ brane pod uwagÄ™) */
    const _hp=document.getElementById('hphone'); if(_hp){_hp.classList.remove('has-new'); setTimeout(()=>{if((G.sms?.unread||0)>0||(G.notifsUnread||0)>0)_hp.classList.add('has-new');},100);}
  }
}
function closePhone(){document.getElementById('phone').classList.remove('on');}
function phoneOpen(){return document.getElementById('phone').classList.contains('on');}

