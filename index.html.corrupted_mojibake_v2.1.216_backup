function checkStoryline(){
  if(!G.mainQuest) G.mainQuest={currentStep:0,completed:[]};
  /* v2.1.123: Wave 8 W80 â€” storyline soft-lock fix. Po Prestige `mainQuestStartDay` ustawione na dzieĹ„ prestige, quest checks wymagajÄ… minimum 2 dni od resetu (gracz nie zalicza wszystkiego automatycznie z persisted fans/followers). */
  if(G.mainQuest._startDay && (G.day - G.mainQuest._startDay) < 2 && G.mainQuest.currentStep < 5){
    /* Pierwsze 5 questĂłw wymaga 2 dni przerwy po Prestige â€” anti soft-lock */
    checkSideStorylines();return;
  }
  const step=G.mainQuest.currentStep;
  if(step>=STORYLINE_QUESTS.length){checkSideStorylines();return;}
  const q=STORYLINE_QUESTS[step];
  if(q.check()){
    G.mainQuest.completed.push(q.id);
    G.mainQuest.currentStep++;
    /* v1.9.33: BUG FIX storyline reward â€” money przez earn() (Prestige moneyMult), fame przez addFame() (Prestige fameMult). WczeĹ›niej direct G.money+=/G.fame+= bypassowaĹ‚o prestige bonus. */
    if(q.reward.money){if(typeof earn==='function')earn(q.reward.money,true); else {G.money+=q.reward.money;G.totalEarned=(G.totalEarned||0)+q.reward.money;}}
    if(q.reward.fame){if(typeof addFame==='function')addFame(q.reward.fame); else G.fame=clamp(G.fame+q.reward.fame,0,500);}
    if(q.reward.xp) addXP(q.reward.xp);
    if(q.reward.skillPts) G.skillPoints=(G.skillPoints||0)+q.reward.skillPts;
    confetti(40);
    /* v2.1.175: dĹ‚uĹĽszy + wiÄ™kszy notification dla storyline â€” user reported "nie zaliczyĹ‚ siÄ™" mimo ĹĽe logika dziaĹ‚a (showMsg domyĹ›lny 3s mogĹ‚y byÄ‡ przeoczone podczas minigame end). */
    showMsg(`đźŽŻ STORYLINE! ${q.em} ${q.name} â€” wykonane! Nagroda: +${q.reward.money||0} zĹ‚, +${q.reward.fame||0} sĹ‚awy${q.reward.skillPts?', +'+q.reward.skillPts+' pkt skill':''}`,'g',6000);
    addNotif(`${q.em} STORYLINE: ${q.name} âś“`);
    showGain(`âś“ ${q.name}`,'#f1c40f');
  }
  checkSideStorylines();
}

