    if(typeof renderMusicShop==='function') renderMusicShop();
  };
  if(typeof gameConfirm==='function'){gameConfirm(`SprzedaÄ‡ "${m.name}" za ${refund.toLocaleString('pl')} zĹ‚ (50% ceny zakupu)?`,_doSell);}
  else _doSell();
};
