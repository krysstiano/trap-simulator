        };
        const labelKey=p.label.split(' ').slice(0,2).join(' ');
        let cov=null;
        for(const k of Object.keys(coverColors)){if(p.label.startsWith(k)||p.label.includes(k.split(' ')[1])){cov=coverColors[k];break;}}
        if(!cov) cov=['#3a2a4a','#1a1525','đź“·'];
        // Sample komentarze fanĂłw (deterministyczne na p.day, max 2 widoczne)
        const allComments=[
          {n:'@fan_'+G.day,t:'Goat đź'},
          {n:'@trapsoul',t:'CzekaĹ‚em na to!'},
          {n:'@beatlover',t:'Numer ognia đź”Ą'},
          {n:'@miastoraps',t:'W koĹ„cu coĹ› dobrego'},
          {n:'@mc_random',t:'Daj wiÄ™cej!'},
          {n:'@hejter_xx',t:'SĹ‚abe.'},
          {n:'@vibe_only',t:'Vibez âś¨'},
        ];
        const visibleComments=Math.min(p.comments||0,2);
        const sampleC=allComments.slice(0,visibleComments);
        return`<div style="background:#0a1220;border-radius:10px;margin-bottom:8px;border:1px solid ${growing?'#3a2010':'#0a1a30'};overflow:hidden">
          <!-- Header â€” avatar + handle -->
          <div style="display:flex;align-items:center;gap:8px;padding:8px 10px;border-bottom:1px solid #0a1a30">
            <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#c13584,#fd1d1d,#fcb045);display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:900">${(G.name||'?')[0].toUpperCase()}</div>
            <div style="flex:1;min-width:0">
              <div style="font-size:12px;color:#fff;font-weight:700">@${(G.name||'user').toLowerCase()}</div>
              <div style="font-size:10px;color:#667">Dz.${p.day}</div>
            </div>
          </div>
          <!-- Image â€” gradient cover -->
          <div style="height:90px;background:linear-gradient(135deg,${cov[0]},${cov[1]});display:flex;align-items:center;justify-content:center;font-size:42px;position:relative">
            <span style="text-shadow:0 2px 8px rgba(0,0,0,.6)">${cov[2]}</span>
            ${growing?`<span style="position:absolute;top:6px;right:8px;background:rgba(241,196,15,.85);color:#000;font-size:9px;font-weight:900;padding:2px 6px;border-radius:8px">âŹł ROĹšNIE</span>`:''}
          </div>
          <!-- Caption -->
          <div style="padding:8px 10px;font-size:12px;color:#ccc">${p.label}</div>
          <!-- Stats: likes/comments -->
          <div style="padding:0 10px 6px;font-size:11px;color:#c13584;display:flex;gap:10px">
            <span>âť¤ď¸Ź ${p.likes||0}</span>
            <span>đź’¬ ${p.comments||0}</span>
            ${growing?'':`<span style="color:#27ae60">âś… +${p.pendingFollowers||0} fanĂłw</span>`}
          </div>
          ${sampleC.length>0?`<div style="padding:0 10px 8px;border-top:1px solid #0a1a30;padding-top:6px">
            ${sampleC.map(c=>`<div style="font-size:10px;color:#aaa;margin-top:3px"><b style="color:#c13584">${c.n}</b> ${c.t}</div>`).join('')}
          </div>`:''}
        </div>`;}).join('')}
    </div>`;
    window.igPost=(idx)=>{
      const cat=postCats[idx];
      if(cat.req&&!cat.req()) return;
      /* v1.9.21: BUG FIX guard limit dziennych postĂłw (poprzednio funkcja nie sprawdzaĹ‚a, tylko UI button gating) */
      const _maxPostsRT=(typeof getRaperST==='function' && getRaperST('autopromocja')>=2)?2:1;
      if(G._igPostDay!==G.day){G._igPostDay=G.day;G._igPostCount=0;}
      if((G._igPostCount||0)>=_maxPostsRT){if(typeof showMsg==='function')showMsg('đź“¸ DziĹ› juĹĽ opublikowaĹ‚eĹ› maksymalnÄ… liczbÄ™ postĂłw. WrĂłÄ‡ jutro.','r');return;}
      G.lastIGPostDay=G.day;
      G._igPostCount=(G._igPostCount||0)+1;
      G.energy=clampStat('energy', G.energy-cat.cost.energy);
      const formaBonus=1+(G.forma||0)*0.005;
      const autoSTMult=1+(getRaperST('autopromocja')>=1?0.10:0)+(getRaperST('autopromocja')>=3?0.15:0)+(getRaperST('autopromocja')>=5?0.15:0); /* v1.9.45: Autopromocja 5 +15% (poprzednio cap przy lvl 3) */
      // F3-FIX-B: FOTO skill + INFLUENCER bonus (skill+PU+evo)
      const follGain=Math.floor(cat.bonus.followers*getKarieraBonus('influencer')*formaBonus*autoSTMult*getFotoQualityBonus());
      G.careers.influencer.posts=(G.careers.influencer.posts||0)+1;
      // Track boost â€” Zadanie #31
      if(cat.trackBoost&&latestTrack){
        const streamBoost=Math.floor(latestTrack.streams*0.20+G.followers*0.05*(1+(G.drip||0)*0.01));
        latestTrack.streams=(latestTrack.streams||0)+streamBoost;
        G.spotify.streams=(G.spotify.streams||0)+streamBoost;
        addNotif(`đźŽ¶ Post promuje "${latestTrack.name}": +${streamBoost} streamĂłw`);
      }
      if(!G.igPosts) G.igPosts=[];
      G.igPosts.push({
        label:cat.label,likes:0,comments:0,day:G.day,
        growStage:0,maxLikes:rnd(20,600)+Math.floor(G.followers*.015),
        maxComments:rnd(3,60),pendingFollowers:follGain,pendingFame:cat.bonus.fame,followersAdded:false
      });
      /* v1.9.45: cap igPosts na 150 wpisĂłw (audyt instagram â€” unbounded growth ryzyko save bloat) */
      if(G.igPosts.length>150) G.igPosts.shift();
      addXP(5);progressQuest('post');
      notify(`đź“¸ Post wrzucony! Sprawdzaj reakcje w telefonie...`);
      renderPhoneApp('instagram');
    };
  } else if(app==='twitter'){
    // Dynamiczne tweety na podstawie stanu gry
    /* v2.1.35: pokazuj feed dopiero po pierwszym tweet'cie gracza. Nowa gra = brak wpisĂłw. */
    const tweets=[];
    const hasTweeted=(G.lastTweetDay||0)>0;
    if(hasTweeted){
      const latestTrack=(G.studioTracks||[]).slice(-1)[0];
      const raperLvl=G.careers.raper?G.careers.raper.level:0;
      if(G.followers>=10000) tweets.push(`${G.followers.toLocaleString('pl')} obserwujÄ…cych đź¤Ż Nie mogÄ™ w to uwierzyÄ‡! DziÄ™kujÄ™ wszystkim! âť¤ď¸Ź #${Math.floor(G.followers/1000)}K`);
      else if(G.followers>=1000) tweets.push(`${G.followers.toLocaleString('pl')} followersĂłw! WkrĂłtce 10K đź”Ą #grind #muzyka`);
      else tweets.push(`KaĹĽdy zaczyna od zera. RosnÄ™ powoli. WkrĂłtce zobaczycie đź’Ş #grinding`);
      if(G.events.performed>0) tweets.push(`Koncert ${G.events.performed===1?'zaliczony':'numer '+G.events.performed}! Publika byĹ‚a ogieĹ„ đźŽ¤đź”Ą DziÄ™kujÄ™ za obecnoĹ›Ä‡!`);
      else tweets.push(`PracujÄ™ nad pierwszym koncertem... WkrĂłtce! Trzymajcie siÄ™ đź‘€`);
      if(latestTrack) tweets.push(`Nowy singiel "${latestTrack.name}" juĹĽ online đźŽµ Streamujcie i udostÄ™pniajcie! #nowoĹ›Ä‡ #rap`);
      else tweets.push(`Studio session đźŽ§ Nagrania idÄ… Ĺ›wietnie. Niebawem premiera đź”Ą #studio`);
      if(G.yt.subs>0) tweets.push(`KanaĹ‚ roĹ›nie! ${G.yt.subs.toLocaleString('pl')} subĂłw đź“ş Nowy film juĹĽ niedĹ‚ugo #YouTube`);
      if(G.spotify.listeners>0) tweets.push(`${G.spotify.listeners.toLocaleString('pl')} sĹ‚uchaczy miesiÄ™cznie na Spotify đźŽµ DziÄ™kujÄ™ za support!`);
      if(raperLvl>=3) tweets.push(`Lata pracy dajÄ… efekty. Nikt nie wyobraĹĽa sobie ile w to wĹ‚oĹĽyĹ‚em đź’Ż #raper #poziom${raperLvl}`);
      if(G.streetRep>=50) tweets.push(`Ulica mĂłwi sama za siebie. Rep: ${G.streetRep}% đźŹ† #streetcred`);
      if(G.money>=5000) tweets.push(`CiÄ™ĹĽka praca + mÄ…dre decyzje = efekty đź’° Nie zatrzymujÄ™ siÄ™ #grind`);
      if(G.careers.raper&&G.careers.raper.freestyles>0) tweets.push(`${G.careers.raper.freestyles} freestylĂłw za mnÄ… đźŽ¤ KaĹĽdy byĹ‚ lepszy od poprzedniego. Na ulicy uczysz siÄ™ najszybciej!`);
      // UzupeĹ‚nij do min. 4 tweetĂłw ogĂłlnymi
      const generic=[
        `DzieĹ„ ${G.day} i wciÄ…ĹĽ na nogach đź’Ş #motivation`,
        `Muzyka to nie praca â€” to pasja. Nie zapomnijcie o tym đźŽµ`,
        `Wiem jedno: siÄ™ nie poddajÄ™ đź”Ą #rapper #grind`,
      ];
      for(const g of generic){if(tweets.length<4)tweets.push(g);}
    }
    const canTweet=G.day!==(G.lastTweetDay||0);
    // #43 batch 2: Twitter UI rebuild jak prawdziwy Twitter â€” profile header, verified, tweet cards z replies
    const handle=G.name.toLowerCase().replace(/\s/g,'_');
    const initial=(G.name||'?')[0].toUpperCase();
    const verified=G.followers>=1000;
    ph.innerHTML=`<div class="ph-screen">
      <!-- Profile header (Twitter-style banner + avatar) -->
      <div style="background:linear-gradient(135deg,#0a1a2a,#1a2a3a);border-radius:10px;overflow:hidden;margin-bottom:10px;border:1px solid #1da1f230">
        <!-- Banner -->
        <div style="height:50px;background:linear-gradient(135deg,#1da1f2,#0a3a5a);position:relative">
          <!-- Avatar overlap -->
          <div style="position:absolute;bottom:-22px;left:14px;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#1da1f2,#0d8bd9);border:3px solid #050f1c;display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:900">${initial}</div>
        </div>
        <!-- Profile info -->
        <div style="padding:30px 14px 12px">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px">
            <div style="font-size:17px;color:#fff;font-weight:900">${G.name}</div>
            ${verified?`<span title="Zweryfikowany â€” 1k+ obserwujÄ…cych" style="color:#1da1f2;font-size:14px">âś“</span>`:''}
          </div>
          <div style="font-size:12px;color:#778;margin-bottom:8px">@${handle}</div>
          <div style="font-size:12px;color:#aaa;line-height:1.4;margin-bottom:8px">đźŽ¤ ChĹ‚opak z ulicy. ${G.fame>=20?'SĹ‚ychaÄ‡ o mnie w mieĹ›cie.':'BudujÄ™ markÄ™.'}${G.label.type?' Â· đźŽĽ '+G.label.type:''}</div>
          <div style="display:flex;gap:14px;font-size:12px;color:#aaa">
            <span><b style="color:#fff">${G.followers.toLocaleString('pl')}</b> ObserwujÄ…cy</span>
            <span><b style="color:#fff">${(G._twitterFollowing||0).toLocaleString('pl')}</b> Obserwowani</span>
          </div>
        </div>
      </div>
      ${canTweet?`
      <div style="font-size:11px;color:#778;letter-spacing:1px;margin-bottom:6px">đź“ť WYBIERZ TWEET (1/dzieĹ„)</div>
      <div style="display:grid;gap:6px;margin-bottom:10px">
        ${(()=>{
          /* v2.1.35: Twitter z kontekstowymi wymogami â€” gracz moĹĽe tweetowaÄ‡ tylko o tym co faktycznie zrobiĹ‚ */
          const hasTracks=(G.studioTracks||[]).length>0;
          const hasFreestyles=(G.careers?.raper?.freestyles||0)>0;
          const hasGymToday=G._lastGymDay===G.day;
          const hasCar=!!(G.car&&G.car.name);
          const hasHaters=(G.haters||0)>=10;
          const isVerified=(G.followers||0)>=500;
          const tweetTypes=[
            {id:'thoughts',color:'#778',bg:'#0a1220',label:'đź’­ PrzemyĹ›lenia',desc:'Generic post o ĹĽyciu â€” maĹ‚y zasiÄ™g, zawsze dziaĹ‚a',req:null},
            {id:'promo',color:'#1da1f2',bg:'#0a1528',label:'đźŽ¤ Promo muzyki',desc:'Bezpieczne â€” duĹĽy zasiÄ™g jeĹ›li masz tracki',req:hasTracks,reqTxt:'Najpierw nagraj track w studio'},
            {id:'meme',color:'#e91e8c',bg:'#1a0a18',label:'đź‚ Mem o branĹĽy',desc:'15% szans na viral (+200-300)! Inaczej +1-8',req:null},
            {id:'freestyle',color:'#9b59b6',bg:'#15102a',label:'đźŽ™ď¸Ź Po freestylu',desc:'Relacja z ulicy â€” fani lojalni z energiÄ…',req:hasFreestyles,reqTxt:'Najpierw zrĂłb freestyle na ulicy'},
            {id:'gym',color:'#e74c3c',bg:'#1a0a0a',label:'đź’Ş Trening done',desc:'Selfie z siĹ‚owni â€” motywacja, +sĹ‚awa',req:hasGymToday,reqTxt:'Trenuj dziĹ› na siĹ‚owni'},
            {id:'car',color:'#f39c12',bg:'#1a1505',label:'đźš— Auto flex',desc:'PokaĹĽ swoje auto â€” drip + zasiÄ™g',req:hasCar,reqTxt:'Najpierw kup auto'},
            {id:'sponsored',color:'#27ae60',bg:'#0a1f0a',label:'đź’Ľ Sponsorowany post',desc:'+50-200 zĹ‚, mniej obs (1-5). Wymaga 500+ obs.',req:isVerified,reqTxt:'Wymaga 500+ obserwujÄ…cych'},
            {id:'beef',color:'#c0392b',bg:'#1a0808',label:'đź”Ą Diss tweet',desc:'Zaczep konkurencjÄ™ â€” viral 30% (+150), ale +20 hejterĂłw',req:hasHaters,reqTxt:'Najpierw zarĂłb 10+ hejterĂłw'},
            /* v2.1.201 [Amper]: Twitter Battle â€” interaktywny minigame z 3 opcjami odpowiedzi.
               Drip wpĹ‚ywa na success rate (image = wiedza co publika lubi). 50+ haters wymĂłg. */
            {id:'battle',color:'#f39c12',bg:'#1f1505',label:'đźŽŻ Twitter Battle',desc:'Clapback minigame: wybierz najlepszÄ… riposte z 3 opcji. Drip pomaga celowaÄ‡ w gust publiki.',req:(G.haters||0)>=50,reqTxt:'Wymaga 50+ hejterĂłw'},
          ];
          return tweetTypes.map(tt=>{
            const blocked=tt.req!==null && !tt.req;
            return `<button class="bbtn" ${blocked?'disabled':''} onclick="${blocked?'':`window._tweetNow('${tt.id}')`}" style="background:${blocked?'#0a0a0a':tt.bg};border-color:${blocked?'#222':tt.color};color:${blocked?'#444':tt.color};text-align:left;padding:10px;cursor:${blocked?'not-allowed':'pointer'}">
              <b>${tt.label}</b><br>
              <span style="font-size:11px;color:${blocked?'#e74c3c':'#778'}">${blocked?'đź”’ '+tt.reqTxt:tt.desc}</span>
            </button>`;
          }).join('');
        })()}
      </div>`:`<div style="background:#06080f;border:1px solid #0f1f35;border-radius:6px;padding:8px;text-align:center;color:#3a5070;font-size:13px;margin-bottom:10px">âŹł Tweet wrzucony Dz. ${G.lastTweetDay}. NastÄ™pny: Dz. ${G.lastTweetDay+1}+ (idĹş spaÄ‡)</div>`}
      <div style="font-size:11px;color:#1da1f2;letter-spacing:1px;margin-bottom:6px">đź“ś OSTATNIE TWEETY</div>
      ${tweets.length===0?`<div style="background:#06080f;border:1px dashed #1f2f4a;border-radius:8px;padding:18px;text-align:center;color:#556;font-size:12px;line-height:1.5">đź¦ Brak tweetĂłw.<br>WyĹ›lij swĂłj pierwszy tweet powyĹĽej!</div>`:''}
      ${tweets.slice(0,5).map((t,i)=>{
        const replies=rnd(1,20);
        const retweets=rnd(2+i,80+i*10);
        const likes=rnd(10+i*5,Math.max(20,G.followers||100));
        const views=likes*rnd(8,15);
        const dayAgo=i===0?'teraz':i===1?'2h':i+'d';
        return `<div style="background:#0a1220;border-radius:10px;padding:10px 12px;margin-bottom:8px;border:1px solid #0f1f35">
          <!-- Tweet header â€” avatar + name + handle -->
          <div style="display:flex;gap:8px;align-items:flex-start;margin-bottom:6px">
            <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#1da1f2,#0d8bd9);display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;font-weight:900;flex-shrink:0">${initial}</div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:4px;font-size:12px;flex-wrap:wrap">
                <span style="color:#fff;font-weight:700">${G.name}</span>
                ${verified?'<span style="color:#1da1f2">âś“</span>':''}
                <span style="color:#778">@${handle} Â· ${dayAgo}</span>
              </div>
            </div>
          </div>
          <!-- Tweet body -->
          <div style="font-size:13px;color:#ddd;line-height:1.45;margin-bottom:8px;padding-left:44px">${t}</div>
          <!-- Tweet stats â€” Twitter style with icons -->
          <div style="display:flex;gap:18px;font-size:11px;color:#1da1f2aa;padding-left:44px">
            <span title="Komentarze">đź’¬ ${replies}</span>
            <span title="Retweety" style="color:#27ae60aa">â™»ď¸Ź ${retweets}</span>
            <span title="Polubienia" style="color:#e74c3caa">âť¤ď¸Ź ${likes}</span>
            <span title="WyĹ›wietlenia" style="color:#778">đź“Š ${views.toLocaleString('pl')}</span>
          </div>
        </div>`;
      }).join('')}
    </div>`;
    window._tweetNow=(type)=>{
      if(G.day===(G.lastTweetDay||0)){notify('đź¦ JuĹĽ dziĹ› tweetowaĹ‚eĹ› â€” wrĂłÄ‡ jutro');return;}
      // v1.8.18: BUG fix â€” lastTweetDay ustawiane PO walidacji gatingu
      // v2.1.35: dodane typy thoughts/freestyle/gym/car/beef + wymĂłg hasTracks dla promo
      const autoLvl=getRaperST?getRaperST('autopromocja')||0:0;
      let gain=0,money=0,viralChance=0,msg='',fameBonus=0,fanBonus=0,hatersBonus=0;
      if(type==='thoughts'){
        gain=rnd(1,5)+Math.floor((G.followers||0)*0.002);
        msg=`đź’­ Tweet o ĹĽyciu â€” +${gain} obserwujÄ…cych`;
      } else if(type==='promo'){
        if((G.studioTracks||[]).length===0){notify('đźŽ¤ Najpierw nagraj track w studio!');return;}
        gain=Math.floor(rnd(8,20)+(G.followers*0.005)*(1+autoLvl*0.1));
        msg=`đźŽ¤ Promo muzyki! +${gain} obserwujÄ…cych`;
      } else if(type==='meme'){
        viralChance=0.15+autoLvl*0.05;
        if(Math.random()<viralChance){
          gain=200+rnd(0,100);
          msg=`đźš€ VIRAL! TwĂłj mem rozjebaĹ‚ Twittera! +${gain} obserwujÄ…cych!`;
          fameBonus=3;
          confetti(30);
        } else {
          gain=rnd(1,8);
          msg=`đź‚ Mem nie zasiÄ™gnÄ…Ĺ‚ â€” +${gain} obserwujÄ…cych.`;
        }
      } else if(type==='freestyle'){
        if((G.careers?.raper?.freestyles||0)===0){notify('đźŽ™ď¸Ź Najpierw zrĂłb freestyle na ulicy!');return;}
        gain=rnd(10,30);
        fanBonus=rnd(5,20);
        msg=`đźŽ™ď¸Ź Relacja z ulicy â€” +${gain} obserwujÄ…cych, +${fanBonus} fanĂłw lojalnych`;
      } else if(type==='gym'){
        if(G._lastGymDay!==G.day){notify('đź’Ş Trenuj dziĹ› na siĹ‚owni!');return;}
        gain=rnd(8,25);
        fameBonus=1;
        msg=`đź’Ş Selfie z siĹ‚owni â€” +${gain} obserwujÄ…cych, +1 sĹ‚awa`;
      } else if(type==='car'){
        if(!(G.car&&G.car.name)){notify('đźš— Najpierw kup auto!');return;}
        const carBoost=Math.floor((G.car.price||0)/5000);
        gain=rnd(15,40)+carBoost;
        fameBonus=2;
        msg=`đźš— ${G.car.name} flex! +${gain} obserwujÄ…cych, +2 sĹ‚awa`;
      } else if(type==='sponsored'){
        if(G.followers<500){notify('đź’Ľ Sponsored wymaga 500+ obserwujÄ…cych!');return;}
        money=rnd(50,200)+Math.floor(G.followers*0.05);
        gain=rnd(1,5);
        /* v1.9.53: Sponsorowany tweet przez earn() â€” poprzednio direct G.money+= pomijaĹ‚ Prestige */
        if(typeof earn==='function') earn(money,false); else {G.money+=money;G.totalEarned=(G.totalEarned||0)+money;}
        msg=`đź’Ľ Sponsorowany! +${money} zĹ‚, +${gain} obserwujÄ…cych`;
      } else if(type==='beef'){
        if((G.haters||0)<10){notify('đź”Ą Najpierw zarĂłb 10+ hejterĂłw (np. odpowiedz na hejt)!');return;}
        const dissViral=Math.random()<0.30;
        if(dissViral){
          gain=150+rnd(0,100);
          fameBonus=2;
          msg=`đź”Ą DISS rozjebaĹ‚ branĹĽÄ™! +${gain} obserwujÄ…cych, +2 sĹ‚awa`;
          confetti(20);
        } else {
          gain=rnd(5,30);
          msg=`đź”Ą Diss tweet â€” +${gain} obserwujÄ…cych`;
        }
        hatersBonus=20;
      } else if(type==='battle'){
        /* v2.1.201 [Amper]: Twitter Battle â€” interaktywny clapback minigame.
           NIE konsumuje dnia jeszcze â€” modal pyta o odpowiedĹş. Konsumuje w _tweetBattleResolve. */
        if((G.haters||0)<50){notify('đźŽŻ Twitter Battle wymaga 50+ hejterĂłw!');return;}
        if(typeof window._tweetBattleStart==='function') window._tweetBattleStart();
        return;
      } else {
        notify('đź¦ Nieznany typ tweeta');return;
      }
      // dopiero teraz konsumuj dzieĹ„ + energiÄ™
      G.lastTweetDay=G.day;
      G.energy=Math.max(0,G.energy-3);
      G.followers=(G.followers||0)+gain;
      if(fanBonus>0) addFans(fanBonus); /* v2.1.141: Instagram fan bonus */
      if(fameBonus>0){if(typeof addFame==='function')addFame(fameBonus);else G.fame=clamp((G.fame||0)+fameBonus,0,500);}
      if(hatersBonus>0) G.haters=(G.haters||0)+hatersBonus;
      addXP(3);progressQuest('post');
      notify(msg);
      renderPhoneApp('twitter');
    };
    /* v2.1.201 [Amper]: Twitter Battle â€” clapback minigame z drip-influenced success rate */
    window._tweetBattleStart=()=>{
      const haterTweets=[
        `taki raper ĹĽe nawet ulica nie zna đź¤ˇ`,
        `${G.name} przereklamowany. NastÄ™pny đź’€`,
        `${G.name} co Ty robisz na Twitterze? Wracaj do studia đź´`,
        `SĹ‚yszaĹ‚em nowy track ${G.name} â€” instrumentalkÄ™ polecam, vocal nie đź¤˘`,
        `${G.name} pĹ‚acze ĹĽe ma 0 platynowych. Sad! đź¤ˇ`,
        `${G.name} myĹ›li ĹĽe jest kimĹ›. Skille jak u kogoĹ› co dopiero startuje đź¬`,
      ];
      const allResponses=[
        {text:'Czy to ironia? Bo wracam z nowym numerem za tydzieĹ„. Stay tuned đźŽ¤',archetypes:['clever','wise']},
        {text:'CoĹ› wiÄ™cej niĹĽ "skill issue" masz do powiedzenia? Bo ja mam juĹĽ swoje track đź’ż',archetypes:['aggressive']},
        {text:'KaĹĽdy ma prawo do opinii. BudujÄ™ dalej swoim tempem âśŚď¸Ź',archetypes:['wise']},
        {text:'TwĂłj hejt = mĂłj pre-order. Kupuj, sĹ‚ucham na repeat đź’¸',archetypes:['clever']},
        {text:'PokaĹĽ swĂłj track, zobaczymy kto rzÄ…dzi. Czekam... đźŽ™',archetypes:['aggressive','clever']},
        {text:'Mama uczyĹ‚a ignorowaÄ‡ takie. NastÄ™pny đź™Ź',archetypes:['wise']},
        {text:'Bracie, blokujÄ™ CiÄ™. Wracaj jak nauczysz siÄ™ szanowaÄ‡ pracÄ™ đźš«',archetypes:['aggressive','wise']},
        {text:'Statystyki mĂłwiÄ… same â€” moje streamy poszĹ‚y +50% w tygodniu. A Ty? đź“Š',archetypes:['clever']},
      ];
      const haterTweet=haterTweets[Math.floor(Math.random()*haterTweets.length)];
      const shuffled=[...allResponses].sort(()=>Math.random()-0.5);
      const options=shuffled.slice(0,3);
      const archetypes=['clever','aggressive','wise'];
      const audienceLikes=archetypes[Math.floor(Math.random()*archetypes.length)];
      const audienceLabel={clever:'đźŹ Publika czeka na sprytnÄ… odpowiedĹş',aggressive:'đź¤ Publika lubi ostre teksty',wise:'đź§ Publika ceni klasÄ™'}[audienceLikes];
      const _dripV=(G.drip||0);
      const dripHint=_dripV>=200?'âś¨ Drip Master: czujesz publikÄ™ intuicyjnie':_dripV>=100?'âś¨ Drip Trendsetter: dobre wyczucie':_dripV>=50?'đź’ˇ Drip pomaga lekko':'âš ď¸Ź Niski drip â€” zgadujesz w ciemno';
      const ovrId='tweet-battle-overlay';
      let ov=document.getElementById(ovrId);
      if(ov) ov.remove();
      ov=document.createElement('div');
      ov.id=ovrId;
      ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;font-family:inherit';
      ov.innerHTML=`<div style="background:#050f1c;border:2px solid #1da1f2;border-radius:12px;max-width:480px;width:100%;padding:20px;color:#fff;max-height:90vh;overflow-y:auto">
        <div style="font-size:13px;color:#1da1f2;letter-spacing:1px;margin-bottom:8px">đźŽŻ TWITTER BATTLE</div>
        <div style="background:#1a0a0a;border:1px solid #c0392b;border-radius:8px;padding:12px;margin-bottom:14px">
          <div style="font-size:11px;color:#c0392b;margin-bottom:4px">đź”Ą Hejter @random_hater_${rnd(100,9999)}</div>
          <div style="font-size:13px;color:#ddd">${haterTweet}</div>
        </div>
        <div style="background:#0a1528;border:1px solid #f39c12;border-radius:6px;padding:8px 10px;margin-bottom:10px;font-size:11px;color:#f39c12">${audienceLabel}</div>
        <div style="font-size:12px;color:#aaa;margin-bottom:8px">Wybierz najlepszÄ… riposte:</div>
        ${options.map((opt,i)=>`<button onclick="window._tweetBattleResolve(${i},'${audienceLikes}','${opt.archetypes.join(',')}')" style="display:block;width:100%;text-align:left;background:#0a1528;border:1px solid #1da1f2;color:#fff;padding:10px;margin-bottom:6px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px;line-height:1.4">${opt.text}</button>`).join('')}
        <div style="font-size:10px;color:#778;margin-top:8px;text-align:center">${dripHint}</div>
        <button onclick="(function(){var o=document.getElementById('tweet-battle-overlay');if(o)o.remove();})()" style="display:block;width:100%;background:#1a0a0a;border:1px solid #5a1a1a;color:#c0392b;padding:8px;margin-top:8px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px">â† Wycofaj siÄ™ (bez kary)</button>
      </div>`;
      document.body.appendChild(ov);
    };
    window._tweetBattleResolve=(idx,audienceLikes,archetypesCSV)=>{
      const archetypes=archetypesCSV.split(',');
      const ov=document.getElementById('tweet-battle-overlay');if(ov) ov.remove();
      G.lastTweetDay=G.day;
      G.energy=Math.max(0,G.energy-5);
      const matches=archetypes.includes(audienceLikes);
      const _dripV=(G.drip||0);
      const dripBoost=_dripV>=200?0.20:_dripV>=100?0.10:_dripV>=50?0.05:0;
      const success=matches||Math.random()<dripBoost;
      let msg='',gain=0,fameBonus=0,hatersBonus=0,fansBonus=0;
      if(success){
        gain=200+rnd(50,200);
        fansBonus=rnd(25,80);
        fameBonus=4;
        hatersBonus=-10;
        msg=`đź”Ą BATTLE WYGRANY! Publika rzÄ…dzi â€” +${gain} obs., +${fansBonus} fanĂłw, +${fameBonus} sĹ‚awy, -10 hejterĂłw`;
        if(typeof confetti==='function') confetti(40);
      } else {
        gain=rnd(5,20);
        hatersBonus=rnd(25,60);
        msg=`đź’€ Battle przegrany â€” publika nie czuje. +${gain} obs., +${hatersBonus} hejterĂłw`;
      }
      G.followers=(G.followers||0)+gain;
      if(fansBonus>0&&typeof addFans==='function') addFans(fansBonus);
      if(fameBonus>0){if(typeof addFame==='function')addFame(fameBonus);else G.fame=clamp((G.fame||0)+fameBonus,0,500);}
      G.haters=Math.max(0,(G.haters||0)+hatersBonus);
      addXP(8);progressQuest('post');
      if(typeof showMsg==='function') showMsg(msg,success?'g':'r',5000);
      if(typeof renderPhoneApp==='function') renderPhoneApp('twitter');
      if(typeof saveGameSilent==='function') saveGameSilent();
    };
  } else if(app==='bank'){
    const invs=G.bank.investments||[];
    ph.innerHTML=`<div class="ph-screen">
      <div style="background:#0a1a2a;border-radius:8px;padding:14px;margin-bottom:12px">
        <div style="font-size:12px;color:#3498db;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Konto gĹ‚Ăłwne</div>
        <div style="font-size:26px;color:#fff;font-weight:700">${G.money.toLocaleString('pl')} zĹ‚</div>
        ${G.managementDeal?'<div style="font-size:12px;color:#7ec87e;margin-top:4px">MenadĹĽer aktywny: x1.2 zarobki</div>':''}
      </div>
      ${G.bank.loan>0?`<div style="background:#1a0a0a;border-radius:8px;padding:12px;margin-bottom:10px"><div style="color:#e74c3c;font-size:14px">Kredyt: ${G.bank.loan} zĹ‚ do spĹ‚aty</div><button class="bbtn" onclick="repayLoan()" style="margin-top:8px">SpĹ‚aÄ‡ 100 zĹ‚</button></div>`:''}
      <button class="bbtn" onclick="takeLoan()" style="margin-bottom:10px" ${G.bank.loan>0?'disabled':''}>đź’ł WeĹş kredyt (1000 zĹ‚, 1200 zĹ‚ do spĹ‚aty + 1%/dzieĹ„ odsetek)</button> <!-- v2.1.133 -->

      <div style="font-size:12px;color:#27ae60;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">đź“ Inwestycje <span style="color:#667;font-size:10px;letter-spacing:0">(${invs.length}/${BANK_INVEST_MAX} aktywnych)</span></div>
      <button class="bbtn" onclick="invest(1000,3,8)" style="margin-bottom:6px" ${G.money<1000||invs.length>=BANK_INVEST_MAX?'disabled':''}>Zainwestuj 1000 zĹ‚ â†’ 1080 zĹ‚ za 3 dni (+8%)</button>
      <button class="bbtn" onclick="invest(3000,5,15)" style="margin-bottom:10px" ${G.money<3000||invs.length>=BANK_INVEST_MAX?'disabled':''}>Zainwestuj 3000 zĹ‚ â†’ 3450 zĹ‚ za 5 dni (+15%)</button>
      <button class="bbtn" onclick="invest(10000,7,22)" style="margin-bottom:10px" ${G.money<10000||invs.length>=BANK_INVEST_MAX?'disabled':''}>Zainwestuj 10 000 zĹ‚ â†’ 12 200 zĹ‚ za 7 dni (+22%)</button>
      ${invs.length>0?`<div style="background:#0a1a0a;border-radius:8px;padding:10px;margin-bottom:8px">
        <div style="font-size:12px;color:#27ae60;margin-bottom:6px">Aktywne inwestycje:</div>
        ${invs.map(i=>`<div style="font-size:13px;color:#aaa;margin-bottom:4px">đź“ ${i.amount.toLocaleString('pl')} zĹ‚ â†’ ${i.returnAmount.toLocaleString('pl')} zĹ‚ (DzieĹ„ ${i.returnDay})</div>`).join('')}
      </div>`:''}
      <!-- v2.1.120: Wave 6 S51 â€” Bank invest history (totalInvestmentProfit + ostatnie 5 zakoĹ„czonych). -->
      <div style="background:#0a1018;border-radius:8px;padding:10px;margin-top:8px">
        <div style="font-size:11px;color:#7ec8e3;letter-spacing:1px;margin-bottom:6px">đź“ś HISTORIA INWESTYCJI</div>
        <div style="font-size:13px;color:#aaa;margin-bottom:4px">ĹÄ…czny zysk z inwestycji (lifetime): <strong style="color:#27ae60">${(G.bank.totalInvestmentProfit||0).toLocaleString('pl')} zĹ‚</strong></div>
        ${Array.isArray(G.bank.investHistory)&&G.bank.investHistory.length>0?G.bank.investHistory.slice(-5).reverse().map(h=>`<div style="font-size:12px;color:#778;margin-bottom:3px">âś… ${h.amount.toLocaleString('pl')} â†’ ${h.returnAmount.toLocaleString('pl')} zĹ‚ (Dz.${h.returnDay}, zysk +${h.profit||0} zĹ‚)</div>`).join(''):'<div style="font-size:11px;color:#556">Brak zakoĹ„czonych inwestycji.</div>'}
      </div>
    </div>`;
  } else if(app==='bills'){
    if(!G.bills) G.bills={pending:[],history:[],evicted:false};
    const pending=G.bills.pending||[];
    const totalDue=pending.reduce((s,b)=>s+b.amount,0);
    const overdueBills=pending.filter(b=>G.day>b.dueDay);
    ph.innerHTML=`<div class="ph-screen">
      <div style="background:linear-gradient(135deg,#1a0a0a,#0a0a0a);border-radius:10px;padding:14px;margin-bottom:10px;border:1px solid #5a1a1a">
        <div style="font-size:11px;color:#e74c3c;font-weight:700;letter-spacing:1.5px;margin-bottom:6px">đź’¸ RACHUNKI DOMOWE</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:12px">
          <div><div style="color:#778">Aktywne</div><div style="color:#fff;font-weight:700">${pending.length}</div></div>
          <div><div style="color:#778">Po terminie</div><div style="color:${overdueBills.length>0?'#e74c3c':'#27ae60'};font-weight:700">${overdueBills.length}</div></div>
          <div><div style="color:#778">ĹÄ…cznie do zapĹ‚aty</div><div style="color:#f1c40f;font-weight:700">${totalDue} zĹ‚</div></div>
          <div><div style="color:#778">Twoja kasa</div><div style="color:#27ae60;font-weight:700">${G.money} zĹ‚</div></div>
        </div>
      </div>
      ${G.bills.evicted?'<div style="background:#3a0a0a;border:2px solid #e74c3c;border-radius:8px;padding:12px;margin-bottom:10px;font-size:13px;color:#fff">đźš¨ <b>EKSMISJA AKTYWNA</b><br>Aktualnie wrzucony do Traphouse â€” spĹ‚aÄ‡ wszystkie rachunki by wrĂłciÄ‡ do najlepszego posiadanego mieszkania.</div>':''}
      ${pending.length===0?`<div style="background:#0a1a0a;border:1px dashed #2a5a2a;border-radius:8px;padding:14px;text-align:center;color:#7ec87e;font-size:13px">âś… Brak aktywnych rachunkĂłw. Wszystko opĹ‚acone!</div>`:`
      ${pending.length>1?`<button onclick="window.payAllBills()" ${G.money<totalDue?'disabled':''} style="width:100%;background:${G.money>=totalDue?'linear-gradient(135deg,#1a4a2a,#0a3a1a)':'#1a1a1a'};border:1px solid ${G.money>=totalDue?'#27ae60':'#444'};color:${G.money>=totalDue?'#7ec87e':'#556'};padding:10px;border-radius:6px;cursor:${G.money>=totalDue?'pointer':'not-allowed'};font-family:inherit;font-size:13px;font-weight:700;margin-bottom:10px">${G.money>=totalDue?'đź’° ZAPĹAÄ† WSZYSTKIE ('+totalDue+' zĹ‚)':'đź’¸ Brak kasy ('+totalDue+' zĹ‚)'}</button>`:''}
      <div style="font-size:11px;color:#e74c3c;letter-spacing:1px;margin-bottom:6px">đź“‹ DO ZAPĹATY</div>
      <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:10px">
        ${pending.map(b=>{
          const overdue=G.day>b.dueDay;
          const daysToDeadline=b.dueDay-G.day;
          const daysOver=G.day-b.dueDay;
          const statusColor=overdue?'#e74c3c':daysToDeadline<=2?'#f1c40f':'#7ec87e';
          const statusText=overdue?`âš ď¸Ź ${daysOver}d po terminie`:daysToDeadline===0?'âšˇ DZIĹš':`${daysToDeadline}d do terminu`;
          return `<div style="background:#0a0a0a;border:1px solid ${overdue?'#5a1a1a':'#1a2a3a'};border-radius:8px;padding:10px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
              <div style="font-size:13px;color:#fff;font-weight:700">đźŹ  ${b.type} â€” ${CFG.APT_NAMES[b.apt]||b.apt}</div>
              <div style="font-size:14px;color:#f1c40f;font-weight:900">${b.amount} zĹ‚</div>
            </div>
            <div style="font-size:11px;color:${statusColor};margin-bottom:6px">${statusText} Â· wystawiony Dz.${b.issuedDay}</div>
            <button onclick="window.payBill('${b.id}')" ${G.money<b.amount?'disabled':''} style="width:100%;background:${G.money>=b.amount?'#0a3a1a':'#1a1a1a'};border:1px solid ${G.money>=b.amount?'#27ae60':'#444'};color:${G.money>=b.amount?'#7ec87e':'#556'};padding:7px;border-radius:6px;cursor:${G.money>=b.amount?'pointer':'not-allowed'};font-family:inherit;font-size:12px;font-weight:700">${G.money>=b.amount?'đź’° ZapĹ‚aÄ‡ '+b.amount+' zĹ‚':'đź’¸ Brak kasy'}</button>
          </div>`;
        }).join('')}
      </div>`}
      ${G.bills.history?.length>0?(()=>{
        /* v2.1.109: Bills history toggle (Wave 6 N16) â€” domyĹ›lnie 5, klik "PokaĹĽ wszystkie" rozwija peĹ‚nÄ… historiÄ™.
           WczeĹ›niej hard-limit 5 â€” gracz nie widziaĹ‚ starszych zapĹ‚aconych. */
        const _showAll=window._billsHistoryAll||false;
        const _count=G.bills.history.length;
        const _slice=_showAll?G.bills.history:G.bills.history.slice(-5);
        const _btnLabel=_showAll?`â–˛ PokaĹĽ mniej (${_count})`:_count>5?`â–Ľ PokaĹĽ wszystkie (${_count})`:'';
        const _toggleBtn=_count>5?`<button onclick="window._billsHistoryAll=!window._billsHistoryAll;renderPhoneApp('bills')" style="font-size:10px;background:#0a1a30;color:#7ec8e3;border:1px solid #1a3a5a;padding:3px 8px;border-radius:4px;cursor:pointer;margin-bottom:6px;align-self:flex-start">${_btnLabel}</button>`:'';
        return `<div style="font-size:11px;color:#778;letter-spacing:1px;margin-bottom:6px">đź“ś OSTATNIE ZAPĹACONE${_showAll?' (WSZYSTKIE)':''}</div>
      <div style="display:flex;flex-direction:column;gap:4px;max-height:${_showAll?'240px':'auto'};overflow-y:${_showAll?'auto':'visible'}">
        ${_toggleBtn}
        ${_slice.reverse().map(b=>`<div style="background:#050a05;border-radius:5px;padding:5px 8px;font-size:11px;color:#778;display:flex;justify-content:space-between"><span>âś… ${b.type} â€” ${CFG.APT_NAMES[b.apt]||b.apt}</span><span>${b.amount} zĹ‚ Â· Dz.${b.paidDay}</span></div>`).join('')}
      </div>`;
      })():''}
    </div>`;
  } else if(app==='atelier'){
    /* v2.1.216 [Amper]: Atelier app — Tier 4 GOAT exclusive merchant. Crown of Hip-Hop outfit. */
    const _f=G.fame||0;
    const _tier4=_f>=400;
    const _hasCrown=(G.outfit?.top==='crown_of_hh')||G._hasCrownOfHipHop;
    ph.innerHTML=`<div class="ph-screen">
      <div style="font-size:14px;color:#c8a520;font-weight:700;margin-bottom:8px">🎨 ATELIER MAESTRO</div>
      <div style="font-size:11px;color:#aac;margin-bottom:10px;line-height:1.5">Ekskluzywny merchant — tylko dla legend hip-hopu. Unikalne kreacje na zamówienie.</div>
      ${!_tier4 ? `<div style="background:#1a0a14;border:1px solid #5a2a3a;border-radius:6px;padding:10px;color:#c0392b;font-size:12px;margin-bottom:8px">🔒 Dostępne od Tier 4 GOAT (fame 400+). Masz: ${_f}/400</div>` : ''}
      <div style="background:#0a0a14;border:1px solid #c8a520;border-radius:8px;padding:14px;margin-bottom:10px">
        <div style="font-size:48px;text-align:center;margin-bottom:6px">👑</div>
        <div style="font-size:14px;color:#c8a520;font-weight:700;text-align:center;margin-bottom:4px">Crown of Hip-Hop</div>
        <div style="font-size:11px;color:#aaa;text-align:center;margin-bottom:8px;line-height:1.4">Unikalna korona — handmade dla absolutnych legend.<br>Symbol GOAT statusu w grze.</div>
        <div style="font-size:12px;color:#27ae60;text-align:center;margin-bottom:6px">💰 +20% concert earn · 🌟 Status visual</div>
        <div style="font-size:12px;color:#f1c40f;font-weight:700;text-align:center;margin-bottom:8px">💵 100 000 zł</div>
        ${_hasCrown ? '<div style="color:#27ae60;font-size:12px;text-align:center">✅ POSIADASZ</div>' :
          _tier4 ? (G.money>=100000 ? `<button onclick="buyCrownOfHipHop()" style="width:100%;background:#1a1505;border:1px solid #c8a520;color:#c8a520;padding:8px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700">👑 Kup Crown of Hip-Hop</button>` :
          `<div style="color:#c0392b;font-size:11px;text-align:center">💵 Brak kasy (potrzeba 100k zł)</div>`) :
          '<div style="color:#778;font-size:11px;text-align:center">Wymóg: Tier 4 GOAT</div>'}
      </div>
      <div style="font-size:10px;color:#778;text-align:center;margin-top:10px;font-style:italic">"Korona dla tych, którzy ścięli legendy."<br>— Maestro, ekskluzywny stylist</div>
    </div>`;
  } else if(app==='contracts'){
    /* v2.1.214 [Amper]: Sponsor Inbox apka — 6 marek, kontrakty, oferty, historia */
    const _famePlayer=(G.fame||0);
    const _tier2Unlocked=_famePlayer>=200;
    const _activeS=G.activeSponsors||[];
    const _offers=G.sponsorOffers||[];
    const _history=G.sponsorHistory||[];
    const _totalEarned=_history.reduce((s,h)=>s+(h.totalEarned||0),0) + _activeS.reduce((s,a)=>s+(a.totalEarned||0),0);

    let _activeHtml='';
    if(_activeS.length>0){
      _activeHtml=_activeS.map(s=>{
        const b=getSponsorBrand(s.brandId);
        const daysLeft=s.expireDay-G.day;
        const renewable=daysLeft<=3;
        return `<div style="background:#0a1f10;border:1px solid #27ae60;border-radius:6px;padding:8px 10px;margin-bottom:6px">
          <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#fff">
            <span><b style="color:#27ae60">${b.emoji} ${b.name}</b> · ${s.dailyRate.toLocaleString('pl')} zł/dzień</span>
            <span style="color:${daysLeft<=3?'#f39c12':'#aac'}">📅 ${daysLeft} dni</span>
          </div>
          <div style="font-size:10px;color:#778;margin-top:3px">PR: ${b.pr} · ${b.pers} · Zarobione: ${(s.totalEarned||0).toLocaleString('pl')} zł</div>
          <div style="margin-top:6px;display:flex;gap:4px">
            ${renewable?`<button onclick="renewSponsor('${s.brandId}','same')" style="flex:1;background:#0a3a1a;border:1px solid #27ae60;color:#27ae60;padding:5px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">🔄 Odnów (10 dni)</button>
            <button onclick="renewSponsor('${s.brandId}','negotiate')" style="flex:1;background:#1a1505;border:1px solid #f39c12;color:#f39c12;padding:5px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">💬 Negocjuj +10% (70% szans)</button>`:''}
            <button onclick="cancelSponsor('${s.brandId}')" style="flex:0 0 80px;background:#1a0a0a;border:1px solid #5a1a1a;color:#c0392b;padding:5px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">❌ Anuluj</button>
          </div>
        </div>`;
      }).join('');
    }

    let _offersHtml='';
    if(_offers.length>0){
      _offersHtml=_offers.map(o=>{
        const b=getSponsorBrand(o.brandId);
        const daysToExpire=o.expireOfferDay-G.day;
        const dripNote=o.dripBoost>1 ? ` (Drip boost ×${o.dripBoost.toFixed(2)})` : '';
        return `<div style="background:#0a1a2a;border:1px solid #f1c40f;border-radius:6px;padding:8px 10px;margin-bottom:6px">
          <div style="font-size:12px;color:#f1c40f;font-weight:700;margin-bottom:3px">${b.emoji} ${b.name} — ${b.pr}</div>
          <div style="font-size:10px;color:#aaa;line-height:1.4;margin-bottom:5px">${_sponsorMsgTemplate('new_offer', b)}</div>
          <div style="font-size:11px;color:#27ae60;margin-bottom:5px">💰 ${o.dailyRate.toLocaleString('pl')} zł/dzień × 10 dni = ${(o.dailyRate*10).toLocaleString('pl')} zł total${dripNote}</div>
          <div style="font-size:10px;color:#778;margin-bottom:5px">⏰ Oferta wygasa za ${daysToExpire} dni</div>
          <div style="display:flex;gap:4px">
            <button onclick="acceptSponsorOffer('${o.brandId}')" style="flex:1;background:#0a3a1a;border:1px solid #27ae60;color:#27ae60;padding:6px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">✅ Akceptuj</button>
            <button onclick="declineSponsorOffer('${o.brandId}')" style="flex:1;background:#1a0a0a;border:1px solid #5a1a1a;color:#c0392b;padding:6px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">❌ Odrzuć</button>
          </div>
        </div>`;
      }).join('');
    }

    let _historyHtml='';
    if(_history.length>0){
      _historyHtml=_history.slice(-5).reverse().map(h=>{
        const b=getSponsorBrand(h.brandId);
        const reasonEmoji={'expired':'⏰','cancelled':'❌','scandal_break':'💔','negotiation_failed':'💸'}[h.endReason]||'📋';
        const reasonText={'expired':'wygasł','cancelled':'anulowany','scandal_break':'zerwany (skandal)','negotiation_failed':'zerwany (negocjacja)'}[h.endReason]||h.endReason;
        return `<div style="background:#0a0a14;border-radius:4px;padding:5px 8px;margin-bottom:3px;font-size:10px;color:#778">
          ${reasonEmoji} ${b?.emoji||''} ${b?.name||'?'} — ${reasonText} · Dz.${h.endDay} · zarobione ${(h.totalEarned||0).toLocaleString('pl')} zł
        </div>`;
      }).join('');
    }

    ph.innerHTML=`<div class="ph-screen">
      <div style="font-size:14px;color:#f1c40f;font-weight:700;margin-bottom:8px">📋 KONTRAKTY SPONSORSKIE</div>
      ${!_tier2Unlocked ? `<div style="background:#1a0a14;border:1px solid #5a2a3a;border-radius:6px;padding:10px;color:#c0392b;font-size:12px;margin-bottom:8px">🔒 Dostępne od Tier 2 Famous (fame 200+). Masz: ${_famePlayer}/200</div>` : ''}
      <div style="font-size:12px;color:#aac;margin-bottom:10px">💰 Total ze sponsorów: <b style="color:#f1c40f">${_totalEarned.toLocaleString('pl')} zł</b></div>

      <div style="font-size:11px;color:#27ae60;font-weight:700;margin-bottom:6px">⚡ AKTYWNE (${_activeS.length}/2)</div>
      ${_activeHtml || '<div style="color:#667;font-size:11px;padding:8px;background:#0a0a14;border-radius:4px;margin-bottom:8px;text-align:center">Brak aktywnych kontraktów</div>'}

      ${(()=>{
        /* v2.1.214 audit fix: PR drama events sekcja */
        const _pending=(G.sponsorMessages||[]).filter(m=>m.type==='pr_drama'&&m.pending);
        if(_pending.length===0) return '';
        return `<div style="font-size:11px;color:#e74c3c;font-weight:700;margin:10px 0 6px 0">⚡ PR DRAMA (${_pending.length})</div>`+
          _pending.map(m=>{
            const b=getSponsorBrand(m.brandId);
            return `<div style="background:#1a0a14;border:1px solid #c0392b;border-radius:6px;padding:8px 10px;margin-bottom:6px">
              <div style="font-size:12px;color:#c0392b;font-weight:700;margin-bottom:3px">${b?.emoji||'📋'} ${m.from}</div>
              <div style="font-size:11px;color:#ddd;margin-bottom:5px">${m.text}</div>
              <div style="font-size:11px;color:#27ae60;margin-bottom:5px">Akcept: ${m.accept}</div>
              <div style="display:flex;gap:4px">
                <button onclick="acceptPRDrama('${m.dramaId}')" style="flex:1;background:#0a3a1a;border:1px solid #27ae60;color:#27ae60;padding:5px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">✅ Akceptuj</button>
                <button onclick="declinePRDrama('${m.dramaId}')" style="flex:1;background:#1a0a0a;border:1px solid #5a1a1a;color:#c0392b;padding:5px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">❌ Odrzuć</button>
              </div>
            </div>`;
          }).join('');
      })()}
      <div style="font-size:11px;color:#f1c40f;font-weight:700;margin:10px 0 6px 0">📨 NOWE OFERTY (${_offers.length})</div>
      ${_offersHtml || `<div style="color:#667;font-size:11px;padding:8px;background:#0a0a14;border-radius:4px;margin-bottom:8px;text-align:center">Brak nowych ofert${_tier2Unlocked?' — sprawdź co 7 dni gry':''}</div>`}

      ${_history.length>0 ? `<div style="font-size:11px;color:#778;font-weight:700;margin:10px 0 6px 0">📜 HISTORIA (ostatnie 5)</div>${_historyHtml}` : ''}
    </div>`;
  } else if(app==='label'){
    ph.innerHTML=`<div class="ph-screen">
      <div style="font-size:14px;color:#9b59b6;font-weight:700;margin-bottom:10px">đźŽĽ WytwĂłrnia Muzyczna</div>
      ${G.label.type?`<div style="background:#1a2a1a;border-radius:8px;padding:12px;margin-bottom:12px;color:#7ec87e;font-size:14px">
        Typ: <strong>${G.label.type==='indie'?'WĹ‚asna WytwĂłrnia':'Major Label'}</strong><br>
        <span style="color:#667;font-size:12px">${G.label.type==='indie'?'100% tantiemĂłw':'50% tantiemĂłw, wsparcie marketingowe'}</span>
      </div>`:`<div style="color:#667;font-size:13px;margin-bottom:12px">Nie masz jeszcze wytwĂłrni. Potrzebna sĹ‚awa ${G.fame<30?30:40}+ i moĹĽesz podpisaÄ‡ kontrakt lub zaĹ‚oĹĽyÄ‡ wĹ‚asnÄ….</div>`}
      <button class="bbtn" onclick="openCareerOverlay('label');closePhone()">ZarzÄ…dzaj wytwĂłrniÄ…</button>
    </div>`;
  } else if(app==='merch'){
    if(!G.merch.active){
      ph.innerHTML=`<div class="ph-screen"><div style="color:#667;font-size:14px;padding:20px;text-align:center">đź”’ Sklep Merch odblokuje siÄ™ po osiÄ…gniÄ™ciu 5000 obserwujÄ…cych (masz ${G.followers.toLocaleString('pl')})</div></div>`;
    } else {
      ph.innerHTML=`<div class="ph-screen">
        <div style="background:#1a0a2a;border-radius:8px;padding:14px;margin-bottom:12px">
          <div style="font-size:13px;color:#9b59b6;font-weight:700;margin-bottom:8px">TWĂ“J SKLEP MERCH</div>
          <div style="color:#aaa;font-size:14px;margin-bottom:4px">Sprzedano: <strong style="color:#fff">${G.merch.sold} szt.</strong></div>
          <div style="color:#aaa;font-size:14px">ĹÄ…czny przychĂłd: <strong style="color:#9b59b6">${G.merch.revenue.toLocaleString('pl')} zĹ‚</strong></div>
        </div>
        <div style="font-size:13px;color:#667;margin-bottom:12px">Merch sprzedaje siÄ™ automatycznie â€” ~0.3% obserwujÄ…cych kupuje co tydzieĹ„. KaĹĽda sztuka = 80 zĹ‚.</div>
        <div style="background:#0a1220;border-radius:8px;padding:10px;font-size:13px;color:#aaa">
          đź“¦ DostÄ™pny merch: koszulki, czapki, bluzy z Twoim logo<br>
          đź’° Szacowany tygodniowy zarobek: ~${Math.floor(G.followers*0.003*7*80).toLocaleString('pl')} zĹ‚
        </div>
      </div>`;
    }
  }

  /* v2.1.120: Wave 4 S35 â€” single template + single concat (zamiast 2Ă— identyczne `innerHTML +=` w if-else). Lepsza wydajnoĹ›Ä‡ DOM. */
  ph.insertAdjacentHTML('beforeend', `<div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>`);
}

function renderPhoneQuests(){
  const ph=document.getElementById('ph-content');
  if(!G.dailyQuest){generateDailyQuest();}
  const q=G.dailyQuest;
  // â”€â”€ STORYLINE â€” Ĺ‚aĹ„cuch 18 misji gĹ‚Ăłwnych â”€â”€
  if(!G.mainQuest) G.mainQuest={currentStep:0,completed:[]};
  const stepIdx=G.mainQuest.currentStep;
  const totalSteps=STORYLINE_QUESTS.length;
  let storyHtml='';
  if(stepIdx<totalSteps){
    const cur=STORYLINE_QUESTS[stepIdx];
    storyHtml=`
      <div style="background:linear-gradient(135deg,#1a0a2a,#0a0a1a);border:1.5px solid #c8a520;border-radius:10px;padding:14px;margin-bottom:14px;position:relative">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <div style="color:#c8a520;font-size:11px;font-weight:700;letter-spacing:1px">đźŽŻ STORYLINE â€” krok ${stepIdx+1}/${totalSteps}</div>
          <div style="font-size:10px;color:#778">${stepIdx} ukoĹ„czonych</div>
        </div>
        <div style="font-size:18px;font-weight:900;color:#fff;margin-bottom:4px">${cur.em} ${cur.name}</div>
        <div style="font-size:13px;color:#aaa;margin-bottom:10px">${cur.desc}</div>
        <div style="background:#0a0a14;border-radius:4px;height:6px;overflow:hidden;margin-bottom:8px">
          <div style="width:${Math.round(stepIdx/totalSteps*100)}%;height:100%;background:linear-gradient(90deg,#c8a520,#f1c40f);border-radius:4px"></div>
        </div>
        <div style="font-size:11px;color:#7ec87e">Nagroda: +${cur.reward.money||0} zĹ‚${cur.reward.fame?' Â· +'+cur.reward.fame+' sĹ‚awy':''}${cur.reward.skillPts?' Â· +'+cur.reward.skillPts+' pkt skill':''}${cur.reward.xp?' Â· +'+cur.reward.xp+' XP':''}</div>
      </div>`;
  } else {
    storyHtml=`<div style="background:linear-gradient(135deg,#0a2a0a,#0a1a0a);border:1.5px solid #27ae60;border-radius:10px;padding:14px;margin-bottom:14px;text-align:center">
      <div style="font-size:32px;margin-bottom:8px">đźŹ†</div>
      <div style="font-size:16px;color:#f1c40f;font-weight:900">STORYLINE UKOĹCZONY!</div>
      <div style="font-size:12px;color:#aaa;margin-top:4px">Status Legendy osiÄ…gniÄ™ty. Kontynuuj grÄ™ dla Prestige.</div>
    </div>`;
  }
  // v1.9.41: SIDE_STORYLINES w telefonie (audyt UI: byĹ‚y caĹ‚kiem ukryte mimo 6 linii)
  let sideHtml='';
  if(typeof SIDE_STORYLINES==='object' && G.sideQuests){
    const lines=Object.entries(SIDE_STORYLINES);
    let sideRows='';
    lines.forEach(([lineId,line])=>{
      const prog=G.sideQuests[lineId]||{step:0,completed:[]};
      const total=line.quests.length;
      const step=prog.step;
      if(step>=total){
        sideRows+=`<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px dashed #1a2535;font-size:12px;">
          <span style="color:${line.color}">${line.name}</span>
          <span style="color:#27ae60;font-weight:700">âś“ KOMPLET (${total}/${total})</span>
        </div>`;
      } else {
        const cur=line.quests[step];
        sideRows+=`<div style="padding:6px 0;border-bottom:1px dashed #1a2535;font-size:12px;">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span style="color:${line.color}">${line.name}</span>
            <span style="color:#aaa;font-size:10px">${step}/${total}</span>
          </div>
          <div style="color:#aaa;font-size:11px;margin-top:2px">${cur.em} ${cur.name}</div>
          <div style="background:#0a0a14;border-radius:3px;height:4px;overflow:hidden;margin-top:3px">
            <div style="width:${Math.round(step/total*100)}%;height:100%;background:${line.color};border-radius:3px"></div>
          </div>
        </div>`;
      }
    });
    sideHtml=`<div style="background:linear-gradient(135deg,#0a1525,#0a0a14);border:1px solid #2a3a4a;border-radius:10px;padding:10px 14px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-size:11px;font-weight:700;letter-spacing:1px;margin-bottom:6px">đźŽŻ LINIE BOCZNE</div>
      ${sideRows}
    </div>`;
  }
  const isDone=q.completed;
  const isClaimed=q.claimed;
  const statusTxt=isClaimed?'âś… ZALICZONE â€” wracaj jutro':isDone?'âś… UKOĹCZONE â€” odbierz nagrodÄ™!':'âŹł W trakcie';
  const statusColor=isDone?'#27ae60':'#f1c40f';
  // Wykonane zadanie: przekreĹ›lone + ptaszek + tĹ‚o
  const cardBg=isClaimed?'#0a2a14':isDone?'#0a2a18':'#0a1220';
  const cardBorder=isClaimed||isDone?'2px solid #27ae60':'1px solid #1a3a5a';
  const descStyle=isClaimed?'text-decoration:line-through;color:#556':'color:#eee';
  const checkmark=isClaimed?'<span style="color:#27ae60;font-size:22px;margin-right:6px">âś”</span>':isDone?'<span style="color:#27ae60;font-size:18px;margin-right:6px">âś“</span>':'';
  ph.innerHTML=`
    <div style="padding:12px;overflow-y:auto;max-height:480px;">
      ${storyHtml}
      ${sideHtml}
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
        <span style="font-size:28px">đź“‹</span>
        <div>
          <div style="font-size:17px;font-weight:700;color:#7ec8e3">Dzienne Zadanie</div>
          <div style="font-size:11px;color:#556">DzieĹ„ ${G.day} Â· Resetuje siÄ™ jutro</div>
        </div>
      </div>
      <div style="background:${cardBg};border:${cardBorder};border-radius:8px;padding:14px;margin-bottom:12px;position:relative">
        ${isClaimed?'<div style="position:absolute;top:8px;right:10px;background:#27ae60;color:#0a1a0a;font-weight:900;font-size:11px;padding:3px 8px;border-radius:4px;letter-spacing:1px">ZALICZONE</div>':''}
        <div style="font-size:15px;${descStyle};margin-bottom:8px;line-height:1.5">${checkmark}${q.desc}</div>
        <div style="display:flex;justify-content:space-between;margin-bottom:10px">
          <span style="color:${statusColor};font-weight:700;font-size:14px">${statusTxt}</span>
          <span style="color:#aaa;font-size:13px">PostÄ™p: ${q.progress}/${q.count}</span>
        </div>
        <div style="background:#0a0a14;border-radius:4px;height:8px;overflow:hidden;margin-bottom:10px">
          <div style="height:100%;background:linear-gradient(90deg,#1a4a8a,#3498db);width:${Math.min(100,q.progress/q.count*100)}%;border-radius:4px;transition:width .3s"></div>
        </div>
        <div style="display:flex;justify-content:space-between">
          <span style="color:#f1c40f;font-size:13px">đź’° Nagroda: ${(()=>{const cm=typeof getCharyzmaBonus==='function'?getCharyzmaBonus():1;const r=Math.floor((q.reward||0)*cm);return cm>1?r+' zĹ‚ âś¨':r+' zĹ‚';})()}</span>
          <span style="color:#9b59b6;font-size:13px">â­ +${q.xp} XP</span>
        </div>
      </div>
      ${q.completed&&!q.claimed?`<button onclick="claimQuestReward();renderPhoneQuests();" style="width:100%;background:#0a3a0a;border:1px solid #27ae60;color:#27ae60;padding:10px;border-radius:6px;font-size:14px;cursor:pointer;margin-bottom:8px;">đź’° Odbierz nagrodÄ™ (${q.reward} zĹ‚ + ${q.xp} XP)</button>`:''}
      ${q.claimed?`<div style="text-align:center;color:#27ae60;font-size:15px;padding:10px">âś… Nagroda odebrana!</div>`:''}
      ${(!q.completed&&!q.claimed)?`<button onclick="G.dailyQuest=null;generateDailyQuest();renderPhoneQuests();" style="width:100%;background:#1a1a1a;border:1px solid #2a3a4a;color:#556;padding:8px;border-radius:6px;font-size:12px;cursor:pointer;margin-bottom:8px;">đź”„ Nowe zadanie (reset)</button>`:''}
      <button onclick="renderPhoneHome();" style="width:100%;background:#0a0a14;border:1px solid #1a2535;color:#334;padding:8px;border-radius:6px;font-size:12px;cursor:pointer;">â† PowrĂłt</button>
    </div>
  `;
}

function renderPhoneNotifs(){
  document.getElementById('ph-title').textContent='đź”” Powiadomienia';
  /* v2.1.182 (Agent phone audit): reset unread counter + re-evaluate badge â€” wczeĹ›niej notif badge NIGDY nie znikaĹ‚. */
  G.notifsUnread=0;
  const _hp=document.getElementById('hphone');
  if(_hp){
    _hp.classList.remove('has-new');
    setTimeout(()=>{if((G.sms?.unread||0)>0||(G.notifsUnread||0)>0)_hp.classList.add('has-new');},100);
  }
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-notifs">
      ${G.notifications.length===0?'<p style="color:#334;padding:16px;text-align:center">Brak powiadomieĹ„</p>':
        G.notifications.slice().reverse().slice(0,25).map(n=>`<div class="ph-notif"><div class="nt">${n.time}</div>${n.text}</div>`).join('')}
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>
  `;
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  đź’¬ SMS / WIADOMOĹšCI (v1.9.9 Faza 3)
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
/* v2.1.66 Amper: `physical:false` oznacza SMS-only kontakt bez NPC w mieĹ›cie. WpĹ‚ywa na UI â€” brak "WpadnÄ™", inny system przyjaĹşni. */
const SMS_CONTACTS={
  wiktor:    {name:'Wiktor (Drip District)',  em:'đź‘”', color:'#7ec8e3', physical:true},
  marcin:    {name:'Marcin (Organizator)',    em:'đźŽ¤', color:'#9b59b6', physical:true},
  producent: {name:'Producent',                em:'đźŽšď¸Ź', color:'#e67e22', physical:true},
  kamil:     {name:'Kamil (Stary kumpel)',    em:'đź‘Š', color:'#27ae60', physical:false},
  zbyszek:   {name:'Zbyszek (Kebab)',          em:'đźŚ®', color:'#f1c40f', physical:true},
  manager:   {name:'MenadĹĽer',                 em:'đź¤µ', color:'#c8a520', physical:false},
  label:     {name:'Label A&R',                em:'đźŹ˘', color:'#bdc3c7', physical:false},
  sponsor:   {name:'Sponsor',                  em:'đź’Ľ', color:'#e91e8c', physical:false},
  bank:      {name:'mBank Trap',               em:'đźŹ¦', color:'#f39c12', physical:false},
  system:    {name:'TrapSimulator',            em:'đź“±', color:'#7ec8e3', physical:false},
  fan:       {name:'Fan nr 1',                 em:'âť¤ď¸Ź', color:'#e74c3c', physical:true},
  crew:      {name:'Ekipa',                    em:'đź‘Ą', color:'#3498db', physical:false}, /* v2.1.116: Wave 4 W36 â€” Crew SMS contact dodany (brak entry blokowaĹ‚ SMS dla crew events) */
  gymbro:    {name:'Gym Bro',                  em:'đź’Ş', color:'#e67e22', physical:false}, /* v2.1.179: Gym Bro SMS contact (wczeĹ›niej osobny G.gymBroMessages array, NIE pojawiaĹ‚ siÄ™ w WiadomoĹ›ci) */
};
function _ensureSMS(){
  if(!G.sms||typeof G.sms!=='object') G.sms={conversations:{},unread:0,_triggeredEvents:{}};
  if(!G.sms.conversations) G.sms.conversations={};
  if(typeof G.sms.unread!=='number') G.sms.unread=0;
  if(!G.sms._triggeredEvents) G.sms._triggeredEvents={};
}
// SMS od NPC do gracza
window._smsSend=function(contactId,text,opts){
  _ensureSMS();
  if(!SMS_CONTACTS[contactId]) return;
  if(!G.sms.conversations[contactId]) G.sms.conversations[contactId]=[];
  const _hh=Math.floor((typeof gameMin==='number'?gameMin:0)/60)%24;
  const _mm=Math.floor((typeof gameMin==='number'?gameMin:0)%60); /* v1.9.72: floor ĹĽeby usunÄ…Ä‡ fraction (06:28.819199 â†’ 06:28) */
  const time=`${String(_hh).padStart(2,'0')}:${String(_mm).padStart(2,'0')}`;
  G.sms.conversations[contactId].push({from:contactId,text,day:G.day||0,time,read:false});
  /* v2.1.125: Wave 4 K41 â€” per-message cap 100 podczas gameplay (nie tylko przy Prestige). Memory leak fix dla dĹ‚ugich save'Ăłw. */
  if(G.sms.conversations[contactId].length>100) G.sms.conversations[contactId]=G.sms.conversations[contactId].slice(-100);
  G.sms.unread=(G.sms.unread||0)+1;
  // v1.9.17: BUG FIX â€” SMS ma swĂłj licznik unread + badge na đź’¬ ikonie. Toast tylko gdy phone zamkniÄ™ty, ĹĽeby nie spamowaÄ‡ dual notification.
  if(typeof addNotif==='function' && !document.getElementById('phone')?.classList.contains('on')){
    const c=SMS_CONTACTS[contactId];
    addNotif(`${c.em} SMS od ${c.name.split(' ')[0]}: ${text.slice(0,40)}${text.length>40?'â€¦':''}`);
  }
  // Opcjonalna akcja po otrzymaniu SMS (np. quick offer)
  if(opts&&opts.action) G.sms.conversations[contactId][G.sms.conversations[contactId].length-1].action=opts.action;
};
// Trigger SMS tylko raz w grze (dla milestone-based events)
window._smsTriggerOnce=function(triggerId,contactId,text,opts){
  _ensureSMS();
  if(G.sms._triggeredEvents[triggerId]) return false;
  G.sms._triggeredEvents[triggerId]=G.day||0;
  _smsSend(contactId,text,opts);
  return true;
};
// SprawdĹş eventy ktĂłre powinny wywoĹ‚aÄ‡ SMS â€” wywoĹ‚ywany w nextPeriod (rzadko, ~co dzieĹ„)
window._smsCheckTriggers=function(){
  _ensureSMS();
  /* v2.1.37 [Amper]: SMS panel uĹĽywa G.fans lojalnych (spĂłjnoĹ›Ä‡) */
  const fans=(G.fans||0);
  const tracks=G.careers?.raper?.tracks||0;
  const freestyles=G.careers?.raper?.freestyles||0;
  const concerts=G.events?.performed||0;
  // â€” Onboarding: pierwsza wypĹ‚ata
  if(G.totalEarned>=100) _smsTriggerOnce('first_money','kamil','siema kolego! widziaĹ‚em ze juz zarabiasz. nie zapomnij ze mam zlecenia jak bedziesz potrzebowal kasy đź’°');
  if(G.totalEarned>=1000) _smsTriggerOnce('1k_earned','zbyszek',`Hej ${G.name||'kolego'}, jak idzie biznes? Wpadnij na kebaba, mam dla Ciebie zniĹĽkÄ™ đźŚ®`);
  // â€” Pierwszy freestyle
  if(freestyles>=1) _smsTriggerOnce('first_freestyle','kamil','widzialem ten freestyle na ulicy đź”Ą ostro spalileĹ›! tak trzymaj');
  // â€” Pierwszy track
  if(tracks>=1) _smsTriggerOnce('first_track','producent',`Yo, ${G.name||'kolego'}! TwĂłj track wpadĹ‚ mi w ucho. Jak zrobisz 3 single â€” pogadamy o kontrakcie đźŽšď¸Ź`);
  if(tracks>=3) _smsTriggerOnce('3_tracks','label','A&R Major Label tu. Twoje numery rosnÄ… w streamach. PodejdĹş do nas â€” mamy ofertÄ™. Czekam na sygnaĹ‚ đźŹ˘');
  // â€” Pierwszy koncert
  if(concerts>=1) _smsTriggerOnce('first_concert','marcin',`Ĺšwietny wystÄ™p ${G.name||'kolego'}! Ludzie pytajÄ… kiedy nastepny. Daj znaÄ‡ jak chcesz wbic wiÄ™kszÄ… scenÄ™ đźŽ¤`);
  if(concerts>=5) _smsTriggerOnce('5_concerts','marcin','5 koncertĂłw masz na koncie, jesteĹ› juĹĽ rozpoznawalny w mieĹ›cie. Festiwal moĹĽe byÄ‡ nastÄ™pnym krokiem â€” myĹ›l o tym');
  // â€” SĹ‚awa
  if(G.fame>=25) _smsTriggerOnce('fame_25','sponsor',`CzeĹ›Ä‡ ${G.name||'kolego'}! ReprezentujÄ™ markÄ™ odzieĹĽowÄ…. SĹ‚awÄ™ masz, czas na drip â€” wpadnij do Drip District đź’Ľ`);
  if(G.fame>=50) _smsTriggerOnce('fame_50','manager','Yo, jestem Twoim potencjalnym menadĹĽerem. Daj znaÄ‡ jak chcesz pogadaÄ‡ o x1.2 zarobkĂłw. Czekam pod salÄ… koncertowÄ… đź¤µ');
  if(G.fame>=75) _smsTriggerOnce('fame_75','sponsor','Globalna marka chce z TobÄ… wspĂłĹ‚pracowaÄ‡. Sponsoring na poziomie nie do odrzucenia. Skontaktuj siÄ™ đź’Ľ');
  // â€” Fani milestones
  if(fans>=1000) _smsTriggerOnce('fans_1k','fan','OMG masz juĹĽ 1000 fanĂłw! Jestem Twoim najwiÄ™kszym fanem od pierwszego tracka âť¤ď¸Ź Daj znaÄ‡ kiedy nowy materiaĹ‚!');
  if(fans>=10000) _smsTriggerOnce('fans_10k','fan','10k fanĂłw! JuĹĽ regularnie sĹ‚ucham Twoich trackĂłw non-stop. Kiedy w mieĹ›cie koncert? âť¤ď¸Źđź”Ą');
  if(fans>=100000) _smsTriggerOnce('fans_100k','sponsor','100k fanĂłw to powaĹĽny status. Brand partnership na 6 cyfr czeka â€” wpadnij porozmawiaÄ‡ đź’Ľ');
  /* v2.1.181 (Agent SMS audit fill): hejterzy milestone â€” gracz ma G.haters licznik (random events, social media), ale wczeĹ›niej ĹĽaden SMS nie reagowaĹ‚. */
  const haters=(G.haters||0);
  if(haters>=100) _smsTriggerOnce('haters_100','system','đź“± TrapSimulator: 100+ hejterĂłw. PamiÄ™taj â€” hejt = zasiÄ™g. MoĹĽesz zignorowaÄ‡ lub uruchomiÄ‡ PR Campaign (Telefon â†’ Social Media).');
  if(haters>=1000) _smsTriggerOnce('haters_1k','manager','đź¤µ Yo, mamy 1000+ hejterĂłw na Twoim koncie. Pora pomyĹ›leÄ‡ o profesjonalnym PR. Wpadnij â€” pogadamy o damage control.');
  // â€” Bank
  if(G.money>=50000) _smsTriggerOnce('money_50k','bank','mBank Trap: masz 50k+ na koncie. Czas na lokatÄ™ terminowÄ…? Wpadnij do aplikacji Bank đźŹ¦');
  // â€” Rep uliczna
  if(G.streetRep>=50) _smsTriggerOnce('rep_50','wiktor',`PojechaĹ‚eĹ› po dzielnicy! Rep 50+. ZniĹĽki w Drip District czekajÄ… â€” wpadnij đź‘”`);
  // â€” Drip
  if(G.drip>=100) _smsTriggerOnce('drip_100','sponsor','TwĂłj drip to jest sztos! Marka luksusowa chce CiÄ™ sponsorowaÄ‡. SprawdĹş ofertÄ™ đź’Ž');
  // â€” Prestige
  if(G.prestige>=1) _smsTriggerOnce('prestige_1','system','đźŚź Pierwszy Prestige! Resetujesz progres ale +5% zarobkĂłw forever. Legenda na drodze đź“±');
  /* v2.1.168: Prestige Skills hint w SMS po pierwszym Prestige */
  if(G.prestige>=1 && (G.prestigePoints||0)>=1) _smsTriggerOnce('prestige_skills_unlock','system','đźŚź Masz Prestige Skill Point! Wydaj go: Telefon â†’ Statystyki â†’ đźŚź Prestige Skills. 6 permanentnych perkĂłw do odblokowania.');
  /* v2.1.168: Mansion hint SMS po zakupie */
  if(G.apartment==='mansion') _smsTriggerOnce('mansion_bought','marcin','đźŹ° SĹ‚yszaĹ‚em o twojej Rezydencji obok Biura NieruchomoĹ›ci! To znaczy ĹĽe jesteĹ› teraz w innej lidze. MoĹĽe prywatny koncert w salonie? đźŽ¤');
  /* v2.1.215 [Amper]: Mega Villa Marcin SMS — Tier 3 Legendary */
  if(G.apartment==='mega_villa') _smsTriggerOnce('mega_villa_bought','marcin','🏖 Mega Villa?! Bracie wszedłeś w legendę. Mam dla Ciebie zaproszenie na zamknięty event Polish Hip-Hop Awards.');
  // â€” Storyline waĹĽne kroki
  if((G.mainQuest?.currentStep||0)>=5) _smsTriggerOnce('story_5','kamil','widze ze idzie ci, juz piaty krok storyline. szanuje đź’Ş'); /* v1.9.16: BUG FIX â€” G.storylineStep nigdy nie istniaĹ‚o, prawidĹ‚owe pole to G.mainQuest.currentStep */
  // â€” Kontrakt label
  if(G.label?.type==='major') _smsTriggerOnce('major_signed','label','Witamy w rodzinie! TwĂłj kontrakt aktywny. Promujemy kaĹĽdy TwĂłj track. Marketing rusza đźŹ˘');
  if(G.label?.type==='global') _smsTriggerOnce('global_signed','label','GLOBAL DEAL aktywny. Twoja muzyka leci na caĹ‚ym Ĺ›wiecie. Czekamy na nowe single đźŚŤ');
};
window.renderPhoneSMS=function(){
  _ensureSMS();
  /* v1.9.81: try fetch player messages on open */
  if(typeof window._fetchPlayerMessages==='function') window._fetchPlayerMessages().catch(()=>{});
  document.getElementById('ph-title').textContent='đź’¬ WiadomoĹ›ci';
  const _esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  /* v2.0.32: dwie sekcje â€” NPC (z SMS_CONTACTS) vs Znajomi (player_xxx â†’ G.friends mapping).
     WczeĹ›niej wszystko w jednej liĹ›cie â€” player_xxx pokazywaĹ‚o siÄ™ jako "player_36416162-..." (brak SMS_CONTACTS entry).
     Quick reply "DziÄ™ki/WpadnÄ™/PĂłĹşniej" pasuje tylko do NPC, nie do graczy â†’ klik znajomy idzie teraz do _openPlayerChat. */
  const allCids=Object.keys(G.sms.conversations).filter(k=>G.sms.conversations[k].length>0);
  const _sortByLast=(a,b)=>{
    const ma=G.sms.conversations[a],mb=G.sms.conversations[b];
    const la=ma[ma.length-1],lb=mb[mb.length-1];
    return (lb.day*1440+_smsTimeToMin(lb.time))-(la.day*1440+_smsTimeToMin(la.time));
  };
  const npcCids=allCids.filter(cid=>!cid.startsWith('player_') && SMS_CONTACTS[cid]).sort(_sortByLast);
  const playerCids=allCids.filter(cid=>cid.startsWith('player_')).sort(_sortByLast);
  /* Friends bez konwersacji â€” dopisz do listy znajomych ĹĽeby gracz mĂłgĹ‚ zaczÄ…Ä‡ rozmowÄ™ */
  const friendsList=(G.friends||[]).map(f=>({userId:f.userId,nick:f.nick,cid:'player_'+f.userId,lastMsg:null,unread:0}));
  for(const cid of playerCids){
    const uid=cid.replace(/^player_/,'');
    const msgs=G.sms.conversations[cid];
    const f=friendsList.find(x=>x.userId===uid);
    if(f){
      f.lastMsg=msgs[msgs.length-1];
      f.unread=msgs.filter(m=>!m.read&&m.from!=='me').length;
    }else{
      /* WiadomoĹ›Ä‡ od kogoĹ› kto nie jest w paczce (np. usuniÄ™ty znajomy) */
      friendsList.push({userId:uid,nick:uid.slice(0,8),cid,lastMsg:msgs[msgs.length-1],unread:msgs.filter(m=>!m.read&&m.from!=='me').length,_external:true});
    }
  }
  if(npcCids.length===0 && friendsList.length===0){
    document.getElementById('ph-content').innerHTML=`
      <div style="padding:20px;text-align:center;color:#778;font-size:13px">
        <div style="font-size:48px;margin-bottom:12px">đź“­</div>
        Brak wiadomoĹ›ci.<br><br>
        <span style="color:#556;font-size:11px">Zacznij zarabiaÄ‡ i robiÄ‡ tracki â€” NPC bÄ™dÄ… siÄ™ odzywaÄ‡.</span>
      </div>
      <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>`;
    return;
  }
  /* Sekcja NPC */
  const npcRows=npcCids.map(cid=>{
    const c=SMS_CONTACTS[cid];
    const msgs=G.sms.conversations[cid];
    const last=msgs[msgs.length-1];
    const unread=msgs.filter(m=>!m.read&&m.from!=='me').length;
    return `<div onclick="renderSMSConversation('${cid}')" style="background:linear-gradient(135deg,${c.color}22,${c.color}08);border:1px solid ${c.color}44;border-left:4px solid ${c.color};border-radius:8px;padding:10px 12px;margin-bottom:6px;cursor:pointer;transition:transform .15s" onmouseover="this.style.transform='translateX(3px)'" onmouseout="this.style.transform=''">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
        <span style="font-size:18px">${c.em}</span>
        <span style="flex:1;color:#fff;font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${c.name}</span>
        ${unread>0?`<span style="background:${c.color};color:#000;font-size:10px;font-weight:800;padding:2px 6px;border-radius:10px">${unread}</span>`:''}
      </div>
      <div style="color:#aac;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${last.text}</div>
      <div style="color:#556;font-size:9px;margin-top:2px">Dz. ${last.day} Â· ${last.time}</div>
    </div>`;
  }).join('');
  /* Sekcja Znajomi â€” sortuj: najpierw z wiadomoĹ›ciami, potem reszta */
  friendsList.sort((a,b)=>{
    if(a.lastMsg && !b.lastMsg) return -1;
    if(!a.lastMsg && b.lastMsg) return 1;
    if(a.lastMsg && b.lastMsg){
      return (b.lastMsg.day*1440+_smsTimeToMin(b.lastMsg.time))-(a.lastMsg.day*1440+_smsTimeToMin(a.lastMsg.time));
    }
    return 0;
  });
  const friendRows=friendsList.map(f=>{
    const last=f.lastMsg;
    const escNick=_esc(f.nick);
    const escUid=_esc(f.userId);
    return `<div onclick="window._openPlayerChat('${escUid}','${escNick}')" style="background:linear-gradient(135deg,#3498db22,#1a4a8a11);border:1px solid #3498db55;border-left:4px solid #3498db;border-radius:8px;padding:10px 12px;margin-bottom:6px;cursor:pointer;transition:transform .15s" onmouseover="this.style.transform='translateX(3px)'" onmouseout="this.style.transform=''">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
        <span style="font-size:18px">đź‘¤</span>
        <span style="flex:1;color:#fff;font-weight:700;font-size:13px;word-break:break-word;line-height:1.2">${escNick}${f._external?' <span style=\"color:#778;font-size:9px;font-weight:400\">(z LB)</span>':''}</span>
        ${f.unread>0?`<span style="background:#e74c3c;color:#fff;font-size:10px;font-weight:800;padding:2px 6px;border-radius:10px">${f.unread}</span>`:''}
      </div>
      <div style="color:#aac;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${last?_esc(last.text):'Brak wiadomoĹ›ci â€” napisz pierwszy'}</div>
      ${last?`<div style="color:#556;font-size:9px;margin-top:2px">Dz. ${last.day} Â· ${last.time}</div>`:''}
    </div>`;
  }).join('');
  const sectionHeader=(label,color,count)=>`<div style="display:flex;align-items:center;gap:8px;padding:8px 14px 6px;margin-top:6px"><div style="height:2px;flex:1;background:linear-gradient(90deg,${color}88,transparent)"></div><span style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:${color};font-weight:800">${label} (${count})</span><div style="height:2px;flex:1;background:linear-gradient(270deg,${color}88,transparent)"></div></div>`;
  const npcSection=npcCids.length>0?`${sectionHeader('đź§‘ NPC z miasta','#c8a520',npcCids.length)}<div style="padding:0 12px">${npcRows}</div>`:'';
  const friendSection=friendsList.length>0?`${sectionHeader('đź‘Ą Znajomi z paczki','#3498db',friendsList.length)}<div style="padding:0 12px">${friendRows}</div>`:'';
  document.getElementById('ph-content').innerHTML=`
    ${npcSection}
    ${friendSection}
    <div style="padding:12px 14px 8px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>`;
};
/* v1.9.81: lista friends do chatu P2P */
window.renderPlayerChatList=function(){
  const ph=document.getElementById('ph-content');
  if(!ph) return;
  document.getElementById('ph-title').textContent='đź’¬ Czat ze znajomymi';
  const _esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  if(!G.friends||G.friends.length===0){
    ph.innerHTML=`<div style="padding:20px;text-align:center;color:#778;font-size:13px"><div style="font-size:48px;margin-bottom:12px">đź‘Ą</div>Brak znajomych. Dodaj graczy w telefonie â†’ đźŹ† Leaderboard.</div><div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneSMS()">â† SMS</button></div>`;
    return;
  }
  const rows=G.friends.map(f=>{
    const cid='player_'+f.userId;
    const msgs=G.sms?.conversations?.[cid]||[];
    const unread=msgs.filter(m=>!m.read&&m.from!=='me').length;
    return `<div onclick="window._openPlayerChat('${_esc(f.userId)}','${_esc(f.nick)}')" style="background:linear-gradient(135deg,#1a3a5a22,#0a1a2a08);border:1px solid #2a4a6a44;border-left:4px solid #3498db;border-radius:8px;padding:10px 12px;margin-bottom:6px;cursor:pointer">
      <div style="display:flex;align-items:center;gap:8px">
        <span style="font-size:18px">đź‘¤</span>
        <span style="flex:1;color:#fff;font-weight:700;font-size:13px">${_esc(f.nick)}</span>
        ${unread>0?`<span style="background:#e74c3c;color:#fff;font-size:10px;padding:2px 6px;border-radius:10px">${unread}</span>`:''}
      </div>
      <div style="color:#aac;font-size:11px;margin-top:3px">${msgs.length>0?_esc((msgs[msgs.length-1].text||'').slice(0,50)):'Brak wiadomoĹ›ci â€” napisz pierwszy.'}</div>
    </div>`;
  }).join('');
  ph.innerHTML=`<div style="padding:6px 12px">${rows}</div><div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneSMS()">â† SMS</button></div>`;
};
function _smsTimeToMin(t){const [h,m]=(t||'00:00').split(':').map(Number);return h*60+m;}
window.renderSMSConversation=function(contactId){
  _ensureSMS();
  /* v2.0.32: player_xxx â†’ forward do _openPlayerChat (ten ma input do pisania, quick replies NIE pasujÄ… do graczy) */
  if(String(contactId).startsWith('player_')){
    const uid=contactId.replace(/^player_/,'');
    const f=(G.friends||[]).find(fr=>fr.userId===uid);
    const nick=f?f.nick:uid.slice(0,8);
    if(typeof window._openPlayerChat==='function'){window._openPlayerChat(uid,nick);return;}
  }
  const c=SMS_CONTACTS[contactId]||{name:contactId,em:'đź‘¤',color:'#aac'};
  document.getElementById('ph-title').textContent=`${c.em} ${c.name}`;
  const msgs=G.sms.conversations[contactId]||[];
  // Oznacz wszystkie jako przeczytane
  let unreadCount=0;
  msgs.forEach(m=>{if(!m.read&&m.from!=='me'){m.read=true;unreadCount++;}});
  G.sms.unread=Math.max(0,(G.sms.unread||0)-unreadCount);
  const bubbles=msgs.map(m=>{
    const isMe=m.from==='me';
    const bg=isMe?'#0a3a5a':'#1a1a2a';
    const color=isMe?'#7ec8e3':'#fff';
    const align=isMe?'flex-end':'flex-start';
    return `<div style="display:flex;justify-content:${align};margin-bottom:8px">
      <div style="max-width:75%;background:${bg};border:1px solid ${c.color}22;border-radius:14px;padding:8px 12px">
        <div style="color:${color};font-size:13px;line-height:1.4;word-break:break-word">${m.text}</div>
        <div style="color:#556;font-size:9px;margin-top:3px;text-align:right">Dz. ${m.day} Â· ${m.time}${isMe?' Â·  âś“':''}</div>
      </div>
    </div>`;
  }).join('');
  // Quick replies â€” zawsze 3 standardowe + opcjonalna akcja per ostatnia wiadomoĹ›Ä‡
  const lastMsg=msgs[msgs.length-1];
  const hasAction=lastMsg&&lastMsg.action&&!lastMsg._actionUsed;
  const actionBtn=hasAction?`<button onclick="_smsExecAction('${contactId}',${msgs.length-1})" style="width:100%;background:linear-gradient(135deg,${c.color},${c.color}aa);border:none;color:#000;font-weight:800;padding:10px;border-radius:8px;cursor:pointer;font-size:13px;margin-bottom:6px">${lastMsg.action.label}</button>`:'';
  document.getElementById('ph-content').innerHTML=`
    <button class="ph-back-btn" onclick="renderPhoneSMS()">â† WiadomoĹ›ci</button>
    <div style="padding:6px 12px;max-height:55vh;overflow-y:auto" id="sms-thread">${bubbles||'<div style="color:#556;text-align:center;padding:20px">Pusty thread</div>'}</div>
    <div style="padding:6px 12px;border-top:1px solid #1a2535">
      ${actionBtn}
      ${(()=>{
        /* v2.1.66 Amper: SMS-only NPC (Kamil, Label, Sponsor, Bank, System) â€” bez "WpadnÄ™". Zamiast tego "đź“ž ZadzwoĹ„" (longer chat, +2 przyjaĹşĹ„). */
        const _c=SMS_CONTACTS[contactId];
        const _smsOnly=_c && _c.physical===false;
        if(_smsOnly){
          return `<div style="background:#1a1a2a;border-left:3px solid #9b59b6;padding:6px 10px;margin-bottom:6px;font-size:10px;color:#aac;font-style:italic">đź’¬ Kontakt tylko przez telefon â€” ${_c.name} nie ma fizycznej obecnoĹ›ci w mieĹ›cie. Wbijasz przyjaĹşĹ„ odpowiadajÄ…c na SMS-y.</div>
          <div style="display:flex;gap:4px;flex-wrap:wrap">
            <button onclick="_smsQuickReply('${contactId}','thanks')" style="flex:1;background:#1a3525;border:1px solid #2a6a3a;color:#9ee89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">đź‘Ť DziÄ™ki (+1 przyjaĹşĹ„)</button>
            <button onclick="_smsQuickReply('${contactId}','call')" style="flex:1;background:#2a1a35;border:1px solid #6a3a8a;color:#c89eeb;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">đź“ž ZadzwoĹ„ (+2 przyjaĹşĹ„)</button>
            <button onclick="_smsQuickReply('${contactId}','later')" style="flex:1;background:#352525;border:1px solid #6a3a3a;color:#e89e9e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">âŹł PĂłĹşniej (-1 przyjaĹşĹ„)</button>
          </div>`;
        }
        return `<div style="display:flex;gap:4px;flex-wrap:wrap">
          <button onclick="_smsQuickReply('${contactId}','thanks')" style="flex:1;background:#1a3525;border:1px solid #2a6a3a;color:#9ee89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">đź‘Ť DziÄ™ki (+1 przyjaĹşĹ„)</button>
          <button onclick="_smsQuickReply('${contactId}','visit')" style="flex:1;background:#2a3525;border:1px solid #6a8a3a;color:#e8e89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">đźš¶ WpadnÄ™ (+3 przyjaĹşĹ„)</button>
          <button onclick="_smsQuickReply('${contactId}','later')" style="flex:1;background:#352525;border:1px solid #6a3a3a;color:#e89e9e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">âŹł PĂłĹşniej (-1 przyjaĹşĹ„)</button>
        </div>`;
      })()}
    </div>`;
  // Auto-scroll do doĹ‚u
  setTimeout(()=>{const t=document.getElementById('sms-thread');if(t)t.scrollTop=t.scrollHeight;},10);
  if(typeof saveGameSilent==='function') saveGameSilent();
};
window._smsReply=function(contactId,text){
  _ensureSMS();
  if(!G.sms.conversations[contactId]) G.sms.conversations[contactId]=[];
  const _hh=Math.floor((typeof gameMin==='number'?gameMin:0)/60)%24;
  const _mm=Math.floor((typeof gameMin==='number'?gameMin:0)%60); /* v1.9.72: floor fraction fix */
  G.sms.conversations[contactId].push({from:'me',text,day:G.day||0,time:`${String(_hh).padStart(2,'0')}:${String(_mm).padStart(2,'0')}`,read:true});
  /* v2.1.125: K41 cap 100 per contact (NPC reply) */
  if(G.sms.conversations[contactId].length>100) G.sms.conversations[contactId]=G.sms.conversations[contactId].slice(-100);
  renderSMSConversation(contactId);
};
/* v1.9.72: SMS quick reply z rĂłĹĽnym efektem (zgĹ‚oszone przez gracza â€” wczeĹ›niej trzy opcje robiĹ‚y to samo) */
/* v1.9.77: Player-to-player SMS przez Supabase
   Wymaga tabeli `player_messages` w Supabase (kolumny: from_user_id, to_user_id, from_nick, text, sent_at, day)
   JeĹ›li tabela nie istnieje, fail-safe â€” pokazuje toast + zapisuje lokalnie. */
window._sendPlayerMessage=async(toUserId,toNick,text)=>{
  if(!G.playerUUID){if(typeof showMsg==='function')showMsg('âš ď¸Ź Musisz mieÄ‡ nick (telefon â†’ leaderboard)','r');return false;}
  if(!text||text.trim().length<1||text.length>200){if(typeof showMsg==='function')showMsg('âš ď¸Ź WiadomoĹ›Ä‡ 1-200 znakĂłw','r');return false;}
  /* lokalna kopia w SMS conversation */
  const cid='player_'+toUserId;
  if(!G.sms)G.sms={conversations:{},unread:0};
  if(!G.sms.conversations[cid])G.sms.conversations[cid]=[];
  const _hh=Math.floor((gameMin||0)/60)%24, _mm=Math.floor((gameMin||0)%60);
  G.sms.conversations[cid].push({from:'me',text,day:G.day||0,time:`${String(_hh).padStart(2,'0')}:${String(_mm).padStart(2,'0')}`,read:true,toNick});
  /* v2.1.125: K41 cap 100 per player chat */
  if(G.sms.conversations[cid].length>100) G.sms.conversations[cid]=G.sms.conversations[cid].slice(-100);
  try{
    if(typeof _lbFetch==='function'){
      const res=await _lbFetch('player_messages',{
        method:'POST',
        headers:{'Prefer':'return=minimal'},
        body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:toUserId,from_nick:G.globalNick||'Player',text:text.slice(0,200),day:G.day||0})
      });
      if(res===true||res){
        if(typeof showMsg==='function')showMsg(`đź“¨ WiadomoĹ›Ä‡ do ${toNick} wysĹ‚ana`,'g',2200);
        if(typeof saveGameSilent==='function')saveGameSilent();
        return true;
      }
    }
    if(typeof showMsg==='function')showMsg(`đź“¨ Zapisano lokalnie (offline lub brak tabeli player_messages)`,'f',3000);
    if(typeof saveGameSilent==='function')saveGameSilent();
    return false;
  }catch(e){
    if(typeof showMsg==='function')showMsg(`đź“¨ Zapisano lokalnie (bĹ‚Ä…d: ${e.message})`,'f',3000);
    return false;
  }
};
window._fetchPlayerMessages=async(opts)=>{
  if(!G.playerUUID||typeof _lbFetch!=='function')return [];
  /* v2.1.13: opts.silent=true â†’ tylko sync bez toastĂłw (np. pierwszy fetch po starcie ĹĽeby nie spamowaÄ‡) */
  const silent = opts && opts.silent;
  try{
    const rows=await _lbFetch(`player_messages?to_user_id=eq.${G.playerUUID}&order=sent_at.desc&limit=50`);
    if(!Array.isArray(rows))return [];
    let newCount=0;
    const newMsgs=[];
    if(!G.sms)G.sms={conversations:{},unread:0};
    for(const m of rows){
      const cid='player_'+m.from_user_id;
      if(!G.sms.conversations[cid])G.sms.conversations[cid]=[];
      const exists=G.sms.conversations[cid].some(x=>x._sentAt===m.sent_at);
      if(!exists){
        G.sms.conversations[cid].push({from:cid,fromNick:m.from_nick,text:m.text,day:m.day||G.day,time:'',read:false,_sentAt:m.sent_at});
        /* v2.1.125: K41 cap 100 per inbound player msg */
        if(G.sms.conversations[cid].length>100) G.sms.conversations[cid]=G.sms.conversations[cid].slice(-100);
        G.sms.unread=(G.sms.unread||0)+1;
        newCount++;
        newMsgs.push({from_nick:m.from_nick||'Gracz',text:m.text});
      }
    }
    if(newCount>0 && !silent){
      /* v2.1.13: toast per wiadomoĹ›Ä‡ z PREVIEW treĹ›ci, plus addNotif z autorem + treĹ›ciÄ… */
      if(typeof showMsg==='function' && typeof addNotif==='function'){
        for(const m of newMsgs.slice(0,3)){
          const preview = m.text.length>60?m.text.slice(0,57)+'...':m.text;
          showMsg(`đź’¬ ${m.from_nick}: ${preview}`,'f',5500);
          addNotif(`đź’¬ ${m.from_nick}: ${preview}`);
        }
        if(newMsgs.length>3){
          showMsg(`đź“¨ +${newMsgs.length-3} kolejnych wiadomoĹ›ci od graczy`,'f',4000);
        }
      }
    }
    return rows;
  }catch(e){console.warn('fetchPlayerMessages:',e.message);return [];}
};

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   v2.1.13 SOCIAL POLLER â€” toast + addNotif dla nowych:
   â€˘ Friend invites (pending TO me)
   â€˘ Crew invites (pending TO me)
   â€˘ Player messages (deleguje do _fetchPlayerMessages)
   WywoĹ‚ywane co 30s przez setInterval startSocialPoller(), plus initial silent fetch po starcie. */
window._pollSocial=async function(opts){
  if(!G.playerUUID) return;
  const silent = opts && opts.silent;
  G._socialSeen = G._socialSeen || {friendInvites:[], crewInvites:[]};
  /* 1. FRIEND INVITES */
  try{
    const fInv = await _lbFetch(`friendships?to_user_id=eq.${G.playerUUID}&status=eq.pending&order=created_at.desc&limit=10`);
    if(Array.isArray(fInv)){
      for(const inv of fInv){
        const key = inv.from_user_id;
        if(!G._socialSeen.friendInvites.includes(key)){
          G._socialSeen.friendInvites.push(key);
          if(silent) continue;
          /* Fetch nick z LB */
          let nick = 'Gracz';
          const lb = await _lbFetch(`leaderboard?user_id=eq.${inv.from_user_id}&order=updated_at.desc&limit=1`);
          if(Array.isArray(lb) && lb[0] && lb[0].nick) nick = lb[0].nick;
          if(typeof showMsg==='function') showMsg(`đź“¨ ${nick} wysĹ‚aĹ‚ Ci zaproszenie do znajomych!`,'f',5500);
          if(typeof addNotif==='function') addNotif(`đź“¨ ${nick} wysĹ‚aĹ‚ Ci zaproszenie do znajomych (đź“± Znajomi â†’ đź“Ą Zaproszenia)`);
        }
      }
      /* Cleanup: usuĹ„ ze seen tych ktĂłrych juĹĽ nie ma w pending (zaakceptowane/odrzucone) */
      const pendingIds = new Set(fInv.map(i=>i.from_user_id));
      G._socialSeen.friendInvites = G._socialSeen.friendInvites.filter(k=>pendingIds.has(k));
    }
  }catch(e){console.warn('pollSocial friendInvites:',e.message);}
  /* 2. CREW INVITES */
  try{
    const cInv = await _lbFetch(`crew_invites?to_uuid=eq.${G.playerUUID}&status=eq.pending&order=created_at.desc&limit=10`);
    if(Array.isArray(cInv)){
      for(const inv of cInv){
        const key = `${inv.crew_id}_${inv.from_uuid}`;
        if(!G._socialSeen.crewInvites.includes(key)){
          G._socialSeen.crewInvites.push(key);
          if(silent) continue;
          const fromNick = inv.from_nick || 'Lider';
          const crewName = inv.crew_name || 'crew';
          if(typeof showMsg==='function') showMsg(`đźŹ† ${fromNick} zaprasza CiÄ™ do crew "${crewName}"!`,'f',5500);
          if(typeof addNotif==='function') addNotif(`đźŹ† ${fromNick} zaprasza CiÄ™ do crew "${crewName}" (đź“± Crew â†’ đź“Ą Zaproszenia)`);
        }
      }
      const pendingIds = new Set(cInv.map(i=>`${i.crew_id}_${i.from_uuid}`));
      G._socialSeen.crewInvites = G._socialSeen.crewInvites.filter(k=>pendingIds.has(k));
    }
  }catch(e){console.warn('pollSocial crewInvites:',e.message);}
  /* 3. PLAYER MESSAGES (deleguje) */
  if(typeof window._fetchPlayerMessages==='function') await window._fetchPlayerMessages({silent});
  /* 4. CREW CHAT MESSAGES (v2.1.15) â€” gdy gracz jest w crew, sprawdĹş nowe wiadomoĹ›ci grupowe. */
  if(G.playerCrew && G.playerCrew.id){
    try{
      const msgs = await _lbFetch(`crew_messages?crew_id=eq.${G.playerCrew.id}&order=id.desc&limit=20`);
      if(Array.isArray(msgs) && msgs.length>0){
        const lastSeenId = G._socialSeen.lastCrewMsgId || 0;
        const newMsgs = msgs.filter(m => m.id > lastSeenId && m.from_uuid !== G.playerUUID).reverse(); /* chronologicznie */
        G._socialSeen.lastCrewMsgId = Math.max(...msgs.map(m=>m.id));
        if(!silent && newMsgs.length>0){
          for(const m of newMsgs.slice(0,3)){
            const preview = m.text.length>60?m.text.slice(0,57)+'...':m.text;
            if(typeof showMsg==='function') showMsg(`đźŹ† [Crew] ${m.from_nick||'CzĹ‚onek'}: ${preview}`,'f',5500);
            if(typeof addNotif==='function') addNotif(`đźŹ† [Crew] ${m.from_nick||'CzĹ‚onek'}: ${preview}`);
          }
          if(newMsgs.length>3 && typeof showMsg==='function'){
            showMsg(`đź“¨ +${newMsgs.length-3} kolejnych wiadomoĹ›ci w crew`,'f',4000);
          }
        }
      }
    }catch(e){console.warn('pollSocial crewMessages:',e.message);}
  }
};
window._startSocialPoller=function(){
  if(window._socialPollerTimer) return;
  /* Initial silent fetch ĹĽeby zsynchronizowaÄ‡ stan przed pierwszym poll (anti-spam toast po starcie/wczytaniu save) */
  setTimeout(()=>{window._pollSocial({silent:true});}, 2000);
  /* Regularny poll co 30s */
  window._socialPollerTimer = setInterval(()=>{
    window._pollSocial({silent:false});
  }, 30000);
};
window._stopSocialPoller=function(){
  if(window._socialPollerTimer){clearInterval(window._socialPollerTimer);window._socialPollerTimer=null;}
};
window._openPlayerChat=(userId,nick)=>{
  /* v1.9.79: XSS fix â€” escape nick i text przed wstawieniem do innerHTML (audyt P2P SMS) */
  const _esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const cid='player_'+userId;
  if(!G.sms)G.sms={conversations:{},unread:0};
  if(!G.sms.conversations[cid])G.sms.conversations[cid]=[];
  const msgs=G.sms.conversations[cid];
  const safeNick=_esc(nick);
  const html=`
    <div id="ph-title" style="font-weight:700;color:#7ec8e3;padding:10px 14px">đź’¬ Czat z ${safeNick}</div>
    <div style="padding:0 14px;max-height:340px;overflow-y:auto" id="player-chat-msgs">
      ${msgs.length===0?'<div style="text-align:center;color:#556;padding:30px">Brak wiadomoĹ›ci. Napisz pierwszy.</div>':msgs.map(m=>{
        const mine=m.from==='me';
        /* v2.1.120: Wave 4 S37 â€” delivered indicator (âś“ wysĹ‚ane) dla wĹ‚asnych wiadomoĹ›ci. */
        const _statusIndicator=mine?'<div style="font-size:9px;color:#7ec8e3;margin-top:2px;text-align:right">âś“ wysĹ‚ane</div>':'';
        return `<div style="text-align:${mine?'right':'left'};margin:6px 0"><div style="display:inline-block;max-width:80%;background:${mine?'#1a3a5a':'#2a1a3a'};color:#fff;padding:8px 12px;border-radius:12px;font-size:13px">${_esc(m.text)}</div>${_statusIndicator}</div>`;
      }).join('')}
    </div>
    <div style="padding:10px 14px;display:flex;gap:8px">
      <input id="player-chat-input" type="text" placeholder="Napisz wiadomoĹ›Ä‡..." maxlength="200" style="flex:1;background:#0a1525;border:1px solid #2a4a6a;color:#fff;padding:8px 10px;border-radius:6px" onkeydown="if(event.key==='Enter') window._playerChatSend('${userId}','${nick.replace(/'/g,"\\'")}')">
      <button onclick="window._playerChatSend('${userId}','${nick.replace(/'/g,"\\'")}')" class="cbtn" style="background:#27ae60;color:#fff">đź“¨</button>
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneSMS&&renderPhoneSMS()">â† SMS</button></div>`;
  /* v2.0.30: fix selectora â€” container telefonu to #ph-content (linia 476), nie #phone-content.
     WczeĹ›niej selector nie matchowaĹ‚ â†’ klik znajomego "nic siÄ™ nie pokazywaĹ‚". */
  document.getElementById('friend-profile-modal')?.remove();
  const ph=document.getElementById('ph-content');
  if(ph){
    /* OtwĂłrz telefon jeĹ›li zamkniÄ™ty */
    const phEl=document.getElementById('phone');
    if(phEl && !phEl.classList.contains('on')){phEl.classList.add('on');}
    document.getElementById('ph-title')&&(document.getElementById('ph-title').textContent='đź’¬ Czat z '+safeNick);
    ph.innerHTML=html;
    setTimeout(()=>document.getElementById('player-chat-input')?.focus(),50);
  }
};
window._playerChatSend=async(userId,nick)=>{
  const inp=document.getElementById('player-chat-input');
  if(!inp)return;
  const text=inp.value.trim();
  if(text.length<1)return;
  inp.value='';
  await _sendPlayerMessage(userId,nick,text);
  window._openPlayerChat(userId,nick); /* refresh */
};

window._smsQuickReply=function(contactId,type){
  /* v1.9.82: per-MESSAGE tracking (a nie per NPC per dzieĹ„).
     KaĹĽda wiadomoĹ›Ä‡ od NPC moĹĽe byÄ‡ odpowiedziana RAZ. NPC wysyĹ‚a rĂłĹĽne â€” kaĹĽdÄ… gracz odpowiada osobno. */
  const conv=G.sms?.conversations?.[contactId]||[];
  if(conv.length===0) return;
  /* ZnajdĹş ostatniÄ… wiadomoĹ›Ä‡ OD NPC (nie 'me') ktĂłra NIE ma jeszcze odpowiedzi */
  let targetMsgIdx=-1;
  for(let i=conv.length-1;i>=0;i--){
    const m=conv[i];
    if(m.from==='me') continue;
    if(m._replied) continue;
    targetMsgIdx=i; break;
  }
  if(targetMsgIdx<0){
    if(typeof showMsg==='function') showMsg('đź’¬ JuĹĽ odpowiedziaĹ‚eĹ› na wszystkie wiadomoĹ›ci od tego kontaktu. Poczekaj na nowe.','r',4500);
    return;
  }
  const replies={
    thanks:{text:'đź‘Ť OK, dziÄ™ki!',friendDelta:1,energyDelta:0,note:'+1 przyjaĹşĹ„'},
    visit:{text:'Zaraz wpadnÄ™.',friendDelta:0,energyDelta:0,note:'ZobowiÄ…zanie aktywne â€” podejdĹş do NPC ĹĽeby zaliczyÄ‡ (+3 przyjaĹşĹ„, max 2 dni)',pendingVisit:true},
    /* v2.1.66 Amper: call dla SMS-only NPC â€” nie ma fizycznej obecnoĹ›ci, wiÄ™c nie moĹĽna "wpaĹ›Ä‡". */
    call:{text:'Spoko, zadzwoniÄ™ pĂłĹşniej pogadaÄ‡.',friendDelta:2,energyDelta:0,note:'PogadaĹ‚eĹ› z nim przez telefon. +2 przyjaĹşĹ„.'},
    later:{text:'MoĹĽe pĂłĹşniej.',friendDelta:-1,energyDelta:0,note:'-1 przyjaĹşĹ„ (NPC zniechÄ™cony)'}
  };
  const r=replies[type]||replies.thanks;
  _smsReply(contactId,r.text);
  /* v1.9.82: mark target msg as replied */
  if(conv[targetMsgIdx]) conv[targetMsgIdx]._replied=true;
  if(typeof addFriendship==='function' && r.friendDelta!==0) addFriendship(contactId,r.friendDelta);
  if(r.energyDelta<0 && typeof clampStat==='function') G.energy=clampStat('energy',(G.energy||0)+r.energyDelta);
  if(r.pendingVisit){
    if(!G._smsPendingVisit) G._smsPendingVisit={};
    G._smsPendingVisit[contactId]={day:G.day,expiresDay:G.day+2};
    if(typeof addNotif==='function') addNotif(`đź“Ť ${contactId} czeka â€” podejdĹş do niego (max 2 dni) ĹĽeby zaliczyÄ‡ wizytÄ™.`);
    /* v2.0.31: opcja podglÄ…du mapy z podĹ›wietlonÄ… lokalizacjÄ… NPC.
       v2.1.66 Amper: Kamil usuniÄ™ty â€” SMS-only, nie ma fizycznej obecnoĹ›ci. */
    const _mapNpcs=['wiktor','marcin','zbyszek','producent'];
    if(_mapNpcs.includes(contactId) && typeof gameConfirm==='function'){
      const cName=(typeof SMS_CONTACTS!=='undefined' && SMS_CONTACTS[contactId])?SMS_CONTACTS[contactId].name:contactId;
      setTimeout(()=>{
        gameConfirm(`đź“Ť PokazaÄ‡ gdzie znaleĹşÄ‡ ${cName} na mapie miasta?`,()=>{
          const phEl=document.getElementById('phone');
          if(phEl && !phEl.classList.contains('on')){phEl.classList.add('on');}
          if(typeof renderPhoneNPCMap==='function') renderPhoneNPCMap(contactId);
        });
      },400);
    }
  }
  if(typeof showMsg==='function' && r.note) showMsg(`đź’¬ ${r.note}`,'f',3500);
  if(typeof saveGameSilent==='function') saveGameSilent();
};
/* v1.9.79: zaliczenie wizyty przy podejĹ›ciu do NPC */
window._smsCheckPendingVisit=function(contactId){
  /* v1.9.84: validation â€” pomiĹ„ jeĹ›li contactId nie istnieje w SMS_CONTACTS */
  if(typeof SMS_CONTACTS!=='undefined' && !SMS_CONTACTS[contactId]) return;
  if(!G._smsPendingVisit||!G._smsPendingVisit[contactId]) return;
  const pv=G._smsPendingVisit[contactId];
  if(G.day>pv.expiresDay){
    delete G._smsPendingVisit[contactId];
    if(typeof addFriendship==='function') addFriendship(contactId,-2);
    if(typeof addNotif==='function') addNotif(`âŹ° SpĂłĹşniĹ‚eĹ› siÄ™ â€” wizyta wygasĹ‚a (-2 przyjaĹşĹ„)`);
    return;
  }
  if(typeof addFriendship==='function') addFriendship(contactId,3);
  delete G._smsPendingVisit[contactId];
  if(typeof showMsg==='function') showMsg(`đź¤ť Wizyta zaliczona â€” +3 przyjaĹşĹ„!`,'g',3000);
  if(typeof saveGameSilent==='function') saveGameSilent();
};
window._smsExecAction=function(contactId,msgIdx){
  const msg=G.sms.conversations[contactId]?.[msgIdx];
  if(!msg||!msg.action) return;
  msg._actionUsed=true;
  // Akcja moĹĽe byÄ‡ funkcjÄ… lub stringiem (np. otwĂłrz overlay)
  try{
    if(typeof msg.action.fn==='function') msg.action.fn();
    /* v1.9.69: usuniÄ™ty eval() branch â€” dead code, action.fn nigdy nie jest stringiem (audyt final security pass) */
  }catch(e){console.warn('SMS action failed:',e);}
  renderSMSConversation(contactId);
};

/* v1.9.79: Panel przyjaĹşni z NPC + bonusy + mapka lokalizacji (zgĹ‚oszone przez gracza) */
window.renderPhoneFriendships=function(){
  /* v2.0.30: fix â€” container telefonu to #ph-content, nie #phone-content */
  const ph=document.getElementById('ph-content');
  if(!ph) return;
  const NPCS=[
    {id:'wiktor',em:'đź’Ľ',name:'Wiktor',role:'Zleceniodawca',loc:'Chodnik H1 north â€” przy Traphouse (NW)',bonus:'-5% ceny w Drip District (przy 50+ przyjaĹşĹ„)'},
    {id:'producent',em:'đźŽĽ',name:'Producent (Majkel)',role:'WytwĂłrnia muzyczna',loc:'Chodnik H1 north â€” po prawej Studia',bonus:'Lepsze tantiemy z trackĂłw'},
    {id:'manager',em:'đź¤µ',name:'Kamil (MenadĹĽer)',role:'MenadĹĽer kariery',loc:'Chodnik H1 south â€” przed Szpitalem',bonus:'Ă—1.2 do wszystkich zarobkĂłw po podpisaniu managementu'},
    {id:'zbyszek',em:'đźŚ®',name:'Zbyszek',role:'Sprzedawca uliczny',loc:'Centrum â€” budka z kebabem',bonus:'ZniĹĽki na kebab/zupÄ™/energetyk (kup = +1 przyjaĹşĹ„)'},
    {id:'crew',em:'đźŽ§',name:'Crew (DJ/Grafik/Hype)',role:'Ekipa muzyczna',loc:'Chodnik H2 north â€” Ĺ›rodek dolny',bonus:'+15% zarobki koncertĂłw (Ă—Marcin)'},
    {id:'marcin',em:'đźŽ¤',name:'Marcin',role:'Organizator koncertĂłw',loc:'Chodnik H3 north â€” przy Drip District',bonus:'+15% zarobki z koncertĂłw (kombinuje z Crew, cap 2Ă—)'},
    {id:'fan',em:'đźŽ‰',name:'Fani hardcore',role:'Najwierniejsi fani',loc:'Chodnik H3 south â€” fani Drip',bonus:'CzÄ™stsze donacje, autografy'},
    {id:'kamil',em:'đź’¬',name:'Kamil (Stary kumpel)',role:'Wsparcie SMS',loc:'đź“ž Tylko SMS (brak obecnoĹ›ci w mieĹ›cie)',bonus:'Wsparcie i wiadomoĹ›ci w storyline'},
  ];
  document.getElementById('ph-title')&&(document.getElementById('ph-title').textContent='đź¤ť PrzyjaĹşnie z NPC');
  const tiers=[
    {min:100,name:'âť¤ď¸Ź NAJBLIĹ»SI PRZYJACIELE',color:'#e74c3c',mult:'Ă—1.5'},
    {min:75,name:'đź’š PRZYJACIELE',color:'#27ae60',mult:'Ă—1.3'},
    {min:50,name:'đź’™ ZNAJOMI',color:'#3498db',mult:'Ă—1.15'},
    {min:25,name:'âšŞ ZNAJOMY',color:'#aab',mult:'Ă—1.05'},
    {min:0,name:'âš« OBCY',color:'#556',mult:'Ă—1.0'},
  ];
  const _getTier=v=>{for(const t of tiers)if(v>=t.min)return t;return tiers[tiers.length-1];};
  ph.innerHTML=`
    <div style="padding:12px;overflow-y:auto;max-height:480px">
      <div style="text-align:center;font-size:11px;color:#aac;margin-bottom:12px;line-height:1.6">
        KaĹĽdy NPC ma poziom przyjaĹşni 0-100. WyĹĽszy poziom = wiÄ™kszy bonus do zwiÄ…zanych mechanik.<br>
        Buduj przyjaĹşĹ„ przez: zakupy, side quests, SMS odpowiedzi, prezenty.
      </div>
      ${NPCS.map(n=>{
        const v=Math.min(100,G.npcFriendship?.[n.id]||0);
        const tier=_getTier(v);
        return `<div style="background:linear-gradient(135deg,#0a1525,#1a0a2a);border:1px solid #2a3a4a;border-radius:10px;padding:10px 14px;margin-bottom:10px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
            <span style="font-size:28px">${n.em}</span>
            <div style="flex:1">
              <div style="font-weight:700;color:#fff;font-size:14px">${n.name}</div>
              <div style="font-size:11px;color:#aac">${n.role}</div>
            </div>
            <div style="text-align:right">
              <div style="color:${tier.color};font-weight:700;font-size:12px">${tier.name.split(' ')[0]}</div>
              <div style="font-size:10px;color:#aac">${tier.mult}</div>
            </div>
          </div>
          <div style="background:#0a0a14;height:6px;border-radius:3px;overflow:hidden;margin-bottom:6px"><div style="width:${v}%;height:100%;background:linear-gradient(90deg,${tier.color},${tier.color}aa);border-radius:3px"></div></div>
          <div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px">
            <span style="color:#aac">đź“Ť ${n.loc}</span>
            <span style="color:#778">${v}/100</span>
          </div>
          <div style="color:#7ec87e;font-size:11px;line-height:1.5">đź’ˇ ${n.bonus}</div>
        </div>`;
      }).join('')}
      <button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† Telefon</button>
    </div>`;
};

window.renderPhoneNPCMap=function(highlightId){
  /* v2.0.30: fix selektora â€” #ph-content
     v2.0.31: opcjonalny highlightId â€” pulsujÄ…cy pin + banner
     v2.0.32: prawdziwa minimapa z drogami/budynkami zamiast pustego gradientu + poprawione pozycje NPC do faktycznych
     spawnĂłw w grze (wczeĹ›niej Kamil "przy restauracji" miaĹ‚ wx:2120,wy:430 â€” restauracja jest faktycznie wx:1400,wy:2208).
     Kamil usuniÄ™ty â€” to SMS-only kontakt, brak fizycznej obecnoĹ›ci w grze. */
  const ph=document.getElementById('ph-content');
  if(!ph) return;
  document.getElementById('ph-title')&&(document.getElementById('ph-title').textContent='đź“Ť Mapa NPC');
  /* Lokalizacje NPC zsynchronizowane z ROOMS.ulica.objects (v2.1.6: rozrzucone po caĹ‚ej mapie) */
  /* v2.1.66 Amper: pozycje zsynchronizowane z poprawionym layoutem NPC. Marcin obok Sali, Crew bez wystawania na drogÄ™. Tylko fizyczni NPC â€” SMS-only (Kamil, Label, Sponsor, manager) nie sÄ… na mapie. */
  const LOCS=[
    {id:'wiktor',   em:'đź’Ľ',name:'Wiktor',         wx:317, wy:336, desc:'Chodnik H1 north â€” wschĂłd od Traphouse'},
    {id:'producent',em:'đźŽĽ',name:'Majkel',         wx:1867,wy:336, desc:'Chodnik H1 north â€” po prawej Studia'},
    {id:'zbyszek',  em:'đźŚ®',name:'Zbyszek',        wx:1545,wy:748, desc:'Centrum â€” budka z kebabem'},
    {id:'crew',     em:'đźŽ§',name:'Crew',           wx:2499,wy:1781,desc:'Chodnik H2 north â€” wschĂłd od V2 (centrum miasta)'}, /* v2.1.202 [Amper]: sync z ROOMS.ulica.objects npc_crew (2400,1860)â†’(2499,1781) */
    {id:'marcin',   em:'đźŽ¤',name:'Marcin',         wx:2937,wy:624, desc:'Chodnik H1 south â€” obok Sali Koncertowej'},
    {id:'fan',      em:'đźŽ¤',name:'Fan',            wx:1217,wy:3120,desc:'Chodnik H3 south â€” fan przy Drip District'},
  ];
  /* Wymiary mapy ulicy */
  const _ulica=typeof ROOMS!=='undefined'?ROOMS.ulica:null;
  const mapW=(_ulica?.wT||90)*48, mapH=(_ulica?.hT||75)*48;
  /* v2.1.3: SW=320 wystawaĹ‚o za szerokoĹ›Ä‡ telefonu (#phone 340px - padding 12+12 - border 4 = 312px usable).
     Zmniejszone do 280px. SH skaluje proporcjonalnie: 280Ă—3600/4320 = 233px. */
  const SW=280, SH=Math.round(SW*mapH/mapW);
  const SCALE_X=SW/mapW, SCALE_Y=SH/mapH;
  const _hl=highlightId && LOCS.find(l=>l.id===highlightId)?highlightId:null;
  const _hlNpc=_hl?LOCS.find(l=>l.id===_hl):null;
  const banner=_hlNpc?`<div style="background:linear-gradient(135deg,#3a2a05,#5a3a05);border:2px solid #f1c40f;border-radius:8px;padding:8px 12px;margin-bottom:10px;color:#f1c40f;font-weight:700;font-size:12px;animation:pulseGold 1.4s ease-in-out infinite">đź“Ť ${_hlNpc.em} ${_hlNpc.name} oczekuje wizyty â€” podejdĹş w mieĹ›cie (max 2 dni)</div>`:'';
  /* Minimapa Canvas-based â€” drogi (H1/H2/H3 + V1/V2/V3) + strefy budynkĂłw + park + landmarki */
  ph.innerHTML=`
    <style>@keyframes pulseGold{0%,100%{box-shadow:0 0 0 0 rgba(241,196,15,.6)}50%{box-shadow:0 0 12px 4px rgba(241,196,15,.8)}}
    @keyframes pulsePin{0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(241,196,15,.8)}50%{transform:scale(1.25);box-shadow:0 0 16px 6px rgba(241,196,15,.95)}}</style>
    <div style="padding:12px;text-align:center">
      ${banner}
      <div style="font-size:11px;color:#aac;margin-bottom:10px">NajedĹş na pin ĹĽeby zobaczyÄ‡ szczegĂłĹ‚y. Wszystkie budynki miasta zaznaczone.</div>
      <div style="position:relative;width:${SW}px;height:${SH}px;margin:0 auto;border:2px solid #c8a520;border-radius:10px;overflow:hidden;box-shadow:inset 0 0 20px rgba(0,0,0,.6)">
        <canvas id="npc-minimap" width="${SW}" height="${SH}" style="display:block"></canvas>
        <canvas id="npc-minimap-route" width="${SW}" height="${SH}" style="display:block;position:absolute;left:0;top:0;pointer-events:none;z-index:2"></canvas>
        ${LOCS.map(l=>{
          const sx=Math.round(l.wx*SCALE_X);
          const sy=Math.round(l.wy*SCALE_Y);
          const v=G.npcFriendship?.[l.id]||0;
          const isHl=l.id===_hl;
          const extra=isHl?'animation:pulsePin 1.2s ease-in-out infinite;z-index:5;background:linear-gradient(135deg,#e91e8c,#f1c40f);border:3px solid #fff':'';
          return `<div title="${l.name}: ${v}/100 â€” ${l.desc}" style="position:absolute;left:${sx-10}px;top:${sy-10}px;width:20px;height:20px;background:linear-gradient(135deg,#c8a520,#f1c40f);border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.7);z-index:3;${extra}">${l.em}</div>`;
        }).join('')}
        ${(()=>{
          /* v2.1.66 Amper: marker gracza "TY" â€” pokazuje gdzie gracz jest na mapie NPC. */
          if(typeof P==='undefined' || currentRoom!=='ulica') return '';
          const px=Math.round((P.wx||0)*SCALE_X), py=Math.round((P.wy||0)*SCALE_Y);
          return `<div title="Twoja pozycja" style="position:absolute;left:${px-9}px;top:${py-9}px;width:18px;height:18px;background:linear-gradient(135deg,#3498db,#1a6090);border:2px solid #fff;border-radius:50%;box-shadow:0 0 12px rgba(52,152,219,.9);z-index:6;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:900;color:#fff">TY</div>`;
        })()}
      </div>
      <div style="margin-top:10px;text-align:left;font-size:11px;color:#aac;background:#0a0f1a;border:1px solid #1a2535;border-radius:8px;padding:8px 10px">
        ${LOCS.map(l=>{const v=G.npcFriendship?.[l.id]||0;const isHl=l.id===_hl;return `<div style="margin:3px 0${isHl?';color:#f1c40f;font-weight:700':''}">${isHl?'âž¤ ':''}${l.em} <b>${l.name}</b> Â· ${v}/100 Â· <span style="color:#778">${l.desc}</span></div>`;}).join('')}
        <div style="margin-top:8px;padding-top:6px;border-top:1px solid #1a2535;color:#778;font-size:10px">đź’¬ <b>Kamil (Stary kumpel), Label, Sponsor</b> â€” kontakt tylko przez SMS (brak fizycznej obecnoĹ›ci na ulicy).</div>
      </div>
      <button class="cbtn" style="width:100%;margin-top:14px" onclick="renderPhoneHome()">â† Telefon</button>
    </div>`;
  /* v2.1.6: Rysuj minimapÄ™ â€” bez legendy, wszystkie budynki, spĂłjne kolory */
  setTimeout(()=>{
    const cv=document.getElementById('npc-minimap');
    if(!cv) return;
    const ctx=cv.getContext('2d');
    const sx=SCALE_X, sy=SCALE_Y;
    /* TĹ‚o â€” trawa (ciemna zieleĹ„) */
    ctx.fillStyle='#1f3a1f';
    ctx.fillRect(0,0,SW,SH);
    /* Park â€” jaĹ›niejsza zieleĹ„, wx:0-672, wy:864-1248 */
    ctx.fillStyle='#2d5a2d';
    ctx.fillRect(0,864*sy,672*sx,(1248-864)*sy);
    /* Chodniki â€” szary po obu stronach drĂłg */
    ctx.fillStyle='#787880';
    ctx.fillRect(0,288*sy,mapW*sx,(384-288)*sy);
    ctx.fillRect(0,576*sy,mapW*sx,(672-576)*sy);
    ctx.fillRect(0,1824*sy,mapW*sx,(1920-1824)*sy);
    ctx.fillRect(0,2112*sy,mapW*sx,(2208-2112)*sy);
    ctx.fillRect(0,2784*sy,mapW*sx,(2880-2784)*sy);
    ctx.fillRect(0,3072*sy,mapW*sx,(3168-3072)*sy);
    ctx.fillRect(672*sx,0,(768-672)*sx,SH);
    ctx.fillRect(960*sx,0,(1056-960)*sx,SH);
    ctx.fillRect(2112*sx,0,(2208-2112)*sx,SH);
    ctx.fillRect(2400*sx,0,(2496-2400)*sx,SH);
    ctx.fillRect(3360*sx,0,(3456-3360)*sx,SH);
    ctx.fillRect(3648*sx,0,(3744-3648)*sx,SH);
    /* Drogi â€” ciemny asfalt */
    ctx.fillStyle='#2a2a32';
    ctx.fillRect(0,384*sy,mapW*sx,(576-384)*sy);
    ctx.fillRect(0,1920*sy,mapW*sx,(2112-1920)*sy);
    ctx.fillRect(0,2880*sy,mapW*sx,(3072-2880)*sy);
    ctx.fillRect(768*sx,0,(960-768)*sx,SH);
    ctx.fillRect(2208*sx,0,(2400-2208)*sx,SH);
    ctx.fillRect(3456*sx,0,(3648-3456)*sx,SH);
    /* Pasy drogowe â€” ĹĽĂłĹ‚ta linia Ĺ›rodkiem */
    ctx.fillStyle='#c8a520';
    ctx.fillRect(0,480*sy-0.5,mapW*sx,1);
    ctx.fillRect(0,2016*sy-0.5,mapW*sx,1);
    ctx.fillRect(0,2976*sy-0.5,mapW*sx,1);
    ctx.fillRect(864*sx-0.5,0,1,SH);
    ctx.fillRect(2304*sx-0.5,0,1,SH);
    ctx.fillRect(3552*sx-0.5,0,1,SH);
    /* WSZYSTKIE budynki z ROOMS.ulica.objects â€” spĂłjny kolor #5a5a72 fill + #aab border 0.5px */
    const buildings=[
      /* North strip wy:128-288 */
      {wx:90,  wy:128,w:160,h:160},  /* Traphouse */
      {wx:1080,wy:133,w:148,h:155},  /* Sklep muzyczny */
      {wx:1250,wy:133,w:148,h:155},  /* SiĹ‚ownia */
      {wx:1480,wy:128,w:148,h:160},  /* MediaMarkt */
      {wx:1640,wy:133,w:148,h:155},  /* Studio */
      {wx:2680,wy:133,w:148,h:155},  /* Ubrania */
      {wx:3010,wy:133,w:148,h:155},  /* Salon Aut */
      {wx:3760,wy:133,w:148,h:155},  /* Radio */
      {wx:3930,wy:133,w:148,h:155},  /* NieruchomoĹ›ci */
      /* Centralna strefa wy:672-827 */
      {wx:110, wy:672,w:148,h:155},  /* Sklep spoĹĽywczy */
      {wx:440, wy:672,w:130,h:155},  /* Fryzjer */
      {wx:1100,wy:672,w:160,h:155},  /* Merch Studio */
      {wx:1900,wy:672,w:148,h:155},  /* Szpital */
      {wx:2700,wy:672,w:170,h:155},  /* Sala Koncertowa */
      {wx:2960,wy:672,w:148,h:155},  /* IKEA */
      {wx:3190,wy:672,w:148,h:155},  /* Targ */
      {wx:3760,wy:672,w:155,h:155},  /* Kasyno */
      /* South strip wy:2208-2363 */
      {wx:326, wy:2208,w:148,h:155}, /* Supermarket */
      {wx:1080,wy:2208,w:148,h:155}, /* Myjnia */
      {wx:1400,wy:2208,w:148,h:155}, /* Restauracja */
      {wx:1800,wy:2208,w:148,h:155}, /* Budowa */
      {wx:2620,wy:2208,w:148,h:155}, /* Kurier */
      {wx:2920,wy:2208,w:148,h:155}, /* Pizzeria */
      {wx:3200,wy:2208,w:148,h:155}, /* Warsztat */
      /* Drip District wy:2629 + 3168 */
      {wx:2496,wy:2629,w:200,h:155}, /* LV */
      {wx:2712,wy:2629,w:200,h:155}, /* Chanel */
      {wx:2928,wy:2629,w:200,h:155}, /* HermĂ¨s */
      {wx:3144,wy:2629,w:200,h:155}, /* Gucci */
      {wx:2496,wy:3168,w:200,h:155}, /* Balenciaga */
      {wx:2712,wy:3168,w:200,h:155}, /* Bottega */
      {wx:2928,wy:3168,w:200,h:155}, /* Dior */
      {wx:3144,wy:3168,w:200,h:155}, /* Prada */
    ];
    ctx.fillStyle='#5a5a72';
    ctx.strokeStyle='#aab';
    ctx.lineWidth=0.5;
    for(const b of buildings){
      const x=Math.round(b.wx*sx), y=Math.round(b.wy*sy);
      const w=Math.max(2,Math.round(b.w*sx)), h=Math.max(2,Math.round(b.h*sy));
      ctx.fillRect(x,y,w,h);
      ctx.strokeRect(x+0.5,y+0.5,w-1,h-1);
    }
    /* v2.1.66 Amper: rysuj drogÄ™ od gracza do podĹ›wietlonego NPC (jeĹ›li highlightId set). */
    if(_hlNpc && typeof P!=='undefined' && currentRoom==='ulica'){
      const cvR=document.getElementById('npc-minimap-route');
      if(cvR){
        const cR=cvR.getContext('2d');
        const px=Math.round((P.wx||0)*sx), py=Math.round((P.wy||0)*sy);
        const nx=Math.round(_hlNpc.wx*sx), ny=Math.round(_hlNpc.wy*sy);
        cR.clearRect(0,0,SW,SH);
        cR.save();
        /* PulsujÄ…ca linia ĹĽĂłĹ‚to-rĂłĹĽowa, dashowana */
        const _t=Date.now()/100;
        cR.setLineDash([6,4]);cR.lineDashOffset=-_t%10;
        cR.strokeStyle='rgba(241,196,15,.85)';cR.lineWidth=2;
        cR.beginPath();cR.moveTo(px,py);cR.lineTo(nx,ny);cR.stroke();
        /* CieĹ„ linii dla kontrastu */
        cR.setLineDash([]);cR.strokeStyle='rgba(0,0,0,.4)';cR.lineWidth=4;
        cR.globalCompositeOperation='destination-over';
        cR.beginPath();cR.moveTo(px,py);cR.lineTo(nx,ny);cR.stroke();
        cR.restore();
        /* Animacja: re-render co 100ms ĹĽeby dash siÄ™ przesuwaĹ‚ */
        if(!window._npcMapRouteTimer){
          window._npcMapRouteTimer=setInterval(()=>{
            const cv2=document.getElementById('npc-minimap-route');
            if(!cv2){clearInterval(window._npcMapRouteTimer);window._npcMapRouteTimer=null;return;}
            const c2=cv2.getContext('2d');
            c2.clearRect(0,0,SW,SH);
            c2.save();
            const _t2=Date.now()/100;
            c2.setLineDash([6,4]);c2.lineDashOffset=-_t2%10;
            c2.strokeStyle='rgba(241,196,15,.85)';c2.lineWidth=2;
            const _px=Math.round((P.wx||0)*sx), _py=Math.round((P.wy||0)*sy);
            const _nx=Math.round(_hlNpc.wx*sx), _ny=Math.round(_hlNpc.wy*sy);
            c2.beginPath();c2.moveTo(_px,_py);c2.lineTo(_nx,_ny);c2.stroke();
            c2.setLineDash([]);c2.strokeStyle='rgba(0,0,0,.4)';c2.lineWidth=4;
            c2.globalCompositeOperation='destination-over';
            c2.beginPath();c2.moveTo(_px,_py);c2.lineTo(_nx,_ny);c2.stroke();
            c2.restore();
          },120);
        }
      }
    } else if(window._npcMapRouteTimer){
      clearInterval(window._npcMapRouteTimer);
      window._npcMapRouteTimer=null;
    }
  },20);
};
function renderPhoneStats(){
  document.getElementById('ph-title').textContent='đź“Š Statystyki';
  /* v2.1.79 Amper: zwiÄ™kszone czcionki z 11px â†’ 13px + kolor labelu z #778 (slate-gray, sĹ‚aby kontrast) na #cdd (jasnoszary, lepszy kontrast). WczeĹ›niej "SĹ‚awa", "Rep. uliczna" itd. byĹ‚y nieczytelne, wyglÄ…daĹ‚y na niskiej jakoĹ›ci. */
  function statBar(val,max,color,label,emoji){
    /* v2.1.179: Math.floor ĹĽeby nie pokazywaÄ‡ 11.050000000000168/100 (IEEE 754 float precision). */
    const _v=Math.floor(val||0);
    const pct=Math.min(100,Math.round(_v/max*100));
    return `<div style="margin-bottom:9px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <span style="font-size:13px;color:#cdd;font-weight:600">${emoji} ${label}</span>
        <span style="font-size:13px;color:${color};font-weight:800">${_v}${max!==Infinity?'/'+max:''}</span>
      </div>
      <div style="background:#0a0a14;border-radius:3px;height:6px;overflow:hidden">
        <div style="width:${pct}%;height:100%;background:${color};border-radius:3px"></div>
      </div>
    </div>`;
  }
  /* v2.1.88 Amper: KRYTYCZNY BUG FIX â€” UI uĹĽywaĹ‚ `level*150` (liniowo) ale addXP() uĹĽywa `150 * 1.8^(level-1)` (wykĹ‚adniczo).
     Gracz lvl 6 widziaĹ‚ "1738/900 XP" myĹ›lÄ…c ĹĽe ma wystarczajÄ…co, ale faktyczny prĂłg w kodzie to 2834 XP â€” brak levelup mimo nadmiaru wg UI. */
  const xpNeed=Math.floor(150*Math.pow(1.8,G.level-1));
  const xpPct=Math.min(100,Math.round((G.xp/xpNeed)*100));
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen">
      <!-- Identity card -->
      <div style="background:#0a1220;border:1px solid #1a3a5a;border-radius:10px;padding:12px;margin-bottom:10px">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
          <div style="width:36px;height:36px;border-radius:50%;background:#1a2a4a;border:1.5px solid #3498db;display:flex;align-items:center;justify-content:center;font-size:18px">đźŽ¤</div>
          <div>
            <div style="font-size:15px;font-weight:700;color:#fff">${G.name}</div>
            <div style="font-size:11px;color:#667">DzieĹ„ ${G.day} Â· ${CFG.WEATHERS[G.weather]} Â· ${G.car?'đźš— '+G.car.name:'đźš¶ Pieszo'}</div>
          </div>
          <div style="margin-left:auto;text-align:right">
            <div style="font-size:18px;color:#f1c40f;font-weight:700">Lvl ${G.level}</div>
            ${(G.prestige||0)>0?`<div style="font-size:11px;color:#c8a520">${'â…'.repeat(G.prestige)}</div>`:''}
          </div>
        </div>
        <!-- XP bar -->
        <div style="display:flex;justify-content:space-between;font-size:10px;color:#445;margin-bottom:3px"><span>XP</span><span>${G.xp}/${xpNeed}</span></div>
        <div style="background:#0a0a14;border-radius:3px;height:5px;overflow:hidden">
          <div style="width:${xpPct}%;height:100%;background:linear-gradient(90deg,#f1c40f,#f39c12)"></div>
        </div>
      </div>
      <!-- Stat bars -->
      <div style="background:#060e18;border:1px solid #1a2535;border-radius:8px;padding:10px 12px;margin-bottom:8px">
        <div style="font-size:11px;color:#445;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Atrybuty</div>
        ${statBar(G.fame,100,'#9b59b6','SĹ‚awa','â­')}
        ${statBar(G.streetRep,100,'#e67e22','Rep. uliczna','đźŚ†')}
        ${statBar(G.forma||0,typeof getMaxStat==='function'?getMaxStat('forma'):100,'#e67e22','Forma (siĹ‚a) đź’Ş',null)}
        ${statBar(G.fitness||0,typeof getMaxStat==='function'?getMaxStat('fitness'):100,'#27ae60','Kondycja (cardio)','đźŹ')}
        ${statBar(G.drip||0,200,'#c8a520','Drip','đź’Ž')}
      </div>
      <!-- v1.8.61: panel informacyjny o progach reputacji ulicznej -->
      <div style="background:#0a1018;border:1px solid #2a3545;border-radius:8px;padding:10px 12px;margin-bottom:8px">
        <div style="font-size:11px;color:#e67e22;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">đźŚ† Progi reputacji ulicznej</div>
        <div style="font-size:11px;color:#778;margin-bottom:8px">Im wyĹĽsza rep uliczna, tym wiÄ™cej bonusĂłw. Zdobywasz jÄ…: kurier (1 co 5 tras), skate/breakdance (do 4), koncerty (do 9), bity (do 5), random eventy (3-5).</div>
        <div style="display:flex;flex-direction:column;gap:5px">
          <div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:${G.streetRep>=25?'#1a2210':'#0a0a14'};border:1px solid ${G.streetRep>=25?'#3a5018':'#1a1a25'};border-radius:5px;font-size:12px">
            <span style="font-size:14px">${G.streetRep>=25?'âś…':'đź”’'}</span>
            <span style="color:${G.streetRep>=25?'#7ed18b':'#778'};font-weight:700;min-width:30px">25</span>
            <span style="color:${G.streetRep>=25?'#aaa':'#556'}">Kurier pĹ‚aci +20% wiÄ™cej za trasy</span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:${G.streetRep>=50?'#1a2210':'#0a0a14'};border:1px solid ${G.streetRep>=50?'#3a5018':'#1a1a25'};border-radius:5px;font-size:12px">
            <span style="font-size:14px">${G.streetRep>=50?'âś…':'đź”’'}</span>
            <span style="color:${G.streetRep>=50?'#7ed18b':'#778'};font-weight:700;min-width:30px">50</span>
            <span style="color:${G.streetRep>=50?'#aaa':'#556'}">Drip District â€” 5% zniĹĽki na ciuchy</span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:${G.streetRep>=75?'#221a10':'#0a0a14'};border:1px solid ${G.streetRep>=75?'#503a18':'#1a1a25'};border-radius:5px;font-size:12px">
            <span style="font-size:14px">${G.streetRep>=75?'đź‘‘':'đź”’'}</span>
            <span style="color:${G.streetRep>=75?'#f1c40f':'#778'};font-weight:700;min-width:30px">75</span>
            <span style="color:${G.streetRep>=75?'#aaa':'#556'}">+10 sĹ‚awy jednorazowo, Drip District -10%, koncerty przynoszÄ… wiÄ™cej fanĂłw</span>
          </div>
        </div>
      </div>
      <!-- Social stats -->
      <div style="background:#060e18;border:1px solid #1a2535;border-radius:8px;padding:10px 12px;margin-bottom:8px">
        <div style="font-size:11px;color:#445;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">ZasiÄ™gi</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:12px">
          <div style="background:#0a0a14;border-radius:6px;padding:6px 8px;border:1px solid #2a1a3a"><div style="color:#c8a520;font-size:10px;font-weight:700">đź‘Ą FanĂłw</div><div style="color:#fff;font-weight:700;font-size:14px">${(G.fans||0).toLocaleString('pl')}</div></div><div style="background:#0a0a14;border-radius:6px;padding:6px 8px"><div style="color:#556;font-size:10px">đź“± ObserwujÄ…cych</div><div style="color:#aaa;font-weight:700">${G.followers.toLocaleString('pl')}</div></div>
          <div style="background:#0a0a14;border-radius:6px;padding:6px 8px"><div style="color:#556;font-size:10px">đźŽµ Spotify</div><div style="color:#1db954;font-weight:700">${G.spotify.listeners.toLocaleString('pl')}</div></div>
          <div style="background:#0a0a14;border-radius:6px;padding:6px 8px"><div style="color:#556;font-size:10px">đź“ş YouTube</div><div style="color:#e74c3c;font-weight:700">${G.yt.subs.toLocaleString('pl')}</div></div>
          <div style="background:#0a0a14;border-radius:6px;padding:6px 8px"><div style="color:#556;font-size:10px">đźź  SoundCloud</div><div style="color:#ff5500;font-weight:700">${((G.soundcloud&&G.soundcloud.listeners)||0).toLocaleString('pl')}</div></div>
          <div style="background:#0a0a14;border-radius:6px;padding:6px 8px"><div style="color:#556;font-size:10px">đź“» Radio</div><div style="color:#e67e22;font-weight:700">${G.radio.plays.toLocaleString('pl')}</div></div>
        </div>
      </div>
      <!-- Finance -->
      <div style="background:#060e18;border:1px solid #1a2535;border-radius:8px;padding:10px 12px;margin-bottom:8px">
        <div style="font-size:11px;color:#445;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Finanse</div>
        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px"><span style="color:#aaa">đź’° Portfel</span><span style="color:#f1c40f;font-weight:700">${G.money.toLocaleString('pl')} zĹ‚</span></div>
        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px"><span style="color:#aaa">đź’µ ĹÄ…cznie zarobione</span><span style="color:#27ae60;font-weight:700">${(G.totalEarned||0).toLocaleString('pl')} zĹ‚</span></div>
        <div style="display:flex;justify-content:space-between;font-size:13px"><span style="color:#aaa">đźŽ¤ Koncerty</span><span style="color:#7ec8e3;font-weight:700">${G.events.performed}</span></div>
        ${G.crew.length>0?`<div style="display:flex;justify-content:space-between;font-size:13px;margin-top:4px"><span style="color:#aaa">đź‘Ą Ekipa</span><span style="color:#7ec8e3;font-size:12px">${G.crew.map(c=>c.name).join(', ')}</span></div>`:''}
      </div>
      <!-- Achievements summary -->
      <div style="background:#060e18;border:1px solid #1a2535;border-radius:8px;padding:10px 12px;margin-bottom:8px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
          <span style="font-size:11px;color:#445;text-transform:uppercase;letter-spacing:1px">Trofea</span>
          <span style="font-size:11px;color:#f1c40f">${G.achievements.length}/${ACHIEVEMENTS.length}</span>
        </div>
        <div style="background:#0a0a14;border-radius:3px;height:5px;overflow:hidden">
          <div style="width:${Math.round(G.achievements.length/ACHIEVEMENTS.length*100)}%;height:100%;background:linear-gradient(90deg,#c8a520,#f1e060)"></div>
        </div>
      </div>
      ${(G.sleepDebt||0)>0?`<div style="background:#1a0a0a;border:1px solid #3a1a1a;border-radius:8px;padding:10px;color:#e74c3c;font-size:13px;margin-bottom:8px">đź´ NiedobĂłr snu: <strong>${G.sleepDebt}/5</strong> â€” idĹş spaÄ‡!</div>`:''}
      ${G.contract?`<div style="background:#0a1020;border:1px solid #1a3050;border-radius:8px;padding:10px;font-size:12px;color:#7ec8e3;margin-bottom:8px">đź“‹ Kontrakt: ${G.contract.desc} Â· PostÄ™p ${G.contract.progress}/${G.contract.target} Â· Termin: dzieĹ„ ${G.contract.deadline}</div>`:''}
    </div>
      ${(()=>{
        // v1.8.94: Sekcja Prestige zawsze widoczna (z przyciskiem "Co to?") â€” takĹĽe zanim speĹ‚nione wymogi
        const rank=G.prestige||0;
        const nextRank=rank+1;
        const reqs=(typeof getPrestigeReqs==='function')?getPrestigeReqs(nextRank):{level:15,fans:100000};
        const lvlOk=G.level>=reqs.level;
        /* v2.1.37 [Amper]: Prestige sprawdza fanĂłw lojalnych â€” spĂłjnoĹ›Ä‡ z HUD */
  const fansOk=(G.fans||0)>=reqs.fans;
        const ready=lvlOk&&fansOk;
        const currentBonus=G.prestigeBonus?.moneyMult?Math.round((G.prestigeBonus.moneyMult-1)*100):0;
        return `<div style="background:linear-gradient(135deg,#1a1a0a,#0a0a14);border:1px solid #3a3a1a;border-radius:8px;padding:12px;margin-top:8px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <div style="font-size:13px;color:#f1c40f;font-weight:700">â­ Prestige ${rank>0?'â…'.repeat(Math.min(rank,5))+' (rank '+rank+')':'(brak)'}</div>
            <button onclick="showPrestigeInfo()" style="background:rgba(126,200,227,.15);border:1px solid #7ec8e3;color:#7ec8e3;padding:3px 10px;border-radius:6px;cursor:pointer;font-size:10px;font-weight:700;font-family:inherit">â„ąď¸Ź Co to?</button>
          </div>
          ${currentBonus>0?`<div style="font-size:11px;color:#27ae60;margin-bottom:6px">âś“ Permanentny bonus aktywny: <b>+${currentBonus}% wszystkich zarobkĂłw</b></div>`:''}
          <div style="font-size:11px;color:#aac;margin-bottom:8px">Wymogi Prestige ${nextRank}: <b style="color:${lvlOk?'#27ae60':'#e74c3c'}">lvl ${reqs.level}</b> (${G.level}) + <b style="color:${fansOk?'#27ae60':'#e74c3c'}">${reqs.fans.toLocaleString('pl')} fanĂłw</b> (${(G.fans||0).toLocaleString('pl')})</div>
          <button class="bbtn" onclick="${ready?'doPrestige()':'showPrestigeInfo()'}" ${!ready?'style="opacity:.7"':''}>${ready?'â­ WejdĹş w Prestige '+nextRank:'đź”’ Zobacz wymogi'}</button>
        </div>`;
      })()}
      ${(G.spotify.listeners>0||G.tidal.listeners>0||G.radio.beats>0||G.merch.active)?`
      <div style="background:#0a1a0a;border:1px solid #1a4a1a;border-radius:8px;padding:12px;margin-top:8px">
        <div style="font-size:12px;color:#27ae60;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px">Pasywny dochĂłd (na tick)</div>
        ${G.spotify.listeners>0?`<div style="font-size:13px;color:#aaa">đźŽµ Spotify: ~${Math.floor(G.spotify.listeners*.001)} zĹ‚/tick</div>`:''}
        ${G.tidal.listeners>0?`<div style="font-size:13px;color:#aaa">đźŚŠ Tidal: ~${Math.floor(G.tidal.listeners*.0015)} zĹ‚/tick</div>`:''}
        ${G.radio.beats>0?`<div style="font-size:13px;color:#aaa">đź“» Radio: ~${Math.floor(G.radio.beats*0.8)} zĹ‚/tick Ĺ›r.</div>`:''}
        ${G.merch.active?`<div style="font-size:13px;color:#aaa">đź§˘ Merch: ~${Math.floor(G.followers*0.003*80)} zĹ‚/tick Ĺ›r.</div>`:''}
      </div>`:''}
      ${(G.camera||G.mic||G.midiCtrl)?`
      <div style="background:#1a0a0a;border:1px solid #3a1a1a;border-radius:8px;padding:12px;margin-top:8px">
        <div style="font-size:12px;color:#e74c3c;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px">Stan sprzÄ™tu</div>
        ${G.camera?`<div style="font-size:13px;color:${G.camera.quality<50?'#e74c3c':'#aaa'}">đź“ą ${G.camera.name}: ${G.camera.quality}% ${G.camera.quality<50?'âš ď¸Ź Napraw w warsztacie!':''}</div>`:''}
        ${G.mic?`<div style="font-size:13px;color:${G.mic.quality<50?'#e74c3c':'#aaa'}">đźŽ¤ ${G.mic.name}: ${G.mic.quality}% ${G.mic.quality<50?'âš ď¸Ź Napraw w warsztacie!':''}</div>`:''}
        ${G.midiCtrl?`<div style="font-size:13px;color:${G.midiCtrl.quality<50?'#e74c3c':'#aaa'}">đźŽą ${G.midiCtrl.name}: ${G.midiCtrl.quality}% ${G.midiCtrl.quality<50?'âš ď¸Ź Napraw w warsztacie!':''}</div>`:''}
      </div>`:''}
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>
  `;
}

function renderPhoneAchievements(){
  document.getElementById('ph-title').textContent='đźŹ† Trofea';
  const done=G.achievements;
  const pct=Math.round(done.length/ACHIEVEMENTS.length*100);
  // Sort: unlocked first, then locked
  const sorted=[...ACHIEVEMENTS].sort((a,b)=>{const ad=done.includes(a.id),bd=done.includes(b.id);return bd-ad;});
  const achHtml=sorted.map(a=>{
    const unlocked=done.includes(a.id);
    return `<div style="background:${unlocked?'#0a1505':'#06080f'};border:1px solid ${unlocked?'#2a6020':'#141825'};border-radius:10px;padding:10px 8px;text-align:center;${unlocked?'':'opacity:.55'}">
      <div style="font-size:26px;margin-bottom:4px;${unlocked?'':'filter:grayscale(1)'}">${a.icon}</div>
      <div style="font-size:10px;font-weight:700;color:${unlocked?'#7ec87e':'#3a4a5a'};line-height:1.2;margin-bottom:2px">${a.name}</div>
      ${unlocked?`<div style="font-size:9px;color:#3a6a3a;line-height:1.2">${a.desc}</div>`:`<div style="font-size:9px;color:#2a3040;line-height:1.2">${a.desc}</div>`}
    </div>`;
  }).join('');
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen">
      <div style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span style="font-size:13px;color:#f1c40f;font-weight:700">đźŹ† ${done.length} / ${ACHIEVEMENTS.length}</span>
          <span style="font-size:11px;color:#667">${pct}% ukoĹ„czone</span>
        </div>
        <div style="background:#0a0a14;border-radius:4px;height:6px;overflow:hidden">
          <div style="width:${pct}%;height:100%;background:linear-gradient(90deg,#c8a520,#f1e060);transition:width .3s"></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
        ${achHtml}
      </div>
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>
  `;
}

/* v2.1.106: Patch Notes phone app (Wave 6 K51 ghost app fix).
   Pokazuje ostatnie ~30 wpisĂłw z PATCH_NOTES (najnowsze pierwsze), z filtrem kategorii. */
let _patchNotesFilter='all';
let _patchNotesPage=0;
const _PATCH_PER_PAGE=15;
window.renderPhonePatchNotes=function(){
  document.getElementById('ph-title').textContent='đź“‹ Patch Notes';
  const _notes=(typeof PATCH_NOTES!=='undefined'&&Array.isArray(PATCH_NOTES))?PATCH_NOTES:[];
  const _allCats=new Set();
  _notes.forEach(n=>(n.cats||[]).forEach(c=>_allCats.add(c)));
  const _filtered=_patchNotesFilter==='all'?_notes:_notes.filter(n=>(n.cats||[]).includes(_patchNotesFilter));
  const _totalPages=Math.max(1,Math.ceil(_filtered.length/_PATCH_PER_PAGE));
  if(_patchNotesPage>=_totalPages)_patchNotesPage=_totalPages-1;
  const _start=_patchNotesPage*_PATCH_PER_PAGE;
  const _slice=_filtered.slice(_start,_start+_PATCH_PER_PAGE);
  const _escFn=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const _catBtns=['all',...Array.from(_allCats).sort()].map(c=>{
    const active=c===_patchNotesFilter;
    const lbl=c==='all'?'Wszystkie':c;
    return `<button onclick="_patchNotesFilter='${c}';_patchNotesPage=0;window.renderPhonePatchNotes()" style="padding:4px 8px;border-radius:4px;font-size:10px;border:1px solid ${active?'#9b59b6':'#1a2030'};background:${active?'#1a0a25':'#06080f'};color:${active?'#e9b8ff':'#778'};cursor:pointer;margin:2px">${_escFn(lbl)}</button>`;
  }).join('');
  const _notesHtml=_slice.map(n=>{
    const titleSafe=_escFn(n.title||'');
    const verSafe=_escFn(n.ver||'');
    const dateSafe=_escFn(n.date||'');
    const reporterSafe=n.reporter?` <span style="color:#7ec8e3">Â· ${_escFn(n.reporter)}</span>`:'';
    const catsHtml=(n.cats||[]).map(c=>`<span style="font-size:9px;background:#1a0a25;color:#aac;padding:1px 5px;border-radius:3px;margin-right:3px">${_escFn(c)}</span>`).join('');
    const itemsHtml=(n.items||[]).map(it=>{
      const dSafe=(it.d||'').replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>').replace(/`([^`]+)`/g,'<code style="background:#1a1a25;padding:1px 4px;border-radius:3px;font-size:11px;color:#7ec8e3">$1</code>');
      const typeColor={fix:'#27ae60',feature:'#9b59b6',change:'#f1c40f',info:'#7ec8e3'}[it.t]||'#aaa';
      return `<div style="margin-bottom:6px;padding-left:8px;border-left:2px solid ${typeColor};font-size:12px;line-height:1.5;color:#dde">${dSafe}</div>`;
    }).join('');
    return `<div style="background:#0a0a14;border:1px solid #1a1a30;border-radius:8px;padding:10px;margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;flex-wrap:wrap">
        <div style="font-size:13px;color:#e9b8ff;font-weight:800;flex:1">${verSafe} <span style="color:#aaa;font-weight:400">Â· ${dateSafe}${reporterSafe}</span></div>
      </div>
      <div style="margin-bottom:6px">${catsHtml}</div>
      <div style="font-size:13px;color:#fff;font-weight:700;margin-bottom:8px;line-height:1.3">${titleSafe}</div>
      ${itemsHtml}
    </div>`;
  }).join('');
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen">
      <div style="margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px">
        <span style="font-size:12px;color:#9b59b6;font-weight:700">đź“‹ ${_filtered.length} wpis(Ăłw) Â· str. ${_patchNotesPage+1}/${_totalPages}</span>
      </div>
      <div style="margin-bottom:10px;background:#06080f;padding:6px;border-radius:6px;border:1px solid #1a1a30">${_catBtns}</div>
      ${_notesHtml||'<div style="color:#667;text-align:center;padding:20px">Brak wpisĂłw dla wybranej kategorii.</div>'}
      <div style="display:flex;justify-content:space-between;gap:8px;margin-top:8px">
        <button class="cbtn" style="flex:1" ${_patchNotesPage<=0?'disabled':''} onclick="_patchNotesPage--;window.renderPhonePatchNotes()">â† Nowsze</button>
        <button class="cbtn" style="flex:1" ${_patchNotesPage>=_totalPages-1?'disabled':''} onclick="_patchNotesPage++;window.renderPhonePatchNotes()">Starsze â†’</button>
      </div>
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>
  `;
};

// v1.8.73: Phone app â€” Globalna tablica wynikĂłw (Supabase backend)
let _lbCurrentCat='money';
let _lbCurrentScope='alltime';
async function renderPhoneLeaderboard(){
  document.getElementById('ph-title').textContent='đźŚŤ Tablica wynikĂłw';
  // v1.8.79: brak opt-in screen (gra zawsze opt-in) ale gracz manualnie wpisuje nick przy pierwszym wejĹ›ciu.
  G.leaderboardOptIn=true;
  _initPlayerUUID();
  if(!G.globalNick){
    // Pierwszy raz â€” wpisz nick manualnie. Reszta (submit, fetch) dzieje siÄ™ automatycznie potem.
    _lbShowNickPicker();
    return;
  }
  // v1.9.2/v1.9.11: Submit przy otwarciu tabeli â€” z mini-throttle 10s ĹĽeby spam klikania nie wysyĹ‚aĹ‚ 14 POST'Ăłw per klik (anti-DOS/quota burner)
  if(typeof submitAllScores==='function'){
    const _now=Date.now();
    if(!window._lbOpenLastSubmit) window._lbOpenLastSubmit=0;
    if(_now-window._lbOpenLastSubmit>=10000){
      window._lbOpenLastSubmit=_now;
      submitAllScores();
    }
  }
  // GĹ‚Ăłwny widok â€” top 100 dla wybranej kategorii i scope
  const cat=LB_CATEGORIES[_lbCurrentCat];
  const catTabs=Object.entries(LB_CATEGORIES).map(([k,c])=>{
    const active=k===_lbCurrentCat;
    return `<button onclick="_lbCurrentCat='${k}';renderPhoneLeaderboard()" style="background:${active?c.color:'transparent'};border:1px solid ${active?c.color:'#2a3a4a'};color:${active?'#000':c.color};padding:5px 8px;border-radius:5px;cursor:pointer;font-size:10px;font-weight:700;flex:1;min-width:0;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${c.label}">${c.emoji}</button>`;
  }).join('');
  // v1.8.90: trzeci tab "Tylko znajomi" â€” filtruje top-100 do znajomych+gracza
  const friendsCount=(G.friends||[]).length;
  const scopeTabs=`
    <button onclick="_lbCurrentScope='alltime';renderPhoneLeaderboard()" style="background:${_lbCurrentScope==='alltime'?'#7ec8e3':'transparent'};border:1px solid ${_lbCurrentScope==='alltime'?'#7ec8e3':'#2a3a4a'};color:${_lbCurrentScope==='alltime'?'#000':'#7ec8e3'};padding:4px 10px;border-radius:5px;font-size:11px;font-weight:700;cursor:pointer;flex:1">All-time</button>
    <button onclick="_lbCurrentScope='weekly';renderPhoneLeaderboard()" style="background:${_lbCurrentScope==='weekly'?'#f1c40f':'transparent'};border:1px solid ${_lbCurrentScope==='weekly'?'#f1c40f':'#2a3a4a'};color:${_lbCurrentScope==='weekly'?'#000':'#f1c40f'};padding:4px 10px;border-radius:5px;font-size:11px;font-weight:700;cursor:pointer;flex:1">đź“… Weekly</button>
    <button onclick="_lbCurrentScope='friends';renderPhoneLeaderboard()" style="background:${_lbCurrentScope==='friends'?'#9b59b6':'transparent'};border:1px solid ${_lbCurrentScope==='friends'?'#9b59b6':'#2a3a4a'};color:${_lbCurrentScope==='friends'?'#fff':'#9b59b6'};padding:4px 10px;border-radius:5px;font-size:11px;font-weight:700;cursor:pointer;flex:1">đź‘Ą Znajomi (${friendsCount})</button>`;
  // v1.8.82: speedrun ma wĹ‚asnÄ… informacjÄ™ bo wymaga osiÄ…gniÄ™cia 1M fanĂłw ĹĽeby siÄ™ pojawiÄ‡
  let _specialBanner='';
  if(_lbCurrentCat==='speedrun'){
    const fol=G.fans||0;
    const reached=!!G._mile1m;
    const pctTo1M=Math.min(100,Math.round(fol/1000000*100));
    _specialBanner=`<div style="background:rgba(39,174,96,.08);border:1px solid rgba(39,174,96,.35);border-radius:8px;padding:10px 12px;margin-bottom:8px;font-size:11px;line-height:1.55">
      ${reached
        ? `<div style="color:#27ae60;font-weight:700">âś“ OsiÄ…gnÄ…Ĺ‚eĹ› 1M fanĂłw w dniu ${G._mile1mDay||'?'} â€” pojawiasz siÄ™ w rankingu</div>`
        : `<div style="color:#f1c40f;font-weight:700;margin-bottom:6px">âŹ± Aby pojawiÄ‡ siÄ™ tu, osiÄ…gnij 1M fanĂłw</div>
           <div style="color:#aac;margin-bottom:6px">TwĂłj postÄ™p: <b style="color:#fff">${fol.toLocaleString('pl')}</b> / 1 000 000 fanĂłw (${pctTo1M}%)</div>
           <div style="background:#0a0a14;border-radius:3px;height:6px;overflow:hidden;margin-bottom:6px"><div style="width:${pctTo1M}%;height:100%;background:linear-gradient(90deg,#27ae60,#7ed18b)"></div></div>
           <div style="color:#778;font-size:10px">Im mniej dni gry zajmie ci dotarcie do 1M, tym wyĹĽsza pozycja w tabeli (1. = najszybciej).</div>`}
    </div>`;
  }
  // Najpierw szkielet z loading
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen" style="padding:8px 12px">
      <div style="display:flex;gap:3px;margin-bottom:6px">${catTabs}</div>
      <div style="display:flex;gap:6px;margin-bottom:8px">${scopeTabs}</div>
      <div style="background:rgba(${cat.color==='#7ec8e3'?'126,200,227':'255,255,255'},.05);border:1px solid ${cat.color}44;border-radius:8px;padding:10px;margin-bottom:8px;text-align:center">
        <div style="color:${cat.color};font-size:12px;font-weight:700">${cat.label}</div>
        <div style="color:#aac;font-size:10px;margin-top:2px">${_lbCurrentScope==='weekly'?'Reset niedziela 00:00 UTC':_lbCurrentScope==='friends'?'Tylko Ty i Twoi znajomi':'Wyniki wszech czasĂłw'}</div>
      </div>
      ${_specialBanner}
      <!-- v1.8.93: Live ticker â€” ostatnie 5 zmian rankingu w real-time -->
      <div id="lb-ticker" style="display:none"></div>
      <div id="lb-list" style="text-align:center;color:#778;font-size:12px;padding:20px">âŹł Ĺadowanie...</div>
      <div style="color:#667;font-size:10px;text-align:center;padding:6px 0;font-style:italic">TwĂłj wynik aktualizuje siÄ™ automatycznie co minutÄ™ gry</div>
      <div style="padding:4px 0;display:flex;gap:6px;flex-wrap:wrap">
        <button class="cbtn" style="flex:1;min-width:90px" onclick="renderHallOfFame()">đźŹ› Hall of Fame</button>
        <button class="cbtn" style="flex:1;min-width:90px" onclick="renderTitlesGuide()">đźŹ… TytuĹ‚y</button>
        <button class="cbtn" style="flex:1;min-width:90px" onclick="renderPhoneHome()">â† WrĂłÄ‡</button>
      </div>
    </div>`;
  // Live ticker: top 5 latest updates globalnie (wszystkie kategorie)
  _lbFetch(`leaderboard?order=updated_at.desc&limit=5`).then(latest=>{
    if(!Array.isArray(latest)||latest.length===0) return;
    const tickerEl=document.getElementById('lb-ticker');if(!tickerEl) return;
    tickerEl.style.display='';
    const items=latest.map(r=>{
      const lcat=LB_CATEGORIES[r.category];
      const t=_friendThemeColor(r.nick);
      return `<span style="color:${t.primary};font-weight:700">${r.nick}</span><span style="color:#aac"> Â· ${lcat?lcat.emoji:''} ${(r.score||0).toLocaleString('pl')}${lcat?.unit?' '+lcat.unit:''} Â· </span><span style="color:#778;font-size:10px">${_timeAgoLB(r.updated_at)}</span>`;
    }).join('<span style="color:#445;margin:0 8px">|</span>');
    /* v2.1.1: marquee scroll â€” content jeĹşdzi w lewo ĹĽeby nick nie byĹ‚ ucinany.
       Dystans/czas zaleĹĽny od iloĹ›ci znakĂłw ĹĽeby fast/slow content miaĹ‚ spĂłjnÄ… prÄ™dkoĹ›Ä‡. */
    const tickerLen=latest.reduce((s,r)=>s+String(r.nick||'').length+30,0);
    const tickerDur=Math.max(20,Math.round(tickerLen*0.35));
    tickerEl.innerHTML=`<style>@keyframes lbTickerScroll{0%{transform:translateX(100%)}100%{transform:translateX(-100%)}}.lb-ticker-track{display:inline-block;animation:lbTickerScroll ${tickerDur}s linear infinite;padding-left:20px}</style>
      <div style="background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.3);border-radius:8px;padding:6px 10px;margin-bottom:8px;font-size:11px;display:flex;align-items:center;gap:8px;overflow:hidden;white-space:nowrap">
        <span style="color:#e74c3c;font-weight:900;letter-spacing:1px;flex-shrink:0">đź”´ LIVE</span>
        <div style="flex:1;overflow:hidden"><span class="lb-ticker-track">${items}</span></div>
      </div>`;
  });
  // Async fetch
  /* v2.1.117: Wave 6 W58 â€” try/catch ĹĽeby spinner nie zostawaĹ‚ w nieskoĹ„czonoĹ›Ä‡ przy network fail. */
  let list;
  try{
    list=await fetchLeaderboard(_lbCurrentCat,_lbCurrentScope);
  }catch(e){
    const containerErr=document.getElementById('lb-list');
    if(containerErr) containerErr.innerHTML='<div style="color:#e74c3c;padding:20px;text-align:center">âťŚ Brak poĹ‚Ä…czenia z serwerem rankingowym. SprawdĹş internet i ponĂłw prĂłbÄ™.<br><button onclick="renderPhoneLeaderboard()" style="margin-top:12px;padding:8px 16px;background:#1a3a5a;color:#7ec8e3;border:1px solid #2a5a7a;border-radius:6px;cursor:pointer">đź”„ PonĂłw</button></div>';
    return;
  }
  const container=document.getElementById('lb-list');
  if(!container) return; // user wyszedĹ‚
  if(list.length===0){
    const emptyMsg=_lbCurrentScope==='friends'
      ? ((G.friends||[]).length===0
          ? 'Nie masz jeszcze znajomych.<br><br>OtwĂłrz đź‘Ą Znajomi aby dodaÄ‡ kogoĹ› po jego kodzie TRAP-XXXX-XXXX.'
          : 'Twoi znajomi nie majÄ… jeszcze wynikĂłw w tej kategorii.<br><br>Dodaj wiÄ™cej znajomych albo poczekaj aĹĽ coĹ› osiÄ…gnÄ….')
      : _lbCurrentCat==='speedrun'
        ? 'Jeszcze nikt nie ukoĹ„czyĹ‚ speedrunu do 1M fanĂłw.<br><br>BÄ…dĹş pierwszy!'
        : 'Brak wynikĂłw w tej kategorii.<br><br>TwĂłj wynik pojawi siÄ™ tu w ciÄ…gu minuty (auto-submit).';
    container.innerHTML=`<div style="color:#778;padding:20px">${emptyMsg}</div>`;
    return;
  }
  // v1.8.93/v1.9.2/v1.9.6: Rank delta â€” cache pozycji + scores w localStorage
  // v1.9.6: Trackujemy zarĂłwno rank (pozycjÄ™) JAK I score gracza â€” bo solo gracz nie zmienia rank ale score roĹ›nie ciÄ…gle
  // Trzy widoczne stany: â†‘X/â†“X (zmiana pozycji), âś¨ NEW (pierwszy raz widziany), â€˘ (score wzrĂłsĹ‚ na tym samym miejscu)
  if(!window._lbRankCache){
    try{ window._lbRankCache=JSON.parse(localStorage.getItem('trapsim_lb_ranks')||'{}')||{}; }
    catch(e){ window._lbRankCache={}; }
    if(typeof window._lbRankCache!=='object' || window._lbRankCache===null) window._lbRankCache={};
  }
  const cacheKey=_lbCurrentCat+'|'+_lbCurrentScope;
  let prevState=(window._lbRankCache && window._lbRankCache[cacheKey])||{};
  // v1.9.6: Migracja starego formatu (samo number â†’ {r,s})
  const _firstVal=Object.values(prevState)[0];
  if(typeof _firstVal==='number'){
    const migrated={};
    for(const k of Object.keys(prevState)) migrated[k]={r:prevState[k],s:0};
    prevState=migrated;
  }
  const newState={};
  list.forEach((e,i)=>{newState[e.user_id]={r:i+1,s:e.score||0};});
  // SprawdĹş czy mamy w ogĂłle jakÄ…Ĺ› poprzedniÄ… migawkÄ™ (czy to pierwszy render â€” wtedy zachowaj zachowanie spokojne)
  const hadPrev=Object.keys(prevState).length>0;
  const deltaFor=(uid)=>{
    const prev=prevState[uid]; const cur=newState[uid];
    if(!cur) return '';
    if(!hadPrev) return ''; // pierwszy render kiedykolwiek â€” bez badge'y ĹĽeby nie spamowaÄ‡ NEW dla kaĹĽdego
    if(!prev) return `<span style="color:#f1c40f;font-size:9px;font-weight:800;margin-left:3px;animation:lbDeltaPulse 1.5s ease-out" title="Nowy w rankingu">âś¨ NEW</span>`;
    const dRank=prev.r-cur.r;
    if(dRank>0) return `<span style="color:#27ae60;font-size:9px;font-weight:800;margin-left:3px;animation:lbDeltaPulse 1.5s ease-out" title="W gĂłrÄ™ o ${dRank}">â†‘${dRank}</span>`;
    if(dRank<0) return `<span style="color:#e74c3c;font-size:9px;font-weight:800;margin-left:3px;animation:lbDeltaPulse 1.5s ease-out" title="W dĂłĹ‚ o ${-dRank}">â†“${-dRank}</span>`;
    // Pozycja ta sama â€” ale score mĂłgĹ‚ siÄ™ zmieniÄ‡ (gracz solo / nikt nie zmienia rankingu)
    const dScore=(cur.s||0)-(prev.s||0);
    if(dScore>0){
      const fmt=dScore>=1000?(dScore>=1000000?Math.round(dScore/1000000)+'M':Math.round(dScore/1000)+'k'):dScore;
      return `<span style="color:#7ec8e3;font-size:9px;font-weight:700;margin-left:3px;animation:lbDeltaPulse 1.5s ease-out" title="Wzrost wyniku o ${dScore.toLocaleString('pl')} (pozycja bez zmian)">+${fmt}</span>`;
    }
    return '';
  };
  window._lbRankCache[cacheKey]=newState;
  try{ localStorage.setItem('trapsim_lb_ranks',JSON.stringify(window._lbRankCache)); }catch(e){}
  const myIdx=list.findIndex(e=>e.user_id===G.playerUUID);
  // v1.8.93: Rivalry â€” gracz tuĹĽ przede mnÄ… w aktualnej kategorii
  let rivalryBanner='';
  if(myIdx>0){
    const rival=list[myIdx-1];
    const myScore=list[myIdx].score||0;
    const rivalScore=rival.score||0;
    const gap=Math.abs(rivalScore-myScore);
    const rivalTheme=_friendThemeColor(rival.nick);
    rivalryBanner=`<div style="background:linear-gradient(135deg,${rivalTheme.primary}22,#0a0a14);border:1px solid ${rivalTheme.primary}88;border-radius:8px;padding:8px 12px;margin-bottom:8px;font-size:11px">
      <div style="color:${rivalTheme.primary};font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:3px">âš”ď¸Ź TwĂłj rywal</div>
      <div style="color:#fff;font-size:13px">${rival.nick} jest <b style="color:${cat.color}">${gap.toLocaleString('pl')}${cat.unit?' '+cat.unit:''}</b> przed TobÄ…</div>
      <div style="color:#aac;font-size:10px;margin-top:2px">WyprzedĹş go aby objÄ…Ä‡ pozycjÄ™ <b style="color:#f1c40f">#${myIdx}</b></div>
    </div>`;
  } else if(myIdx===0){
    rivalryBanner=`<div style="background:linear-gradient(135deg,#f1c40f22,#0a0a14);border:1px solid #f1c40f88;border-radius:8px;padding:8px 12px;margin-bottom:8px;font-size:11px;text-align:center">
      <div style="color:#f1c40f;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:2px">đź‘‘ JESTEĹš #1!</div>
      <div style="color:#fff;font-size:12px">Brak rywala w tej kategorii â€” utrzymaj pozycjÄ™!</div>
    </div>`;
  }
  const rows=list.map((e,i)=>{
    const isMe=e.user_id===G.playerUUID;
    const rankColor=i===0?'#f1c40f':i===1?'#bdc3c7':i===2?'#cd7f32':'#778';
    const rankLabel=i===0?'đźĄ‡':i===1?'đźĄ':i===2?'đźĄ‰':'#'+(i+1);
    const titleChip=e.title?_lbRenderTitleChip(e.title):'';
    const delta=deltaFor(e.user_id);
    // v1.9.2: Klik gracz â†’ modal profilu (dla znajomych: porĂłwnanie; dla obcych: opcja "Dodaj do znajomych")
    const _safeNick=(e.nick||'').replace(/['"\\]/g,''); // strip apostrofy/cudzysĹ‚owy/backslash dla bezpiecznego HTML attribute
    const clickHandler=isMe?'':`onclick="_lbOpenPlayerCard('${e.user_id}','${_safeNick}')"`;
    const cursor=isMe?'default':'pointer';
    return `<div ${clickHandler} style="display:flex;align-items:center;gap:6px;padding:6px 8px;background:${isMe?'rgba(241,196,15,.12)':'transparent'};border:1px solid ${isMe?'#f1c40f':'transparent'};border-radius:6px;margin-bottom:3px;font-size:12px;cursor:${cursor};transition:background .15s" ${isMe?'':`onmouseover="this.style.background='rgba(255,255,255,.04)'" onmouseout="this.style.background='transparent'"`}>
      <span style="color:${rankColor};min-width:32px;font-weight:700;flex-shrink:0">${rankLabel}${delta}</span>
      ${_renderMiniAvatar(e.avatar)}
      ${_renderFlag(e.country)}
      <span style="flex:1;color:#fff;font-weight:${isMe?'700':'500'};word-break:break-word;line-height:1.2;min-width:0">${e.nick}${isMe?' <span style="color:#f1c40f;font-size:10px">(ja)</span>':''}${titleChip}</span>
      <span style="color:${cat.color};font-weight:700;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;line-height:1.15;gap:2px">
        <span>${(e.score||0).toLocaleString('pl')}${cat.unit?' '+cat.unit:''}</span>
        ${_lbCurrentCat!=='speedrun' ? `<span style="font-size:11px;color:#aac;font-weight:600;background:rgba(170,200,220,.10);padding:1px 6px;border-radius:4px" title="Liczba dni gry w momencie wysĹ‚ania wyniku">đź“… ${e.game_day||'?'} dni</span>` : ''}
      </span>
    </div>`;
  }).join('');
  const myRow=myIdx<0?`<div style="color:#778;font-size:11px;text-align:center;padding:8px 0;border-top:1px dashed #2a3a4a;margin-top:8px">TwĂłj wynik jeszcze nie wysĹ‚any â€” pojawi siÄ™ tu automatycznie w ciÄ…gu minuty.</div>`:`<div style="color:#aac;font-size:11px;text-align:center;padding:8px 0;border-top:1px dashed #2a3a4a;margin-top:8px">Twoja pozycja: <b style="color:${cat.color}">#${myIdx+1}</b> z ${list.length}</div>`;
  container.innerHTML=rivalryBanner+rows+myRow;
}
// v1.8.93: Hall of Fame â€” top 1 z kaĹĽdej kategorii all-time
async function renderHallOfFame(){
  document.getElementById('ph-title').textContent='đźŹ› Hall of Fame';
  document.getElementById('ph-content').innerHTML=`<div style="text-align:center;color:#aac;padding:40px 20px;font-size:13px">âŹł Ĺadowanie hall of fame...</div>`;
  // Fetch top 1 per category w jednej kolejce â€” robimy 7 paralelnych queries
  const cats=Object.entries(LB_CATEGORIES);
  const top1s=await Promise.all(cats.map(([k,c])=>{
    const order=c.lowerIsBetter?'score.asc':'score.desc';
    return _lbFetch(`leaderboard?category=eq.${k}&period_key=eq.alltime&order=${order}&limit=1`);
  }));
  // Render
  const cardsHtml=cats.map(([k,c],i)=>{
    const row=Array.isArray(top1s[i])?top1s[i][0]:null;
    if(!row) return `<div style="background:#0a0e18;border:1px solid #1a2535;border-radius:10px;padding:12px;text-align:center">
      <div style="font-size:22px;margin-bottom:4px">${c.emoji}</div>
      <div style="color:${c.color};font-size:11px;font-weight:800;letter-spacing:.5px;margin-bottom:6px">${c.label}</div>
      <div style="color:#556;font-size:11px;font-style:italic">Brak danych</div>
    </div>`;
    const theme=_friendThemeColor(row.nick);
    const isMe=row.user_id===G.playerUUID;
    const titleChip=row.title?_lbRenderTitleChip(row.title):'';
    return `<div style="background:linear-gradient(135deg,${theme.primary}22,${c.color}11);border:1px solid ${theme.primary}66;border-left:3px solid ${c.color};border-radius:10px;padding:10px 12px">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
        <span style="font-size:18px">${c.emoji}</span>
        <span style="color:${c.color};font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase">${c.label}</span>
      </div>
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
        <span style="font-size:18px">đź‘‘</span>
        ${_renderMiniAvatar(row.avatar)}${_renderFlag(row.country)}
        <span style="flex:1;color:#fff;font-weight:800;font-size:13px;word-break:break-word;line-height:1.2">${row.nick}${isMe?' <span style="color:#f1c40f;font-size:10px">(TY!)</span>':''}${titleChip}</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:11px;color:#aac;padding:0 4px">
        <span><b style="color:${c.color}">${(row.score||0).toLocaleString('pl')}${c.unit?' '+c.unit:''}</b></span>
        <span style="color:#778;font-size:10px">Aktualizacja: ${_timeAgoLB(row.updated_at)}</span>
      </div>
    </div>`;
  }).join('');
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen" style="padding:8px 12px">
      <div style="background:linear-gradient(135deg,#5a3a0a,#3a1a1a);border:2px solid #c8a520;border-radius:12px;padding:12px;margin-bottom:10px;text-align:center;box-shadow:0 4px 20px rgba(200,165,32,.3)">
        <div style="font-size:24px;margin-bottom:4px">đźŹ›</div>
        <h2 style="color:#f1c40f;font-size:18px;margin:0;letter-spacing:2px">HALL OF FAME</h2>
        <p style="color:#aac;font-size:11px;margin:4px 0 0 0">Najlepsi w kaĹĽdej kategorii â€” all-time</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:10px">${cardsHtml}</div>
      <button class="cbtn" style="width:100%" onclick="renderPhoneLeaderboard()">â† WrĂłÄ‡ do rankingu</button>
    </div>`;
}

/* v2.1.47 [Amper]: panel "TytuĹ‚y" â€” lista wszystkich tytuĹ‚Ăłw + warunki w prostym jÄ™zyku.
   TytuĹ‚y to plakietki obok nicka w rankingu (np. đź’Ž LEGENDA). System przyznaje najwyĹĽszy aktywny z listy. */
const _LB_TITLE_DESCRIPTIONS = {
  legend:     'Min. 1 000 000 fanĂłw + Prestige co najmniej 2.',
  prestige5:  'Prestige co najmniej 5 (5Ă— przejĹ›cie New Game+).',
  trapboss:   'ĹÄ…cznie zarobione co najmniej 10 000 000 zĹ‚.',
  megafan:    'Min. 1 000 000 obserwujÄ…cych (Twitter + Instagram).',
  speedrun30: '1 000 000 fanĂłw w 30 dni gry lub szybciej.',
  achiever:   'Zdobyte co najmniej 50 osiÄ…gniÄ™Ä‡.',
  highroller: 'ĹÄ…cznie wygrane w kasynie co najmniej 500 000 ĹĽetonĂłw.',
  prestige1:  'Prestige co najmniej 1 (jedno przejĹ›cie New Game+).',
  milioner:   'ĹÄ…cznie zarobione co najmniej 1 000 000 zĹ‚.',
  star100k:   'Min. 100 000 obserwujÄ…cych.',
  rookie:     'Min. 100 fanĂłw lub Ĺ‚Ä…cznie zarobione co najmniej 1 000 zĹ‚.',
  newbie:     'TytuĹ‚ startowy â€” kaĹĽdy Ĺ›wieĹĽy gracz go ma, pĂłki nie odblokuje wyĹĽszego.',
};
function renderTitlesGuide(){
  document.getElementById('ph-title').textContent='đźŹ… TytuĹ‚y graczy';
  const myTitleId = _lbComputeTitle(G)?.id || null;
  const rows = LB_TITLES.map(t=>{
    const isActive = t.id === myTitleId;
    const got = !!t.cond(G);
    const bg = isActive ? `linear-gradient(135deg,${t.color}33,${t.color}11)` : (got ? '#0a0e18' : '#06080f');
    const border = isActive ? t.color : (got ? `${t.color}55` : '#1a2535');
    const opacity = got ? 1 : 0.55;
    const statusChip = isActive
      ? `<span style="color:#f1c40f;font-size:9px;font-weight:800;letter-spacing:.5px;background:#f1c40f22;padding:2px 6px;border-radius:6px;border:1px solid #f1c40f55">â… TWĂ“J TYTUĹ</span>`
      : (got
          ? `<span style="color:#27ae60;font-size:9px;font-weight:700;background:#27ae6022;padding:2px 6px;border-radius:6px;border:1px solid #27ae6055">âś“ ZDOBYTY</span>`
          : `<span style="color:#778;font-size:9px;font-weight:700;background:#1a2535;padding:2px 6px;border-radius:6px;border:1px solid #2a3a4a">đź”’ ZABLOKOWANY</span>`);
    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:${bg};border:1px solid ${border};border-radius:8px;margin-bottom:6px;opacity:${opacity};transition:all .2s">
      <span style="font-size:26px;flex-shrink:0;line-height:1">${t.emoji}</span>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px">
          <span style="color:${t.color};font-weight:900;font-size:13px;letter-spacing:1px">${t.label}</span>
          ${statusChip}
        </div>
        <div style="color:#aac;font-size:11px;line-height:1.35">${_LB_TITLE_DESCRIPTIONS[t.id]||'(brak opisu)'}</div>
      </div>
    </div>`;
  }).join('');
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen" style="padding:8px 12px">
      <div style="background:linear-gradient(135deg,#1a3a5a,#0a1015);border:1px solid #7ec8e3;border-radius:10px;padding:10px 12px;margin-bottom:10px">
        <div style="color:#7ec8e3;font-size:14px;font-weight:800;letter-spacing:1px;margin-bottom:4px">đźŹ… SYSTEM TYTUĹĂ“W</div>
        <div style="color:#dde;font-size:11px;line-height:1.5">TytuĹ‚y to plakietki przy Twoim nicku w tablicy wynikĂłw i Hall of Fame.<br>Gra automatycznie pokazuje <b style="color:#f1c40f">najwyĹĽszy tytuĹ‚, jaki masz odblokowany</b> â€” od gĂłry listy w dĂłĹ‚, pierwszy speĹ‚niony wygrywa.</div>
      </div>
      ${rows}
      <button class="cbtn" style="width:100%;margin-top:8px" onclick="renderPhoneLeaderboard()">â† WrĂłÄ‡ do rankingu</button>
    </div>`;
}

// v1.8.81: usuniÄ™te _lbManualSubmit() i _lbStartOptIn() â€” martwy kod po refaktorze v1.8.79.
// Auto-submit dzieje siÄ™ w maybeAutoSubmitScores() (throttled co 60s), nick claim w _lbTryClaimNick().
async function _lbShowNickPicker(initialNick){
  const _cur=initialNick||G.globalNick||G.name||'';
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen" style="padding:18px">
      <div style="background:linear-gradient(180deg,#0a1530,#06101e);border:1px solid #2a4a6a;border-radius:12px;padding:16px">
        <div style="text-align:center;font-size:32px;margin-bottom:6px">đźŚŤ</div>
        <h3 style="color:#7ec8e3;margin:0 0 4px 0;font-size:15px;text-align:center">TwĂłj nick globalny</h3>
        <p style="color:#aac;font-size:11px;line-height:1.5;margin-bottom:12px;text-align:center">
          Pod jakim nickiem chcesz pojawiÄ‡ siÄ™ na globalnej tablicy?<br>3-16 znakĂłw: litery, cyfry, _, -
        </p>
        <input id="lb-nick-input" type="text" value="${_cur.replace(/"/g,'')}" maxlength="16" onkeydown="if(event.key==='Enter') _lbTryClaimNick()" style="width:100%;background:#050a14;border:1px solid #2a4a6a;color:#fff;padding:8px 10px;border-radius:6px;font-size:14px;font-family:inherit;box-sizing:border-box;margin-bottom:8px" placeholder="np. Traper">
        <div id="lb-nick-status" style="font-size:11px;min-height:16px;text-align:center;color:#aac;margin-bottom:10px"></div>
        <button class="cbtn" style="width:100%;background:#1a3a5a;border-color:#7ec8e3;color:#fff" onclick="_lbTryClaimNick()">âś“ ZatwierdĹş nick</button>
        <button class="cbtn" style="width:100%;margin-top:6px;background:transparent;border-color:#3a4a5a;color:#778" onclick="renderPhoneHome()">â† WrĂłÄ‡</button>
      </div>
    </div>`;
  setTimeout(()=>document.getElementById('lb-nick-input')?.focus(),50);
}
async function _lbTryClaimNick(){
  const input=document.getElementById('lb-nick-input');
  const status=document.getElementById('lb-nick-status');
  if(!input||!status) return;
  const nick=input.value.trim();
  if(!/^[A-Za-z0-9 _-]{3,16}$/.test(nick)){status.style.color='#e74c3c';status.textContent='âťŚ Nick musi mieÄ‡ 3-16 znakĂłw (litery, cyfry, _, -)';return;}
  status.style.color='#aac';status.textContent='âŹł Sprawdzam dostÄ™pnoĹ›Ä‡...';
  const available=await checkNickAvailable(nick);
  if(!available){status.style.color='#e74c3c';status.textContent='âťŚ Ten nick jest juĹĽ zajÄ™ty â€” wybierz inny';return;}
  status.style.color='#f1c40f';status.textContent='âś“ Wolny, rezerwujÄ™...';
  const ok=await claimNick(nick);
  if(!ok){status.style.color='#e74c3c';status.textContent='âťŚ Nie udaĹ‚o siÄ™ zarezerwowaÄ‡ â€” sprĂłbuj ponownie';return;}
  if(typeof saveGameSilent==='function') saveGameSilent();
  status.style.color='#27ae60';status.textContent='âś… Nick "'+nick+'" zarezerwowany!';
  // WyĹ›lij wszystkie scoresy
  await submitAllScores();
  setTimeout(()=>renderPhoneLeaderboard(),800);
}

// v1.8.91: Friends system â€” ULTIMATE upgrade
// Helpers
function _friendThemeColor(nick){
  if(!nick) return {primary:'#7ec8e3',accent:'#3498db'};
  let h=0;
  for(let i=0;i<nick.length;i++) h=(h*31+nick.charCodeAt(i))&0xffff;
  const hue=h%360;
  return {primary:`hsl(${hue},65%,55%)`,accent:`hsl(${hue},55%,40%)`};
}
function _timeAgoLB(isoTimestamp){
  if(!isoTimestamp) return 'nigdy';
  const then=new Date(isoTimestamp).getTime();
  if(isNaN(then)) return 'nigdy';
  const diff=Math.max(0,Date.now()-then);
  const min=Math.floor(diff/60000);
  if(min<2) return 'aktywny teraz';
  if(min<60) return `${min} min temu`;
  const hr=Math.floor(min/60);
  if(hr<24) return `${hr}h temu`;
  const dd=Math.floor(hr/24);
  if(dd<7) return `${dd} dni temu`;
  if(dd<30) return `${Math.floor(dd/7)} tyg. temu`;
  return `${Math.floor(dd/30)} mies. temu`;
}
function _statusIndicator(isoTimestamp){
  if(!isoTimestamp) return {dot:'âš«',label:'offline',color:'#556'};
  const diff=Date.now()-new Date(isoTimestamp).getTime();
  if(diff<5*60000) return {dot:'đźź˘',label:'aktywny',color:'#27ae60'};
  if(diff<60*60000) return {dot:'đźźˇ',label:'niedawno',color:'#f39c12'};
  return {dot:'âš«',label:'offline',color:'#556'};
}
// Cache po fetchAllFriendsData
let _lbAllFriendsCache=null;
async function fetchAllFriendsData(){
  const friendsList=G.friends||[];
  if(friendsList.length===0) return {scoreMap:new Map(),aggregateMoney:0,aggregateFans:0,latestActivity:null};
  const userIds=friendsList.map(f=>f.userId).join(',');
  // Pobierz wszystkie kategorie all-time dla wszystkich znajomych
  const allRows=await _lbFetch(`leaderboard?user_id=in.(${userIds})&period_key=eq.alltime&limit=500`);
  const scoreMap=new Map(); // userId â†’ {money, fans, level, achievements, casino, speedrun, country, avatar, nick, updated_at}
  let aggMoney=0,aggFans=0;
  let latestActivity=null,latestActivityFriend=null;
  if(Array.isArray(allRows)){
    for(const r of allRows){
      if(!scoreMap.has(r.user_id)) scoreMap.set(r.user_id,{nick:r.nick,country:r.country,avatar:r.avatar,updated_at:r.updated_at});
      const obj=scoreMap.get(r.user_id);
      obj[r.category]=r.score;
      // Track most recent activity
      if(r.updated_at && (!latestActivity || r.updated_at>latestActivity)){
        latestActivity=r.updated_at;
        latestActivityFriend=r.nick;
      }
      // Update timestamp w obj
      if(!obj.updated_at || r.updated_at>obj.updated_at) obj.updated_at=r.updated_at;
    }
    // Aggregate sums
    for(const [,obj] of scoreMap){
      aggMoney+=obj.money||0;
      aggFans+=obj.fans||0;
    }
  }
  return {scoreMap,aggregateMoney:aggMoney,aggregateFans:aggFans,latestActivity,latestActivityFriend};
}
// Suggested friends â€” top w money/fans ktĂłrych nie mam jeszcze + nie jestem ja
async function fetchSuggestedFriends(){
  const rows=await _lbFetch(`leaderboard?category=eq.money&period_key=eq.alltime&order=score.desc&limit=20`);
  if(!Array.isArray(rows)) return [];
  const myFriends=new Set((G.friends||[]).map(f=>f.userId));
  const filtered=rows.filter(r=>r.user_id!==G.playerUUID && !myFriends.has(r.user_id));
  return filtered.slice(0,5);
}
// v2.1.0: Pending requests â€” friendships where to_user_id=me AND status='pending'
async function fetchIncomingRequests(){
  if(!G.playerUUID) return [];
  const rows=await _lbFetch(`friendships?to_user_id=eq.${G.playerUUID}&status=eq.pending&limit=20`);
  if(!Array.isArray(rows)) return [];
  const requesterIds=rows.map(r=>r.from_user_id);
  if(requesterIds.length===0) return [];
  const scores=await _lbFetch(`leaderboard?user_id=in.(${requesterIds.join(',')})&category=eq.money&period_key=eq.alltime&limit=50`);
  const nickMap=new Map();
  if(Array.isArray(scores)) for(const s of scores) if(!nickMap.has(s.user_id)) nickMap.set(s.user_id,s);
  return requesterIds.slice(0,10).map(id=>({userId:id,...(nickMap.get(id)||{nick:'Nieznany',country:'PL'})}));
}
/* v2.1.0: pending outgoing â€” wyĹ›wietlam zaproszenia ktĂłre ja wysĹ‚aĹ‚em (do dodania w UI) */
async function fetchOutgoingRequests(){
  if(!G.playerUUID) return [];
  const rows=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&status=eq.pending&limit=20`);
  if(!Array.isArray(rows)) return [];
  const targetIds=rows.map(r=>r.to_user_id);
  if(targetIds.length===0) return [];
  const scores=await _lbFetch(`leaderboard?user_id=in.(${targetIds.join(',')})&category=eq.money&period_key=eq.alltime&limit=50`);
  const nickMap=new Map();
  if(Array.isArray(scores)) for(const s of scores) if(!nickMap.has(s.user_id)) nickMap.set(s.user_id,s);
  return targetIds.slice(0,10).map(id=>({userId:id,...(nickMap.get(id)||{nick:'Nieznany',country:'PL'})}));
}
/* v2.1.0: synchronizacja G.friends z accepted po stronie serwera. Idempotent.
   âš  NIE usuwa lokalnych znajomych ktĂłrych nie ma na serwerze â€” stare save'y mogÄ… mieÄ‡ jednostronne
   znajomoĹ›ci z poprzednich wersji (przed ALTER status). Tylko DODAJEMY nowych zaakceptowanych przez drugÄ… stronÄ™. */
async function _lbSyncFriendsFromServer(){
  if(!G.playerUUID) return;
  const rows=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&status=eq.accepted&limit=100`);
  if(!Array.isArray(rows)) return;
  if(!Array.isArray(G.friends)) G.friends=[];
  const localIds=new Set(G.friends.map(f=>f.userId));
  const serverIds=new Set(rows.map(r=>r.to_user_id));
  /* Dodaj lokalnie nowych accepted ktĂłrych nie ma lokalnie (np. ktoĹ› zaakceptowaĹ‚ offline) */
  const missing=[...serverIds].filter(id=>!localIds.has(id));
  if(missing.length>0){
    const scores=await _lbFetch(`leaderboard?user_id=in.(${missing.join(',')})&category=eq.money&period_key=eq.alltime&limit=50`);
    const nickMap=new Map();
    if(Array.isArray(scores)) for(const s of scores) if(!nickMap.has(s.user_id)) nickMap.set(s.user_id,{nick:s.nick||'Nieznany'});
    for(const id of missing){
      const meta=nickMap.get(id)||{nick:'Nieznany'};
      G.friends.push({userId:id,nick:meta.nick,addedDay:G.day||0});
    }
    if(typeof saveGameSilent==='function') saveGameSilent();
  }
  /* One-time migration starych save'Ăłw: insert reverse 'accepted' ĹĽeby drugi gracz widziaĹ‚ mnie */
  if(!G._v210FriendsMigrated){
    for(const f of G.friends){
      /* idempotent: ignore duplicates */
      await _lbFetch('friendships',{
        method:'POST',
        headers:{'Prefer':'resolution=ignore-duplicates,return=minimal'},
        body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:f.userId,status:'accepted'})
      });
    }
    G._v210FriendsMigrated=true;
    if(typeof saveGameSilent==='function') saveGameSilent();
  }
}

async function renderPhoneFriends(){
  document.getElementById('ph-title').textContent='đź‘Ą Znajomi';
  if(!G.globalNick || !G.playerUUID){
    document.getElementById('ph-content').innerHTML=`
      <div class="ph-screen" style="padding:18px">
        <div style="background:linear-gradient(180deg,#0a1530,#06101e);border:1px solid #2a4a6a;border-radius:12px;padding:16px;text-align:center">
          <div style="font-size:36px;margin-bottom:8px">đź‘Ą</div>
          <h3 style="color:#7ec8e3;margin:0 0 8px 0">Najpierw ustaw nick globalny</h3>
          <p style="color:#aac;font-size:12px;line-height:1.5;margin-bottom:14px">Aby dodawaÄ‡ znajomych musisz najpierw mieÄ‡ swĂłj nick globalny â€” ustawisz go w đźŚŤ Tablicy wynikĂłw.</p>
          <button class="cbtn" style="width:100%;background:#1a3a5a;border-color:#7ec8e3;color:#fff" onclick="renderPhoneLeaderboard()">â†’ OtwĂłrz TablicÄ™ wynikĂłw</button>
          <button class="cbtn" style="width:100%;margin-top:6px;background:transparent;border-color:#3a4a5a;color:#778" onclick="renderPhoneHome()">â† WrĂłÄ‡</button>
        </div>
      </div>`;
    return;
  }
  const myCode=getFriendCode();
  let friendsList=G.friends||[];
  // Render szkielet z spinnerem
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen" style="padding:10px 12px">
      <div id="friends-aggregate" style="display:none"></div>
      <!-- TwĂłj kod znajomego -->
      <div style="background:linear-gradient(135deg,#2a1a5a,#1a0f3a);border:1px solid #5a3a8a;border-radius:10px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;color:#aab;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px">TwĂłj kod znajomego</div>
        <div style="display:flex;align-items:center;gap:8px">
          <code id="my-friend-code" style="flex:1;font-family:'Courier New',monospace;font-size:18px;font-weight:900;color:#f1c40f;letter-spacing:2px;text-shadow:0 0 8px rgba(241,196,15,.4);background:rgba(0,0,0,.3);padding:8px 10px;border-radius:6px;text-align:center">${myCode||'â€”'}</code>
          <button onclick="_lbCopyFriendCode()" style="background:#1a3a5a;border:1px solid #7ec8e3;color:#7ec8e3;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:700;font-family:inherit">đź“‹ Kopiuj</button>
        </div>
        <div style="font-size:10px;color:#778;margin-top:6px">PrzekaĹĽ ten kod znajomemu â€” on doda CiÄ™ u siebie</div>
      </div>
      <!-- Dodaj znajomego -->
      <div style="background:#0a1018;border:1px solid #2a3a4a;border-radius:10px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;color:#aab;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Dodaj znajomego</div>
        <div style="display:flex;gap:6px">
          <input id="add-friend-input" type="text" placeholder="TRAP-XXXX-XXXX-XXXX" maxlength="19" style="flex:1;background:#050a14;border:1px solid #2a4a6a;color:#fff;padding:8px 10px;border-radius:6px;font-family:'Courier New',monospace;font-size:14px;letter-spacing:1.5px;text-transform:uppercase">
          <button onclick="_lbAddFriendBtn()" style="background:#1a5a1a;border:1px solid #2ecc71;color:#2ecc71;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:700;font-family:inherit">âś“ Dodaj</button>
        </div>
        <div id="add-friend-status" style="font-size:11px;min-height:14px;margin-top:6px;text-align:center;color:#aac"></div>
      </div>
      <!-- Incoming pending requests (Akceptuj/OdrzuÄ‡) -->
