      <div style="background:#0a0a14;border:1px solid #2a3a5a;border-radius:8px;padding:14px;margin:14px auto;max-width:480px">
        <h3 style="color:#f1c40f;margin:0 0 8px 0;font-size:14px">đź“‹ Zasady gier:</h3>
        <div style="color:#aaa;font-size:12px;line-height:1.6">
          đźŽ° <b>Sloty</b> â€” 3 bÄ™bny, 3Ă— ten sam = wygrana. đź’Žđź’Žđź’Ž = JACKPOT 70Ă— + bonus 10Ă— stawki.<br>
          đźŽˇ <b>Ruletka</b> â€” 37 pĂłl (0-36). Czerwone/czarne 2Ă—, liczba 36Ă—.<br>
          đźŹ <b>Blackjack</b> â€” zbliĹĽ siÄ™ do 21. Blackjack = 2.5Ă— stawki.<br>
          âš”ď¸Ź <b>War</b> â€” pojedynek kart 1:1. WyĹĽsza wygrywa (2Ă—). Remis: rezygnacja (zwrot poĹ‚owy) lub WOJNA (dodatkowa stawka, wygrana 3Ă—).
        </div>
        <div style="color:#888;font-size:11px;margin-top:6px;text-align:center">Wszystkie gry akceptujÄ… tylko ĹĽetony. WymieĹ„ gotĂłwkÄ™ powyĹĽej.</div>
      </div>
      <div style="text-align:center"><button onclick="closeOverlay()" class="cbtn">â† WyjdĹş z kantoru</button></div>
    `;
  };
  window.casinoDailySpin=()=>{
    if(G._lastDailySpinDay===G.day){if(typeof showMsg==='function')showMsg('JuĹĽ dziĹ› zakrÄ™ciĹ‚eĹ›!','r');return;}
    G._lastDailySpinDay=G.day;
    // v1.8.21: Hazard skill shift â€” lepsze prawdopodobieĹ„stwa dla wyĹĽszych poziomĂłw.
    // luck=1.0 (skill 0): standard progi. luck=1.5 (max): r dzielone przez luck = czÄ™Ĺ›ciej w jackpot zone.
    const _luck=(typeof getHazardLuckBonus==='function')?getHazardLuckBonus():1;
    const r=Math.min(0.999, Math.random()/_luck);
    let prize=0, msg='';
    // v1.9.14: BUG FIX (OP) â€” EV obniĹĽone z ~120 zĹ‚/dzieĹ„ do ~50 zĹ‚/dzieĹ„. Jackpot 12%â†’4%, super 21%â†’12%, ratio luck dalej dziaĹ‚a.
    if(r<0.04){prize=500;msg='đźŽ‰ JACKPOT! WygraĹ‚eĹ› 500 zĹ‚!';}       // 4% (byĹ‚o 12%)
    else if(r<0.16){prize=200;msg='đźŽ‰ SUPER! WygraĹ‚eĹ› 200 zĹ‚!';}    // 12% (byĹ‚o 21%)
    else if(r<0.42){prize=50;msg='đźŽ‰ WygraĹ‚eĹ› 50 zĹ‚!';}             // 26%
    else if(r<0.78){prize=20;msg='đźŽ‰ Drobny wygraniec: 20 zĹ‚!';}    // 36% (byĹ‚o 26%)
    else {msg='đź˘ Pech â€” nic dziĹ›. WrĂłÄ‡ jutro!';}                   // 22% (byĹ‚o 15%)
    if(prize>0){
      G.money+=prize;G.totalEarned=(G.totalEarned||0)+prize;
      if(typeof sfxCash==='function')sfxCash();
      if(typeof showGain==='function')showGain('+'+prize+' zĹ‚','#f1c40f');
    }
    if(typeof showMsg==='function')showMsg(msg);
    if(typeof updateHUD==='function')updateHUD();
    if(typeof saveGameSilent==='function')saveGameSilent();
    render();
  };
  window.casinoExchange=(action,amount)=>{
    /* v1.9.18: BUG FIX exploit â€” guard przeciw negatywnym iloĹ›ciom (console call casinoExchange('buy',-9999) = money++) */
    if(action==='buy'){
      if(typeof amount!=='number' || amount<=0 || !Number.isFinite(amount)){if(typeof showMsg==='function')showMsg('NieprawidĹ‚owa kwota!','r');return;}
      if(G.money<amount){if(typeof showMsg==='function')showMsg('Brak gotĂłwki!','r');return;}
      G.money-=amount;G.casinoChips=(G.casinoChips||0)+amount;
    } else if(action==='sell'){
      const sellAmount = amount==='all' ? (G.casinoChips||0) : Math.min(amount, G.casinoChips||0);
      if(sellAmount<=0){if(typeof showMsg==='function')showMsg('Brak ĹĽetonĂłw!','r');return;}
      /* v1.9.16: BUG FIX â€” sprzedaĹĽ ĹĽetonĂłw NIE liczy siÄ™ do totalEarned (poprzednio exploit: kup 500kâ†’sprzedaj 500k = +500k totalEarned, instant complete bi4 "Magnat") */
      G.casinoChips-=sellAmount;G.money+=sellAmount;
    }
    /* v1.9.16: Trigger checkStoryline po zakupie/sprzedaĹĽy ĹĽetonĂłw (casino side-storyline c1 dotÄ…d nigdy nie firowaĹ‚ tu) */
    if(typeof checkStoryline==='function') checkStoryline();
    if(typeof updateHUD==='function')updateHUD();
    if(typeof sfxCash==='function')sfxCash();
    render();
  };
  render();
  openOverlay();
}

const ROOM_TIPS={
  studio:'đźŽµ Studio nagraĹ„! Kabina = kariera Realizatora, Mikser = Beatmaker. Odblokuj kariery przez XP!',
  silownia:'đź’Ş SiĹ‚ownia! Wyciskaj sztangÄ™ (spacja) i biegnij na bieĹĽni. Trening = lepsze zdrowie i statystyki.',
  szpital:'đźŹĄ Szpital â€” tu leczysz zdrowie za pieniÄ…dze. WrĂłÄ‡ gdy HP jest niskie!',
  park:'đźŚł Park! UsiÄ…dĹş na Ĺ‚awce ĹĽeby odpoczÄ…Ä‡ i odzyskaÄ‡ energiÄ™. Skatepark = punkty stylu!',
  pizzeria_room:'đźŤ• Pizzeria â€” skĹ‚adaj pizzÄ™ wg zamĂłwienia. Im szybciej, tym wiÄ™cej zarobisz!',
  mieszkanie:'đźŹ  Traphouse. Tu Ĺ›pisz, jesz z lodĂłwki i pracujesz przy komputerze.',
  mieszkanie_premium:'đźŹ˘ Apartament Premium. WiÄ™ksza przestrzeĹ„, kuchnia z wyspÄ… i regaĹ‚ z trofeami.',
  mieszkanie_lux:'đź’Ž Penthouse Lux. Basen, jacuzzi, sauna, ognisko i panorama miasta. Korzystaj 1Ă— dziennie.',
};
// Spawn pointy przed konkretnymi mieszkaniami â€” uĹĽywane przez act 'apt_exit'.
// KaĹĽdy aparment ma swoje wyjĹ›cie na chodnik PRZED budynkiem (north strona od H1/H3).
const APT_EXIT_SPAWNS={
  traphouse:{wx:170, wy:325},   // przed Traphouse (north H1 sidewalk)
  basic:    {wx:350, wy:3110},  // przed apt_basic (south H3 sidewalk)
  premium:  {wx:3900,wy:3110},  // przed apt_premium
  luxury:   {wx:1550,wy:3110},  // przed Penthouse
  mansion:  {wx:4439,wy:325},   // v2.1.172: przed Rezydencja (north H1 sidewalk, center = 4249+190)
  mega_villa:{wx:4720,wy:325},  // v2.1.215: przed Mega Villa (north H1 sidewalk, center = 4644+78)
};
// Anti-stuck: jeĹ›li spawn point gracza koliduje z budynkiem/blokiem/obiektem solid,
// szukaj najbliĹĽszego wolnego punktu w spirali (radial search)
function findFreeSpawn(wx,wy){
  // SprawdĹş solid objects (wiÄ™ksze niĹĽ 50x50, z kolizjÄ…) na ulicy
  if(currentRoom!=='ulica') return {wx,wy};
  const solids=[];
  if(ROOMS.ulica && ROOMS.ulica.objects){
    for(const o of ROOMS.ulica.objects){
      if(o.w>50 && o.h>50 && !o.id.startsWith('npc_') &&
         !['bench','bench2','pond','skate','bboying','freestyle_spot','park_trash','fountain','save','wardrobe','apt_cust','phone_home','park_lamp1','park_lamp2','park_lamp3','park_lamp4','park_bush1','park_bush2','park_bush3','apt2_fountain'].includes(o.id) &&
         !o.id.startsWith('apt1_') && !o.id.startsWith('apt2_') && !o.id.startsWith('apt4_')){
        solids.push(o);
      }
    }
  }
  if(typeof DB_DECORATIVE!=='undefined') solids.push(...DB_DECORATIVE);
  const PW=28, PH=44; // bbox gracza
  function collides(tx,ty){
    for(const s of solids){
      if(tx+PW>s.wx && tx<s.wx+s.w && ty+PH>s.wy && ty<s.wy+s.h) return true;
    }
    return false;
  }
  if(!collides(wx,wy)) return {wx,wy};
  // Spirala: szukaj wolnego punktu w promieniu rosnÄ…cym
  for(let r=20; r<=400; r+=20){
    for(let a=0; a<360; a+=15){
      const rad=a*Math.PI/180;
      const tx=Math.round(wx+Math.cos(rad)*r);
      const ty=Math.round(wy+Math.sin(rad)*r);
      if(!collides(tx,ty)) return {wx:tx, wy:ty};
    }
  }
  return {wx,wy}; // fallback
}
/* v2.1.74 Amper: blokada wejĹ›cia do budynku gdy gracz prowadzi auto. WczeĹ›niej moĹĽna byĹ‚o "wjechaÄ‡ autem" do mieszkania/studia/kasyna â€” nieimmersyjne. Sprawdzane w changeRoom (bezpoĹ›rednie) i startRoomFade (z fade) ĹĽeby pokryÄ‡ wszystkie Ĺ›cieĹĽki. */
function _blockedByCarEnter(id){
  if(G._inCar && currentRoom==='ulica' && id!=='ulica'){
    if(typeof notify==='function') notify('đźš— Nie moĹĽesz wjechaÄ‡ autem do budynku! NaciĹ›nij V aby wysiÄ…Ĺ›Ä‡.');
    return true;
  }
  return false;
}
function changeRoom(id,wx,wy){
  if(_blockedByCarEnter(id)) return;
  // Studio ownership gate
  if(id==='studio'&&!G.studioOwned){
    renderStudioForSale();openOverlay();return;
  }
  /* v2.1.122: Wave 5 S39 â€” BGM fade miÄ™dzy pokojami (wczeĹ›niej muzyka ciÄ…gnÄ™Ĺ‚a siÄ™ przez wszystkie pokoje). Subtle volume dip 300ms. */
  if(typeof bgmAudio!=='undefined' && bgmAudio && !bgmAudio.paused){
    try{
      const _origVol=bgmAudio.volume;
      bgmAudio.volume=Math.max(0,_origVol*0.3);
      setTimeout(()=>{try{if(bgmAudio&&!bgmAudio.paused)bgmAudio.volume=_origVol;}catch(_){}},400);
    }catch(_){}
  }
  // Anti-stuck-key przy zmianie pokoju (focus moĹĽe siÄ™ przerwaÄ‡ przy fade)
  for(const k in K) delete K[k];
  currentRoom=id;
  // Anti-stuck: jeĹ›li spawn na ulicy w bloku/budynku â€” przesuĹ„ gracza na najbliĹĽszy wolny punkt
  if(id==='ulica'){
    const safe=findFreeSpawn(wx,wy);
    P.wx=safe.wx; P.wy=safe.wy;
  } else {
    P.wx=wx; P.wy=wy;
  }
  closeNPCDlg();
  cam._initialized=false; // reset smooth lerp przy zmianie pokoju
  updateCamera();
  // First-visit tip
  if(!G.visitedRooms) G.visitedRooms={};
  if(!G.visitedRooms[id]){
    G.visitedRooms[id]=true;
    /* v1.9.25: BUG FIX â€” pierwsza wizyta daje +2 sĹ‚awy + 5 XP (poprzednio else branch zapisywaĹ‚ flagÄ™ bez bonusu) */
    /* v2.1.123: Wave 3 K33 â€” addFame Prestige aware */
    if(typeof addFame==='function') addFame(2); else G.fame=Math.min(500,(G.fame||0)+2);
    if(typeof addXP==='function') addXP(5);
    if(typeof addNotif==='function') addNotif(`đź—şď¸Ź Nowe miejsce odkryte: ${({mieszkanie:'TwĂłj dom',ulica:'Ulica miasta',studio:'Studio nagraĹ„',silownia:'SiĹ‚ownia',sala:'Sala koncertowa',casino:'Kasyno',mediamarkt:'MediaMarkt',muzyczny:'Sklep muzyczny',ubrania:'Drip District',fryzjer:'Fryzjer',restauracja:'Restauracja',kebab:'Kebab Zbyszka',hospital:'Szpital'})[id]||id}! +2 sĹ‚awy, +5 XP`);
    if(ROOM_TIPS[id]) setTimeout(()=>showMsg(ROOM_TIPS[id]),600);
  }
  // CINEMATIC SIĹOWNI #1 â€” pierwsze wejĹ›cie (NIE auto-close, wymusza klik gracza)
  if(id==='silownia' && !G._gymFirstEntry && typeof showGymTutorialCinematic === 'function'){
    G._gymFirstEntry = true;
    setTimeout(()=>showGymTutorialCinematic(), 700);
  }
}

// â”€â”€ Mood & sleep penalty helpers â”€â”€
function getMoodMod(){
  // G.stress = mood (100=relaxed, 0=burned out); low mood â†’ worse performance
  const s=G.stress||0;
  return s<25?0.72:s<50?0.88:s<70?0.96:1.0;
}
function getSleepMod(){
  // Each sleepDebt level â†’ -8% quality, minimum 60%
  return Math.max(0.60,1-(G.sleepDebt||0)*0.08);
}

// â”€â”€ STUDIO â€” sprzedaĹĽ + reputacja + jakoĹ›Ä‡ nagraĹ„ â”€â”€
function getRecordingQuality(){
  const micQ=G.mic?G.mic.quality:5;
  /* v1.9.56: ifMult tylko dla XLR, USB uĹĽycie 1.0 â€” spĂłjnoĹ›Ä‡ z doRecord (12366). Poprzednio USB miaĹ‚ 0.7 hardcoded penalty (niespĂłjne miÄ™dzy funkcjami) */
  const mtype=G.mic?G.mic.type:'none';
  const ifMult=mtype==='xlr'?(G.audioInterface?G.audioInterface.ifMult:0.3):1;
  const micEff=micQ*ifMult;
  // #36B: stackujÄ…ce â€” pianka 3pkt Ă— 5 = 15, panel 6pkt Ă— 3 = 18 â†’ max 33pkt acoustic bonus
  const acoustic=(G.acousticFoams||0)*3+(G.acousticPanels||0)*6;
  const dawPts={1:15,2:25,3:40};const daw=G.hasDaw?(dawPts[G.dawTier||1]||15):0;
  const monitor=G.headphones?Math.floor(G.headphones.quality/8):0;
  const skilBonus=(getRaperST('realizacja')||0)*4+(getRaperST('mikser')||0)*3;
  const baseQ=Math.min(100,Math.round(micEff+acoustic+daw+monitor+skilBonus));
  const flowQMult=getRaperST('flow')>=5?1.25:getRaperST('flow')>=3?1.1:1; // Flow 3â†’+10%, Flow 5â†’+25%
  // v1.8.98: Mikser 1 "+10% jakoĹ›ci wĹ‚asnych trackĂłw" â€” multiplikatywny boost (poprzednio tylko liniowe +3pkt z skilBonus)
  const mikserQMult=getRaperST('mikser')>=1?1.10:1;
  const moodM=getMoodMod();const sleepM=getSleepMod();
  return Math.min(100,Math.round(baseQ*flowQMult*mikserQMult*moodM*sleepM));
}

function renderStudioForSale(){
  const q=getRecordingQuality();
  const studioPrice=G.level>=5?15000:G.level>=3?20000:25000;
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŽ™ď¸Ź Studio NagraĹ„</h2>
    <p class="sub" style="color:#e74c3c">đź”’ To studio jest na sprzedaĹĽ. Kup je ĹĽeby nagrywaÄ‡ tracki!</p>
    <div style="background:#0a1220;border:1px solid #1a3a5a;border-radius:10px;padding:16px;margin-bottom:16px">
      <div style="font-size:14px;color:#aaa;line-height:2">
        <div>đź’µ Cena: <strong style="color:#f1c40f">${studioPrice.toLocaleString('pl')} zĹ‚</strong></div>
        <div>đź“Š Twoja kasa: <strong style="color:${G.money>=studioPrice?'#2ecc71':'#e74c3c'}">${G.money.toLocaleString('pl')} zĹ‚</strong></div>
        <div>đźŽ¤ JakoĹ›Ä‡ nagraĹ„ (twĂłj sprzÄ™t): <strong style="color:#7ec8e3">${q}%</strong></div>
      </div>
      <div style="font-size:12px;color:#556;margin-top:10px;line-height:1.6">
        Po zakupie: nagrywanie wokalu, tworzenie bitĂłw, przyjmowanie zleceĹ„.<br>
        Kupuj sprzÄ™t w Sklepie Muzycznym ĹĽeby zwiÄ™kszyÄ‡ jakoĹ›Ä‡ nagraĹ„.
      </div>
    </div>
    <button class="dbtn" style="font-size:18px;padding:14px 30px" ${G.money<studioPrice?'disabled':''} onclick="window.buyStudio(${studioPrice})">đź’Ž Kup Studio â€” ${studioPrice.toLocaleString('pl')} zĹ‚</button>
    <div class="res" id="studio-sale-res" style="margin-top:10px"></div>
    <button class="cbtn" style="margin-top:12px" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  window.buyStudio=(price)=>{
    /* v1.9.16: guard przeciw double-click drain */
    if(G.studioOwned){closeOverlay();return;}
    if(G.money<price){document.getElementById('studio-sale-res').textContent='Za maĹ‚o pieniedzy!';return;}
    G.money-=price;G.studioOwned=true;
    closeOverlay();
    addNotif('đźŽ™ď¸Ź Studio zakupione!');
    addXP(30);
    // v1.8.18: cinematic przy zakupie studia (analogicznie do milestone'Ăłw fanĂłw)
    if(typeof showMilestoneCinematic==='function'){
      showMilestoneCinematic({
        emoji:'đźŽ™ď¸Ź',
        title:'STUDIO NAGRAĹ',
        subtitle:'Twoja wĹ‚asna przestrzeĹ„ kreatywna',
        tagline:'Nagrywaj tracki Â· TwĂłrz bity Â· Wydawaj single',
        accentColor:'#9b59b6',
        accent2:'#e91e8c',
        duration:4500,
        onDone:()=>{
          showMsg('đźŽ‰ Studio gotowe! IdĹş na ulicÄ™ â†’ wejdĹş do Studia â†’ komputer (DAW)');
          changeRoom('studio',200,300);
        }
      });
    } else {
      showMsg('đźŽ‰ Studio kupione! Teraz moĹĽesz nagrywaÄ‡ tracki, tworzyÄ‡ bity i przyjmowaÄ‡ zlecenia!');
      changeRoom('studio',200,300);
    }
  };
}

// Pasywny przychĂłd z wynajmu studia
function studioRentalIncome(){
  if(!G.studioOwned) return 0;
  const q=getRecordingQuality();
  // Reputacja = quality Ă— sĹ‚awa Ă— raper level
  const rep=Math.floor(q*0.3+(G.fame||0)*0.5+(G.careers.raper.level||0)*10);
  if(rep<20) return 0;
  return Math.floor(rnd(50,200)*rep/100);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  DĹąWIÄKI (Web Audio API)
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let audioCtx=null;
let _sfxMasterGain=null;
let _sfxVolume=parseFloat(localStorage.getItem('snowy_sfx_vol'));
if(isNaN(_sfxVolume))_sfxVolume=1.0;
let _sfxLastVolume=_sfxVolume>0?_sfxVolume:1.0;
// Backward-compat â€” niektĂłre miejsca mogÄ… jeszcze sprawdzaÄ‡ _muted
let _muted=_sfxVolume<=0;
function getAudio(){
  if(_sfxVolume<=0) return null;
  if(!audioCtx){
    audioCtx=new(window.AudioContext||window.webkitAudioContext)();
    _sfxMasterGain=audioCtx.createGain();
    _sfxMasterGain.gain.value=_sfxVolume;
    _sfxMasterGain.connect(audioCtx.destination);
  }
  // v1.9.15: Autoplay policy â€” resume context jeĹ›li suspended (Chrome/Safari)
  if(audioCtx.state==='suspended'){try{audioCtx.resume();}catch(e){}}
  return audioCtx;
}
function isMuted(){return _sfxVolume<=0;}
function setSfxVolume(v){
  _sfxVolume=Math.max(0,Math.min(1,v));
  if(_sfxVolume>0)_sfxLastVolume=_sfxVolume;
  _muted=_sfxVolume<=0;
  localStorage.setItem('snowy_sfx_vol',_sfxVolume.toFixed(3));
  if(_sfxMasterGain)_sfxMasterGain.gain.value=_sfxVolume;
  const lbl=document.getElementById('sfx-vol-label');if(lbl)lbl.textContent=Math.round(_sfxVolume*100)+'%';
  const sl=document.getElementById('sfx-vol-slider');if(sl&&Math.abs(parseFloat(sl.value)-_sfxVolume*100)>0.5)sl.value=Math.round(_sfxVolume*100);
  const ico=document.getElementById('hmute');if(ico)ico.textContent=_sfxVolume<=0?'đź”‡':'đź”Š';
}
function toggleMute(){
  if(_sfxVolume>0)setSfxVolume(0);
  else setSfxVolume(_sfxLastVolume||1.0);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  Background Music â€” pliki MP3 z folderu mp3/, wĹ‚asny fader, ducking
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
const BGM_LIST=[
  {name:"UtwĂłr 1", url:"https://files.catbox.moe/o356wi.mp3"},
  {name:"UtwĂłr 2", url:"https://files.catbox.moe/z0xsgh.mp3"},
  {name:"UtwĂłr 3", url:"https://files.catbox.moe/ypp7yh.mp3"},
  {name:"UtwĂłr 4", url:"https://files.catbox.moe/f9i9dz.mp3"},
  {name:"UtwĂłr 5", url:"https://files.catbox.moe/amqoj1.mp3"},
  {name:"UtwĂłr 6", url:"https://files.catbox.moe/8jfw7f.mp3"},
  {name:"UtwĂłr 7", url:"https://files.catbox.moe/mn46lm.mp3"},
  {name:"UtwĂłr 8", url:"https://files.catbox.moe/x1rkht.mp3"},
  {name:"UtwĂłr 9", url:"https://files.catbox.moe/gb5kb1.mp3"},
  {name:"UtwĂłr 10",url:"https://files.catbox.moe/1pat1n.mp3"},
  {name:"UtwĂłr 11",url:"https://files.catbox.moe/bdm3a9.mp3"}
];
let bgmAudio=null;
let bgmIdx=Math.floor(Math.random()*BGM_LIST.length);
let bgmVolume=parseFloat(localStorage.getItem('snowy_bgm_vol'));
if(isNaN(bgmVolume))bgmVolume=0.13;
let bgmEnabled=localStorage.getItem('snowy_bgm_on')!=='0';
let _bgmDuckedUntil=0;
let _bgmDuckTimer=null;
// Smooth ducking â€” animowany mnoĹĽnik 0..1 (1=full, ~0.4=duck). Fade-out ~70ms, hold, fade-in ~280ms.
let _bgmDuckMult=1;
let _bgmDuckRAF=null;
function bgmGetTrackName(){return BGM_LIST[bgmIdx].name;}
function bgmInit(){
  if(bgmAudio) return;
  bgmAudio=new Audio();
  bgmAudio.addEventListener('ended',bgmNext);
  bgmAudio.addEventListener('error',()=>{bgmNext();});
  bgmAudio.volume=0;
  bgmLoad();
}
function bgmLoad(){
  if(!bgmAudio) return;
  bgmAudio.src=BGM_LIST[bgmIdx].url;
  bgmAudio.crossOrigin='anonymous';
  bgmApplyVolume();
  if(bgmEnabled){
    const p=bgmAudio.play();
    if(p&&p.catch)p.catch(()=>{});
  }
  const tn=document.getElementById('bgm-track-name');
  if(tn)tn.textContent=bgmGetTrackName();
}
function bgmNext(){
  bgmIdx=(bgmIdx+1)%BGM_LIST.length;
  bgmLoad();
}
function bgmPrev(){
  bgmIdx=(bgmIdx-1+BGM_LIST.length)%BGM_LIST.length;
  bgmLoad();
}
function bgmSetVolume(v){
  bgmVolume=Math.max(0,Math.min(1,v));
  localStorage.setItem('snowy_bgm_vol',bgmVolume.toFixed(3));
  bgmApplyVolume();
  const lbl=document.getElementById('bgm-vol-label');
  if(lbl)lbl.textContent=Math.round(bgmVolume*100)+'%';
}
function bgmApplyVolume(){
  if(!bgmAudio) return;
  bgmAudio.volume=bgmVolume*_bgmDuckMult*(bgmEnabled?1:0);
}
// Smooth ducking: gĹ‚adki fade-out â†’ hold â†’ fade-in. WywoĹ‚ywane przez SFX (oprĂłcz krokĂłw).
// fadeOut 70ms (lookahead â€” chwilÄ™ PRZED dĹşwiÄ™kiem), hold ~250ms, fadeIn 280ms (chwilÄ™ PO dĹşwiÄ™ku).
function bgmDuck(holdMs){
  if(!bgmAudio||!bgmEnabled) return;
  const HOLD=Math.max(180,holdMs||280);
  const FADE_OUT=70, FADE_IN=280;
  const TARGET=0.4; // 60% redukcji
  const start=performance.now();
  const fromMult=_bgmDuckMult;
  // WydĹ‚uĹĽ _bgmDuckedUntil na czas peĹ‚nego cyklu
  _bgmDuckedUntil=Date.now()+FADE_OUT+HOLD+FADE_IN;
  if(_bgmDuckRAF)cancelAnimationFrame(_bgmDuckRAF);
  function step(now){
    const t=now-start;
    let mult;
    if(t<FADE_OUT){
      // Fade out: fromMult â†’ TARGET
      const k=t/FADE_OUT;
      mult=fromMult+(TARGET-fromMult)*k;
    } else if(t<FADE_OUT+HOLD){
      mult=TARGET;
    } else if(t<FADE_OUT+HOLD+FADE_IN){
      const k=(t-FADE_OUT-HOLD)/FADE_IN;
      mult=TARGET+(1-TARGET)*k;
    } else {
      mult=1;
      _bgmDuckMult=1;
      bgmApplyVolume();
      _bgmDuckRAF=null;
      return;
    }
    _bgmDuckMult=mult;
    bgmApplyVolume();
    _bgmDuckRAF=requestAnimationFrame(step);
  }
  _bgmDuckRAF=requestAnimationFrame(step);
}
function bgmToggle(){
  bgmEnabled=!bgmEnabled;
  localStorage.setItem('snowy_bgm_on',bgmEnabled?'1':'0');
  if(!bgmAudio)bgmInit();
  bgmApplyVolume();
  if(bgmEnabled){const p=bgmAudio.play();if(p&&p.catch)p.catch(()=>{});}
  else bgmAudio.pause();
  const btn=document.getElementById('bgm-toggle-btn');
  if(btn)btn.textContent=bgmEnabled?'âŹ¸ Pauza':'â–¶ Graj';
}
function toggleAudioPanel(){
  const p=document.getElementById('audio-panel');
  if(!p)return;
  const open=p.style.display!=='none'&&p.style.display!=='';
  p.style.display=open?'none':'block';
  if(!open){
    if(!bgmAudio)bgmInit();
    // Sync UI z aktualnymi wartoĹ›ciami
    const tn=document.getElementById('bgm-track-name');
    if(tn)tn.textContent=bgmGetTrackName();
    const bsl=document.getElementById('bgm-vol-slider');
    if(bsl)bsl.value=Math.round(bgmVolume*100);
    const blbl=document.getElementById('bgm-vol-label');
    if(blbl)blbl.textContent=Math.round(bgmVolume*100)+'%';
    const btn=document.getElementById('bgm-toggle-btn');
    if(btn)btn.textContent=bgmEnabled?'âŹ¸ Pauza':'â–¶ Graj';
    const ssl=document.getElementById('sfx-vol-slider');
    if(ssl)ssl.value=Math.round(_sfxVolume*100);
    const slbl=document.getElementById('sfx-vol-label');
    if(slbl)slbl.textContent=Math.round(_sfxVolume*100)+'%';
    // Sync fullscreen toggle
    const fsb=document.getElementById('fs-toggle-btn');
    if(fsb){
      const on=fullscreenEnabled();
      fsb.textContent=on?'âś“ PeĹ‚ny ekran':'âś— PeĹ‚ny ekran';
      fsb.style.background=on?'#0a3a1a':'#3a1a1a';
      fsb.style.borderColor=on?'#27ae60':'#5a2020';
      fsb.style.color=on?'#7ec87e':'#e07070';
    }
  }
}
// Backward compat (gdyby coĹ› jeszcze uĹĽywaĹ‚o)
function toggleBgmPanel(){toggleAudioPanel();}
// Auto-start BGM przy pierwszej user interaction (autoplay policy)
function _bgmAutoStart(){
  if(!bgmAudio)bgmInit();
  document.removeEventListener('click',_bgmAutoStart);
  document.removeEventListener('keydown',_bgmAutoStart);
}
document.addEventListener('click',_bgmAutoStart,{once:true});
document.addEventListener('keydown',_bgmAutoStart,{once:true});

// v1.8.20: globalny ripple effect na buttonach (.dbtn/.bbtn/.cbtn/.mbtn/.bdbtn)
document.addEventListener('click',(e)=>{
  const btn=e.target.closest('.dbtn,.bbtn,.cbtn,.mbtn,.bdbtn,.copt-btn');
  if(!btn||btn.disabled) return;
  try{
    const r=btn.getBoundingClientRect();
    const rip=document.createElement('span');
    rip.className='btn-ripple';
    const size=Math.max(r.width,r.height)*1.3;
    rip.style.cssText=`width:${size}px;height:${size}px;left:${e.clientX-r.left-size/2}px;top:${e.clientY-r.top-size/2}px;`;
    // ensure btn has position
    if(getComputedStyle(btn).position==='static') btn.style.position='relative';
    btn.appendChild(rip);
    setTimeout(()=>rip.remove(),650);
  }catch(_){}
},true);
function playStep(){
  if(_muted) return;
  try{const a=getAudio();if(!a) return;const o=a.createOscillator();const g=a.createGain();
    o.connect(g);g.connect(_sfxMasterGain||a.destination);
    o.type='square';o.frequency.setValueAtTime(80+Math.random()*40,a.currentTime);
    g.gain.setValueAtTime(.07,a.currentTime);g.gain.exponentialRampToValueAtTime(.001,a.currentTime+.08);
    o.start();o.stop(a.currentTime+.08);}catch(e){}
}
function playEat(){
  if(typeof bgmDuck==='function') bgmDuck(); /* v2.1.123: Wave 5 S41 â€” bgmDuck */
  if(_muted) return;
  try{const a=getAudio();if(!a) return;
    for(let i=0;i<3;i++){const o=a.createOscillator();const g=a.createGain();
      o.connect(g);g.connect(_sfxMasterGain||a.destination);
      o.type='sawtooth';o.frequency.setValueAtTime(200+i*80,a.currentTime+i*.08);
      g.gain.setValueAtTime(.12,a.currentTime+i*.08);g.gain.exponentialRampToValueAtTime(.001,a.currentTime+i*.08+.12);
      o.start(a.currentTime+i*.08);o.stop(a.currentTime+i*.08+.12);}
  }catch(e){}
}
function playClick(){
  if(typeof bgmDuck==='function') bgmDuck(); /* v2.1.123: Wave 5 S41 â€” bgmDuck */
  if(_muted)return;
  try{const a=getAudio();const o=a.createOscillator();const g=a.createGain();
    o.connect(g);g.connect(_sfxMasterGain||a.destination);
    o.type='square';o.frequency.setValueAtTime(600,a.currentTime);o.frequency.exponentialRampToValueAtTime(200,a.currentTime+.06);
    g.gain.setValueAtTime(.08,a.currentTime);g.gain.exponentialRampToValueAtTime(.001,a.currentTime+.06);
    o.start();o.stop(a.currentTime+.06);}catch(e){}
}
function playSnore(){
  if(typeof bgmDuck==='function') bgmDuck(); /* v2.1.123: Wave 5 S41 â€” bgmDuck */
  if(_muted)return;
  try{const a=getAudio();const o=a.createOscillator();const g=a.createGain();const lfo=a.createOscillator();const lfoG=a.createGain();
    lfo.connect(lfoG);lfoG.connect(g.gain);lfoG.gain.value=.04;lfo.frequency.value=4;
    o.connect(g);g.connect(_sfxMasterGain||a.destination);
    o.type='sine';o.frequency.setValueAtTime(120,a.currentTime);o.frequency.linearRampToValueAtTime(80,a.currentTime+.4);o.frequency.linearRampToValueAtTime(120,a.currentTime+.8);
    g.gain.setValueAtTime(.08,a.currentTime);g.gain.linearRampToValueAtTime(.12,a.currentTime+.4);g.gain.linearRampToValueAtTime(.04,a.currentTime+.8);
    lfo.start();o.start();lfo.stop(a.currentTime+.8);o.stop(a.currentTime+.8);}catch(e){}
}

let lastStepSound=0;
function maybeSoundStep(){
  if(!P.moving) return;
  /* v2.1.175: blokuj kroki gdy pauza/overlay/sleep/cinematic/rest. WczeĹ›niej user trzymaĹ‚ klawisz ruchu i naciskaĹ‚ Esc â€” pauza, ale P.moving=true z poprzedniej klatki â†’ step sound nadal graĹ‚. */
  if(_paused) return;
  if(isOverlayOpen()) return;
  if(typeof phoneOpen==='function' && phoneOpen()) return;
  if(typeof mgOpen==='function' && mgOpen()) return;
  if(typeof npcDlgOpen==='function' && npcDlgOpen()) return;
  if(G._resting) return;
  if(typeof sleepInterval!=='undefined' && sleepInterval) return;
  const now=Date.now();if(now-lastStepSound<280){return;}lastStepSound=now;playStep();
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  SEN â€” animacja
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let sleepInterval=null;
// Pula tipĂłw â€” dopasowane do progresu (cond=>true â†’ dostÄ™pne).
// Po obudzeniu losujemy 1 z dostÄ™pnych, kaĹĽdy pokazuje siÄ™ raz na 3 dni gry.
const DAILY_TIPS=[
  {id:'cook',cond:()=>G.skills?.cooking<3,text:'đź’ˇ Domowe gotowanie na đź”Ą pĹ‚ycie indukcyjnej daje znacznie wiÄ™ksze bonusy niĹĽ kupne jedzenie!'},
  {id:'gym',cond:()=>G.fitness<50||G.forma<30,text:'đź’ˇ SiĹ‚ownia: Ĺ‚awka/wyciÄ…g = forma (siĹ‚a), bieĹĽnia = kondycja (prÄ™dkoĹ›Ä‡). KaĹĽde max 2Ă— dziennie.'},
  {id:'merch',cond:()=>(G.fans||0)>=5000&&!G.merchStore?.products?.length,text:'đź’ˇ Studio Projektowania: zaprojektuj merch i zarabiaj pasywnie (cap zysku zaleĹĽy od capacity).'},
  {id:'concert',cond:()=>G.fame>=10&&getRaperST('scena')>=1&&!(G._lastConcertMin>0),text:'đź’ˇ Sala Koncertowa: zagraj koncert! Im lepsza wydajnoĹ›Ä‡ (combo, accuracy), tym wiÄ™kszy zarobek.'},
  {id:'streak',cond:()=>G.playStreak>=2,text:`đź’ˇ Streak ${G.playStreak} dni! Bonus do zarobkĂłw: +${Math.min(20,(G.playStreak-1)*2)}%. Graj codziennie ĹĽeby utrzymaÄ‡.`},
  {id:'apt',cond:()=>G.apartment==='traphouse'&&(G.fans||0)>=2000,text:'đź’ˇ SpeĹ‚niasz wymogi Apartamentu Premium (60k zĹ‚). Lepsza regeneracja energii + nastrĂłj dziennie.'}, /* v2.1.110: W40 â€” aktualna cena 60k (byĹ‚o 15k pre-v2.1.51) */
  {id:'pantry',cond:()=>(!G.pantry||Object.values(G.pantry).reduce((s,v)=>s+v,0)<5),text:'đź’ˇ Kup skĹ‚adniki w đź›’ sklepie spoĹĽywczym lub đźŹŞ na targu, aby gotowaÄ‡ w domu na pĹ‚ycie!'},
  {id:'sleep',cond:()=>(G.sleepDebt||0)>=2,text:'đź’ˇ NiedobĂłr snu zwiÄ™ksza spadek energii. IdĹş spaÄ‡ przez kolejne dni ĹĽeby zlikwidowaÄ‡ debet.'},
  {id:'stress',cond:()=>(G.stress||0)<40,text:'đź’ˇ Niski nastrĂłj obniĹĽa wszystkie wyniki o 12-28%. Sofa/sauna/biblioteka pomaga.'},
  {id:'fame',cond:()=>G.fame<20&&G.followers>=500,text:'đź’ˇ TwĂłrz, postuj na IG, graj koncerty â€” sĹ‚awa otwiera nowe moĹĽliwoĹ›ci (sponsorzy, kontrakty).'},
  {id:'wiktor',cond:()=>G.dailyQuest&&G.dailyQuest.completed&&!G.dailyQuest.claimed,text:'đź’ˇ Masz gotowe dzienne zadanie! IdĹş do Wiktora odebraÄ‡ nagrodÄ™ (chodnik H1).'},
  {id:'savings',cond:()=>G.money>=5000&&(!G.bank?.investments||G.bank.investments.length===0),text:'đź’ˇ Bank w telefonie: zainwestuj nadmiar kasy w lokaty terminowe (3/5/7 dni) aby zarobiÄ‡ odsetki.'},
  {id:'crew',cond:()=>G.fame>=30&&(!G.crew||G.crew.length===0),text:'đź’ˇ Rekrutuj ekipÄ™ (NPC obok sali koncertowej) â€” DJ, grafik, manager dajÄ… staĹ‚e bonusy.'},
];
function showDailyTip(){
  if(!G._tipHistory) G._tipHistory={};
  // v1.8.18: zwiÄ™kszony cooldown 3â†’7 dni â€” wczeĹ›niej te same tipy wracaĹ‚y zbyt czÄ™sto.
  const available=DAILY_TIPS.filter(t=>{
    try{
      if(!t.cond()) return false;
      const last=G._tipHistory[t.id]||-99;
      return G.day-last>=7;
    }catch(e){return false;}
  });
  if(available.length===0) return;
  const tip=available[Math.floor(Math.random()*available.length)];
  G._tipHistory[tip.id]=G.day;
  setTimeout(()=>showMsg(tip.text),2500);
}

// v1.8.18: smart idle popup â€” sprawdĹş czy gracz nic nie robi >45s i pokaĹĽ ewentualny tip
window._lastUserActionAt=Date.now();
window._lastIdleTipAt=0;
// v1.8.24: trzymamy referencjÄ™ ĹĽeby mĂłc clearowaÄ‡ np. przy reset/newGame
window._idleHintInterval=null;
function _idleHintTick(){
  const _now=Date.now();
  if(_now-window._lastUserActionAt<45000) return; // jeszcze nie idle
  if(_now-window._lastIdleTipAt<5*60*1000) return; // tip max raz na 5 min
  if(typeof overlayOpen==='function'&&overlayOpen()) return; // nie pokazuj gdy okienko otwarte
  if(typeof npcDlgOpen==='function'&&npcDlgOpen()) return;
  if(typeof mgOpen==='function'&&mgOpen()) return;
  if(typeof _paused!=='undefined'&&_paused) return;
  if(typeof sleepInterval!=='undefined'&&sleepInterval) return;
  if(typeof _restTimer!=='undefined'&&_restTimer) return;
  window._lastIdleTipAt=_now;
  showDailyTip();
}
// rejestruj aktywnoĹ›Ä‡ uĹĽytkownika
document.addEventListener('keydown',()=>{window._lastUserActionAt=Date.now();},true);
document.addEventListener('mousedown',()=>{window._lastUserActionAt=Date.now();},true);
if(window._idleHintInterval) clearInterval(window._idleHintInterval);
window._idleHintInterval=setInterval(_idleHintTick,10000); // sprawdzaj co 10s
// Podsumowanie minionego dnia â€” popup po wakeUp pokazujÄ…cy zarobki/wydatki/akcje.
// Pokazuje siÄ™ TYLKO jeĹ›li byĹ‚ aktywny dzieĹ„ (jakieĹ› earned>0 lub akcje).
function showDailySummary(){
  const ds=window._lastDayStats;
  if(!ds||(ds.earned===0&&ds.spent===0&&ds.jobs===0&&ds.concerts===0&&ds.gym===0)) return;
  document.getElementById('day-summary')?.remove();
  const balance=ds.earned-ds.spent;
  const balColor=balance>=0?'#27ae60':'#e07070';
  const el=document.createElement('div');
  el.id='day-summary';
  el.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(135deg,#0a1525,#0a0a1a);border:2px solid #7ec8e3;border-radius:12px;padding:22px 30px;width:360px;z-index:240;box-shadow:0 0 60px rgba(126,200,227,.4);color:#fff;font-family:inherit;animation:welcomeIn .35s ease-out';
  el.innerHTML=`
    <div style="text-align:center;font-size:20px;color:#7ec8e3;font-weight:900;margin-bottom:14px">đź“Š Podsumowanie dnia ${ds.day}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;font-size:13px;margin-bottom:16px">
      <div style="color:#888">đź’° Zarobione:</div><div style="color:#27ae60;font-weight:700;text-align:right">+${ds.earned.toLocaleString('pl')} zĹ‚</div>
      <div style="color:#888">đź’¸ Wydane:</div><div style="color:#e07070;font-weight:700;text-align:right">-${ds.spent.toLocaleString('pl')} zĹ‚</div>
      <div style="color:#888;border-top:1px solid #1a2a3a;padding-top:4px">đź“ Bilans:</div><div style="color:${balColor};font-weight:900;text-align:right;border-top:1px solid #1a2a3a;padding-top:4px">${balance>=0?'+':''}${balance.toLocaleString('pl')} zĹ‚</div>
      ${ds.jobs>0?`<div style="color:#888">đź›  Zlecenia:</div><div style="color:#f39c12;text-align:right">${ds.jobs}</div>`:''}
      ${ds.concerts>0?`<div style="color:#888">đźŽ¤ Koncerty:</div><div style="color:#9b59b6;text-align:right">${ds.concerts}</div>`:''}
      ${ds.gym>0?`<div style="color:#888">đź’Ş Trening:</div><div style="color:#e67e22;text-align:right">${ds.gym}Ă— sesji</div>`:''}
    </div>
    <button onclick="document.getElementById('day-summary')?.remove()" style="width:100%;background:#0a3a5a;border:1px solid #7ec8e3;color:#7ec8e3;padding:10px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700">â–¶ Zaczynaj nowy dzieĹ„</button>
  `;
  document.body.appendChild(el);
  setTimeout(()=>document.getElementById('day-summary')?.remove(),9000);
}
function wakeUp(){
  if(!sleepInterval) return;
  clearInterval(sleepInterval);sleepInterval=null;
  const ov=document.getElementById('sleep-overlay');
  ov.classList.remove('on');
  G.lastSleepDay=G.day;
  G.sleepDebt=Math.max(0,(G.sleepDebt||0)-1);
  G.hunger=clampStat('hunger', G.hunger-Math.floor((window._sleepTicks||0)*0.06));
  if((window._sleepTicks||0)>=20) addXP(5);
  /* v1.9.48: tracker dla tutorialu (audyt tutorial â€” step 7 wymagaĹ‚ lastSleepDay>0 ale init=1 = pre-speĹ‚nione) */
  if(!G._tutStat) G._tutStat={};
  G._tutStat.slept=(G._tutStat.slept||0)+1;
  // Spanie ZAWSZE skacze do 06:00 nastÄ™pnego dnia (nie tylko +1 pora dnia)
  gameMin=360;
  G.timeOfDay=3; // wymuszamy ĹĽeby nextPeriod() zaliczyĹ‚ nowy dzieĹ„ (3â†’0, day++)
  // v1.8.83: reset gameMin-based cooldownĂłw â€” bo gameMin wĹ‚aĹ›nie skoczyĹ‚ wstecz do 360.
  // Bez tego: freestyle/cooking cooldown uĹĽywa (now-lastFs), ktĂłre robi siÄ™ ujemne â†’ bug "musisz odpoczÄ…Ä‡" po obudzeniu.
  // v1.9.10: KOMPLET wszystkich gameMin trackerĂłw (poprzednio TYLKO freestyle+cook resetowane â†’ 6 innych cooldownĂłw zostawaĹ‚o zawieszone)
  G._lastFreestyleMin=-9999;
  G._lastCookMin=-9999;
  G._lastEatTableMin=-9999;
  G._lastBibliotekaMin=-9999;
  G._lastBeatSellMin=-9999;
  G._lastBeatPackMin=-9999;
  G._lastConcertMin=-9999;
  G._lastConcertAbs=-9999; /* v2.1.87: nowy absolutny tracker â€” reset przy spaniu (analogicznie do _lastConcertMin) */
  G._lastQuickCookMin=-9999;
  G._lastHeliMin=-9999; /* v1.9.58: helipad cooldown reset on sleep (audyt cooldowns â€” wczeĹ›niej brakowaĹ‚o, blokowaĹ‚o helipad caĹ‚y dzieĹ„ po Ĺ›nie) */
  nextPeriod();
  // v1.9.15: jeĹ›li eksmisja nastÄ…piĹ‚a PODCZAS snu (bill rollover), force-teleport na ulicÄ™ ĹĽeby gracz nie squattowaĹ‚ w eksmitowanym mieszkaniu
  if(G.bills?.evicted && currentRoom!=='ulica' && typeof APT_ROOMS!=='undefined' && APT_ROOMS[G.apartment]===currentRoom){
    currentRoom='ulica';
    if(typeof P!=='undefined'){P.wx=600;P.wy=500;}
    if(typeof showEvictionLetter==='function') setTimeout(()=>showEvictionLetter(),500);
  }
  notify('â€ď¸Ź ObudziĹ‚eĹ› siÄ™! Energia: '+Math.floor(G.energy)+'% Â· GĹ‚Ăłd: '+Math.floor(G.hunger)+'%');
  window._sleepTicks=0;
  // Daily summary najpierw, potem tip â€” odstÄ™p by siÄ™ nie nakĹ‚adaĹ‚y
  setTimeout(()=>showDailySummary(),800);
  setTimeout(()=>showDailyTip(),3500);
}

function startSleepAnimation(){
  if(sleepInterval) return;
  /* v2.1.122: Wave 5 S48 â€” Sleep mid-tour guard. Gdy gracz w trasie, sen wstrzymuje World Tour (anti exploit multi-day sleep podczas tour). */
  if(G._tourActive){
    if(typeof showMsg==='function') showMsg('đźŚŤ JesteĹ› w trasie â€” nie moĹĽesz spaÄ‡ tutaj. DokoĹ„cz World Tour lub przerwij u Marcina.','r',5000);
    return;
  }
  const ov=document.getElementById('sleep-overlay');
  ov.classList.add('on');
  // #77 BUG FIX: ĹĂłĹĽko Lux daje +20% szybkoĹ›Ä‡ regeneracji (poza apartmentowym bonusem)
  // v1.8.96: Aptbonus multiplikatywny (premium +15%, luxury +25%) zamiast dodatku 0.15/0.25 do bazy 1.5 (ktĂłre dawaĹ‚o tylko +10%/+16%)
  const aptBonus=G.apartment==='basic'?0.05:G.apartment==='premium'?0.15:G.apartment==='luxury'?0.25:G.apartment==='mansion'?0.40:G.apartment==='mega_villa'?0.50:0; /* v1.9.58: basic +5% · v2.1.159: mansion +40% · v2.1.215: Mega Villa +50% regen */
  const bedLuxBonus=G.aptPurchases?.furniture?.includes('bed_luxury')?0.20:0;
  const totalBonus=(aptBonus+bedLuxBonus)*1.5; // mnozenie przez baze: aptBonus=15% z 1.5 = 0.225
  const bar=document.getElementById('sleep-bar');
  const status=document.getElementById('sleep-status');
  let snoreTimer=0;
  window._sleepTicks=0;
  // v1.8.18: 2x szybsza regeneracja snu (user: "spanie/odpoczywanie zdecydowanie za dĹ‚ugo")
  // Bazowa: 0.6â†’1.5 energy/tick (2.5Ă—), health 0.18â†’0.45, stress 0.3â†’0.6
  sleepInterval=setInterval(()=>{
    window._sleepTicks++;
    G.energy=clampStat('energy', G.energy+(1.5+totalBonus)*getMedytacjaStressBonus()); // F3-FIX: medytacja
    G.health=clampStat('health', G.health+0.45);
    G.stress=clamp(G.stress+0.15,0,100); /* v2.1.200: 0.6â†’0.15 â€” Agent audyt: sleep tick 200ms, 0.6/tick = 180/min (vs decay 10/min) â†’ 18Ă— imbalance. Teraz 0.15/tick = 45/min â€” sleep nadal regeneruje mood ale nie cap'uje natychmiast. Wraz z decay 1.0/tick=10/min, gracz musi aktywnie zarzÄ…dzaÄ‡ nastrojem. */
    G.hunger=clampStat('hunger', G.hunger-0.22);
    gameMin+=10; // 10 game mins per tick
    snoreTimer+=200;
    if(snoreTimer>=2500){snoreTimer=0;playSnore();}
    bar.style.width=G.energy+'%';
    status.innerHTML=`âšˇ <b style="color:#3498db">${Math.floor(G.energy)}%</b> &nbsp;Â·&nbsp; đźŤ” <b style="color:#27ae60">${Math.floor(G.hunger)}%</b> &nbsp;Â·&nbsp; âť¤ď¸Ź <b style="color:#e74c3c">${Math.floor(G.health)}%</b>`;
    updateHUD();
    // Auto-wake: energy full OR hunger critical OR max 8 game hours (48 ticks * ~10min = 480min = 8h)
    if(G.energy>=100||G.hunger<=3||(window._sleepTicks||0)>=480){
      wakeUp();
    }
  },200);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  REST MINIGAME (sofa/bench/pond) â€” real-time, cancellable
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let _restTimer=null;
let _restOnDone=null;
function stopRest(){
  if(!_restTimer)return;
  clearInterval(_restTimer);_restTimer=null;
  G._resting=false;
  const ov=document.getElementById('rest-overlay');
  if(ov&&ov.parentNode)ov.parentNode.removeChild(ov);
}
function openTVMenu(){
  document.getElementById('ov-content').innerHTML=`
    <h2>đź“ş Telewizor 4K</h2>
    <p class="sub">Co oglÄ…dasz?</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
      <button class="bbtn" onclick="closeOverlay();window.open('https://www.youtube.com','_blank')" style="padding:18px;font-size:15px;background:linear-gradient(135deg,#ff0000,#990000);color:#fff;border:none;border-radius:10px;cursor:pointer;font-weight:700">â–¶ď¸Ź YouTube</button>
      <button class="bbtn" onclick="closeOverlay();window.open('https://www.netflix.com','_blank')" style="padding:18px;font-size:15px;background:linear-gradient(135deg,#e50914,#831010);color:#fff;border:none;border-radius:10px;cursor:pointer;font-weight:700">đźŽ¬ Netflix</button>
      <button class="bbtn" onclick="closeOverlay();window.open('https://open.spotify.com','_blank')" style="padding:18px;font-size:15px;background:linear-gradient(135deg,#1db954,#0a5a2a);color:#fff;border:none;border-radius:10px;cursor:pointer;font-weight:700">đźŽµ Spotify</button>
      <button class="bbtn" onclick="closeOverlay();window.open('https://www.twitch.tv','_blank')" style="padding:18px;font-size:15px;background:linear-gradient(135deg,#9146ff,#5a1aaa);color:#fff;border:none;border-radius:10px;cursor:pointer;font-weight:700">đźŽ® Twitch</button>
    </div>
    <button class="bbtn" onclick="closeOverlay();startRestMG('sofa',20,30,20,'đź“ş OglÄ…dasz TV â€” odpoczywasz...')" style="width:100%;padding:14px;background:#0a1525;border:1px solid #2a3a50;color:#7ec8e3;border-radius:8px;cursor:pointer;font-size:14px;margin-top:6px">đźŚ Odpoczynek przy TV (+30 nastrĂłj, +20 energii)</button>
    <button class="cbtn" style="margin-top:10px" onclick="closeOverlay()">â† WrĂłÄ‡</button>`;
