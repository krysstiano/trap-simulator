          } else {
            closeNPCDlg();
            if(typeof notify==='function') notify('đźŽ¤ Kup mikrofon w Sklepie muzycznym (budynek obok). Cashback 30% po zakupie.');
          }
        }
      },
      {text:()=>`đź’» Side quest 2: Kup komputer z DAW (${G.hasDaw?'1':'0'}/1)`,
        cond:()=>G._questAudioMicDone && !G._questAudioDawDone,
        fn:()=>{
