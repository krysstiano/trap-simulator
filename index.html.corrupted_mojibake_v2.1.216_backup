    case 'cvip_daily_wheel':   drawDailyWheel(sx,sy,w,h,true);break;
    case 'casino_elevator': case 'cvip_elevator': drawElevatorDoor(sx,sy,w,h);break;
    case 'elev_lobby_btn': drawElevatorButton(sx,sy,w,h,'đźŹ›','PARTER','#c8a520');break;
    case 'elev_vip_btn':   drawElevatorVipButton(sx,sy,w,h);break; /* v2.0.0: pokazuje postÄ™p wygranych */
    /* VIP gry */
    case 'cvip_hrslot1': case 'cvip_hrslot2': case 'cvip_hrslot3': drawCasinoVipSlot(sx,sy,w,h);break; /* v2.0.11 */
    case 'cvip_baccarat':  drawBaccaratTable(sx,sy,w,h);break;
