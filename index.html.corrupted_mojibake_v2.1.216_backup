/* v1.9.98: Cinematic odblokowania VIP â€” peĹ‚noekranowa animacja celebrujÄ…ca pierwsze wejĹ›cie */
window.showVipUnlockCinematic=(cb)=>{
  /* v2.0.3: Defensive cleanup â€” usuĹ„ poprzednie instancje (spam-click) */
  document.querySelectorAll('#vip-unlock-cinem').forEach(e=>e.remove());
  /* Cleanup wszelkie zalegajÄ…ce keylistenery */
  if(window._vipEscHandler){document.removeEventListener('keydown',window._vipEscHandler);window._vipEscHandler=null;}
  const ov=document.createElement('div');
  ov.id='vip-unlock-cinem';
  ov.style.cssText='position:fixed;inset:0;background:radial-gradient(ellipse at center,#3a1a4a 0%,#0a0010 80%);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:inherit;color:#fff;text-align:center;overflow:hidden;opacity:0;transition:opacity .5s';
  ov.innerHTML=`
    <div style="position:absolute;top:0;left:0;right:0;height:120px;background:linear-gradient(180deg,#000,transparent);opacity:.9;pointer-events:none"></div>
    <div style="position:absolute;bottom:0;left:0;right:0;height:120px;background:linear-gradient(0deg,#000,transparent);opacity:.9;pointer-events:none"></div>
    <div id="vip-cinem-emoji" style="font-size:140px;text-shadow:0 0 80px rgba(255,215,0,.8);opacity:0;transform:scale(.6);transition:opacity 1s,transform 1s">đź‘‘</div>
    <h1 id="vip-cinem-title" style="font-size:54px;letter-spacing:8px;margin:8px 0 4px;background:linear-gradient(135deg,#ffd700,#c8a520,#ffd700);-webkit-background-clip:text;background-clip:text;color:transparent;font-family:'Russo One','Orbitron',Impact,sans-serif;text-shadow:0 0 30px rgba(255,215,0,.4);opacity:0;transform:scale(.7);transition:opacity 1.5s,transform 1.5s">VIP LOUNGE</h1>
    <div id="vip-cinem-stars" style="font-size:18px;letter-spacing:6px;color:#f1c40f;margin-bottom:30px;opacity:0;transition:opacity 1s">â… â… â… ODBLOKOWANE â… â… â…</div>
    <p id="vip-cinem-desc" style="max-width:640px;font-size:15px;line-height:1.7;color:#e8d8e8;padding:0 40px;opacity:0;transition:opacity 1s">Witaj w ekskluzywnym 1 piÄ™trze Casino Royal!<br>Otrzymujesz dostÄ™p do <b style="color:#f1c40f">7 premium gier</b>: Baccarat, Craps, Poker 5-Card, Plinko, Keno, High-Roller Sloty, VIP Daily Wheel.<br><br><span style="color:#7ec87e">WyĹĽsze stawki = lepsze wypĹ‚aty. Powodzenia!</span></p>
    <button id="vip-unlock-btn" style="margin-top:30px;background:linear-gradient(135deg,#c8a520,#f1c40f);color:#000;border:none;padding:16px 40px;font-size:16px;font-weight:900;letter-spacing:3px;border-radius:12px;cursor:pointer;box-shadow:0 0 30px rgba(255,215,0,.5);opacity:0;transition:opacity 1s">â–¶ WEJDĹą NA 1 PIÄTRO</button>
    <div id="vip-cinem-skip" style="position:absolute;top:14px;right:20px;color:#aaa;font-size:11px;opacity:0;transition:opacity 1s">ESC = pomiĹ„</div>`;
  document.body.appendChild(ov);
  /* Animacje cascada â€” staged reveal */
  requestAnimationFrame(()=>{ov.style.opacity='1';});
  setTimeout(()=>{const e=document.getElementById('vip-cinem-emoji');if(e){e.style.opacity='1';e.style.transform='scale(1)';}},200);
  setTimeout(()=>{const e=document.getElementById('vip-cinem-title');if(e){e.style.opacity='1';e.style.transform='scale(1)';}},700);
  setTimeout(()=>{const e=document.getElementById('vip-cinem-stars');if(e){e.style.opacity='1';}},1300);
  setTimeout(()=>{const e=document.getElementById('vip-cinem-desc');if(e){e.style.opacity='1';}},1700);
  setTimeout(()=>{const e=document.getElementById('vip-unlock-btn');if(e){e.style.opacity='1';}},2200);
  setTimeout(()=>{const e=document.getElementById('vip-cinem-skip');if(e){e.style.opacity='1';}},2200);
  if(typeof confetti==='function') setTimeout(()=>confetti(60),1500);
  let _closed=false;
  const _close=()=>{
    if(_closed) return;
    _closed=true;
    if(window._vipEscHandler){document.removeEventListener('keydown',window._vipEscHandler);window._vipEscHandler=null;}
    if(window._vipAutoTimer){clearTimeout(window._vipAutoTimer);window._vipAutoTimer=null;}
    ov.style.opacity='0';
    setTimeout(()=>{ov.remove();if(cb)cb();},500);
  };
  document.getElementById('vip-unlock-btn').onclick=_close;
  /* v2.0.3: ESC = skip */
  window._vipEscHandler=(e)=>{
    if(e.key==='Escape'){
      e.stopPropagation();
      _close();
    }
  };
  document.addEventListener('keydown',window._vipEscHandler);
  /* Auto-zamkniÄ™cie po 15s (byĹ‚o 12, zwiÄ™kszone) */
  window._vipAutoTimer=setTimeout(()=>{
    if(document.getElementById('vip-unlock-cinem')) _close();
  }, 15000);
};

/* v1.9.96: Prompt dla starych save'Ăłw ktĂłre nie odbyĹ‚y cinematic */
window._showCinematicOffer=()=>{
