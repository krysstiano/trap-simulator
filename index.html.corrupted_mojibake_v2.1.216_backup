    }
  },
  /* Tier 2 Famous — Biography deal (one-time w karierze) */
  {name:'Biography deal', chance:0.003, maxPerDay:1,
    cond:()=>_evPhoneSpot()&&(G.fame||0)>=200&&!G._biographyDone,
    fn:()=>{
      G._biographyDone=true;
      const cash=rnd(25000,35000);
      if(typeof earn==='function') earn(cash,false); else {G.money+=cash;G.totalEarned=(G.totalEarned||0)+cash;}
      /* addFame(30) — przy Tier 2 ÷2 = +15 fame final */
      if(typeof addFame==='function') addFame(30); else G.fame=Math.min(500,(G.fame||0)+15);
      if(typeof confetti==='function') confetti(50);
      notify(`📖 BIOGRAFIA! Wydawnictwo chce Cię na okładce książki "${G.name}: Z ulicy do gwiazd". +${cash.toLocaleString('pl')} zł, +15 sławy.`);
    }
  },
  /* v2.1.216 [Amper]: Tier 4 GOAT — NPC text comments na ulicy (visual immersion). */
  {name:'GOAT recognition', chance:0.04, maxPerDay:3,
    cond:()=>currentRoom==='ulica'&&typeof getFameTier==='function'&&getFameTier()===4,
    fn:()=>{
      const comments=[
        '👀 NPC: "Bracie... to on!"',
        '😯 NPC: "Patrz... legenda!"',
        '🙌 NPC: "Mistrzu, autograf?"',
        '🎤 NPC: "Czy to naprawdę...?"',
        '👑 NPC: "To GOAT polskiego hip-hopu."',
        '🤩 NPC: "Wow, on tutaj?!"',
      ];
      const _msg=comments[Math.floor(Math.random()*comments.length)];
      if(typeof addNotif==='function') addNotif(_msg);
      G.stress=clamp((G.stress||0)+5,0,100);
    }
  },
  /* v2.1.215 [Amper]: Tier 3 Legendary (fame 300+) — Hall of Fame event (one-time + statua w Drip District) */
  {name:'Hall of Fame nomination', chance:0.003, maxPerDay:1,
    cond:()=>_evPhoneSpot()&&(G.fame||0)>=300&&!G._hallOfFameDone&&(G.events?.performed||0)>=20,
    fn:()=>{
      G._hallOfFameDone=true;
      G._hasHallOfFameStatue=true; /* flaga dla statua w Drip District (visual) */
      const cash=50000;
      if(typeof earn==='function') earn(cash,false); else {G.money+=cash;G.totalEarned=(G.totalEarned||0)+cash;}
      /* addFame(60) — przy Tier 3 ÷4 = +15 fame final */
      if(typeof addFame==='function') addFame(60); else G.fame=Math.min(500,(G.fame||0)+15);
      if(typeof confetti==='function') confetti(80);
      notify(`🏛 HALL OF FAME! Polish Hip-Hop Awards uznali Cię za legendę. +${cash.toLocaleString('pl')} zł, +15 sławy, statua w Drip District!`);
      if(typeof showMilestoneCinematic==='function'){
        showMilestoneCinematic({emoji:'🏛',title:'HALL OF FAME',subtitle:'Polish Hip-Hop Legend',tagline:`${G.name||'Twoja'} statua stanie w Drip District — Twoja kariera staje się historią.`,accentColor:'#c8a520',accent2:'#f1c40f',duration:6000});
      }
    }
  },
];

function checkRandomEvents(){
  // F+ Audyt 2026-05-11: cooldowny per event (maxPerDay) â€” niektĂłre eventy
  // zdarzaĹ‚y siÄ™ zbyt czÄ™sto (np. Lucky day kilkanaĹ›cie razy/dzieĹ„)
  if(!G._eventCounts || G._eventCounts.day !== G.day){
    G._eventCounts = {day:G.day, counts:{}};
  }
  for(const ev of RANDOM_EVENTS){
    const limit = ev.maxPerDay || Infinity;
    if((G._eventCounts.counts[ev.name]||0) >= limit) continue;
    if(ev.cond()&&Math.random()<ev.chance){
      ev.fn();
      G._eventCounts.counts[ev.name] = (G._eventCounts.counts[ev.name]||0) + 1;
      return;
    }
  }
  // Eventy z wyborem (rzadziej, raz dziennie max)
  if(G._lastChoiceEventDay===G.day) return;
  for(const ev of CHOICE_EVENTS){
    if(ev.cond()&&Math.random()<ev.chance){G._lastChoiceEventDay=G.day;ev.fn();return;}
  }
}

/* v2.1.214 [Amper]: Sponsor Inbox functions (Faza D). */
function _pushSponsorMessage(type, brandId, extra){
  if(!G.sponsorMessages) G.sponsorMessages=[];
  const brand=getSponsorBrand(brandId);
  if(!brand) return;
  G.sponsorMessages.unshift({
    type, brandId, from:`${brand.pr} (${brand.name})`,
    text: _sponsorMsgTemplate(type, brand),
    day: G.day, read: false,
  });
  /* Cap historii wiadomości na 30 (anti-bloat save) */
  if(G.sponsorMessages.length>30) G.sponsorMessages.length=30;
}
function checkSponsorOffers(){
  /* Tier 2 gating + max 2 aktywne + co 7 dni gry sprawdza */
  if((G.fame||0)<200) return;
  if((G.activeSponsors||[]).length>=2) return;
  if((G._lastSponsorCheckDay||0)===G.day) return;
  if(G.day-(G._lastSponsorCheckDay||0)<7 && G._lastSponsorCheckDay>0) return;
  G._lastSponsorCheckDay=G.day;
  const available=SPONSOR_BRANDS.filter(sponsorBrandAvailable);
  if(available.length===0) return;
  /* 60% szans wygenerować nową ofertę (czasem brak nowych — realistyczne) */
  if(Math.random()>0.6) return;
  const brand=available[Math.floor(Math.random()*available.length)];
  const dripBoost=getSponsorDripBoost();
  const dailyRate=Math.floor(brand.baseDaily*dripBoost);
  if(!G.sponsorOffers) G.sponsorOffers=[];
  G.sponsorOffers.push({
    brandId: brand.id, offeredDay: G.day, expireOfferDay: G.day+5,
    dailyRate, dripBoost,
  });
  _pushSponsorMessage('new_offer', brand.id);
  if(typeof addNotif==='function') addNotif(`📋 Nowa oferta sponsora: ${brand.emoji} ${brand.name}!`);
}
function processSponsorDailyPayments(){
  /* v2.1.214 [Amper]: expire stale offers PRZED active check (audit fix — offer wygasa niezależnie od active sponsorów) */
  if(G.sponsorOffers){
    for(let i=G.sponsorOffers.length-1;i>=0;i--){
      if(G.day>G.sponsorOffers[i].expireOfferDay) G.sponsorOffers.splice(i,1);
    }
  }
  if(!G.activeSponsors||G.activeSponsors.length===0) return;
  let total=0;
  for(let i=G.activeSponsors.length-1;i>=0;i--){
    const s=G.activeSponsors[i];
    if(G.day>s.expireDay){
      /* Wygasł — move to history */
      if(!G.sponsorHistory) G.sponsorHistory=[];
      G.sponsorHistory.push({...s, endDay:s.expireDay, endReason:'expired'});
      _pushSponsorMessage('expired', s.brandId);
      G.activeSponsors.splice(i,1);
      continue;
    }
    total+=s.dailyRate;
    s.totalEarned=(s.totalEarned||0)+s.dailyRate;
  }
  if(total>0){
    if(typeof earn==='function') earn(total,false);
    else {G.money+=total;G.totalEarned=(G.totalEarned||0)+total;}
    if(typeof addNotif==='function') addNotif(`💼 Sponsorzy: +${total.toLocaleString('pl')} zł/dzień`);
  }
  /* v2.1.214 audit fix: stale offers expire już na początku funkcji (przed active early return) */
}
window.acceptSponsorOffer=function(brandId){
  const oIdx=(G.sponsorOffers||[]).findIndex(o=>o.brandId===brandId);
  if(oIdx<0){if(typeof showMsg==='function') showMsg('📋 Oferta wygasła','r');return;}
  if((G.activeSponsors||[]).length>=2){if(typeof showMsg==='function') showMsg('📋 Max 2 aktywne sponsory! Zakończ jeden wcześniej.','r');return;}
  const offer=G.sponsorOffers[oIdx];
  G.sponsorOffers.splice(oIdx,1);
  if(!G.activeSponsors) G.activeSponsors=[];
  G.activeSponsors.push({
    brandId:brandId, signedDay:G.day, expireDay:G.day+10,
    dailyRate:offer.dailyRate, totalEarned:0, renewalCount:0,
  });
  const brand=getSponsorBrand(brandId);
  _pushSponsorMessage('signed', brandId);
  if(typeof showMsg==='function') showMsg(`📋 ${brand.emoji} ${brand.name} podpisany! ${offer.dailyRate} zł/dzień przez 10 dni.`,'g',5000);
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};
window.declineSponsorOffer=function(brandId){
  const oIdx=(G.sponsorOffers||[]).findIndex(o=>o.brandId===brandId);
  if(oIdx<0) return;
  G.sponsorOffers.splice(oIdx,1);
  if(typeof notify==='function') notify('📋 Oferta odrzucona.');
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};
window.cancelSponsor=function(brandId){
  const sIdx=(G.activeSponsors||[]).findIndex(s=>s.brandId===brandId);
  if(sIdx<0) return;
  const s=G.activeSponsors[sIdx];
  if(!G.sponsorHistory) G.sponsorHistory=[];
  G.sponsorHistory.push({...s, endDay:G.day, endReason:'cancelled'});
  G.activeSponsors.splice(sIdx,1);
  if(typeof notify==='function') notify('📋 Sponsor anulowany.');
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};
/* v2.1.214 [Amper] AUDIT FIX: PR drama events — user explicit zatwierdził w planie, ale pominięte w głównej implementacji.
   Random check 1×/dzień gry per active sponsor (~6% szans). Jednorazowy bonus za akceptu, brak penalty za odrzuć. */
const PR_DRAMA_TEMPLATES = {
  nike:    [{id:'sport_post', ask:'Justin: "Wrzuć Insta post w sport gear — nasz nowy collab launch."', accept:'+800 zł natychmiast', reward:800},
           {id:'gym_video', ask:'Justin: "Nakręć krótkie video z siłowni dla Nike Training Club."', accept:'+1000 zł natychmiast', reward:1000}],
  adidas:  [{id:'race_event', ask:'Klaus: "Mamy charytatywny bieg w mieście — pojaw się w naszych kolorach."', accept:'+1000 zł + 50 fanów', reward:1000, fans:50},
           {id:'product_drop', ask:'Klaus: "Nowy dropbie collab. Pokaż na story że masz na sobie nowe kicksy."', accept:'+900 zł natychmiast', reward:900}],
  supreme: [{id:'street_collab', ask:'Drake: "Wbij na nasz lookbook shoot — street vibes, nasi fotografowie."', accept:'+1200 zł + 100 fanów', reward:1200, fans:100},
           {id:'limited_drop', ask:'Drake: "Limited drop friday — bądź pierwszy w sklepie, my zrobimy szum."', accept:'+1100 zł natychmiast', reward:1100}],
  gucci:   [{id:'fashion_week', ask:'Mara: "Fashion week Milano — bądź gościem w pierwszym rzędzie."', accept:'+1500 zł + 5 sławy', reward:1500, fame:5},
           {id:'magazine_shoot', ask:'Mara: "Specjalna sesja dla Vogue Italia w naszych ubraniach."', accept:'+1300 zł natychmiast', reward:1300}],
  bmw:     [{id:'launch_event', ask:'Hans: "Launch nowego modelu — bądź gościem honorowym."', accept:'+1400 zł + 5 sławy', reward:1400, fame:5},
           {id:'test_drive', ask:'Hans: "Nakręć test drive video naszego nowego concept car."', accept:'+1200 zł natychmiast', reward:1200}],
  rolex:   [{id:'gala_dinner', ask:'Dimitri: "Roczna gala Rolex — eksklusywne zaproszenie."', accept:'+2000 zł + 8 sławy', reward:2000, fame:8},
           {id:'limited_watch', ask:'Dimitri: "Otrzymasz limited edition jako prezent — zapis o nim na social."', accept:'+1500 zł + 3 sławy', reward:1500, fame:3}],
};
function checkSponsorDrama(){
  if(!G.activeSponsors||G.activeSponsors.length===0) return;
  /* Cooldown: max 1 drama na 5 dni gry */
  if((G._lastSponsorDramaDay||0)>0 && (G.day-G._lastSponsorDramaDay)<5) return;
  /* 6% szans dla każdego active sponsor — w sumie max ~12% szans gdy 2 active */
  for(const s of G.activeSponsors){
    if(Math.random()<0.06){
      const templates=PR_DRAMA_TEMPLATES[s.brandId];
      if(!templates) continue;
      const drama=templates[Math.floor(Math.random()*templates.length)];
      if(!G.sponsorMessages) G.sponsorMessages=[];
      G.sponsorMessages.unshift({
        type:'pr_drama', brandId:s.brandId,
        from:`${getSponsorBrand(s.brandId)?.pr} (${getSponsorBrand(s.brandId)?.name})`,
        text:drama.ask, accept:drama.accept, reward:drama.reward,
        fameBonus:drama.fame||0, fansBonus:drama.fans||0,
        dramaId:drama.id, day:G.day, read:false, pending:true,
      });
      G._lastSponsorDramaDay=G.day;
      if(typeof addNotif==='function') addNotif(`📋 PR drama: ${getSponsorBrand(s.brandId)?.emoji} prośba od marki`);
      break; /* max 1 drama per dzień gry */
    }
  }
}
window.acceptPRDrama=function(dramaId){
  if(!G.sponsorMessages) return;
  const msg=G.sponsorMessages.find(m=>m.type==='pr_drama'&&m.dramaId===dramaId&&m.pending);
  if(!msg) return;
  msg.pending=false;
  if(typeof earn==='function') earn(msg.reward,false); else {G.money+=msg.reward;G.totalEarned=(G.totalEarned||0)+msg.reward;}
  if(msg.fameBonus>0 && typeof addFame==='function') addFame(msg.fameBonus);
  if(msg.fansBonus>0 && typeof addFans==='function') addFans(msg.fansBonus);
  if(typeof showMsg==='function') showMsg(`📋 PR drama akceptowany! ${msg.accept}`,'g',5000);
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};
window.declinePRDrama=function(dramaId){
  if(!G.sponsorMessages) return;
  const msg=G.sponsorMessages.find(m=>m.type==='pr_drama'&&m.dramaId===dramaId&&m.pending);
  if(!msg) return;
  msg.pending=false;
  if(typeof notify==='function') notify('📋 PR drama odrzucone.');
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};

/* v2.1.216 [Amper]: Atelier — Crown of Hip-Hop buy handler (Tier 4 GOAT exclusive). */
window.buyCrownOfHipHop=function(){
  if((G.fame||0)<400){if(typeof showMsg==='function') showMsg('👑 Wymaga Tier 4 GOAT (fame 400+)','r');return;}
  if(G.money<100000){if(typeof showMsg==='function') showMsg('💵 Brak kasy (potrzeba 100k zł)','r');return;}
  if(G._hasCrownOfHipHop){if(typeof showMsg==='function') showMsg('👑 Już posiadasz Crown of Hip-Hop','f');return;}
  G.money-=100000;
  G._hasCrownOfHipHop=true;
  G.outfit=G.outfit||{};G.outfit.top='crown_of_hh';
  if(typeof showMsg==='function') showMsg('👑 CROWN OF HIP-HOP! Maestro: "Korona dla legendy." Status GOAT widoczny dla wszystkich. +20% concert earn.','g',7000);
  if(typeof confetti==='function') confetti(60);
  if(typeof showMilestoneCinematic==='function'){
    showMilestoneCinematic({emoji:'👑',title:'CROWN OF HIP-HOP',subtitle:'GOAT Status',tagline:'Twoja korona stanęła nad Tobą. Jesteś już nie raperem — jesteś legendą.',accentColor:'#c8a520',accent2:'#f1c40f',duration:6500});
  }
  if(typeof renderPhoneApp==='function') renderPhoneApp('atelier');
  if(typeof saveGameSilent==='function') saveGameSilent();
};

window.renewSponsor=function(brandId, mode){
  const sIdx=(G.activeSponsors||[]).findIndex(s=>s.brandId===brandId);
  if(sIdx<0) return;
  const s=G.activeSponsors[sIdx];
  /* Renewal tylko jeśli kontrakt wygasa w ciągu 3 dni */
  if(s.expireDay-G.day>3){if(typeof showMsg==='function') showMsg('📋 Renewal dostępny na 3 dni przed końcem.','r');return;}
  if(mode==='same'){
    s.expireDay=G.day+10; s.renewalCount=(s.renewalCount||0)+1;
    if(typeof showMsg==='function') showMsg(`📋 Kontrakt odnowiony! +10 dni.`,'g');
  } else if(mode==='negotiate'){
    const success=Math.random()<0.70;
    if(success){
      s.dailyRate=Math.floor(s.dailyRate*1.10);
      s.expireDay=G.day+10; s.renewalCount=(s.renewalCount||0)+1;
      if(typeof showMsg==='function') showMsg(`📋 Negocjacja sukces! +10% rate → ${s.dailyRate} zł/dzień, +10 dni.`,'g',5000);
    } else {
      if(!G.sponsorHistory) G.sponsorHistory=[];
      G.sponsorHistory.push({...s, endDay:G.day, endReason:'negotiation_failed'});
      G.activeSponsors.splice(sIdx,1);
      const brand=getSponsorBrand(brandId);
      if(typeof showMsg==='function') showMsg(`📋 ${brand?.name}: "Niestety, nie zgodzimy się na podwyżkę. Kończymy współpracę." Kontrakt zerwany!`,'r',6000);
    }
  }
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};

