  /* v2.1.201 [Amper]: 3 nowe NPCs z side questami â€” DJ Tola, Janek Audio Consultant, Anita Promoter */
  dj: {
    name:'đźŽ§ DJ Tola â€” Radio Street',
    lines:[
      'Yo! SĹ‚yszaĹ‚em twoje bity. MogĹ‚abym kilka puĹ›ciÄ‡ na antenie.',
      'Radio to jeszcze dziaĹ‚a w 2026? Pewnie ĹĽe tak â€” ludzie sĹ‚uchajÄ… w aucie.',
      'WyĹ›lij bit do mojego slotu â€” promocja na ĹĽywo dla caĹ‚ego miasta.',
    ],
    opts:[
      {text:()=>`đź“» Side quest: WyĹ›lij 3 bity na radio (${Math.min(G.radio?.beats||0,3)}/3)`,
        cond:()=>!(G._questDjBeats3Done),
        fn:()=>{
          const sent=G.radio?.beats||0;
          if(sent>=3){
            G._questDjBeats3Done=true;
            if(typeof earn==='function') earn(2500,false); else {G.money+=2500;G.totalEarned=(G.totalEarned||0)+2500;}
            if(typeof addFame==='function') addFame(5); else G.fame=clamp((G.fame||0)+5,0,500);
            G.streetRep=clamp((G.streetRep||0)+5,0,100);
            closeNPCDlg();
            if(typeof showMsg==='function') showMsg('đźŽ§ DJ Tola: "Twoje bity graĹ‚y trzy razy! SĹ‚uchacze pytali kto to. +2500 zĹ‚, +5 sĹ‚awy, +5 rep ulicy"','g',6000);
          } else {
            closeNPCDlg();
            if(typeof notify==='function') notify(`đź“» WyĹ›lij ${3-sent} wiÄ™cej bitĂłw do Radio Street (Sklep muzyczny â†’ Radio)`);
          }
        }
      },
      {text:'âś“ Quest "3 bity" odebrany',
        cond:()=>G._questDjBeats3Done && !G._questDjAlbumDone,
        fn:()=>{closeNPCDlg();notify('đźŽ§ WrĂłÄ‡ z 1 wydanym albumem â€” kolejny quest dostÄ™pny.');}
      },
      {text:()=>`đź“€ Side quest 2: Wydaj 1 album (${G.albumsReleased||0}/1)`,
        cond:()=>G._questDjBeats3Done && !G._questDjAlbumDone,
        fn:()=>{
          if((G.albumsReleased||0)>=1){
            G._questDjAlbumDone=true;
            if(typeof earn==='function') earn(8000,false); else {G.money+=8000;G.totalEarned=(G.totalEarned||0)+8000;}
            if(typeof addFame==='function') addFame(10); else G.fame=clamp((G.fame||0)+10,0,500);
            if(typeof addFans==='function') addFans(200);
            closeNPCDlg();
            if(typeof showMsg==='function') showMsg('đźŽ§ DJ Tola: "TwĂłj album rozkrÄ™ciĹ‚ radio! +8000 zĹ‚, +10 sĹ‚awy, +200 fanĂłw"','g',6000);
          } else {
            closeNPCDlg();
            if(typeof notify==='function') notify('đź“€ Wydaj 1 album w studio aby skoĹ„czyÄ‡ quest.');
          }
        }
      },
      {text:'âť“ Jak wysĹ‚aÄ‡ bit?', fn:()=>{
        closeNPCDlg();
        if(typeof showMsg==='function') showMsg('đźŽ§ OtwĂłrz Radio Street (budynek obok) â†’ wybierz slot â†’ wyĹ›lij bit. KaĹĽdy bit musi speĹ‚niaÄ‡ wymogi slotu (Spotify, tracki). Bity tworzysz przez komputer (DAW â†’ Beatmaker â†’ Sequencer).','f',9000);
