        G.money-=lend;
        notify(`đźšŞ SÄ…siad poprosiĹ‚ o poĹĽyczkÄ™ â€” daĹ‚eĹ› ${lend} zĹ‚. MoĹĽe zwrĂłci, moĹĽe nie.`);
