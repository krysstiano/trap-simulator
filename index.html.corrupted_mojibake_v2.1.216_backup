function buildMaps(){
  // Ulica (90x75 tiles) â€” trzy drogi + skrzyĹĽowania V1/V2/V3
  const ru=ROOMS.ulica;ru.map=[];
  for(let r=0;r<ru.hT;r++){
    ru.map.push([]);
    for(let c=0;c<ru.wT;c++){
      const isH1=r>=8&&r<=11;
      const isH2=r>=40&&r<=43;
      const isH3=r>=60&&r<=63; // H3 na peĹ‚nej szerokoĹ›ci mapy
      const isV1=c>=16&&c<=19;
      const isV2=c>=46&&c<=49;
      const isV3=c>=72&&c<=75; // V3 idzie peĹ‚nym pionem
      const isRoad=isH1||isH2||isH3||isV1||isV2||isV3;
      const isSideH1=(r===6||r===7||r===12||r===13);
      const isSideH2=(r===38||r===39||r===44||r===45);
      const isSideH3=(r===58||r===59||r===64||r===65); // H3 chodnik peĹ‚na szerokoĹ›Ä‡
      const isSideV=((c===14||c===15||c===20||c===21||c===44||c===45||c===50||c===51)&&!isRoad)||
                    ((c===70||c===71||c===76||c===77)&&!isRoad); // V3 sidewalk peĹ‚nym pionem
      let t;
      // Park: ROZSZERZONY â€” peĹ‚na szerokoĹ›Ä‡ Z1 (do lewej krawÄ™dzi mapy), c=0-13, r=18-25 (14Ă—8 kafli).
      // Pixel: x=0-672, y=864-1200.
      const inParkBox = !isRoad && !(isSideH1||isSideH2||isSideH3||isSideV) && r>=18 && r<=25 && c>=0 && c<=13;
      const isPark = inParkBox; // peĹ‚en prostokÄ…t â€” bez okrÄ…gĹ‚ego ksztaĹ‚tu
      // ĹšcieĹĽka â€” od chodnika V1 (c=13) w lewo do c=2 (sklepĂłw), centralny rzÄ…d r=21
      const pathYAt = c => 21 + Math.round(Math.sin((c-2)*0.55)*1.4);
      const isParkPath = isPark && (r===pathYAt(c) || r===pathYAt(c)+1);
      // WejĹ›cie â€” przerwa w pĹ‚ocie od strony V1 chodnika (wschĂłd), c=13, r=21-22
      const isParkEntrance = isPark && c===13 && (r===21||r===22);
      const isFlowerBed = isPark && (
        (r===18&&c===0) || (r===18&&c===13) ||
        (r===25&&c===0) || (r===25&&c===13)
      );
      // Strefy commercial (Z2, Z3, Z4) miÄ™dzy chodnikami = ciemny miejski "concrete/podjazd"
      // ĹĽeby miÄ™dzy blokami NIE widaÄ‡ zielonej trawy.
      // Dolny pas (r>=66): Z3 (Drip District S â€” Balenciaga/Bottega/Dior/Prada) teĹĽ commercial,
      //   ale Z1/Z2/Z4 zostajÄ… zielone bo to apartamenty mieszkalne (apt_basic/penthouse/premium).
      const inCommercialZone = (c>=22 && c<=43) || (c>=52 && c<=69) || (c>=78 && c<=89);
      const inMidCentral = r>=14 && r<=37;       // miÄ™dzy H1 (12-13) i H2 (38-39)
      const inMidH2H3 = r>=46 && r<=57;          // miÄ™dzy H2 (44-45) i H3 (58-59) â€” Drip N strefa
      const inDripSouth = r>=66 && (c>=52 && c<=69); // dolny pas tylko Z3 (Drip S)
      const isUrbanFiller = !isRoad && !(isSideH1||isSideH2||isSideH3||isSideV)
                            && ((inCommercialZone && (inMidCentral||inMidH2H3)) || inDripSouth);
      if(isRoad){t='road';}
      else if(isSideH1||isSideH2||isSideH3||isSideV){t='side';}
      else if(isParkPath){t='sand';}
      else if(isFlowerBed){t='flowerbed';}
      else if(isPark){t='park';}
      else if(r<=1||r>=73){t='gdark';}
      else if(isUrbanFiller){t='urban';}
      else{t='grass';}
      ru.map[r].push(t);
    }
  }
  // Mieszkanie (Traphouse)
  const rm=ROOMS.mieszkanie;rm.map=[];
  for(let r=0;r<rm.hT;r++){rm.map.push([]);for(let c=0;c<rm.wT;c++)rm.map[r].push(r<2?'wallp':'wood');}
  // Apartament Premium
  const rmp=ROOMS.mieszkanie_premium;rmp.map=[];
  for(let r=0;r<rmp.hT;r++){rmp.map.push([]);for(let c=0;c<rmp.wT;c++)rmp.map[r].push(r<2?'wallp':'parquet');}
  // Penthouse Lux
  const rml=ROOMS.mieszkanie_lux;rml.map=[];
  for(let r=0;r<rml.hT;r++){rml.map.push([]);for(let c=0;c<rml.wT;c++)rml.map[r].push(r<2?'wallp_lux':'marble');}
  // SiĹ‚ownia
  const rs=ROOMS.silownia;rs.map=[];
  for(let r=0;r<rs.hT;r++){rs.map.push([]);for(let c=0;c<rs.wT;c++)rs.map[r].push(r<2?'wallp':'gym');}
  // Studio Projektowania (merch_studio)
  const rms=ROOMS.merch_studio;rms.map=[];
  for(let r=0;r<rms.hT;r++){rms.map.push([]);for(let c=0;c<rms.wT;c++)rms.map[r].push(r<2?'wallp':'parquet');}
  // Studio
  const rst=ROOMS.studio;rst.map=[];
  for(let r=0;r<rst.hT;r++){rst.map.push([]);for(let c=0;c<rst.wT;c++)rst.map[r].push(r<2?'wallp':'wood');}
  // Kasyno â€” bordowy dywan z zĹ‚otym wzorem
  const rcas=ROOMS.casino;rcas.map=[];
  for(let r=0;r<rcas.hT;r++){rcas.map.push([]);for(let c=0;c<rcas.wT;c++)rcas.map[r].push(r<2?'wallp':'casino_carpet');}
  /* v1.9.91: Kasyno VIP â€” premium 1 piÄ™tro */
  /* v2.0.11: Casino VIP â€” premium 2-warstwowa podĹ‚oga.
     - r<2: wallp_lux (Ĺ›ciany)
     - r=2-3 Ĺ›rodek: vip_carpet (czerwony chodnik z gold pattern dla wejĹ›cia)
     - reszta: vip_marble (czarno-gold marble) */
  const rcvip=ROOMS.casino_vip;rcvip.map=[];
  for(let r=0;r<rcvip.hT;r++){
    rcvip.map.push([]);
    for(let c=0;c<rcvip.wT;c++){
      let tile;
      if(r<2) tile='wallp_lux';
      else if(r>=10 && r<=12 && c>=10 && c<=14) tile='vip_carpet'; /* czerwony dywan na wejĹ›ciu (Ĺ›rodek-dĂłĹ‚) */
      else tile='vip_marble';
      rcvip.map[r].push(tile);
    }
  }
  /* v1.9.95: Winda â€” wiÄ™kszy interior z lux floor + walls (16Ă—11 zamiast 8Ă—7) */
  const relev=ROOMS.elevator;relev.map=[];
  for(let r=0;r<relev.hT;r++){relev.map.push([]);for(let c=0;c<relev.wT;c++)relev.map[r].push(r<3?'wallp_lux':'marble');}
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  RENDERING
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let currentRoom='ulica';
function wx2sx(wx){return wx-cam.x;}
function wy2sy(wy){return wy-cam.y+62;}

function drawTileMap(room){
  const ox=-cam.x,oy=-cam.y+62;
  const wW=room.wT*T, wH=room.hT*T;
  // Gdy pokĂłj jest mniejszy niĹĽ viewport (np. studio 1056Ă—672, silownia 960Ă—672 vs 1280Ă—658),
  // dorysuj ciemne tĹ‚o aby NIE byĹ‚o pustego czarnego paska po prawej / na dole.
  if(wW<1280 || wH<658){
    X.fillStyle='#0e1420';
    X.fillRect(0,62,1280,658);
    // Subtelny gradient ĹĽeby nie wyglÄ…daĹ‚o jak "out-of-bounds"
    const g=X.createLinearGradient(0,62,0,720);
    g.addColorStop(0,'rgba(50,30,50,.10)');g.addColorStop(1,'rgba(0,0,0,.30)');
    X.fillStyle=g;X.fillRect(0,62,1280,658);
  }
  for(let r=0;r<room.hT;r++){
    for(let c=0;c<room.wT;c++){
      const tx=c*T+ox,ty=r*T+oy;
      if(tx>-T&&tx<1280&&ty>-T&&ty<720){
        const id=room.map[r][c];
        if(tiles[id]) X.drawImage(tiles[id],tx,ty);
      }
    }
  }
}

function drawObjects(room){
  const nearId=getNear();
  for(const obj of room.objects){
    // NPC fan only visible when player has fans
    if(obj.id==='npc_fan'&&(G.fans||0)<10) continue;
    const sx=wx2sx(obj.wx),sy=wy2sy(obj.wy);
    // Clipping uwzglÄ™dnia szerokoĹ›Ä‡ obiektu â€” dla dĹ‚ugich Ĺ›cian (np. wall_h2b lux: 1480px)
    // sam sx nie wystarczy: lewa krawÄ™dĹş moĹĽe byÄ‡ daleko poza ekranem, a prawa wciÄ…ĹĽ widoczna.
    // v1.9.20: Dodano Y-axis culling â€” wczeĹ›niej offscreen pionowe obiekty peĹ‚zĹ‚y peĹ‚en pipeline rysowania
    if(sx+obj.w<-50||sx>1530||sy+(obj.h||64)<-50||sy>820) continue;
    if(nearId===obj.id){
      const pulse=0.55+0.45*Math.sin(anim*0.12);
      X.save();
      // Aura â€” radial gradient za obiektem (zamiast tylko ring)
      X.globalCompositeOperation='lighter';
      const cx=sx+obj.w/2,cy=sy+obj.h/2;
      const r=Math.max(obj.w,obj.h)*0.7;
      const g=X.createRadialGradient(cx,cy,obj.w*0.3,cx,cy,r);
      g.addColorStop(0,`rgba(126,200,227,${0.18+pulse*0.10})`);
      g.addColorStop(0.6,`rgba(126,200,227,${0.05+pulse*0.05})`);
      g.addColorStop(1,'rgba(126,200,227,0)');
      X.fillStyle=g;X.fillRect(sx-r/2,sy-r/2,obj.w+r,obj.h+r);
      X.globalCompositeOperation='source-over';
      // Ring â€” dotychczasowy
      X.shadowColor='#7ec8e3';X.shadowBlur=18+10*pulse;
      X.strokeStyle=`rgba(126,200,227,${0.6+0.4*pulse})`;X.lineWidth=2;
      X.strokeRect(sx-3,sy-3,obj.w+6,obj.h+6);
      X.restore();
    }
    drawSprite(obj.id,sx,sy,obj.w,obj.h);
  }
}

function drawSprite(id,sx,sy,w,h){
  X.save();
  switch(id){
    case 'bed':          drawBed(sx,sy,w,h);break;
    case 'fridge':       drawFridge(sx,sy,w,h);break;
