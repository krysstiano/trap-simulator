    case 'cvip_cashier':   drawCasinoCashierObj(sx,sy,w,h);break; /* v2.1.0 */
    case 'npc_cvip_host': drawCroupier(sx,sy,w,h);break;
    case 'npc_cvip_guest1':
    case 'npc_cvip_guest2':
    case 'npc_cvip_guest3': drawCasinoGuest(sx,sy,w,h,id);break;
    case 'npc_croupier':  drawCroupier(sx,sy,w,h);break;
    case 'npc_barman':    drawBarman(sx,sy,w,h);break;
    case 'npc_casino_guest1':
    case 'npc_casino_guest2':
    case 'npc_casino_guest3':
    case 'npc_casino_guest4': drawCasinoGuest(sx,sy,w,h,id);break;
    case 'wardrobe':     drawWardrobe(sx,sy,w,h);break;
    case 'save':         drawSavePoint(sx,sy,w,h);break;
    case 'apt_cust':     drawAptCust(sx,sy,w,h);break;
    case 'phone_home':   drawPhoneObj(sx,sy,w,h);break;
    case 'traphouse':    drawBuilding(sx,sy,w,h,'#2a3a2a','Traphouse','#7ec87e','đźŹšď¸Ź');break;
    case 'apt_basic':    drawAptBasic(sx,sy,w,h);break;
    case 'apt_premium':  drawAptPremium(sx,sy,w,h);break;
    case 'apt_penthouse':drawAptPenthouse(sx,sy,w,h);break;
    case 'apt_mansion':  drawMansion(sx,sy,w,h);break; /* v2.1.162: Mansion drawing */
    case 'apt_mega_villa': drawMegaVilla(sx,sy,w,h);break; /* v2.1.215: Mega Villa drawing */
    case 'hof_statue': if(G._hasHallOfFameStatue) drawHofStatue(sx,sy,w,h); break; /* v2.1.215: Hall of Fame statue */
    case 'sklep':        drawBuilding(sx,sy,w,h,'#3a2a1a','Sklep','#f1c40f','đź›’',true,{commercial:true});drawSupermarketWindow(sx,sy,w,h);drawShopAwning(sx,sy,w,h,'#5a4020','#f1c40f','#3a2a10');break;
    case 'mediamarkt':   drawBuilding(sx,sy,w,h,'#3a0000','Media Markt','#e74c3c','đź“ş',false,{commercial:true});break;
    case 'muzyczny':     drawBuilding(sx,sy,w,h,'#1a0a3a','Sklep Muzyczny','#9b59b6','đźŽ¸',false,{commercial:true});break;
    case 'ubrania':      drawBuilding(sx,sy,w,h,'#3a1a3a','Ubrania','#e91e8c','đź‘—',false,{commercial:true});break;
