    case 'kurier':       drawBuilding(sx,sy,w,h,'#2a1a0a','Kurier','#f39c12','đźš´',true,{commercial:true});break;
    case 'zmywak':       drawBuilding(sx,sy,w,h,'#0a2a2a','Zmywak','#1abc9c','đźŤ˝ď¸Ź',false,{commercial:true});break;
    case 'pizzeria':     drawBuilding(sx,sy,w,h,'#3a1a0a','Pizzeria','#e67e22','đźŤ•',true,{commercial:true});drawPizzeriaExtras(sx,sy,w,h);drawShopAwningPizzeria(sx,sy,w,h);break;
    case 'supermarket':  drawBuilding(sx,sy,w,h,'#0a2a0a','Supermarket','#2ecc71','đź›Ťď¸Ź',true,{commercial:true});drawSupermarketWindow(sx,sy,w,h);drawShopAwningSupermarket(sx,sy,w,h);break;
    case 'restauracja':  drawBuilding(sx,sy,w,h,'#2a1a0a','Restauracja','#e67e22','đźŤ˝ď¸Ź',true,{commercial:true});drawRestaurantAwning(sx,sy,w,h);break;
    case 'carwash':      drawBuilding(sx,sy,w,h,'#0a1a3a','Myjnia','#3498db','đźš—',true,{commercial:true});drawCarwashExtras(sx,sy,w,h);drawShopAwningCarwash(sx,sy,w,h);break;
    case 'construction': drawBuilding(sx,sy,w,h,'#3a2a0a','Budowa','#f1c40f','đźŹ—ď¸Ź',true,{commercial:true});drawConstructionExtras(sx,sy,w,h);break;
    case 'sala_konce':   drawBuilding(sx,sy,w,h,'#1a0a3a','Sala Koncertowa','#e91e8c','đźŽ¤',true,{commercial:true});drawConcertHallExtras(sx,sy,w,h);break;
    case 'sala_konce2':  drawBuilding(sx,sy,w,h,'#1a1a2a','Parking','#aaaaaa',null,false,{commercial:true});break;
    case 'biuro_nieruch':drawBuilding(sx,sy,w,h,'#1a2a3a','NieruchomoĹ›ci','#3498db','đźŹ ',false,{commercial:true});drawBiuroExtras(sx,sy,w,h);break;
    case 'salon':        drawBuilding(sx,sy,w,h,'#0a1a0a','Salon Aut','#27ae60','đźš',false,{commercial:true});drawSalonExtras(sx,sy,w,h);break;
    case 'radio_st':     drawBuilding(sx,sy,w,h,'#2a0a1a','Radio Street','#e74c3c','đź“»',false,{commercial:true});drawRadioExtras(sx,sy,w,h);break;
    case 'targ':         drawBuilding(sx,sy,w,h,'#2a3a0a','Targ','#f1c40f','đźŹŞ',true,{commercial:true});break;
    case 'warsztat':     drawBuilding(sx,sy,w,h,'#1a1a0a','Warsztat','#e67e22','đź”§',true,{commercial:true});drawWarsztatExtras(sx,sy,w,h);break;
    case 'casino':       drawCasino(sx,sy,w,h);break;
    case 'parking':      drawParking(sx,sy,w,h);break;
    case 'park_monument':drawParkMonument(sx,sy,w,h);break;
    case 'park_bench2':  drawBench(sx,sy,w,h);break;
    case 'penthouse_helipad': drawPenthouseHelipad(sx,sy,w,h);break;
    case 'penthouse_antenna': drawPenthouseAntenna(sx,sy,w,h);break;
    case 'meble':        drawBuilding(sx,sy,w,h,'#003087','','#FFDA1A',null,true,{commercial:true});drawIKEASign(sx,sy,w,h);break;
    case 'merch_studio': drawBuilding(sx,sy,w,h,'#3a1a2a','Studio Merch','#e91e63','đź§˘',true,{commercial:true});break;
    case 'merch_designer': drawMerchDesignerObj(sx,sy,w,h);break;
    case 'merch_factory':  drawMerchFactoryObj(sx,sy,w,h);break;
    case 'merch_warehouse':drawMerchWarehouseObj(sx,sy,w,h);break;
    case 'merch_report':   drawMerchReportObj(sx,sy,w,h);break;
    // â”€â”€ Dzielnica Dripu â”€â”€
    case 'lv':          drawLuxuryBuilding(sx,sy,w,h,'LV','#c8a520');break;
    case 'chanel':      drawLuxuryBuilding(sx,sy,w,h,'CHANEL','#1a1a1a',true);break;
    case 'hermes':      drawLuxuryBuilding(sx,sy,w,h,'HERMĂS','#cc5500');break;
    case 'gucci':       drawLuxuryBuilding(sx,sy,w,h,'GUCCI','#1a3a1a');break;
    case 'balenciaga':  drawLuxuryBuilding(sx,sy,w,h,'BALENCIAGA','#000000',true);break;
    case 'bottega':     drawLuxuryBuilding(sx,sy,w,h,'BOTTEGA','#8b7355');break;
    case 'dior':        drawLuxuryBuilding(sx,sy,w,h,'DIOR','#0a2a5a',true);break;
    case 'prada':       drawLuxuryBuilding(sx,sy,w,h,'PRADA','#1a1a1a');break;
    case 'freestyle_spot': drawFreestyleSpot(sx,sy,w,h);break;
    case 'npc_quest':    drawNPC(sx,sy,w,h,'#e0c890','#2a4a2a','âť“');break;
    case 'bench':        drawBench(sx,sy,w,h);drawBenchSitter(sx,sy,w,h,1);break;
    case 'pond':         drawPondSurface(sx,sy,w,h);break;
    case 'skate':        drawSkatepark(sx,sy,w,h);break;
    case 'bboying':      drawBboyFloor(sx,sy,w,h);break;
    case 'bench_press':    drawBenchPress(sx,sy,w,h);break;
    case 'treadmill':      drawTreadmill(sx,sy,w,h);break;
    case 'cable_machine':  drawCableMachine(sx,sy,w,h);break;
    case 'mic_booth':      drawBooth(sx,sy,w,h);break;
    case 'mixer':          drawMixer(sx,sy,w,h);break;
    case 'computer':       drawStudioComputer(sx,sy,w,h);break;
    case 'npc_fan':      drawNPC(sx,sy,w,h,'#e0a870','#1e6030','đź‘¤');break;
    case 'npc_manager':  drawNPC(sx,sy,w,h,'#c07840','#1a2a6a','đź¤µ');break;
    case 'npc_producer': drawNPC(sx,sy,w,h,'#704020','#4a0a6a','đźŽ§');break;
    case 'npc_vendor':   drawKebabStand(sx,sy,w,h);drawNPC(sx,sy,w,h,'#d0a040','#3a1a0a','đźŚ®');break;
    case 'npc_crew':     drawNPC(sx,sy,w,h,'#a0c080','#1a3a2a','đź‘Ą');break;
    case 'npc_casino_promo': drawNPC(sx,sy,w,h,'#d4a070','#c01020','đźŽ°');break;
    case 'npc_booking':  drawNPC(sx,sy,w,h,'#e0c8a0','#1a1a4a','đź“…');break;
    /* v2.1.203 [Amper]: drawing cases dla 3 nowych NPCs z v2.1.201 (wczeĹ›niej rysowali siÄ™ jako placeholder tekst id). */
    case 'npc_dj':       drawNPC(sx,sy,w,h,'#9b59b6','#e91e8c','đźŽ§');break;
    case 'npc_audio':    drawNPC(sx,sy,w,h,'#7ec8e3','#1a3a5a','đźŽ¤');break;
    case 'npc_promoter': drawNPC(sx,sy,w,h,'#e67e22','#c0392b','đźŽŻ');break;
    case 'pool':           drawPool(sx,sy,w,h);break;
    case 'fountain':       drawFountain(sx,sy,w,h);break;
    case 'park_lamp1':case 'park_lamp2':case 'park_lamp3':case 'park_lamp4': drawParkLamp(sx,sy,w,h);break;
    case 'park_bush1':case 'park_bush2':case 'park_bush3': drawParkBush(sx,sy,w,h);break;
    case 'park_trash':     drawParkTrash(sx,sy,w,h);break;
    case 'bench2':         drawBench(sx,sy,w,h);drawBenchSitter(sx,sy,w,h,2);break;
    // Zagospodarowanie wokol budynkow mieszkaniowych
    case 'apt1_bench':case 'apt1_bench2':case 'apt4_bench':case 'apt4_bench2': drawBench(sx,sy,w,h);break;
    case 'apt2_bench':case 'apt2_bench2': drawDesignerBench(sx,sy,w,h);break; // Penthouse â€” premium marmur+chrom
    case 'apt1_lamp':case 'apt2_lamp1':case 'apt2_lamp2':case 'apt2_lamp3':case 'apt2_lamp4':case 'apt4_lamp1':case 'apt4_lamp2':case 'apt4_lamp3': drawParkLamp(sx,sy,w,h);break;
    case 'apt1_bush1':case 'apt1_bush2':case 'apt2_bush1':case 'apt2_bush2':case 'apt2_bush3':case 'apt2_bush4':case 'apt4_bush1':case 'apt4_bush2': drawParkBush(sx,sy,w,h);break;
    case 'apt1_trash':case 'apt4_trash': drawParkTrash(sx,sy,w,h);break;
    case 'apt2_fountain':  drawFountain(sx,sy,w,h);break;
    case 'jacuzzi':        drawJacuzzi(sx,sy,w,h);break;
    case 'sauna':          drawSauna(sx,sy,w,h);break;
    case 'firepit':        drawFirepit(sx,sy,w,h);break;
    case 'kitchen_island': drawKitchenIsland(sx,sy,w,h);break;
    case 'gold_shelf':     drawGoldShelf(sx,sy,w,h);break;
    case 'aquarium':       drawAquarium(sx,sy,w,h);break;
    case 'tv':             drawTVSet(sx,sy,w,h);break;
    case 'tv_traphouse':   drawTVSet(sx,sy,w,h);break;
    case 'lampka':         drawLampkaNocna(sx,sy,w,h);break;
    case 'plyta':          drawPlytaIndukcyjna(sx,sy,w,h);break;
    case 'blat':           drawBlatKuchenny(sx,sy,w,h);break;
    case 'szafki':         drawSzafkiKuchenne(sx,sy,w,h);break;
    case 'stol':           drawStolJadalny(sx,sy,w,h);break;
    case 'biblioteka':     drawBiblioteka(sx,sy,w,h);break;
    case 'wall_v1a':case 'wall_v1b':case 'wall_v2':case 'wall_v2a':case 'wall_v2b':
    case 'wall_v3a':case 'wall_v3b':case 'wall_v4a':case 'wall_v4b':
    case 'wall_h1a':case 'wall_h1b':case 'wall_h1c':case 'wall_h1d':
    case 'wall_h2a':case 'wall_h2b':case 'wall_h2c':case 'wall_h2d':
      drawAptWall(sx,sy,w,h);break;
    default:             drawGeneric(sx,sy,w,h,id);break;
  }
  X.restore();
}

// â”€â”€ MEBLE â”€â”€
function drawBed(sx,sy,w,h){
  const fc=G.aptColors.bed||'#3a5a8a';
  X.fillStyle='#5a3a1a';X.fillRect(sx,sy,w,h);
  X.fillStyle='#e8e0d0';X.fillRect(sx+4,sy+4,w-8,h-8);
  X.fillStyle=fc;X.fillRect(sx+4,sy+h/3,w-8,h*2/3-4);
  X.fillStyle='#f0e8d8';X.beginPath();X.roundRect(sx+10,sy+6,w-20,h/3-8,4);X.fill();
}
function drawFridge(sx,sy,w,h){
  X.fillStyle='#c0c8d0';X.fillRect(sx,sy,w,h);
  X.fillStyle='#b0b8c0';X.fillRect(sx+2,sy+2,w-4,h*.55);
  X.fillStyle='#b8c0c8';X.fillRect(sx+2,sy+h*.56,w-4,h*.42);
  X.fillStyle='#808890';X.fillRect(sx+w-7,sy+h*.22,4,10);X.fillRect(sx+w-7,sy+h*.65,4,8);
}
function drawAptWall(sx,sy,w,h){
  // Drewniana Ĺ›ciana z teksturÄ…
  const grad=X.createLinearGradient(sx,sy,sx,sy+h);
  grad.addColorStop(0,'#7a5028');grad.addColorStop(.5,'#5a3818');grad.addColorStop(1,'#4a2810');
  X.fillStyle=grad;X.fillRect(sx,sy,w,h);
  // CieĹ„ u doĹ‚u/prawej
  X.fillStyle='rgba(0,0,0,.25)';X.fillRect(sx,sy+h-2,w,2);X.fillRect(sx+w-2,sy,2,h);
  // Ozdoba â€” listwa
  X.fillStyle='#c8a560';X.fillRect(sx+1,sy+1,w-2,1);
}
function drawLampkaNocna(sx,sy,w,h){
  const isOn=G._lampkaOn!==false;
  // Stolik nocny
  X.fillStyle='#5a3a18';X.fillRect(sx,sy+h*.7,w,h*.3);
  X.fillStyle='#4a2a10';X.fillRect(sx,sy+h*.7,w,3);
  // Trzonek lampy
  X.fillStyle='#888';X.fillRect(sx+w/2-2,sy+h*.4,4,h*.32);
  // Klosz
  X.fillStyle=isOn?'#fff8d0':'#888';
  X.beginPath();X.moveTo(sx+w*.2,sy+h*.4);X.lineTo(sx+w*.8,sy+h*.4);X.lineTo(sx+w*.7,sy+h*.15);X.lineTo(sx+w*.3,sy+h*.15);X.closePath();X.fill();
  if(isOn){
    // Glow
    X.shadowColor='rgba(255,240,160,.7)';X.shadowBlur=20;
    X.fillStyle='rgba(255,250,200,.6)';X.beginPath();X.arc(sx+w/2,sy+h*.3,w*.6,0,Math.PI*2);X.fill();
    X.shadowBlur=0;
  }
}
function drawPlytaIndukcyjna(sx,sy,w,h){
  X.fillStyle='#1a1a1a';X.fillRect(sx,sy,w,h);
  X.fillStyle='#3a3a3a';X.fillRect(sx+2,sy+2,w-4,h-4);
  // 4 palniki
  const r=Math.min(w,h)/5;
  [[w*.3,h*.35],[w*.7,h*.35],[w*.3,h*.7],[w*.7,h*.7]].forEach(([cx,cy])=>{
    X.strokeStyle='#888';X.lineWidth=1;
    X.beginPath();X.arc(sx+cx,sy+cy,r,0,Math.PI*2);X.stroke();
    X.fillStyle='rgba(255,80,40,.18)';X.beginPath();X.arc(sx+cx,sy+cy,r-2,0,Math.PI*2);X.fill();
  });
  // Panel sterowania
  X.fillStyle='#222';X.fillRect(sx+w*.85,sy+5,w*.13,h-10);
  X.fillStyle='#2ecc71';X.fillRect(sx+w*.88,sy+8,3,3);
}
function drawBlatKuchenny(sx,sy,w,h){
  // Blat marmurowy
  const grad=X.createLinearGradient(sx,sy,sx,sy+h);
  grad.addColorStop(0,'#e8e0d0');grad.addColorStop(.5,'#d8d0c0');grad.addColorStop(1,'#c0b8a8');
  X.fillStyle=grad;X.fillRect(sx,sy,w,h);
  // KrawÄ™dĹş
  X.fillStyle='#5a4028';X.fillRect(sx,sy+h-4,w,4);
  // Ĺ»yĹ‚ki marmuru
  X.strokeStyle='rgba(120,100,80,.3)';X.lineWidth=1;
  for(let i=0;i<3;i++){
    X.beginPath();
    X.moveTo(sx+i*w/3,sy+5);
    X.bezierCurveTo(sx+i*w/3+20,sy+15,sx+i*w/3-10,sy+25,sx+i*w/3+30,sy+h-8);
    X.stroke();
  }
  // MaĹ‚a deska do krojenia
  X.fillStyle='#a07840';X.fillRect(sx+w*.6,sy+8,w*.25,h*.4);
  X.fillStyle='#8a5a28';X.fillRect(sx+w*.6,sy+8,w*.25,2);
}
function drawSzafkiKuchenne(sx,sy,w,h){
  // Szafka dolna (drewno)
  X.fillStyle='#7a4a18';X.fillRect(sx,sy,w,h);
  X.fillStyle='#5a3010';X.fillRect(sx,sy+h-4,w,4);
  // Drzwiczki â€” 2 segmenty
  X.fillStyle='#8a5a20';
  X.fillRect(sx+3,sy+5,w/2-5,h-10);
  X.fillRect(sx+w/2+2,sy+5,w/2-5,h-10);
  // Klamki
  X.fillStyle='#c8a520';
  X.fillRect(sx+w/2-7,sy+h/2-2,4,4);
  X.fillRect(sx+w/2+3,sy+h/2-2,4,4);
}
function drawStolJadalny(sx,sy,w,h){
  // KrzesĹ‚o 1 (lewy)
  X.fillStyle='#5a3018';X.fillRect(sx-4,sy+h*.3,12,h*.55);
  // StĂłĹ‚ â€” drewniany
  X.fillStyle='#7a4a20';X.fillRect(sx+8,sy+h*.2,w-16,h*.6);
  X.fillStyle='#5a3010';X.fillRect(sx+8,sy+h*.2,w-16,3);
  // SĹ‚oje drewna
  X.strokeStyle='rgba(80,50,20,.3)';X.lineWidth=1;
  for(let i=1;i<4;i++){X.beginPath();X.moveTo(sx+10+i*8,sy+h*.25);X.lineTo(sx+10+i*8,sy+h*.78);X.stroke();}
  // Talerz
  X.fillStyle='#fff';X.beginPath();X.arc(sx+w/2,sy+h/2,w*.18,0,Math.PI*2);X.fill();
  X.strokeStyle='#aac';X.lineWidth=1;X.stroke();
  // KrzesĹ‚o 2 (prawy)
  X.fillStyle='#5a3018';X.fillRect(sx+w-8,sy+h*.3,12,h*.55);
  // Nogi stoĹ‚u
  X.fillStyle='#5a3010';X.fillRect(sx+12,sy+h*.78,4,h*.18);X.fillRect(sx+w-16,sy+h*.78,4,h*.18);
}
function drawBiblioteka(sx,sy,w,h){
  // RegaĹ‚
  X.fillStyle='#3a2010';X.fillRect(sx,sy,w,h);
  X.fillStyle='#5a3018';X.fillRect(sx+2,sy+2,w-4,h-4);
  // 3 pĂłĹ‚ki z ksiÄ…ĹĽkami
  const shelfH=h/4;
  for(let i=0;i<3;i++){
    const sy2=sy+(i+1)*shelfH;
    // PĂłĹ‚ka
    X.fillStyle='#3a2010';X.fillRect(sx+2,sy2-3,w-4,3);
    // KsiÄ…ĹĽki â€” rĂłĹĽne wysokoĹ›ci
    const bookCount=Math.floor((w-10)/8);
    const colors=['#a02a2a','#2a5aa0','#2a7a2a','#a07a2a','#5a2a7a','#7a3a3a','#3a5a7a'];
    for(let j=0;j<bookCount;j++){
      const bh=shelfH*0.7+Math.sin(i*7+j*3.1)*shelfH*0.1;
      X.fillStyle=colors[(i*bookCount+j)%colors.length];
      X.fillRect(sx+5+j*8,sy2-bh-3,7,bh);
    }
  }
}
function drawDesk(sx,sy,w,h){
  // Auto-detect orientation: jesli h > w*1.3, biurko jest pionowe (obrocone 90 stopni â€” przy bocznej scianie)
  if(h>w*1.3){
    // VERTICAL desk: biurko zajmuje LEWA strona obiektu (przylegajaca do prawej sciany pokoju), monitor na PRAWEJ stronie biurka
    X.fillStyle='#5a4018';X.fillRect(sx,sy,w*.55,h);
    X.fillStyle='#7a5828';X.fillRect(sx,sy,8,h);
    const mx=sx+w*.05,my=sy+h*.3,mw=w*.42,mh=h*.4;
    X.fillStyle='#0a0a0a';X.fillRect(mx,my,mw,mh);
    X.fillStyle=G.hasPCUpgrade?'#0a2a4a':'#0a1a2a';X.fillRect(mx+3,my+3,mw-6,mh-8);
    X.font='9px monospace';X.fillStyle='#7ec8e3';X.textAlign='center';
    X.fillText('PC',mx+mw/2,my+mh/2+2);X.textAlign='left';
    // Stojak monitora
    X.fillStyle='#0a0a0a';X.fillRect(mx+mw/2-5,my+mh,9,6);X.fillRect(mx+mw/2-14,my+mh+6,28,4);
    // Krzeselko po PRAWEJ stronie biurka (gdzie siedzi gracz)
    X.fillStyle='#2a2a2a';X.beginPath();X.arc(sx+w*.78,sy+h*.5,12,0,Math.PI*2);X.fill();
    X.fillStyle='#3a3a3a';X.fillRect(sx+w*.78-2,sy+h*.5+10,4,18);
    if(G.camera){X.font='8px "Segoe UI"';X.fillStyle='#e74c3c';X.fillText('đź“ą',sx+w*.05,sy+h*.95);}
    return;
  }
  // HORIZONTAL desk (oryginalny uklad â€” biurko u gory pokoju)
  X.fillStyle='#5a4018';X.fillRect(sx,sy+h*.45,w,h*.55);
  X.fillStyle='#7a5828';X.fillRect(sx,sy+h*.45,w,8);
  const mx=sx+w*.3,my=sy+2,mw=w*.62,mh=h*.42;
  X.fillStyle='#0a0a0a';X.fillRect(mx,my,mw,mh);
  X.fillStyle=G.hasPCUpgrade?'#0a2a4a':'#0a1a2a';X.fillRect(mx+3,my+3,mw-6,mh-8);
  X.font='9px monospace';X.fillStyle='#7ec8e3';X.textAlign='center';
  X.fillText('PC',mx+mw/2,my+mh/2+2);X.textAlign='left';
  X.fillStyle='#0a0a0a';X.fillRect(mx+mw/2-5,my+mh,9,6);X.fillRect(mx+mw/2-14,my+mh+6,28,4);
  if(G.camera){X.font='8px "Segoe UI"';X.fillStyle='#e74c3c';X.fillText('đź“ą'+G.camera.name.slice(0,6),sx+2,sy+h*.44);}
}
function drawSofa(sx,sy,w,h){
  const fc=G.aptColors.sofa||'#5a3060';
  const lc=lightenHex(fc,20);
  X.fillStyle=fc;X.fillRect(sx,sy,w,h*.45);
  X.fillStyle=lc;X.fillRect(sx+3,sy+3,w-6,h*.4);
  X.fillStyle=fc;X.fillRect(sx,sy+h*.45,w,h*.55);
  X.fillStyle=lc;X.fillRect(sx+3,sy+h*.48,w-6,h*.47);
  X.fillStyle=lightenHex(fc,35);
  X.beginPath();X.roundRect(sx+5,sy+h*.49,w/2-8,h*.42,4);X.fill();
  X.beginPath();X.roundRect(sx+w/2+3,sy+h*.49,w/2-8,h*.42,4);X.fill();
}
function drawDoor(sx,sy,w,h){
  X.fillStyle='#3a2008';X.fillRect(sx,sy,w,h);
  X.fillStyle='#4a3018';X.fillRect(sx+3,sy+2,w-6,h-2);
  X.fillStyle='#c0a030';X.beginPath();X.arc(sx+w-10,sy+h*.5,4,0,Math.PI*2);X.fill();
}
function drawWardrobe(sx,sy,w,h){
  X.fillStyle='#4a3010';X.fillRect(sx,sy,w,h);
  X.fillStyle='#5a4020';X.fillRect(sx+3,sy+3,w-6,h-6);
  X.strokeStyle='#3a2008';X.lineWidth=2;
  X.strokeRect(sx+6,sy+6,w/2-9,h-12);X.strokeRect(sx+w/2+3,sy+6,w/2-9,h-12);
  X.fillStyle='#c0a030';X.beginPath();X.arc(sx+w/2-3,sy+h/2,3,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(sx+w/2+3,sy+h/2,3,0,Math.PI*2);X.fill();
  X.shadowBlur=0;X.shadowColor='transparent';X.font='16px Arial';X.textAlign='center';X.fillText('đź‘•',sx+w/2,sy+h-8);X.textAlign='left';
}
function drawSavePoint(sx,sy,w,h){
  X.fillStyle='#0a1a2a';X.fillRect(sx,sy,w,h);
  X.fillStyle='#1a3a5a';X.fillRect(sx+3,sy+3,w-6,h-6);
  X.shadowBlur=0;X.shadowColor='transparent';X.font='22px Arial';X.textAlign='center';X.fillText('đź’ľ',sx+w/2,sy+h/2+8);X.textAlign='left';
}
function drawAptCust(sx,sy,w,h){
  X.fillStyle='#1a0a2a';X.fillRect(sx,sy,w,h);X.fillStyle='#2a1a3a';X.fillRect(sx+3,sy+3,w-6,h-6);
  X.shadowBlur=0;X.shadowColor='transparent';X.font='18px Arial';X.textAlign='center';X.fillText('đźŽ¨',sx+w/2,sy+h/2+6);X.textAlign='left';
}
function drawPhoneObj(sx,sy,w,h){
  X.fillStyle='#0a0a14';X.fillRect(sx,sy,w,h);X.fillStyle='#1a1a24';X.fillRect(sx+3,sy+3,w-6,h-6);
  X.shadowBlur=0;X.shadowColor='transparent';X.font='22px Arial';X.textAlign='center';X.fillText('đź“±',sx+w/2,sy+h/2+8);X.textAlign='left';
}
function drawBench(sx,sy,w,h){
  // F+ 2026-05-12 #46: Ĺ‚awka WYGLÄ„DA JAK ĹAWKA â€” z oparciem, deszczuĹ‚kami, fakturÄ… drewna
  // WczeĹ›niej tylko 1 prostokÄ…t siedziska â€” wyglÄ…daĹ‚o jak biurko.
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.28)';X.beginPath();X.ellipse(sx+w/2,sy+h+2,w*0.5,3,0,0,Math.PI*2);X.fill();
  // Oparcie z tyĹ‚u (wysokie, z 3 pionowymi szczeblami)
  X.fillStyle='#3a2410';X.fillRect(sx+8,sy-h*.55,w-16,h*.55);
  X.fillStyle='#5a3a18';X.fillRect(sx+8,sy-h*.55,w-16,4); // top oparcia
  // 3 pionowe szczeble oparcia (kontrast)
  X.fillStyle='#2a1808';
  for(let i=1;i<4;i++)X.fillRect(sx+8+i*((w-16)/4),sy-h*.5,2,h*.5);
  // Siedzisko â€” 2 deszczuĹ‚ki
  X.fillStyle='#5a3a18';X.fillRect(sx,sy,w,h*.32);
  X.fillStyle='#7a5028';X.fillRect(sx,sy,w,2); // highlight gĂłrnej krawÄ™dzi
  X.fillStyle='rgba(0,0,0,.4)';X.fillRect(sx,sy+h*.16,w,1.5); // linia miÄ™dzy deszczuĹ‚kami
  // Fakturze drewna â€” drobne pionowe smugi
  X.fillStyle='rgba(0,0,0,.15)';
  for(let i=0;i<6;i++)X.fillRect(sx+8+i*((w-16)/6),sy+2,1,h*.28);
  // Nogi metalowe â€” wyraĹşnie z gradientem
  X.fillStyle='#1a1a1a';X.fillRect(sx+10,sy+h*.32,8,h*.68);X.fillRect(sx+w-18,sy+h*.32,8,h*.68);
  X.fillStyle='#3a3a3a';X.fillRect(sx+11,sy+h*.32,2,h*.65);X.fillRect(sx+w-17,sy+h*.32,2,h*.65);
  // Ĺapki/wsporniki przy oparciu
  X.fillStyle='#1a1a1a';X.fillRect(sx+10,sy-2,8,h*.18);X.fillRect(sx+w-18,sy-2,8,h*.18);
  // F+ 2026-05-12 #21: Ĺ›nieg na Ĺ‚awkach zimÄ… â€” biaĹ‚a warstwa na siedzisku
  if(typeof seasonId!=='undefined' && seasonId==='winter'){
    X.fillStyle='rgba(255,255,255,.85)';X.fillRect(sx,sy-1,w,3);
    X.fillStyle='rgba(220,230,245,.7)';X.fillRect(sx+2,sy-2,w-4,2);
    X.fillStyle='rgba(255,255,255,.95)';
    for(let i=0;i<3;i++){X.beginPath();X.arc(sx+w*0.2+i*w*0.3,sy-1,3,0,Math.PI*2);X.fill();}
  }
}
// Designerska Ĺ‚awka â€” premium wykoĹ„czenie (marmurowy blat + chromowane nogi + LED glow nocÄ…)
function drawDesignerBench(sx,sy,w,h){
  const isNight=G.timeOfDay>=2;
  // CieĹ„ pod Ĺ‚awkÄ…
  X.fillStyle='rgba(0,0,0,.30)';
  X.beginPath();X.ellipse(sx+w/2,sy+h+2,w/2-2,3,0,0,Math.PI*2);X.fill();
  // Blat marmurowy (gradient: jasny marmur + subtelne ĹĽyĹ‚kowanie)
  const mg=X.createLinearGradient(sx,sy,sx,sy+h*.32);
  mg.addColorStop(0,'#f4ede0'); mg.addColorStop(.5,'#e8ddc8'); mg.addColorStop(1,'#d8c8b0');
  X.fillStyle=mg; X.fillRect(sx,sy,w,h*.32);
  // Ĺ»yĹ‚ki marmuru â€” cienkie szarzane linie
  X.strokeStyle='rgba(120,100,80,.32)';X.lineWidth=.6;
  X.beginPath();
  X.moveTo(sx+w*.15,sy+1); X.bezierCurveTo(sx+w*.3,sy+h*.18, sx+w*.5,sy+h*.05, sx+w*.85,sy+h*.22);
  X.stroke();
  X.beginPath();
  X.moveTo(sx+2,sy+h*.22); X.bezierCurveTo(sx+w*.4,sy+h*.12, sx+w*.7,sy+h*.28, sx+w-2,sy+h*.10);
  X.stroke();
  // ZĹ‚ota linia akcentu wzdĹ‚uĹĽ przedniej krawÄ™dzi
  const goldG=X.createLinearGradient(sx,sy+h*.32,sx,sy+h*.36);
  goldG.addColorStop(0,'#c8a520'); goldG.addColorStop(.5,'#f1d060'); goldG.addColorStop(1,'#a87810');
  X.fillStyle=goldG;
  X.fillRect(sx,sy+h*.32,w,Math.max(2,h*.05));
  // Chromowane nogi (X-shape, cienkie metalowe)
  const legW=4, legY=sy+h*.38, legH=h*.62;
  // Lewa noga
  const lg1=X.createLinearGradient(sx+8,legY,sx+12,legY);
  lg1.addColorStop(0,'#8a8a90'); lg1.addColorStop(.5,'#e0e0e8'); lg1.addColorStop(1,'#6a6a72');
  X.fillStyle=lg1; X.fillRect(sx+8,legY,legW,legH);
  // Prawa noga
  X.fillStyle=lg1; X.fillRect(sx+w-12,legY,legW,legH);
  // Dolne wykoĹ„czenie nĂłg (maĹ‚a stĂłpka chromowana)
  X.fillStyle='#3a3a40';
  X.fillRect(sx+5,sy+h-3,10,3); X.fillRect(sx+w-15,sy+h-3,10,3);
  // LED podĹ›wietlenie pod blatem (nocÄ… subtle glow)
  if(isNight){
    const glow=X.createLinearGradient(sx,sy+h*.34,sx,sy+h*.6);
    glow.addColorStop(0,'rgba(160,200,255,.45)'); glow.addColorStop(1,'rgba(160,200,255,0)');
    X.fillStyle=glow;
    X.fillRect(sx-2,sy+h*.34,w+4,h*.3);
    // LED strip
    X.fillStyle='rgba(180,220,255,.85)';
    X.fillRect(sx+2,sy+h*.37,w-4,1);
  }
  // Refleks na blacie (subtle highlight)
  X.fillStyle='rgba(255,255,255,.30)';
  X.fillRect(sx+w*.1,sy+1,w*.4,1);
}
// Rysuje siedzÄ…cego NPC na Ĺ‚awce â€” staĹ‚a, deterministyczna postaÄ‡ per Ĺ‚awka
function drawBenchSitter(sx,sy,w,h,seed){
  const t=Date.now()*0.001;
  // Subtelne koĹ‚ysanie gĹ‚owy
  const sway=Math.sin(t+seed*0.3)*0.6;
  // CieĹ„ pod Ĺ‚awkÄ…
  X.fillStyle='rgba(0,0,0,.18)';X.beginPath();X.ellipse(sx+w/2,sy+h+1,w/2-4,3,0,0,Math.PI*2);X.fill();
  // Deterministyczne kolory na podstawie seed
  const skinCols=['#e0a870','#c07840','#d4905a','#b87640'];
  const clothCols=['#3a2a4a','#1a3a2a','#3a1a1a','#4a3a1a','#2a4a4a','#2a3a5a'];
  const hatCols=['#c0392b','#2980b9','#27ae60','#d35400','#8e44ad','#7f8c8d'];
  const sc=skinCols[seed%skinCols.length];
  const cc=clothCols[seed%clothCols.length];
  const hc=hatCols[seed%hatCols.length];
  const cx=sx+w/2;
  const sitY=sy-2; // tuĹ‚Ăłw zaczyna nad Ĺ‚awkÄ…
  // Nogi zwieszone
  X.fillStyle='#1a2030';
  X.fillRect(cx-7,sy+h*.3,5,h*.55);
  X.fillRect(cx+2,sy+h*.3,5,h*.55);
  // Buty
  X.fillStyle='#0a0a0f';
  X.fillRect(cx-8,sy+h*.85,6,4);
  X.fillRect(cx+2,sy+h*.85,6,4);
  // TuĹ‚Ăłw (siedzi prosto)
  X.fillStyle=cc;
  X.beginPath();
  X.moveTo(cx-7,sitY-12);X.lineTo(cx+7,sitY-12);
  X.lineTo(cx+9,sitY+1);X.lineTo(cx-9,sitY+1);
  X.closePath();X.fill();
  // RÄ™ce â€” leĹĽÄ… na kolanach
  X.fillStyle=sc;
  X.fillRect(cx-9,sitY-2,4,6);
  X.fillRect(cx+5,sitY-2,4,6);
  // GĹ‚owa
  X.fillStyle=sc;X.beginPath();X.arc(cx+sway,sitY-19,7,0,Math.PI*2);X.fill();
  // Oczy
  X.fillStyle='rgba(0,0,0,.75)';
  X.beginPath();X.arc(cx-2+sway,sitY-20,1.3,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(cx+2+sway,sitY-20,1.3,0,Math.PI*2);X.fill();
  // Czapka
  X.fillStyle=hc;
  X.beginPath();X.moveTo(cx-7+sway,sitY-22);X.lineTo(cx+7+sway,sitY-22);
  X.lineTo(cx+5+sway,sitY-28);X.lineTo(cx+sway,sitY-31);X.lineTo(cx-5+sway,sitY-28);X.closePath();X.fill();
  X.fillStyle='rgba(255,255,255,.85)';X.beginPath();X.arc(cx+sway,sitY-32,2.5,0,Math.PI*2);X.fill();
  // Co kilka sekund â€” telefon w rÄ™kach (40% czasu)
  const phasePh=Math.floor(t*0.3+seed*7)%5;
  if(phasePh<2){
    X.fillStyle='#0a0a14';X.fillRect(cx-3,sitY-2,6,5);
    X.fillStyle='#3498db';X.fillRect(cx-2,sitY-1,4,3);
  }
}
function drawPondSurface(sx,sy,w,h){
  const g=X.createRadialGradient(sx+w/2,sy+h/2,10,sx+w/2,sy+h/2,w/2);
  g.addColorStop(0,'rgba(40,100,200,.6)');g.addColorStop(1,'rgba(20,60,140,.4)');
  X.fillStyle=g;X.beginPath();X.ellipse(sx+w/2,sy+h/2,w/2,h/2,0,0,Math.PI*2);X.fill();
  // F+ Punkt #22: Kaczki na stawie â€” 3 kaczki dryfujÄ…ce po powierzchni
  const t=Date.now();
  const ducks=[
    {ox:0.3, oy:0.4, phase:0,    col:'#f8f4e8', headC:'#2a5a2a'}, // samiec mallard
    {ox:0.6, oy:0.5, phase:1.5,  col:'#a08068', headC:'#5a4030'}, // samica brÄ…zowa
    {ox:0.45,oy:0.65,phase:3.0,  col:'#f8f4e8', headC:'#2a5a2a'}, // samiec
  ];
  for(const d of ducks){
    const dx=sx+w*d.ox+Math.sin(t*0.0008+d.phase)*8;
    const dy=sy+h*d.oy+Math.cos(t*0.0006+d.phase)*3;
    // CieĹ„ na wodzie
    X.fillStyle='rgba(0,0,0,.2)';X.beginPath();X.ellipse(dx,dy+1,5,1.5,0,0,Math.PI*2);X.fill();
    // CiaĹ‚o
    X.fillStyle=d.col;X.beginPath();X.ellipse(dx,dy,5,3.5,0,0,Math.PI*2);X.fill();
    // SkrzydĹ‚o
    X.fillStyle='rgba(0,0,0,.18)';X.beginPath();X.ellipse(dx-1,dy-1,3,2,0,0,Math.PI*2);X.fill();
    // GĹ‚owa i szyja (kierunek zaleĹĽy od phase)
    const hx=Math.cos(t*0.0008+d.phase)>0?dx+4:dx-4;
    X.fillStyle=d.headC;X.beginPath();X.arc(hx,dy-2,2.5,0,Math.PI*2);X.fill();
    // DziĂłb maĹ‚y ĹĽĂłĹ‚ty
    X.fillStyle='#f1c40f';X.fillRect(hx+(Math.cos(t*0.0008+d.phase)>0?2:-3),dy-2,1.5,1);
    // Oko
    X.fillStyle='#0a0a0a';X.fillRect(hx+(Math.cos(t*0.0008+d.phase)>0?1:0),dy-2.5,0.8,0.8);
    // MaĹ‚a fala wokĂłĹ‚ kaczki (concentric)
    X.strokeStyle='rgba(255,255,255,.25)';X.lineWidth=0.5;
    X.beginPath();X.ellipse(dx,dy+2,7,2,0,0,Math.PI*2);X.stroke();
  }
}
function drawSkatepark(sx,sy,w,h){
  // Betonowa nawierzchnia skateparku
  X.fillStyle='#7a7060';X.fillRect(sx,sy,w,h);
  // KrawÄ™dĹş asfaltu
  X.fillStyle='#8a8070';X.fillRect(sx+2,sy+2,w-4,h-4);
  // Half-pipe (rampa)
  X.fillStyle='#6a6050';
  X.beginPath();X.moveTo(sx+w*.1,sy+h*.8);X.quadraticCurveTo(sx+w*.3,sy+h*.2,sx+w*.5,sy+h*.15);X.lineTo(sx+w*.5,sy+h*.5);X.quadraticCurveTo(sx+w*.3,sy+h*.55,sx+w*.1,sy+h*.8);X.closePath();X.fill();
  // MaĹ‚a rampa drugiej strony
  X.fillStyle='#606050';
  X.beginPath();X.moveTo(sx+w*.55,sy+h*.8);X.quadraticCurveTo(sx+w*.72,sy+h*.25,sx+w*.9,sy+h*.2);X.lineTo(sx+w*.9,sy+h*.5);X.quadraticCurveTo(sx+w*.72,sy+h*.55,sx+w*.55,sy+h*.8);X.closePath();X.fill();
  // Linie
  X.strokeStyle='rgba(255,255,255,.15)';X.lineWidth=1;X.setLineDash([5,5]);
  X.beginPath();X.moveTo(sx,sy+h/2);X.lineTo(sx+w,sy+h/2);X.stroke();X.setLineDash([]);
  // Etykieta
  X.shadowBlur=0;X.font='bold 12px "Segoe UI",Arial,sans-serif';X.textAlign='center';
  X.strokeStyle='rgba(0,0,0,.6)';X.lineWidth=2;X.lineJoin='round';X.strokeText('SKATEPARK',sx+w/2,sy+h-4);
  X.fillStyle='#fff';X.fillText('SKATEPARK',sx+w/2,sy+h-4);X.textAlign='left';
}
function drawBboyFloor(sx,sy,w,h){
  // Parkiet do breakdance â€” drewniana podĹ‚oga z koĹ‚em
  X.fillStyle='#5a3a18';X.fillRect(sx,sy,w,h);
  // Deski parkietu
  for(let i=0;i<4;i++){X.fillStyle=i%2===0?'#6a4a22':'#5a3a18';X.fillRect(sx,sy+i*h/4,w,h/4);}
  // OkrÄ…g tancerza
  const cx2=sx+w/2,cy2=sy+h/2;
  X.strokeStyle='rgba(255,200,50,.4)';X.lineWidth=2;X.beginPath();X.arc(cx2,cy2,Math.min(w,h)*0.38,0,Math.PI*2);X.stroke();
  X.strokeStyle='rgba(255,200,50,.2)';X.lineWidth=1;X.beginPath();X.arc(cx2,cy2,Math.min(w,h)*0.2,0,Math.PI*2);X.stroke();
  // 4 znaczniki na bokach okrÄ™gu
  for(let i=0;i<4;i++){const a=i/4*Math.PI*2;const r2=Math.min(w,h)*0.38;X.fillStyle='rgba(255,200,50,.6)';X.beginPath();X.arc(cx2+Math.cos(a)*r2,cy2+Math.sin(a)*r2,3,0,Math.PI*2);X.fill();}
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';X.strokeText('BREAKDANCE',cx2,sy+h-5);
  X.fillStyle='#ffd060';X.fillText('BREAKDANCE',cx2,sy+h-5);X.textAlign='left';
}
function drawGymEq(sx,sy,w,h,em,lbl){
  X.fillStyle='#1a1a1a';X.fillRect(sx,sy,w,h);X.fillStyle='#2a2a2a';X.fillRect(sx+3,sy+3,w-6,h-6);
  X.shadowBlur=0;X.shadowColor='transparent';X.font='38px Arial';X.textAlign='center';X.fillText(em,sx+w/2,sy+h/2+12);
  X.font='bold 13px "Segoe UI"';X.fillStyle='#aaa';X.fillText(lbl,sx+w/2,sy+h-6);X.textAlign='left';
}
function drawBenchPress(sx,sy,w,h){
  // PodĹ‚oga / tĹ‚o
  X.fillStyle='#111';X.fillRect(sx,sy,w,h);
  // Stojaki (rack uprights) â€” 2 pionowe sĹ‚upki
  const rackX1=sx+w*.2,rackX2=sx+w*.75,rackY=sy+h*.05,rackH=h*.55;
  X.fillStyle='#555';X.fillRect(rackX1,rackY,7,rackH);X.fillRect(rackX2,rackY,7,rackH);
  // Poprzeczka stojaka (gĂłrna)
  X.fillStyle='#666';X.fillRect(rackX1-4,rackY,rackX2-rackX1+15,7);
  // Haczyki na sztangÄ™ (J-hooks)
  X.fillStyle='#888';
  X.fillRect(rackX1+7,rackY+rackH*.35,8,5);X.fillRect(rackX2-8,rackY+rackH*.35,8,5);
  // Ĺawka â€” padded bench
  const bnX=sx+w*.12,bnY=sy+h*.55,bnW=w*.75,bnH=h*.22;
  X.fillStyle='#222';X.fillRect(bnX,bnY,bnW,bnH); // frame
  X.fillStyle='#3a1a0a';X.fillRect(bnX+3,bnY+3,bnW-6,bnH*.55); // padding
  X.fillStyle='#4a2a10';X.fillRect(bnX+5,bnY+4,bnW-10,bnH*.35); // highlight
  // Nogi Ĺ‚awki
  X.fillStyle='#444';
  X.fillRect(bnX+8,bnY+bnH,6,h*.2);X.fillRect(bnX+bnW-14,bnY+bnH,6,h*.2);
  // Sztanga (barbell) na stojaku
  const barY=rackY+rackH*.38;
  // Gryf â€” dĹ‚ugi prÄ™t
  X.fillStyle='#999';X.fillRect(sx+2,barY-2,w-4,4); // shaft
  X.fillStyle='#bbb';X.fillRect(sx+2,barY-2,w-4,1.5); // highlight
  // Talerze â€” w pakiecie na SAMEJ KRAWÄDZI (jak prawdziwa sztanga: najwiÄ™kszy najdalej, najmniejszy bliĹĽej Ĺ›rodka)
  // Format: [offsetFromEnd, halfWidth, halfHeight, color, edgeColor]
  const plates=[
    [3,  4, 18, '#c0392b', '#7a1f15'], // 20kg czerwony â€” najwiÄ™kszy, na samym koĹ„cu
    [11, 3, 14, '#2c3e50', '#1a252e'], // 10kg ciemny niebieski â€” bliĹĽej
    [18, 3, 11, '#27ae60', '#1a6a3a']  // 5kg zielony â€” najmniejszy, bliĹĽej Ĺ›rodka
  ];
  function drawPlate(cx, halfW, halfH, color, edge){
    // Talerz jako pionowy owal (widziany z boku)
    X.fillStyle=color;X.beginPath();X.ellipse(cx, barY, halfW, halfH, 0, 0, Math.PI*2);X.fill();
    // KrawÄ™dĹş â€” ciemniejsza
    X.strokeStyle=edge;X.lineWidth=1.5;X.beginPath();X.ellipse(cx, barY, halfW, halfH, 0, 0, Math.PI*2);X.stroke();
    // Highlight (poĹ‚yskiem na lewym gĂłrnym)
    X.fillStyle='rgba(255,255,255,.18)';X.beginPath();X.ellipse(cx-halfW*.3, barY-halfH*.3, halfW*.4, halfH*.3, 0, 0, Math.PI*2);X.fill();
    // OtwĂłr Ĺ›rodkowy (pierĹ›cieĹ„ gryfu)
    X.fillStyle='#666';X.fillRect(cx-1, barY-2, 2, 4);
  }
  // LEWA strona â€” talerze ciasno na koĹ„cu sztangi
  plates.forEach(([off, hw, hh, col, edge])=>{
    drawPlate(sx+off+hw, hw, hh, col, edge);
  });
  // PRAWA strona â€” lustrzanie
  plates.forEach(([off, hw, hh, col, edge])=>{
    drawPlate(sx+w-off-hw, hw, hh, col, edge);
  });
  // PierĹ›cienie zabezpieczajÄ…ce (collars) â€” trzymajÄ… talerze
  X.fillStyle='#444';
  X.fillRect(sx+24, barY-5, 3, 10); // lewy collar
  X.fillRect(sx+w-27, barY-5, 3, 10); // prawy collar
  // Label
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('ĹAWKA',sx+w/2,sy+h-4);
  X.fillStyle='#f1c40f';X.fillText('ĹAWKA',sx+w/2,sy+h-4);X.textAlign='left';
}
function drawTreadmill(sx,sy,w,h){
  // Frame
  X.fillStyle='#111';X.fillRect(sx,sy,w,h);
  X.fillStyle='#1c1c1c';X.fillRect(sx+4,sy+4,w-8,h-8);
  // Belt platform
  const beltY=sy+h*.55,beltH=h*.32;
  X.fillStyle='#0a0a0a';X.fillRect(sx+8,beltY,w-16,beltH);
  // Running belt stripes (animated)
  const t=Date.now()*0.003%1;
  X.fillStyle='#1a1a1a';
  for(let i=0;i<8;i++){
    const bx=(i/8+t)%1;
    X.fillRect(sx+8+bx*(w-16),beltY+2,4,beltH-4);
  }
  X.fillStyle='#2a2a2a';X.fillRect(sx+8,beltY+beltH-4,w-16,4);
  // Side rails
  X.fillStyle='#333';X.fillRect(sx+4,beltY-4,8,beltH+8);X.fillRect(sx+w-12,beltY-4,8,beltH+8);
  // Handlebars (side poles going up)
  X.fillStyle='#444';X.fillRect(sx+10,sy+h*.1,5,h*.48);X.fillRect(sx+w-15,sy+h*.1,5,h*.48);
  // Crossbar
  X.fillRect(sx+10,sy+h*.1,w-20,5);
  // Display panel
  const dpX=sx+w*.25,dpY=sy+h*.12,dpW=w*.5,dpH=h*.22;
  X.fillStyle='#0a1a0a';X.fillRect(dpX,dpY,dpW,dpH);
  X.fillStyle='#003300';X.fillRect(dpX+3,dpY+3,dpW-6,dpH-6);
  X.fillStyle='#00ff00';X.font='bold 11px "Courier New",monospace';X.textAlign='center';
  X.fillText('5.0 km/h',dpX+dpW/2,dpY+dpH*.6);
  X.textAlign='left';
  // Label
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('BIEĹ»NIA',sx+w/2,sy+h-4);
  X.fillStyle='#f1c40f';X.fillText('BIEĹ»NIA',sx+w/2,sy+h-4);X.textAlign='left';
}
function drawCableMachine(sx,sy,w,h){
  // Frame
  X.fillStyle='#222';X.fillRect(sx,sy,w,h);
  X.fillStyle='#2e2e2e';X.fillRect(sx+4,sy+4,w-8,h-8);
  // Left post
  X.fillStyle='#1a1a1a';X.fillRect(sx+6,sy+4,10,h-8);
  // Right post
  X.fillStyle='#1a1a1a';X.fillRect(sx+w-16,sy+4,10,h-8);
  // Pulley at top
  X.fillStyle='#777';X.beginPath();X.arc(sx+w/2,sy+12,7,0,Math.PI*2);X.fill();
  X.fillStyle='#555';X.beginPath();X.arc(sx+w/2,sy+12,4,0,Math.PI*2);X.fill();
  // Cable
  X.strokeStyle='#bbb';X.lineWidth=1.5;
  X.beginPath();X.moveTo(sx+w/2,sy+19);X.lineTo(sx+w/2,sy+h*.68);X.stroke();
  // Handle bar
  X.fillStyle='#444';X.fillRect(sx+w/2-13,sy+h*.63,26,10);
  X.fillStyle='#333';X.fillRect(sx+w/2-13,sy+h*.63,26,4);
  // Weight stack (right side)
  for(let i=0;i<5;i++){
    X.fillStyle=i===0?'#555':'#333';
    X.fillRect(sx+w*.66,sy+12+i*11,w*.24,9);
    X.fillStyle='rgba(255,255,255,.06)';X.fillRect(sx+w*.66,sy+12+i*11,w*.24,3);
  }
  // Label
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('WYCIÄ„G',sx+w/2,sy+h-4);
  X.fillStyle='#f1c40f';X.fillText('WYCIÄ„G',sx+w/2,sy+h-4);X.textAlign='left';
}

// â”€â”€ DEKORACJE POKOI â”€â”€
function drawRoomDecorations(){
  if(currentRoom==='silownia') drawSilowniaDecorations();
  else if(currentRoom==='studio') drawStudioDecorations();
  else if(currentRoom==='mieszkanie') drawMieszkanieDecorations();
  else if(currentRoom==='mieszkanie_premium') drawPremiumDecorations();
  else if(currentRoom==='mieszkanie_lux') drawLuxDecorations();
  else if(currentRoom==='merch_studio') drawMerchStudioDecorations();
}

function drawSilowniaDecorations(){
  // Lustro na Ĺ›cianie pĂłĹ‚nocnej (peĹ‚na szerokoĹ›Ä‡)
  const mx=wx2sx(50),my=wy2sy(58),mw=780,mh=52;
  X.fillStyle='#181818';X.fillRect(mx,my,mw,mh);
  const mg=X.createLinearGradient(mx,my,mx+mw,my+mh);
  mg.addColorStop(0,'rgba(140,160,200,.55)');
  mg.addColorStop(.4,'rgba(200,220,255,.7)');
  mg.addColorStop(1,'rgba(140,160,200,.55)');
  X.fillStyle=mg;X.fillRect(mx+3,my+3,mw-6,mh-6);
  X.fillStyle='rgba(255,255,255,.25)';X.fillRect(mx+10,my+3,18,mh-6);
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 13px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.7)';X.lineWidth=2;X.lineJoin='round';X.strokeText('LUSTRO',mx+mw/2,my+mh/2+5);
  X.fillStyle='#fff';X.fillText('LUSTRO',mx+mw/2,my+mh/2+5);X.textAlign='left';

  // Stojak z hantlami przy poĹ‚udniowej Ĺ›cianie
  const rx=wx2sx(80),ry=wy2sy(320),rw=680,rh=50;
  X.fillStyle='#2a2a2a';X.fillRect(rx,ry,rw,rh);
  X.fillStyle='#1a1a1a';X.fillRect(rx,ry+rh*.5,rw,rh*.5);
  // Pary hantli
  const dColors=['#888','#c05020','#2060c0','#208050','#a0a030','#802080'];
  const dSizes=[7,8,9,10,11,12];
  for(let i=0;i<6;i++){
    const hx=rx+22+i*(rw/6.4);
    const dc=dColors[i],dr=dSizes[i];
    // lewy talerz
    X.fillStyle=dc;X.beginPath();X.ellipse(hx,ry+rh*.28,dr*.5,dr,0,0,Math.PI*2);X.fill();
    // gryf
    X.fillStyle='#666';X.fillRect(hx,ry+rh*.28-3,rw/8.5,6);
    // prawy talerz
    X.fillStyle=dc;X.beginPath();X.ellipse(hx+rw/8.5,ry+rh*.28,dr*.5,dr,0,0,Math.PI*2);X.fill();
    // ciÄ™ĹĽar
    X.font='bold 9px "Segoe UI",Arial,sans-serif';X.textAlign='center';
    X.strokeStyle='rgba(0,0,0,.8)';X.lineWidth=2;X.strokeText((i+1)*5+'kg',hx+rw/17,ry+rh*.78);
    X.fillStyle='#fff';X.fillText((i+1)*5+'kg',hx+rw/17,ry+rh*.78);
  }
  X.textAlign='left';

  // Tablica z planem treningowym â€” wiÄ™ksza i czytelna
  const bx=wx2sx(810),by=wy2sy(180),bw=140,bh=130;
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.4)';X.fillRect(bx+3,by+3,bw,bh);
  // Drewniana ramka
  X.fillStyle='#3a2110';X.fillRect(bx,by,bw,bh);
  X.fillStyle='#5a3318';X.fillRect(bx+2,by+2,bw-4,bh-4);
  // BiaĹ‚e tĹ‚o tablicy (poniĹĽej paska nagĹ‚Ăłwka)
  X.fillStyle='#f8f3e0';X.fillRect(bx+6,by+34,bw-12,bh-40);
  // Klipsik na gĂłrze
  X.fillStyle='#888';X.fillRect(bx+bw/2-10,by-3,20,6);
  // Pasek nagĹ‚Ăłwka â€” ciemny z biaĹ‚ym tekstem
  X.fillStyle='#2a1408';X.fillRect(bx+6,by+6,bw-12,28);
  X.shadowBlur=0;X.shadowColor='transparent';X.textBaseline='alphabetic';
  X.fillStyle='#fff';X.font='bold 14px "Segoe UI",Arial,sans-serif';X.textAlign='left';
  X.fillText('PLAN',bx+12,by+25);
  // Emoji w prawym KOĹCU paska (na ciemnym tle, duĹĽo dalej od napisu)
  X.font='16px Arial,sans-serif';X.textAlign='right';
  X.fillText('đź’Ş',bx+bw-12,by+26);
  X.textAlign='left';
  // Pozycje planu (w biaĹ‚ej czÄ™Ĺ›ci, NIE nakĹ‚adajÄ… siÄ™ na nagĹ‚Ăłwek)
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.fillStyle='#222';
  const plan=['BP 5Ă—5','Squat 4Ă—8','DL 3Ă—6','OHP 4Ă—10'];
  plan.forEach((l,i)=>X.fillText('â€˘ '+l,bx+12,by+52+i*16));
  // Cel
  X.font='bold 10px "Segoe UI",Arial,sans-serif';X.fillStyle='#a02020';
  X.fillText('Cel: 80kg â†’',bx+12,by+bh-12);
  X.textAlign='left';

  // #71: 3 Maty â€” wszystkie nazwane "MATA" (bez 2/3). ObciÄ…ĹĽniki NA macie (z-order â€” nie pod).
  const mats=[
    {x:80,  y:430, color:'rgba(30,60,30,.6)', stroke:'rgba(50,100,50,.4)', kbX:[120,160,205], kbWeights:[8,16,24]},
    {x:380, y:430, color:'rgba(60,30,40,.6)', stroke:'rgba(100,50,80,.4)', kbX:[420,460,505], kbWeights:[12,20,28]},
    {x:680, y:430, color:'rgba(30,40,60,.6)', stroke:'rgba(50,80,100,.4)', kbX:[720,760,805], kbWeights:[16,24,32]},
  ];
  for(const mat of mats){
    const matX=wx2sx(mat.x), matY=wy2sy(mat.y), matW=180, matH=100;
    X.fillStyle=mat.color; X.fillRect(matX,matY,matW,matH);
    X.strokeStyle=mat.stroke; X.lineWidth=1; X.strokeRect(matX,matY,matW,matH);
    X.shadowBlur=0;X.shadowColor='transparent';
    X.font='bold 12px "Segoe UI",Arial,sans-serif';X.textAlign='center';
    X.lineJoin='round';X.lineWidth=2;X.strokeStyle='rgba(0,0,0,.7)';
    // Label w lewym gĂłrnym rogu (nie na Ĺ›rodku â€” ĹĽeby nie kolidowaÄ‡ z obciÄ…ĹĽnikami)
    X.strokeText('MATA', matX+matW/2, matY+18);
    X.fillStyle='#dde3d8'; X.fillText('MATA', matX+matW/2, matY+18);
    // ObciÄ…ĹĽniki NA macie (Ĺ›rodek y maty zamiast 530 = poniĹĽej maty)
    const kbY=mat.y+matH/2-5; // wx-coord wewnÄ…trz maty
    mat.kbX.forEach((wx,i)=>{
      const kx=wx2sx(wx), ky=wy2sy(kbY);
      // FIX: radius roĹ›nie z wagÄ… (i=0 najlĹĽejszy = najmniejszy, i=2 najciÄ™ĹĽszy = najwiÄ™kszy)
      const kr=8+i*2;
      // CieĹ„ pod kettlebellem (na macie)
      X.fillStyle='rgba(0,0,0,.35)';X.beginPath();X.ellipse(kx,ky+kr+5,kr,kr*.4,0,0,Math.PI*2);X.fill();
      X.fillStyle='#222'; X.beginPath();X.arc(kx,ky+kr,kr,0,Math.PI*2);X.fill();
      X.fillStyle='#555'; X.beginPath();X.arc(kx,ky,kr*.5,0,Math.PI);X.fill();
      X.font='bold 9px "Segoe UI",Arial,sans-serif';X.textAlign='center';
      X.lineWidth=2.5;X.strokeStyle='rgba(0,0,0,.85)';
      X.strokeText(`${mat.kbWeights[i]}kg`, kx, ky+kr+18);
      X.fillStyle='#fff'; X.fillText(`${mat.kbWeights[i]}kg`, kx, ky+kr+18);
    });
  }
  X.textAlign='left';

  // Linia na podĹ‚odze (strefa treningowa)
  X.strokeStyle='rgba(255,150,50,.3)';X.lineWidth=2;X.setLineDash([10,8]);
  X.beginPath();X.moveTo(wx2sx(80),wy2sy(300));X.lineTo(wx2sx(680),wy2sy(300));X.stroke();
  X.setLineDash([]);

  // #71: UsuniÄ™to duplikat sekcji "Maty do rozciÄ…gania" â€” 3 maty wyĹĽej juĹĽ wystarczÄ….

  // â”€â”€ Dystrybutor wody (przy prawej Ĺ›cianie) â”€â”€
  {
    const wx2=wx2sx(850),wy2=wy2sy(350);
    // CieĹ„
    X.fillStyle='rgba(0,0,0,.2)';X.beginPath();X.ellipse(wx2+10,wy2+56,14,5,0,0,Math.PI*2);X.fill();
    // Zbiornik (niebieska baĹ„ka)
    const wbg=X.createRadialGradient(wx2+6,wy2+8,2,wx2+10,wy2+12,16);
    wbg.addColorStop(0,'rgba(120,200,255,.9)');wbg.addColorStop(.6,'rgba(30,100,200,.8)');wbg.addColorStop(1,'rgba(10,60,160,.7)');
    X.fillStyle=wbg;X.beginPath();X.ellipse(wx2+10,wy2+14,12,16,0,0,Math.PI*2);X.fill();
    // BiaĹ‚e odblaszczenie na baĹ„ce
    X.fillStyle='rgba(255,255,255,.35)';X.beginPath();X.ellipse(wx2+5,wy2+8,4,6,-.4,0,Math.PI*2);X.fill();
    // Korpus dystrybutora
    const dcg=X.createLinearGradient(wx2,wy2+28,wx2+20,wy2+56);
    dcg.addColorStop(0,'#d0d8e0');dcg.addColorStop(.5,'#b0bac4');dcg.addColorStop(1,'#8090a0');
    X.fillStyle=dcg;X.fillRect(wx2,wy2+28,20,28);
    // Panel przyciskĂłw
    X.fillStyle='#e8eef2';X.fillRect(wx2+2,wy2+36,16,12);
    X.fillStyle='#2244cc';X.beginPath();X.arc(wx2+7,wy2+40,3,0,Math.PI*2);X.fill();
    X.fillStyle='#cc2222';X.beginPath();X.arc(wx2+14,wy2+40,3,0,Math.PI*2);X.fill();
    // Kubeczki
    X.fillStyle='rgba(255,255,255,.7)';
    [[wx2+24,wy2+44],[wx2+28,wy2+46]].forEach(([cx,cy])=>{
      X.beginPath();X.moveTo(cx,cy);X.lineTo(cx+7,cy);X.lineTo(cx+6,cy+10);X.lineTo(cx+1,cy+10);X.closePath();X.fill();
    });
    // Etykieta
    X.font='bold 6px Arial';X.fillStyle='rgba(0,80,180,.8)';X.textAlign='center';
    X.fillText('Hâ‚‚O',wx2+10,wy2+60);X.textAlign='left';
  }

  // â”€â”€ Skakanka â€” w wolnym miejscu miÄ™dzy hantlami a dystrybutorem (poza tablicÄ… PLAN) â”€â”€
  {
    const hkx=wx2sx(790),hky=wy2sy(360);
    // Haczyk
    X.fillStyle='#555';X.fillRect(hkx,hky,4,6);
    // Skakanka zrolowana
    X.strokeStyle='#c87020';X.lineWidth=3;
    for(let i=0;i<4;i++){X.beginPath();X.ellipse(hkx+2,hky+14+i*5,8,3,0,0,Math.PI*2);X.stroke();}
    // Uchwyt skakanki
    X.fillStyle='#222';X.fillRect(hkx-2,hky+6,7,5);X.fillRect(hkx-2,hky+34,7,5);
    X.font='bold 8px "Segoe UI",Arial,sans-serif';X.textAlign='center';
    X.strokeStyle='rgba(0,0,0,.7)';X.lineWidth=2;X.strokeText('SKIP',hkx+2,hky+50);
    X.fillStyle='#f1c40f';X.fillText('SKIP',hkx+2,hky+50);X.textAlign='left';
  }
}

function drawStudioDecorations(){
  /* v2.1.52 Amper: REDESIGN â€” premium feel jak w prawdziwym studio nagraniowym.
     STREFY:
       LEWA (0-340): kabina nagraniowa â€” mic_booth interactive
       ĹšRODEK (340-820): mikser, krzesĹ‚o, audio interface, monitory na stojakach
       PRAWA-GĂ“RA (820-1296, 62-400): biurko z DAW computer + ekran
       PRAWA-DĂ“Ĺ (820-1296, 400-672): lounge â€” kanapa + stolik
       GĂ“RA (62-160): panele akustyczne na caĹ‚ej dĹ‚ugoĹ›ci
       DOLNA krawÄ™dĹş: LED strip
     PeĹ‚ny viewport: 1296Ă—672. */
  const flx=wx2sx(0),fly=wy2sy(62),flw=wx2sx(1296)-flx,flh=wy2sy(672)-fly;
  /* v2.1.67 Amper: prawdziwa podĹ‚oga z desek drewnianych studyjnych â€” herringbone pattern + ciepĹ‚y gradient. */
  /* Bazowy ciemny drewno z gradient */
  const flg=X.createLinearGradient(flx,fly,flx,fly+flh);
  flg.addColorStop(0,'#1a0e16');flg.addColorStop(.5,'#241218');flg.addColorStop(1,'#160a12');
  X.fillStyle=flg;X.fillRect(flx,fly,flw,flh);
  /* Deski podĹ‚ogowe â€” poziome (kierunek rĂłwnolegĹ‚y do Ĺ›cian) z subtelnymi pÄ™kniÄ™ciami */
  const _plankH=64;
  for(let py=fly;py<fly+flh;py+=_plankH){
    /* KaĹĽda deska ma lekko innÄ… teksturÄ™ */
    const _seed=(py-fly)/_plankH;
    const _shade=(_seed%2===0)?'#1d0f15':'#1a0d14';
    X.fillStyle=_shade;X.fillRect(flx,py,flw,_plankH);
    /* Linia Ĺ‚Ä…czenia desek â€” ciemna */
    X.strokeStyle='rgba(8,4,6,.7)';X.lineWidth=1;
    X.beginPath();X.moveTo(flx,py);X.lineTo(flx+flw,py);X.stroke();
    /* WewnÄ™trzne grain desek â€” bardzo subtelne */
    X.strokeStyle='rgba(60,40,55,.06)';X.lineWidth=0.5;
    for(let gx=0;gx<flw;gx+=3){
      const _yoff=Math.sin((gx+_seed*100)*0.05)*1.5;
      X.beginPath();X.moveTo(flx+gx,py+_plankH/2+_yoff);X.lineTo(flx+gx+3,py+_plankH/2+_yoff);X.stroke();
    }
    /* ĹÄ…czenia pionowe (rĂłĹĽne pozycje per deska) â€” pseudo-random na podstawie seeda */
    const _splits=[(120+_seed*73)%flw, (380+_seed*131)%flw, (720+_seed*43)%flw, (1020+_seed*97)%flw];
    X.strokeStyle='rgba(0,0,0,.55)';X.lineWidth=1;
    for(const sx of _splits){X.beginPath();X.moveTo(flx+sx,py);X.lineTo(flx+sx,py+_plankH);X.stroke();}
  }
  /* Subtelny purple ambient overlay â€” recording studio mood */
  const _amb=X.createRadialGradient(flx+flw/2,fly+flh/2,0,flx+flw/2,fly+flh/2,Math.max(flw,flh)*0.7);
  _amb.addColorStop(0,'rgba(80,40,120,.08)');_amb.addColorStop(.5,'rgba(40,20,60,.04)');_amb.addColorStop(1,'rgba(0,0,0,.25)');
  X.fillStyle=_amb;X.fillRect(flx,fly,flw,flh);

  const _tt=Date.now();
  /* ON AIR â€” pulsujÄ…cy czerwony neon NAD kabinÄ… (lewa strona, wyrĂłwnany z mic_booth) */
  {
    const oax=wx2sx(100),oay=wy2sy(105);
    const pulse=0.7+Math.sin(_tt/400)*0.3;
    X.shadowColor='#e74c3c';X.shadowBlur=14*pulse;
    X.fillStyle=`rgba(0,0,0,0.9)`;X.fillRect(oax,oay,160,28);
    X.strokeStyle=`rgba(231,76,60,${0.9*pulse})`;X.lineWidth=2.5;X.strokeRect(oax,oay,160,28);
    X.fillStyle=`rgba(255,${100-50*pulse},${100-50*pulse},${pulse})`;
    X.font='bold 16px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.fillText('â—Ź ON AIR',oax+80,oay+15);
    X.shadowBlur=0;X.textAlign='left';X.textBaseline='alphabetic';
  }

  /* v2.1.69 Amper: studio monitors PRZENIESIONE â€” flankujÄ… KOMPUTER, nie mikser. Pod kÄ…tem ~38Â° wzglÄ™dem krzesĹ‚a (Ĺ›rodek 960, 369): monitor lewy x:780, prawy x:1140, oba na biurku obok komputera (wy:170). To sweet spot stereo dla nasĹ‚uchiwania producenckiego. */
  for(const sm of [{x:wx2sx(780),y:wy2sy(170)},{x:wx2sx(1140),y:wy2sy(170)}]){
    const sx=sm.x,sy=sm.y;
    // CieĹ„ stojaka
    X.fillStyle='rgba(0,0,0,.35)';X.fillRect(sx+4,sy+62,28,4);
    // Statyw
    X.fillStyle='#1a1a1a';X.fillRect(sx+15,sy+30,4,32);
    X.fillRect(sx+5,sy+62,24,3);
    // Obudowa gĹ‚oĹ›nika (drewniana ciemna)
    const cg=X.createLinearGradient(sx,sy,sx+34,sy+30);
    cg.addColorStop(0,'#1a1a1e');cg.addColorStop(0.5,'#2a2a30');cg.addColorStop(1,'#1a1a1e');
    X.fillStyle=cg;X.fillRect(sx,sy,34,30);
    X.strokeStyle='#3a3a3a';X.lineWidth=1;X.strokeRect(sx+.5,sy+.5,33,29);
    // Tweeter (mniejszy)
    X.fillStyle='#0a0a0a';X.beginPath();X.arc(sx+17,sy+8,3,0,Math.PI*2);X.fill();
    X.fillStyle='#1a1a1a';X.beginPath();X.arc(sx+17,sy+8,2,0,Math.PI*2);X.fill();
    // Woofer (wiÄ™kszy)
    X.fillStyle='#0a0a0a';X.beginPath();X.arc(sx+17,sy+20,7,0,Math.PI*2);X.fill();
    X.fillStyle='#1a1a1a';X.beginPath();X.arc(sx+17,sy+20,5.5,0,Math.PI*2);X.fill();
    X.fillStyle='#2a2a2a';X.beginPath();X.arc(sx+17,sy+20,2.5,0,Math.PI*2);X.fill();
    // LED status (zielona pulsujÄ…ca)
    const sled=0.5+Math.sin(_tt/600)*0.5;
    X.fillStyle=`rgba(39,174,96,${0.4+sled*0.6})`;
    X.beginPath();X.arc(sx+30,sy+27,1.5,0,Math.PI*2);X.fill();
  }
  /* v2.1.52 Amper: plakaty na Ĺ›cianie nad mikserem (Ĺ›rodek) â€” nie kolidujÄ… z kabinÄ… (lewa) ani DAW (prawa). */
  const posters=[
    {wx:380,wy:120,c1:'#e91e8c',c2:'#9b59b6',title:'TRAP\nKING'},
    {wx:560,wy:120,c1:'#f1c40f',c2:'#e67e22',title:'MUSIC\nLIFE'},
    {wx:740,wy:120,c1:'#3498db',c2:'#27ae60',title:'LIVE\nFEST'},
  ];
  for(const po of posters){
    const px=wx2sx(po.wx),py=wy2sy(po.wy);
    // CieĹ„ ramki
    X.fillStyle='rgba(0,0,0,.35)';X.fillRect(px+2,py+2,58,80);
    // Ramka czarna
    X.fillStyle='#0a0a0a';X.fillRect(px,py,60,82);
    // Plakat â€” gradient
    const pg=X.createLinearGradient(px+2,py+2,px+58,py+80);
    pg.addColorStop(0,po.c1);pg.addColorStop(1,po.c2);
    X.fillStyle=pg;X.fillRect(px+2,py+2,56,78);
    // Tekst
    X.font='bold 10px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.fillStyle='rgba(0,0,0,.6)';X.fillText(po.title.split('\n')[0],px+31,py+34);X.fillText(po.title.split('\n')[1]||'',px+31,py+47);
    X.fillStyle='#fff';X.fillText(po.title.split('\n')[0],px+30,py+33);X.fillText(po.title.split('\n')[1]||'',px+30,py+46);
    X.textAlign='left';X.textBaseline='alphabetic';
    // Stamp odznaki "PLATINUM" w rogu
    X.fillStyle='rgba(241,196,15,.85)';X.beginPath();X.arc(px+8,py+74,5,0,Math.PI*2);X.fill();
    X.fillStyle='#000';X.font='bold 5px Arial';X.fillText('â…',px+5,py+76);
  }
  // LED strip â€” wzdĹ‚uĹĽ dolnej krawÄ™dzi pĂłĹ‚nocnej Ĺ›ciany (RGB pulsujÄ…cy)
  const t=Date.now();
  const ledAx=wx2sx(20),ledAy=wy2sy(110),ledAw=wx2sx(1036)-ledAx;
  for(let i=0;i<28;i++){
    const lx=ledAx+i*(ledAw/28);
    const hue=(i*40+t/30)%360;
    X.fillStyle=`hsl(${hue},80%,60%)`;
    X.fillRect(lx,ledAy,3,3);
    X.shadowBlur=8;X.shadowColor=`hsl(${hue},80%,60%)`;
    X.fillRect(lx,ledAy,3,3);X.shadowBlur=0;
  }
  // Piankowe panele akustyczne na Ĺ›cianie pĂłĹ‚nocnej â€” #29B stackujÄ…ca wizualizacja
  const ax=wx2sx(50),ay=wy2sy(58),aw=950,ah=50;
  const foams=G.acousticFoams||0,panels=G.acousticPanels||0;
  const totalAc=foams+panels*2; // panele liczone podwĂłjnie (wiÄ™ksze)
  X.fillStyle='#1a0a0a';X.fillRect(ax,ay,aw,ah);
  const pW=Math.floor(aw/9);
  for(let i=0;i<9;i++){
    const px=ax+2+i*(aw-4)/9;
    // WypeĹ‚nij panele od lewej zgodnie z liczbÄ… zakupionych (max 9 widocznych slotĂłw)
    const filled=i<Math.min(9,totalAc);
    if(filled){
      X.fillStyle=i%2===0?'#3a1818':'#2a1010';
      X.fillRect(px+1,ay+2,pW-3,ah-4);
      X.fillStyle='rgba(100,40,40,.4)';X.fillRect(px+3,ay+4,pW-7,ah-8);
      // Tekstura pianki â€” kropki
      X.fillStyle='rgba(0,0,0,.3)';
      for(let dx=4;dx<pW-4;dx+=6){for(let dy=6;dy<ah-8;dy+=6){X.fillRect(px+dx,ay+dy,2,2);}}
    } else {
      // Pusty slot â€” ciemniejszy
      X.fillStyle=i%2===0?'#222':'#1a1a1a';
      X.fillRect(px+1,ay+2,pW-3,ah-4);
      // Indykator "tu moĹĽna zamontowaÄ‡" â€” szary plus
      X.fillStyle='rgba(120,120,120,.2)';X.font='14px Arial';X.textAlign='center';X.textBaseline='middle';
      X.fillText('+',px+pW/2,ay+ah/2);X.textAlign='left';X.textBaseline='alphabetic';
    }
  }
  /* v2.1.67 Amper: STUDIO + NICK GRACZA â€” auto-scaling czcionka w zaleĹĽnoĹ›ci od dĹ‚ugoĹ›ci nicka. */
  const panelColor=foams>0||panels>0;
  X.shadowBlur=0;X.shadowColor='transparent';
  X.textAlign='center';X.textBaseline='alphabetic';
  const _nick=(G.globalNick||G.name||'PRODUCER').toUpperCase();
  const _prefix=panelColor?'đźŽ¤ STUDIO PRO':'đźŽ™ STUDIO';
  const _label=`${_prefix} â€˘ ${_nick}`;
  /* Auto-fit: zaczynaj od 18px, zmniejszaj aĹĽ label siÄ™ zmieĹ›ci w 90% szerokoĹ›ci panelu */
  const _maxW=aw*0.9;
  let _fs=18;
  X.font=`bold ${_fs}px "Segoe UI",Arial,sans-serif`;
  while(_fs>9 && X.measureText(_label).width>_maxW){_fs--;X.font=`bold ${_fs}px "Segoe UI",Arial,sans-serif`;}
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
  X.strokeText(_label,ax+aw/2,ay+ah/2+_fs/3);
  /* WypeĹ‚nienie gradient: zĹ‚oto dla PRO, ciemne dla bazowego */
  const _txtGrad=X.createLinearGradient(ax,ay,ax,ay+ah);
  if(panelColor){_txtGrad.addColorStop(0,'#f1c40f');_txtGrad.addColorStop(.5,'#e91e8c');_txtGrad.addColorStop(1,'#c8a520');}
  else {_txtGrad.addColorStop(0,'#cfd8e0');_txtGrad.addColorStop(1,'#888a92');}
  X.fillStyle=_txtGrad;X.fillText(_label,ax+aw/2,ay+ah/2+_fs/3);
  X.textAlign='left';

  // ZĹ‚ote/platynowe nagrody (jeĹ›li gracz ma wydane single)
  if((G.studioTracks||[]).length>0){
    const tracks=G.studioTracks;
    const goldCount=tracks.filter(t=>(t.streams||0)>=10000).length;
    const platCount=tracks.filter(t=>(t.streams||0)>=100000).length;
    if(goldCount>0||platCount>0){
      /* v2.1.52 Amper: tablica nagrĂłd przesuniÄ™ta na Ĺ›cianÄ™ po lewej obok kabiny (wczeĹ›niej kolidowaĹ‚a z plakatem prawym wx:880). */
      const wx0=wx2sx(56),wy0=wy2sy(360);
      X.fillStyle='rgba(0,0,0,.4)';X.fillRect(wx0+3,wy0+3,140,80);
      X.fillStyle='#3a2818';X.fillRect(wx0,wy0,140,80);
      X.fillStyle='#1a1208';X.fillRect(wx0+4,wy0+4,132,72);
      // PĹ‚yty na tablicy
      const slots=[[15,18],[55,18],[95,18],[15,48],[55,48],[95,48]];
      let idx=0;
      for(let i=0;i<platCount&&idx<6;i++){
        const [sx,sy]=slots[idx++];
        const cx=wx0+sx+10,cy=wy0+sy+10;
        const grd=X.createRadialGradient(cx,cy,2,cx,cy,11);
        grd.addColorStop(0,'#f8f8f8');grd.addColorStop(.6,'#a0a0a0');grd.addColorStop(1,'#505050');
        X.fillStyle=grd;X.beginPath();X.arc(cx,cy,10,0,Math.PI*2);X.fill();
        X.fillStyle='#0a0a0a';X.beginPath();X.arc(cx,cy,2,0,Math.PI*2);X.fill();
      }
      for(let i=0;i<goldCount&&idx<6;i++){
        const [sx,sy]=slots[idx++];
        const cx=wx0+sx+10,cy=wy0+sy+10;
        const grd=X.createRadialGradient(cx,cy,2,cx,cy,11);
        grd.addColorStop(0,'#fff4a0');grd.addColorStop(.6,'#d4a020');grd.addColorStop(1,'#7a5810');
        X.fillStyle=grd;X.beginPath();X.arc(cx,cy,10,0,Math.PI*2);X.fill();
        X.fillStyle='#0a0a0a';X.beginPath();X.arc(cx,cy,2,0,Math.PI*2);X.fill();
      }
      X.font='bold 10px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
      X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2;X.strokeText('đźŹ† NAGRODY',wx0+70,wy0-3);
      X.fillStyle='#f1c40f';X.fillText('đźŹ† NAGRODY',wx0+70,wy0-3);X.textAlign='left';
    }
  }

  /* v2.1.69 Amper: audio interface PRZESUNIÄTY WYĹ»EJ (iy:330 â†’ iy:290), ĹĽeby nie kolidowaĹ‚ z krzesĹ‚em ktĂłre teĹĽ jest w okolicy y=380-440. Mikser dekoracyjny (audio interface) ma byÄ‡ minimalnie wyĹĽej. */
  const ix=wx2sx(895),iy=wy2sy(290),iw=130,ih=60;
  if(G.audioInterface){
    X.fillStyle='#0a0a1a';X.fillRect(ix,iy,iw,ih);
    X.fillStyle='#12122a';X.fillRect(ix+3,iy+3,iw-6,ih-6);
    const kc=['#e74c3c','#3498db','#2ecc71','#f39c12'];
    for(let i=0;i<4;i++){
      const kx=ix+13+i*(iw-14)/4,ky=iy+ih*.38;
      X.fillStyle='#222';X.beginPath();X.arc(kx,ky,6,0,Math.PI*2);X.fill();
      X.fillStyle=kc[i];X.beginPath();X.arc(kx,ky,4,0,Math.PI*2);X.fill();
      X.strokeStyle='#fff';X.lineWidth=1;X.beginPath();X.moveTo(kx,ky);X.lineTo(kx,ky-5);X.stroke();
    }
    for(let i=0;i<8;i++){
      X.fillStyle=i<5?'#27ae60':i<7?'#f39c12':'#e74c3c';
      X.fillRect(ix+5+i*13,iy+ih*.65,10,5);
    }
    X.fillStyle='#555';X.fillRect(ix+3,iy+ih*.5,6,ih*.35);
    X.font='bold 10px "Segoe UI",Arial,sans-serif';X.fillStyle='#3498db';X.textAlign='center';
    X.fillText('AUDIO',ix+iw/2,iy+ih-4);X.textAlign='left';
  }

  /* v2.1.69 Amper: krzesĹ‚o PRZESUNIÄTE WYĹ»EJ (chY:380â†’340) ĹĽeby zostawiÄ‡ gap przed sofÄ… ktĂłra stoi niĹĽej (wy:480). Ĺšrodek krzesĹ‚a = (960, 369). */
  const chX=wx2sx(931),chY=wy2sy(340),chW=58,chH=58;
  X.fillStyle='rgba(0,0,0,.25)';X.beginPath();X.ellipse(chX+chW/2,chY+chH+4,28,5,0,0,Math.PI*2);X.fill();
  X.fillStyle='#1a1a2a';X.fillRect(chX,chY,chW,chH);
  const chg=X.createLinearGradient(chX,chY,chX+chW,chY);
  chg.addColorStop(0,'#1a1a2a');chg.addColorStop(.5,'#2a2a3a');chg.addColorStop(1,'#1a1a2a');
  X.fillStyle=chg;X.fillRect(chX+4,chY+4,chW-8,chH*.55);
  X.fillStyle='#1e1e30';X.fillRect(chX+8,chY+chH*.55,chW-16,chH*.35);
  X.fillStyle='#333';
  [[chX+14,chY+chH],[chX+chW-14,chY+chH],[chX+chW/2,chY+chH]].forEach(([cx,cy])=>{
    X.beginPath();X.arc(cx,cy,3,0,Math.PI*2);X.fill();
  });

  /* SĹ‚uchawki â€” na Ĺ›cianie obok audio interface (prawa strona). */
  if(G.headphones){
    const hpX=wx2sx(840),hpY=wy2sy(330);
    X.strokeStyle='#222';X.lineWidth=4;X.beginPath();X.arc(hpX,hpY,14,Math.PI,0);X.stroke();
    X.fillStyle='#222';X.beginPath();X.arc(hpX-14,hpY,5,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(hpX+14,hpY,5,0,Math.PI*2);X.fill();
    /* Hak na Ĺ›cianie */
    X.fillStyle='#555';X.fillRect(hpX-2,hpY-22,4,8);
  }

  /* v2.1.52 Amper: kabel XLR od kabiny do miksera (lewaâ†’Ĺ›rodek). */
  X.strokeStyle='rgba(180,80,80,.55)';X.lineWidth=2.5;X.setLineDash([4,3]);
  X.beginPath();X.moveTo(wx2sx(260),wy2sy(280));X.bezierCurveTo(wx2sx(340),wy2sy(330),wx2sx(420),wy2sy(330),wx2sx(490),wy2sy(310));X.stroke();
  /* Kabel od miksera do audio interface (Ĺ›rodekâ†’prawa). */
  X.strokeStyle='rgba(80,140,200,.55)';
  X.beginPath();X.moveTo(wx2sx(620),wy2sy(310));X.bezierCurveTo(wx2sx(720),wy2sy(360),wx2sx(820),wy2sy(340),wx2sx(880),wy2sy(330));X.stroke();
  X.setLineDash([]);

  /* v2.1.52 Amper: regaĹ‚ winyli przeniesiony na LEWÄ„ DOLNÄ„ Ĺ›cianÄ™ pod tablicÄ… nagrĂłd (nie pod kabinÄ™). */
  {
    const rx=wx2sx(180),ry=wy2sy(440);
    // CieĹ„
    X.fillStyle='rgba(0,0,0,.2)';X.fillRect(rx+4,ry+6,74,104);
    // Korpus regaĹ‚u
    const rg=X.createLinearGradient(rx,ry,rx+70,ry);
    rg.addColorStop(0,'#1e1a14');rg.addColorStop(.5,'#2e2820');rg.addColorStop(1,'#1a1610');
    X.fillStyle=rg;X.fillRect(rx,ry,70,100);
    // PĂłĹ‚ki
    X.fillStyle='#3a3020';
    [0,33,66].forEach(i=>{X.fillRect(rx+2,ry+i+30,66,4);});
    // Winyle na pĂłĹ‚kach
    const vcolors=['#8B0000','#004080','#2d5a1b','#5a1b5a','#1b3a5a'];
    for(let sh=0;sh<3;sh++){
      const shy=ry+sh*33+6;
      let vx=rx+4;
      for(let v=0;v<5;v++){
        X.fillStyle=vcolors[v];
        X.fillRect(vx,shy,10,24);
        X.strokeStyle='rgba(255,255,255,.08)';X.lineWidth=0.5;X.strokeRect(vx,shy,10,24);
        // Label winyla
        X.fillStyle='rgba(255,255,255,.15)';
        X.fillRect(vx+1,shy+6,8,12);
        vx+=11+2;
      }
      // Separator
      X.fillStyle='rgba(255,255,255,.05)';X.fillRect(vx+2,shy,2,24);
      // Kilka CD boxĂłw
      vx+=6;
      for(let c=0;c<3;c++){
        X.fillStyle=['#2a3a4a','#3a2a1a','#1a2a3a'][c];
        X.fillRect(vx,shy,8,24);
        X.strokeStyle='rgba(255,255,255,.1)';X.lineWidth=0.5;X.strokeRect(vx,shy,8,24);
        vx+=9;
      }
    }
    /* v2.1.67 Amper: napis VINYLS NAD regaĹ‚em (ry-22), gĹ‚oĹ›nik na BOKU regaĹ‚u (rx+74, po prawej stronie) â€” wczeĹ›niej gĹ‚oĹ›nik na top (ry-34) zasĹ‚aniaĹ‚ napis. */
    X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.lineJoin='round';X.strokeText('đź’ż VINYLS',rx+35,ry-8);
    X.fillStyle='#f1c40f';X.fillText('đź’ż VINYLS',rx+35,ry-8);
    X.textAlign='left';
    /* GĹ‚oĹ›nik bookshelf â€” po PRAWEJ stronie regaĹ‚u (nie zasĹ‚ania napisu) */
    const spx=rx+76,spy=ry+10;
    X.fillStyle='#111';X.fillRect(spx,spy,32,40);
    X.fillStyle='#222';X.fillRect(spx+2,spy+2,28,36);
    // Tweeter (gĂłra)
    X.fillStyle='#333';X.beginPath();X.arc(spx+16,spy+10,5,0,Math.PI*2);X.fill();
    X.fillStyle='#555';X.beginPath();X.arc(spx+16,spy+10,3,0,Math.PI*2);X.fill();
    // Woofer (dĂłĹ‚)
    const wg=X.createRadialGradient(spx+16,spy+27,0,spx+16,spy+27,11);
    wg.addColorStop(0,'#555');wg.addColorStop(.7,'#222');wg.addColorStop(1,'#111');
    X.fillStyle=wg;X.beginPath();X.arc(spx+16,spy+27,10,0,Math.PI*2);X.fill();
    X.strokeStyle='#444';X.lineWidth=1;X.beginPath();X.arc(spx+16,spy+27,9,0,Math.PI*2);X.stroke();
    // Logo gĹ‚oĹ›nika â€” na Ĺ›rodku boku, pod tweetterem
    X.fillStyle='rgba(255,200,80,.6)';X.font='4px Arial';X.textAlign='center';
    X.fillText('â–¶',spx+16,spy+38);X.textAlign='left';
  }
}

function drawMieszkanieDecorations(){
  // RozrĂłĹĽnienie wizualne traphouse vs basic (oba uĹĽywajÄ… tego samego room ROOMS.mieszkanie)
  const isBasic=G.apartment==='basic';
  // PodĹ‚oga â€” basic ma jasny parkiet, traphouse ciemne deski (overlay na 'wood' tile)
  if(isBasic){
    // Jasny parkiet â€” overlay
    const flx=wx2sx(0),fly=wy2sy(62),flw=wx2sx(1296)-flx,flh=wy2sy(734)-fly;
    X.fillStyle='rgba(220,200,170,.18)';X.fillRect(flx,fly,flw,flh);
    // Linie parkietu
    X.strokeStyle='rgba(180,160,130,.12)';X.lineWidth=1;
    for(let py2=fly+30;py2<fly+flh;py2+=30){X.beginPath();X.moveTo(flx,py2);X.lineTo(flx+flw,py2);X.stroke();}
  } else {
    // Traphouse â€” ciepĹ‚y overlay drewna (bez "okrÄ…gĹ‚ych cieni" â€” usuniÄ™te zgodnie z #60)
    const flx=wx2sx(0),fly=wy2sy(62),flw=wx2sx(1296)-flx,flh=wy2sy(734)-fly;
    X.fillStyle='rgba(40,20,10,.15)';X.fillRect(flx,fly,flw,flh);
  }
  // Dywan w salonie â€” basic ma czysty niebieski, traphouse ciemny fioletowy
  const drx=wx2sx(60),dry=wy2sy(470),drw=440,drh=200;
  const drg=X.createLinearGradient(drx,dry,drx+drw,dry+drh);
  if(isBasic){
    drg.addColorStop(0,'rgba(60,90,130,.55)');drg.addColorStop(.5,'rgba(80,120,170,.65)');drg.addColorStop(1,'rgba(60,90,130,.55)');
  } else {
    drg.addColorStop(0,'rgba(60,30,80,.5)');drg.addColorStop(.5,'rgba(80,40,100,.6)');drg.addColorStop(1,'rgba(60,30,80,.5)');
  }
  X.fillStyle=drg;X.fillRect(drx,dry,drw,drh);
  X.strokeStyle=isBasic?'rgba(180,210,240,.22)':'rgba(200,150,255,.18)';X.lineWidth=1;
  X.strokeRect(drx+6,dry+6,drw-12,drh-12);

  // Plakat TRAPLIFE â€” przeniesiony na gĂłrnÄ… Ĺ›cianÄ™ biura, gdzie nic nie zasĹ‚ania (#61)
  // Biuro: wx 820-1296, wy 340-734. GĂłrna Ĺ›ciana wy=345-395. Wolne miejsce wx=950-1090.
  const pw=140, ph=50;
  const px=wx2sx(950), py=wy2sy(348);
  X.fillStyle='rgba(0,0,0,.4)';X.fillRect(px+3,py+3,pw,ph);
  X.fillStyle=isBasic?'#1a2a3a':'#111';X.fillRect(px,py,pw,ph);
  const hasCar=G.careers&&(G.careers.raper||G.careers.beatmaker||G.careers.youtuber);
  const pg=X.createLinearGradient(px,py,px,py+ph);
  if(isBasic){
    // Czysty plakat â€” nowoczesny styl
    pg.addColorStop(0,'#2a4a6a');pg.addColorStop(.5,'#1a3a5a');pg.addColorStop(1,'#0a2a4a');
  } else if(hasCar){
    pg.addColorStop(0,'#3a0a4a');pg.addColorStop(.5,'#1a0a2a');pg.addColorStop(1,'#2a0a3a');
  } else {
    pg.addColorStop(0,'#0a1830');pg.addColorStop(1,'#050a1a');
  }
  X.fillStyle=pg;X.fillRect(px+4,py+4,pw-8,ph-8);
  if(hasCar&&!isBasic){X.strokeStyle='#c8a520';X.lineWidth=1;X.strokeRect(px+6,py+6,pw-12,ph-12);}
  if(isBasic){X.strokeStyle='#7ec8e3';X.lineWidth=1;X.strokeRect(px+6,py+6,pw-12,ph-12);}
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 26px Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  const posterEm=isBasic?'đźŚ†':(hasCar?'đźŽ¤':'đźŽµ');
  X.fillText(posterEm,px+pw/2-32,py+ph*.65);
  X.font='bold 13px "Segoe UI",Arial,sans-serif';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
  const posterTxt=isBasic?'HOME':(hasCar?'TRAPLIFE':'GRINDING');
  X.strokeText(posterTxt,px+pw/2+18,py+ph*.62);
  X.fillStyle=isBasic?'#7ec8e3':(hasCar?'#f1c40f':'#fff');
  X.fillText(posterTxt,px+pw/2+18,py+ph*.62);
  X.textAlign='left';

  // Basic ma dodatkowÄ… roĹ›linÄ™ przy Ĺ›cianie â€” symbol czystego mieszkania
  if(isBasic){
    const plX=wx2sx(70),plY=wy2sy(380);
    X.fillStyle='#7a5030';X.fillRect(plX-10,plY,20,15);
    X.fillStyle='#1a5a20';X.beginPath();X.arc(plX,plY-10,12,0,Math.PI*2);X.fill();
    X.fillStyle='#2a8a30';X.beginPath();X.arc(plX-4,plY-12,6,0,Math.PI*2);X.fill();
  }

  // â”€â”€ DODATKOWE DEKORACJE WNÄTRZ â”€â”€
  // Plakaty na Ĺ›cianach w sypialni â€” wieksze i czytelniejsze
  {
    const pw1=80, ph1=58;
    const px1=wx2sx(120),py1=wy2sy(70);
    X.fillStyle='#1a1a1a';X.fillRect(px1,py1,pw1,ph1);
    const pg1=X.createLinearGradient(px1,py1,px1,py1+ph1);
    pg1.addColorStop(0,isBasic?'#1a5078':'#3a0a4a');
    pg1.addColorStop(1,isBasic?'#0a3050':'#1a0a2a');
    X.fillStyle=pg1;X.fillRect(px1+2,py1+2,pw1-4,ph1-4);
    X.shadowBlur=0;X.shadowColor='transparent';
    X.font='bold 24px Arial';X.textAlign='center';X.textBaseline='alphabetic';
    X.fillText(isBasic?'đźŚ†':'đźŽµ',px1+pw1/2,py1+ph1*0.5);
    // Tekst â€” wieksza czcionka z konturem dla czytelnosci
    X.font='bold 11px "Segoe UI",Arial,sans-serif';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
    X.strokeText(isBasic?'HOME':'VIBES',px1+pw1/2,py1+ph1-7);
    X.fillStyle='#fff';
    X.fillText(isBasic?'HOME':'VIBES',px1+pw1/2,py1+ph1-7);
    X.textAlign='left';
  }
  // Ramka na zdjÄ™ciach przy sypialni (rodzina/przyjaciele)
  {
    const fX=wx2sx(290),fY=wy2sy(105);
    X.fillStyle='#3a2010';X.fillRect(fX,fY,28,22);
    X.fillStyle='#7a5028';X.fillRect(fX+1,fY+1,26,20);
    X.fillStyle='#cccccc';X.fillRect(fX+3,fY+3,22,16);
    X.fillStyle='#7ec8e3';X.fillRect(fX+3,fY+12,22,7); // niebo
    X.fillStyle='#aa7050';X.beginPath();X.arc(fX+8,fY+16,3,0,Math.PI*2);X.fill();
    X.fillStyle='#aa7050';X.beginPath();X.arc(fX+18,fY+16,3,0,Math.PI*2);X.fill();
  }
  // Lampa sufitowa nad salonem (cienka)
  {
    const lcX=wx2sx(280),lcY=wy2sy(370);
    X.fillStyle='#1a1a1a';X.fillRect(lcX-1,lcY,2,20);
    X.fillStyle='#3a3a40';X.beginPath();X.moveTo(lcX-12,lcY+20);X.lineTo(lcX+12,lcY+20);X.lineTo(lcX+8,lcY+30);X.lineTo(lcX-8,lcY+30);X.closePath();X.fill();
    // Bulb glow w nocy
    if(G.timeOfDay>=2&&G._lampkaOn!==false){
      X.save();X.globalCompositeOperation='lighter';
      const gg=X.createRadialGradient(lcX,lcY+30,5,lcX,lcY+30,80);
      gg.addColorStop(0,'rgba(255,235,170,0.3)');
      gg.addColorStop(1,'rgba(255,235,170,0)');
      X.fillStyle=gg;X.beginPath();X.arc(lcX,lcY+30,80,0,Math.PI*2);X.fill();
      X.restore();
      X.fillStyle='#ffe89a';X.beginPath();X.arc(lcX,lcY+27,3,0,Math.PI*2);X.fill();
    }
  }
  // MaĹ‚y dywan przed Ĺ‚ĂłĹĽkiem
  {
    const drX=wx2sx(60),drY=wy2sy(245),drW=160,drH=50;
    const dg=X.createLinearGradient(drX,drY,drX+drW,drY+drH);
    if(isBasic){dg.addColorStop(0,'rgba(60,90,140,.55)');dg.addColorStop(.5,'rgba(80,120,170,.65)');dg.addColorStop(1,'rgba(60,90,140,.55)');}
    else{dg.addColorStop(0,'rgba(140,30,30,.55)');dg.addColorStop(.5,'rgba(180,50,50,.65)');dg.addColorStop(1,'rgba(140,30,30,.55)');}
    X.fillStyle=dg;X.fillRect(drX,drY,drW,drH);
    X.strokeStyle=isBasic?'rgba(180,210,240,.3)':'rgba(220,180,80,.4)';X.lineWidth=1;
    X.strokeRect(drX+5,drY+5,drW-10,drH-10);
  }
  // Wieszak Ĺ›cienny w garderobie
  {
    const wX=wx2sx(420),wY=wy2sy(80);
    X.fillStyle='#5a3a18';X.fillRect(wX,wY,90,5);
    // Wieszane ubrania
    const cols=['#3498db','#e91e8c','#f1c40f','#27ae60'];
    for(let i=0;i<4;i++){
      X.fillStyle='#888';X.fillRect(wX+10+i*20,wY+5,1,3); // hak
      X.fillStyle=cols[i];X.fillRect(wX+5+i*20,wY+7,12,18);
      X.fillStyle='rgba(0,0,0,.2)';X.fillRect(wX+5+i*20,wY+22,12,2);
    }
  }
  // (Dekoracja stosu ksiazek na biurku â€” usunieta, biblioteka jest osobnym obiektem)
  // Zegar Ĺ›cienny
  {
    const ckX=wx2sx(1100),ckY=wy2sy(80);
    X.fillStyle='#1a1a1a';X.beginPath();X.arc(ckX,ckY,14,0,Math.PI*2);X.fill();
    X.fillStyle='#fff';X.beginPath();X.arc(ckX,ckY,12,0,Math.PI*2);X.fill();
    X.fillStyle='#000';
    // Cyferki
    X.font='bold 6px Arial';X.textAlign='center';X.textBaseline='middle';
    for(let i=0;i<12;i++){
      const a=i*Math.PI/6-Math.PI/2;
      X.fillText(((i+12)%12)||12,ckX+Math.cos(a)*9,ckY+Math.sin(a)*9);
    }
    // WskazĂłwki â€” synchronizowane z gameMin
    const totalMins=Math.floor(gameMin)%1440;
    const hrs=Math.floor(totalMins/60)%12,mins=totalMins%60;
    const ha=hrs*Math.PI/6-Math.PI/2,ma=mins*Math.PI/30-Math.PI/2;
    X.strokeStyle='#000';X.lineWidth=2;X.lineCap='round';
    X.beginPath();X.moveTo(ckX,ckY);X.lineTo(ckX+Math.cos(ha)*5,ckY+Math.sin(ha)*5);X.stroke();
    X.lineWidth=1;
    X.beginPath();X.moveTo(ckX,ckY);X.lineTo(ckX+Math.cos(ma)*8,ckY+Math.sin(ma)*8);X.stroke();
    X.fillStyle='#c80000';X.beginPath();X.arc(ckX,ckY,1.5,0,Math.PI*2);X.fill();
    X.textAlign='left';X.textBaseline='alphabetic';
  }

  // (Lampka, TV, biblioteka â€” usuniÄ™te stÄ…d, sÄ… jako obiekty w ROOMS.mieszkanie.objects)

  // â”€â”€ RoĹ›lina doniczkowa (prawy dolny naroĹĽnik salonu â€” bezpieczna pozycja) â”€â”€
  {
    const plx=wx2sx(490),ply=wy2sy(700);
    // Doniczka
    X.fillStyle='#5a3010';X.beginPath();X.moveTo(plx-14,ply+10);X.lineTo(plx+14,ply+10);X.lineTo(plx+10,ply+28);X.lineTo(plx-10,ply+28);X.closePath();X.fill();
    X.fillStyle='#7a4020';X.fillRect(plx-15,ply+8,30,4);
    // Ziemia
    X.fillStyle='#2a1a08';X.beginPath();X.ellipse(plx,ply+9,12,4,0,0,Math.PI*2);X.fill();
    // Ĺodygi i liĹ›cie
    const leafCols=['#1a5a10','#2a7a20','#1a4a10','#3a8a30'];
    [[-8,-30,-18,-10],[-3,-36,6,-8],[5,-28,18,-12],[0,-40,-12,-18]].forEach(([lx,ly,ex,ey],i)=>{
      X.fillStyle=leafCols[i];X.beginPath();X.moveTo(plx,ply);X.quadraticCurveTo(plx+lx,ply+ly,plx+ex,ply+ey);X.quadraticCurveTo(plx+lx*0.5,ply+ly*0.5,plx,ply);X.fill();
    });
    // Ĺšrodkowy pÄ…czek
    X.fillStyle='#5aba40';X.beginPath();X.ellipse(plx,ply-36,4,6,0,0,Math.PI*2);X.fill();
  }

  // â”€â”€ Dywanik przy drzwiach (kolor zaleĹĽy od mieszkania) â”€â”€
  {
    const mdx=wx2sx(560),mdy=wy2sy(555),mdw=130,mdh=42;
    const mdg=X.createLinearGradient(mdx,mdy,mdx+mdw,mdy);
    if(isBasic){
      mdg.addColorStop(0,'rgba(30,80,120,.65)');mdg.addColorStop(.5,'rgba(50,120,170,.85)');mdg.addColorStop(1,'rgba(30,80,120,.65)');
    } else {
      mdg.addColorStop(0,'rgba(120,30,30,.65)');mdg.addColorStop(.5,'rgba(170,50,50,.85)');mdg.addColorStop(1,'rgba(120,30,30,.65)');
    }
    X.fillStyle=mdg;X.fillRect(mdx,mdy,mdw,mdh);
    X.strokeStyle=isBasic?'rgba(180,220,255,.5)':'rgba(255,200,120,.45)';X.lineWidth=2;
    X.strokeRect(mdx+3,mdy+3,mdw-6,mdh-6);
    X.shadowBlur=0;X.shadowColor='transparent';
    X.textBaseline='middle';
    X.font='bold 12px "Segoe UI",Arial,sans-serif';X.textAlign='center';
    const _aptLbl=({traphouse:'TRAPHOUSE',basic:'MIESZKANIE',premium:'APARTAMENT',luxury:'PENTHOUSE',mansion:'REZYDENCJA'})[G.apartment]||'TRAPHOUSE';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
    X.strokeText(_aptLbl,mdx+mdw/2,mdy+mdh/2+1);
    X.fillStyle=isBasic?'#dceeff':'#ffe4b8';
    X.fillText(_aptLbl,mdx+mdw/2,mdy+mdh/2+1);
    X.textAlign='left';X.textBaseline='alphabetic';
  }
}
function drawBooth(sx,sy,w,h){
  // Dark acoustic booth background
  X.fillStyle='#0a0505';X.fillRect(sx,sy,w,h);
  // Acoustic foam panels on walls (visible from top-down)
  const pc=getRaperST('realizacja')>0||G.hasFoam?'#3a1818':'#1a1010';
  const pc2=getRaperST('realizacja')>0||G.hasFoam?'#2a0e0e':'#140a0a';
  for(let r=0;r<4;r++)for(let c=0;c<5;c++){
    X.fillStyle=(r+c)%2===0?pc:pc2;
    X.fillRect(sx+5+c*(w-10)/5,sy+5+r*(h-10)/4,(w-10)/5-2,(h-10)/4-2);
  }
  // Pop shield (circular ring at top-center)
  const midX=sx+w/2,shY=sy+h*.22;
  X.strokeStyle='#555';X.lineWidth=2;X.beginPath();X.arc(midX,shY,10,0,Math.PI*2);X.stroke();
  X.strokeStyle='rgba(200,200,200,.2)';X.lineWidth=1;X.setLineDash([2,2]);
  X.beginPath();X.arc(midX,shY,9,0,Math.PI*2);X.stroke();X.setLineDash([]);
  // Mic stand
  X.strokeStyle='#777';X.lineWidth=3;X.beginPath();X.moveTo(midX,shY+10);X.lineTo(midX,sy+h*.7);X.stroke();
  // Base
  X.strokeStyle='#666';X.lineWidth=4;X.beginPath();X.moveTo(midX-16,sy+h*.72);X.lineTo(midX+16,sy+h*.72);X.stroke();
  // Microphone body (condenser mic) â€” kolor zaleĹĽny od jakoĹ›ci G.mic
  const micH=h*.28,micW=14;
  const mgX=midX-micW/2,mgY=shY-micH*.5;
  const micQ=G.mic?G.mic.quality:0;
  const mg=X.createLinearGradient(mgX,mgY,mgX+micW,mgY);
  if(micQ>=80){
    // Pro mic â€” gold/platinum
    mg.addColorStop(0,'#c8a520');mg.addColorStop(.3,'#f1d060');mg.addColorStop(.7,'#c8a520');mg.addColorStop(1,'#7a5810');
  } else if(micQ>=50){
    // Mid mic â€” silver
    mg.addColorStop(0,'#aaa');mg.addColorStop(.3,'#ddd');mg.addColorStop(.7,'#bbb');mg.addColorStop(1,'#777');
  } else if(micQ>0){
    // Budget mic â€” gray
    mg.addColorStop(0,'#666');mg.addColorStop(.3,'#999');mg.addColorStop(.7,'#777');mg.addColorStop(1,'#444');
  } else {
    // No mic â€” wyblakĹ‚y
    mg.addColorStop(0,'#3a3a3a');mg.addColorStop(.5,'#5a5a5a');mg.addColorStop(1,'#3a3a3a');
  }
  X.fillStyle=mg;X.fillRect(mgX,mgY,micW,micH*.7);
  // Mic capsule (mesh)
  X.fillStyle='#444';X.beginPath();X.arc(midX,mgY,micW*.6,Math.PI,0);X.fill();
  for(let i=0;i<3;i++){
    X.fillStyle='rgba(200,200,200,.15)';X.beginPath();X.arc(midX-4+i*4,mgY,2,Math.PI,0);X.fill();
  }
  // Red LED on mic (recording indicator)
  const ledOn=G.currentTrack&&G.currentTrack.recording;
  X.fillStyle=ledOn?'#ff2020':'#3a0808';
  X.beginPath();X.arc(midX+micW*.5,mgY+micH*.1,2.5,0,Math.PI*2);X.fill();
  // Label â€” strokeText+fillText (wzorzec "PoĹ‚ĂłĹĽ cegĹ‚Ä™!", brak rozpikselowania)
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';
  X.lineJoin='round';X.lineWidth=2.5;X.strokeStyle='rgba(0,0,0,.85)';
  X.strokeText('KABINA',sx+w/2,sy+h-4);
  X.fillStyle='#e8a8a8';X.fillText('KABINA',sx+w/2,sy+h-4);
  X.textAlign='left';
}
function drawMixer(sx,sy,w,h){
  X.fillStyle='#0a0a1a';X.fillRect(sx,sy,w,h);X.fillStyle='#14142a';X.fillRect(sx+3,sy+3,w-6,h-6);
  for(let i=0;i<5;i++){X.fillStyle='#3498db';X.fillRect(sx+10+i*22,sy+h*.3,14,h*.4*(sr(i)*.5+.5));}
  // Label â€” strokeText+fillText
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';
  X.lineJoin='round';X.lineWidth=2.5;X.strokeStyle='rgba(0,0,0,.85)';
  X.strokeText('MIKSER',sx+w/2,sy+h-5);
  X.fillStyle='#7ec8e3';X.fillText('MIKSER',sx+w/2,sy+h-5);
  X.textAlign='left';
  // Klawiatura MIDI nad mikserem (jeĹ›li kupiona)
  if(G.midiCtrl){
    const kbY=sy-20;
    // Korpus klawiatury MIDI
    X.fillStyle='#1a1a2a';X.fillRect(sx,kbY,w,18);
    X.fillStyle='#0a0a14';X.fillRect(sx+1,kbY+1,w-2,16);
    // Klawisze biaĹ‚e
    const kCount=Math.max(8,Math.floor(w/8));
    const kW=(w-4)/kCount;
    for(let k=0;k<kCount;k++){
      X.fillStyle='#f0f0f0';X.fillRect(sx+2+k*kW,kbY+3,kW-1,11);
    }
    // Klawisze czarne (co 2 i 5)
    for(let k=0;k<kCount;k++){
      if(k%7===1||k%7===3||k%7===5||k%7===6){
        X.fillStyle='#0a0a0a';X.fillRect(sx+2+k*kW+kW*.55,kbY+3,kW*.5,7);
      }
    }
    // Logo MIDI
    const qual=G.midiCtrl.quality||30;
    const ledColor=qual>=70?'#27ae60':qual>=40?'#f39c12':'#e74c3c';
    X.fillStyle=ledColor;X.fillRect(sx+w-8,kbY+1,3,3);
    X.font='bold 6px sans-serif';X.fillStyle='rgba(150,150,200,.5)';X.fillText('MIDI',sx+4,kbY-2);
  }
}
function drawStudioComputer(sx,sy,w,h){
  // Biurko (drewniany blat na podstawie)
  X.fillStyle='#1a1a2a';X.fillRect(sx,sy+h*.45,w,h*.55);
  X.fillStyle='#3a2818';X.fillRect(sx,sy+h*.45,w,8); // drewniany blat
  X.fillStyle='#222234';X.fillRect(sx,sy+h*.50,w,2); // krawÄ™dĹş
  // Obudowa monitora â€” zawsze widoczna
  X.fillStyle='#0a0a0a';X.fillRect(sx+8,sy,w-16,h*.42);
  // Ekran monitora
  if(G.hasDaw){
    const dawColor={1:'#9b59b6',2:'#3498db',3:'#2ecc71'}[G.dawTier||1];
    const sg=X.createLinearGradient(sx+11,sy+3,sx+w-11,sy+h*.38);
    sg.addColorStop(0,'#0a0a1a');sg.addColorStop(1,'#1a0a2a');
    X.fillStyle=sg;X.fillRect(sx+11,sy+3,w-22,h*.36);
    // DAW waveforms
    X.strokeStyle=dawColor;X.lineWidth=1.2;X.beginPath();
    let first=true;
    for(let i=0;i<w-22;i+=2){
      const yy=sy+h*.2+Math.sin(i*.25)*((h*.36-12)*0.45)*sr(i*7);
      if(first){X.moveTo(sx+11+i,yy);first=false;}else X.lineTo(sx+11+i,yy);
    }
    X.stroke();
    const dawNames={1:'DAW BASIC',2:'DAW PRO',3:'LOGIC PRO'};
    X.shadowBlur=0;X.font='bold 8px "Segoe UI",Arial,sans-serif';X.fillStyle=dawColor;X.textAlign='center';
    X.fillText(dawNames[G.dawTier||1],sx+w/2,sy+h*.26);X.textAlign='left';
  } else {
    // WyĹ‚Ä…czony ekran (ciemny, lekki refleks Ĺ›wiatĹ‚a)
    X.fillStyle='#1a1820';X.fillRect(sx+11,sy+3,w-22,h*.36);
    X.fillStyle='rgba(255,255,255,.04)';X.fillRect(sx+11,sy+3,w-22,4); // refleks gĂłrnej krawÄ™dzi
    // Pasek "wyĹ‚Ä…czony" + napis "Kup komputer studyjny" (gdy hasDaw=false)
    X.shadowBlur=0;X.font='bold 9px "Segoe UI",Arial,sans-serif';X.fillStyle='rgba(180,180,200,.45)';X.textAlign='center';
    X.lineJoin='round';X.lineWidth=2.2;X.strokeStyle='rgba(0,0,0,.7)';
    X.strokeText('đź’» Kup komputer studyjny',sx+w/2,sy+h*.21);
    X.fillText('đź’» Kup komputer studyjny',sx+w/2,sy+h*.21);
    X.textAlign='left';
  }
  // Podstawa monitora (zawsze)
  X.fillStyle='#0a0a0a';X.fillRect(sx+w/2-4,sy+h*.42,8,7);X.fillRect(sx+w/2-12,sy+h*.42+7,24,4);
  // Klawiatura â€” zawsze widoczna
  X.fillStyle='#1a1a22';X.fillRect(sx+10,sy+h*.55,w-30,10);
  X.fillStyle=G.hasDaw?'rgba(150,100,200,.4)':'rgba(120,120,140,.25)';
  for(let k=0;k<Math.floor((w-30)/15);k++)X.fillRect(sx+12+k*15,sy+h*.56,12,7);
  // Mysz â€” po prawej obok klawiatury
  X.fillStyle='#15151a';
  X.beginPath();X.ellipse(sx+w-15,sy+h*.6+3,8,5,0,0,Math.PI*2);X.fill();
  X.fillStyle='rgba(80,80,100,.3)';X.fillRect(sx+w-17,sy+h*.6,4,1); // scroll
}
function drawGeneric(sx,sy,w,h,id){
  X.fillStyle='#1a2030';X.fillRect(sx,sy,w,h);
  X.font='12px "Segoe UI"';X.fillStyle='#556';X.textAlign='center';X.fillText(id,sx+w/2,sy+h/2+4);X.textAlign='left';
}
// â”€â”€ MERCH STUDIO OBIEKTY â”€â”€
function drawMerchDesignerObj(sx,sy,w,h){
  // StĂłĹ‚ projektanta â€” biaĹ‚a powierzchnia, schematy
  X.fillStyle='rgba(0,0,0,.25)';X.fillRect(sx+4,sy+h-6,w-8,6);
  X.fillStyle='#5a3a18';X.fillRect(sx,sy+h*.55,w,h*.45); // korpus
  X.fillStyle='#e8e0d0';X.fillRect(sx+5,sy+h*.4,w-10,h*.18); // blat
  // Szkice produktĂłw
  X.fillStyle='#fff';X.fillRect(sx+15,sy+h*.45,w*.25,h*.1);
  X.fillStyle='#3a3a3a';X.fillRect(sx+18,sy+h*.47,3,3);X.fillRect(sx+22,sy+h*.47,3,3);
  X.fillRect(sx+18,sy+h*.51,8,2);
  // Komputer/tablet
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*.5,sy+h*.3,w*.3,h*.18);
  X.fillStyle='#3a8ae0';X.fillRect(sx+w*.52,sy+h*.32,w*.26,h*.13);
  X.fillStyle='#fff';X.font='bold 8px sans-serif';X.textAlign='center';X.fillText('DESIGN',sx+w*.65,sy+h*.4+3);X.textAlign='left';
  // PiĂłro
  X.fillStyle='#e91e63';X.fillRect(sx+w*.1,sy+h*.42,w*.06,3);
  // Emoji indykator
  X.font='28px Arial';X.textAlign='center';X.fillStyle='rgba(255,255,255,.5)';X.fillText('đźŽ¨',sx+w/2,sy+h*.3);X.textAlign='left';
}
function drawMerchFactoryObj(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.25)';X.fillRect(sx+4,sy+h-6,w-8,6);
  // Maszyna â€” szafa metalowa
  X.fillStyle='#3a3a40';X.fillRect(sx,sy+h*.2,w,h*.8);
  X.fillStyle='#4a4a50';X.fillRect(sx+3,sy+h*.22,w-6,h*.05);
  // Panel kontrolny
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*.1,sy+h*.3,w*.35,h*.25);
  // Ekran z animowanÄ… liniÄ… produkcji
  X.fillStyle='#1a4a1a';X.fillRect(sx+w*.12,sy+h*.32,w*.31,h*.21);
  X.fillStyle='#7ec87e';X.font='bold 9px monospace';X.textAlign='center';X.fillText('â—Ź PRODUCING',sx+w*.275,sy+h*.4+3);X.textAlign='left';
  // Diody
  for(let i=0;i<3;i++){X.fillStyle=['#27ae60','#f1c40f','#e74c3c'][i];X.beginPath();X.arc(sx+w*.13+i*8,sy+h*.5,2,0,Math.PI*2);X.fill();}
  // TaĹ›ma produkcyjna
  X.fillStyle='#2a2a2a';X.fillRect(sx+w*.5,sy+h*.6,w*.45,h*.15);
  X.fillStyle='#1a1a1a';for(let i=0;i<4;i++){X.fillRect(sx+w*.5+i*16,sy+h*.6,8,h*.15);}
  // Produkt na taĹ›mie
  const prodX=sx+w*.5+((anim*0.05)%(w*.4));
  X.fillStyle='#e91e63';X.fillRect(prodX,sy+h*.55,16,12);
  X.font='24px Arial';X.textAlign='center';X.fillStyle='rgba(255,255,255,.4)';X.fillText('đźŹ­',sx+w*.7,sy+h*.4);X.textAlign='left';
}
function drawMerchWarehouseObj(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.25)';X.fillRect(sx+4,sy+h-6,w-8,6);
  // RegaĹ‚y magazynu
  X.fillStyle='#5a3a18';X.fillRect(sx,sy+h*.15,w,h*.85);
  // 3 pĂłĹ‚ki
  X.fillStyle='#3a2410';
  for(let r=0;r<3;r++){X.fillRect(sx+4,sy+h*.25+r*(h*.22),w-8,4);}
  // PudĹ‚a na pĂłĹ‚kach
  const colors=['#e91e63','#3498db','#27ae60','#f39c12','#9b59b6','#e74c3c'];
  for(let r=0;r<3;r++){
    for(let c=0;c<3;c++){
      const bx=sx+8+c*(w/3.2),by=sy+h*.27+r*(h*.22);
      X.fillStyle=colors[(r*3+c)%6];X.fillRect(bx,by,w*.22,h*.16);
      X.fillStyle='rgba(0,0,0,.3)';X.fillRect(bx,by+h*.13,w*.22,3);
      X.fillStyle='#fff';X.font='bold 6px sans-serif';X.fillText('M',bx+3,by+8);
    }
  }
  X.font='22px Arial';X.textAlign='center';X.fillStyle='rgba(255,255,255,.5)';X.fillText('đź“¦',sx+w/2,sy+h*.12);X.textAlign='left';
}
function drawMerchReportObj(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.25)';X.fillRect(sx+4,sy+h-6,w-8,6);
  // Biurko
  X.fillStyle='#3a2a18';X.fillRect(sx,sy+h*.6,w,h*.4);
  // Monitor
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*.15,sy+h*.15,w*.7,h*.45);
  X.fillStyle='#1a3a5a';X.fillRect(sx+w*.18,sy+h*.18,w*.64,h*.39);
  // Wykres sĹ‚upkowy
  X.fillStyle='#7ec87e';
  const bars=[10,18,14,22,28,16,32];
  for(let i=0;i<bars.length;i++){X.fillRect(sx+w*.22+i*(w*.085),sy+h*.45-bars[i]*0.6,w*.06,bars[i]*0.6);}
  // Linia wykresu
  X.strokeStyle='#f1c40f';X.lineWidth=2;X.beginPath();
  X.moveTo(sx+w*.22,sy+h*.4);
  X.bezierCurveTo(sx+w*.4,sy+h*.35,sx+w*.6,sy+h*.3,sx+w*.78,sy+h*.22);
  X.stroke();
  // Stojak monitora
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*.45,sy+h*.6,w*.1,h*.05);
  X.fillRect(sx+w*.4,sy+h*.65,w*.2,h*.04);
  X.font='22px Arial';X.textAlign='center';X.fillStyle='rgba(255,255,255,.5)';X.fillText('đź“Š',sx+w*.85,sy+h*.25);X.textAlign='left';
}
// â”€â”€ PARK OBIEKTY â”€â”€
function drawFountain(sx,sy,w,h){
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.25)';X.beginPath();X.ellipse(sx+w/2,sy+h-4,w*.5,h*.12,0,0,Math.PI*2);X.fill();
  // ZewnÄ™trzny kamieĹ„
  X.fillStyle='#888888';X.beginPath();X.ellipse(sx+w/2,sy+h*.65,w*.5,h*.32,0,0,Math.PI*2);X.fill();
  X.fillStyle='#666666';X.beginPath();X.ellipse(sx+w/2,sy+h*.65,w*.45,h*.28,0,0,Math.PI*2);X.fill();
  // Woda dolnego basenu
  const wg=X.createRadialGradient(sx+w/2,sy+h*.6,2,sx+w/2,sy+h*.6,w*.4);
  wg.addColorStop(0,'#4ab8e0');wg.addColorStop(.7,'#2a8ac0');wg.addColorStop(1,'#1a6a90');
  X.fillStyle=wg;X.beginPath();X.ellipse(sx+w/2,sy+h*.6,w*.38,h*.22,0,0,Math.PI*2);X.fill();
  // GĂłrny dzban
  X.fillStyle='#888';X.fillRect(sx+w*.42,sy+h*.25,w*.16,h*.3);
  X.fillStyle='#aaa';X.beginPath();X.ellipse(sx+w/2,sy+h*.25,w*.13,h*.06,0,0,Math.PI*2);X.fill();
  // Strumienie wody
  const t=anim*0.1;
  X.strokeStyle='rgba(180,220,255,.7)';X.lineWidth=2;
  for(let i=0;i<6;i++){
    const a=(i/6)*Math.PI*2 + t*0.05;
    X.beginPath();X.moveTo(sx+w/2,sy+h*.22);
    X.bezierCurveTo(sx+w/2+Math.cos(a)*8, sy+h*.1, sx+w/2+Math.cos(a)*22, sy+h*.4, sx+w/2+Math.cos(a)*30, sy+h*.55);
    X.stroke();
  }
  // Krople
  for(let i=0;i<5;i++){
    X.fillStyle='rgba(255,255,255,.6)';
    X.beginPath();X.arc(sx+w/2+Math.cos(t+i)*15+sr(i*5)*8, sy+h*.3+sr(i*7)*15, 1.5,0,Math.PI*2);X.fill();
  }
  // PoĹ‚ysk wody
  X.fillStyle='rgba(255,255,255,.3)';X.beginPath();X.ellipse(sx+w*.35,sy+h*.55,w*.1,h*.04,0,0,Math.PI*2);X.fill();
}
function drawParkLamp(sx,sy,w,h){
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*.4,sy+h*.3,w*.2,h*.7); // sĹ‚upek
  // GĹ‚Ăłwka lampy
  X.fillStyle='#2a2a2a';X.fillRect(sx+w*.2,sy+h*.15,w*.6,h*.2);
  // Klosz
  const isNight=G.timeOfDay>=2;
  const lg=X.createRadialGradient(sx+w/2,sy+h*.25,1,sx+w/2,sy+h*.25,w*.4);
  if(isNight){lg.addColorStop(0,'rgba(255,230,150,.95)');lg.addColorStop(.6,'rgba(255,200,100,.6)');lg.addColorStop(1,'rgba(255,180,80,.1)');}
  else{lg.addColorStop(0,'rgba(180,180,180,.9)');lg.addColorStop(1,'rgba(120,120,120,.5)');}
  X.fillStyle=lg;X.beginPath();X.ellipse(sx+w/2,sy+h*.25,w*.32,h*.13,0,0,Math.PI*2);X.fill();
  // Aura nocna
  if(isNight){
    const ag=X.createRadialGradient(sx+w/2,sy+h*.25,2,sx+w/2,sy+h*.25,w*1.2);
    ag.addColorStop(0,'rgba(255,220,140,.25)');ag.addColorStop(1,'rgba(255,200,100,0)');
    X.fillStyle=ag;X.beginPath();X.arc(sx+w/2,sy+h*.25,w*1.2,0,Math.PI*2);X.fill();
  }
  // Podstawa
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*.3,sy+h*.95,w*.4,h*.05);
}
function drawParkBush(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.2)';X.beginPath();X.ellipse(sx+w/2,sy+h-3,w*.4,h*.15,0,0,Math.PI*2);X.fill();
  // 3 nakĹ‚adajÄ…ce siÄ™ sfery dla peĹ‚noĹ›ci
  X.fillStyle='#1a5a2a';X.beginPath();X.arc(sx+w*.3,sy+h*.6,w*.28,0,Math.PI*2);X.fill();
  X.fillStyle='#22682a';X.beginPath();X.arc(sx+w*.7,sy+h*.55,w*.3,0,Math.PI*2);X.fill();
  X.fillStyle='#287030';X.beginPath();X.arc(sx+w*.5,sy+h*.4,w*.32,0,Math.PI*2);X.fill();
  // LiĹ›cie (jaĹ›niejsze plamki)
  for(let i=0;i<8;i++){
    X.fillStyle=`rgba(80,180,80,${.3+sr(i)*.3})`;
    X.beginPath();X.arc(sx+sr(i*3)*w,sy+h*.3+sr(i*5)*h*.5,2.5,0,Math.PI*2);X.fill();
  }
  // Akcent â€” kwiaty
  for(let i=0;i<3;i++){
    X.fillStyle=['#e74c3c','#f1c40f','#9b59b6'][i];
    X.beginPath();X.arc(sx+sr(i*7)*w,sy+h*.35+sr(i*5)*h*.3,1.5,0,Math.PI*2);X.fill();
  }
}
function drawParkTrash(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(sx+w/2,sy+h-2,w*.4,h*.06,0,0,Math.PI*2);X.fill();
  // Korpus
  X.fillStyle='#2a4a2a';X.fillRect(sx+w*.15,sy+h*.2,w*.7,h*.75);
  X.fillStyle='#3a6a3a';X.fillRect(sx+w*.18,sy+h*.22,w*.64,h*.05);
  // Pokrywa
  X.fillStyle='#1a3a1a';X.fillRect(sx+w*.1,sy+h*.15,w*.8,h*.08);
  // OtwĂłr
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*.3,sy+h*.27,w*.4,h*.08);
  // Logo "â™»ď¸Ź"
  X.fillStyle='#7ec87e';X.font='bold 8px sans-serif';X.textAlign='center';X.fillText('â™»',sx+w/2,sy+h*.6+3);X.textAlign='left';
}
// â”€â”€ LUXURY OBIEKTY â”€â”€
function drawPool(sx,sy,w,h){
  X.fillStyle='#7a6040';X.fillRect(sx,sy,w,h); // marmurowa krawÄ™dĹş
  X.fillStyle='#5a4030';X.fillRect(sx+8,sy+8,w-16,h-16);
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,'#3aa8e0');g.addColorStop(.5,'#2a8ac0');g.addColorStop(1,'#1a6a90');
  X.fillStyle=g;X.fillRect(sx+14,sy+14,w-28,h-28);
  X.strokeStyle='rgba(255,255,255,.45)';X.lineWidth=1.5;
  for(let i=0;i<3;i++){
    X.beginPath();
    const wy=sy+22+i*((h-44)/3)+Math.sin(anim*0.05+i)*2;
    X.moveTo(sx+18,wy);X.bezierCurveTo(sx+w*.3,wy-3,sx+w*.6,wy+3,sx+w-18,wy);X.stroke();
  }
  X.font='18px Arial';X.textAlign='center';X.fillStyle='rgba(255,255,255,.6)';X.fillText('đźŹŠ',sx+w/2,sy+h/2+6);X.textAlign='left';
}
function drawJacuzzi(sx,sy,w,h){
  X.fillStyle='#3a2010';X.beginPath();X.roundRect(sx,sy,w,h,12);X.fill();
  X.fillStyle='#1a4a6a';X.beginPath();X.roundRect(sx+8,sy+8,w-16,h-16,8);X.fill();
  // BÄ…belki
  for(let i=0;i<6;i++){
    const bx=sx+10+sr(i*3+anim*0.01)*(w-20),by=sy+10+(i*8+anim*0.4)%(h-20);
    X.fillStyle='rgba(255,255,255,.4)';X.beginPath();X.arc(bx,by,2+sr(i)*2,0,Math.PI*2);X.fill();
  }
  X.font='22px Arial';X.textAlign='center';X.fillStyle='rgba(255,200,180,.7)';X.fillText('â™¨ď¸Ź',sx+w/2,sy+h/2+8);X.textAlign='left';
}
function drawSauna(sx,sy,w,h){
  // Korpus z drewna
  X.fillStyle='#5a3818';X.fillRect(sx,sy,w,h);
  for(let i=1;i<6;i++){X.fillStyle='rgba(80,50,20,.6)';X.fillRect(sx,sy+i*(h/6),w,1);}
  // Drzwi
  X.fillStyle='#3a2010';X.fillRect(sx+w*.3,sy+h*.3,w*.4,h*.65);
  X.fillStyle='#7a5828';X.fillRect(sx+w*.3+3,sy+h*.3+3,w*.4-6,h*.4);
  X.fillStyle='rgba(255,200,80,.4)';X.fillRect(sx+w*.32,sy+h*.32,w*.36,h*.18); // okienko
  X.font='20px Arial';X.textAlign='center';X.fillStyle='#fff';X.fillText('đź§–',sx+w/2,sy+24);X.textAlign='left';
}
function drawFirepit(sx,sy,w,h){
  // Kamienna obwĂłdka
  X.fillStyle='#4a4040';X.beginPath();X.ellipse(sx+w/2,sy+h*.7,w*.45,h*.3,0,0,Math.PI*2);X.fill();
  X.fillStyle='#2a2020';X.beginPath();X.ellipse(sx+w/2,sy+h*.7,w*.35,h*.22,0,0,Math.PI*2);X.fill();
  // Drewno
  X.fillStyle='#3a2010';X.fillRect(sx+w*.32,sy+h*.65,w*.36,4);X.fillRect(sx+w*.36,sy+h*.6,w*.28,4);
  // PĹ‚omienie
  const flick=Math.sin(anim*0.2)*4;
  const fg=X.createRadialGradient(sx+w/2,sy+h*.5,2,sx+w/2,sy+h*.5,w*.3);
  fg.addColorStop(0,'rgba(255,240,150,.95)');fg.addColorStop(.4,'rgba(255,140,40,.7)');fg.addColorStop(1,'rgba(180,40,20,0)');
  X.fillStyle=fg;X.beginPath();X.ellipse(sx+w/2,sy+h*.45+flick,w*.25,h*.3,0,0,Math.PI*2);X.fill();
  X.font='18px Arial';X.textAlign='center';X.fillStyle='rgba(255,200,80,.9)';X.fillText('đź”Ą',sx+w/2,sy+h*.4+flick);X.textAlign='left';
}
function drawKitchenIsland(sx,sy,w,h){
  // Korpus szafek
  X.fillStyle='#1a1a1a';X.fillRect(sx,sy+h*.45,w,h*.55);
  // Marmurowy blat
  const g=X.createLinearGradient(sx,sy+h*.45,sx+w,sy+h*.45);
  g.addColorStop(0,'#e8e2d4');g.addColorStop(.5,'#f8f2e4');g.addColorStop(1,'#d8d2c4');
  X.fillStyle=g;X.fillRect(sx,sy+h*.4,w,h*.1);
  // PĹ‚yta indukcyjna
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*.1,sy+h*.42,w*.3,h*.06);
  for(let i=0;i<4;i++){X.fillStyle='#3a2a0a';X.beginPath();X.arc(sx+w*.13+i*(w*.07),sy+h*.45,4,0,Math.PI*2);X.fill();}
  // Zlew
  X.fillStyle='#404040';X.fillRect(sx+w*.55,sy+h*.42,w*.3,h*.06);
  X.fillStyle='#202020';X.fillRect(sx+w*.58,sy+h*.43,w*.24,h*.04);
  // Bar stoolki â€” sygnaĹ‚
  X.fillStyle='#5a3a18';X.fillRect(sx+w*.2,sy+h*.95,8,h*.05);X.fillRect(sx+w*.7,sy+h*.95,8,h*.05);
  X.font='16px Arial';X.textAlign='center';X.fillStyle='#7ec87e';X.fillText('đźŤł',sx+w*.25,sy+h*.4-4);X.textAlign='left';
}
function drawGoldShelf(sx,sy,w,h){
  X.fillStyle='#2a1a0a';X.fillRect(sx,sy,w,h);
  X.strokeStyle='#7a5a20';X.lineWidth=2;X.strokeRect(sx+2,sy+2,w-4,h-4);
  for(let r=0;r<3;r++){
    const ry=sy+8+r*((h-16)/3);
    X.fillStyle='#3a2810';X.fillRect(sx+4,ry+18,w-8,3);
    // ZĹ‚ote/platynowe pĹ‚yty
    for(let i=0;i<3;i++){
      const px=sx+10+i*((w-20)/3);
      const isGold=(r+i)%2===0;
      const gg=X.createRadialGradient(px+10,ry+9,2,px+10,ry+9,11);
      if(isGold){gg.addColorStop(0,'#fff4a0');gg.addColorStop(.6,'#d4a020');gg.addColorStop(1,'#7a5810');}
      else {gg.addColorStop(0,'#f0f0f0');gg.addColorStop(.6,'#a8a8a8');gg.addColorStop(1,'#606060');}
      X.fillStyle=gg;X.beginPath();X.arc(px+10,ry+9,9,0,Math.PI*2);X.fill();
      X.fillStyle='#0a0a0a';X.beginPath();X.arc(px+10,ry+9,2,0,Math.PI*2);X.fill();
    }
  }
  X.font='14px Arial';X.textAlign='center';X.fillStyle='#f1c40f';X.fillText('đźŹ†',sx+w/2,sy-3);X.textAlign='left';
}
function drawAquarium(sx,sy,w,h){
  // Stojak
  X.fillStyle='#2a1a0a';X.fillRect(sx,sy+h*.85,w,h*.15);
  // Szyba
  X.fillStyle='#0a1a2a';X.fillRect(sx+4,sy+h*.05,w-8,h*.8);
  // Woda
  const g=X.createLinearGradient(sx,sy+h*.05,sx,sy+h*.85);
  g.addColorStop(0,'rgba(80,180,220,.4)');g.addColorStop(1,'rgba(20,80,140,.7)');
  X.fillStyle=g;X.fillRect(sx+6,sy+h*.07,w-12,h*.78);
  // RoĹ›linki
  X.fillStyle='#1a6a2a';
  for(let i=0;i<3;i++){const px=sx+12+i*((w-24)/3);X.fillRect(px,sy+h*.65,3,h*.2);X.fillRect(px+3,sy+h*.55,3,h*.3);}
  // Rybki
  for(let i=0;i<3;i++){
    const fx=sx+15+((anim*0.02+i*30)%(w-30));
    const fy=sy+h*.2+Math.sin(anim*0.04+i*2)*8+i*8;
    X.fillStyle=['#f0a020','#f04040','#a0f040'][i];
    X.beginPath();X.ellipse(fx,fy,5,3,0,0,Math.PI*2);X.fill();
    X.fillStyle='rgba(0,0,0,.5)';X.fillRect(fx+3,fy-1,3,2);
  }
  // BÄ…belki
  for(let i=0;i<4;i++){
    X.fillStyle='rgba(255,255,255,.5)';
    X.beginPath();X.arc(sx+w*.85,sy+h*.85-(anim*0.5+i*15)%(h*.7),2,0,Math.PI*2);X.fill();
  }
  // Ramka
  X.strokeStyle='#7a5a20';X.lineWidth=2;X.strokeRect(sx+4,sy+h*.05,w-8,h*.8);
}
function drawTVSet(sx,sy,w,h){
  // Stojak
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*.25,sy+h*.85,w*.5,h*.15);
  X.fillRect(sx+w*.15,sy+h*.95,w*.7,h*.05);
  // Korpus TV
  X.fillStyle='#0a0a0a';X.fillRect(sx,sy,w,h*.85);
  // Ekran
  const tg=X.createLinearGradient(sx+4,sy+4,sx+w-4,sy+h*.78);
  if(G.timeOfDay===3){tg.addColorStop(0,'#000');tg.addColorStop(1,'#0a0a0a');}
  else{tg.addColorStop(0,'#1a3a6a');tg.addColorStop(.5,'#3a5a8a');tg.addColorStop(1,'#0a2040');}
  X.fillStyle=tg;X.fillRect(sx+4,sy+4,w-8,h*.78);
  if(G.timeOfDay<3){
    // TreĹ›Ä‡ â€” pasek "wiadomoĹ›ci"
    X.fillStyle='rgba(200,40,40,.7)';X.fillRect(sx+4,sy+4,w-8,h*.18);
    X.fillStyle='#fff';X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';
    X.fillText('đź“ş 4K LIVE',sx+w/2,sy+h*.14);
    X.fillStyle='rgba(255,255,255,.4)';X.font='10px Arial';X.fillText('TRENDY Â· CHARTS Â· NEWS',sx+w/2,sy+h*.42);
    X.textAlign='left';
  }
}
// â”€â”€ DEKORACJE: APARTAMENT PREMIUM â”€â”€
function drawPremiumDecorations(){
  // v2.1.172: DuĹĽy dywan pod sofÄ… w SALONIE (byĹ‚: 560-880 x 300-470, w garderobie zamiast pod sofÄ…)
  // Salon: 0-560 x 494-864. Sofa: 60-300 x 610-700. Dywan: 30-450 x 580-770 â€” pod i wokĂłĹ‚ sofy.
  const drx=wx2sx(30),dry=wy2sy(580),drw=420,drh=200;
  const drg=X.createLinearGradient(drx,dry,drx+drw,dry+drh);
  drg.addColorStop(0,'rgba(80,60,40,.5)');drg.addColorStop(.5,'rgba(120,90,60,.6)');drg.addColorStop(1,'rgba(80,60,40,.5)');
  X.fillStyle=drg;X.fillRect(drx,dry,drw,drh);
  X.strokeStyle='rgba(200,180,150,.3)';X.lineWidth=2;X.strokeRect(drx+8,dry+8,drw-16,drh-16);
  // Obrazy (galeria 3 ramki)
  for(let i=0;i<3;i++){
    const px=wx2sx(560+i*140),py=wy2sy(54),pw=110,ph=72;
    X.fillStyle='#3a2818';X.fillRect(px,py,pw,ph);
    const cols=['#1a3a5a','#3a1a4a','#1a4a2a'];
    X.fillStyle=cols[i];X.fillRect(px+4,py+4,pw-8,ph-8);
    X.font='28px Arial';X.textAlign='center';X.fillStyle='rgba(255,255,255,.7)';
    X.fillText(['đźŚ†','đźŽ¤','đźŹ†'][i],px+pw/2,py+ph*.65);X.textAlign='left';
  }
  // WiszÄ…ca lampa nad kuchniÄ…
  const lx=wx2sx(530),ly=wy2sy(60),lw=20,lh=80;
  X.fillStyle='#1a1a1a';X.fillRect(lx+lw/2-1,ly,2,lh*.6);
  X.fillStyle='#7a5a20';X.beginPath();X.moveTo(lx,ly+lh*.6);X.lineTo(lx+lw,ly+lh*.6);X.lineTo(lx+lw*.7,ly+lh);X.lineTo(lx+lw*.3,ly+lh);X.closePath();X.fill();
  if(G.timeOfDay>=2){const lg=X.createRadialGradient(lx+lw/2,ly+lh,2,lx+lw/2,ly+lh,40);lg.addColorStop(0,'rgba(255,220,140,.4)');lg.addColorStop(1,'rgba(255,200,100,0)');X.fillStyle=lg;X.beginPath();X.arc(lx+lw/2,ly+lh,40,0,Math.PI*2);X.fill();}
  // v2.1.172: RoĹ›lina ozdobna (monstera) â€” przeniesiona z (1480,380) na (1620,380) by nie nachodziÄ‡ na kitchen_island (1340-1520)
  const px2=wx2sx(1620),py2=wy2sy(380);
  X.fillStyle='#3a2010';X.fillRect(px2,py2+50,40,30);
  X.fillStyle='#1a5a2a';
  for(let i=0;i<5;i++){const lfx=px2+5+i*7,lfy=py2+sr(i*3)*30;X.beginPath();X.ellipse(lfx,lfy,9,16,sr(i)*0.5,0,Math.PI*2);X.fill();}

  // â”€â”€ Barek z butelkami (lewa strona pokoju) â”€â”€
  {
    const bx=wx2sx(80),by=wy2sy(540),bw=120,bh=80;
    // CieĹ„
    X.fillStyle='rgba(0,0,0,.3)';X.fillRect(bx+3,by+78,bw,4);
    // Korpus barku
    X.fillStyle='#3a2410';X.fillRect(bx,by+30,bw,bh-30);
    X.fillStyle='#5a3818';X.fillRect(bx+2,by+32,bw-4,3);
    // Blat
    X.fillStyle='#222';X.fillRect(bx-3,by+25,bw+6,8);
    X.fillStyle='#333';X.fillRect(bx-3,by+25,bw+6,2);
    // PĂłĹ‚ka z butelkami (na Ĺ›cianie nad barkiem)
    X.fillStyle='#2a1810';X.fillRect(bx+5,by-5,bw-10,4);
    // Butelki
    const bottles=[
      ['#704020','#a0633a',8],['#1a3a5a','#2a5a8a',7],['#a02020','#d04040',8],
      ['#2a2a2a','#444',7],['#704020','#9a5a30',7]
    ];
    bottles.forEach(([c1,c2,h],i)=>{
      const bbx=bx+10+i*22, bby=by-5;
      // Korek
      X.fillStyle='#2a1808';X.fillRect(bbx+5,bby-h-3,4,3);
      // Szyjka butelki
      X.fillStyle=c1;X.fillRect(bbx+5,bby-h,4,h-4);
      // Korpus
      X.fillStyle=c1;X.fillRect(bbx+2,bby-4,10,8);
      // Highlight
      X.fillStyle=c2;X.fillRect(bbx+2,bby-3,2,6);
      // Etykieta
      X.fillStyle='#fff';X.fillRect(bbx+4,bby-2,6,4);
    });
    X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('đźŤ¸ MINIBAR',bx+bw/2,by+50);
    X.fillStyle='#c8a520';X.fillText('đźŤ¸ MINIBAR',bx+bw/2,by+50);X.textAlign='left';
  }

  // â”€â”€ Ĺšwiece zapachowe na pĂłĹ‚ce â”€â”€
  {
    const cx=wx2sx(1080),cy=wy2sy(560),cw=130,ch=8;
    // PĂłĹ‚ka
    X.fillStyle='#3a2410';X.fillRect(cx,cy,cw,ch);
    X.fillStyle='#5a3a18';X.fillRect(cx,cy,cw,2);
    // 3 Ĺ›wiece
    [['#f1c40f',12],['#9b59b6',58],['#27ae60',102]].forEach(([col,off])=>{
      // Ĺšwieczka
      X.fillStyle=col;X.fillRect(cx+off,cy-22,16,22);
      X.fillStyle='rgba(255,255,255,.2)';X.fillRect(cx+off+2,cy-20,4,18);
      // Knot
      X.fillStyle='#222';X.fillRect(cx+off+7,cy-26,2,4);
      // PĹ‚omieĹ„ (jeĹ›li wieczĂłr)
      if(G.timeOfDay>=2){
        const fl=Math.sin(anim*0.15)*1;
        X.fillStyle='rgba(255,180,40,.7)';X.beginPath();X.ellipse(cx+off+8,cy-32+fl,2.5,4,0,0,Math.PI*2);X.fill();
        X.fillStyle='rgba(255,240,140,.9)';X.beginPath();X.ellipse(cx+off+8,cy-30+fl,1.5,2,0,0,Math.PI*2);X.fill();
      }
    });
  }
}
// â”€â”€ DEKORACJE: PENTHOUSE LUX â”€â”€
function drawLuxDecorations(){
  // Panorama miasta (caĹ‚a gĂłrna Ĺ›ciana, za "oknami")
  const wx0=wx2sx(0),wy0=wy2sy(0);
  const winY=wy0+30,winH=58;
  // Niebo gradient (kolor zaleĹĽny od pory dnia)
  const skyColors=[['#7ec8e3','#f4a460'],['#5a9ac8','#e8e8f0'],['#3a5080','#e07060'],['#0a0828','#1a1838']];
  const sk=skyColors[G.timeOfDay]||skyColors[1];
  const skg=X.createLinearGradient(wx0,winY,wx0,winY+winH);
  skg.addColorStop(0,sk[0]);skg.addColorStop(1,sk[1]);
  X.fillStyle=skg;X.fillRect(wx0+30,winY,1920-60,winH);
  // Sylwetki budynkĂłw
  X.fillStyle=G.timeOfDay===3?'#000':'rgba(20,20,40,.85)';
  for(let i=0;i<14;i++){
    const bx=wx0+40+i*135,bw=90+sr(i*7)*30,bh=20+sr(i*3)*32;
    X.fillRect(bx,winY+winH-bh,bw,bh);
    if(G.timeOfDay>=2){
      // ĹšwiecÄ…ce okna
      for(let r=0;r<Math.floor(bh/8);r++)for(let c=0;c<Math.floor(bw/8);c++){
        if(sr(i*100+r*10+c)>0.6){X.fillStyle='rgba(255,220,140,.85)';X.fillRect(bx+c*8+2,winY+winH-bh+r*8+2,3,3);X.fillStyle=G.timeOfDay===3?'#000':'rgba(20,20,40,.85)';}
      }
    }
  }
  // Ramy okienne
  X.strokeStyle='#7a5a20';X.lineWidth=3;X.strokeRect(wx0+30,winY,1920-60,winH);
  for(let i=1;i<8;i++){X.beginPath();X.moveTo(wx0+30+i*((1920-60)/8),winY);X.lineTo(wx0+30+i*((1920-60)/8),winY+winH);X.stroke();}
  // v2.1.172: Dywan perski pod sofÄ… w SALONIE (byĹ‚: 640-1020 x 360-560, przenikaĹ‚ Ĺ›ciany do garderoby i biura)
  // Salon: 0-636 x 528-816. Sofa: 120-380 x 600-710. Dywan: 80-460 x 580-770 â€” pod sofÄ… i wokĂłĹ‚.
  const drx=wx2sx(80),dry=wy2sy(580),drw=380,drh=190;
  const drg=X.createLinearGradient(drx,dry,drx+drw,dry+drh);
  drg.addColorStop(0,'rgba(140,30,30,.7)');drg.addColorStop(.5,'rgba(180,50,50,.8)');drg.addColorStop(1,'rgba(140,30,30,.7)');
  X.fillStyle=drg;X.fillRect(drx,dry,drw,drh);
  X.strokeStyle='rgba(220,180,80,.5)';X.lineWidth=2.5;X.strokeRect(drx+10,dry+10,drw-20,drh-20);X.strokeRect(drx+22,dry+22,drw-44,drh-44);
  X.font='30px Arial';X.textAlign='center';X.fillStyle='rgba(220,180,80,.5)';X.fillText('âś¦',drx+drw/2,dry+drh/2+10);X.textAlign='left';
  // Ĺ»yrandol
  const cx=wx2sx(960),cy=wy2sy(54);
  X.fillStyle='#1a1a1a';X.fillRect(cx-1,cy,2,40);
  X.fillStyle='#d4a020';X.beginPath();X.arc(cx,cy+50,25,0,Math.PI*2);X.fill();
  X.fillStyle='#7a5810';X.beginPath();X.arc(cx,cy+50,25,0,Math.PI*2);X.stroke();
  for(let i=0;i<6;i++){const a=(i/6)*Math.PI*2,bx=cx+Math.cos(a)*22,by=cy+50+Math.sin(a)*22;X.fillStyle='rgba(255,240,180,.95)';X.beginPath();X.arc(bx,by,4,0,Math.PI*2);X.fill();}
  if(G.timeOfDay>=2){
    const cg=X.createRadialGradient(cx,cy+50,5,cx,cy+50,150);
    cg.addColorStop(0,'rgba(255,230,160,.25)');cg.addColorStop(1,'rgba(255,200,100,0)');
    X.fillStyle=cg;X.beginPath();X.arc(cx,cy+50,150,0,Math.PI*2);X.fill();
  }
  // Marmurowe schody do sypialni (dekoracja)
  const stx=wx2sx(330),sty=wy2sy(280);
  for(let i=0;i<3;i++){X.fillStyle=`rgba(232,226,212,${0.85-i*0.1})`;X.fillRect(stx,sty+i*8,150-i*30,8);}
  // v2.1.172: RoĹ›linki ozdobne (palmy) â€” palma (1500,540) przeniesiona na (1700,540) by nie nachodziÄ‡ na akwarium (1300-1580 x 600-760)
  for(const[wxp,wyp]of[[1700,540],[40,550]]){
    const px=wx2sx(wxp),py=wy2sy(wyp);
    X.fillStyle='#3a2010';X.fillRect(px,py+50,36,38);
    X.fillStyle='#1a5a2a';
    for(let i=0;i<7;i++){
      const a=(i/7)*Math.PI-Math.PI/2;
      const lx=px+18+Math.cos(a)*30,ly=py+50+Math.sin(a)*30-10;
      X.beginPath();X.ellipse(lx,ly,18,7,a,0,Math.PI*2);X.fill();
    }
  }
}

// â”€â”€ DEKORACJE: STUDIO PROJEKTOWANIA (MERCH) â”€â”€
function drawMerchStudioDecorations(){
  X.shadowBlur=0;X.shadowColor='transparent';

  // â”€â”€ Mood board (tablica trendĂłw) na Ĺ›cianie wschodniej â”€â”€
  {
    const bx=wx2sx(40),by=wy2sy(80),bw=140,bh=70;
    X.fillStyle='rgba(0,0,0,.3)';X.fillRect(bx+3,by+3,bw,bh);
    X.fillStyle='#3a2818';X.fillRect(bx,by,bw,bh);
    X.fillStyle='#1a1208';X.fillRect(bx+3,by+3,bw-6,bh-6);
    // Karteczki przyklejone
    const stickers=[['#e91e8c',0,0],['#3498db',45,5],['#27ae60',90,0],['#f1c40f',15,28],['#9b59b6',60,32],['#e67e22',105,28]];
    stickers.forEach(([c,dx,dy])=>{
      X.fillStyle='rgba(0,0,0,.4)';X.fillRect(bx+8+dx+1,by+8+dy+1,28,20);
      X.fillStyle=c;X.fillRect(bx+8+dx,by+8+dy,28,20);
      // Pinezka
      X.fillStyle='#222';X.beginPath();X.arc(bx+22+dx,by+10+dy,2,0,Math.PI*2);X.fill();
    });
    X.font='bold 9px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('MOOD BOARD',bx+bw/2,by-4);
    X.fillStyle='#f1c40f';X.fillText('MOOD BOARD',bx+bw/2,by-4);X.textAlign='left';
  }

  // â”€â”€ Stojak z ubraniami (rack) â€” Ĺ›rodek â”€â”€
  {
    const rx=wx2sx(420),ry=wy2sy(360),rw=200,rh=100;
    // Stojak (rurka)
    X.fillStyle='#888';X.fillRect(rx,ry,rw,4);
    // Nogi stojaka
    X.fillStyle='#666';X.fillRect(rx+5,ry,4,rh);X.fillRect(rx+rw-9,ry,4,rh);
    // Stopki
    X.fillStyle='#444';X.fillRect(rx,ry+rh,14,4);X.fillRect(rx+rw-14,ry+rh,14,4);
    // Wieszaki + koszulki
    const tshirts=[
      {x:18, col:'#e74c3c'}, {x:48, col:'#27ae60'}, {x:78, col:'#3498db'},
      {x:108, col:'#f1c40f'}, {x:138, col:'#9b59b6'}, {x:168, col:'#1a1a1a'}
    ];
    tshirts.forEach(({x,col})=>{
      // Wieszak (haczyk)
      X.strokeStyle='#999';X.lineWidth=2;X.beginPath();X.moveTo(rx+x+10,ry);X.lineTo(rx+x+10,ry+8);X.stroke();
      X.beginPath();X.arc(rx+x+10,ry+10,3,Math.PI,0);X.stroke();
      // Koszulka â€” tuĹ‚Ăłw + rÄ™kawy (uproszczona sylwetka)
      X.fillStyle=col;
      // RÄ™kawy
      X.beginPath();X.moveTo(rx+x,ry+18);X.lineTo(rx+x+4,ry+34);X.lineTo(rx+x+8,ry+32);X.lineTo(rx+x+8,ry+22);X.closePath();X.fill();
      X.beginPath();X.moveTo(rx+x+20,ry+18);X.lineTo(rx+x+16,ry+22);X.lineTo(rx+x+16,ry+32);X.lineTo(rx+x+20,ry+34);X.closePath();X.fill();
      // TuĹ‚Ăłw
      X.fillRect(rx+x+5,ry+18,16,40);
      // Akcent (logo/grafika)
      X.fillStyle='rgba(255,255,255,.4)';X.fillRect(rx+x+9,ry+30,8,8);
    });
    X.font='bold 10px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('đź§Ą KOLEKCJA',rx+rw/2,ry+rh+22);
    X.fillStyle='#f1c40f';X.fillText('đź§Ą KOLEKCJA',rx+rw/2,ry+rh+22);X.textAlign='left';
  }

  // â”€â”€ Manekin z hoodie (lewy) â”€â”€
  {
    const mx=wx2sx(220),my=wy2sy(360);
    // CieĹ„
    X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(mx+18,my+115,22,7,0,0,Math.PI*2);X.fill();
    // Stojak (cienki sĹ‚upek)
    X.fillStyle='#444';X.fillRect(mx+15,my+90,6,25);
    X.fillStyle='#222';X.fillRect(mx+10,my+112,16,4);
    // Tors manekina
    X.fillStyle='#d8d0c8';
    X.beginPath();X.moveTo(mx+8,my+30);X.lineTo(mx+28,my+30);X.lineTo(mx+30,my+90);X.lineTo(mx+6,my+90);X.closePath();X.fill();
    // Bluza/hoodie
    X.fillStyle='#9b59b6';X.fillRect(mx+4,my+35,28,55);
    // Kaptur
    X.fillStyle='#7a3098';X.beginPath();X.ellipse(mx+18,my+30,18,12,0,0,Math.PI);X.fill();
    // Sznurki kaptura
    X.strokeStyle='#fff';X.lineWidth=1.5;X.beginPath();X.moveTo(mx+14,my+38);X.lineTo(mx+15,my+45);X.stroke();X.beginPath();X.moveTo(mx+22,my+38);X.lineTo(mx+21,my+45);X.stroke();
    // Logo
    X.fillStyle='#f1c40f';X.font='bold 10px "Segoe UI",Arial';X.textAlign='center';X.fillText('TRAP',mx+18,my+62);
    X.fillStyle='#fff';X.font='bold 8px "Segoe UI"';X.fillText('LIFE',mx+18,my+72);
    X.textAlign='left';
  }

  // â”€â”€ Manekin z czapkÄ… (prawy) â”€â”€
  {
    const mx=wx2sx(720),my=wy2sy(360);
    X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(mx+18,my+115,22,7,0,0,Math.PI*2);X.fill();
    X.fillStyle='#444';X.fillRect(mx+15,my+90,6,25);
    X.fillStyle='#222';X.fillRect(mx+10,my+112,16,4);
    X.fillStyle='#d8d0c8';
    X.beginPath();X.moveTo(mx+8,my+30);X.lineTo(mx+28,my+30);X.lineTo(mx+30,my+90);X.lineTo(mx+6,my+90);X.closePath();X.fill();
    // GĹ‚owa (kĂłĹ‚ko)
    X.fillStyle='#d8d0c8';X.beginPath();X.arc(mx+18,my+18,12,0,Math.PI*2);X.fill();
    // Czapka (cap)
    X.fillStyle='#1a1a1a';X.beginPath();X.ellipse(mx+18,my+12,13,5,0,Math.PI,0);X.fill();
    X.fillRect(mx+5,my+10,26,4);
    // Daszek
    X.fillStyle='#0a0a0a';X.fillRect(mx+18,my+14,16,3);
    // Logo na czapce
    X.fillStyle='#e91e8c';X.font='bold 8px "Segoe UI"';X.textAlign='center';X.fillText('M',mx+18,my+10);
    X.textAlign='left';
    // T-shirt
    X.fillStyle='#e74c3c';X.fillRect(mx+4,my+35,28,55);
    X.fillStyle='#fff';X.font='bold 9px "Segoe UI"';X.textAlign='center';X.fillText('TRAPER',mx+18,my+62);
    X.textAlign='left';
  }

  // â”€â”€ StĂłĹ‚ z rolkami tkanin (lewy dolny) â”€â”€
  {
    const tx=wx2sx(80),ty=wy2sy(490);
    X.fillStyle='rgba(0,0,0,.3)';X.fillRect(tx+3,ty+58,120,6);
    // Blat stoĹ‚u
    X.fillStyle='#5a3a18';X.fillRect(tx,ty+50,120,12);
    X.fillStyle='#3a2410';X.fillRect(tx,ty+62,120,4);
    // Nogi
    X.fillStyle='#3a2410';X.fillRect(tx+5,ty+62,4,30);X.fillRect(tx+111,ty+62,4,30);
    // Rolki tkanin
    const rolls=[['#e74c3c',0],['#3498db',32],['#27ae60',64],['#f1c40f',92]];
    rolls.forEach(([c,off])=>{
      // Rolka jako cylinder z boku
      X.fillStyle=c;X.beginPath();X.ellipse(tx+12+off,ty+45,12,6,0,0,Math.PI*2);X.fill();
      X.fillStyle='rgba(0,0,0,.3)';X.fillRect(tx+12+off-12,ty+39,24,6);
      // Ĺšrodek (oĹ› rolki)
      X.fillStyle='#222';X.beginPath();X.arc(tx+12+off,ty+45,3,0,Math.PI*2);X.fill();
    });
    X.font='bold 9px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('đź§µ TKANINY',tx+60,ty+90);
    X.fillStyle='#f1c40f';X.fillText('đź§µ TKANINY',tx+60,ty+90);X.textAlign='left';
  }

  // â”€â”€ Plakat reklamowy (prawa Ĺ›ciana) â”€â”€
  {
    const px=wx2sx(900),py=wy2sy(360),pw=120,ph=170;
    X.fillStyle='rgba(0,0,0,.4)';X.fillRect(px+3,py+3,pw,ph);
    X.fillStyle='#1a0a2a';X.fillRect(px,py,pw,ph);
    X.fillStyle='#3a1a4a';X.fillRect(px+4,py+4,pw-8,ph-8);
    // "PostaÄ‡" na plakacie (sylwetka)
    X.fillStyle='#0a0014';X.fillRect(px+30,py+30,60,80);
    X.fillStyle='#1a0024';X.beginPath();X.arc(px+60,py+25,15,0,Math.PI*2);X.fill();
    // Promienie Ĺ›wietlne
    X.strokeStyle='rgba(241,196,15,.4)';X.lineWidth=1;
    for(let i=0;i<6;i++){
      const a=(i/6)*Math.PI*2-Math.PI/2;
      X.beginPath();X.moveTo(px+60,py+50);X.lineTo(px+60+Math.cos(a)*45,py+50+Math.sin(a)*45);X.stroke();
    }
    // Tekst SUMMER COLLECTION
    X.font='bold 10px "Segoe UI",Arial';X.textAlign='center';X.textBaseline='alphabetic';
    X.fillStyle='#fff';X.fillText('SUMMER',px+pw/2,py+135);
    X.fillStyle='#f1c40f';X.font='bold 12px "Segoe UI",Arial';X.fillText('COLLECTION',px+pw/2,py+150);
    X.fillStyle='#aaa';X.font='8px "Segoe UI",Arial';X.fillText("'26",px+pw/2,py+162);X.textAlign='left';
  }

  // â”€â”€ Maszyna do drukowania (Ĺ›rodek dolny) â”€â”€
  {
    const mx=wx2sx(380),my=wy2sy(490);
    X.fillStyle='rgba(0,0,0,.3)';X.fillRect(mx+3,my+78,150,6);
    // Korpus
    X.fillStyle='#3a3a40';X.fillRect(mx,my+30,150,55);
    X.fillStyle='#4a4a50';X.fillRect(mx+3,my+33,144,4);
    // GĂłrna platforma druku
    X.fillStyle='#1a1a1a';X.fillRect(mx+10,my+20,130,10);
    X.fillStyle='#0a0a0a';X.fillRect(mx+15,my+10,120,10);
    // Ramie drukarki
    X.fillStyle='#666';X.fillRect(mx+70,my,4,20);
    X.fillStyle='#888';X.fillRect(mx+60,my-3,24,8);
    // Lampka kontrolna
    X.fillStyle='#27ae60';X.beginPath();X.arc(mx+140,my+45,3,0,Math.PI*2);X.fill();
    X.fillStyle='rgba(39,174,96,.4)';X.beginPath();X.arc(mx+140,my+45,6,0,Math.PI*2);X.fill();
    // WyĹ›wietlacz
    X.fillStyle='#0a0a0a';X.fillRect(mx+12,my+45,40,18);
    X.fillStyle='#0a0';X.font='bold 9px "Courier New",monospace';X.textAlign='center';
    X.fillText('READY',mx+32,my+57);
    X.font='bold 10px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.strokeText('đź–¨ DRUKARKA',mx+75,my+105);
    X.fillStyle='#f1c40f';X.fillText('đź–¨ DRUKARKA',mx+75,my+105);X.textAlign='left';
  }

  // â”€â”€ Kosz na Ĺ›cinki â”€â”€
  {
    const kx=wx2sx(960),ky=wy2sy(540);
    X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(kx+15,ky+45,18,4,0,0,Math.PI*2);X.fill();
    X.fillStyle='#3a3a3a';X.beginPath();X.moveTo(kx,ky+5);X.lineTo(kx+30,ky+5);X.lineTo(kx+27,ky+42);X.lineTo(kx+3,ky+42);X.closePath();X.fill();
    X.fillStyle='#555';X.fillRect(kx-2,ky,34,6);
    // Ĺšcinki tkanin wystajÄ…ce
    X.fillStyle='#e74c3c';X.fillRect(kx+5,ky+2,3,8);
    X.fillStyle='#3498db';X.fillRect(kx+12,ky-1,3,7);
    X.fillStyle='#27ae60';X.fillRect(kx+19,ky+1,3,9);
  }
}

function drawKebabStand(npcSx,npcSy,npcW,npcH){
  // Budka kebab â€” drewniana z markizÄ…, wiÄ™ksza (#57)
  const sw=160, sh=115;
  const sx=npcSx+npcW/2-sw/2;  // wycentruj wokĂłĹ‚ NPC
  const sy=npcSy-sh+npcH-10;   // budka koĹ„czy siÄ™ przy stopach NPC
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.30)';X.fillRect(sx+6,sy+6,sw,sh);
  // Korpus drewniany
  X.fillStyle='#7a4a18';X.fillRect(sx,sy,sw,sh);
  X.fillStyle='#5a3010';X.fillRect(sx,sy+sh-16,sw,16);  // dolny pas
  // Drewniane deski (linie pionowe)
  X.fillStyle='rgba(0,0,0,.18)';
  for(let i=1;i<6;i++){X.fillRect(sx+i*sw/6,sy+10,1,sh-18);}
  // Markiza w paski czerwono-biaĹ‚e
  const awH=18;
  X.fillStyle='#a01818';X.fillRect(sx-5,sy-awH,sw+10,awH);
  X.fillStyle='#fff';
  for(let i=0;i<7;i++){X.fillRect(sx-5+i*(sw+10)/7+i,sy-awH,(sw+10)/14,awH);}
  X.fillStyle='rgba(0,0,0,.30)';X.fillRect(sx-5,sy-awH+awH-3,sw+10,3);
  // Lada â€” przed NPC, dolne 1/3 budki
  X.fillStyle='#a06030';X.fillRect(sx,sy+sh*0.5,sw,5);
  // Napis "KEBAB"
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 14px "Segoe UI",Arial,sans-serif';X.textAlign='center';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('đźŚŻ KEBAB',sx+sw/2,sy-4);
  X.fillStyle='#ffe080';X.fillText('đźŚŻ KEBAB',sx+sw/2,sy-4);
  X.textAlign='left';
}

function drawNPC(sx,sy,w,h,skin,cloth,em){
  const phase=(sx*0.13+sy*0.07)%6.28;
  const bob=Math.sin(Date.now()*0.0028+phase)*0.6;
  const breath=Math.sin(Date.now()*0.0042+phase)*0.4;
  X.fillStyle='rgba(0,0,0,.22)';X.beginPath();X.ellipse(sx+w/2,sy+h-3,12,4.5,0,0,Math.PI*2);X.fill();
  X.fillStyle='#2a2a3a';X.fillRect(sx+w/2-8,sy+h*.5,7,h*.44);X.fillRect(sx+w/2+1,sy+h*.5,7,h*.44);
  X.fillStyle=cloth;X.fillRect(sx+w/2-10,sy+h*.25+bob*0.3,20,h*.28+breath*0.3);
  X.fillStyle='rgba(0,0,0,.18)';X.fillRect(sx+w/2-10,sy+h*.46+bob*0.3,20,h*.07);
  X.fillStyle=skin;X.fillRect(sx+w/2-14,sy+h*.27+bob*0.2,5,h*.2);X.fillRect(sx+w/2+9,sy+h*.27+bob*0.2,5,h*.2);
  const headX=sx+w/2, headY=sy+h*.16+bob;
  X.fillStyle=skin;X.beginPath();X.arc(headX,headY,11,0,Math.PI*2);X.fill();
  X.fillStyle='rgba(255,255,255,.10)';X.beginPath();X.arc(headX-3,headY-3,4,0,Math.PI*2);X.fill();
  // F+ 2026-05-12 #44: TWARZ â€” oczy + usta (NPC nie wyglÄ…dajÄ… juĹĽ "bez twarzy")
  X.fillStyle='#1a1a1a';
  X.fillRect(headX-4,headY-1,2,2); // lewe oko
  X.fillRect(headX+2,headY-1,2,2); // prawe oko
  // Usta â€” maĹ‚a kreska
  X.strokeStyle='rgba(80,40,30,.7)';X.lineWidth=1;
  X.beginPath();X.moveTo(headX-2,headY+4);X.lineTo(headX+2,headY+4);X.stroke();
  // WĹ‚osy (maĹ‚a czapka koloru ciemniejszego niĹĽ skin)
  X.fillStyle='rgba(40,20,10,.6)';
  X.fillRect(headX-9,headY-9,18,4);
  // Emoji icon above
  X.shadowBlur=0;X.shadowColor='transparent';X.font='18px Arial';X.textAlign='center';X.fillText(em,sx+w/2,sy-4+bob*0.5);X.textAlign='left';
}

function drawBuilding(sx,sy,w,h,col,label,accent,icon,flip=false,opts={}){
  // flip=false: budynki pĂłĹ‚nocne â€” wejĹ›cie od poĹ‚udnia (drzwi na dole sprite'a)
  // flip=true: budynki centralne/poĹ‚udniowe â€” wejĹ›cie od pĂłĹ‚nocy (drzwi na gĂłrze sprite'a)
  // opts.commercial=true â†’ witryna sklepowa zamiast siatki okien mieszkalnych (bug #5)
  // Time-of-day shadow direction: morning=long E, day=direct, evening=long W, night=faint
  const commercial=!!opts.commercial;
  const _bSh=[[12,14,.16],[8,10,.28],[5,10,.20],[3,6,.07]][G.timeOfDay]||[8,10,.28];
  X.fillStyle=`rgba(0,0,0,${_bSh[2]})`;X.fillRect(sx+_bSh[0],sy+_bSh[1],w,h);
  X.fillStyle=col;X.fillRect(sx,sy,w,h);
  // Gradient fasady â€” lekki shimmer od gĂłry do doĹ‚u
  const _fg=X.createLinearGradient(sx,sy,sx,sy+h);
  _fg.addColorStop(0,'rgba(255,255,255,.10)');
  _fg.addColorStop(.35,'rgba(255,255,255,.03)');
  _fg.addColorStop(1,'rgba(0,0,0,.18)');
  X.fillStyle=_fg;X.fillRect(sx,sy,w,h);
  // Boczne Ĺ›wiatĹ‚o
  const _sl=X.createLinearGradient(sx,sy,sx+w,sy);
  _sl.addColorStop(0,'rgba(255,255,255,.06)');
  _sl.addColorStop(.5,'rgba(255,255,255,0)');
  _sl.addColorStop(1,'rgba(0,0,0,.06)');
  X.fillStyle=_sl;X.fillRect(sx,sy,w,h);
  // PodĹ›wietlenie przy wejĹ›ciu
  X.fillStyle=lightenHex(col,15);
  if(!flip){X.fillRect(sx,sy+h*.82,w,h*.18);}  // poĹ‚udnie â€” wejĹ›cie u doĹ‚u
  else{X.fillRect(sx,sy,w,h*.18);}               // pĂłĹ‚noc â€” wejĹ›cie u gĂłry
  X.fillStyle='rgba(0,0,0,.22)';
  if(!flip){X.fillRect(sx,sy+h*.80,w,2);}else{X.fillRect(sx,sy+h*.18,w,2);}
  if(commercial){
    // Sklep komercyjny â€” szeroka witryna sklepowa zamiast siatki okien
    // Witryna: duĹĽy poziomy pas szkĹ‚a z markizÄ… u gĂłry
    const winY = flip ? sy+h*0.62 : sy+h*0.30;
    const winH = Math.max(36, Math.floor(h*0.28));
    const winX = sx+8, winW = w-16;
    // CieĹ„ witryny
    X.fillStyle='rgba(0,0,0,.30)';X.fillRect(winX-1,winY-1,winW+2,winH+2);
    // Szyba â€” gradient niebieski/szary z odbiciem
    const _wlit=G.timeOfDay>=2;
    const wg=X.createLinearGradient(winX,winY,winX,winY+winH);
    if(_wlit){
      wg.addColorStop(0,'rgba(255,225,140,.78)');
      wg.addColorStop(.6,'rgba(220,180,90,.55)');
      wg.addColorStop(1,'rgba(160,120,40,.4)');
    } else {
      wg.addColorStop(0,'rgba(190,225,250,.62)');
      wg.addColorStop(.5,'rgba(140,180,225,.42)');
      wg.addColorStop(1,'rgba(90,130,170,.32)');
    }
    X.fillStyle=wg;X.fillRect(winX,winY,winW,winH);
    // Refleks ukoĹ›ny (top-left)
    X.fillStyle=_wlit?'rgba(255,255,200,.28)':'rgba(255,255,255,.22)';
    X.fillRect(winX+3,winY+3,Math.floor(winW*.35),Math.floor(winH*.30));
    // Pionowe podziaĹ‚y witryny â€” co ~70px
    const divs=Math.max(2,Math.floor(winW/70));
    X.fillStyle='rgba(0,0,0,.42)';
    for(let i=1;i<divs;i++){const _vx=winX+Math.round(winW*i/divs);X.fillRect(_vx-1,winY,2,winH);}
    // Dolna i gĂłrna ramka witryny
    X.fillStyle='rgba(0,0,0,.55)';X.fillRect(winX,winY,winW,2);X.fillRect(winX,winY+winH-2,winW,2);
    // Markiza nad witrynÄ… â€” w kolorze accent (rozpoznawalna)
    const awY=winY-7;
    if(awY>sy+h*0.05){
      X.fillStyle=accent;X.fillRect(winX-3,awY,winW+6,5);
      X.fillStyle='rgba(0,0,0,.30)';X.fillRect(winX-3,awY+5,winW+6,2);
    }
  } else {
    // Bloki mieszkalne â€” siatka okien (traphouse, decorative)
    const _wlit=G.timeOfDay>=2;  // okna Ĺ›wiecÄ… nocÄ…/wieczorem
    const _wCol=_wlit?'rgba(255,230,120,.75)':'rgba(160,200,240,.55)';
    const _wRef=_wlit?'rgba(255,255,200,.4)':'rgba(220,240,255,.4)';
    const _wBord=_wlit?'rgba(255,200,80,.3)':'rgba(100,160,220,.3)';
    const wW=Math.max(14,Math.floor(w*.12)),wH=Math.max(11,Math.floor(h*.13));
    const wRow1Y=sy+Math.round(h*(flip?0.28:0.22)),wRow2Y=sy+Math.round(h*(flip?0.48:0.42));
    const wCols=Math.min(4,Math.floor(w/36));
    const wStep=Math.floor((w-14)/(wCols+0.5));
    const wStartX=sx+Math.round((w-wStep*(wCols-1)-wW)/2);
    for(let _wi=0;_wi<wCols;_wi++){
      const _wx=wStartX+_wi*wStep;
      X.fillStyle='rgba(0,0,0,.25)';X.fillRect(_wx-1,wRow1Y-1,wW+2,wH+2);
      X.fillStyle='rgba(0,0,0,.25)';X.fillRect(_wx-1,wRow2Y-1,wW+2,wH+2);
      X.fillStyle=_wCol;X.fillRect(_wx,wRow1Y,wW,wH);
      X.fillStyle=_wCol;X.fillRect(_wx,wRow2Y,wW,wH);
      X.fillStyle=_wRef;X.fillRect(_wx+1,wRow1Y+1,Math.ceil(wW*.35),Math.ceil(wH*.35));
      X.fillStyle=_wRef;X.fillRect(_wx+1,wRow2Y+1,Math.ceil(wW*.35),Math.ceil(wH*.35));
      X.strokeStyle=_wBord;X.lineWidth=1;
      X.strokeRect(_wx,wRow1Y,wW,wH);X.strokeRect(_wx,wRow2Y,wW,wH);
      X.beginPath();X.moveTo(_wx+Math.ceil(wW/2),wRow1Y);X.lineTo(_wx+Math.ceil(wW/2),wRow1Y+wH);X.stroke();
      X.beginPath();X.moveTo(_wx,wRow1Y+Math.ceil(wH/2));X.lineTo(_wx+wW,wRow1Y+Math.ceil(wH/2));X.stroke();
      X.beginPath();X.moveTo(_wx+Math.ceil(wW/2),wRow2Y);X.lineTo(_wx+Math.ceil(wW/2),wRow2Y+wH);X.stroke();
      X.beginPath();X.moveTo(_wx,wRow2Y+Math.ceil(wH/2));X.lineTo(_wx+wW,wRow2Y+Math.ceil(wH/2));X.stroke();
    }
    // Poziomy pas dekoracyjny miÄ™dzy piÄ™trami
    X.fillStyle='rgba(0,0,0,.14)';X.fillRect(sx,sy+h*.5,w,2);
  }
  // Drzwi
  if(!flip){X.fillStyle='#0a0a0a';X.fillRect(sx+w/2-16,sy+h*.76,32,h*.24);}  // dĂłĹ‚
  else{X.fillStyle='#0a0a0a';X.fillRect(sx+w/2-16,sy,32,h*.24);}              // gĂłra
  // Emoji i nazwa
  // flip=false: wejĹ›cie od poĹ‚udnia â€” icon/label u gĂłry sprite'a (od strony widocznej gdy patrzysz)
  // flip=true: wejĹ›cie od pĂłĹ‚nocy â€” icon u gĂłry (widoczne od strony gracza zbliĹĽajÄ…cego siÄ™ z gĂłry)
  // flip=false: emoji na gĂłrze (sy+40), z dala od drzwi na dole
  // flip=true:  drzwi na gĂłrze (sy do sy+h*0.24), emoji przesuniÄ™te PONIĹ»EJ drzwi
  const _ey=flip?Math.round(sy+h*0.52):sy+40; // baseline Y emoji
  if(icon){
    X.shadowBlur=0;X.shadowColor='transparent';
    X.font='40px Arial';X.textAlign='center';X.fillText(icon,sx+w/2,_ey);
  }
  // Detal dachu â€” antena lub klimatyzator
  const _rt=sr(w*.03+h*.07);
  if(_rt<.4){// Antena
    const _ax=sx+Math.floor(w*.7),_ay=sy;
    X.fillStyle='#555';X.fillRect(_ax,_ay-10,2,10);
    X.fillStyle='#888';X.fillRect(_ax-6,_ay-11,14,2);X.fillRect(_ax-3,_ay-13,8,2);
  } else if(_rt<.7){// Klimatyzator
    X.fillStyle='#444';X.fillRect(sx+Math.floor(w*.1),sy-5,22,7);
    X.fillStyle='#666';X.fillRect(sx+Math.floor(w*.1)+2,sy-3,18,3);
  }
  // Ostre napisy â€” zerowy blur, kontur dla czytelnoĹ›ci
  X.shadowBlur=0;X.shadowColor='transparent';
  X.font='bold 15px "Segoe UI",Arial,sans-serif';
  X.textAlign='center';
  const _ly=icon?(flip?_ey+17:sy+57):sy+22;
  // Neon glow at evening/night
  if(G.timeOfDay>=2){
    const _np=0.55+Math.sin(Date.now()*.0018)*0.18; // pulsing 0.37â€“0.73
    X.shadowColor=accent;X.shadowBlur=10*_np;
    X.fillStyle=accent;X.fillText(label,sx+w/2,_ly);
    X.shadowBlur=18*_np;X.fillText(label,sx+w/2,_ly);
    X.shadowBlur=0;X.shadowColor='transparent';
  }
  X.strokeStyle='rgba(0,0,0,.65)';X.lineWidth=3.5;X.lineJoin='round';
  X.strokeText(label,sx+w/2,_ly);
  X.fillStyle=accent;X.fillText(label,sx+w/2,_ly);
  X.textAlign='left';
}

// â”€â”€ FREESTYLE SPOT â€” znacznik na mapie â”€â”€
function drawFreestyleSpot(sx,sy,w,h){
  // PulsujÄ…ce rĂłĹĽowe kĂłĹ‚ko z emoji đźŽ¤ w Ĺ›rodku + soundwaves wokĂłĹ‚ + glow
  const cx=sx+w/2, cy=sy+h/2;
  const t=Date.now();
  const pulse=0.7+Math.sin(t/400)*0.3;
  // Glow tĹ‚a (radial)
  const gg=X.createRadialGradient(cx,cy,4,cx,cy,w*0.7);
  gg.addColorStop(0,`rgba(233,30,140,${0.45*pulse})`);
  gg.addColorStop(0.5,`rgba(155,89,182,${0.20*pulse})`);
  gg.addColorStop(1,'rgba(233,30,140,0)');
  X.fillStyle=gg;X.beginPath();X.arc(cx,cy,w*0.7,0,Math.PI*2);X.fill();
  // Soundwaves â€” 3 pierĹ›cienie ekspandujÄ…ce
  for(let i=0;i<3;i++){
    const r=w*0.35+(t/100+i*30)%24;
    const alpha=0.4*(1-((t/100+i*30)%24)/24);
    X.strokeStyle=`rgba(241,196,15,${alpha*pulse})`;X.lineWidth=2;
    X.beginPath();X.arc(cx,cy,r,0,Math.PI*2);X.stroke();
  }
  // PulsujÄ…ce rĂłĹĽowe kĂłĹ‚ko zewnÄ™trzne (pĂłĹ‚przezroczyste)
  X.fillStyle=`rgba(233,30,140,${pulse*.4})`;X.beginPath();X.arc(cx,cy,w/2,0,Math.PI*2);X.fill();
  // GĹ‚Ăłwne rĂłĹĽowe kĂłĹ‚ko
  X.fillStyle='#e91e8c';X.beginPath();X.arc(cx,cy,w/3,0,Math.PI*2);X.fill();
  // Subtle inner shadow dla gĹ‚Ä™bi
  X.fillStyle='rgba(160,16,96,.5)';X.beginPath();X.arc(cx,cy,w/3,Math.PI*0.3,Math.PI*0.7);X.fill();
  // Mikrofon emoji w Ĺ›rodku â€” JEDEN (Canvas ignoruje fillStyle dla emoji, wiÄ™c cieĹ„ by zdublowaĹ‚ ikonÄ™).
  // Zamiast tego uĹĽywamy ctx.shadow* przed renderem.
  X.save();
  X.font='bold 22px Arial';X.textAlign='center';X.textBaseline='middle';
  X.shadowColor='rgba(0,0,0,.55)';X.shadowBlur=3;X.shadowOffsetX=1;X.shadowOffsetY=2;
  X.fillText('đźŽ¤',cx,cy+1);
  X.restore();
  // Napis "FREE" nad ikonÄ… â€” maĹ‚y, ostry, ĹĽĂłĹ‚ty z czarnym konturem
  X.font='900 11px "Segoe UI",Arial';X.textAlign='center';X.textBaseline='middle';
  const labelY=sy-6;
  X.lineWidth=3;X.strokeStyle='#000';X.strokeText('FREE',cx,labelY);
  X.fillStyle='#f1c40f';X.fillText('FREE',cx,labelY);
  X.textAlign='left';X.textBaseline='alphabetic';
}

// â”€â”€ DZIELNICA DRIPU â€” luksusowy budynek â”€â”€
function drawLuxuryBuilding(sx,sy,w,h,brand,accentColor,darkFacade=false){
  // Shadow
  X.fillStyle='rgba(0,0,0,.28)';X.fillRect(sx+6,sy+8,w,h);
  // Marble/dark facade
  if(darkFacade){
    const mg=X.createLinearGradient(sx,sy,sx,sy+h);
    mg.addColorStop(0,'#181818');mg.addColorStop(.5,'#0e0e0e');mg.addColorStop(1,'#080808');
    X.fillStyle=mg;
  } else {
    const mg=X.createLinearGradient(sx,sy,sx,sy+h);
    mg.addColorStop(0,'#f2ede8');mg.addColorStop(.4,'#e8e2da');mg.addColorStop(1,'#cec8be');
    X.fillStyle=mg;
  }
  X.fillRect(sx,sy,w,h);
  // Gold border top+bottom
  X.fillStyle='#c8a520';X.fillRect(sx,sy,w,6);
  X.fillStyle='#c8a520';X.fillRect(sx,sy+h-5,w,5);
  // Thin columns
  X.fillStyle='#b8951a';X.fillRect(sx+7,sy+6,4,h-11);X.fillRect(sx+w-11,sy+6,4,h-11);
  // Logo stripe â€” solid band for brand name to sit on
  X.fillStyle=accentColor||'#c8a520';
  X.globalAlpha=darkFacade?0.25:0.12;
  X.fillRect(sx+8,sy+8,w-16,Math.round(h*0.28));
  X.globalAlpha=1;
  // Brand name â€” drawn FIRST, then window below it
  X.shadowBlur=0;
  const fontSize=Math.min(13,Math.max(9,Math.floor(w*0.10)));
  X.font=`bold ${fontSize}px "Segoe UI",Arial,sans-serif`;
  X.textAlign='center';
  const textColor=darkFacade?'#e8d58a':'#6a4a08';
  // Outline for readability
  X.strokeStyle=darkFacade?'rgba(0,0,0,.8)':'rgba(255,255,255,.9)';
  X.lineWidth=2;X.lineJoin='round';
  X.strokeText(brand,sx+w/2,sy+h*0.23);
  X.fillStyle=textColor;
  X.fillText(brand,sx+w/2,sy+h*0.23);
  // Show-window â€” below the name band
  const winy=sy+h*0.33,winh=h*0.32;
  X.fillStyle=darkFacade?'rgba(40,60,80,.7)':'rgba(180,210,240,.45)';
  X.fillRect(sx+12,winy,w-24,winh);
  X.strokeStyle='#c8a520';X.lineWidth=1.5;X.strokeRect(sx+12,winy,w-24,winh);
  // Small interior reflection
  X.fillStyle=darkFacade?'rgba(80,120,160,.15)':'rgba(255,255,255,.25)';
  X.fillRect(sx+15,winy+4,Math.round((w-30)*0.4),winh-8);
  // F+ Punkt #18: 2 manekiny w eleganckich strojach w witrynie
  const _manX1=sx+w*0.28, _manX2=sx+w*0.72, _manY=winy+winh*0.5;
  // Manekin 1 â€” w sukience (czerwony lub czarny zaleĹĽnie od fasady)
  const _dress=darkFacade?'#c8a520':'#c01818';
  X.fillStyle='#f4d4a4';X.beginPath();X.arc(_manX1,_manY-12,3,0,Math.PI*2);X.fill(); // gĹ‚owa
  X.fillStyle=_dress;X.fillRect(_manX1-4,_manY-9,8,6); // tuĹ‚Ăłw (suknia)
  X.beginPath();X.moveTo(_manX1-4,_manY-3);X.lineTo(_manX1+4,_manY-3);
  X.lineTo(_manX1+6,_manY+8);X.lineTo(_manX1-6,_manY+8);X.closePath();X.fill(); // dolna czÄ™Ĺ›Ä‡ sukni (A-line)
  X.fillStyle='#1a1a1a';X.fillRect(_manX1-2,_manY+8,1.5,2);X.fillRect(_manX1+0.5,_manY+8,1.5,2); // buty
  // Manekin 2 â€” w garniturze (granatowy)
  X.fillStyle='#f4d4a4';X.beginPath();X.arc(_manX2,_manY-12,3,0,Math.PI*2);X.fill();
  X.fillStyle='#1a1a3a';X.fillRect(_manX2-4,_manY-9,8,16); // marynarka+spodnie
  X.fillStyle='#c8a520';X.fillRect(_manX2-0.7,_manY-7,1.4,5); // krawat
  X.fillStyle='#1a1a1a';X.fillRect(_manX2-2,_manY+7,1.5,2);X.fillRect(_manX2+0.5,_manY+7,1.5,2);
  // PodĹ›wietlenie spotlight nad manekinami
  X.fillStyle='rgba(255,240,180,.18)';
  X.beginPath();X.moveTo(_manX1,winy);X.lineTo(_manX1-8,_manY-15);X.lineTo(_manX1+8,_manY-15);X.closePath();X.fill();
  X.beginPath();X.moveTo(_manX2,winy);X.lineTo(_manX2-8,_manY-15);X.lineTo(_manX2+8,_manY-15);X.closePath();X.fill();
  // F+ 2026-05-12 #92: hologram DRIP CZYTELNY na kaĹĽdym tle â€” kontrastowy outline + dopasowany kolor
  const _brandEmoji={'LV':'đź‘ś','CHANEL':'đź’„','HERMĂS':'đźŽ','GUCCI':'đź‘‘','BALENCIAGA':'đź•¶ď¸Ź','BOTTEGA':'đź‘›','DIOR':'đźŚą','PRADA':'đź–¤'};
  const _brandIcon=_brandEmoji[brand]||'đź’Ž';
  const _holoT=Date.now()*0.001;
  const _holoBob=Math.sin(_holoT*0.7+sx*0.01)*1.5;
  const _holoY=sy+h*0.88+_holoBob;
  // Beam delikatny gdy noc
  if(G.timeOfDay>=2){
    const beamG=X.createLinearGradient(sx+w/2,_holoY-10,sx+w/2,_holoY+8);
    beamG.addColorStop(0,'rgba(126,200,227,0)');
    beamG.addColorStop(0.5,'rgba(126,200,227,.18)');
    beamG.addColorStop(1,'rgba(126,200,227,0)');
    X.fillStyle=beamG;X.fillRect(sx+w/2-22,_holoY-10,44,18);
  }
  X.font=`bold 12px "Segoe UI",Arial`;X.shadowBlur=0;
  // GRUBY outline kontrastowy ĹĽeby napis byĹ‚ czytelny na DOWOLNYM tle
  X.lineWidth=4;X.lineJoin='round';
  X.strokeStyle=darkFacade?'rgba(0,0,0,.95)':'rgba(255,255,255,.98)';
  X.strokeText(`${_brandIcon} DRIP`,sx+w/2,_holoY);
  // Drugi cieĹ„szy outline kontrastowy (czarny na biaĹ‚ej fasadzie, biaĹ‚y na ciemnej)
  X.lineWidth=1.5;
  X.strokeStyle=darkFacade?'rgba(255,255,255,.9)':'rgba(0,0,0,.9)';
  X.strokeText(`${_brandIcon} DRIP`,sx+w/2,_holoY);
  // Kolor wypeĹ‚nienia â€” dopasowany do tĹ‚a
  if(darkFacade){
    X.shadowColor='#7ec8e3';X.shadowBlur=G.timeOfDay>=2?12:0;
    const _ha=G.timeOfDay>=2?(0.95+Math.sin(_holoT*1.5)*0.05):0.92;
    X.fillStyle=`rgba(200,235,255,${_ha})`;
  } else {
    X.shadowBlur=0;
    X.fillStyle='#0a2540'; // ciemny granat na biaĹ‚ym â€” wysoki kontrast
  }
  X.fillText(`${_brandIcon} DRIP`,sx+w/2,_holoY);
  X.shadowBlur=0;
  // â”€â”€ Neon glow at night â”€â”€
  if(G.timeOfDay>=2){
    const neonAlpha=0.4+Math.sin(Date.now()*.002)*0.15;
    X.shadowColor=accentColor;X.shadowBlur=18*neonAlpha;
    const nf=Math.min(13,Math.max(9,Math.floor(w*0.10)));
    X.font=`bold ${nf}px "Segoe UI",Arial,sans-serif`;
    X.globalAlpha=neonAlpha*0.7;
    X.fillStyle=accentColor;X.fillText(brand,sx+w/2,sy+h*0.23);
    X.globalAlpha=1;X.shadowBlur=0;
  }
  // F+ Punkt #16: Kwiaty w doniczkach przy wejĹ›ciu â€” luxury vibe
  const _flowerPot=(px,py)=>{
    // Doniczka â€” brÄ…zowa terakota z paskiem
    X.fillStyle='#7a4a2a';X.fillRect(px-5,py-2,10,8);
    X.fillStyle='#5a3a1a';X.fillRect(px-5,py+5,10,2);
    X.strokeStyle='rgba(0,0,0,.4)';X.lineWidth=0.5;X.strokeRect(px-5,py-2,10,8);
    // Zielone liĹ›cie (2 kÄ™py)
    X.fillStyle='#2a7a2a';
    X.beginPath();X.arc(px-3,py-3,3,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(px+3,py-3,3,0,Math.PI*2);X.fill();
    // 3 kwiatki rĂłĹĽnokolorowe nad liĹ›Ä‡mi
    X.fillStyle='#e74c3c';X.beginPath();X.arc(px-4,py-6,1.8,0,Math.PI*2);X.fill();
    X.fillStyle='#f1c40f';X.beginPath();X.arc(px,py-8,1.8,0,Math.PI*2);X.fill();
    X.fillStyle='#e91e8c';X.beginPath();X.arc(px+4,py-6,1.8,0,Math.PI*2);X.fill();
    // MaĹ‚y highlight na doniczce (terakota)
    X.fillStyle='rgba(255,200,150,.25)';X.fillRect(px-4,py-1,3,2);
  };
  _flowerPot(sx+18,sy+h-4);     // lewa strona wejĹ›cia
  _flowerPot(sx+w-18,sy+h-4);   // prawa strona wejĹ›cia
  X.textAlign='left';
}

// â”€â”€ DETALE BUDYNKĂ“W â€” unikalne elementy fasady â”€â”€
function drawIKEASign(sx,sy,w,h){
  // Ĺ»ĂłĹ‚ty pas fasady IKEA â€” zakrywa standardowe okna, zawiera peĹ‚ne branding
  const yTop=Math.round(sy+h*.28),yH=Math.round(h*.32);
  X.fillStyle='#FFDA1A';X.fillRect(sx,yTop,w,yH);
  // Emoji krzesĹ‚a na ĹĽĂłĹ‚tym tle
  X.shadowBlur=0;X.font='28px Arial';X.textAlign='center';
  X.fillText('đźŞ‘',sx+w/2,yTop+Math.round(yH*.46));
  // Napis IKEA
  X.font='bold 18px "Segoe UI",Arial,sans-serif';X.fillStyle='#003087';
  X.strokeStyle='rgba(0,0,0,.12)';X.lineWidth=2;
  X.strokeText('IKEA',sx+w/2,yTop+Math.round(yH*.85));
  X.fillText('IKEA',sx+w/2,yTop+Math.round(yH*.85));
  // Niebieski pas graniczny
  X.fillStyle='#003087';X.fillRect(sx,yTop+yH,w,Math.round(h*.04));
  X.textAlign='left';
}
function drawStudioExtras(sx,sy,w,h){
  // ON AIR lampka
  const lx=sx+w*.6,ly=sy+h*.08;
  X.fillStyle='#1a0a2a';X.fillRect(lx,ly,w*.3,h*.08);
  X.fillStyle='#e74c3c';X.beginPath();X.arc(lx+7,ly+h*.04,4,0,Math.PI*2);X.fill();
  X.font='bold 8px "Segoe UI"';X.fillStyle='#ff6060';X.textAlign='left';X.shadowBlur=0;
  X.fillText('ON AIR',lx+14,ly+h*.05);
  // Pianka akustyczna â€” widoczne panele na Ĺ›cianie bocznej
  X.fillStyle='rgba(40,10,40,.5)';
  for(let i=0;i<4;i++)X.fillRect(sx+w*.05+i*(w*.2),sy+h*.3,w*.16,h*.15);
  X.textAlign='left';
}
function drawGymExtras(sx,sy,w,h){
  // DuĹĽe okno z sylwetkÄ… sztangisty
  X.fillStyle='rgba(0,0,0,.3)';X.fillRect(sx+w*.08,sy+h*.35,w*.84,h*.25);
  X.fillStyle='rgba(30,100,200,.15)';X.fillRect(sx+w*.08,sy+h*.35,w*.84,h*.25);
  // Sylwetka Ä‡wiczÄ…cego w oknie
  X.fillStyle='rgba(0,0,0,.4)';
  X.beginPath();X.arc(sx+w*.5,sy+h*.40,6,0,Math.PI*2);X.fill(); // gĹ‚owa
  X.fillRect(sx+w*.46,sy+h*.44,w*.08,h*.1); // tuĹ‚Ăłw
  // Sztanga
  X.fillRect(sx+w*.28,sy+h*.46,w*.44,3);
  // Talerze
  X.beginPath();X.arc(sx+w*.28,sy+h*.46+1,7,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(sx+w*.72,sy+h*.46+1,7,0,Math.PI*2);X.fill();
}
function drawBarberPole(sx,sy,w,h){
  // SĹ‚upek fryzjerski â€” spiralne paski (delikatnie bliĹĽej prawej krawÄ™dzi, nie na oknach)
  const px=sx+w*.94,py=sy+h*.25,ph=h*.45,pr=7;
  X.fillStyle='#f0f0f0';X.fillRect(px-pr,py,pr*2,ph);
  X.fillStyle='#e74c3c';
  for(let i=0;i<4;i++){X.fillRect(px-pr,py+i*(ph/4),pr*2,ph/8);}
  X.fillStyle='#3498db';
  for(let i=0;i<4;i++){X.fillRect(px-pr,py+i*(ph/4)+ph/8,pr*2,ph/8);}
  X.strokeStyle='#ccc';X.lineWidth=1;X.strokeRect(px-pr,py,pr*2,ph);
  // Cap
  X.fillStyle='#888';X.fillRect(px-pr-1,py-5,pr*2+2,5);
}
function drawRestaurantAwning(sx,sy,w,h){
  drawShopAwning(sx,sy,w,h,'#8b2500','#c03020','#7a1e00');
}
// F+ Punkt #15: generic markiza nad wejĹ›ciem sklepu â€” kolorowy trĂłjkÄ…tny dach z paskami i falbankÄ…
function drawShopAwning(sx,sy,w,h,darkC,lightC,shadowC){
  // Pasek gĹ‚Ăłwny (kolor sklepu, ciemniejszy)
  const aH=Math.round(h*.09);
  X.fillStyle=darkC;X.fillRect(sx-4,sy,w+8,aH);
  // Paski pionowe (jaĹ›niejszy kolor)
  X.fillStyle=lightC;
  for(let i=0;i<Math.floor((w+8)/12);i++)X.fillRect(sx-4+i*12,sy,6,aH);
  // Falbanka (pĂłĹ‚kola na dole)
  X.fillStyle=shadowC;
  for(let i=0;i<Math.floor((w+8)/8)+1;i++){
    X.beginPath();X.arc(sx-4+i*8+4,sy+aH,4,0,Math.PI);X.fill();
  }
}
function drawShopAwningMusic(sx,sy,w,h){ drawShopAwning(sx,sy,w,h,'#0a1a3a','#3498db','#0a1530'); }
function drawShopAwningPizzeria(sx,sy,w,h){ drawShopAwning(sx,sy,w,h,'#5a1500','#e67e22','#3a0e00'); }
function drawShopAwningSupermarket(sx,sy,w,h){ drawShopAwning(sx,sy,w,h,'#0a4a0a','#2ecc71','#072c07'); }
function drawShopAwningCarwash(sx,sy,w,h){ drawShopAwning(sx,sy,w,h,'#0a2a5a','#5dade2','#082042'); }
function drawSupermarketWindow(sx,sy,w,h){
  // Witryna w dolnej czÄ™Ĺ›ci budynku â€” poniĹĽej emoji i labela
  const wy=Math.round(sy+h*.65),wh=Math.round(h*.24);
  X.fillStyle='rgba(0,30,60,.4)';X.fillRect(sx+w*.06,wy,w*.88,wh);
  X.fillStyle='rgba(200,230,255,.12)';X.fillRect(sx+w*.06,wy,w*.88,Math.round(wh*.22));
  // Produkty w oknie wystawowym
  const items=['đźĄ›','đźŤž','đźĄ¦'];
  items.forEach((em,i)=>{
    X.font='10px serif';X.textAlign='center';X.shadowBlur=0;
    X.fillText(em,sx+w*.25+i*w*.25,wy+Math.round(wh*.65));
  });
  X.textAlign='left';
}

// â”€â”€ KASYNO â€” neonowa fasada Las Vegas â”€â”€
function drawCasino(sx,sy,w,h){
  X.shadowBlur=0;
  const t=Date.now()/600;
  const isNight=G.timeOfDay>=2;
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.4)';X.fillRect(sx+5,sy+6,w,h);
  // Fasada â€” bordowo-zĹ‚ota
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,'#3a0820');g.addColorStop(.5,'#5a0a30');g.addColorStop(1,'#1a0410');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  // ZĹ‚oty pas dolny (markiza wejĹ›cia)
  X.fillStyle='#c8a520';X.fillRect(sx,sy+h-6,w,6);
  X.fillStyle='#f1c40f';X.fillRect(sx,sy+h-6,w,1.5);
  // MigajÄ…cy neonowy napis CASINO â€” duĹĽe litery
  const blinkOn=Math.sin(t*1.5)>0;
  const neonCol=blinkOn?'#ff2080':'#ffd860';
  if(isNight){X.shadowColor=neonCol;X.shadowBlur=18;}
  X.font='bold 22px "Impact","Segoe UI",Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle=neonCol;X.fillText('CASINO',sx+w/2,sy+h*0.25);
  X.shadowBlur=0;
  // ZĹ‚ote ramki Ĺ›wietlne wokĂłĹ‚ napisu (lampki obwodowe)
  X.fillStyle=blinkOn?'#ffd860':'#5a3a08';
  for(let i=0;i<8;i++){
    const lx=sx+12+i*(w-24)/7;
    X.beginPath();X.arc(lx,sy+8,2.2,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(lx,sy+h-12,2.2,0,Math.PI*2);X.fill();
  }
  // Wielkie ruletkowe koĹ‚o na fasadzie (Ĺ›rodek)
  const rcx=sx+w/2, rcy=sy+h*0.58, rR=Math.min(w,h)*0.22;
  // WirujÄ…ce koĹ‚o â€” segmenty czerwone/czarne na zmianÄ™
  const wheelRot=t*0.4;
  for(let i=0;i<8;i++){
    const a1=wheelRot+i*(Math.PI*2/8), a2=wheelRot+(i+1)*(Math.PI*2/8);
    X.fillStyle=i%2===0?'#c01020':'#101010';
    X.beginPath();X.moveTo(rcx,rcy);X.arc(rcx,rcy,rR,a1,a2);X.closePath();X.fill();
  }
  // ZĹ‚ota ramka koĹ‚a
  X.strokeStyle='#f1c40f';X.lineWidth=3;
  X.beginPath();X.arc(rcx,rcy,rR,0,Math.PI*2);X.stroke();
  X.fillStyle='#c8a520';X.beginPath();X.arc(rcx,rcy,3,0,Math.PI*2);X.fill();
  // Drzwi po lewej i prawej â€” wejĹ›cie (czarne kontury)
  X.fillStyle='#2a0a18';X.fillRect(sx+10,sy+h*0.65,18,h*0.3);
  X.fillRect(sx+w-28,sy+h*0.65,18,h*0.3);
  X.strokeStyle='#f1c40f';X.lineWidth=1.5;
  X.strokeRect(sx+10,sy+h*0.65,18,h*0.3);
  X.strokeRect(sx+w-28,sy+h*0.65,18,h*0.3);
  // Klamki zĹ‚ote
  X.fillStyle='#f1c40f';X.fillRect(sx+24,sy+h*0.8,2,3);X.fillRect(sx+w-14,sy+h*0.8,2,3);
  // đźŽ° emoji nad ruletkÄ…
  X.font='14px Arial';X.textAlign='center';
  X.shadowColor=isNight?'#ffd860':'transparent';X.shadowBlur=isNight?10:0;
  X.fillText('đźŽ°',rcx,sy+h*0.42);
  X.shadowBlur=0;
  X.textAlign='left';X.textBaseline='alphabetic';
}

// Pozycje wszystkich 12 miejsc parkingowych (do auto-pickania pustego dla _carParkedAt).
// Statyczne â€” auta z parkedPos zajmujÄ… slot 0,1,3,4 lewy oraz 0,2,3,5 prawy.
const _PARKING_OCCUPIED_SET=new Set(['L0','L1','L3','L4','R0','R2','R3','R5']);
function _findFreeParkingSpot(parkObj){
  if(!parkObj) return {wx:1500, wy:1620};
  const drivewayW=80;
  const drivewayX=parkObj.wx + Math.round((parkObj.w-drivewayW)/2);
  const leftSpace=drivewayX - parkObj.wx;
  const rightSpace=(parkObj.wx+parkObj.w)-(drivewayX+drivewayW);
  const SPOTS_PER_SIDE=6;
  const lW=leftSpace/SPOTS_PER_SIDE, rW=rightSpace/SPOTS_PER_SIDE;
  const free=[];
  for(let i=0;i<SPOTS_PER_SIDE;i++){
    if(!_PARKING_OCCUPIED_SET.has('L'+i)) free.push({wx: parkObj.wx + i*lW + lW/2, wy: parkObj.wy + parkObj.h/2});
    if(!_PARKING_OCCUPIED_SET.has('R'+i)) free.push({wx: drivewayX+drivewayW + i*rW + rW/2, wy: parkObj.wy + parkObj.h/2});
  }
  return free.length ? free[Math.floor(Math.random()*free.length)] : {wx:parkObj.wx+parkObj.w/2, wy:parkObj.wy+parkObj.h/2};
}

// â”€â”€ PARKING MIEJSKI â€” asfalt z liniami i zaparkowanymi autami â”€â”€
function drawParking(sx,sy,w,h){
  // v1.8.18: REDESIGN parkingu (user feedback po v1.8.15):
  // - Auta rĂłĹĽnej dĹ‚ugoĹ›ci (sedan/hatch/SUV) zamiast wszystkich "limuzyn"
  // - spotW dynamiczny â€” zero dziur na prawej stronie
  // - Wjazd 80px na Ĺ›rodku, wypeĹ‚niony do koĹ„ca parkingu
  // Asfalt
  X.fillStyle='#1a1a1e';X.fillRect(sx,sy,w,h);
  X.fillStyle='#2a2a30';
  for(let i=0;i<60;i++){
    const px=((i*73)%w), py=((i*37)%h);
    X.fillRect(sx+px, sy+py, 2, 1);
  }
  // Wjazd na Ĺ›rodku â€” pas pionowy
  const drivewayW = 80;
  const drivewayX = sx + Math.round((w-drivewayW)/2);
  X.fillStyle='#0a0a0e';X.fillRect(drivewayX, sy, drivewayW, h);
  // PrzejĹ›cie dla pieszych w wjeĹşdzie (biaĹ‚e paski poprzeczne) â€” od strony chodnika
  X.fillStyle='#f0f0f0';
  for(let i=0;i<5;i++){
    X.fillRect(drivewayX+8, sy+h-40+i*7, drivewayW-16, 3);
  }
  // v1.8.36: REWRITE linii â€” parking od krawÄ™dzi do krawÄ™dzi, BEZ luki po prawej.
  // 6 miejsc per strona = 7 linii pionowych (6 miÄ™dzy + 2 zewnÄ™trzne na koĹ„cach).
  // GĂłrna linia rysowana jako 1 ciÄ…gĹ‚y pasek per strona (nie per-spot z lukami).
  const leftSpace = drivewayX - sx;
  const rightStartX = drivewayX + drivewayW;
  const rightSpace = (sx + w) - rightStartX;
  const SPOTS_PER_SIDE = 6;
  const leftSpotW = leftSpace / SPOTS_PER_SIDE;
  const rightSpotW = rightSpace / SPOTS_PER_SIDE;
  X.fillStyle='#f0f0f0';
  // LEWA strona â€” 7 linii pionowych (od sx do drivewayX), jedna peĹ‚na linia gĂłrna
  for(let i=0;i<=SPOTS_PER_SIDE;i++){
    const lineX = Math.round(sx + i*leftSpotW);
    // wewnÄ™trzne linie 2px, krawÄ™dziowe (i=0 i i=6) cofniÄ™te ĹĽeby nie wystawaĹ‚y
    const xPos = (i===0) ? sx : (i===SPOTS_PER_SIDE) ? lineX-2 : lineX;
    X.fillRect(xPos, sy+4, 2, h-8);
  }
  X.fillRect(sx, sy+4, leftSpace, 2); // gĂłrna linia ciÄ…gĹ‚a
  // PRAWA strona â€” analogicznie od rightStartX do sx+w
  for(let i=0;i<=SPOTS_PER_SIDE;i++){
    const lineX = Math.round(rightStartX + i*rightSpotW);
    const xPos = (i===0) ? rightStartX : (i===SPOTS_PER_SIDE) ? lineX-2 : lineX;
    X.fillRect(xPos, sy+4, 2, h-8);
  }
  X.fillRect(rightStartX, sy+4, rightSpace, 2); // gĂłrna linia ciÄ…gĹ‚a
  // Zaparkowane auta â€” RĂ“Ĺ»NE TYPY (sedan/hatch/SUV) zamiast wszystkich limuzyn
  // type: {h: % wysokoĹ›ci miejsca, w: % szerokoĹ›ci}
  const CAR_TYPES=[
    {type:'sedan', hRatio:0.85, wRatio:0.30},  // dĹ‚ugi
    {type:'hatch', hRatio:0.65, wRatio:0.28},  // krĂłtki kompakt
    {type:'suv',   hRatio:0.78, wRatio:0.36},  // szeroki SUV
    {type:'kombi', hRatio:0.92, wRatio:0.30},  // dĹ‚ugi kombi
  ];
  const parkedPos=[
    {side:'L',slot:0,color:'#c01020',type:1},  // hatch czerwony
    {side:'L',slot:1,color:'#2050a0',type:0},  // sedan niebieski
    {side:'L',slot:3,color:'#208040',type:2},  // SUV zielony
    {side:'L',slot:4,color:'#a08020',type:1},  // hatch ĹĽĂłĹ‚ty
    {side:'R',slot:0,color:'#602060',type:3},  // kombi fioletowy
    {side:'R',slot:2,color:'#505050',type:0},  // sedan szary
    {side:'R',slot:3,color:'#f1c40f',type:1},  // hatch ĹĽĂłĹ‚ty
    {side:'R',slot:5,color:'#3a3a3a',type:2},  // SUV grafitowy
  ];
  for(const pc of parkedPos){
    const _spW = pc.side==='L' ? leftSpotW : rightSpotW;
    const baseX = pc.side==='L' ? sx + pc.slot*_spW : rightStartX + pc.slot*_spW;
    const ct = CAR_TYPES[pc.type] || CAR_TYPES[0];
    const carW = Math.round(_spW * ct.wRatio * 2);
    const carH = Math.round((h-12) * ct.hRatio);
    const cx = baseX + (_spW - carW)/2;
    const cy = sy + 6 + ((h-12) - carH)/2;
    // v1.8.41: top-down rendering ulepszony â€” auto wyglÄ…da bardziej trĂłjwymiarowo
    // (gradient karoserii z 2 kierunkĂłw, dach z highlightem, szyby z odbiciem, ostre koĹ‚a).
    // CieĹ„ â€” ellipse pod autem (jak drawCar na ulicy)
    X.fillStyle='rgba(0,0,0,.35)';
    X.beginPath();X.ellipse(cx+carW/2, cy+carH+2, carW*0.45, 3, 0, 0, Math.PI*2);X.fill();
    // Karoseria â€” gradient pionowy (jaĹ›niej na Ĺ›rodku)
    const _cg=X.createLinearGradient(cx, cy, cx, cy+carH);
    _cg.addColorStop(0,lightenHex(pc.color,-10));
    _cg.addColorStop(.5,lightenHex(pc.color,18));
    _cg.addColorStop(1,lightenHex(pc.color,-10));
    X.fillStyle=_cg;X.fillRect(cx, cy, carW, carH);
    // Karoseria â€” gradient boczny (ciemniej na krawÄ™dziach)
    const _sg=X.createLinearGradient(cx, cy, cx+carW, cy);
    _sg.addColorStop(0,'rgba(0,0,0,.22)');_sg.addColorStop(.5,'rgba(0,0,0,0)');_sg.addColorStop(1,'rgba(0,0,0,.22)');
    X.fillStyle=_sg;X.fillRect(cx, cy, carW, carH);
    // Dach z gradientem (Ĺ›rodek jaĹ›niejszy â€” blacha)
    const roofMargin = Math.max(3, Math.floor(carW*0.12));
    const roofTop = cy + Math.floor(carH*0.18);
    const roofBot = cy + Math.floor(carH*0.73);
    const _rg = X.createLinearGradient(cx, roofTop, cx, roofBot);
    _rg.addColorStop(0,lightenHex(pc.color,-15));
    _rg.addColorStop(.5,lightenHex(pc.color,25));
    _rg.addColorStop(1,lightenHex(pc.color,-15));
    X.fillStyle=_rg;X.fillRect(cx+roofMargin, roofTop, carW-roofMargin*2, roofBot-roofTop);
    // Szyba przednia (gĂłra) â€” z odbiciem
    X.fillStyle='#0e2240';
    X.fillRect(cx+roofMargin+1, cy+3, carW-roofMargin*2-2, Math.floor(carH*0.13));
    X.fillStyle='rgba(180,210,240,.30)';
    X.fillRect(cx+roofMargin+2, cy+3, Math.max(3,(carW-roofMargin*2-2)*0.5), 2);
    // Szyba tylna (dĂłĹ‚) â€” z odbiciem
    X.fillStyle='#0a1a30';
    X.fillRect(cx+roofMargin+1, cy+carH-Math.floor(carH*0.13)-3, carW-roofMargin*2-2, Math.floor(carH*0.13));
    // Reflektory biaĹ‚e (przĂłd) i tylne czerwone (tyĹ‚)
    X.fillStyle='#ffe898';X.fillRect(cx+2, cy+1, 4, 2);X.fillRect(cx+carW-6, cy+1, 4, 2);
    X.fillStyle='#c01818';X.fillRect(cx+2, cy+carH-3, 4, 2);X.fillRect(cx+carW-6, cy+carH-3, 4, 2);
    // KoĹ‚a â€” peĹ‚ne ciemne owale (4)
    X.fillStyle='#111';
    [[cx-1, cy+Math.floor(carH*0.22)],[cx+carW+1, cy+Math.floor(carH*0.22)],
     [cx-1, cy+carH-Math.floor(carH*0.22)],[cx+carW+1, cy+carH-Math.floor(carH*0.22)]].forEach(([wx,wy])=>{
      X.beginPath();X.ellipse(wx, wy, 2.2, 4.5, 0, 0, Math.PI*2);X.fill();
      X.fillStyle='#444';X.beginPath();X.ellipse(wx, wy, 1.3, 3, 0, 0, Math.PI*2);X.fill();
      X.fillStyle='#111';
    });
  }
}

// â”€â”€ DUĹ»Y HELIPAD VIP PRZY PENTHOUSE (#86) â”€â”€
function drawPenthouseHelipad(sx,sy,w,h){
  const t=Date.now()/300;
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.4)';X.beginPath();X.ellipse(sx+w/2+3,sy+h/2+3,w*0.5,h*0.5,0,0,Math.PI*2);X.fill();
  // Beton platforma â€” okrÄ…gĹ‚a
  X.fillStyle='#4a4a4e';X.beginPath();X.arc(sx+w/2,sy+h/2,w/2,0,Math.PI*2);X.fill();
  X.fillStyle='#5a5a5e';X.beginPath();X.arc(sx+w/2,sy+h/2,w/2-3,0,Math.PI*2);X.fill();
  // Pas startowy (X krzyĹĽ na Ĺ›rodku)
  X.strokeStyle='#fff';X.lineWidth=2;
  X.beginPath();X.arc(sx+w/2,sy+h/2,w/2-8,0,Math.PI*2);X.stroke();
  // Wielkie H ĹĽĂłĹ‚te na Ĺ›rodku â€” czytelne
  X.fillStyle='#f1c40f';
  X.shadowColor='#000';X.shadowBlur=4;
  X.font='bold 42px "Impact","Arial Black",Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillText('H',sx+w/2,sy+h/2+2);
  X.shadowBlur=0;X.textBaseline='alphabetic';X.textAlign='left';
  // 8 migajÄ…cych lights wokĂłĹ‚ (helipad lights)
  const pulseOn=Math.sin(t*1.2)>0;
  X.fillStyle=pulseOn?'#27ae60':'#0a3a1a';
  for(let i=0;i<8;i++){
    const ang=i*Math.PI/4;
    const lx=sx+w/2+Math.cos(ang)*(w/2-5);
    const ly=sy+h/2+Math.sin(ang)*(h/2-5);
    X.beginPath();X.arc(lx,ly,2.5,0,Math.PI*2);X.fill();
    if(pulseOn){
      X.shadowColor='#27ae60';X.shadowBlur=8;
      X.fillStyle='rgba(39,174,96,.6)';X.beginPath();X.arc(lx,ly,5,0,Math.PI*2);X.fill();
      X.shadowBlur=0;X.fillStyle='#27ae60';
    }
  }
  // Napis "VIP HELIPAD" pod okrÄ™giem
  X.fillStyle='#f1c40f';X.font='bold 9px "Impact",Arial';X.textAlign='center';
  X.fillText('VIP HELIPAD',sx+w/2,sy+h-2);
  X.textAlign='left';
  // F+ 2026-05-12: maĹ‚y helikopter zawiesza siÄ™ nad helipadem (animacja bobbing + rotor)
  const heliY=sy+h/2-22+Math.sin(t*0.4)*2;
  const heliX=sx+w/2;
  // CieĹ„ nad helipadem
  X.fillStyle='rgba(0,0,0,.2)';X.beginPath();X.ellipse(heliX,sy+h/2-4,14,3,0,0,Math.PI*2);X.fill();
  // KadĹ‚ub
  X.fillStyle='#c0392b';X.fillRect(heliX-10,heliY-3,20,8);
  X.fillStyle='#a0291b';X.fillRect(heliX-10,heliY+4,20,2);
  // Kokpit szyba
  X.fillStyle='#7ec8e3';X.fillRect(heliX+5,heliY-2,5,5);
  // Ogon
  X.fillStyle='#c0392b';X.fillRect(heliX-18,heliY+1,8,2);
  X.fillRect(heliX-19,heliY-2,2,5);
  // Wirnik (rotor) â€” krÄ™ci siÄ™ szybko, rysowany jako rozmazana linia
  X.strokeStyle='rgba(50,50,50,.4)';X.lineWidth=1;
  const rotPhase=t*3;
  for(let i=0;i<4;i++){
    const a=rotPhase+i*Math.PI/2;
    X.beginPath();X.moveTo(heliX,heliY-3);X.lineTo(heliX+Math.cos(a)*14,heliY-3+Math.sin(a)*2);X.stroke();
  }
  X.fillStyle='#1a1a1a';X.beginPath();X.arc(heliX,heliY-3,1.5,0,Math.PI*2);X.fill();
  // PĹ‚ozy
  X.fillStyle='#3a3a3a';X.fillRect(heliX-10,heliY+6,20,1);
}

// â”€â”€ ANTENA RADIOWA PRZY HELIPADZIE (#86) â”€â”€
function drawPenthouseAntenna(sx,sy,w,h){
  const t=Date.now()/600;
  // CieĹ„ u podstawy
  X.fillStyle='rgba(0,0,0,.4)';X.beginPath();X.ellipse(sx+w/2,sy+h-2,w*0.8,3,0,0,Math.PI*2);X.fill();
  // Podstawa beton
  X.fillStyle='#4a4a4e';X.fillRect(sx-2,sy+h-8,w+4,8);
  // Maszt
  const stemX=sx+w/2;
  X.fillStyle='#5a5a65';X.fillRect(stemX-2,sy+5,4,h-13);
  X.fillStyle='#7a7a85';X.fillRect(stemX-2,sy+5,1,h-13); // highlight
  // 3 elementy w kierunku gĂłry (jak prawdziwa antena)
  X.fillStyle='#3a3a44';
  X.fillRect(stemX-8,sy+20,16,2);
  X.fillRect(stemX-6,sy+35,12,2);
  X.fillRect(stemX-4,sy+50,8,2);
  // MigajÄ…cy czerwony beacon na szczycie
  const beaconOn=Math.sin(t*2)>0;
  if(beaconOn){
    X.shadowColor='#ff2020';X.shadowBlur=12;
    X.fillStyle='rgba(255,32,32,.7)';X.beginPath();X.arc(stemX,sy+3,6,0,Math.PI*2);X.fill();
    X.shadowBlur=0;
  }
  X.fillStyle=beaconOn?'#ff2020':'#5a1010';X.beginPath();X.arc(stemX,sy+3,3,0,Math.PI*2);X.fill();
}

// â”€â”€ POMNIK HISTORYCZNY W PARKU (#88) â”€â”€
function drawParkMonument(sx,sy,w,h){
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.45)';X.beginPath();X.ellipse(sx+w/2,sy+h-2,w*0.55,5,0,0,Math.PI*2);X.fill();
  // PiedestaĹ‚ granitowy (dĂłĹ‚, szeroki)
  const pedH=h*0.45, pedY=sy+h-pedH;
  X.fillStyle='#6a6a70';X.fillRect(sx-2,pedY,w+4,pedH);
  X.fillStyle='#5a5a60';X.fillRect(sx-2,pedY+pedH-4,w+4,4);
  X.fillStyle='#8a8a90';X.fillRect(sx-2,pedY,w+4,3); // highlight gĂłrny
  // Plakietka brÄ…zowa na piedestale
  X.fillStyle='#8a5a18';X.fillRect(sx+w/2-12,pedY+8,24,12);
  X.strokeStyle='#5a3a08';X.lineWidth=0.8;X.strokeRect(sx+w/2-12,pedY+8,24,12);
  X.fillStyle='#f1c40f';X.font='bold 6px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillText('1923',sx+w/2,pedY+14);
  X.textBaseline='alphabetic';X.textAlign='left';
  // Figura brÄ…zowa z patynÄ… (postaÄ‡ mÄ™ska w klasycznym ubraniu)
  const figH=h*0.55, figY=sy, figW=w*0.55, figX=sx+(w-figW)/2;
  // Nogi
  X.fillStyle='#5a3a08';X.fillRect(figX+figW*0.3,figY+figH*0.65,figW*0.18,figH*0.35);
  X.fillRect(figX+figW*0.55,figY+figH*0.65,figW*0.18,figH*0.35);
  // TuĹ‚Ăłw (pĹ‚aszcz)
  X.fillStyle='#6a4a18';X.beginPath();
  X.moveTo(figX+figW*0.2,figY+figH*0.65);
  X.lineTo(figX+figW*0.25,figY+figH*0.30);
  X.lineTo(figX+figW*0.75,figY+figH*0.30);
  X.lineTo(figX+figW*0.8,figY+figH*0.65);X.closePath();X.fill();
  // Patyna zielonkawa (akcent wieku)
  X.fillStyle='rgba(80,140,100,.35)';X.fillRect(figX+figW*0.2,figY+figH*0.45,figW*0.6,figH*0.10);
  // GĹ‚owa
  X.fillStyle='#5a3a08';X.beginPath();X.arc(figX+figW/2,figY+figH*0.18,figW*0.18,0,Math.PI*2);X.fill();
  X.fillStyle='rgba(80,140,100,.45)';X.beginPath();X.arc(figX+figW/2-2,figY+figH*0.16,figW*0.05,0,Math.PI*2);X.fill();
  // RamiÄ™ w geĹ›cie "ku gĂłrze"
  X.fillStyle='#6a4a18';X.fillRect(figX+figW*0.7,figY+figH*0.20,figW*0.12,figH*0.30);
  X.fillStyle='rgba(80,140,100,.3)';X.fillRect(figX+figW*0.7,figY+figH*0.32,figW*0.12,figH*0.08);
}

// â”€â”€ KASYNO INTERIOR â€” sloty/ruletka/blackjack/krupierzy/kantor (#94) â”€â”€
function drawCasinoSlot(sx,sy,w,h){
  const t=Date.now()/300;
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+4,sy+4,w,h);
  // Obudowa maszyny â€” czerwono-zĹ‚ota
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,'#6a0a18');g.addColorStop(1,'#3a0410');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  // ZĹ‚ota ramka
  X.strokeStyle='#c8a520';X.lineWidth=2;X.strokeRect(sx+1,sy+1,w-2,h-2);
  // Ekran z 3 symbolami â€” animowany
  const screenY=sy+18, screenH=36;
  X.fillStyle='#0a0a0e';X.fillRect(sx+6,screenY,w-12,screenH);
  X.strokeStyle='#f1c40f';X.lineWidth=1;X.strokeRect(sx+6,screenY,w-12,screenH);
  // 3 bÄ™bny z symbolami
  const sw=(w-12)/3;
  const symbols=['đźŤ’','đźŤ‹','đźŤ‡','7ď¸ŹâŁ','đź’Ž'];
  X.font='bold 18px Arial';X.textAlign='center';X.textBaseline='middle';
  for(let i=0;i<3;i++){
    const sym=symbols[Math.floor(t+i*0.7)%symbols.length];
    X.fillText(sym, sx+6+sw*(i+0.5), screenY+screenH/2);
  }
  X.textBaseline='alphabetic';X.textAlign='left';
  // DĹşwignia po prawej
  X.fillStyle='#3a3a40';X.fillRect(sx+w-4,sy+30,3,20);
  X.fillStyle='#c01020';X.beginPath();X.arc(sx+w-2.5,sy+30,4,0,Math.PI*2);X.fill();
  // MigajÄ…cy neon SLOTS na gĂłrze
  const slotsClr=Math.sin(t*0.8)>0?'#f1c40f':'#c8a520';
  X.font='bold 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=2;X.strokeText('SLOTY', sx+w/2, sy+11);
  X.fillStyle=slotsClr;X.fillText('SLOTY', sx+w/2, sy+11);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.0.11: VIP HR Slot â€” premium look z zĹ‚otÄ… koronÄ…, gold gradient body, "VIP" branding */
function drawCasinoVipSlot(sx,sy,w,h){
  const t=Date.now()/300;
  /* cieĹ„ gold glow */
  X.fillStyle='rgba(200,165,32,.4)';X.fillRect(sx+4,sy+4,w,h);
  /* obudowa â€” czarno-zĹ‚oty premium gradient */
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,'#3a2a08');g.addColorStop(0.4,'#1a0a04');g.addColorStop(1,'#0a0204');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  /* podwĂłjna zĹ‚ota ramka */
  X.strokeStyle='#ffd700';X.lineWidth=2.5;X.strokeRect(sx+1,sy+1,w-2,h-2);
  X.strokeStyle='#8a6a08';X.lineWidth=1;X.strokeRect(sx+3,sy+3,w-6,h-6);
  /* korona na gĂłrze */
  X.font='bold 14px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle='#ffd700';
  X.shadowColor='#ffd700';X.shadowBlur=8;
  X.fillText('đź‘‘', sx+w/2, sy+8);
  X.shadowBlur=0;
  /* Ekran z 3 symbolami â€” z gold border */
  const screenY=sy+22, screenH=32;
  X.fillStyle='#0a0204';X.fillRect(sx+6,screenY,w-12,screenH);
  X.strokeStyle='#ffd700';X.lineWidth=1.5;X.strokeRect(sx+6,screenY,w-12,screenH);
  /* inner glow */
  const innerG=X.createLinearGradient(sx+6,screenY,sx+6,screenY+screenH);
  innerG.addColorStop(0,'rgba(255,215,0,.15)');
  innerG.addColorStop(1,'rgba(255,215,0,0)');
  X.fillStyle=innerG;X.fillRect(sx+7,screenY+1,w-14,screenH-2);
  /* 3 bÄ™bny z symbolami */
  const sw=(w-12)/3;
  const symbols=['đźŤ’','đźŤ‹','đźŤ‡','7ď¸ŹâŁ','đź’Ž'];
  X.font='bold 16px Arial';X.textAlign='center';X.textBaseline='middle';
  for(let i=0;i<3;i++){
    const sym=symbols[Math.floor(t+i*0.7)%symbols.length];
    X.fillText(sym, sx+6+sw*(i+0.5), screenY+screenH/2);
  }
  /* DĹşwignia po prawej â€” gold */
  X.fillStyle='#5a4a08';X.fillRect(sx+w-4,sy+34,3,18);
  X.fillStyle='#ffd700';X.beginPath();X.arc(sx+w-2.5,sy+34,4,0,Math.PI*2);X.fill();
  /* "VIP" napis na dole - migajÄ…cy gold */
  const vipClr=Math.sin(t*0.8)>0?'#ffd700':'#c8a520';
  X.font='900 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.shadowColor=vipClr;X.shadowBlur=6;
  X.strokeStyle='#0a0010';X.lineWidth=2.5;X.lineJoin='round';
  X.strokeText('VIP â…', sx+w/2, sy+h-9);
  X.fillStyle=vipClr;X.fillText('VIP â…', sx+w/2, sy+h-9);
  X.shadowBlur=0;
  /* PulsujÄ…ce kropki gold w rogach (premium accent) */
  const pulse=0.5+0.5*Math.sin(t*1.2);
  X.fillStyle=`rgba(255,215,0,${0.4+pulse*0.4})`;
  X.beginPath();X.arc(sx+6,sy+6,1.5,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(sx+w-6,sy+6,1.5,0,Math.PI*2);X.fill();
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.0.21: owalny zielony stĂłĹ‚ (jak prawdziwa ruletka, nie prostokÄ…t) */
function drawCasinoRouletteTable(sx,sy,w,h){
  const ex=sx+w/2, ey=sy+h/2, rw=w/2-3, rh=h/2-3;
  // Owalny cieĹ„
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(ex+4,ey+4,rw,rh,0,0,Math.PI*2);X.fill();
  // Owalny zielony stĂłĹ‚
  X.fillStyle='#0a4a0a';
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.fill();
  // ZĹ‚ota ramka owalna
  X.strokeStyle='#c8a520';X.lineWidth=3;
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.stroke();
  // KoĹ‚o ruletki â€” wirujÄ…ce
  const t=Date.now()/600;
  const cx=sx+w/2, cy=sy+h/2-2, R=Math.min(w,h)*0.32;
  // Drewno wokĂłĹ‚
  X.fillStyle='#5a3a18';X.beginPath();X.arc(cx,cy,R+6,0,Math.PI*2);X.fill();
  X.fillStyle='#7a5028';X.beginPath();X.arc(cx,cy,R+3,0,Math.PI*2);X.fill();
  // 12 segmentĂłw uproszczonych
  for(let i=0;i<12;i++){
    const a1=(i/12)*Math.PI*2+t*0.3;
    const a2=((i+1)/12)*Math.PI*2+t*0.3;
    X.fillStyle = i===0?'#27ae60' : (i%2===1?'#c01020':'#0a0a0a');
    X.beginPath();X.moveTo(cx,cy);X.arc(cx,cy,R,a1,a2);X.closePath();X.fill();
  }
  // Ĺšrodek
  X.fillStyle='#8a6020';X.beginPath();X.arc(cx,cy,R*0.3,0,Math.PI*2);X.fill();
  X.fillStyle='#c8a520';X.font='bold 9px Arial';X.textAlign='center';X.textBaseline='middle';X.fillText('â…',cx,cy);
  X.textBaseline='alphabetic';X.textAlign='left';
  // Napis "RULETKA"
  X.font='bold 14px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.strokeText('RULETKA', sx+w/2, sy+h-9);
  X.fillStyle='#f1c40f';X.fillText('RULETKA', sx+w/2, sy+h-9);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.0.21: owalny zielony stĂłĹ‚ (jak prawdziwy stĂłĹ‚ blackjack, nie prostokÄ…t) */
function drawCasinoBlackjackTable(sx,sy,w,h){
  const ex=sx+w/2, ey=sy+h/2, rw=w/2-3, rh=h/2-3;
  // Owalny cieĹ„
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(ex+4,ey+4,rw,rh,0,0,Math.PI*2);X.fill();
  // Owalny zielony stĂłĹ‚
  X.fillStyle='#0a4a0a';
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=3;
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.stroke();
  // PĂłĹ‚okrÄ…g Ĺ‚uk klienta (w dolnej czÄ™Ĺ›ci owalu)
  X.strokeStyle='rgba(200,165,32,.6)';X.lineWidth=2;
  X.beginPath();X.arc(sx+w/2,sy+h-12,w/2-12,Math.PI*1.2,Math.PI*1.8);X.stroke();
  // 3 zestawy ĹĽetonĂłw (groszki) na stole
  const t=Date.now()/200;
  for(let p=0;p<3;p++){
    const cx=sx+w*(0.25+p*0.25), cy=sy+h*0.35;
    for(let i=0;i<3;i++){
      X.fillStyle=['#c01020','#3498db','#27ae60'][i];
      X.beginPath();X.arc(cx,cy-i*2,4,0,Math.PI*2);X.fill();
      X.strokeStyle='#fff';X.lineWidth=0.6;X.stroke();
    }
  }
  // 2 karty leĹĽÄ… na Ĺ›rodku
  X.fillStyle='#fff';X.fillRect(sx+w/2-14,sy+h/2-6,12,18);X.fillRect(sx+w/2+2,sy+h/2-6,12,18);
  X.strokeStyle='#1a1a1a';X.lineWidth=0.8;X.strokeRect(sx+w/2-14,sy+h/2-6,12,18);X.strokeRect(sx+w/2+2,sy+h/2-6,12,18);
  X.fillStyle='#c01020';X.font='bold 8px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillText('A',sx+w/2-8,sy+h/2+3);X.fillStyle='#1a1a1a';X.fillText('K',sx+w/2+8,sy+h/2+3);
  X.textBaseline='alphabetic';X.textAlign='left';
  // Napis "BLACKJACK"
  X.font='bold 13px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.strokeText('BLACKJACK', sx+w/2, sy+h-9);
  X.fillStyle='#f1c40f';X.fillText('BLACKJACK', sx+w/2, sy+h-9);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.0.21: owalny ciemnoczerwony stĂłĹ‚ WAR */
function drawCasinoWarTable(sx,sy,w,h){
  const ex=sx+w/2, ey=sy+h/2, rw=w/2-3, rh=h/2-3;
  // Owalny cieĹ„
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(ex+4,ey+4,rw,rh,0,0,Math.PI*2);X.fill();
  // Owalny ciemnoczerwony stĂłĹ‚
  X.fillStyle='#3a0a08';
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=3;
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.stroke();
  // Linia Ĺ›rodkowa (granica pojedynku)
  X.strokeStyle='rgba(200,165,32,.5)';X.lineWidth=1.5;X.setLineDash([5,3]);
  X.beginPath();X.moveTo(sx+8,sy+h/2);X.lineTo(sx+w-8,sy+h/2);X.stroke();X.setLineDash([]);
  // 2 karty leĹĽÄ… na stole (gĂłra=krupier, dĂłĹ‚=gracz)
  X.fillStyle='#fff';
  X.fillRect(sx+w/2-7,sy+h*0.18,14,18);
  X.strokeStyle='#1a1a1a';X.lineWidth=0.8;X.strokeRect(sx+w/2-7,sy+h*0.18,14,18);
  X.fillStyle='#c01020';X.font='bold 10px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.fillText('K',sx+w/2,sy+h*0.18+9);
  X.fillStyle='#fff';X.fillRect(sx+w/2-7,sy+h*0.62,14,18);
  X.strokeStyle='#1a1a1a';X.strokeRect(sx+w/2-7,sy+h*0.62,14,18);
  X.fillStyle='#1a1a1a';X.fillText('A',sx+w/2,sy+h*0.62+9);
  X.textBaseline='alphabetic';X.textAlign='left';
  // SkrzyĹĽowane miecze ikona
  const t=Date.now()/400;
  X.save();X.translate(sx+w*0.2,sy+h*0.5);X.rotate(Math.sin(t*0.3)*0.05);
  X.fillStyle='#c8a520';X.font='bold 16px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillText('âš”',0,0);
  X.restore();
  // Napis WAR
  X.font='bold 14px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.strokeText('WAR', sx+w/2, sy+h-9);
  X.fillStyle='#f1c40f';X.fillText('WAR', sx+w/2, sy+h-9);
  X.textAlign='left';X.textBaseline='alphabetic';
}

function drawCasinoCashierObj(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+4,sy+4,w,h);
  // Lada drewniana
  X.fillStyle='#5a3a18';X.fillRect(sx,sy,w,h);
  X.fillStyle='#7a5028';X.fillRect(sx,sy,w,4);
  X.strokeStyle='#3a2410';X.lineWidth=1.5;X.strokeRect(sx+1,sy+1,w-2,h-2);
  // Szyba kantoru
  X.fillStyle='rgba(150,200,230,.35)';X.fillRect(sx+8,sy+12,w-16,h-40);
  X.strokeStyle='#aaa';X.lineWidth=0.8;X.strokeRect(sx+8,sy+12,w-16,h-40);
  // Symbol $ na szybie
  X.fillStyle='#27ae60';X.font='bold 24px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillText('đź’°', sx+w/2, sy+h*0.4);
  X.textBaseline='alphabetic';X.textAlign='left';
  // Napis KANTOR
  X.font='bold 14px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.strokeText('KANTOR', sx+w/2, sy+h-9);
  X.fillStyle='#f1c40f';X.fillText('KANTOR', sx+w/2, sy+h-9);
  X.textAlign='left';X.textBaseline='alphabetic';
}

function drawCasinoBar(sx,sy,w,h){
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+4,sy+4,w,h);
  // Lada bar
  X.fillStyle='#3a1a0a';X.fillRect(sx,sy,w,h);
  X.fillStyle='#5a2a18';X.fillRect(sx,sy,w,6); // gĂłrna krawÄ™dĹş
  X.strokeStyle='#1a0e08';X.lineWidth=1.5;X.strokeRect(sx+1,sy+1,w-2,h-2);
  // PĂłĹ‚ka z butelkami (z tyĹ‚u â€” wyĹĽsza)
  X.fillStyle='#1a0e08';X.fillRect(sx+10,sy+10,w-20,30);
  // Butelki
  const colors=['#c01020','#27ae60','#3498db','#f1c40f','#9b59b6','#e67e22','#8a5a18','#1a1a1a'];
  for(let i=0;i<8;i++){
    const bx=sx+18+i*((w-32)/8);
    X.fillStyle=colors[i];X.fillRect(bx,sy+15,5,20);
    X.fillStyle='#aaa';X.fillRect(bx+1,sy+13,3,3); // korek
  }
  // MaĹ‚a neonowa kreska (BAR)
  const t=Date.now()/600;
  const barClr=Math.sin(t*0.8)>0?'#f1c40f':'#c8a520';
  X.font='bold 16px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.shadowColor=barClr;X.shadowBlur=10;
  X.strokeStyle='#1a0a04';X.lineWidth=3;X.strokeText('BAR',sx+w/2,sy+h*0.78);
  X.fillStyle=barClr;X.fillText('BAR',sx+w/2,sy+h*0.78);
  X.shadowBlur=0;
  X.textBaseline='alphabetic';X.textAlign='left';
}

/* v1.9.95: PLINKO machine â€” pionowy automat z bell-shape board */
/* v2.0.22: bez ramki i drewnianej podstawy, soft rounded board (wolnostojÄ…cy) */
function drawPlinkoMachine(sx,sy,w,h){
  /* owalny cieĹ„ pod boardem */
  X.fillStyle='rgba(0,0,0,.45)';
  X.beginPath();X.ellipse(sx+w/2+2,sy+h-3,w*0.42,h*0.07,0,0,Math.PI*2);X.fill();
  /* board tĹ‚o â€” granatowy gradient z rounded corners + zĹ‚ota ramka */
  const bg=X.createLinearGradient(sx,sy,sx,sy+h);
  bg.addColorStop(0,'#1a2a4a');bg.addColorStop(1,'#0a1525');
  X.fillStyle=bg;
  X.beginPath();
  if(X.roundRect){X.roundRect(sx+2,sy+2,w-4,h-8,10);}
  else X.rect(sx+2,sy+2,w-4,h-8);
  X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=2;X.stroke();
  /* pegs â€” 5 wierszy bell-shape */
  X.fillStyle='#f1c40f';
  for(let row=0;row<5;row++){
    const pegs=row+2;
    const py=sy+10+row*((h-30)/6);
    for(let p=0;p<pegs;p++){
      const px=sx+w/2 - (pegs-1)*7 + p*14;
      X.beginPath();X.arc(px,py,1.5,0,Math.PI*2);X.fill();
    }
  }
  /* spadajÄ…ca kulka (animowana) */
  const t=Date.now()/700;
  const ballY=sy+15+(Math.sin(t)*0.5+0.5)*(h-45);
  const ballX=sx+w/2+Math.sin(t*1.7)*8;
  X.fillStyle='#fff';X.beginPath();X.arc(ballX,ballY,2.5,0,Math.PI*2);X.fill();
  /* slots na dole */
  for(let i=0;i<5;i++){
    const slotX=sx+4+i*(w-8)/5;
    const cols=['#e91e8c','#f1c40f','#7ec87e','#f1c40f','#e91e8c'];
    X.fillStyle=cols[i];X.fillRect(slotX,sy+h-22,(w-8)/5-1,7);
  }
  /* napis "PLINKO" u gĂłry */
  X.font='bold 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=2.5;X.lineJoin='round';
  X.strokeText('PLINKO',sx+w/2,sy+10);
  X.fillStyle='#f1c40f';X.fillText('PLINKO',sx+w/2,sy+10);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.95: WHEEL OF FORTUNE machine â€” kolorowe koĹ‚o na drewnianym stojaku */
/* v2.0.20: wolnostojÄ…ce koĹ‚o â€” bez prostokÄ…tnego korpusu/ramki, tylko koĹ‚o + cieĹ„ + wskaĹşnik + napis */
function drawWheelMachine(sx,sy,w,h){
  const cx=sx+w/2, cy=sy+h*0.42, r=Math.min(w,h)*0.40;
  /* owalny cieĹ„ pod koĹ‚em (eliptyczny, "pĹ‚aski") */
  X.fillStyle='rgba(0,0,0,.45)';
  X.beginPath();X.ellipse(cx+2,cy+r*0.92,r*0.95,r*0.22,0,0,Math.PI*2);X.fill();
  const t=Date.now()/1200;
  X.save();
  X.translate(cx,cy);
  X.rotate(t);
  /* v2.0.24: 16 segmentĂłw (spĂłjne z gameplay openWheel â€” wczeĹ›niej byĹ‚o 8 dekoracyjnych) */
  const COLS=['#c01a1a','#27ae60','#c01a1a','#f1c40f','#c01a1a','#27ae60','#c01a1a','#ffd700','#c01a1a','#27ae60','#c01a1a','#f1c40f','#c01a1a','#27ae60','#c01a1a','#f1c40f'];
  const segA=Math.PI*2/16;
  for(let i=0;i<16;i++){
    const a1=i*segA, a2=(i+1)*segA;
    X.fillStyle=COLS[i];
    X.beginPath();X.moveTo(0,0);X.arc(0,0,r,a1,a2);X.closePath();X.fill();
    X.strokeStyle='#000';X.lineWidth=0.5;X.stroke();
  }
  /* zĹ‚oty rim wokĂłĹ‚ caĹ‚ego koĹ‚a */
  X.strokeStyle='#c8a520';X.lineWidth=2.5;
  X.beginPath();X.arc(0,0,r,0,Math.PI*2);X.stroke();
  /* Ĺ›rodek */
  X.fillStyle='#c8a520';X.beginPath();X.arc(0,0,r*0.18,0,Math.PI*2);X.fill();
  X.strokeStyle='#5a3a08';X.lineWidth=1;X.stroke();
  X.restore();
  /* wskaĹşnik na gĂłrze */
  X.fillStyle='#fff';
  X.beginPath();X.moveTo(cx,cy-r-1);X.lineTo(cx-5,cy-r-9);X.lineTo(cx+5,cy-r-9);X.closePath();X.fill();
  X.strokeStyle='#000';X.lineWidth=1;X.stroke();
  /* napis pod koĹ‚em */
  X.font='bold 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('KOĹO FORTUNY',sx+w/2,sy+h-6);
  X.fillStyle='#f1c40f';X.fillText('KOĹO FORTUNY',sx+w/2,sy+h-6);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.95: KENO board â€” siatka liczb */
/* v2.0.22: bez ramki, soft rounded shape (wolnostojÄ…cy) */
function drawKenoMachine(sx,sy,w,h){
  /* owalny cieĹ„ */
  X.fillStyle='rgba(0,0,0,.45)';
  X.beginPath();X.ellipse(sx+w/2+2,sy+h-3,w*0.42,h*0.07,0,0,Math.PI*2);X.fill();
  /* board tĹ‚o fioletowe z rounded corners + zĹ‚ota ramka */
  X.fillStyle='#5a1a4a';
  X.beginPath();
  if(X.roundRect){X.roundRect(sx+2,sy+2,w-4,h-8,10);}
  else X.rect(sx+2,sy+2,w-4,h-8);
  X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=2;X.stroke();
  /* siatka 6Ă—4 liczb */
  const t=Date.now()/600;
  X.font='bold 7px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  for(let row=0;row<4;row++){
    for(let col=0;col<6;col++){
      const cx=sx+10+col*(w-20)/5, cy=sy+15+row*(h-40)/4;
      const isLit=(((col+row*6+Math.floor(t))%24)<5);
      X.fillStyle=isLit?'#f1c40f':'#1a0a1a';
      X.fillRect(cx-5,cy-4,10,8);
      X.fillStyle=isLit?'#000':'#7a5a7a';
      X.fillText((col+row*6+1).toString(),cx,cy);
    }
  }
  X.font='bold 10px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=2.5;X.lineJoin='round';
  X.strokeText('KENO',sx+w/2,sy+h-9);
  X.fillStyle='#f1c40f';X.fillText('KENO',sx+w/2,sy+h-9);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.95: BACCARAT TABLE â€” owalny zielony stĂłĹ‚ z kartami */
/* v2.0.20: cieĹ„ OWALNY (nie prostokÄ…tny) â€” ĹĽeby nie wystawaĹ‚y czarne rogi spod owalnego stoĹ‚u */
function drawBaccaratTable(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(sx+w/2+4,sy+h/2+4,w/2-3,h/2-3,0,0,Math.PI*2);X.fill();
  /* owalny zielony stĂłĹ‚ */
  X.fillStyle='#1a4a2a';
  X.beginPath();X.ellipse(sx+w/2,sy+h/2,w/2-3,h/2-3,0,0,Math.PI*2);X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=3;X.stroke();
  /* napis PLAYER / BANKER */
  X.font='bold 9px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle='#fff';X.fillText('PLAYER',sx+w*0.3,sy+h*0.4);
  X.fillText('BANKER',sx+w*0.7,sy+h*0.4);
  /* 2 karty na Ĺ›rodku */
  X.fillStyle='#fff';X.fillRect(sx+w*0.42,sy+h*0.55,12,15);
  X.fillRect(sx+w*0.52,sy+h*0.55,12,15);
  X.strokeStyle='#000';X.lineWidth=0.5;
  X.strokeRect(sx+w*0.42,sy+h*0.55,12,15);
  X.strokeRect(sx+w*0.52,sy+h*0.55,12,15);
  X.fillStyle='#c01020';X.font='bold 8px Arial';
  X.fillText('â™Ą',sx+w*0.42+6,sy+h*0.55+8);
  X.fillStyle='#000';X.fillText('â™ ',sx+w*0.52+6,sy+h*0.55+8);
  /* napis BACCARAT */
  X.font='bold 13px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('BACCARAT',sx+w/2,sy+h-10);
  X.fillStyle='#f1c40f';X.fillText('BACCARAT',sx+w/2,sy+h-10);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.95: CRAPS TABLE â€” z 2 kostkami i czerwonym filcem */
/* v2.0.22: owalny stĂłĹ‚ bez ramki + wnÄ™trze zmieszczone w owalu (uproszczone bez numbers grid) */
function drawCrapsTable(sx,sy,w,h){
  const ex=sx+w/2, ey=sy+h/2, rw=w/2-3, rh=h/2-3;
  // Owalny cieĹ„
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(ex+4,ey+4,rw,rh,0,0,Math.PI*2);X.fill();
  // Owalny czerwony stĂłĹ‚
  X.fillStyle='#7a1a1a';
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=3;
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.stroke();
  // Linia podziaĹ‚u stoĹ‚u (subtelna, Ĺ‚ukowa)
  X.strokeStyle='rgba(200,165,32,.35)';X.lineWidth=1;
  X.beginPath();X.ellipse(ex,ey,rw*0.75,rh*0.7,0,0,Math.PI*2);X.stroke();
  // 2 kostki animowane w Ĺ›rodku stoĹ‚u (mieszczÄ… siÄ™ w owalu)
  const t=Date.now()/700;
  const d1=Math.floor((t*0.5)%6)+1;
  const d2=Math.floor((t*0.7)%6)+1;
  const dSize=12;
  const d1x=Math.round(ex-dSize-2), dyTop=Math.round(ey-dSize/2);
  const d2x=Math.round(ex+2);
  X.fillStyle='#fff';
  X.fillRect(d1x,dyTop,dSize,dSize);
  X.fillRect(d2x,dyTop,dSize,dSize);
  X.strokeStyle='#000';X.lineWidth=1;
  X.strokeRect(d1x+.5,dyTop+.5,dSize-1,dSize-1);
  X.strokeRect(d2x+.5,dyTop+.5,dSize-1,dSize-1);
  X.fillStyle='#000';X.font='bold 10px Arial';X.textAlign='center';X.textBaseline='middle';
  X.fillText(d1,d1x+dSize/2,dyTop+dSize/2);
  X.fillText(d2,d2x+dSize/2,dyTop+dSize/2);
  // PASS / DON'T zaznaczone subtelnie (gĂłra/dĂłĹ‚ owalu)
  X.font='bold 8px Arial';X.fillStyle='rgba(255,255,255,.55)';
  X.fillText('PASS',ex,Math.round(ey-rh*0.65));
  X.fillText("DON'T",ex,Math.round(ey+rh*0.65));
  // Napis CRAPS u doĹ‚u (poza owalem ĹĽeby siÄ™ nie nakĹ‚adaĹ‚)
  X.font='bold 12px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  const labelY=Math.round(sy+h-6);
  X.strokeText('CRAPS',Math.round(ex),labelY);
  X.fillStyle='#f1c40f';X.fillText('CRAPS',Math.round(ex),labelY);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.95: POKER TABLE â€” zielony stĂłĹ‚ owalny z 5 kartami */
/* v2.0.20: cieĹ„ OWALNY (nie prostokÄ…tny) */
/* v2.1.188: Ride the Bus â€” spĂłjny styl z innymi VIP stoĹ‚ami (owalny + zĹ‚ote obramowanie + dyskretny detail).
   Granatowy stĂłĹ‚ jak Poker, maĹ‚y autobus + 4 karty w Ĺ‚uku, ĹĽĂłĹ‚ty napis z czarnym obrysem. */
function drawRideBusTable(sx,sy,w,h){
  const ex=sx+w/2, ey=sy+h/2, rw=w/2-3, rh=h/2-3;
  /* Owalny cieĹ„ */
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(ex+4,ey+4,rw,rh,0,0,Math.PI*2);X.fill();
  /* Owalny granatowy stĂłĹ‚ */
  X.fillStyle='#1a2a4a';
  X.beginPath();X.ellipse(ex,ey,rw,rh,0,0,Math.PI*2);X.fill();
  /* ZĹ‚ote obramowanie */
  X.strokeStyle='#c8a520';X.lineWidth=3;X.stroke();
  /* WewnÄ™trzny pierĹ›cieĹ„ subtelny â€” jak inne VIP stoĹ‚y */
  X.strokeStyle='rgba(200,165,32,.35)';X.lineWidth=1;
  X.beginPath();X.ellipse(ex,ey,rw*0.78,rh*0.72,0,0,Math.PI*2);X.stroke();
  /* MaĹ‚y autobus â€” ĹĽĂłĹ‚ta sylwetka w gĂłrnej poĹ‚owie stoĹ‚u */
  const busW=22, busH=10;
  const busX=ex-busW/2, busY=ey-rh*0.42;
  X.fillStyle='#c8a520';
  X.fillRect(busX,busY,busW,busH);
  X.strokeStyle='#8a6e10';X.lineWidth=0.8;X.strokeRect(busX+.5,busY+.5,busW-1,busH-1);
  /* 3 mini-okienka autobusu */
  X.fillStyle='#7ec8e3';
  for(let i=0;i<3;i++){
    X.fillRect(busX+2+i*(busW-4)/3, busY+1.5, (busW-4)/3-1, busH*0.45);
  }
  /* KĂłĹ‚ka autobusu */
  X.fillStyle='#1a1a1a';
  X.beginPath();X.arc(busX+busW*0.22,busY+busH+1,1.6,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(busX+busW*0.78,busY+busH+1,1.6,0,Math.PI*2);X.fill();
  /* 4 karty w Ĺ‚uku pod autobusem (jak w pokerze) */
  for(let i=0;i<4;i++){
    const a=(i-1.5)*0.16;
    const cx=ex + Math.sin(a)*26 - 6;
    const cy=ey + h*0.05 - Math.cos(a)*4;
    X.save();
    X.translate(cx+6, cy+8);
    X.rotate(a*0.55);
    X.fillStyle='#fff';X.fillRect(-6,-8,12,16);
    X.strokeStyle='#000';X.lineWidth=0.5;X.strokeRect(-6,-8,12,16);
    const suits=['â™ ','â™Ą','â™¦','â™Ł'];
    const colors=['#000','#c01020','#c01020','#000'];
    X.fillStyle=colors[i];
    X.font='bold 8px Arial';X.textAlign='center';X.textBaseline='middle';
    X.fillText(suits[i],0,0);
    X.restore();
  }
  /* Subtelny stosik ĹĽetonĂłw po lewej (jak Poker) */
  for(let i=0;i<3;i++){
    X.fillStyle=['#c01020','#3060c0','#27ae60'][i];
    X.beginPath();X.arc(sx+w*0.18+i*2.5,sy+h*0.55-i*2,4.5,0,Math.PI*2);X.fill();
    X.strokeStyle='#000';X.lineWidth=0.5;X.stroke();
  }
  /* Napis RIDE THE BUS â€” ĹĽĂłĹ‚ty z czarnym obrysem (jak Poker/Baccarat/Craps) */
  X.font='bold 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('đźšŚ RIDE THE BUS',ex,sy+h-10);
  X.fillStyle='#f1c40f';X.fillText('đźšŚ RIDE THE BUS',ex,sy+h-10);
  X.textAlign='left';X.textBaseline='alphabetic';
}
function drawPokerTable(sx,sy,w,h){
  X.fillStyle='rgba(0,0,0,.5)';
  X.beginPath();X.ellipse(sx+w/2+4,sy+h/2+4,w/2-3,h/2-3,0,0,Math.PI*2);X.fill();
  X.fillStyle='#0a3a1a';
  X.beginPath();X.ellipse(sx+w/2,sy+h/2,w/2-3,h/2-3,0,0,Math.PI*2);X.fill();
  X.strokeStyle='#c8a520';X.lineWidth=3;X.stroke();
  /* 5 kart w Ĺ‚uku */
  for(let i=0;i<5;i++){
    const a=(i-2)*0.18;
    const cx=sx+w/2 + Math.sin(a)*30 - 6;
    const cy=sy+h*0.55 - Math.cos(a)*5;
    X.save();
    X.translate(cx+6,cy+8);
    X.rotate(a*0.5);
    X.fillStyle='#fff';X.fillRect(-6,-8,12,16);
    X.strokeStyle='#000';X.lineWidth=0.5;X.strokeRect(-6,-8,12,16);
    X.fillStyle=i%2===0?'#c01020':'#000';
    X.font='bold 8px Arial';X.textAlign='center';X.textBaseline='middle';
    X.fillText(['â™ ','â™Ą','â™¦','â™Ł','â™ '][i],0,0);
    X.restore();
  }
  /* chips stack */
  for(let i=0;i<3;i++){
    X.fillStyle=['#c01020','#3060c0','#27ae60'][i];
    X.beginPath();X.arc(sx+w*0.2+i*3,sy+h*0.4-i*2,5,0,Math.PI*2);X.fill();
    X.strokeStyle='#000';X.lineWidth=0.5;X.stroke();
  }
  /* napis */
  X.font='bold 12px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('POKER',sx+w/2,sy+h-10);
  X.fillStyle='#f1c40f';X.fillText('POKER',sx+w/2,sy+h-10);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.91: Uniwersalny "automat kasynowy" â€” kolorowa szafka z emoji + napisem (plinko/keno/koĹ‚o/baccarat/craps) */
function drawCasinoMachine(sx,sy,w,h,emoji,label,color){
  /* cieĹ„ */
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+4,sy+4,w,h);
  /* korpus szafki â€” pionowy gradient */
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,_lightenHex(color,30));
  g.addColorStop(0.5,color);
  g.addColorStop(1,_lightenHex(color,-25));
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  /* zĹ‚ota ramka */
  X.strokeStyle='#c8a520';X.lineWidth=2;X.strokeRect(sx+2,sy+2,w-4,h-4);
  /* ekran (display) â€” czarny prostokÄ…t z emoji */
  const sw=w*0.7, sh=h*0.45, dx=sx+(w-sw)/2, dy=sy+10;
  X.fillStyle='#0a0a14';X.fillRect(dx,dy,sw,sh);
  X.strokeStyle='#3a3a4a';X.lineWidth=1;X.strokeRect(dx+.5,dy+.5,sw-1,sh-1);
  /* inner glow */
  const t=Date.now()/500;
  const pulse=0.5+0.5*Math.sin(t);
  X.fillStyle=`rgba(248,224,112,${0.08+pulse*0.06})`;X.fillRect(dx+1,dy+1,sw-2,sh-2);
  /* emoji w Ĺ›rodku */
  X.font=`${Math.round(sh*0.65)}px serif`;X.textAlign='center';X.textBaseline='middle';
  X.fillText(emoji, dx+sw/2, dy+sh/2);
  /* napis u doĹ‚u â€” outline+fill */
  X.font='bold 13px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText(label, sx+w/2, sy+h-12);
  X.fillStyle='#f1c40f';X.fillText(label, sx+w/2, sy+h-12);
  /* dolny pulsujÄ…cy pasek LED */
  X.fillStyle=`rgba(241,196,15,${0.4+pulse*0.4})`;
  X.fillRect(sx+w*0.15, sy+h-4, w*0.7, 2);
  X.textAlign='left';X.textBaseline='alphabetic';
}

function _lightenHex(hex,amt){
  /* pomocnicza â€” przesuwa skĹ‚adowe RGB o amt */
  const n=parseInt(hex.slice(1),16);
  let r=((n>>16)&255)+amt, gn=((n>>8)&255)+amt, b=(n&255)+amt;
  r=Math.max(0,Math.min(255,r));gn=Math.max(0,Math.min(255,gn));b=Math.max(0,Math.min(255,b));
  return '#'+((1<<24)+(r<<16)+(gn<<8)+b).toString(16).slice(1);
}

/* v1.9.93: Daily Wheel of Fortune â€” kolorowe koĹ‚o z animacjÄ… obrotu + banner FREE/COOLDOWN */
/* v2.0.20: wolnostojÄ…ce koĹ‚o â€” bez prostokÄ…tnego korpusu/ramki, tylko koĹ‚o + cieĹ„ + napis */
function drawDailyWheel(sx,sy,w,h,isVip){
  /* SprawdĹş dostÄ™pnoĹ›Ä‡ */
  const lastSpin=(isVip?G._lastVipDailyWheel:G._lastDailyWheel)||-1;
  const available=lastSpin!==G.day;
  const cx=sx+w/2, cy=sy+h*0.42, r=Math.min(w,h)*0.40;
  /* owalny cieĹ„ pod koĹ‚em */
  X.fillStyle='rgba(0,0,0,.45)';
  X.beginPath();X.ellipse(cx+2,cy+r*0.92,r*0.95,r*0.22,0,0,Math.PI*2);X.fill();
  /* PulsujÄ…cy glow gdy available â€” okrÄ…gĹ‚y wokĂłĹ‚ koĹ‚a (nie prostokÄ…tny) */
  const t=Date.now()/700;
  if(available){
    const pulse=0.5+0.5*Math.sin(t*1.5);
    X.shadowColor=isVip?'#ff80c0':'#27ae60';X.shadowBlur=10+pulse*10;
    X.strokeStyle=`rgba(${isVip?'255,160,224':'126,255,144'},${0.5+pulse*0.4})`;X.lineWidth=2;
    X.beginPath();X.arc(cx,cy,r+3,0,Math.PI*2);X.stroke();
    X.shadowBlur=0;
  }
  /* Auto-spin gdy available (slow rotation), stop gdy used */
  const rotation = available ? (t*0.8) : (Math.PI*0.25);
  X.save();
  X.translate(cx,cy);
  X.rotate(rotation);
  /* 8 segmentĂłw koĹ‚a z rĂłĹĽnymi kolorami */
  const segColors=['#e74c3c','#f1c40f','#27ae60','#3498db','#9b59b6','#e67e22','#1abc9c','#f06292'];
  for(let i=0;i<8;i++){
    const a1=i*Math.PI/4;
    const a2=(i+1)*Math.PI/4;
    X.fillStyle=available?segColors[i]:_lightenHex(segColors[i],-50);
    X.beginPath();X.moveTo(0,0);X.arc(0,0,r,a1,a2);X.closePath();X.fill();
    X.strokeStyle='#000';X.lineWidth=0.8;X.stroke();
  }
  /* zĹ‚oty rim */
  X.strokeStyle='#c8a520';X.lineWidth=2.5;
  X.beginPath();X.arc(0,0,r,0,Math.PI*2);X.stroke();
  /* Ĺšrodek koĹ‚a â€” pin */
  X.fillStyle='#c8a520';X.beginPath();X.arc(0,0,r*0.18,0,Math.PI*2);X.fill();
  X.strokeStyle='#5a3a08';X.lineWidth=1;X.stroke();
  X.restore();
  /* WskaĹşnik (trĂłjkÄ…t) na gĂłrze koĹ‚a */
  X.fillStyle=available?'#fff':'#888';
  X.beginPath();
  X.moveTo(cx,cy-r-1);X.lineTo(cx-5,cy-r-9);X.lineTo(cx+5,cy-r-9);X.closePath();
  X.fill();X.strokeStyle='#000';X.lineWidth=1;X.stroke();
  /* Napis pod koĹ‚em â€” bez prostokÄ…tnego bannera, tylko tekst z outline */
  X.font='bold 10px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  const labelText = available?(isVip?'â… VIP FREE SPIN â…':'â… FREE SPIN â…'):'WRĂ“Ä† JUTRO';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText(labelText, cx, sy+h-6);
  X.fillStyle=available?(isVip?'#ff80c0':'#7eff90'):'#aa5a5a';
  X.fillText(labelText, cx, sy+h-6);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.91: Drzwi windy w kasynie â€” metalowe srebrne z zĹ‚otym akcentem */
function drawElevatorDoor(sx,sy,w,h){
  /* cieĹ„ */
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+4,sy+4,w,h);
  /* metal â€” pionowy gradient */
  const g=X.createLinearGradient(sx,sy,sx+w,sy);
  g.addColorStop(0,'#3a3a44');g.addColorStop(0.4,'#7a7a88');g.addColorStop(0.5,'#a8a8b8');g.addColorStop(0.6,'#7a7a88');g.addColorStop(1,'#3a3a44');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  /* zĹ‚ote obramowanie */
  X.strokeStyle='#c8a520';X.lineWidth=2;X.strokeRect(sx+2,sy+2,w-4,h-4);
  /* linia Ĺ›rodkowa (rozdzielenie drzwi) */
  X.fillStyle='#1a1a1a';X.fillRect(sx+w/2-0.5,sy+4,1,h-8);
  /* przycisk wezwania (po prawej) */
  X.fillStyle='#0a0a0a';X.fillRect(sx+w-12,sy+h/2-6,8,12);
  const t=Date.now()/600;
  X.fillStyle=Math.sin(t*0.8)>0?'#27ae60':'#f1c40f';
  X.beginPath();X.arc(sx+w-8,sy+h/2,2.5,0,Math.PI*2);X.fill();
  /* strzaĹ‚ka â†• na drzwiach */
  X.fillStyle='#c8a520';X.font='bold 14px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.fillText('â–˛', sx+w/2, sy+h*0.35);
  X.fillText('â–Ľ', sx+w/2, sy+h*0.55);
  /* napis WINDA */
  X.font='bold 12px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('WINDA', sx+w/2, sy+h-10);
  X.fillStyle='#f1c40f';X.fillText('WINDA', sx+w/2, sy+h-10);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v1.9.91: Przycisk w windzie â€” okrÄ…gĹ‚y z emoji + napis */
function drawElevatorButton(sx,sy,w,h,emoji,label,color){
  /* cieĹ„ */
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+3,sy+3,w,h);
  /* czarne tĹ‚o tabliczki */
  X.fillStyle='#1a1a22';X.fillRect(sx,sy,w,h);
  X.strokeStyle=color;X.lineWidth=2;X.strokeRect(sx+1,sy+1,w-2,h-2);
  /* okrÄ…gĹ‚y guzik */
  const cx=sx+w/2, cy=sy+h*0.4, r=w*0.32;
  const t=Date.now()/700;
  const pulse=0.5+0.5*Math.sin(t);
  X.shadowColor=color;X.shadowBlur=8+pulse*8;
  const bg=X.createRadialGradient(cx,cy-r*0.2,1,cx,cy,r);
  bg.addColorStop(0,_lightenHex(color,40));
  bg.addColorStop(1,_lightenHex(color,-20));
  X.fillStyle=bg;X.beginPath();X.arc(cx,cy,r,0,Math.PI*2);X.fill();
  X.shadowBlur=0;
  X.strokeStyle='#0a0a14';X.lineWidth=1.5;X.beginPath();X.arc(cx,cy,r,0,Math.PI*2);X.stroke();
  /* emoji na guziku */
  X.font=`${Math.round(r*1.1)}px serif`;X.textAlign='center';X.textBaseline='middle';
  X.fillText(emoji, cx, cy);
  /* v2.0.21: napis u doĹ‚u â€” Math.round pozycji + cieĹ„szy stroke (anti-blur dla maĹ‚ych fontĂłw) */
  X.font='bold 12px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=2;X.lineJoin='round';X.miterLimit=2;
  const lx=Math.round(sx+w/2), ly=Math.round(sy+h-11);
  X.strokeText(label, lx, ly);
  X.fillStyle=color;X.fillText(label, lx, ly);
  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.0.0: VIP button z paskiem postÄ™pu wygranych. Gdy 10000+ ĹĽetonĂłw wygranych â€” odblokowany (gold pulse). */
function drawElevatorVipButton(sx,sy,w,h){
  const won=G.casinoStats?.totalWon||0;
  const REQ=10000;
  const unlocked = won>=REQ;
  const progress = Math.min(1, won/REQ);
  const baseColor = unlocked ? '#c8a520' : '#5a4a20';
  /* cieĹ„ */
  X.fillStyle='rgba(0,0,0,.5)';X.fillRect(sx+3,sy+3,w,h);
  /* tĹ‚o tabliczki */
  X.fillStyle=unlocked?'#2a1a08':'#1a1a22';X.fillRect(sx,sy,w,h);
  X.strokeStyle=baseColor;X.lineWidth=2;X.strokeRect(sx+1,sy+1,w-2,h-2);
  /* okrÄ…gĹ‚y guzik */
  const cx=sx+w/2, cy=sy+h*0.32, r=w*0.28;
  const t=Date.now()/700;
  const pulse=0.5+0.5*Math.sin(t);
  if(unlocked){X.shadowColor='#c8a520';X.shadowBlur=8+pulse*8;}
  const bg=X.createRadialGradient(cx,cy-r*0.2,1,cx,cy,r);
  bg.addColorStop(0,_lightenHex(baseColor,40));
  bg.addColorStop(1,_lightenHex(baseColor,-20));
  X.fillStyle=bg;X.beginPath();X.arc(cx,cy,r,0,Math.PI*2);X.fill();
  X.shadowBlur=0;
  X.strokeStyle='#0a0a14';X.lineWidth=1.5;X.beginPath();X.arc(cx,cy,r,0,Math.PI*2);X.stroke();
  /* emoji đź‘‘ lub đź”’ */
  X.font=`${Math.round(r*1.1)}px serif`;X.textAlign='center';X.textBaseline='middle';
  X.fillText(unlocked?'đź‘‘':'đź”’', cx, cy);
  /* v2.0.21: napisy ostrzejsze â€” wiÄ™ksze fonty, cieĹ„szy stroke, Math.round() pozycji ĹĽeby uniknÄ…Ä‡ subpixel blur */
  /* napis "1 PIÄTRO VIP" */
  const cxR = Math.round(sx+w/2);
  X.font='bold 13px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='#0a0010';X.lineWidth=2;X.lineJoin='round';X.miterLimit=2;
  X.strokeText('1 PIÄTRO VIP', cxR, Math.round(sy+h*0.6));
  X.fillStyle=baseColor;X.fillText('1 PIÄTRO VIP', cxR, Math.round(sy+h*0.6));
  /* v2.0.22: gdy unlocked â€” duĹĽy gold napis "âś“ ODBLOKOWANE" zamiast paska gradientu (nie zlewa siÄ™ z tĹ‚em).
     Gdy locked â€” normalny pasek progress + napis postÄ™pu na czarnym tle (kontrast OK). */
  const barX=Math.round(sx+10), barY=Math.round(sy+h*0.72), barW=w-20, barH=14;
  if(unlocked){
    /* DuĹĽy gold "âś“ ODBLOKOWANE" â€” bez paska, na ciemnym tle przycisku */
    X.font='bold 14px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.strokeStyle='#0a0010';X.lineWidth=3;X.lineJoin='round';X.miterLimit=2;
    const okY=Math.round(barY+barH/2);
    X.strokeText('âś“ ODBLOKOWANE', cxR, okY);
    X.fillStyle='#ffd700';
    X.fillText('âś“ ODBLOKOWANE', cxR, okY);
  } else {
    /* Pasek postÄ™pu z tekstem */
    X.fillStyle='#0a0a14';X.fillRect(barX,barY,barW,barH);
    X.strokeStyle=baseColor;X.lineWidth=1;X.strokeRect(barX+.5,barY+.5,barW-1,barH-1);
    const fillG=X.createLinearGradient(barX,barY,barX+barW,barY);
    fillG.addColorStop(0,'#27ae60');
    fillG.addColorStop(0.5,'#f1c40f');
    fillG.addColorStop(1,'#c8a520');
    X.fillStyle=fillG;
    X.fillRect(barX+1,barY+1,(barW-2)*progress,barH-2);
    /* Tekst postÄ™pu na pasku */
    X.font='bold 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.strokeStyle='rgba(0,0,0,.9)';X.lineWidth=2;X.lineJoin='round';
    const txt=`${won.toLocaleString('pl')} / ${REQ.toLocaleString('pl')} zĹ‚`;
    const txtY=Math.round(barY+barH/2);
    X.strokeText(txt, cxR, txtY);
    X.fillStyle='#fff';
    X.fillText(txt, cxR, txtY);
  }
  /* Helper text na dole â€” wiÄ™kszy font (11px zamiast 9px), cieĹ„szy stroke */
  X.font='bold 11px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=1.5;X.lineJoin='round';
  const helperTxt=unlocked?'Witaj, high rollerze!':'Wygrywaj by odblokowaÄ‡';
  const helperY=Math.round(sy+h-10);
  X.strokeText(helperTxt, cxR, helperY);
  X.fillStyle=unlocked?'#ffd700':'#aac';
  X.fillText(helperTxt, cxR, helperY);
  X.textAlign='left';X.textBaseline='alphabetic';
}

function drawBarman(sx,sy,w,h){
  // NPC barman â€” biaĹ‚a koszula, czarna kamizelka, muszka
  X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(sx+w/2,sy+h-2,w*0.5,3,0,0,Math.PI*2);X.fill();
  // Nogi czarne
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*0.3,sy+h*0.55,w*0.16,h*0.4);X.fillRect(sx+w*0.54,sy+h*0.55,w*0.16,h*0.4);
  // BiaĹ‚a koszula
  X.fillStyle='#fff';X.fillRect(sx+w*0.25,sy+h*0.28,w*0.5,h*0.32);
  // Czarna kamizelka po bokach
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.22,sy+h*0.28,w*0.10,h*0.32);X.fillRect(sx+w*0.68,sy+h*0.28,w*0.10,h*0.32);
  // Muszka czarna
  X.fillStyle='#1a1a1a';X.beginPath();
  X.moveTo(sx+w*0.42,sy+h*0.30);X.lineTo(sx+w*0.58,sy+h*0.30);X.lineTo(sx+w*0.55,sy+h*0.34);X.lineTo(sx+w*0.45,sy+h*0.34);X.closePath();X.fill();
  // GĹ‚owa
  X.fillStyle='#e8c8a0';X.beginPath();X.arc(sx+w/2,sy+h*0.18,w*0.18,0,Math.PI*2);X.fill();
  // WĹ‚osy blond
  X.fillStyle='#c89858';X.fillRect(sx+w*0.32,sy+h*0.05,w*0.36,h*0.10);
  // Oczy
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.40,sy+h*0.17,2,2);X.fillRect(sx+w*0.56,sy+h*0.17,2,2);
  // WÄ…sy (rys. drobny)
  X.fillRect(sx+w*0.42,sy+h*0.22,w*0.16,1);
  // Szklanka w rÄ™ce (animowana)
  const t=Date.now()/500;
  const handY=sy+h*0.42+Math.sin(t)*1.2;
  X.fillStyle='rgba(150,200,230,.5)';X.fillRect(sx+w*0.78,handY,5,8);
  X.fillStyle='#c8a520';X.fillRect(sx+w*0.78,handY,5,2); // zĹ‚oty drink na gĂłrze
}

function drawCasinoGuest(sx,sy,w,h,id){
  // StaĹ‚y NPC w eleganckim ubraniu â€” kolory zaleĹĽne od id (rĂłĹĽne dla kaĹĽdego goĹ›cia)
  const seed=(id.charCodeAt(id.length-1)-48); // 1-4
  const skinPal=['#e0a870','#d4a070','#c89858','#a06030'];
  const suitPal=['#1a3a5a','#3a1a3a','#1a3a1a','#5a1a1a'];
  const accentPal=['#c8a520','#e74c3c','#27ae60','#3498db'];
  const skin=skinPal[seed%skinPal.length];
  const suit=suitPal[seed%suitPal.length];
  const accent=accentPal[seed%accentPal.length];
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(sx+w/2,sy+h-2,w*0.5,3,0,0,Math.PI*2);X.fill();
  // Nogi
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.3,sy+h*0.55,w*0.16,h*0.4);X.fillRect(sx+w*0.54,sy+h*0.55,w*0.16,h*0.4);
  // TuĹ‚Ăłw (garnitur)
  X.fillStyle=suit;X.fillRect(sx+w*0.22,sy+h*0.28,w*0.56,h*0.32);
  // Krawat
  X.fillStyle=accent;X.fillRect(sx+w/2-1.5,sy+h*0.30,3,h*0.20);
  // GĹ‚owa
  X.fillStyle=skin;X.beginPath();X.arc(sx+w/2,sy+h*0.18,w*0.18,0,Math.PI*2);X.fill();
  // WĹ‚osy
  X.fillStyle='#2a1810';X.fillRect(sx+w*0.32,sy+h*0.05,w*0.36,h*0.10);
  // Oczy
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.40,sy+h*0.17,2,2);X.fillRect(sx+w*0.56,sy+h*0.17,2,2);
  // MaĹ‚a bobbing animacja (idle)
  const t=Date.now()/800;
  const bob=Math.sin(t+seed)*0.5;
  // Drink w rÄ™ce (czasem)
  if(seed%2===0){
    X.fillStyle='rgba(231,76,60,.6)';X.fillRect(sx+w*0.78,sy+h*0.42+bob,4,7);
    X.fillStyle='#aaa';X.fillRect(sx+w*0.78,sy+h*0.41+bob,4,1);
  } else {
    // Telefon w rÄ™ce
    X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.78,sy+h*0.40+bob,4,6);
    X.fillStyle='#3498db';X.fillRect(sx+w*0.78,sy+h*0.41+bob,4,2);
  }
}

function drawCroupier(sx,sy,w,h){
  // Krupier â€” NPC w garniturze z muszkÄ…
  // CieĹ„
  X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.ellipse(sx+w/2,sy+h-2,w*0.5,3,0,0,Math.PI*2);X.fill();
  // Nogi w czarnych spodniach
  X.fillStyle='#0a0a0a';X.fillRect(sx+w*0.3,sy+h*0.55,w*0.16,h*0.4);X.fillRect(sx+w*0.54,sy+h*0.55,w*0.16,h*0.4);
  // TuĹ‚Ăłw â€” biaĹ‚a koszula + czarna kamizelka
  X.fillStyle='#fff';X.fillRect(sx+w*0.25,sy+h*0.28,w*0.5,h*0.32);
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.22,sy+h*0.28,w*0.16,h*0.32);X.fillRect(sx+w*0.62,sy+h*0.28,w*0.16,h*0.32);
  // Muszka czerwona
  X.fillStyle='#c01020';X.beginPath();
  X.moveTo(sx+w*0.42,sy+h*0.30);X.lineTo(sx+w*0.58,sy+h*0.30);X.lineTo(sx+w*0.55,sy+h*0.35);X.lineTo(sx+w*0.45,sy+h*0.35);X.closePath();X.fill();
  // GĹ‚owa
  X.fillStyle='#d4a070';X.beginPath();X.arc(sx+w/2,sy+h*0.18,w*0.18,0,Math.PI*2);X.fill();
  // WĹ‚osy ciemne
  X.fillStyle='#2a1810';X.fillRect(sx+w*0.32,sy+h*0.05,w*0.36,h*0.10);
  // Oczy
  X.fillStyle='#1a1a1a';X.fillRect(sx+w*0.40,sy+h*0.17,2,2);X.fillRect(sx+w*0.56,sy+h*0.17,2,2);
  // MaĹ‚a ikonka kart w rÄ™ce
  const t=Date.now()/400;
  const handY=sy+h*0.45+Math.sin(t)*1.5;
  X.fillStyle='#fff';X.fillRect(sx+w*0.78,handY,6,10);
  X.strokeStyle='#1a1a1a';X.lineWidth=0.5;X.strokeRect(sx+w*0.78,handY,6,10);
}

// â”€â”€ BUDYNKI MIESZKANIOWE â€” 3 osobne, kupowane przez gracza â”€â”€
// Mieszkanie Podstawowe â€” modest brick block, drzwi od polnocy (flip=true, ku H3)
function drawAptBasic(sx,sy,w,h){
  X.shadowBlur=0;X.shadowColor='transparent';
  // Cien
  X.fillStyle='rgba(0,0,0,.32)';X.fillRect(sx+4,sy+4,w,h);
  // Fasada â€” cegla, wyblakla
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,'#7a4a30');g.addColorStop(0.5,'#6a3a20');g.addColorStop(1,'#5a3018');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  // Wzor cegiel
  X.strokeStyle='rgba(0,0,0,.18)';X.lineWidth=1;
  for(let r=0;r<6;r++){
    const yL=sy+10+r*((h-30)/6);
    X.beginPath();X.moveTo(sx+2,yL);X.lineTo(sx+w-2,yL);X.stroke();
    const offsetX=r%2?14:0;
    for(let c=0;c<5;c++){
      const xL=sx+10+c*((w-20)/5)+offsetX;
      if(xL<sx+w-4){X.beginPath();X.moveTo(xL,yL);X.lineTo(xL,yL+(h-30)/6);X.stroke();}
    }
  }
  // Drzwi (gora â€” ku H3)
  const doorW=24,doorH=36,doorX=sx+w/2-doorW/2,doorY=sy;
  X.fillStyle='#2a1a0a';X.fillRect(doorX,doorY,doorW,doorH);
  X.fillStyle='#3a2a18';X.fillRect(doorX+2,doorY+2,doorW-4,doorH-4);
  X.fillStyle='#c8a040';X.beginPath();X.arc(doorX+doorW-5,doorY+doorH-15,1.8,0,Math.PI*2);X.fill();
  // Numer mieszkania nad drzwiami
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle='#0a0a0a';X.fillRect(doorX-3,doorY+doorH+1,doorW+6,12);
  X.fillStyle='#7ec8e3';X.fillText('#42',doorX+doorW/2,doorY+doorH+7);
  // Okna â€” siatka
  const winRows=3,winCols=4;
  const wW=14,wH=18,gap=(w-winCols*wW)/(winCols+1);
  for(let r=0;r<winRows;r++)for(let c=0;c<winCols;c++){
    const wx=sx+gap+c*(wW+gap),wy=sy+50+r*(wH+10);
    if(wy+wH>sy+h-10)continue;
    // Czy zaslonete?
    // F4.2 FIX: sx â†’ 11 (deterministyczne, nie migoce przy ruchu kamery)
    const lit=G.timeOfDay>=2&&((r*winCols+c+11)%5)>1;
    X.fillStyle=lit?'#f1d870':'#1a2030';X.fillRect(wx,wy,wW,wH);
    X.strokeStyle='#2a1a08';X.lineWidth=1;X.strokeRect(wx-.5,wy-.5,wW+1,wH+1);
    // Krzyz w oknie
    X.beginPath();X.moveTo(wx+wW/2,wy);X.lineTo(wx+wW/2,wy+wH);X.moveTo(wx,wy+wH/2);X.lineTo(wx+wW,wy+wH/2);X.stroke();
  }
  // Klima na dachu (mala)
  X.fillStyle='#3a3a3a';X.fillRect(sx+w-30,sy+h-12,18,8);
  X.fillStyle='#1a1a1a';X.fillRect(sx+w-28,sy+h-10,14,4);
  // Podpis "MIESZKANIE"
  X.font='bold 12px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('MIESZKANIE',sx+w/2,sy+h-6);
  X.fillStyle='#e8d8c0';X.fillText('MIESZKANIE',sx+w/2,sy+h-6);
  X.textAlign='left';X.textBaseline='alphabetic';
}

// Apartament Premium â€” stylowy nowoczesny budynek z balkonami
function drawAptPremium(sx,sy,w,h){
  X.shadowBlur=0;X.shadowColor='transparent';
  X.fillStyle='rgba(0,0,0,.36)';X.fillRect(sx+4,sy+4,w,h);
  // Fasada â€” bezowy beton z elementami marmuru
  const g=X.createLinearGradient(sx,sy,sx,sy+h);
  g.addColorStop(0,'#d8c8a8');g.addColorStop(0.5,'#c8b898');g.addColorStop(1,'#a89878');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);
  // Marmurowe pasy
  X.fillStyle='rgba(255,255,255,.12)';
  for(let i=0;i<3;i++){X.fillRect(sx,sy+30+i*40,w,2);}
  // Wejscie â€” duza szklana brama (gora â€” ku H3)
  const eW=80,eH=44,eX=sx+w/2-eW/2,eY=sy;
  // Marmurowy framing
  X.fillStyle='#3a3020';X.fillRect(eX-4,eY,eW+8,eH+4);
  X.fillStyle='#1a3050';X.fillRect(eX,eY,eW,eH);
  // Gradient szkla
  const eg=X.createLinearGradient(eX,eY,eX,eY+eH);
  eg.addColorStop(0,'rgba(120,180,220,.85)');
  eg.addColorStop(0.5,'rgba(80,130,180,.95)');
  eg.addColorStop(1,'rgba(40,80,130,.95)');
  X.fillStyle=eg;X.fillRect(eX+2,eY+2,eW-4,eH-4);
  // Linia szkla pionowa (rozdzielenie drzwi)
  X.fillStyle='rgba(0,0,0,.4)';X.fillRect(eX+eW/2-1,eY+2,2,eH-4);
  // Klamki zlote
  X.fillStyle='#f1c40f';X.beginPath();X.arc(eX+eW/2-6,eY+eH-12,2,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(eX+eW/2+6,eY+eH-12,2,0,Math.PI*2);X.fill();
  // Podswietlenie wejscia
  if(G.timeOfDay>=2){
    X.fillStyle='rgba(255,220,140,.35)';
    X.fillRect(eX-12,eY-4,eW+24,2);
  }
  // Balkony â€” 3 kondygnacje x 4 balkonow
  const bRows=3,bCols=4;
  for(let r=0;r<bRows;r++){
    const yL=sy+62+r*((h-90)/bRows);
    for(let c=0;c<bCols;c++){
      const xL=sx+12+c*((w-24)/bCols);
      const bW=(w-24)/bCols-6;
      // Okno-drzwi balkonowe
      // F4.2 FIX: bylo (r*bCols+c+sx) â€” sx zalezy od kamery â†’ migotanie podczas chodzenia
      // Teraz: deterministyczne (r*bCols+c+7) â€” okna nie migaja
      const lit=G.timeOfDay>=2&&((r*bCols+c+7)%4)>1;
      X.fillStyle=lit?'#f1d880':'#1a2840';
      X.fillRect(xL,yL,bW-6,18);
      X.strokeStyle='#5a4030';X.lineWidth=1;X.strokeRect(xL-.5,yL-.5,bW-5,19);
      // Balustrada balkonu
      X.fillStyle='#7a6840';X.fillRect(xL-2,yL+18,bW-2,2);
      X.strokeStyle='#5a4830';X.lineWidth=1;
      for(let bi=0;bi<5;bi++){const bx2=xL+bi*(bW-4)/5;X.beginPath();X.moveTo(bx2,yL+18);X.lineTo(bx2,yL+24);X.stroke();}
      // Kwiat na balkonie czasem
      if((r+c)%3===0){X.fillStyle='#27ae60';X.beginPath();X.arc(xL+bW/2-3,yL+22,2,0,Math.PI*2);X.fill();}
    }
  }
  // Logo na dachu â€” gold "PREMIUM"
  X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle='rgba(0,0,0,.4)';X.fillRect(sx+w/2-50,sy+h-20,100,16);
  X.fillStyle='#f1c40f';X.fillText('â… PREMIUM â…',sx+w/2,sy+h-12);
  // Etykieta
  X.font='bold 13px "Segoe UI",Arial,sans-serif';X.textBaseline='alphabetic';
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
  X.strokeText('Apartament',sx+w/2,sy+h-22);
  X.fillStyle='#fff';X.fillText('Apartament',sx+w/2,sy+h-22);
  X.textAlign='left';X.textBaseline='alphabetic';
}

// Penthouse â€” futurystyczny luksusowy wiezowiec z neonami, holografia, spotlightami
function drawAptPenthouse(sx,sy,w,h){
  X.shadowBlur=0;X.shadowColor='transparent';
  const t=Date.now()/600;
  const isNight=G.timeOfDay>=2;
  // Cien
  X.fillStyle='rgba(0,0,0,.55)';X.fillRect(sx+6,sy+6,w,h);
  // Fasada â€” premium dark glass z fioletowym akcentem
  const g=X.createLinearGradient(sx,sy,sx+w,sy+h);
  g.addColorStop(0,'#1a1a3a');g.addColorStop(0.3,'#0a0a2a');g.addColorStop(0.7,'#1a0a3a');g.addColorStop(1,'#0a0518');
  X.fillStyle=g;X.fillRect(sx,sy,w,h);

  // â”€â”€ ANIMOWANE NEONY PIONOWE â€” RGB cycle wzdluz boku budynku â”€â”€
  const neonHue=(Date.now()/30)%360;
  for(let side=0;side<2;side++){
    const xL=side===0?sx:sx+w-3;
    // Neonowa rura pionowa
    const ng=X.createLinearGradient(xL,sy,xL,sy+h);
    ng.addColorStop(0,`hsla(${(neonHue+0)%360},100%,60%,.95)`);
    ng.addColorStop(0.33,`hsla(${(neonHue+120)%360},100%,60%,.95)`);
    ng.addColorStop(0.66,`hsla(${(neonHue+240)%360},100%,60%,.95)`);
    ng.addColorStop(1,`hsla(${(neonHue+0)%360},100%,60%,.95)`);
    X.fillStyle=ng;X.fillRect(xL,sy+8,3,h-30);
    // Glow
    if(isNight){
      X.shadowColor=`hsl(${neonHue},100%,60%)`;X.shadowBlur=14;
      X.fillStyle=`hsla(${neonHue},100%,70%,.5)`;X.fillRect(xL,sy+8,3,h-30);
      X.shadowBlur=0;
    }
  }

  // â”€â”€ HOLOGRAFICZNE LOGO unoszace sie nad budynkiem â”€â”€
  const holoY=sy+h+18+Math.sin(t*0.7)*3;
  const holoX=sx+w/2;
  if(isNight){
    // Beam wstepny od budynku w gore
    const beamG=X.createLinearGradient(holoX,sy+h-10,holoX,holoY);
    beamG.addColorStop(0,'rgba(126,200,227,0)');
    beamG.addColorStop(0.5,'rgba(126,200,227,.4)');
    beamG.addColorStop(1,'rgba(126,200,227,.7)');
    X.fillStyle=beamG;
    X.beginPath();
    X.moveTo(holoX-2,sy+h-5);X.lineTo(holoX+2,sy+h-5);
    X.lineTo(holoX+12,holoY+10);X.lineTo(holoX-12,holoY+10);
    X.closePath();X.fill();
  }
  // Hologram â€” animowany emoji
  X.shadowColor='#7ec8e3';X.shadowBlur=isNight?16:6;
  X.font='bold 26px Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle=isNight?`rgba(180,230,255,${0.85+Math.sin(t*1.5)*0.15})`:'rgba(180,230,255,.65)';
  X.fillText('đź’Ž',holoX,holoY);
  X.shadowBlur=0;

  // â”€â”€ F+ 2026-05-12 #91: obrotowy reflektor "VIP" nad dachem + animowane fajerwerki nocÄ… â”€â”€
  // ZastÄ™puje stare "podskakujÄ…ce odwaĹĽniki" (spotlight beams ktĂłre wyglÄ…daĹ‚y dziwnie).
  if(isNight){
    X.save();
    X.globalCompositeOperation='lighter';
    // Obrotowy reflektor â€” pojedyncza wiÄ…zka krÄ™cÄ…ca siÄ™ 360Â° wokĂłĹ‚ Ĺ›rodka dachu
    const beamCenterX=sx+w/2, beamCenterY=sy+h-8;
    const rotAngle=(t*0.6)%(Math.PI*2);
    const beamLen=140;
    // Kolor wiÄ…zki zmienia siÄ™ pĹ‚ynnie (RGB cycle)
    const beamHue=(t*40)%360;
    for(let bi=0;bi<3;bi++){
      const a=rotAngle+bi*(Math.PI*2/3);
      const ex=beamCenterX+Math.cos(a)*beamLen;
      const ey=beamCenterY-Math.sin(a)*beamLen*0.5; // spĹ‚aszczona perspektywa
      const bg=X.createLinearGradient(beamCenterX,beamCenterY,ex,ey);
      bg.addColorStop(0,`hsla(${(beamHue+bi*120)%360},100%,65%,.55)`);
      bg.addColorStop(.6,`hsla(${(beamHue+bi*120)%360},100%,65%,.18)`);
      bg.addColorStop(1,`hsla(${(beamHue+bi*120)%360},100%,65%,0)`);
      X.fillStyle=bg;
      X.beginPath();
      X.moveTo(beamCenterX,beamCenterY);
      X.lineTo(ex+12*Math.cos(a+Math.PI/2),ey+12*Math.sin(a+Math.PI/2));
      X.lineTo(ex-12*Math.cos(a+Math.PI/2),ey-12*Math.sin(a+Math.PI/2));
      X.closePath();X.fill();
    }
    // Animowane "fajerwerki" â€” 4 czÄ…steczki rozpryskujÄ…ce siÄ™ okresowo nad dachem
    const fwPhase=(t*0.8)%1;
    if(fwPhase<0.7){
      const fwX=sx+w*0.3+Math.sin(t*0.3)*40, fwY=sy+h-30;
      for(let p=0;p<8;p++){
        const ang=p*(Math.PI*2/8);
        const dist=fwPhase*40;
        const pX=fwX+Math.cos(ang)*dist, pY=fwY+Math.sin(ang)*dist;
        const al=Math.max(0,1-fwPhase*1.3);
        X.fillStyle=`hsla(${(beamHue+p*45)%360},100%,70%,${al*0.85})`;
        X.beginPath();X.arc(pX,pY,2,0,Math.PI*2);X.fill();
      }
    }
    X.restore();
  }

  // Wejscie â€” DUZE szklane drzwi z LED ramka pulsujaca
  const eW=120,eH=64,eX=sx+w/2-eW/2,eY=sy;
  // Welcome mat (czerwony dywan VIP) â€” przed wejsciem (na chodniku)
  const matG=X.createLinearGradient(eX-15,eY-8,eX+eW+15,eY-8);
  matG.addColorStop(0,'rgba(120,20,30,.9)');matG.addColorStop(0.5,'rgba(180,30,40,.95)');matG.addColorStop(1,'rgba(120,20,30,.9)');
  X.fillStyle=matG;X.fillRect(eX-15,eY-8,eW+30,8);
  X.strokeStyle='#f1c40f';X.lineWidth=1;X.strokeRect(eX-13,eY-6,eW+26,4);

  // LED frame (animowane neony â€” RGB cycle)
  const neonHue2=(Date.now()/20)%360;
  const ledThick=4;
  X.fillStyle=`hsl(${neonHue2},100%,65%)`;
  X.fillRect(eX-ledThick,eY,eW+ledThick*2,ledThick);  // gora
  X.fillRect(eX-ledThick,eY+eH+ledThick,eW+ledThick*2,ledThick);  // dol
  X.fillRect(eX-ledThick,eY,ledThick,eH+ledThick*2);  // lewo
  X.fillRect(eX+eW,eY,ledThick,eH+ledThick*2);  // prawo
  // Glow LED
  if(isNight){
    X.shadowColor=`hsl(${neonHue2},100%,65%)`;X.shadowBlur=20;
    X.fillStyle=`hsla(${neonHue2},100%,80%,.5)`;
    X.fillRect(eX-ledThick,eY,eW+ledThick*2,ledThick);
    X.shadowBlur=0;
  }

  // Szklane drzwi â€” gradient z holograficzny refleks
  const eg=X.createLinearGradient(eX,eY,eX,eY+eH);
  eg.addColorStop(0,'rgba(80,140,220,.7)');
  eg.addColorStop(0.4,'rgba(30,60,140,.9)');
  eg.addColorStop(1,'rgba(10,20,60,.95)');
  X.fillStyle=eg;X.fillRect(eX,eY+1,eW,eH+2);
  // Animowany refleks ruchomy
  const refX=eX+(Math.sin(t*0.3)*0.5+0.5)*(eW-30);
  X.fillStyle='rgba(220,240,255,.35)';
  X.beginPath();
  X.moveTo(refX+5,eY+4);X.lineTo(refX+25,eY+4);X.lineTo(refX+15,eY+eH-4);X.lineTo(refX-5,eY+eH-4);
  X.closePath();X.fill();
  // Linia rozdzielenia drzwi
  X.fillStyle='rgba(0,0,0,.8)';X.fillRect(eX+eW/2-1,eY+1,2,eH+2);
  // Klamki gold + diamond
  X.fillStyle='#f1c40f';X.fillRect(eX+eW/2-12,eY+eH/2,4,8);X.fillRect(eX+eW/2+8,eY+eH/2,4,8);
  X.fillStyle='#fff';X.beginPath();X.arc(eX+eW/2-10,eY+eH/2-2,1.5,0,Math.PI*2);X.fill();X.beginPath();X.arc(eX+eW/2+10,eY+eH/2-2,1.5,0,Math.PI*2);X.fill();

  // â”€â”€ BIG WINDOW ROW â€” DUZA szklana fasada z partikles wewnatrz (light show) â”€â”€
  const winRows=3;
  for(let r=0;r<winRows;r++){
    const yL=sy+74+r*((h-104)/winRows);
    const winH=(h-110)/winRows-4;
    const wg=X.createLinearGradient(sx+10,yL,sx+w-10,yL+winH);
    if(isNight){
      // Wnetrze: VIP party light show
      const partyHue=(Date.now()/40+r*120)%360;
      wg.addColorStop(0,`hsla(${partyHue},90%,60%,.85)`);
      wg.addColorStop(0.5,`hsla(${(partyHue+60)%360},85%,55%,.95)`);
      wg.addColorStop(1,`hsla(${(partyHue+120)%360},80%,40%,.85)`);
    } else {
      // Dzien: szkĹ‚o niebieskie/srebrne odbijajace niebo
      wg.addColorStop(0,'rgba(120,170,220,.85)');
      wg.addColorStop(0.5,'rgba(80,130,190,.95)');
      wg.addColorStop(1,'rgba(50,90,150,.95)');
    }
    X.fillStyle=wg;X.fillRect(sx+10,yL,w-20,winH);

    // Reflection refleksy diagonalne
    if(!isNight){
      X.fillStyle='rgba(255,255,255,.15)';
      X.beginPath();
      X.moveTo(sx+10,yL+winH*.3);X.lineTo(sx+10+winH*.5,yL);X.lineTo(sx+10+winH*1.2,yL);X.lineTo(sx+10,yL+winH);X.closePath();
      X.fill();
    } else {
      // v1.8.18: sylwetki tancerzy zamiast "skaczÄ…cych odwaĹĽnikĂłw" â€” owalne gĹ‚owy + ruchome rÄ™ce.
      // User: "wyglÄ…da jak skaczÄ…ce odwaĹĽniki przemieszczajÄ…ce siÄ™ na bok" â€” teraz ukĹ‚ad taneczny.
      const partySeed=r*7;
      for(let p=0;p<5;p++){
        // Pozycja pozioma â€” stabilna per p (nie biega po szybie)
        const px2=sx+18+((p+0.5)/5)*(w-36);
        // Falowanie pionowe â€” wolniejsze, sub-pixel, rĂłĹĽne fazy
        const sway=Math.sin(t*1.1+p*1.3+partySeed*0.4)*2.5;
        const baseY=yL+winH*.55+sway;
        // Ramie wyrzucone w gĂłrÄ™ â€” alternatywne rÄ™ce, animacja
        const armPhase=Math.sin(t*1.6+p*0.9);
        const leftArmUp=armPhase>0;
        X.fillStyle='rgba(0,0,0,.65)';
        // GĹ‚owa â€” owalna
        X.beginPath();X.ellipse(px2,baseY-9,2.6,3.2,0,0,Math.PI*2);X.fill();
        // TuĹ‚Ăłw â€” trapezoidalny
        X.beginPath();
        X.moveTo(px2-3,baseY-5);X.lineTo(px2+3,baseY-5);
        X.lineTo(px2+3.5,baseY+5);X.lineTo(px2-3.5,baseY+5);
        X.closePath();X.fill();
        // RÄ™ce â€” jedna podniesiona, druga opuszczona (taniec)
        X.strokeStyle='rgba(0,0,0,.65)';X.lineWidth=1.5;
        X.beginPath();
        if(leftArmUp){
          X.moveTo(px2-3,baseY-4);X.lineTo(px2-6,baseY-10); // lewa w gĂłrÄ™
          X.moveTo(px2+3,baseY-4);X.lineTo(px2+5,baseY+2); // prawa w dĂłĹ‚
        } else {
          X.moveTo(px2-3,baseY-4);X.lineTo(px2-5,baseY+2);
          X.moveTo(px2+3,baseY-4);X.lineTo(px2+6,baseY-10);
        }
        X.stroke();
      }
      // Disco ball flicker â€” wielokolorowy obrotowy refleks
      const dbPhase=(t*3+r)%6;
      const dbColors=['rgba(255,80,80,.6)','rgba(255,200,80,.6)','rgba(80,200,255,.6)','rgba(180,80,255,.6)','rgba(80,255,180,.6)','rgba(255,255,255,.7)'];
      X.fillStyle=dbColors[Math.floor(dbPhase)];
      const dbX=sx+w/2+Math.cos(t*2+r)*16;
      X.beginPath();X.arc(dbX,yL+winH/3,3.5,0,Math.PI*2);X.fill();
    }
    // Pionowe podzialy szyb
    X.strokeStyle='rgba(0,0,0,.5)';X.lineWidth=1.5;
    for(let c=1;c<6;c++){
      const xL=sx+10+c*(w-20)/6;
      X.beginPath();X.moveTo(xL,yL);X.lineTo(xL,yL+winH);X.stroke();
    }
    // Rama szyby â€” gold akcent
    X.strokeStyle=isNight?'rgba(241,196,15,.5)':'#3a4a5a';X.lineWidth=1.5;
    X.strokeRect(sx+9.5,yL-.5,w-19,winH+1);
  }

  // â”€â”€ PENTHOUSE BANNER NA DACHU â€” animowany neon â”€â”€
  const lY=sy+h-22;
  // Tlo banera (ciemne z gold border)
  X.fillStyle='rgba(8,8,20,.95)';X.fillRect(sx+w/2-85,lY-3,170,21);
  X.strokeStyle='#f1c40f';X.lineWidth=1.5;X.strokeRect(sx+w/2-85,lY-3,170,21);
  // Migajacy neon â€” pink/cyan na zmiane
  const neonColor=Math.sin(t*0.8)>0?'#e91e8c':'#7ec8e3';
  X.shadowColor=neonColor;X.shadowBlur=isNight?15:6;
  X.font='bold 13px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  X.fillStyle=neonColor;X.fillText('â–¶ PENTHOUSE â—€',sx+w/2,lY+8);
  X.shadowBlur=0;
  // Diamenty po bokach
  X.font='bold 12px Arial';
  X.fillStyle='#f1c40f';
  X.fillText('đź’Ž',sx+w/2-72,lY+8);
  X.fillText('đź’Ž',sx+w/2+72,lY+8);

  // F+ 2026-05-12 #86: helipad i antena USUNIÄTE z dachu Penthouse (byĹ‚y maĹ‚e i nieczytelne).
  // ZastÄ…pione osobnym DUĹ»YM helipadem jako obiekt na wolnej przestrzeni obok budynku (wx=2050, wy=3450).

  // â”€â”€ GLASS ELEVATOR po lewej (animowana winda) â”€â”€
  const elevX=sx+w-12,elevW=8;
  X.fillStyle='rgba(180,200,230,.3)';X.fillRect(elevX,sy+24,elevW,h-44);
  X.strokeStyle='rgba(126,200,227,.6)';X.lineWidth=1;X.strokeRect(elevX-.5,sy+23.5,elevW+1,h-43);
  // Sama winda
  const elevPos=(Math.sin(t*0.3)*0.5+0.5);
  const elevY=sy+30+elevPos*(h-66);
  X.fillStyle=isNight?'#f1d870':'#7ec8e3';
  X.fillRect(elevX+1,elevY,elevW-2,12);
  X.strokeStyle='rgba(0,0,0,.5)';X.strokeRect(elevX+0.5,elevY-.5,elevW-1,13);
  // Glow okolo windy
  if(isNight){
    X.shadowColor='#f1d870';X.shadowBlur=8;
    X.fillStyle='rgba(255,220,140,.4)';X.fillRect(elevX+1,elevY,elevW-2,12);
    X.shadowBlur=0;
  }

  // â”€â”€ PARTICLES â€” drobne iskry wokol budynku (noc only) â”€â”€
  if(isNight){
    for(let p=0;p<6;p++){
      const sparkleX=sx+((p*53+Math.floor(t*30))%w);
      const sparkleY=sy+15+((p*31)%(h-30));
      const a=Math.sin(t*3+p*1.7)*0.5+0.5;
      X.fillStyle=`rgba(255,240,200,${a*0.85})`;
      X.beginPath();X.arc(sparkleX,sparkleY,1.5+a*0.8,0,Math.PI*2);X.fill();
    }
  }

  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.1.171: Mansion drawing â€” luksusowa rezydencja w prestiĹĽowej dzielnicy (obok Biura NieruchomoĹ›ci).
   Wszystkie zewnÄ™trzne elementy (lawn/hedge/pool/helipad/topiary) usuniÄ™te â€” city version. */
function drawMansion(sx,sy,w,h){
  /* v2.1.170: warstwowe cienie, kolumny z fluting+shading, dach z dachĂłwkami, drzwi z arkadÄ…, okiennice z lamelami, balkon, lampy
     v2.1.171: refactor city â€” usuniÄ™te basen/helipad/topiary/lawn (mansion w mieĹ›cie, nie poza), wszystko wewnÄ…trz sx,sy,w,h */
  X.shadowBlur=0;X.shadowColor='transparent';
  const isNight=G.timeOfDay>=2;
  const t=Date.now()/400;
  /* === CieĹ„ gĹ‚Ăłwny mansion === */
  X.fillStyle='rgba(0,0,0,.35)';
  X.fillRect(sx+6,sy+h*0.16+4,w,h*0.84);
  /* === Fasada gĹ‚Ăłwna === */
  const facadeY=sy+h*0.16;
  const facadeH=h*0.84;
  const fg=X.createLinearGradient(sx,facadeY,sx,facadeY+facadeH);
  fg.addColorStop(0,'#fbf0d8');fg.addColorStop(0.4,'#f0e0c0');fg.addColorStop(0.8,'#d8c8a0');fg.addColorStop(1,'#a89878');
  X.fillStyle=fg;X.fillRect(sx,facadeY,w,facadeH);
  /* Cieniowanie boczne fasady (vignette efekt) */
  const vg=X.createLinearGradient(sx,0,sx+w,0);
  vg.addColorStop(0,'rgba(60,40,20,.25)');vg.addColorStop(0.15,'rgba(0,0,0,0)');vg.addColorStop(0.85,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(60,40,20,.25)');
  X.fillStyle=vg;X.fillRect(sx,facadeY,w,facadeH);
  /* Pasek fryzu na gĂłrze fasady (klasyczny detal) */
  X.fillStyle='#b8a070';X.fillRect(sx,facadeY+2,w,4);
  X.fillStyle='#d8c090';X.fillRect(sx,facadeY+1,w,1);
  /* CokĂłĹ‚ na dole fasady (granit) */
  X.fillStyle='#5a4838';X.fillRect(sx,facadeY+facadeH-12,w,12);
  X.fillStyle='#8a7050';X.fillRect(sx,facadeY+facadeH-12,w,1);
  /* === Dach (gable) === */
  const roofPeakY=sy-8;
  X.fillStyle='#581808';
  X.beginPath();
  X.moveTo(sx-14,facadeY);
  X.lineTo(sx+w/2,roofPeakY);
  X.lineTo(sx+w+14,facadeY);
  X.closePath();
  X.fill();
  /* Dach â€” pattern dachĂłwek (curved rows) */
  for(let row=0;row<5;row++){
    const ry=roofPeakY+(facadeY-roofPeakY)*((row+1)/6);
    const inset=(facadeY-ry)*(w/2/(facadeY-roofPeakY));
    const rowW=w-2*inset+24;
    X.fillStyle=(row%2===0)?'#6a2818':'#4a1408';
    /* DachĂłwki w rzÄ™dzie â€” co 10px Ĺ‚uk */
    for(let tx=sx-12+inset;tx<sx+w+12-inset;tx+=11){
      X.fillRect(tx,ry,10,3);
    }
    /* CieĹ„ rzÄ…du */
    X.fillStyle='rgba(0,0,0,.35)';X.fillRect(sx-12+inset,ry+3,rowW,1);
  }
  /* Dach krawÄ™dĹş (eave) â€” drewniana belka */
  X.fillStyle='#3a1808';
  X.fillRect(sx-14,facadeY-2,w+28,3);
  /* Komin po prawej */
  X.fillStyle='#7a3a28';X.fillRect(sx+w*0.78,roofPeakY+8,w*0.04,16);
  X.fillStyle='#3a1808';X.fillRect(sx+w*0.78-1,roofPeakY+8,w*0.04+2,2);
  /* Dym z komina (subtle animowany) */
  if(!isNight){
    X.fillStyle=`rgba(180,180,180,${0.3+0.1*Math.sin(t/2)})`;
    X.beginPath();X.arc(sx+w*0.80,roofPeakY+2+Math.sin(t)*1.5,3,0,Math.PI*2);X.fill();
    X.fillStyle=`rgba(160,160,160,${0.2})`;
    X.beginPath();X.arc(sx+w*0.81,roofPeakY-4+Math.sin(t+1)*1.5,4,0,Math.PI*2);X.fill();
  }
  /* === Tympanon (frontowa attyka) â€” Ĺ›rodkowy gable === */
  const tympX1=sx+w*0.3, tympX2=sx+w*0.7;
  X.fillStyle='#fbf0d8';
  X.beginPath();X.moveTo(tympX1,facadeY);X.lineTo(sx+w/2,sy+h*0.05);X.lineTo(tympX2,facadeY);X.closePath();X.fill();
  /* Tympanon krawÄ™dĹş */
  X.strokeStyle='#a08858';X.lineWidth=2;X.stroke();
  /* ZĹ‚oty herb/godĹ‚o w Ĺ›rodku tympanonu */
  X.fillStyle='#f1c40f';
  X.beginPath();X.arc(sx+w/2,facadeY-6,5,0,Math.PI*2);X.fill();
  X.fillStyle='#a87808';
  X.beginPath();X.arc(sx+w/2,facadeY-6,5,0,Math.PI*2);X.stroke();
  /* v2.1.172: KOLUMNY przeniesione PO oknach â€” kolumny majÄ… byÄ‡ NA WIERZCHU okien (priority architectural element) */
  /* === Stopnie portyku === */
  const stepY=facadeY+facadeH;
  for(let s=0;s<3;s++){
    X.fillStyle=s===0?'#8a7a5a':(s===1?'#a89070':'#c8b090');
    X.fillRect(sx+w*0.25-s*4,stepY+s*3,w*0.5+s*8,4);
    X.fillStyle='rgba(0,0,0,.3)';X.fillRect(sx+w*0.25-s*4,stepY+s*3+3,w*0.5+s*8,1);
  }
  /* === Wielkie drzwi z arkadÄ… === */
  const doorW=w*0.11, doorH=facadeH*0.55;
  const doorX=sx+w/2-doorW/2, doorY=facadeY+facadeH-doorH-12;
  /* WnÄ™ka wejĹ›ciowa (cieĹ„) */
  X.fillStyle='#1a0a05';X.fillRect(doorX-3,doorY-2,doorW+6,doorH+2);
  /* Drzwi double-leaf */
  const doorG=X.createLinearGradient(doorX,0,doorX+doorW,0);
  doorG.addColorStop(0,'#2a1808');doorG.addColorStop(0.5,'#4a2a14');doorG.addColorStop(1,'#2a1808');
  X.fillStyle=doorG;X.fillRect(doorX,doorY,doorW,doorH);
  /* GĂłrny Ĺ‚uk drzwi (arkada) */
  X.fillStyle='#4a2a14';
  X.beginPath();X.arc(doorX+doorW/2,doorY,doorW/2,Math.PI,Math.PI*2);X.fill();
  X.fillStyle='#1a0a05';X.beginPath();X.arc(doorX+doorW/2,doorY,doorW/2-1,Math.PI,Math.PI*2);X.fill();
  /* WitraĹĽ w arkadzie */
  X.fillStyle=isNight?'#f4d96a':'#7090a8';
  X.beginPath();X.arc(doorX+doorW/2,doorY,doorW/2-3,Math.PI,Math.PI*2);X.fill();
  /* PodziaĹ‚ drzwi (Ĺ›rodkowa szczelina) */
  X.fillStyle='#0a0402';X.fillRect(doorX+doorW/2-0.5,doorY,1,doorH);
  /* Panele drzwi (4 prostokÄ…ty) */
  X.strokeStyle='#1a0a05';X.lineWidth=1;
  X.strokeRect(doorX+2,doorY+4,doorW/2-3,doorH/2-6);
  X.strokeRect(doorX+doorW/2+1,doorY+4,doorW/2-3,doorH/2-6);
  X.strokeRect(doorX+2,doorY+doorH/2+2,doorW/2-3,doorH/2-6);
  X.strokeRect(doorX+doorW/2+1,doorY+doorH/2+2,doorW/2-3,doorH/2-6);
  /* ZĹ‚ote uchwyty */
  X.fillStyle='#f1c40f';
  X.beginPath();X.arc(doorX+doorW*0.40,doorY+doorH*0.55,1.8,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(doorX+doorW*0.60,doorY+doorH*0.55,1.8,0,Math.PI*2);X.fill();
  /* Lampy po bokach drzwi */
  for(const lampX of [doorX-7,doorX+doorW+5]){
    X.fillStyle='#3a2818';X.fillRect(lampX-1.5,doorY+doorH*0.2,3,doorH*0.5);
    X.fillStyle=isNight?'#f4d96a':'#a89070';
    X.beginPath();X.arc(lampX,doorY+doorH*0.18,3.5,0,Math.PI*2);X.fill();
    if(isNight){X.shadowColor='#f4d96a';X.shadowBlur=8;
      X.fillStyle='rgba(244,217,106,.5)';X.beginPath();X.arc(lampX,doorY+doorH*0.18,3.5,0,Math.PI*2);X.fill();
      X.shadowBlur=0;}
  }
  /* === Balkon piÄ™tro nad drzwiami === */
  const balcY=facadeY+facadeH*0.30;
  X.fillStyle='#9a8060';X.fillRect(sx+w*0.42,balcY,w*0.16,3);
  /* Balustrada â€” 5 sĹ‚upkĂłw */
  for(let b=0;b<5;b++){
    X.fillStyle='#fafaf0';X.fillRect(sx+w*0.43+b*(w*0.035),balcY-7,1.5,7);
  }
  X.fillStyle='#9a8060';X.fillRect(sx+w*0.42,balcY-9,w*0.16,2);
  /* === Okna boczne z okiennicami === */
  const winRows=[facadeY+facadeH*0.18,facadeY+facadeH*0.50];
  const winCols=[sx+w*0.06,sx+w*0.20,sx+w*0.74,sx+w*0.88];
  const winW=w*0.06, winH=facadeH*0.18;
  for(const wy of winRows){
    for(const wx of winCols){
      /* Rama okna (zewnÄ™trzna) */
      X.fillStyle='#3a2818';X.fillRect(wx-1.5,wy-1.5,winW+3,winH+3);
      /* Szyba */
      X.fillStyle=isNight?'#f4d96a':'#5a7090';
      X.fillRect(wx,wy,winW,winH);
      /* KrzyĹĽ okienny (4 panele) */
      X.fillStyle='#3a2818';
      X.fillRect(wx+winW/2-0.5,wy,1,winH);
      X.fillRect(wx,wy+winH/2-0.5,winW,1);
      /* Okiennice po bokach (drewniane z lameli) */
      for(const sxn of [-1,1]){
        const shutX=wx+(sxn<0?-winW*0.35-2:winW+2);
        X.fillStyle='#3a4a28';X.fillRect(shutX,wy-1,winW*0.32,winH+2);
        /* Lamele */
        X.fillStyle='#2a3a18';
        for(let l=0;l<5;l++){X.fillRect(shutX,wy+l*(winH/5)+1,winW*0.32,1);}
      }
      /* Parapet */
      X.fillStyle='#a08858';X.fillRect(wx-3,wy+winH,winW+6,2);
      /* Night glow */
      if(isNight){
        X.shadowColor='#f4d96a';X.shadowBlur=6;
        X.fillStyle='rgba(244,217,106,.25)';X.fillRect(wx,wy,winW,winH);
        X.shadowBlur=0;
      }
    }
  }
  /* v2.1.171: pool/helipad/topiary usuniÄ™te â€” mansion teraz w mieĹ›cie, nie ma miejsca na ogrĂłd. */
  /* v2.1.172: === 4 KOLUMNY Ionic z flutingiem === (rysowane PO oknach â€” na wierzchu, priority architectural) */
  const colY=facadeY+8, colH=facadeH-20;
  for(let i=0;i<4;i++){
    const cx=sx+w*0.10+i*(w*0.245), cw=w*0.045;
    /* Trzon kolumny â€” base white */
    const colG=X.createLinearGradient(cx,0,cx+cw,0);
    colG.addColorStop(0,'#d0d0c5');colG.addColorStop(0.5,'#fafaf0');colG.addColorStop(1,'#b8b8a8');
    X.fillStyle=colG;X.fillRect(cx,colY+6,cw,colH-12);
    /* Fluting (vertical lines) â€” 3 paski */
    X.fillStyle='rgba(120,110,90,.4)';
    for(let f=1;f<=3;f++){X.fillRect(cx+cw*(f*0.25),colY+8,0.7,colH-16);}
    /* Kapitel joĹ„ska â€” voluta zwoje */
    X.fillStyle='#e8e8d8';X.fillRect(cx-3,colY+2,cw+6,7);
    X.fillStyle='#fafaf0';X.fillRect(cx-4,colY,cw+8,4);
    /* Voluta lewa i prawa (maĹ‚e kĂłĹ‚eczka) */
    X.fillStyle='#c8c8b8';X.beginPath();X.arc(cx-1,colY+5,2,0,Math.PI*2);X.arc(cx+cw+1,colY+5,2,0,Math.PI*2);X.fill();
    /* Baza kolumny */
    X.fillStyle='#a8a898';X.fillRect(cx-3,colY+colH-7,cw+6,5);
    X.fillStyle='#888878';X.fillRect(cx-4,colY+colH-3,cw+8,3);
  }
  /* === Label "REZYDENCJA" === */
  X.shadowBlur=0;X.shadowColor='transparent';
  X.textAlign='center';
  X.font='bold 18px Russo One, Arial, sans-serif';
  X.strokeStyle='rgba(0,0,0,0.9)';X.lineWidth=4;
  X.strokeText('đźŹ° REZYDENCJA',sx+w/2,roofPeakY-14);
  /* ZĹ‚oty fill */
  const labelG=X.createLinearGradient(0,roofPeakY-22,0,roofPeakY-8);
  labelG.addColorStop(0,'#fde047');labelG.addColorStop(1,'#d4a017');
  X.fillStyle=labelG;
  X.fillText('đźŹ° REZYDENCJA',sx+w/2,roofPeakY-14);
  /* Subtitle */
  X.font='italic 11px Arial, sans-serif';
  X.strokeStyle='rgba(0,0,0,0.85)';X.lineWidth=2.5;
  X.strokeText('prywatna posiadĹ‚oĹ›Ä‡',sx+w/2,roofPeakY+2);
  X.fillStyle='#e8f0f8';X.fillText('prywatna posiadĹ‚oĹ›Ä‡',sx+w/2,roofPeakY+2);
  X.textAlign='left';X.textBaseline='alphabetic'; /* reset */
}
// â”€â”€ UNIKALNE DETALE BUDYNKĂ“W â€” dodatkowe rozrĂłĹĽnienie wizualne â”€â”€
function drawHospitalCross(sx,sy,w,h){
  // Czerwony krzyĹĽ w PRAWYM GĂ“RNYM rogu fasady â€” ĹĽeby NIE zasĹ‚aniaĹ‚ emoji đźŹĄ i napisu Szpital na Ĺ›rodku
  const cx=sx+w*.85, cy=sy+h*.12, cs=11;
  // BiaĹ‚e tĹ‚o-kwadrat z czerwonÄ… obwĂłdkÄ… (klasyczny znak medyczny)
  X.fillStyle='#fff';
  X.fillRect(cx-cs-2,cy-cs-2,cs*2+4,cs*2+4);
  X.strokeStyle='#a01818';X.lineWidth=1.5;
  X.strokeRect(cx-cs-2+.5,cy-cs-2+.5,cs*2+3,cs*2+3);
  // Jaskrawy czerwony krzyĹĽ
  X.fillStyle='#e0150f';
  X.fillRect(cx-cs/3,cy-cs,cs/3*2,cs*2);
  X.fillRect(cx-cs,cy-cs/3,cs*2,cs/3*2);
}
function drawPizzeriaExtras(sx,sy,w,h){
  // Neony "PIZZA" i okrÄ…gĹ‚e okno
  const pulse=0.7+Math.sin(Date.now()/600)*0.3;
  X.fillStyle=`rgba(255,100,20,${pulse*.45})`;X.beginPath();X.arc(sx+w*.72,sy+h*.38,w*.15,0,Math.PI*2);X.fill();
  X.strokeStyle='rgba(255,140,40,.7)';X.lineWidth=2;X.beginPath();X.arc(sx+w*.72,sy+h*.38,w*.12,0,Math.PI*2);X.stroke();
  X.shadowBlur=0;X.font='8px Arial';X.fillStyle='rgba(255,200,50,.9)';X.textAlign='center';
  X.fillText('đźŤ•',sx+w*.72,sy+h*.42);X.textAlign='left';
}
function drawCarwashExtras(sx,sy,w,h){
  // BÄ…belki wody
  const t=Date.now();
  [[.2,.4],[.45,.6],[.7,.3],[.3,.7],[.6,.5]].forEach(([fx,fy],i)=>{
    const bx=sx+w*fx+Math.sin(t*.001+i)*3,by=sy+h*fy-((t*.02+i*40)%60);
    const br=3+i%3;X.strokeStyle='rgba(100,200,255,.5)';X.lineWidth=1.5;
    X.beginPath();X.arc(bx,by,br,0,Math.PI*2);X.stroke();
  });
}
function drawConstructionExtras(sx,sy,w,h){
  // Rusztowanie â€” pionowe i poziome sĹ‚upy
  X.strokeStyle='rgba(255,180,20,.5)';X.lineWidth=2;
  X.beginPath();X.moveTo(sx+w*.15,sy);X.lineTo(sx+w*.15,sy+h);X.stroke();
  X.beginPath();X.moveTo(sx+w*.85,sy);X.lineTo(sx+w*.85,sy+h);X.stroke();
  for(let i=0;i<3;i++){X.beginPath();X.moveTo(sx+w*.15,sy+h*(0.25+i*.25));X.lineTo(sx+w*.85,sy+h*(0.25+i*.25));X.stroke();}
  // Flaga
  X.fillStyle='#f1c40f';X.fillRect(sx+w*.82,sy-14,14,10);
}
/* v2.1.215 [Amper]: Mega Villa — Tier 3 Legendary apartament. Compact (155x155) — niebieski akcent (basen), białe kolumny, złote dach (status). */
function drawMegaVilla(sx,sy,w,h){
  /* Tło (trawnik) */
  X.fillStyle='#2a4a28';X.fillRect(sx,sy,w,h);
  /* Cień */
  X.fillStyle='rgba(0,0,0,.35)';X.fillRect(sx+5,sy+5,w-10,h-10);
  /* Fasada (kremowy marmur z luxury akcentem) */
  X.fillStyle='#f0e4c8';X.fillRect(sx+5,sy+10,w-10,h-15);
  /* Złoty dach (premium status) */
  X.fillStyle='#c8a520';X.fillRect(sx+3,sy+5,w-6,12);
  X.fillStyle='#a08518';X.fillRect(sx+3,sy+15,w-6,2);
  /* Kolumny jońskie (4 słupki) */
  X.fillStyle='#fff';
  for(let i=0;i<4;i++){
    const cx=sx+10+i*((w-20)/3);
    X.fillRect(cx,sy+18,8,h-30);
    /* Kapitele */
    X.fillStyle='#e0d4a8';X.fillRect(cx-2,sy+18,12,3);X.fillRect(cx-2,sy+h-15,12,3);
    X.fillStyle='#fff';
  }
  /* Drzwi (premium złoto) */
  X.fillStyle='#c8a520';X.fillRect(sx+w/2-10,sy+h-25,20,20);
  X.fillStyle='#a08518';X.fillRect(sx+w/2-10,sy+h-25,20,2);
  X.fillStyle='#5a3a08';X.fillRect(sx+w/2-2,sy+h-15,4,4);  /* klamka */
  /* Okna (niebieskie szyby — basen reflection) */
  X.fillStyle='#3a6a9a';
  for(let i=0;i<3;i++){
    const wx_=sx+15+i*((w-30)/2)-4;
    X.fillRect(wx_,sy+25,8,15);
  }
  /* Basen sygnał (mały niebieski blok przed wejściem) */
  X.fillStyle='#5a8aba';X.fillRect(sx+10,sy+h-8,w-20,5);
  X.fillStyle='rgba(255,255,255,.4)';X.fillRect(sx+15,sy+h-7,8,1);
  /* Label "MEGA VILLA" */
  X.fillStyle='#c8a520';X.font='bold 9px Arial';X.textAlign='center';
  X.fillText('MEGA VILLA',sx+w/2,sy+14);X.textAlign='left';
  /* Subtelne ikoniczne 🌴 (palma) po bokach */
  X.font='14px Arial';X.fillText('🌴',sx+2,sy+h-3);X.fillText('🌴',sx+w-14,sy+h-3);
}
/* v2.1.215 [Amper]: Hall of Fame statue — złoty pomnik gracza w Drip District (tylko gdy unlock). */
function drawHofStatue(sx,sy,w,h){
  /* Cokół (marmur) */
  X.fillStyle='#d4d4d4';X.fillRect(sx+w*.15,sy+h*.7,w*.7,h*.3);
  X.fillStyle='#a8a8a8';X.fillRect(sx+w*.15,sy+h*.95,w*.7,h*.05);
  /* Złota plakieta z imieniem */
  X.fillStyle='#c8a520';X.fillRect(sx+w*.25,sy+h*.78,w*.5,h*.12);
  X.fillStyle='#1a1a1a';X.font='bold 7px Arial';X.textAlign='center';
  X.fillText((G.name||'').slice(0,10).toUpperCase(),sx+w/2,sy+h*.84);
  X.fillText('HALL OF FAME',sx+w/2,sy+h*.89);
  /* Figura (uproszczona — postać w garniturze, złota) */
  /* Głowa */
  X.fillStyle='#c8a520';X.beginPath();X.arc(sx+w/2,sy+h*.2,w*.12,0,Math.PI*2);X.fill();
  /* Tors */
  X.fillStyle='#b89518';X.fillRect(sx+w*.32,sy+h*.32,w*.36,h*.3);
  /* Ramiona (na biodrach — power pose) */
  X.fillRect(sx+w*.20,sy+h*.34,w*.12,h*.10);
  X.fillRect(sx+w*.68,sy+h*.34,w*.12,h*.10);
  /* Mikrofon w ręce */
  X.fillStyle='#1a1a1a';X.beginPath();X.arc(sx+w*.85,sy+h*.42,w*.05,0,Math.PI*2);X.fill();
  /* Sparkle effects (4 gwiazdki wokół) */
  const _t=Date.now()/300;
  X.fillStyle=`rgba(255,220,100,${0.6+Math.sin(_t)*0.3})`;
  X.font='12px Arial';X.textAlign='center';
  X.fillText('✨',sx+w*.05,sy+h*.15);
  X.fillText('✨',sx+w*.95,sy+h*.15);
  X.fillText('✨',sx+w*.10,sy+h*.55);
  X.fillText('✨',sx+w*.90,sy+h*.55);
  X.textAlign='left';
}
function drawConcertHallExtras(sx,sy,w,h){
  // Subtelne reflektory sceniczne (mniejsze i jaĹ›niejsze niĹĽ wczeĹ›niej)
  const pulse=0.6+Math.sin(Date.now()/400)*0.4;
  X.fillStyle=`rgba(233,30,140,${pulse*.22})`;X.beginPath();X.arc(sx+w*.5,sy+h*.13,w*.10,0,Math.PI*2);X.fill();
  X.fillStyle=`rgba(155,89,182,${pulse*.20})`;X.beginPath();X.arc(sx+w*.28,sy+h*.16,4,0,Math.PI*2);X.fill();
  X.fillStyle=`rgba(233,30,140,${pulse*.20})`;X.beginPath();X.arc(sx+w*.72,sy+h*.16,4,0,Math.PI*2);X.fill();
  // Neonowy napis "LIVE" â€” na dole budynku, ostrzejszy, wiÄ™kszy
  const neonPulse=0.75+Math.sin(Date.now()/350)*0.25;
  const ny=sy+h*.86;
  X.font='bold 15px "Arial Black",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
  // Subtelny glow (mniejszy blur dla ostroĹ›ci)
  X.shadowBlur=4*neonPulse;X.shadowColor='#e91e8c';
  X.fillStyle=`rgba(255,255,255,${0.95})`;
  X.fillText('â—Ź LIVE',sx+w*.5,ny);
  X.shadowBlur=0;
  // WewnÄ™trzny kolor (rdzeĹ„ napisu)
  X.fillStyle=`rgba(255,80,160,${0.95+neonPulse*0.05})`;
  X.fillText('â—Ź LIVE',sx+w*.5,ny);
  // Mocny ostry kontur (efekt neonowej rurki)
  X.strokeStyle=`rgba(255,200,230,${0.85})`;X.lineWidth=1;X.lineJoin='round';
  X.strokeText('â—Ź LIVE',sx+w*.5,ny);
  X.textAlign='left';X.textBaseline='alphabetic';
}
