      </g>
      <!-- ĹšwiecÄ…ce okna â€” losowo rozsiane -->
      <g>
        <rect class="w" x="20" y="245" width="6" height="8"/><rect class="w" x="35" y="260" width="6" height="8"/><rect class="w" x="55" y="270" width="6" height="8"/><rect class="w" x="80" y="245" width="6" height="8"/><rect class="w" x="95" y="220" width="6" height="8"/><rect class="w" x="135" y="250" width="6" height="8"/><rect class="w" x="160" y="265" width="6" height="8"/><rect class="w" x="185" y="220" width="6" height="8"/><rect class="w" x="220" y="265" width="6" height="8"/><rect class="w" x="240" y="280" width="6" height="8"/>
