// â”€â”€â”€ WORLD TOUR â”€â”€
function runTourDay(){
  if(!G._tourActive) return;
  const t=G._tourActive;
  // Tour ukoĹ„czona â€” finalizacja po ostatnim mieĹ›cie
  if(t.day>=t.cities.length){
    /* v2.1.50 Amper: nerf bonusu koĹ„cowego (0.5â†’0.2 totalEarned, 0.3â†’0.15 totalFans). WczeĹ›niej trasa dawaĹ‚a 75-150k zĹ‚
       co przy 4000 sĹ‚uchaczy byĹ‚o absurdalnie duĹĽo. Teraz bonus koĹ„cowy = ~20% trasy + 15% fanĂłw. */
    const completionBonus=Math.floor((t.totalEarned||0)*0.2);
    const completionFans=Math.floor((t.totalFans||0)*0.15);
    /* v2.1.98: Prestige moneyMult przez earn() + Prestige fameMult przez addFame() (Wave 5 K44 Tour completion bypass fix) */
    if(completionBonus>0){if(typeof earn==='function')earn(completionBonus,false);else{G.money+=completionBonus;G.totalEarned=(G.totalEarned||0)+completionBonus;}}
    if(completionFans>0){G.followers+=completionFans;}
    showMsg(`đźŚŤ WORLD TOUR ZAKOĹCZONY! ${t.cities.length} miast, +${t.totalEarned.toLocaleString('pl')} zĹ‚ zarobione w trasie + bonus koĹ„cowy ${completionBonus.toLocaleString('pl')} zĹ‚ + ${completionFans.toLocaleString('pl')} fanĂłw. JesteĹ› legendÄ…!`);
    addNotif('đźŚŤ World Tour ukoĹ„czony!');
    addFame(15);
    G._tourActive=null;
    confetti(60);
    return;
  }
  const city=t.cities[t.day];
  // v1.8.65: kaĹĽde miasto = prawdziwy rhythm-minigame koncert (nie auto-reward jak wczeĹ›niej).
  if((G.energy||0)<15){
    showMsg(`âšˇ Za maĹ‚o energii (potrzeba 15) â€” trasa wstrzymana w ${city}. Odpocznij i wrĂłÄ‡ do Marcina by kontynuowaÄ‡.`,'r');
    return;
  }
  // v1.9.17: BUG FIX â€” energy faktycznie pobrana (poprzednio tylko sprawdzane, 5 free concertĂłw na 1 charge = exploit)
  G.energy=Math.max(0,G.energy-15);
  /* v2.1.50 Amper: NERF zarobkĂłw per miasto z 8000-20000 do 3000-7500 (po skalowaniu +15%/miasto: max 5Ă—=200% = max 15k zamiast 40k). */
  const mult=1+t.day*0.15;
  /* v2.1.203 [Amper]: World Tour cinematic przeniesiony do endConcert (post-minigame). WczeĹ›niej blokowaĹ‚ minigre. */
  startConcertMG(`đźŚŤ World Tour: ${city} (${t.day+1}/${t.cities.length})`, 0, 0, Math.round(3000*mult), Math.round(7500*mult));
}

// â”€â”€â”€ FESTIWAL TYGODNIOWY â”€â”€
const WEEKLY_FESTIVALS=[
  {id:'hiphop',  name:'đźŽ¤ Festiwal Hip-Hop',     desc:'CaĹ‚a scena oĹĽyĹ‚a. Koncerty +100% sĹ‚awy przez 3 dni.',    days:3, effect:{concertFameMult:2.0}},
  {id:'blackfri',name:'đź›Ť Black Friday',         desc:'Promocja roku â€” sprzedaĹĽ merchu Ă—3 przez 1 dzieĹ„.',     days:1, effect:{merchSalesMult:3.0}},
  {id:'targi',   name:'đźŽµ Targi muzyczne',       desc:'Spotkanie z A&R moĹĽliwe â€” szansa na lepsze deale label.',days:2, effect:{labelOfferBoost:true}},
  {id:'talent',  name:'đźŚź Konkurs talentĂłw',     desc:'Freestyle daje +50% XP i +50 fanĂłw za udziaĹ‚.',         days:2, effect:{freestyleBoost:1.5}},
  {id:'street',  name:'đźŹ™ Street Art Week',     desc:'Reputacja uliczna roĹ›nie 2Ă— szybciej.',                 days:3, effect:{repMult:2.0}},
  {id:'studio',  name:'đźŽ™ Studio Boom',          desc:'Wszystkie nagrania majÄ… +20% jakoĹ›ci przez 3 dni.',     days:3, effect:{recordingQualityBoost:1.2}}
];
function tickFestival(){
  if(!G.day || G.day<7) return;
  /* v1.9.33: BUG FIX â€” expiry PRZED triggerem (poprzednio festival koĹ„czÄ…cy dziĹ› blokowaĹ‚ nowy = 7-dniowa luka) */
  if(G.activeFestival && G.activeFestival.expiresDay<=G.day){
    addNotif(`Festiwal "${G.activeFestival.name}" zakoĹ„czony.`);
    G.activeFestival=null;
  }
  // Co 7 dni rozpoczyna siÄ™ nowy festiwal (jeĹ›li nie ma aktywnego)
  if(G.day%7===0 && (!G.activeFestival || G.activeFestival.expiresDay<=G.day)){
    const f=WEEKLY_FESTIVALS[Math.floor(Math.random()*WEEKLY_FESTIVALS.length)];
    G.activeFestival={id:f.id,name:f.name,desc:f.desc,expiresDay:G.day+f.days,effect:f.effect};
    setTimeout(()=>showMsg(`${f.name} rozpoczÄ™ty! ${f.desc}`),1000);
    addNotif(`${f.name} (${f.days} dni)`);
  }
}
// â”€â”€ ĹšWIÄTA KALENDARZOWE (per cykl 56 dni = 1 rok gry) â”€â”€
const HOLIDAYS=[
  {id:'walentynki', day:14, name:'âť¤ď¸Ź Walentynki',     desc:'NPC dajÄ… kwiaty. +10 nastrĂłj. Insta posty +25% zasiÄ™gu.', dur:1},
  {id:'majowka',    day:28, name:'đźŚ· MajĂłwka',         desc:'Wszyscy na piknikach. Koncerty plenerowe Ă—1.5 zarobkĂłw.', dur:2},
  {id:'halloween',  day:42, name:'đźŽ Halloween',       desc:'Imprezy do rana. Streetrep +50% przyrostu.',              dur:2},
  {id:'blackfriday',day:49, name:'đź›Ť Black Friday',    desc:'Wszystkie sklepy â’20%. Merch Ă—3.',                        dur:1},
  {id:'wigilia',    day:54, name:'đźŽ„ Wigilia',         desc:'Czas spokoju. +500 zĹ‚ od fanĂłw + nastrĂłj 100/100 (totalny relaks).',    dur:1}, /* v2.1.114: W20 â€” opis jasny ĹĽe stress=100 to zen mood (high=zen, NIE chaos) */
  {id:'sylwester',  day:56, name:'đźŽ† Sylwester',       desc:'Mega bal! Koncerty Ă—2 zarobkĂłw + 100 fanĂłw.',             dur:1},
];
function checkHolidays(){
  if(!G.day) return;
  const yearDay=((G.day-1)%56)+1; // dzieĹ„ w roku gry (1-56)
  // SprawdĹş czy zaczyna siÄ™ jakieĹ› Ĺ›wiÄ™to
  for(const h of HOLIDAYS){
    if(yearDay===h.day && (!G.activeHoliday || G.activeHoliday.id!==h.id)){
      G.activeHoliday={id:h.id,name:h.name,desc:h.desc,expiresDay:G.day+h.dur};
      showMsg(`${h.name} rozpoczÄ™te! ${h.desc}`);
      addNotif(`${h.name} (${h.dur} dni)`);
      // Walentynki bonus: stress +10
      if(h.id==='walentynki') G.stress=Math.min(100,(G.stress||0)+10);
      // Wigilia: +500 zĹ‚ od fanĂłw (jeĹ›li >100 fanĂłw)
      if(h.id==='wigilia' && G.followers>=100){
        if(typeof earn==='function') earn(500,false); else {G.money+=500;G.totalEarned=(G.totalEarned||0)+500;}
        G.stress=100;
      }
      /* v1.9.50: Sylwester +100 fanĂłw (ghost feature â€” opis obiecywaĹ‚, kod nigdy nie dawaĹ‚) */
      if(h.id==='sylwester'){
        G.followers=(G.followers||0)+100;
        if(typeof addNotif==='function') addNotif('đźŽ† +100 fanĂłw na Sylwestra!');
      }
      return;
    }
  }
  // SprzÄ…tnij wygasĹ‚e Ĺ›wiÄ™to
  if(G.activeHoliday && G.activeHoliday.expiresDay<=G.day){
    addNotif(`${G.activeHoliday.name} zakoĹ„czone.`);
    G.activeHoliday=null;
  }
}
function holidayBonus(type){
  if(!G.activeHoliday) return 1;
  const id=G.activeHoliday.id;
  // type: 'concert','merch','rep','insta','shop'
  /* v2.1.83 Amper: NERF mnoĹĽnikĂłw Ĺ›wiÄ…tecznych. Sylwester Ă—2.0 â†’ Ă—1.4, MajĂłwka Ă—1.5 â†’ Ă—1.25. Stack koncertĂłw byĹ‚ OP late game.
     v2.1.110: Wave 2 W18 â€” BUFF kod do match UI obietnic (Sylwester desc "Koncerty Ă—2", MajĂłwka "Ă—1.5"). Memory rule: NIE zamiataÄ‡ pod dywan. Kod podniesiony do match opisĂłw. */
  if(type==='concert' && (id==='majowka'||id==='sylwester')) return id==='sylwester'?2.0:1.5;
  if(type==='merch' && id==='blackfriday') return 3.0;
  if(type==='shop' && id==='blackfriday') return 0.8; // ceny -20%
  if(type==='rep' && id==='halloween') return 1.5;
  if(type==='insta' && id==='walentynki') return 1.25;
  return 1;
}
function festivalEffect(key){
  return G.activeFestival?.effect?.[key];
}
// â”€â”€â”€ SEZONY â”€â”€
const SEASONS=[
  {id:0, name:'Wiosna', emoji:'đźŚ¸', tint:'rgba(180,255,180,0.05)', merchBoost:{tshirt:1.2,cap:1.15,poster:1.1}, concertBoost:1.0, eventBoost:1.2}, /* v2.1.116: Wave 5 S47 â€” Wiosna dostaĹ‚a sezonowe boosty (wczeĹ›niej pusta) */
  {id:1, name:'Lato',   emoji:'â€ď¸Ź',  tint:'rgba(255,220,140,0.06)', merchBoost:{tshirt:1.3,cap:1.4,cup:1.1}, concertBoost:1.3, eventBoost:1.0},
  {id:2, name:'JesieĹ„', emoji:'đźŤ‚', tint:'rgba(220,150,90,0.07)', merchBoost:{hoodie:1.2,vinyl:1.15}, concertBoost:0.95, eventBoost:1.1},
  {id:3, name:'Zima',   emoji:'âť„ď¸Ź',  tint:'rgba(180,210,255,0.08)', merchBoost:{hoodie:1.5,luxhood:1.5,cap:1.2}, concertBoost:0.85, eventBoost:1.0}
];
function getSeason(){
  // 14 dni gry = 1 sezon. Cykl 56 dni.
  return SEASONS[Math.floor(((G.day||1)-1)/14)%4];
}
function seasonMerchMult(typeId){
  const s=getSeason();
  return s.merchBoost[typeId]||1.0;
}
function drawSeasonOverlay(){
  if(currentRoom!=='ulica') return;
  const s=getSeason();
  if(s.tint && s.tint!=='rgba(180,255,180,0.05)'){
    X.fillStyle=s.tint;
    X.fillRect(0,62,1280,658);
  }
}
