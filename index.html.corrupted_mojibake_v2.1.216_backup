          if(G.mic){
            G._questAudioMicDone=true;
            /* v2.1.203 [Amper]: cashback 30% ceny pierwszego mikrofonu (NIE hardcoded). Min 50 zĹ‚ ĹĽeby tani mic nie byĹ‚ 0 zĹ‚ reward. */
            const _micPrice=G._firstMicPrice||(G.mic?.price)||0;
