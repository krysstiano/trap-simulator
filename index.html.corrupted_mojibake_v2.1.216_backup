      durPerPlace:3500,
    },
    {
      em:'đźŽ™', title:'KARIERA MUZYCZNA',
      desc:'Studio NagraĹ„ (tracki, albumy), Sklep Muzyczny (instrumenty), Media Markt (kamery, mikrofony), Sala Koncertowa (3 sceny â€” gĹ‚Ăłwne ĹşrĂłdĹ‚o sĹ‚awy), Radio Street.',
      places:[
        {wx:1714, wy:210, label:'STUDIO NAGRAĹ', zoom:1.7},
        {wx:1154, wy:210, label:'SKLEP MUZYCZNY', zoom:1.6},
        {wx:1554, wy:208, label:'MEDIA MARKT', zoom:1.6},
