    {
      em:'đź’Ľ', title:'PRACE DORYWCZE',
      /* v2.1.199: usuniÄ™ty WARSZTAT z prac (user feedback "warsztat to nie praca dorywcza, kĹ‚amstwo"). Warsztat to sklep techniczny â€” przeniesiony do osobnego topica "SERWIS I NAPRAWA". */
      desc:'Pizzeria, Supermarket, Zmywak (restauracja), Myjnia, Budowa, Kurier. Pierwsze ĹşrĂłdĹ‚o kasy zanim odblokujesz kariery.',
      places:[
        {wx:400, wy:2285, label:'SUPERMARKET', zoom:1.6},
        {wx:1154, wy:2285, label:'MYJNIA', zoom:1.6},
        {wx:1474, wy:2285, label:'ZMYWAK (RESTAURACJA)', zoom:1.6},
        {wx:1874, wy:2285, label:'BUDOWA', zoom:1.6},
        {wx:2694, wy:2285, label:'KURIER', zoom:1.6},
        {wx:2994, wy:2285, label:'PIZZERIA (PRACA)', zoom:1.6},
      ],
      durPerPlace:2800,
