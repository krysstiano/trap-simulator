    case 'cvip_poker':     drawPokerTable(sx,sy,w,h);break;
    case 'cvip_plinko':    drawPlinkoMachine(sx,sy,w,h);break;
    case 'cvip_keno':      drawKenoMachine(sx,sy,w,h);break;
    case 'cvip_ridebus':   drawRideBusTable(sx,sy,w,h);break; /* v2.1.187: Ride the Bus */
    case 'cvip_bar':       drawCasinoBar(sx,sy,w,h);break;
