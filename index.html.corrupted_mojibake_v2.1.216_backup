<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Trap Simulator</title>
<style>
@import url('https://fonts.googleapis.com/css?family=Orbitron:400,700,900&subset=latin,latin-ext&display=swap');
@import url('https://fonts.googleapis.com/css?family=Russo+One&subset=latin,latin-ext&display=swap');
*{margin:0;padding:0;box-sizing:border-box;}
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:radial-gradient(ellipse at center, #1a1a2a 0%, #0a0a14 60%, #050508 100%);}
body{font-family:'"Segoe UI"',Tahoma,sans-serif;}
#wrap{position:absolute;width:1280px;height:720px;overflow:hidden;transform-origin:top left;}
canvas{display:block;}

/* â”€â”€ HUD â”€â”€ solidne tĹ‚o bez przerwy, z subtelnym akcentem na dole */
#hud{position:absolute;top:0;left:0;width:100%;height:62px;background:linear-gradient(180deg,rgba(8,12,22,.97) 0%,rgba(5,8,14,.95) 100%);display:flex;align-items:center;gap:4px;padding:0 12px;padding-right:250px;pointer-events:none;z-index:10;overflow:hidden;}/* v2.1.198: padding-right 200â†’250 â€” clock width ~135 (horizontal row), absolute right:110 â†’ clock zajmuje 110-245 od right edge. Plus 5px buffer = 250. Zapobiega nakĹ‚adaniu siÄ™ fanĂłw (hfollow) na clock. */
#hud::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent 0%,rgba(126,200,227,.35) 25%,rgba(155,89,182,.35) 50%,rgba(241,196,15,.3) 75%,transparent 100%);pointer-events:none;opacity:.7}
/* Subtelny zĹ‚oty akcent na dole HUD â€” wyraĹşna granica bez "czarnego paska" */
#hud::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(200,165,32,.4) 30%,rgba(241,196,15,.5) 50%,rgba(200,165,32,.4) 70%,transparent);pointer-events:none;box-shadow:0 1px 6px rgba(241,196,15,.2);}
.hsml{font-size:9px;color:#556;letter-spacing:.5px}
.hs{display:flex;align-items:center;gap:4px;pointer-events:all;flex-shrink:0;}
[data-tip]{pointer-events:all;}
.hs .ico{font-size:16px;}
.hbar{width:50px;height:9px;background:#101820;border-radius:5px;overflow:hidden;position:relative;box-shadow:inset 0 1px 2px rgba(0,0,0,.5);}
.hfill{height:100%;border-radius:5px;transition:width .4s;position:relative;overflow:hidden;}
.hfill::after{content:'';position:absolute;top:0;left:-30%;width:30%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);animation:hudShimmer 3.5s linear infinite;}
@keyframes hudShimmer{0%{left:-30%;}100%{left:130%;}}
@keyframes lbDeltaPulse{0%{transform:scale(.6) translateY(4px);opacity:0;}40%{transform:scale(1.3) translateY(0);opacity:1;}100%{transform:scale(1) translateY(0);opacity:1;}}
@keyframes hudPulseRed{0%,100%{box-shadow:inset 0 1px 2px rgba(0,0,0,.5),0 0 0 rgba(231,76,60,0);}50%{box-shadow:inset 0 1px 2px rgba(0,0,0,.5),0 0 8px rgba(231,76,60,.85);}}
.hbar.crit{animation:hudPulseRed 0.9s ease-in-out infinite;}
.fhp{background:linear-gradient(90deg,#b03030,#e74c3c,#ff6b6b);}
.fen{background:linear-gradient(90deg,#c05000,#f39c12,#ffb347);}
.fhu{background:linear-gradient(90deg,#1a7040,#27ae60,#5fd987);}
.ffa{background:linear-gradient(90deg,#602080,#9b59b6,#c78dde);}
.fst{background:linear-gradient(90deg,#205080,#3498db,#5fb8e8);}
.hv{font-size:13px;color:#aaa;min-width:26px;}
.hdiv{width:1px;height:36px;background:#1a2535;}
.hbig{font-size:17px;color:#7ec8e3;font-weight:700;overflow:visible;line-height:1;}
.hsml{font-size:12px;color:#445;}
#hphone{position:absolute;top:12px;right:10px;height:30px;background:linear-gradient(180deg,#1f2c44,#142035);border:1px solid #3a4a6a;color:#7ec8e3;font-size:14px;padding:0 9px;border-radius:8px;cursor:pointer;pointer-events:all;transition:all .15s;line-height:1;box-shadow:0 2px 6px rgba(0,0,0,.45),inset 0 1px 0 rgba(126,200,227,.12);box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-width:38px;}/* v2.1.198: wyrĂłwnane z #hmute (height 30, padding 0 9, font 14) â€” wczeĹ›niej padding 6 9 i font 17 dawaĹ‚y innÄ… wysokoĹ›Ä‡/szerokoĹ›Ä‡ */
#hphone.has-new::after{content:'';position:absolute;top:2px;right:2px;width:9px;height:9px;background:#e74c3c;border:2px solid #142035;border-radius:50%;animation:pulse-gold 1.5s ease-in-out infinite;}
#hphone:hover,#hmute:hover{background:linear-gradient(180deg,#2a3a55,#1c2a44);border-color:#7ec8e3;transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.55),inset 0 1px 0 rgba(126,200,227,.2);}
#hcontract{position:absolute;bottom:2px;right:14px;font-size:11px;color:#f1c40f;display:none;pointer-events:none;}
#hquest{display:none!important}
#hclock{font-family:'Orbitron',monospace;font-size:14px;color:#e8c84a;font-weight:700;letter-spacing:.3px;text-shadow:0 0 6px rgba(232,200,74,.35);min-width:42px;display:inline-block;}
#sleep-overlay{position:absolute;top:62px;left:0;right:0;bottom:0;background:rgba(0,0,12,.96);display:none;z-index:45;flex-direction:column;align-items:center;justify-content:center;}
#sleep-overlay.on{display:flex;}
.hs{cursor:help;}

/* â”€â”€ PROMPT â”€â”€ */
#prompt{position:absolute;bottom:70px;left:50%;transform:translateX(-50%);background:rgba(4,8,14,.93);border:1px solid #7ec8e3;color:#7ec8e3;font-size:17px;font-weight:600;padding:11px 26px;border-radius:6px;pointer-events:none;display:none;z-index:25;letter-spacing:.5px;animation:promptPulse 1.6s ease-in-out infinite;box-shadow:0 0 12px rgba(126,200,227,.25);}
@keyframes promptPulse{0%,100%{box-shadow:0 0 12px rgba(126,200,227,.25);border-color:#7ec8e3}50%{box-shadow:0 0 24px rgba(126,200,227,.7);border-color:#a3d8ed}}

/* â”€â”€ MSG â”€â”€ */
/* v1.9.15: Fade-in NAPRAWIONY â€” base opacity:0 + translateY(10px), .show podnosi (poprzednio toast SNAPowaĹ‚ przy pojawieniu) */
#msg{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(10px);background:linear-gradient(135deg,rgba(10,25,10,.98),rgba(15,30,15,.98));border:3px solid #2a6a2a;color:#b8f8b8;font-size:22px;font-weight:700;padding:22px 42px;border-radius:14px;pointer-events:none;display:none;z-index:9999;max-width:820px;text-align:center;transition:opacity 0.3s, transform 0.3s;opacity:0;box-shadow:0 12px 48px rgba(0,0,0,.7),0 0 40px rgba(46,175,90,.35),inset 0 1px 0 rgba(255,255,255,.1);letter-spacing:.3px;}
/* v1.9.82: jeszcze wiÄ™ksze toasty (gracz wciÄ…ĹĽ przegapiaĹ‚ â€” font 22px, padding 22px, gradient bg, glow) */
#msg.show{opacity:1;transform:translateX(-50%) translateY(0);}
#msg.hide{opacity:0;transform:translateX(-50%) translateY(10px);}

/* â”€â”€ OVERLAY â€” v1.8.19 redesign system â”€â”€ */
:root{
  --bg-base:#070b18;
  --bg-card:linear-gradient(150deg,rgba(16,22,40,0.72),rgba(10,14,28,0.78));
  --bg-card-hover:linear-gradient(150deg,rgba(24,32,58,0.85),rgba(14,18,36,0.85));
  --bg-card-deep:rgba(8,12,24,0.85);
  --border-soft:rgba(126,200,227,0.10);
  --border-med:rgba(126,200,227,0.20);
  --border-strong:rgba(126,200,227,0.45);
  --accent:#7ec8e3;
  --accent-warm:#f1c40f;
  --accent-green:#27ae60;
  --accent-purple:#9b59b6;
  --accent-pink:#e91e8c;
  --accent-red:#e74c3c;
  --text-main:#dde6f0;
  --text-muted:#7a8aa0;
  --text-dim:#4a5670;
  --glow-cool:0 0 28px rgba(126,200,227,.18);
  --shadow-card:0 6px 24px rgba(0,0,0,0.45),0 2px 4px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,0.04);
  --shadow-card-hover:0 12px 36px rgba(0,0,0,.55),0 2px 8px rgba(126,200,227,.15),inset 0 1px 0 rgba(255,255,255,0.06);
}
#overlay{position:absolute;top:62px;left:0;right:0;bottom:0;background:radial-gradient(ellipse at 30% 0%,rgba(36,46,86,0.35) 0%,rgba(8,12,24,0.98) 60%),linear-gradient(160deg,rgba(3,6,14,.98) 0%,rgba(5,10,22,.98) 50%,rgba(4,8,18,.98) 100%);display:none;flex-direction:column;overflow-y:auto;padding:32px 56px;z-index:30;animation:overlayContent .35s cubic-bezier(0.22,0.61,0.36,1);}
#overlay.on{display:flex;}
@keyframes overlayContent{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
#char-panel.on{display:flex;}
#overlay h2{font-size:32px;margin-bottom:6px;color:#fff;font-weight:800;letter-spacing:0.3px;text-shadow:0 2px 24px rgba(126,200,227,0.18);}
#overlay .sub{color:var(--text-muted);font-size:14px;margin-bottom:22px;line-height:1.5;}
.cards{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:18px;}
.card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;padding:18px 18px 16px;width:218px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:var(--shadow-card);transition:all .22s cubic-bezier(0.22,0.61,0.36,1);position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent 0%,rgba(126,200,227,0.4) 50%,transparent 100%);opacity:0;transition:opacity .22s;}
.card:hover{border-color:var(--border-med);transform:translateY(-2px);box-shadow:var(--shadow-card-hover);background:var(--bg-card-hover);}
.card:hover::before{opacity:1;}
.card h3{font-size:15px;margin-bottom:8px;color:#fff;font-weight:700;letter-spacing:0.2px;}
.card p{font-size:12px;color:var(--text-muted);line-height:1.55;margin-bottom:10px;}
.card .cost{font-size:12px;color:var(--accent-warm);margin-bottom:12px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;text-shadow:0 1px 0 rgba(0,0,0,.6);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}
.section-sep{border:none;border-top:1px solid var(--border-soft);margin:20px 0;}
.dbtn{background:linear-gradient(145deg,rgba(38,90,142,.95),rgba(20,46,82,.95));border:1px solid rgba(126,200,227,0.35);color:#cfe7f5;font-family:inherit;font-size:14px;font-weight:600;padding:11px 0;cursor:pointer;border-radius:8px;width:100%;transition:all .18s cubic-bezier(0.22,0.61,0.36,1);letter-spacing:0.2px;box-shadow:0 2px 8px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,0.08);}
.dbtn:hover:not(:disabled){background:linear-gradient(145deg,rgba(56,124,184,.98),rgba(28,64,108,.98));border-color:rgba(126,200,227,0.7);color:#fff;transform:translateY(-1px);box-shadow:0 6px 18px rgba(56,124,184,.4),inset 0 1px 0 rgba(255,255,255,0.12);}
.dbtn:active:not(:disabled){transform:translateY(0);box-shadow:0 2px 6px rgba(0,0,0,.4),inset 0 1px 4px rgba(0,0,0,.2);}
.dbtn:disabled{background:linear-gradient(145deg,#0e1320,#0a0e18);border-color:rgba(60,72,98,.2);color:#3a4458;cursor:not-allowed;opacity:0.55;}
.cbtn{background:transparent;border:1px solid rgba(126,200,227,0.20);color:var(--text-muted);font-family:inherit;font-size:14px;padding:10px 26px;cursor:pointer;border-radius:8px;transition:all .18s;margin-top:8px;align-self:flex-start;letter-spacing:0.3px;}
.cbtn:hover{background:rgba(126,200,227,0.08);color:var(--accent);border-color:rgba(126,200,227,0.5);transform:translateY(-1px);}
.res{background:linear-gradient(145deg,rgba(8,30,12,0.6),rgba(6,18,8,0.6));border:1px solid rgba(39,174,96,0.25);border-radius:10px;padding:13px 18px;font-size:14px;color:#9ddca8;min-height:44px;margin-bottom:16px;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);}
.statrow{display:flex;gap:18px;background:linear-gradient(145deg,rgba(14,20,36,0.7),rgba(10,16,30,0.7));border:1px solid var(--border-soft);border-radius:12px;padding:14px 18px;margin-bottom:18px;flex-wrap:wrap;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:inset 0 1px 0 rgba(255,255,255,0.03);}
.sbox{flex:1;min-width:100px;}
.sbox .l{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-dim);font-weight:600;}
.sbox .v{font-size:22px;font-weight:800;color:var(--accent);margin-top:2px;letter-spacing:0.3px;}
.shopgrid{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:18px;}
.sitem{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:16px;width:182px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);box-shadow:var(--shadow-card);transition:all .22s cubic-bezier(0.22,0.61,0.36,1);position:relative;overflow:hidden;}
.sitem::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent 0%,rgba(126,200,227,0.3) 50%,transparent 100%);opacity:0;transition:opacity .22s;}
.sitem:hover{border-color:var(--border-med);transform:translateY(-2px);box-shadow:var(--shadow-card-hover);}
.sitem:hover::before{opacity:1;}
.sitem h3{font-size:14px;margin-bottom:6px;color:#fff;font-weight:700;letter-spacing:0.2px;}
.sitem p{font-size:12px;color:var(--text-muted);margin-bottom:8px;line-height:1.5;}
.sitem .pr{color:var(--accent-warm);font-size:13px;font-weight:700;margin-bottom:10px;letter-spacing:0.3px;}
.sitem .owned{display:inline-block;color:var(--accent-green);background:rgba(39,174,96,0.18);border:1px solid rgba(39,174,96,0.5);border-radius:12px;font-size:11px;font-weight:600;padding:3px 10px;margin-bottom:8px;letter-spacing:0.3px;box-shadow:0 0 8px rgba(39,174,96,0.25);}
.sitem:has(.owned){border-color:rgba(39,174,96,0.3);background:linear-gradient(160deg,rgba(14,30,18,0.7),rgba(10,20,12,0.7));}
.bbtn{background:linear-gradient(145deg,rgba(32,124,68,.95),rgba(18,72,42,.95));border:1px solid rgba(39,174,96,0.4);color:#d4f0d8;font-family:inherit;font-size:13px;font-weight:600;padding:10px 0;cursor:pointer;border-radius:8px;width:100%;transition:all .18s cubic-bezier(0.22,0.61,0.36,1);letter-spacing:0.2px;box-shadow:0 2px 8px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,0.08);}
.bbtn:hover:not(:disabled){background:linear-gradient(145deg,rgba(46,156,86,.98),rgba(24,94,52,.98));border-color:rgba(39,174,96,0.75);color:#fff;transform:translateY(-1px);box-shadow:0 6px 18px rgba(39,174,96,.35),inset 0 1px 0 rgba(255,255,255,0.12);}
.bbtn:active:not(:disabled){transform:translateY(0);box-shadow:0 2px 6px rgba(0,0,0,.4),inset 0 1px 4px rgba(0,0,0,.2);}
.bbtn:disabled{background:linear-gradient(145deg,#0e1318,#0a0e10);border-color:rgba(60,72,68,.2);color:#3a4448;cursor:not-allowed;opacity:0.55;}
@keyframes overlayFadeIn{from{opacity:0;transform:translate(-50%,-50%) scale(.95);}to{opacity:1;transform:translate(-50%,-50%) scale(1);}}
@keyframes notifSlide{from{transform:translateY(-20px);opacity:0;}to{transform:translateY(0);opacity:1;}}
/* Section headers in shops/overlays â€” premium chip-style */
#overlay h3{font-size:14px;color:var(--accent);font-weight:700;letter-spacing:0.7px;text-transform:uppercase;margin:18px 0 10px;padding-left:12px;border-left:3px solid var(--accent);}
/* Premium tab strip (used in DAW etc.) */
.tabstrip{display:flex;gap:2px;border-bottom:1px solid var(--border-soft);margin-bottom:18px;padding-bottom:0;background:rgba(8,12,24,0.5);border-radius:10px 10px 0 0;padding:6px 6px 0;}
.tabstrip button{background:transparent;border:none;border-bottom:3px solid transparent;color:var(--text-muted);cursor:pointer;font-family:inherit;font-size:13px;padding:10px 16px 8px;transition:all .18s;font-weight:600;border-radius:6px 6px 0 0;}
.tabstrip button:hover{color:var(--accent);background:rgba(126,200,227,0.05);}
.tabstrip button.active{color:var(--accent);border-bottom-color:var(--accent);background:rgba(126,200,227,0.08);}
/* Premium pill/chip */
.chip{display:inline-flex;align-items:center;gap:4px;background:rgba(126,200,227,0.10);border:1px solid rgba(126,200,227,0.25);color:var(--accent);font-size:11px;font-weight:600;padding:3px 10px;border-radius:14px;letter-spacing:0.3px;}
.chip-gold{background:rgba(241,196,15,0.12);border-color:rgba(241,196,15,0.3);color:var(--accent-warm);}
.chip-green{background:rgba(39,174,96,0.12);border-color:rgba(39,174,96,0.3);color:var(--accent-green);}
.chip-red{background:rgba(231,76,60,0.12);border-color:rgba(231,76,60,0.3);color:var(--accent-red);}
.chip-purple{background:rgba(155,89,182,0.12);border-color:rgba(155,89,182,0.3);color:var(--accent-purple);}

/* â”€â”€ PHONE â”€â”€ */
#phone{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:340px;height:600px;background:linear-gradient(160deg,#0d1424 0%,#080814 60%,#070612 100%);border:2px solid #2a3a5a;border-radius:24px;display:none;flex-direction:column;z-index:50;overflow:hidden;box-shadow:0 12px 48px rgba(0,0,0,.75),0 0 40px rgba(126,200,227,.18),inset 0 1px 0 rgba(255,255,255,.06);}
#phone.on{display:flex;}
.ph-top{background:#080814;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #1a2535;}
.ph-top .pt{font-size:15px;color:#7ec8e3;font-weight:700;font-family:'Orbitron',monospace;letter-spacing:1px;}
.ph-top .px{background:transparent;border:none;color:#556;font-size:20px;cursor:pointer;}
.ph-top .px:hover{color:#e74c3c;}
#ph-content{flex:1;display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;min-height:0;}
.ph-apps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:14px;padding-bottom:24px;}
.ph-app{background:linear-gradient(160deg,#0c1424,#08101e);border:1px solid #1a2535;border-radius:14px;padding:12px 6px 10px;text-align:center;cursor:pointer;transition:all .22s cubic-bezier(.22,.61,.36,1);box-shadow:0 2px 6px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.03);}
.ph-app:hover{background:linear-gradient(160deg,#15203a,#0e1828);border-color:#7ec8e3;transform:scale(1.05) translateY(-1px);box-shadow:0 0 16px rgba(126,200,227,.28),0 6px 12px rgba(0,0,0,.5);}
.ph-app .ai-wrap{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 6px;transition:filter .18s;}
.ph-app:hover .ai-wrap{filter:brightness(1.2) drop-shadow(0 0 5px var(--app-glow,#7ec8e3));}
.ph-app .ai{font-size:26px;line-height:1;}
.ph-app .an{font-size:10px;color:#7ec8e3;line-height:1.3;}
/* v1.8.75: folder ma "stos" 4 mini-ikon w Ĺ›rodku zamiast jednej duĹĽej */
.ph-app.is-folder .ai-wrap{background:rgba(126,200,227,.06)!important;border:1px solid rgba(126,200,227,.18)!important;backdrop-filter:blur(2px);position:relative;}
.ph-app.is-folder .ai-wrap::after{content:'';position:absolute;inset:0;border-radius:12px;background:linear-gradient(135deg,rgba(255,255,255,.06),transparent 60%);pointer-events:none;}
.ph-app.is-folder .ai{display:grid;grid-template-columns:1fr 1fr;gap:2px;font-size:11px;width:36px;height:36px;align-items:center;justify-content:items;text-align:center;}
.ph-app.is-folder .ai span{display:inline-block;line-height:1;font-size:13px;opacity:.95;}
.ph-app.is-folder .an{color:#cfe7f5;font-weight:600;}
.ph-back-btn{background:linear-gradient(180deg,#0c1424,#08101e);border:1px solid #1a2535;color:#7ec8e3;padding:7px 14px;border-radius:8px;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;margin:0 14px 8px;transition:all .15s;}
.ph-back-btn:hover{border-color:#7ec8e3;background:#15203a;}
.ph-folder-title{padding:8px 14px 4px;color:#aac;font-size:11px;letter-spacing:1px;text-transform:uppercase;font-weight:700;}
.ph-notifs{padding:0 16px;flex:1;overflow-y:auto;}
.ph-notif{background:linear-gradient(135deg,#0e1626,#0a1220);border:1px solid #1a2535;border-left:3px solid #2a4a6a;border-radius:8px;padding:10px 12px;margin-bottom:8px;font-size:13px;color:#aaa;transition:all .15s;}
.ph-notif:hover{border-left-color:#7ec8e3;background:linear-gradient(135deg,#121c30,#0c1424);}
.ph-notif .nt{color:#7ec8e3;font-weight:700;font-size:12px;margin-bottom:2px;}
.ph-screen{flex:1;overflow-y:auto;padding:14px;}

/* â”€â”€ MINIGAMES â”€â”€ */
#mg-yt{position:absolute;top:62px;left:0;right:0;bottom:0;background:rgba(3,6,12,.99);display:none;z-index:35;flex-direction:column;align-items:center;justify-content:flex-start;padding:20px 40px;overflow-y:auto;}
#mg-yt.on{display:flex;}
#mg-pizza{position:absolute;top:62px;left:0;right:0;bottom:0;background:rgba(10,8,4,.99);display:none;z-index:35;flex-direction:column;align-items:center;padding:20px 40px;}
#mg-pizza.on{display:flex;}
#mg-edit{position:absolute;top:62px;left:0;right:0;bottom:0;background:rgba(4,6,10,.99);display:none;z-index:35;flex-direction:column;align-items:center;padding:20px 40px;}
#mg-edit.on{display:flex;}
#mg-job{position:absolute;top:62px;left:0;right:0;bottom:0;background:radial-gradient(ellipse at 50% 0%,rgba(40,60,120,.18) 0%,transparent 55%),linear-gradient(160deg,rgba(4,8,16,.99) 0%,rgba(6,10,20,.99) 100%);display:none;z-index:35;flex-direction:column;align-items:center;justify-content:flex-start;padding:20px 40px;overflow-y:auto;}
#mg-job.on{display:flex;}

/* â”€â”€ MENU â€” v1.8.57 redesign: animowane miasto + Ĺ›nieg + gwiazdy â”€â”€ */
#menu{position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(ellipse at 30% 30%,rgba(40,60,120,0.30) 0%,transparent 60%),radial-gradient(ellipse at 80% 70%,rgba(126,200,227,0.12) 0%,transparent 50%),linear-gradient(180deg,#02050f 0%,#040a18 35%,#06122e 65%,#0a1a3a 100%);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:80px 100px;z-index:100;overflow:hidden;}
/* warstwa miasta â€” sylwetka z Ĺ›wiecÄ…cymi oknami */
#menu-city{position:absolute;left:0;right:0;bottom:0;height:42%;pointer-events:none;z-index:1;}
#menu-city svg{position:absolute;bottom:0;left:0;width:100%;height:100%;display:block;}
#menu-city svg .b{filter:drop-shadow(0 -4px 18px rgba(126,200,227,.25));}
#menu-city svg .w{fill:#ffd668;animation:winTwinkle 4s ease-in-out infinite;}
#menu-city svg .w:nth-child(odd){animation-delay:1.2s;}
#menu-city svg .w:nth-child(3n){animation-delay:2.5s;}
@keyframes winTwinkle{0%,100%{opacity:.85}50%{opacity:.45}}
/* warstwa gwiazd â€” kropki migoczÄ…ce */
#menu-stars{position:absolute;inset:0;pointer-events:none;z-index:0;}
#menu-stars span{position:absolute;display:block;width:2px;height:2px;background:#fff;border-radius:50%;animation:starTwinkle 3s ease-in-out infinite;}
@keyframes starTwinkle{0%,100%{opacity:.2;transform:scale(.8)}50%{opacity:.95;transform:scale(1.2);box-shadow:0 0 6px rgba(255,255,255,.7)}}
/* warstwa Ĺ›niegu â€” pĹ‚atki opadajÄ…ce */
#menu-snow{position:absolute;inset:0;pointer-events:none;z-index:2;overflow:hidden;}
#menu-snow span{position:absolute;top:-12px;color:rgba(255,255,255,.75);font-size:14px;line-height:1;animation:snowFall linear infinite;text-shadow:0 0 4px rgba(200,220,255,.7);}
@keyframes snowFall{0%{transform:translateY(-20px) translateX(0) rotate(0deg);opacity:0}5%{opacity:.85}95%{opacity:.85}100%{transform:translateY(110vh) translateX(40px) rotate(360deg);opacity:0}}
/* ksiÄ™ĹĽyc/aura â€” subtelny glow w prawym gĂłrnym rogu */
#menu-moon{position:absolute;top:80px;right:140px;width:120px;height:120px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#e8eef8 0%,#a8b8d0 50%,#5a6a8a 100%);box-shadow:0 0 90px rgba(168,184,208,.45),0 0 180px rgba(126,200,227,.18);z-index:1;pointer-events:none;animation:moonFloat 8s ease-in-out infinite;}
@keyframes moonFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
/* zawartoĹ›Ä‡ menu nad warstwami â€” ale NIE warstwy tĹ‚a (gwiazdy/miasto/snieg/ksiÄ™ĹĽyc), ĹĽeby ich position:absolute zostaĹ‚o zachowane */
#menu>*:not(#menu-stars):not(#menu-moon):not(#menu-city):not(#menu-snow):not(.ver){position:relative;z-index:5;}
#menu h1{font-family:'Russo One','Orbitron',Impact,sans-serif;font-size:84px;font-weight:900;color:#fff;letter-spacing:3px;margin-bottom:2px;text-shadow:0 0 80px rgba(126,200,227,.35),0 0 40px rgba(126,200,227,.2);background:linear-gradient(180deg,#fff 0%,#cfe7f5 70%,#7ec8e3 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 30px rgba(126,200,227,.4));}
#menu .msub{font-size:14px;color:#7ec8e3;letter-spacing:5px;text-transform:uppercase;margin-bottom:50px;opacity:.85;}
.mbtn{background:linear-gradient(145deg,rgba(20,40,72,0.6),rgba(10,22,42,0.6));border:1px solid rgba(126,200,227,0.2);color:#cfe7f5;font-family:inherit;font-size:19px;padding:22px 36px;margin-bottom:12px;cursor:pointer;letter-spacing:1px;text-transform:none;transition:all .22s cubic-bezier(0.22,0.61,0.36,1);min-width:420px;width:auto;text-align:center;border-radius:10px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 4px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);position:relative;overflow:hidden;font-weight:600;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;line-height:1;}
/* v1.8.29: shimmer w wrapper ĹĽeby nie cropowaÄ‡ tekstu przyciskowego */
.mbtn::before{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(126,200,227,0.18),transparent);transition:left .6s ease;pointer-events:none;border-radius:inherit;clip-path:inset(0);}
.mbtn:hover:not(:disabled){background:linear-gradient(145deg,rgba(40,80,140,0.85),rgba(20,42,82,0.85));border-color:rgba(126,200,227,0.7);color:#fff;transform:translateX(6px);box-shadow:0 8px 28px rgba(126,200,227,.25),inset 0 1px 0 rgba(255,255,255,.1);}
.mbtn:hover::before{left:130%;}
.mbtn:disabled{border-color:rgba(40,60,90,0.2);color:#2a3548;cursor:not-allowed;opacity:.4;background:transparent;}
.mbtn:disabled:hover{transform:none;box-shadow:none;}
#menu .ver{position:absolute;bottom:16px;left:100px;color:#9eb0c8;font-size:12px;letter-spacing:.5px;background:rgba(8,12,24,0.78);padding:4px 10px;border-radius:6px;border:1px solid rgba(60,80,110,0.4);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:10;white-space:nowrap;}

/* â”€â”€ CREATOR â€” v1.8.19 redesign â”€â”€ */
#creator{position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(ellipse at 50% 0%,rgba(40,60,120,0.2) 0%,transparent 50%),linear-gradient(160deg,#020610,#040a18);display:none;flex-direction:column;justify-content:center;align-items:center;z-index:100;padding:40px;}
#creator h2{font-size:36px;color:#fff;margin-bottom:6px;font-weight:800;letter-spacing:.5px;background:linear-gradient(180deg,#fff,#cfe7f5);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
#creator .csub{color:#7a8aa0;font-size:14px;margin-bottom:32px;letter-spacing:2px;text-transform:uppercase;font-weight:500;}
.creator-body{display:flex;gap:48px;align-items:flex-start;}
.char-preview{width:240px;height:340px;background:radial-gradient(ellipse at center,rgba(126,200,227,0.06) 0%,rgba(10,18,32,0.85) 70%);border:1px solid rgba(126,200,227,0.18);border-radius:14px;display:flex;align-items:center;justify-content:center;position:relative;box-sizing:content-box;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 8px 32px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.04);}
.char-preview::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(126,200,227,0.3),transparent);}
#char-canvas{pointer-events:none;}
.creator-opts{display:flex;flex-direction:column;gap:16px;}
.copt{display:flex;flex-direction:column;gap:8px;}
.copt label{font-size:11px;color:#7a8aa0;text-transform:uppercase;letter-spacing:1.4px;font-weight:600;}
.copt-btns{display:flex;gap:8px;flex-wrap:wrap;}
.copt-btn{background:linear-gradient(145deg,rgba(14,22,40,0.7),rgba(10,16,30,0.7));border:1px solid rgba(126,200,227,0.18);color:#cfe7f5;font-size:13px;padding:9px 18px;cursor:pointer;border-radius:8px;transition:all .18s;font-family:inherit;font-weight:500;backdrop-filter:blur(4px);}
.copt-btn:hover{background:linear-gradient(145deg,rgba(28,44,72,0.8),rgba(18,28,52,0.8));border-color:rgba(126,200,227,0.45);color:#fff;transform:translateY(-1px);}
.copt-btn.active{background:linear-gradient(145deg,rgba(40,80,140,0.85),rgba(20,42,82,0.85));border-color:rgba(126,200,227,0.7);color:#fff;box-shadow:0 4px 14px rgba(126,200,227,.25),inset 0 1px 0 rgba(255,255,255,.08);}
.name-inp{background:linear-gradient(145deg,rgba(14,22,40,0.7),rgba(10,16,30,0.7));border:1px solid rgba(126,200,227,0.25);color:#fff;font-family:inherit;font-size:17px;padding:11px 16px;border-radius:8px;width:260px;transition:all .18s;}
.name-inp:focus{outline:none;border-color:rgba(126,200,227,0.7);background:linear-gradient(145deg,rgba(20,32,54,0.8),rgba(14,22,42,0.8));box-shadow:0 0 0 3px rgba(126,200,227,.1);}
.start-btn{background:linear-gradient(145deg,#8edff5,#5ab4d2);border:1px solid rgba(126,200,227,0.7);color:#020a14;font-family:inherit;font-size:17px;font-weight:800;padding:14px 48px;cursor:pointer;border-radius:10px;margin-top:14px;letter-spacing:1.5px;transition:all .22s cubic-bezier(0.22,0.61,0.36,1);text-transform:uppercase;box-shadow:0 8px 24px rgba(126,200,227,.4),inset 0 1px 0 rgba(255,255,255,.3);}
.start-btn:hover{background:linear-gradient(145deg,#a8e8f8,#7ec8e3);transform:translateY(-2px);box-shadow:0 12px 32px rgba(126,200,227,.55),inset 0 1px 0 rgba(255,255,255,.35);}

/* â”€â”€ NPC DIALOGUE â”€â”€ */
#npc-dlg{position:absolute;bottom:80px;left:50%;transform:translateX(-50%);min-width:500px;max-width:720px;background:linear-gradient(135deg,rgba(8,14,28,.97),rgba(12,18,34,.97));border:1.5px solid #3a5a7a;border-radius:12px;padding:18px 24px 16px 80px;z-index:40;display:none;box-shadow:0 8px 32px rgba(0,0,0,.55),0 0 24px rgba(126,200,227,.12);animation:npcDlgIn .25s ease-out;}
#npc-dlg.on{display:block;}
#npc-dlg::before{content:'';position:absolute;top:14px;left:14px;width:54px;height:54px;border-radius:50%;background:linear-gradient(135deg,#1a2a3a,#0a1525);border:2px solid #7ec8e3;box-shadow:0 0 12px rgba(126,200,227,.35),inset 0 -2px 6px rgba(0,0,0,.4);}
#npc-dlg::after{content:attr(data-emoji);position:absolute;top:18px;left:18px;width:46px;height:46px;display:flex;align-items:center;justify-content:center;font-size:30px;line-height:1;}
#npc-dlg .npc-name{font-size:15px;color:#7ec8e3;font-weight:800;margin-bottom:6px;letter-spacing:.5px;}
#npc-dlg .npc-text{font-size:15px;color:#dde;margin-bottom:14px;line-height:1.55;font-style:italic;}
#npc-dlg .npc-opts{display:flex;gap:8px;flex-wrap:wrap;}
#npc-dlg .npc-opt{background:#0a1a2a;border:1px solid #2a4a6a;color:#7ec8e3;font-family:inherit;font-size:13px;padding:8px 14px;cursor:pointer;border-radius:6px;transition:all .15s;}
#npc-dlg .npc-opt:hover:not(:disabled){background:#1a2a4a;border-color:#5a8aaa;color:#aedce8;transform:translateY(-1px);box-shadow:0 3px 8px rgba(126,200,227,.2);}
#npc-dlg .npc-opt:disabled{cursor:not-allowed;}
@keyframes npcDlgIn{0%{opacity:0;transform:translateX(-50%) translateY(12px);}100%{opacity:1;transform:translateX(-50%) translateY(0);}}
.npc-opt{background:#0a1a2a;border:1px solid #1a3a5a;color:#7ec8e3;font-family:inherit;font-size:13px;padding:8px 16px;cursor:pointer;border-radius:4px;transition:all .1s;}
.npc-opt:hover{background:#1a3a5a;}
@keyframes fpspop{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes scare{from{transform:scale(.8) rotate(-5deg);opacity:0}to{transform:scale(1) rotate(0deg);opacity:1}}
@keyframes fs-shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
@keyframes overlayFadeIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes floatUp{0%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-60px)}}
@keyframes confettiFall{0%{transform:translateY(-20px) rotate(0deg);opacity:1}100%{transform:translateY(120px) rotate(720deg);opacity:0}}
@keyframes pulseGold{0%,100%{text-shadow:0 0 4px rgba(241,196,15,.3);opacity:1}50%{text-shadow:0 0 14px rgba(241,196,15,.95);opacity:0.85}}
@keyframes welcomeIn{0%{opacity:0;transform:translate(-50%,-50%) scale(.85)}100%{opacity:1;transform:translate(-50%,-50%) scale(1)}}
@keyframes bdFadeIn{0%{opacity:0}100%{opacity:1}}
/* v1.9.99: ukryj HUD i UI podczas cinematic flythrough â€” pure cinematic experience */
/* v2.1.21: visibility:hidden ĹĽeby HUD background gradient zniknÄ…Ĺ‚ natychmiast (nie tylko opacity).
   WczeĹ›niej HUD bg widaÄ‡ byĹ‚o pod letterboxem na wiÄ™kszych viewportach (scale>1). */
body.cinematic-active #hud,
body.cinematic-active #minimap-wrap,
body.cinematic-active #quest-widget,
body.cinematic-active #hclock,
body.cinematic-active #ms-track-pill,
body.cinematic-active #prompt,
body.cinematic-active #hphone{opacity:0!important;visibility:hidden!important;pointer-events:none!important;transition:opacity .6s ease-out;} /* v2.1.199: #prompt teĹĽ ukryty â€” user feedback "widaÄ‡ [E] WejdĹş - Traphouse podczas cinematic" */
@keyframes fmapHalo{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.85}50%{transform:translate(-50%,-50%) scale(1.4);opacity:.4}}
@keyframes skillPtPulse{0%,100%{box-shadow:0 0 0 0 rgba(241,196,15,.7),0 0 8px rgba(241,196,15,.3);border-color:#f1c40f}50%{box-shadow:0 0 0 6px rgba(241,196,15,0),0 0 16px rgba(241,196,15,.55);border-color:#ffd84a}}
canvas#hud-face.skillpt-ready{animation:skillPtPulse 1.4s ease-in-out infinite;border-color:#f1c40f!important}
#hlvl.skillpt-ready{color:#f1c40f!important;animation:skillPtPulse 1.4s ease-in-out infinite}
@keyframes pulse-gold{0%,100%{box-shadow:0 0 0 0 rgba(200,165,32,.4)}50%{box-shadow:0 0 0 8px rgba(200,165,32,0)}}
@keyframes ripple{0%{transform:scale(0);opacity:.6}100%{transform:scale(3);opacity:0}}
@keyframes slideDown{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:translateY(0)}}
@keyframes crowdBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes spotlightSwing{0%{transform:rotate(-15deg);opacity:.2}50%{opacity:.35}100%{transform:rotate(15deg);opacity:.2}}
.crowd-hype span{animation:crowdBounce .4s ease-in-out infinite;display:inline-block}
.crowd-hype span:nth-child(even){animation-delay:.2s}
.spotlight-anim{animation:spotlightSwing 2s ease-in-out infinite alternate}
#overlay.on,#mg-job.on,#mg-yt.on,#mg-pizza.on,#mg-edit.on{animation:overlayContent .35s cubic-bezier(0.22,0.61,0.36,1);}
.float-gain{position:fixed;font-size:16px;font-weight:700;pointer-events:none;z-index:9999;animation:floatUp 1.2s ease-out forwards;}
.dbtn,.bbtn,.cbtn{position:relative;overflow:hidden;}
/* v1.8.19: deprecated overrides usuniÄ™te â€” peĹ‚na definicja stylĂłw w sekcji OVERLAY redesign powyĹĽej */
/* ph-app hover defined in main CSS block above */
.npc-opt:hover{background:#1a3a5a;transform:translateY(-1px);}
/* â”€â”€ v1.8.20: ANIMACJE I MIKROINTERAKCJE â”€â”€ */
/* Stagger fadeInUp dla kart/itemĂłw */
@keyframes staggerFadeIn{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
.cards>.card,.shopgrid>.sitem{animation:staggerFadeIn .5s cubic-bezier(0.22,0.61,0.36,1) both;}
.cards>.card:nth-child(1),.shopgrid>.sitem:nth-child(1){animation-delay:.05s;}
.cards>.card:nth-child(2),.shopgrid>.sitem:nth-child(2){animation-delay:.10s;}
.cards>.card:nth-child(3),.shopgrid>.sitem:nth-child(3){animation-delay:.15s;}
.cards>.card:nth-child(4),.shopgrid>.sitem:nth-child(4){animation-delay:.20s;}
.cards>.card:nth-child(5),.shopgrid>.sitem:nth-child(5){animation-delay:.25s;}
.cards>.card:nth-child(6),.shopgrid>.sitem:nth-child(6){animation-delay:.30s;}
.cards>.card:nth-child(7),.shopgrid>.sitem:nth-child(7){animation-delay:.35s;}
.cards>.card:nth-child(8),.shopgrid>.sitem:nth-child(8){animation-delay:.40s;}
/* Menu buttons stagger */
.mbtn{animation:staggerFadeIn .5s cubic-bezier(0.22,0.61,0.36,1) both;}
.mbtn:nth-child(1){animation-delay:.1s;}.mbtn:nth-child(2){animation-delay:.18s;}
.mbtn:nth-child(3){animation-delay:.26s;}.mbtn:nth-child(4){animation-delay:.34s;}
.mbtn:nth-child(5){animation-delay:.42s;}.mbtn:nth-child(6){animation-delay:.50s;}
#menu h1{animation:staggerFadeIn .6s cubic-bezier(0.22,0.61,0.36,1) both;}
#menu .msub{animation:staggerFadeIn .6s cubic-bezier(0.22,0.61,0.36,1) .15s both;}

/* Floating emoji animation (dla kart z duĹĽym emoji) */
@keyframes emojiFloat{0%,100%{transform:translateY(0) rotate(-1deg);}50%{transform:translateY(-6px) rotate(1deg);}}
.emoji-float{animation:emojiFloat 3.5s ease-in-out infinite;display:inline-block;}

/* Glow pulse na CTA buttonach */
@keyframes ctaGlow{0%,100%{box-shadow:0 6px 18px rgba(39,174,96,.35),inset 0 1px 0 rgba(255,255,255,.15),0 0 0 0 rgba(46,175,90,.4);}50%{box-shadow:0 6px 22px rgba(39,174,96,.5),inset 0 1px 0 rgba(255,255,255,.2),0 0 0 8px rgba(46,175,90,0);}}
.cta-pulse{animation:ctaGlow 2.4s ease-in-out infinite;}
@keyframes ctaGlowGold{0%,100%{box-shadow:0 6px 18px rgba(200,165,32,.4),inset 0 1px 0 rgba(255,255,255,.2),0 0 0 0 rgba(241,196,15,.4);}50%{box-shadow:0 8px 26px rgba(200,165,32,.55),inset 0 1px 0 rgba(255,255,255,.25),0 0 0 10px rgba(241,196,15,0);}}
.cta-pulse-gold{animation:ctaGlowGold 2.4s ease-in-out infinite;}

/* Ripple effect na button click */
.dbtn,.bbtn,.cbtn,.mbtn{position:relative;overflow:hidden;}
@keyframes btnRipple{from{transform:scale(0);opacity:.55;}to{transform:scale(3);opacity:0;}}
.btn-ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);pointer-events:none;animation:btnRipple .65s ease-out;}

/* Ambient particles container (dla wnÄ™trz kasyna/studia) */
@keyframes ambientFloat{0%{transform:translateY(100vh) translateX(0);opacity:0;}10%{opacity:.6;}90%{opacity:.6;}100%{transform:translateY(-20px) translateX(40px);opacity:0;}}
.ambient-particle{position:absolute;width:3px;height:3px;border-radius:50%;background:rgba(126,200,227,.5);pointer-events:none;animation:ambientFloat 14s linear infinite;box-shadow:0 0 6px rgba(126,200,227,.4);}

/* HUD bars smooth fill */
#bhp,#ben,#bhu,#bst,#bfa,#hbarfo{transition:width .4s cubic-bezier(0.22,0.61,0.36,1)!important;}

/* Phone app icons hover bounce */
.ph-app{transition:all .22s cubic-bezier(0.34,1.56,0.64,1)!important;}
.ph-app:hover{transform:scale(1.08) translateY(-2px)!important;}
@keyframes phoneIconBob{0%,100%{transform:translateY(0);}50%{transform:translateY(-3px);}}
.ph-app:hover .ai{animation:phoneIconBob .6s ease-in-out infinite;}

/* Chip-gold shimmer (wÄ™drujÄ…ca poĹ›wiata przez zĹ‚oty chip) */
.chip-gold{position:relative;overflow:hidden;}
.chip-gold::after{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(241,196,15,.4),transparent);animation:chipShimmer 3.5s linear infinite;}
@keyframes chipShimmer{0%{left:-100%;}60%,100%{left:160%;}}

/* Hover lift na clickable divach (.card-clickable utility) */
.card-clickable{transition:all .22s cubic-bezier(0.22,0.61,0.36,1);cursor:pointer;}
.card-clickable:hover{transform:translateY(-3px) scale(1.02);}

/* Number tick animation â€” gdy gracz dostaje kasÄ™ */
@keyframes numTick{0%{transform:scale(1);color:inherit;}50%{transform:scale(1.18);color:#2eaf5a;text-shadow:0 0 12px rgba(39,174,96,.6);}100%{transform:scale(1);color:inherit;}}
.num-tick{animation:numTick .6s cubic-bezier(0.34,1.56,0.64,1);}

/* Overlay enter â€” improved */
#overlay.on{animation:overlayContent .4s cubic-bezier(0.22,0.61,0.36,1);}

/* Pulse glow dla focus elementĂłw */
@keyframes focusGlow{0%,100%{box-shadow:0 0 0 0 rgba(126,200,227,.4);}50%{box-shadow:0 0 0 6px rgba(126,200,227,0);}}
.focus-pulse{animation:focusGlow 2s ease-in-out infinite;}

/* v1.8.19: stare .card override usuniÄ™te â€” uĹĽywamy redesign z gĂłry */

/* v2.1.146: TOUCH/MOBILE SUPPORT â€” virtual joystick + action button + phone button.
   Hidden by default, visible tylko gdy body.touch-device class jest aktywna.
   Position:fixed elements MUSZÄ„ byÄ‡ w document.body NIE #wrap (memory rule transform:scale bug). */
.touch-control{display:none;}
body.touch-device .touch-control{display:flex;}
#touch-joystick{
  position:fixed; left:24px; bottom:24px; width:140px; height:140px;
  background:radial-gradient(circle,rgba(40,60,90,.45) 0%,rgba(20,30,50,.65) 80%);
  border:2px solid rgba(120,180,220,.4); border-radius:50%;
  z-index:9999; touch-action:none; user-select:none; -webkit-user-select:none;
  align-items:center; justify-content:center;
}
#touch-joystick-thumb{
  width:60px; height:60px;
  background:radial-gradient(circle,rgba(126,200,227,.85) 0%,rgba(52,152,219,.7) 100%);
  border:2px solid rgba(255,255,255,.4); border-radius:50%;
  box-shadow:0 0 12px rgba(126,200,227,.6); pointer-events:none;
  transition:transform .05s linear;
}
#touch-action,#touch-phone{
  position:fixed; right:24px; z-index:9999; touch-action:none;
  user-select:none; -webkit-user-select:none;
  border-radius:50%; align-items:center; justify-content:center;
  font-family:inherit; font-weight:800; cursor:pointer;
  box-shadow:0 4px 12px rgba(0,0,0,.5);
}
#touch-action{
  bottom:96px; width:84px; height:84px;
  background:radial-gradient(circle,#27ae60 0%,#0a3a1a 90%);
  border:2px solid #7ec87e; color:#fff; font-size:28px;
}
#touch-phone{
  bottom:24px; width:64px; height:64px;
  background:radial-gradient(circle,#3498db 0%,#0a2a4a 90%);
  border:2px solid #7ec8e3; color:#fff; font-size:24px;
}
#touch-action:active,#touch-phone:active{transform:scale(.92);}
body.touch-device #touch-joystick,
body.touch-device #touch-action,
body.touch-device #touch-phone{display:flex;}
/* Tablet/desktop hide nawet jeĹ›li touch device (np. Surface) â€” pokazuj tylko gdy width<900px LUB user opt-in */
@media (min-width:900px){
  body.touch-device:not(.touch-force) #touch-joystick,
  body.touch-device:not(.touch-force) #touch-action,
  body.touch-device:not(.touch-force) #touch-phone{display:none;}
}

/* v2.1.153: MOBILE UI ADJUSTMENTS â€” toast smaller, joystick wyĹĽej (poza home bar gestures), modale responsive */
@media (max-width:900px){
  /* Toast (#msg) â€” mniejszy font, padding, max-width ĹĽeby nie wystawaĹ‚ */
  #msg{font-size:15px!important;padding:12px 20px!important;max-width:92vw!important;bottom:18px!important;border-width:2px!important;border-radius:10px!important;letter-spacing:0!important;}
  /* Joystick wyĹĽej â€” bottom 24â†’90 ĹĽeby nie kolidowaĹ‚ z iOS home bar / Android gesture bar */
  #touch-joystick{bottom:90px!important;left:18px!important;width:120px!important;height:120px!important;}
  #touch-joystick-thumb{width:52px!important;height:52px!important;}
  /* Action button â€” proportionalnie wyĹĽej + mniejszy */
  #touch-action{bottom:170px!important;right:18px!important;width:72px!important;height:72px!important;font-size:24px!important;}
  /* Phone button â€” mirror joystick height */
  #touch-phone{bottom:90px!important;right:18px!important;width:56px!important;height:56px!important;font-size:22px!important;}
  /* Character creator mobile-friendly */
  #creator{padding:14px!important;overflow-y:auto!important;justify-content:flex-start!important;}
  #creator h2{font-size:24px!important;margin-bottom:4px!important;}
  #creator .csub{font-size:11px!important;margin-bottom:14px!important;letter-spacing:1px!important;}
  .creator-body{flex-direction:column!important;gap:14px!important;align-items:center!important;width:100%!important;}
  .creator-opts{width:100%!important;max-width:340px!important;gap:10px!important;}
  .copt label{font-size:11px!important;}
  .copt-btn{font-size:11px!important;padding:7px 12px!important;}
  .copt-btns{justify-content:center!important;}
  .name-inp{width:100%!important;max-width:280px!important;font-size:14px!important;padding:9px 12px!important;}
  .char-preview canvas{max-width:160px!important;max-height:227px!important;width:160px!important;height:227px!important;}
}
@media (max-width:900px) and (orientation:portrait){
  /* Portrait specific â€” joystick moĹĽe byÄ‡ NIĹ»EJ bo ekran wyĹĽszy, ALE wciÄ…ĹĽ omijaÄ‡ home bar */
  #touch-joystick{bottom:120px!important;}
  #touch-action{bottom:200px!important;}
  #touch-phone{bottom:120px!important;}
}
/* v2.1.153: Milestone cinematic responsive (inline styles override) */
@media (max-width:900px){
  #milestone-cinematic #ms-stage{padding:0 16px!important;}
  #milestone-cinematic #ms-emoji{font-size:72px!important;margin-bottom:12px!important;}
  #milestone-cinematic #ms-title{font-size:32px!important;letter-spacing:2px!important;}
  #milestone-cinematic #ms-sub{font-size:16px!important;margin-top:10px!important;}
  #milestone-cinematic #ms-tag{font-size:11px!important;margin-top:8px!important;letter-spacing:.5px!important;}
  #milestone-cinematic #ms-skip{bottom:12px!important;right:12px!important;padding:5px 10px!important;font-size:9px!important;}
  /* Modal overlays generic â€” max width 92vw na mobile */
  #ov, #ov-content{max-width:96vw!important;}
  /* Overlay padding mniejszy */
  #ov-content{padding:14px!important;}
  /* HUD bars mniejsze fonty */
  #hud{padding:0 8px!important;padding-right:85px!important;height:56px!important;gap:2px!important;}
  /* Phone overlay mobile-friendly */
  #phone{width:92vw!important;max-width:340px!important;height:auto!important;max-height:88vh!important;}
  /* Menu â€” mniej padding, mniejszy h1 */
  #menu{padding:24px 18px!important;}
  #menu h1{font-size:42px!important;letter-spacing:1px!important;}
  #menu .csub, #menu p{font-size:12px!important;}
  #menu-moon{top:24px!important;right:24px!important;width:64px!important;height:64px!important;}
  /* Menu buttons compact â€” min-width:420px wystawaĹ‚, white-space:nowrap blokowaĹ‚ zawijanie */
  .mbtn{font-size:13px!important;padding:10px 16px!important;min-width:0!important;max-width:92vw!important;width:92vw!important;white-space:normal!important;}
  /* Overlay h2 mniejszy */
  #overlay h2, .modal h2, #ov-content h2{font-size:22px!important;}
  /* Shop items â€” fluid width, 1 column max-width 92vw */
  .sitem{width:auto!important;min-width:140px!important;max-width:92vw!important;padding:12px!important;}
  .sitem h3{font-size:14px!important;}
  .sitem p{font-size:11px!important;}
  .shopgrid{justify-content:center!important;gap:10px!important;}
  /* Buttons cbtn/bbtn/dbtn â€” mniejsze fonty */
  .cbtn, .bbtn, .dbtn{font-size:12px!important;padding:7px 14px!important;}
  /* Minigame overlays padding zmniejszony */
  #mg-yt, #mg-pizza, #mg-edit, #mg-job{padding:14px 12px!important;top:56px!important;}
  /* HUD elementy max-width zmniejszony â€” money/follow */
  #hud .hbig{font-size:14px!important;}
  #hud .hsml{font-size:9px!important;}
  /* Sleep overlay font */
  #sleep-overlay{top:56px!important;}
  /* Stat bars â€” mniej padding */
  .sbox{min-width:80px!important;padding:8px!important;}
  /* Cards (overlay content) */
  .cards{gap:8px!important;}
  .card{padding:12px!important;font-size:12px!important;}
  /* Prompt (interaction hint) â€” smaller */
  #prompt{font-size:14px!important;padding:8px 18px!important;bottom:50px!important;}
  /* NPC dialog â€” min-width:500px wystawaĹ‚ na mobile! */
  #npc-dlg{min-width:0!important;max-width:92vw!important;width:92vw!important;padding:14px 14px 14px 56px!important;font-size:13px!important;bottom:60px!important;}
  /* NPC emoji w left padding â€” mniejszy */
  #npc-dlg::after{font-size:24px!important;top:14px!important;left:14px!important;width:36px!important;height:36px!important;}
  /* Patch notes / help overlay */
  #patch-notes-modal, #help-modal{max-width:96vw!important;max-height:88vh!important;padding:14px!important;font-size:12px!important;}
  /* Confirm/Alert modals (game-modal jest realnym ID) */
  #game-modal{max-width:92vw!important;padding:18px 20px!important;font-size:13px!important;}
  #game-modal button{padding:8px 18px!important;font-size:12px!important;}
  /* Cinematic offer modal (przelot kamerÄ…) */
  #cinem-offer > div{max-width:92vw!important;padding:20px 22px!important;}
  #cinem-offer h2{font-size:18px!important;letter-spacing:1px!important;}
  #cinem-offer p{font-size:12px!important;}
  #cinem-offer button{padding:10px 16px!important;font-size:13px!important;margin:4px!important;}
  /* Trash bin modal */
  #trash-modal{max-width:96vw!important;max-height:88vh!important;}
  /* Slot rename modal â€” juĹĽ ma 90% width */
  /* DAW overlay buttons â€” mniejszy padding */
  .mix-row{padding:6px 10px!important;font-size:12px!important;}
  /* Phone apps grid â€” 3 cols zostaje ale mniejsze ikony */
  .ph-apps{padding:10px!important;gap:8px!important;}
  .ph-app{font-size:10px!important;}
  /* Achievement popup â€” min-width 380px wystawaĹ‚ na mobile portrait, naprawiamy */
  #ach-popup{min-width:0!important;max-width:92vw!important;padding:16px 18px!important;border-width:2px!important;}
  #ach-popup > div:nth-child(1){font-size:11px!important;letter-spacing:1px!important;}
  #ach-popup > div:nth-child(2){font-size:42px!important;margin:6px 0!important;}
  #ach-popup > div:nth-child(3){font-size:17px!important;}
  #ach-popup > div:nth-child(4){font-size:11px!important;max-width:280px!important;margin-bottom:8px!important;}
  #ach-popup > div:nth-child(5){font-size:11px!important;}
}
/* Very small phones â€” extra compact */
@media (max-width:380px){
  #menu h1{font-size:32px!important;}
  #phone{width:96vw!important;}
  .sitem{font-size:11px!important;}
  #msg{font-size:13px!important;padding:10px 14px!important;}
}
/* v2.1.155: Mobile pre-game â€” body.mobile-pregame ustawia #wrap full viewport, menu/creator natywne pixele.
   scaleGame() ustawia body.mobile-pregame gdy gracz w menu/creator na mobile. */
body.mobile-pregame #wrap{position:fixed!important;width:100vw!important;height:100vh!important;transform:none!important;left:0!important;top:0!important;overflow:auto!important;}
body.mobile-pregame #menu, body.mobile-pregame #creator{width:100vw!important;height:auto!important;min-height:100vh!important;}
/* v2.1.156: padding-top ĹĽeby rotate hint NIE zachodziĹ‚ na content + scroll OK */
body.mobile-pregame #creator{padding-top:54px!important;padding-bottom:30px!important;}
body.mobile-pregame #menu{padding-top:30px!important;padding-bottom:30px!important;}
body.mobile-pregame #gc, body.mobile-pregame #hud, body.mobile-pregame #dmg-overlay{display:none!important;}
/* Rotate hint NIE pokazuj w landscape (kolizja z menu prawej strony) */
@media (orientation:landscape){#rotate-hint{display:none!important;}}
/* Intro cinematic title â€” moĹĽe wystawaÄ‡ na bardzo wÄ…skich. Override font-size. */
/* Intro cinematic â€” fonty responsive (88px wystawa za szeroko na mobile portrait) */
@media (max-width:900px){
  #ic-logo{font-size:44px!important;letter-spacing:2px!important;}
  #ic-logo span{letter-spacing:4px!important;}
  #ic-tagline{font-size:11px!important;letter-spacing:3px!important;}
  #ic-greet{font-size:24px!important;margin-top:30px!important;}
  #ic-quote{font-size:13px!important;margin-top:14px!important;}
  #ic-skip{bottom:14px!important;right:14px!important;padding:6px 12px!important;font-size:10px!important;}
}

/* v2.1.154: Minigame canvases â€” universal fix dla 15+ minigame canvas elementĂłw z fixed width 500-760px.
   Canvases zachowujÄ… aspect ratio (height:auto + max-width:90vw skaluje canvas-element CSS, nie jego internal resolution).
   Plus minigame overlays scrollable horizontally jeĹ›li canvas wystaje. */
@media (max-width:900px){
  /* Wszystkie canvas w minigame overlays â€” fluid width */
  #mg-job canvas, #mg-yt canvas, #mg-pizza canvas, #mg-edit canvas, #ov canvas:not(#char-canvas):not(#hud-face){
    max-width:92vw!important; height:auto!important; display:block!important;
  }
  /* Wymuszamy overflow-x na minigame containers ĹĽeby canvas mĂłgĹ‚ skalowaÄ‡ */
  #mg-job > *, #mg-yt > *, #mg-pizza > *, #mg-edit > *{
    max-width:96vw!important;
  }
  /* Freestyle minigame word box (L23704) â€” fixed 680px wystaje */
  #fs-wordarea, [id="fs-wordarea"]{max-width:88vw!important;}
  div[style*="width:680px"]{max-width:92vw!important;width:auto!important;}
  /* Treadmill stamina bar (L24536) â€” fixed 700px */
  #tm-stambar{width:100%!important;}
  div[style*="width:700px"]:has(#tm-stambar), .tm-bar-wrap{max-width:92vw!important;}
  /* FPS arena (L15821) â€” fixed 700px */
  #fps-arena{max-width:92vw!important;width:92vw!important;height:auto!important;aspect-ratio:700/340!important;}
  /* Beat sequencer drum pads grid â€” 16 Ă— 46px = 736px, overflow horizontally */
  #mg-job > div:has([style*="repeat("]){overflow-x:auto!important;max-width:96vw!important;}
  /* DAW mixer row â€” flex wrap dla mobile */
  .mix-row{flex-wrap:wrap!important;gap:6px!important;}
  .mix-row label{min-width:auto!important;flex-basis:100%!important;font-size:12px!important;}
  .mix-row input[type="range"]{width:100%!important;flex:1!important;}
  .mix-row span{min-width:30px!important;}
  /* Lyrics 4-col grid â†’ 2-col na bardzo maĹ‚ych ekranach */
  #mg-job div[style*="repeat(4,1fr)"]{grid-template-columns:repeat(3,1fr)!important;}
}
@media (max-width:500px){
  /* Bardzo maĹ‚e phones â€” lyrics 2-col */
  #mg-job div[style*="repeat(4,1fr)"]{grid-template-columns:repeat(2,1fr)!important;}
}
/* v2.1.154 hotfix: skill tree panel + rest overlay + cinematic confirm dla mobile */
@media (max-width:900px){
  /* Skill tree panel (charPanel) â€” min-width:400px wystawaĹ‚, plus h2 nowrap */
  div[style*="min-width:400px"]{min-width:0!important;width:100%!important;}
  /* Skill tree h2 â€” nowrap â†’ wrap na mobile */
  div[style*="min-width:400px"] h2{white-space:normal!important;font-size:18px!important;}
  /* Rest overlay (sofa/Ĺ‚awka) â€” min-width:340 moĹĽe wystawaÄ‡ <340px */
  #rest-overlay{min-width:0!important;max-width:92vw!important;padding:12px 18px!important;}
  /* Cinematic confirm modal â€” min-width:340 */
  div[style*="min-width:340px"]:not(#phone){min-width:0!important;max-width:92vw!important;}
  /* Character panel ogĂłlnie */
  #char-panel{padding:14px!important;max-width:96vw!important;}
  /* Lock white-space:nowrap headers ĹĽeby zawijaĹ‚y */
  h2[style*="white-space:nowrap"], h3[style*="white-space:nowrap"]{white-space:normal!important;}
}
</style>
</head>
<body>
<div id="wrap">
<canvas id="gc" width="1280" height="720"></canvas>
<div id="dmg-overlay" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:8;border-radius:0;display:none;clip-path:polygon(0 0,100% 0,100% 100%,232px 100%,232px 654px,0 654px);"></div>

<!-- HUD -->
<div id="hud">
  <div onclick="toggleCharPanel()" title="Kliknij â€” statystyki i drzewko umiejÄ™tnoĹ›ci" style="position:relative;cursor:pointer;flex-shrink:0;pointer-events:all;width:54px;height:54px">
    <canvas id="hud-face" width="54" height="54" style="border-radius:50%;border:2px solid #2a3a5a;image-rendering:pixelated;pointer-events:none;width:54px;height:54px;display:block;"></canvas>
    <div id="hlvl" style="position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);background:rgba(8,14,28,.95);border:1.5px solid #2a3a50;color:#7ec8e3;font-size:10px;font-weight:800;white-space:nowrap;line-height:1;pointer-events:none;padding:2px 6px;border-radius:8px;letter-spacing:.5px">Lvl 1</div>
  </div>
  <div class="hdiv"></div>
  <div class="hs" data-tip="health"><span class="ico">âť¤ď¸Ź</span><div class="hbar"><div class="hfill fhp" id="bhp" style="width:100%"></div></div><span class="hv" id="vhp">100</span></div>
  <div class="hs" data-tip="energy"><span class="ico">âšˇ</span><div class="hbar"><div class="hfill fen" id="ben" style="width:100%"></div></div><span class="hv" id="ven">100</span></div>
  <div class="hs" data-tip="hunger"><span class="ico">đźŤ”</span><div class="hbar"><div class="hfill fhu" id="bhu" style="width:100%"></div></div><span class="hv" id="vhu">100</span></div>
  <div class="hs" data-tip="fame"><span class="ico">â­</span><div class="hbar"><div class="hfill ffa" id="bfa" style="width:0%"></div></div><span class="hv" id="vfa">0</span></div>
  <div class="hs" data-tip="stress"><span class="ico">đź§ </span><div class="hbar"><div class="hfill fst" id="bst" style="width:100%"></div></div><span class="hv" id="vst">100</span></div>
  <div class="hdiv"></div>
  <div class="hs" data-tip="fitness"><span class="ico">đź’Ş</span><div class="hbar"><div class="hfill" style="background:linear-gradient(90deg,#006060,#00bcd4)" id="hbarfo"></div></div><span class="hv" id="hvfo">0</span></div>
  <div class="hs" data-tip="kondycja" style="min-width:60px"><span class="ico">đźŹ</span><span class="hv" id="hvfit" style="color:#00bcd4;font-size:12px;font-weight:700">0</span></div>
  <div class="hs" data-tip="drip" style="min-width:60px"><span class="ico">đź’Ž</span><span class="hv" id="hvdrip" style="color:#c8a520;font-size:12px;font-weight:700">0</span></div>
  <div class="hdiv"></div>
  <!-- Pogoda PRZED money ĹĽeby NIE nakĹ‚adaĹ‚o siÄ™ na đź”Š (right:54) -->
  <div id="hweath" title="Pogoda" style="font-size:24px;overflow:visible;line-height:1;flex-shrink:0">â€ď¸Ź</div>
  <div class="hdiv"></div>
  <div style="flex-shrink:0;min-width:0;max-width:150px;overflow:hidden"><div class="hbig" id="hmoney" style="font-size:18px;color:#f1c40f;font-weight:900;overflow:hidden;text-overflow:ellipsis;line-height:1;white-space:nowrap;max-width:100%">đź’° 500 zĹ‚</div><div class="hsml">portfel</div></div>
  <!-- v2.1.94 Amper: HARD DEFENSIVE FIX â€” z-index:5 + solid background na hfollow, z-index:1 na hclock. Nawet jeĹ›li flexbox layout siÄ™ rozjedzie z powodu async font loading (Orbitron z Google) lub innej dynamiki, fanĂłw PRZYKRYJE swoim tĹ‚em. Plus margin-right zachowane. -->
  <div style="flex-shrink:0;min-width:0;max-width:120px;overflow:hidden;margin-right:8px;position:relative;z-index:5;background:rgba(8,12,22,0.95);padding:0 4px;border-radius:4px"><div class="hbig" id="hfollow" style="font-size:18px;color:#9b59b6;font-weight:900;overflow:hidden;text-overflow:ellipsis;line-height:1;white-space:nowrap;max-width:100%">đź‘Ą 0</div><div class="hsml">fanĂłw</div></div>
  <!-- v2.1.198: zegar PRZYKLEJONY (position:absolute) â€” nie rusza siÄ™ gdy money/fans rosnÄ….
       v2.1.199: compact column layout (Dz.1 / 06:11 stacked) â€” krĂłtszy niĹĽ horizontal, zmieĹ›ci siÄ™ obok hmute. -->
  <div id="hclock-block" title="DzieĹ„ Â· godzina Â· pora dnia" style="position:absolute;top:12px;right:110px;z-index:6;line-height:1.0;white-space:nowrap;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;background:linear-gradient(135deg,rgba(15,30,50,.96),rgba(8,16,30,.96));border:1px solid rgba(126,200,227,.3);border-radius:8px;padding:0 6px;height:30px;box-shadow:inset 0 1px 0 rgba(126,200,227,.15),0 2px 4px rgba(0,0,0,.5);pointer-events:none;box-sizing:border-box;min-width:54px"><div style="font-size:9px;color:#7ec8e3;font-weight:700;text-shadow:0 0 2px rgba(126,200,227,.3);letter-spacing:.2px;line-height:1;display:flex;align-items:center;gap:3px"><span id="hporaIcon" style="font-size:9px;line-height:1">đźŚ…</span><span id="hday">DzieĹ„ 1</span></div><span id="hclock" style="font-family:'Orbitron',monospace;font-size:11px;color:#e8c84a;font-weight:700;letter-spacing:.3px;text-shadow:0 0 2px rgba(232,200,74,.4);line-height:1">06:00</span><span id="hporaTxt" style="display:none"></span><span id="hpora" style="display:none"></span></div>
  <div id="hname" style="display:none"></div>
  <!-- v2.1.198: hmute i hphone wyrĂłwnane (identical height:30px, padding:0 9px, font 14px) â€” wczeĹ›niej rĂłĹĽne paddings dawaĹ‚y rĂłĹĽne szerokoĹ›ci i wysokoĹ›ci -->
  <button id="hmute" onclick="toggleAudioPanel()" title="Ustawienia dĹşwiÄ™ku" style="position:absolute;top:12px;right:58px;height:30px;background:linear-gradient(180deg,#1f2c44,#142035);border:1px solid #3a4a6a;color:#7ec8e3;font-size:14px;padding:0 9px;border-radius:8px;cursor:pointer;pointer-events:all;line-height:1;box-shadow:0 2px 6px rgba(0,0,0,.45),inset 0 1px 0 rgba(126,200,227,.12);transition:all .15s;box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-width:38px">đź”Š</button>
  <div id="audio-panel" style="display:none;position:fixed;top:75px;left:50%;transform:translateX(-50%);background:rgba(15,20,32,.97);border:1px solid #3a2a5a;border-radius:10px;padding:14px 16px;width:300px;z-index:100;pointer-events:all;box-shadow:0 8px 24px rgba(0,0,0,.5)">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
      <span style="font-size:18px">âš™ď¸Ź</span>
      <span style="font-weight:700;color:#7ec8e3">Ustawienia</span>
      <button onclick="toggleAudioPanel()" style="margin-left:auto;background:transparent;border:none;color:#778;font-size:18px;cursor:pointer;padding:0 4px">âś•</button>
    </div>

    <div style="margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #2a3a50">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
        <span style="font-size:14px;color:#7ec8e3;font-weight:700">đźŽ® DĹşwiÄ™ki gry</span>
        <span style="font-size:10px;color:#556;font-style:italic">(SFX, kasa, kroki...)</span>
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        <input id="sfx-vol-slider" type="range" min="0" max="100" value="100" oninput="setSfxVolume(this.value/100)" style="flex:1;accent-color:#3498db">
        <span id="sfx-vol-label" style="color:#7ec8e3;font-size:12px;font-weight:700;min-width:34px;text-align:right">100%</span>
      </div>
    </div>

    <div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
        <span style="font-size:14px;color:#c8a3e3;font-weight:700">đźŽµ Muzyka w tle</span>
      </div>
      <div id="bgm-track-name" style="font-size:11px;color:#9b59b6;margin-bottom:8px;font-style:italic;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">â€”</div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <input id="bgm-vol-slider" type="range" min="0" max="100" value="13" oninput="bgmSetVolume(this.value/100)" style="flex:1;accent-color:#9b59b6">
        <span id="bgm-vol-label" style="color:#c8a3e3;font-size:12px;font-weight:700;min-width:34px;text-align:right">13%</span>
      </div>
      <div style="display:flex;gap:6px">
        <button onclick="bgmPrev()" title="Poprzedni utwĂłr" style="flex:1;background:#1a1a2a;border:1px solid #3a2a5a;color:#c8a3e3;padding:6px;border-radius:6px;cursor:pointer;font-size:13px">âŹ®</button>
        <button id="bgm-toggle-btn" onclick="bgmToggle()" style="flex:2;background:#2a1a3a;border:1px solid #5a3a7a;color:#c8a3e3;padding:6px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:700">âŹ¸ Pauza</button>
        <button onclick="bgmNext()" title="NastÄ™pny utwĂłr" style="flex:1;background:#1a1a2a;border:1px solid #3a2a5a;color:#c8a3e3;padding:6px;border-radius:6px;cursor:pointer;font-size:13px">âŹ­</button>
      </div>
    </div>

    <div style="font-size:10px;color:#556;margin-top:10px;font-style:italic;text-align:center">SFX gry delikatnie przyciszajÄ… muzykÄ™ (ducking)</div>

    <div style="margin-top:14px;padding-top:12px;border-top:1px solid #2a3a50">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <span style="font-size:14px;color:#f1c40f;font-weight:700">đź–Ą PeĹ‚ny ekran</span>
        <span style="font-size:10px;color:#556;font-style:italic">(F11 = wyjĹ›cie)</span>
      </div>
      <button id="fs-toggle-btn" onclick="toggleFullscreenPref()" style="width:100%;background:#0a3a1a;border:1px solid #27ae60;color:#7ec87e;padding:8px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;transition:all .15s">âś“ PeĹ‚ny ekran</button>
      <div style="font-size:10px;color:#556;margin-top:6px;font-style:italic;text-align:center">DomyĹ›lnie wĹ‚Ä…czony przy starcie gry</div>
    </div>
  </div>
  <button id="hphone" onclick="togglePhone()" title="Telefon (P)">đź“±</button>
  <span id="hcontract"></span>
</div>
<div id="hquest"></div>

<!-- SLEEP OVERLAY -->
<div id="sleep-overlay">
  <div style="font-size:56px;margin-bottom:16px">đź´</div>
  <div style="font-size:24px;color:#7ec8e3;font-family:'Orbitron',monospace;margin-bottom:14px">Ĺšpisz...</div>
  <div style="width:420px;height:14px;background:#0a1220;border-radius:7px;overflow:hidden;margin-bottom:14px">
    <div id="sleep-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#1a3a6a,#3498db);border-radius:7px;transition:width .3s"></div>
  </div>
  <div id="sleep-status" style="font-size:15px;color:#aaa;margin-bottom:16px;line-height:1.7">Energia roĹ›nie...</div>
  <button onclick="wakeUp()" style="background:transparent;border:1px solid #2a4a6a;color:#556;font-family:inherit;font-size:13px;padding:8px 24px;cursor:pointer;border-radius:4px;transition:all .15s;" onmouseover="this.style.borderColor='#7ec8e3';this.style.color='#7ec8e3'" onmouseout="this.style.borderColor='#2a4a6a';this.style.color='#556'">WstaĹ„ [Esc]</button>
</div>

