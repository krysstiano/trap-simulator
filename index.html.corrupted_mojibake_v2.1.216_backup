    <button onclick="adminAddXP(1000)" style="background:#1a0a2a;border:1px solid #9b59b6;color:#9b59b6;padding:8px;border-radius:6px;font-size:12px;cursor:pointer">â­ +1000 XP</button>
  </div>
  <hr style="border:0;border-top:1px solid #333;margin:10px 0"/>
