      </div>
    </div>
    ${(G.fame||0)>=60?`<div style="text-align:center;margin-bottom:14px"><button onclick="window.openCasinoVIP()" style="background:linear-gradient(135deg,#5a0a3a,#c8a520);color:#fff;border:2px solid #c8a520;padding:14px 36px;font-size:16px;font-weight:900;letter-spacing:3px;border-radius:12px;cursor:pointer;box-shadow:0 0 32px rgba(200,165,32,.5)">đźŹ† 2 PIÄTRO â€” VIP LOUNGE</button><div style="color:#c8a520;font-size:11px;margin-top:6px">High-stakes wersje gier (10Ă— min bet, 2Ă— JACKPOT mnoĹĽnik)</div></div>`:`<div style="text-align:center;margin-bottom:14px;color:#778;font-size:12px">đź”’ 2 piÄ™tro VIP â€” wymaga 60+ sĹ‚awy (masz ${G.fame||0})</div>`}
    <div style="text-align:center"><button onclick="closeOverlay()" class="cbtn">â† WyjdĹş z kasyna</button></div>
  `;
  openOverlay();
}

