  level:{label:'â­ Poziom + Prestige',emoji:'â­',color:'#9b59b6',unit:'pkt',get:()=>(G.level||1)+(G.prestige||0)*100,max:5000}, // 5k (byĹ‚o 10k)
  fans:{label:'đźŽ¤ NajwiÄ™cej fanĂłw',emoji:'đźŽ¤',color:'#e91e8c',unit:'',get:()=>G.fans||0,max:5000000}, // v2.1.37: G.fans (lojalnych) â€” spĂłjne z HUD
  achievements:{label:'đźŹ† OsiÄ…gniÄ™cia',emoji:'đźŹ†',color:'#c8a520',unit:'pkt',get:()=>(G.achievements||[]).length,max:200},
  speedrun:{label:'âŹ± Speedrun 1M fanĂłw',emoji:'âŹ±',color:'#27ae60',unit:'dni',get:()=>G._mile1m?(G._mile1mDay||0):0,max:10000,lowerIsBetter:true},
  casino:{label:'đźŽ° Wygrane w kasynie',emoji:'đźŽ°',color:'#e67e22',unit:'đźŽźď¸Ź',get:()=>G.casinoStats?.totalWon||0,max:100000000} // v2.1.45 [Amper]: unit ĹĽetony (nie zĹ‚ â€” wartoĹ›Ä‡ to chips), cap 100M (10M obcinaĹ‚o Ampera)
};
// v1.8.93: System tytuĹ‚Ăłw â€” heurystyka, priorytet od top do doĹ‚u (pierwszy unlocked wins)
const LB_TITLES=[
  {id:'legend',     emoji:'đź’Ž',label:'LEGENDA',         color:'#e91e8c',cond:g=>(g.fans||0)>=1000000 && (g.prestige||0)>=2},
  {id:'prestige5',  emoji:'â­',label:'PRESTIGE MASTER', color:'#f1c40f',cond:g=>(g.prestige||0)>=5},
  {id:'trapboss',   emoji:'đź‘‘',label:'TRAP BOSS',       color:'#9b59b6',cond:g=>(g.totalEarned||0)>=10000000},
  {id:'megafan',    emoji:'đźŽ¤',label:'TRAP LORD',       color:'#e91e8c',cond:g=>(g.followers||0)>=1000000},
  {id:'speedrun30', emoji:'đźŹ',label:'SPEEDRUNNER',     color:'#27ae60',cond:g=>g._mile1m&&(g._mile1mDay||999)<=30},
  {id:'achiever',   emoji:'đźŹ†',label:'TROPHY HUNTER',   color:'#c8a520',cond:g=>(g.achievements||[]).length>=50},
  {id:'highroller', emoji:'đźŽ°',label:'HIGH ROLLER',     color:'#e67e22',cond:g=>(g.casinoStats?.totalWon||0)>=500000},
  {id:'prestige1',  emoji:'â­',label:'PRESTIGE',        color:'#9b59b6',cond:g=>(g.prestige||0)>=1},
  {id:'milioner',   emoji:'đź’°',label:'MILIONER',        color:'#f1c40f',cond:g=>(g.totalEarned||0)>=1000000},
  {id:'star100k',   emoji:'đźŚź',label:'GWIAZDA',         color:'#7ec8e3',cond:g=>(g.followers||0)>=100000},
  {id:'rookie',     emoji:'âś¨',label:'ROOKIE',          color:'#aac',   cond:g=>(g.followers||0)>=100||(g.totalEarned||0)>=1000},
  /* v2.1.2: NEWBIE â€” catch-all dla Ĺ›wieĹĽych graczy bez ĹĽadnego innego tytuĹ‚u (cond zawsze true, ostatni w tablicy) */
  {id:'newbie',     emoji:'đźŚ±',label:'NEWBIE',          color:'#7ed18b',cond:()=>true},
];
function _lbComputeTitle(g){
  for(const t of LB_TITLES) if(t.cond(g)) return t;
  return null;
}
function _lbRenderTitleChip(titleId){
  const t=LB_TITLES.find(x=>x.id===titleId);if(!t) return '';
  return `<span style="display:inline-flex;align-items:center;gap:3px;background:${t.color}22;color:${t.color};border:1px solid ${t.color}55;font-size:9px;font-weight:800;letter-spacing:.7px;padding:1px 6px;border-radius:8px;margin-left:4px">${t.emoji} ${t.label}</span>`;
}
function _currentWeekKey(){
  // ISO 8601 week, np. '2026-W19' (reset niedziela 00:00 UTC)
  const d=new Date();
  const target=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate()));
  const dayNum=(target.getUTCDay()+6)%7;
  target.setUTCDate(target.getUTCDate()-dayNum+3);
  const firstThursday=target.valueOf();
  target.setUTCMonth(0,1);
  if(target.getUTCDay()!==4) target.setUTCMonth(0,1+((4-target.getUTCDay())+7)%7);
  const week=1+Math.ceil((firstThursday-target)/604800000);
  return target.getUTCFullYear()+'-W'+String(week).padStart(2,'0');
}
function _initPlayerUUID(){
  if(!G.playerUUID){
    G.playerUUID=(crypto.randomUUID&&crypto.randomUUID())||
      'p'+Date.now().toString(36)+Math.random().toString(36).slice(2,12);
  }
}
async function _lbFetch(path,opts={}){
  try{
    const r=await fetch(SUPABASE_URL+'/rest/v1/'+path,{...opts,headers:{...LB_HEADERS,...(opts.headers||{})}});
    if(!r.ok){
      const errText=(await r.text()||'').slice(0,200); /* v1.9.16: cap 200 chars zamiast peĹ‚nego dumpu */
      if(r.status>=500){console.error('đźŚŤ LB '+r.status,path,errText);}
      else console.warn('đźŚŤ LB '+r.status,path);
      _lbNotifyOnce();
      return null;
    }
    if(opts.method==='POST' && (opts.headers?.Prefer||LB_HEADERS.Prefer)?.includes('return=minimal')) return true;
    if(r.status===204) return true;
    const txt=await r.text();
    if(!txt) return [];
    try{return JSON.parse(txt);}catch(e){console.warn('đźŚŤ JSON parse error',e.message);return null;}
  }catch(e){
    /* v1.9.16: REMOVED stack trace exposure â€” log tylko message, uĹĽytkownik widzi toast */
    console.warn('đźŚŤ LB network error:',e.message,'path:',path);
    _lbNotifyOnce();
    return null;
  }
}
function _lbNotifyOnce(){
  /* v1.9.16: pokazujemy toast offline TYLKO raz per sesja (anti-spam, ale gracz wie ĹĽe nie ma poĹ‚Ä…czenia) */
  if(window._lbOfflineToastShown) return;
  window._lbOfflineToastShown=true;
  if(typeof showMsg==='function') showMsg('đźŚŤ Brak poĹ‚Ä…czenia z tablicÄ… wynikĂłw (gra offline)','y',4000);
}
// Sprawdza czy nick jest dostÄ™pny (zwraca true jeĹ›li wolny, false jeĹ›li zajÄ™ty przez kogoĹ› innego)
async function checkNickAvailable(nick){
  if(!nick||!/^[A-Za-z0-9 _-]{1,16}$/.test(nick)) return false;
  const r=await _lbFetch('nick_claims?nick_lower=eq.'+encodeURIComponent(nick.toLowerCase()));
  if(!r||r.length===0) return true; // wolny
  return r[0].user_id===G.playerUUID; // zajÄ™ty tylko jeĹ›li przez tego samego gracza
}
async function claimNick(nick){
  _initPlayerUUID();
  if(!await checkNickAvailable(nick)) return false;
  // v1.8.74: on_conflict dla nick_claims teĹĽ
  await _lbFetch('nick_claims?on_conflict=nick_lower',{method:'POST',headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({nick_lower:nick.toLowerCase(),user_id:G.playerUUID})});
  G.globalNick=nick;
  return true;
}
async function submitScore(catKey,scope){
  if(!G.leaderboardOptIn||!G.playerUUID||!G.globalNick) return;
  const cat=LB_CATEGORIES[catKey];if(!cat) return;
  const score=cat.get();
  if(score<0||score>cat.max) return;
  if(catKey==='speedrun' && score===0) return;
  // v1.9.11: Anty-cheat â€” odrzuÄ‡ submission jeĹ›li skok >5Ă— w ciÄ…gu 60s (np. edytowany save)
  // v2.1.45 [Amper]: casino ma jackpoty wielokrotnie wiÄ™ksze od poprzednich wygranych â€” luĹşniejszy prĂłg 100Ă— by nie blokowaÄ‡ legalnych big winĂłw
  if(!window._lbLastSubmitScores) window._lbLastSubmitScores={};
  const _lastKey=catKey+'|'+scope;
  const _prev=window._lbLastSubmitScores[_lastKey];
  const _maxRatio = catKey==='casino' ? 100 : 5;
  if(_prev && _prev.score>0 && score>_prev.score*_maxRatio && (Date.now()-_prev.t)<60000){
    console.warn('đź›ˇ LB anti-cheat: odrzucone submission (score skok >'+_maxRatio+'Ă— w 60s)',{catKey,prev:_prev.score,curr:score});
    return;
  }
  window._lbLastSubmitScores[_lastKey]={score,t:Date.now()};
  const periodKey=scope==='weekly'?'weekly:'+_currentWeekKey():'alltime';
  // v1.8.80/v1.9.11: avatar w payload z WALIDACJÄ„ (anti-injection przez edytowany save)
  const _rawSkin=(typeof P!=='undefined'&&P.skin)||G.skin||'light';
  const _rawHair=(typeof P!=='undefined'&&P.hair)||G.hair||0;
  const _rawCloth=(typeof P!=='undefined'&&P.cloth)||G.cloth||'#2a5080';
  const _safeSkin=['verylight','light','medium','olive','dark','verydark'].includes(_rawSkin)?_rawSkin:'light';
  const _safeHair=(Number.isInteger(_rawHair)&&_rawHair>=0&&_rawHair<=9)?_rawHair:0;
  const _safeCloth=/^#[0-9a-fA-F]{6}$/.test(_rawCloth)?_rawCloth:'#2a5080';
  const avatar=JSON.stringify({skin:_safeSkin,hair:_safeHair,cloth:_safeCloth});
  // v1.8.93: title obliczany z stanu gracza i wysyĹ‚any razem z kaĹĽdÄ… kategoriÄ…
  const title=_lbComputeTitle(G)?.id||null;
  return await _lbFetch('leaderboard?on_conflict=user_id,category,period_key',{
    method:'POST',
    headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
    body:JSON.stringify({
      user_id:G.playerUUID,nick:G.globalNick,category:catKey,
      period_key:periodKey,score,country:'PL',game_day:G.day||0,avatar,title,
      updated_at:new Date().toISOString()
    })
  });
}
async function submitAllScores(){
  if(!G.leaderboardOptIn||!G.globalNick){
    return {sent:0,failed:0};
  }
  /* v2.1.103: anti-cheat â€” blokada submit jeĹ›li gracz uĹĽyĹ‚ admin command (Wave 5 K48 leaderboard accept âž).
     `_adminCheatUsed` flag jest ustawiany przez admin functions (adminMaxAll, adminAddMoney, etc.) â€” gracz Ĺ›wiadomie siÄ™ odciÄ…Ĺ‚ od rankingu. */
  if(G._adminCheatUsed){
    return {sent:0,failed:0,skipped:Object.keys(LB_CATEGORIES).length*2,cheat:true};
  }
  /* v2.1.103: sanity bounds â€” odrzuÄ‡ absurdalne wartoĹ›ci (Wave 5 K46 localStorage tampering protection) */
  if((G.money||0)>999999999999 || (G.totalEarned||0)>999999999999){
    return {sent:0,failed:0,skipped:Object.keys(LB_CATEGORIES).length*2,sanity:'money'};
  }
  if((G.fans||0)>9999999999 || (G.followers||0)>9999999999){
    return {sent:0,failed:0,skipped:Object.keys(LB_CATEGORIES).length*2,sanity:'fans'};
  }
  // Submit kaĹĽdej kategorii do all-time i weekly rĂłwnolegle
  const tasks=[];
  for(const key of Object.keys(LB_CATEGORIES)){
    tasks.push(submitScore(key,'alltime'));
    tasks.push(submitScore(key,'weekly'));
  }
  const results=await Promise.all(tasks);
  const sent=results.filter(r=>r===true).length;
  const failed=results.filter(r=>r===null).length;
  const skipped=results.length-sent-failed;
  return {sent,failed,skipped};
}
// v1.8.81: throttled auto-submit â€” wywoĹ‚ywane co tick gry, faktyczny submit max raz na 60s realnego czasu.
// Pomija wszystko jeĹ›li gracz nie ustawiĹ‚ manualnie nicku (musi wpisaÄ‡ w tablicy wynikĂłw).
let _lbLastAutoSubmit=0;
const _LB_AUTO_INTERVAL=60000;
async function maybeAutoSubmitScores(){
  if(!G.leaderboardOptIn) return;
  if(!G.globalNick || !G.playerUUID) return; // gracz jeszcze nie wpisaĹ‚ nicku â€” pomijamy
  const now=Date.now();
  // v2.1.45 [Amper]: wymuszony submit gdy wygrane w kasynie wzrosĹ‚y (Ampera raport: tablica zaniĹĽona)
  // Bez tego nowa wygrana czekaĹ‚a do nastÄ™pnego nextPeriod() (~1.5min realnego czasu).
  const _curCasino = G.casinoStats?.totalWon || 0;
  const _casinoChanged = _curCasino > (window._lbLastCasinoTotal||0);
  const _throttle = _casinoChanged ? 10000 : _LB_AUTO_INTERVAL; // 10s gdy Ĺ›wieĹĽa wygrana, 60s normalnie
  if(now-_lbLastAutoSubmit<_throttle) return;
  _lbLastAutoSubmit=now;
  window._lbLastCasinoTotal = _curCasino;
  submitAllScores(); // fire and forget
  // v1.8.92: rĂłwnolegle sprawdĹş milestones znajomych (1Ă— na 60s)
  if(typeof _lbCheckFriendsMilestones==='function') _lbCheckFriendsMilestones();
}
// v1.8.80: Mini-avatar (~22Ă—22 px) renderowany w HTML z koloru skĂłry/wĹ‚osĂłw/ubrania.
// DziaĹ‚a cross-platform (Windows nie ma emoji flagowych, wiÄ™c CSS jest pewniejsze).
function _renderMiniAvatar(avatarStr){
  let a={skin:'light',hair:0,cloth:'#2a5080'};
  if(avatarStr){
    try{const p=JSON.parse(avatarStr);if(p&&typeof p==='object') a={...a,...p};}catch(e){}
  }
  const skinCols={verylight:'#f5d8b8',light:'#e0a870',medium:'#c07840',olive:'#a0703a',dark:'#704020',verydark:'#4a2818'};
  const skin=skinCols[a.skin]||skinCols.light;
  // Czapka/wĹ‚osy â€” rĂłĹĽne kolory wedle hair index (0=brÄ…z, 1=ciemny, 2=dredy, 3=Ĺ‚ysy, 4=afro, 5=irokez, 6=bokser, 7=loczki, 8=quiff, 9=buzz)
  const hairCol=['#3a2010','#1a0a08','#3a2010','transparent','#1a0a08','#3a1a08','#3a2010','#4a2818','#2a1408','#3a2818'][a.hair]||'#3a2010';
  const cloth=a.cloth||'#2a5080';
  return `<span style="display:inline-block;width:22px;height:22px;position:relative;vertical-align:middle;flex-shrink:0">
    <span style="position:absolute;bottom:0;left:2px;right:2px;height:9px;background:${cloth};border-radius:3px 3px 1px 1px;border:1px solid rgba(0,0,0,.25)"></span>
    <span style="position:absolute;top:3px;left:5px;width:12px;height:12px;border-radius:50%;background:${skin};border:1px solid rgba(0,0,0,.25)"></span>
    ${a.hair!==3?`<span style="position:absolute;top:1px;left:4px;width:14px;height:7px;border-radius:6px 6px 2px 2px;background:${hairCol};border:1px solid rgba(0,0,0,.3)"></span>`:''}
  </span>`;
}
// v1.8.80: flaga jako CSS â€” emoji flagowe nie renderujÄ… siÄ™ na Windows (pokazujÄ… "PL")
function _renderFlag(country){
  if(country==='PL') return `<span style="display:inline-block;width:18px;height:12px;background:linear-gradient(180deg,#fff 50%,#dc143c 50%);border:1px solid rgba(0,0,0,.4);border-radius:2px;vertical-align:middle;flex-shrink:0" title="Polska"></span>`;
  return `<span style="display:inline-block;width:18px;height:12px;background:#445;border-radius:2px;vertical-align:middle;flex-shrink:0" title="Inny kraj"></span>`;
}
async function fetchLeaderboard(catKey,scope){
  const cat=LB_CATEGORIES[catKey];if(!cat) return [];
  const periodKey=scope==='weekly'?'weekly:'+_currentWeekKey():'alltime';
  const order=cat.lowerIsBetter?'score.asc':'score.desc';
  // v1.8.90: scope 'friends' â€” filtruje top 100 do tylko znajomych (UUID w in.(...))
  if(scope==='friends'){
    const friendIds=(G.friends||[]).map(f=>f.userId).filter(Boolean);
    // DoĹ‚Ä…cz teĹĽ siebie ĹĽeby widzieÄ‡ swojÄ… pozycjÄ™ wĹ›rĂłd znajomych
    if(G.playerUUID) friendIds.push(G.playerUUID);
    if(friendIds.length===0) return [];
    const idsStr=friendIds.join(',');
    const r=await _lbFetch(`leaderboard?category=eq.${catKey}&period_key=eq.alltime&user_id=in.(${idsStr})&order=${order}&limit=100`);
    return r||[];
  }
  const r=await _lbFetch(`leaderboard?category=eq.${catKey}&period_key=eq.${encodeURIComponent(periodKey)}&order=${order}&limit=100`);
  return r||[];
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  v1.8.90: FRIENDS SYSTEM
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// v1.9.11: HTML escape â€” bezpieczne wstawianie nickĂłw/tekstu do innerHTML (anti-XSS)
function _escHtml(s){
  if(s==null) return '';
  return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
}
// v1.9.11: Walidacja nicku â€” regex zgodny z claimNick (anty-injection przez edytowany save)
function _validNick(s){return typeof s==='string' && /^[\p{L}\p{N}_]{2,16}$/u.test(s);}
window._escHtml=_escHtml;
window._validNick=_validNick;
// Friend code: TRAP-XXXX-XXXX-XXXX z pierwszych 12 hex znakĂłw UUID gracza (48 bit, anty-collision dla 65k+ graczy).
// v1.9.11: Rozszerzone z 8 do 12 hex (anty-collision birthday paradox). Stary format nadal czytany dla wstecznej kompatybilnoĹ›ci.
function getFriendCode(uuid){
  uuid=uuid||G.playerUUID||'';
  const hex=uuid.replace(/-/g,'').slice(0,12).toUpperCase();
  if(hex.length<12) return null;
  return `TRAP-${hex.slice(0,4)}-${hex.slice(4,8)}-${hex.slice(8,12)}`;
}
function parseFriendCode(code){
  if(!code) return null;
  const up=code.toUpperCase();
  // Nowy format 12 hex (3 segmenty)
  let m=up.match(/^TRAP[-_]?([0-9A-F]{4})[-_]?([0-9A-F]{4})[-_]?([0-9A-F]{4})$/);
  if(m) return (m[1]+m[2]+m[3]).toLowerCase();
  // Stary format 8 hex (2 segmenty) â€” backward compat
  m=up.match(/^TRAP[-_]?([0-9A-F]{4})[-_]?([0-9A-F]{4})$/);
  if(m) return (m[1]+m[2]).toLowerCase();
  return null;
}
async function addFriend(code){
  const prefix=parseFriendCode(code);
  if(!prefix) return {ok:false,error:'NieprawidĹ‚owy kod (przykĹ‚ad: TRAP-A3F1-B2C9)'};
  const found=await _lbFetch(`leaderboard?user_id=like.${prefix}*&order=updated_at.desc&limit=5`);
  if(!found||!found.length) return {ok:false,error:'Nie znaleziono gracza z tym kodem'};
  const uniqueUsers=new Map();
  for(const e of found){if(!uniqueUsers.has(e.user_id)) uniqueUsers.set(e.user_id,e);}
  const friend=[...uniqueUsers.values()][0];
  if(friend.user_id===G.playerUUID) return {ok:false,error:'To TwĂłj wĹ‚asny kod đź„'};
  if((G.friends||[]).some(f=>f.userId===friend.user_id)) return {ok:false,error:`${friend.nick} jest juĹĽ Twoim znajomym`};
  /* v2.1.0: pending invite flow. SprawdĹş czy ten gracz nas wczeĹ›niej nie zaprosiĹ‚ â†’ auto-accept. */
  const incoming=await _lbFetch(`friendships?from_user_id=eq.${friend.user_id}&to_user_id=eq.${G.playerUUID}&status=eq.pending&limit=1`);
  if(Array.isArray(incoming) && incoming.length>0){
    await _lbAcceptFriendRequest(friend.user_id,friend.nick);
    return {ok:true,friend,autoAccepted:true};
  }
  /* SprawdĹş czy nie ma juĹĽ zaproszenia ode mnie */
  const existing=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${friend.user_id}&limit=1`);
  if(Array.isArray(existing) && existing.length>0 && existing[0].status==='pending'){
    return {ok:false,error:'Zaproszenie juĹĽ wysĹ‚ane â€” czeka na akceptacjÄ™'};
  }
  /* v2.1.11: merge-duplicates ĹĽeby re-send invite po rejected/accepted dziaĹ‚aĹ‚o */
  await _lbFetch('friendships?on_conflict=from_user_id,to_user_id',{
    method:'POST',
    headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
    body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:friend.user_id,status:'pending'})
  });
  return {ok:true,friend,pending:true};
}
async function addFriendByUserId(userId,nick){
  if(userId===G.playerUUID) return {ok:false,error:'To TwĂłj wĹ‚asny profil đź„'};
  if((G.friends||[]).some(f=>f.userId===userId)) return {ok:false,error:`${nick||'Gracz'} jest juĹĽ Twoim znajomym`};
  /* v2.1.11: lepszy nick fallback â€” najpierw sprĂłbuj odzyskaÄ‡ Ĺ›wieĹĽy nick z LB (najnowszy entry tego usera),
     dopiero potem fallback do prostego "Gracz" zamiast UUID prefixu ktĂłry wyglÄ…da jak Player_d6eda2 */
  let _safeNick=_validNick(nick)?nick:null;
  if(!_safeNick){
    const lbRow=await _lbFetch(`leaderboard?user_id=eq.${userId}&order=updated_at.desc&limit=1`);
    if(Array.isArray(lbRow) && lbRow.length>0 && _validNick(lbRow[0].nick)) _safeNick=lbRow[0].nick;
  }
  if(!_safeNick) _safeNick='Gracz';
  const incoming=await _lbFetch(`friendships?from_user_id=eq.${userId}&to_user_id=eq.${G.playerUUID}&status=eq.pending&limit=1`);
  if(Array.isArray(incoming) && incoming.length>0){
    await _lbAcceptFriendRequest(userId,_safeNick);
    return {ok:true,autoAccepted:true};
  }
  /* v2.1.11: uĹĽyj merge-duplicates (UPSERT) â€” gdy invite/friendship juĹĽ istnieje (np. status='rejected'),
     nadpisuje status='pending' zamiast ignore. Plus on_conflict=from_user_id,to_user_id musi pasowaÄ‡ do PRIMARY KEY. */
  const r=await _lbFetch('friendships?on_conflict=from_user_id,to_user_id',{
    method:'POST',
    headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
    body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:userId,status:'pending'})
  });
  if(r===null){
    /* SprawdĹş czy rekord juĹĽ istnieje â€” moĹĽe to konflikt nie bĹ‚Ä…d sieci */
    const exists=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${userId}&limit=1`);
    if(Array.isArray(exists) && exists.length>0){
      const e=exists[0];
      if(e.status==='pending') return {ok:false,error:'Zaproszenie juĹĽ wysĹ‚ane â€” czekaj na akceptacjÄ™'};
      if(e.status==='accepted') return {ok:false,error:'JuĹĽ jesteĹ›cie znajomymi'};
      if(e.status==='rejected') return {ok:false,error:'Zaproszenie odrzucone â€” sprĂłbuj za chwilÄ™'};
    }
    return {ok:false,error:'BĹ‚Ä…d serwera. SprĂłbuj ponownie.'};
  }
  return {ok:true,pending:true};
}
// v1.9.2: Modal profilu gracza (klikniety z rankingu) â€” pokazuje "Dodaj do znajomych" lub porĂłwnanie jeĹ›li juz znajomy
window._lbOpenPlayerCard=async function(userId,nick){
  if(userId===G.playerUUID) return;
  /* v2.1.15: stale state fix. Gdy lokalnie mam userId w G.friends, ale druga strona usunÄ™Ĺ‚a nas,
     DB nie ma juĹĽ friendship â†’ otwiera renderFriendProfile bez "Dodaj do znajomych", brak moĹĽliwoĹ›ci re-add.
     Fix: zweryfikuj w DB czy friendship faktycznie istnieje (accepted). JeĹ›li stale â†’ odĹ›wieĹĽ lokalny G.friends. */
  let isFriend=(G.friends||[]).some(f=>f.userId===userId);
  if(isFriend){
    const dbCheck=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${userId}&status=eq.accepted&limit=1`);
    if(Array.isArray(dbCheck) && dbCheck.length===0){
      /* Druga strona nas usunÄ™Ĺ‚a â€” sync lokalny */
      G.friends=(G.friends||[]).filter(f=>f.userId!==userId);
      if(typeof saveGameSilent==='function') saveGameSilent();
      isFriend=false;
    }
  }
  if(isFriend){renderFriendProfile(userId);return;}
  document.getElementById('lb-player-card')?.remove();
  const modal=document.createElement('div');
  modal.id='lb-player-card';
  modal.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px;cursor:pointer';
  modal.onclick=(e)=>{if(e.target===modal) modal.remove();};
  modal.innerHTML='<div style="color:#aac;font-size:14px">âŹł ĹadujÄ™ profil...</div>';
  document.body.appendChild(modal);
  // Pobierz statystyki gracza
  const data=await _lbFetch(`leaderboard?user_id=eq.${userId}&period_key=eq.alltime&limit=10`);
  const stats={};
  if(Array.isArray(data)) for(const r of data) stats[r.category]={score:r.score,country:r.country,avatar:r.avatar,title:r.title,nick:r.nick};
  const sample=stats.money||stats.fans||stats.level||Object.values(stats)[0]||{};
  const theme=typeof _friendThemeColor==='function'?_friendThemeColor(nick):{primary:'#9b59b6',accent:'#e91e8c'};
  const cats=['money','level','fans','achievements','casino','speedrun'];
  const catLabels={money:'đź’° Kasa',level:'â­ Poziom',fans:'đźŽ¤ Fani',achievements:'đźŹ† Trofea',casino:'đźŽ° Kasyno',speedrun:'âŹ± Speedrun'};
  const titleChip=sample.title?_lbRenderTitleChip(sample.title):'';
  const statsHtml=cats.map(c=>{
    const sc=stats[c]?.score;
    if(typeof sc!=='number') return '';
    const lbl=catLabels[c]||c;
    const val=c==='speedrun'?(sc>0?sc+' dni':'â€”'):sc.toLocaleString('pl');
    return `<div style="display:flex;justify-content:space-between;padding:6px 8px;font-size:12px;border-bottom:1px solid #1a2535"><span style="color:#aac">${lbl}</span><span style="color:#fff;font-weight:700">${val}</span></div>`;
  }).join('');
  modal.innerHTML=`<div style="background:linear-gradient(135deg,${theme.primary}22,${theme.accent}11);border:2px solid ${theme.primary};border-radius:14px;padding:20px 24px;max-width:380px;width:100%;cursor:auto" onclick="event.stopPropagation()">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
      ${_renderMiniAvatar(sample.avatar)}${_renderFlag(sample.country)}
      <div style="flex:1;min-width:0">
        <div style="color:#fff;font-size:17px;font-weight:800;word-break:break-word;line-height:1.2">${nick}${titleChip}</div>
        <div style="color:#778;font-size:10px;margin-top:2px">Profil gracza</div>
      </div>
      <button onclick="document.getElementById('lb-player-card').remove()" style="background:transparent;border:none;color:#aac;font-size:20px;cursor:pointer;padding:0 6px">âś•</button>
    </div>
    <div style="background:#0a0e18;border-radius:8px;padding:4px 4px;margin-bottom:14px">
      ${statsHtml||'<div style="color:#556;padding:14px;text-align:center;font-size:12px">Brak danych statystyk</div>'}
    </div>
    <div id="lb-pc-status" style="color:#aac;font-size:11px;text-align:center;margin-bottom:8px;min-height:14px"></div>
    <div style="display:flex;gap:8px">
      <button id="lb-pc-add-btn" onclick="_lbDoAddFriendFromCard('${userId}','${(nick||'').replace(/['"\\]/g,'')}')" style="flex:1;background:linear-gradient(135deg,${theme.primary},${theme.accent});border:none;color:#fff;font-weight:800;padding:10px;border-radius:8px;cursor:pointer;font-size:13px">âž• Dodaj do znajomych</button>
      <button onclick="document.getElementById('lb-player-card').remove()" style="background:#1a2535;border:1px solid #2a3a4a;color:#aac;padding:10px 14px;border-radius:8px;cursor:pointer;font-size:12px">Zamknij</button>
    </div>
  </div>`;
};
window._lbDoAddFriendFromCard=async function(userId,nick){
  const btn=document.getElementById('lb-pc-add-btn');
  const status=document.getElementById('lb-pc-status');
  if(btn){btn.disabled=true;btn.textContent='âŹł DodajÄ™...';}
  const r=await addFriendByUserId(userId,nick);
  if(r.ok){
    /* v2.1.0: rĂłĹĽny komunikat dla auto-accept vs pending */
    if(r.autoAccepted){
      if(status){status.style.color='#27ae60';status.textContent='âś… Dodano (auto-akceptacja)!';}
      if(btn){btn.style.opacity='0.6';btn.textContent='âś… JuĹĽ znajomy';}
    } else {
      if(status){status.style.color='#9b59b6';status.textContent='đź“¤ Zaproszenie wysĹ‚ane â€” czeka na akceptacjÄ™';}
      if(btn){btn.style.opacity='0.6';btn.textContent='đź“¤ Zaproszenie wysĹ‚ane';}
    }
    setTimeout(()=>{document.getElementById('lb-player-card')?.remove();if(typeof renderPhoneLeaderboard==='function')renderPhoneLeaderboard();},1100);
  } else {
    if(status){status.style.color='#e74c3c';status.textContent=r.error||'BĹ‚Ä…d dodawania znajomego';}
    if(btn){btn.disabled=false;btn.textContent='âž• Dodaj do znajomych';}
  }
};
async function removeFriend(userId){
  G.friends=(G.friends||[]).filter(f=>f.userId!==userId);
  if(typeof saveGameSilent==='function') saveGameSilent();
  /* v2.1.0: usuĹ„ obie strony friendship (od siebie + reverse) â€” ĹĽeby drugi gracz teĹĽ przestaĹ‚ CiÄ™ widzieÄ‡ */
  await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${userId}`,{method:'DELETE'});
  await _lbFetch(`friendships?from_user_id=eq.${userId}&to_user_id=eq.${G.playerUUID}`,{method:'DELETE'});
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   v2.1.0 CREW SYSTEM (Fazy C+D+E)
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   G.playerCrew = {id, name, leader_uuid, isLeader, members:[{userId,nick,role}],
             joinedAt, _lastFetch, _lastMsgFetch}
   âš  NIE myl z G.crew (legacy = ekipa muzyczna NPC: DJ Olek, grafik Bartek, hype Seba). */
window._crewFetchMyCrew=async function(){
  if(!G.playerUUID) return null;
  /* SprawdĹş czy jestem w jakimĹ› crew (crew_members where member_uuid=me) */
  const rows=await _lbFetch(`crew_members?member_uuid=eq.${G.playerUUID}&limit=1`);
  if(!Array.isArray(rows) || rows.length===0){
    if(G.playerCrew){G.playerCrew=null; if(typeof saveGameSilent==='function') saveGameSilent();}
    return null;
  }
  const myMembership=rows[0];
  const crewId=myMembership.crew_id;
  /* Fetch crew + wszystkich czĹ‚onkĂłw */
  const [crews,allMembers]=await Promise.all([
    _lbFetch(`crews?id=eq.${crewId}&limit=1`),
    _lbFetch(`crew_members?crew_id=eq.${crewId}&order=joined_at.asc&limit=10`)
  ]);
  if(!Array.isArray(crews) || crews.length===0){
    if(G.playerCrew){G.playerCrew=null; if(typeof saveGameSilent==='function') saveGameSilent();}
    return null;
  }
  const crew=crews[0];
  const members=Array.isArray(allMembers)?allMembers.map(m=>({
    userId:m.member_uuid, nick:m.member_nick||'Member', role:m.role||'member', joinedAt:m.joined_at
  })):[];
  G.playerCrew={
    id:crew.id, name:crew.name, leader_uuid:crew.leader_uuid,
    isLeader:crew.leader_uuid===G.playerUUID,
    members, joinedAt:myMembership.joined_at,
    _lastFetch:Date.now()
  };
  if(typeof saveGameSilent==='function') saveGameSilent();
  return G.playerCrew;
};
window._crewCreate=async function(name){
  if(!G.playerUUID) return {ok:false,error:'Najpierw ustaw nick (Tablica wynikĂłw)'};
  name=String(name||'').trim();
  if(name.length<2||name.length>30) return {ok:false,error:'Nazwa 2-30 znakĂłw'};
  if(G.playerCrew) return {ok:false,error:'JuĹĽ jesteĹ› w crew â€” opuĹ›Ä‡ je najpierw'};
  const myNick=G.globalNick||'Leader';
  /* INSERT crew (UNIQUE leader_uuid â†’ jeden crew na lidera) */
  const created=await _lbFetch('crews',{
    method:'POST',
    headers:{'Prefer':'return=representation'},
    body:JSON.stringify({name, leader_uuid:G.playerUUID, leader_nick:myNick, max_members:4})
  });
  if(!Array.isArray(created)||created.length===0) return {ok:false,error:'Nie udaĹ‚o siÄ™ utworzyÄ‡ crew (moĹĽe juĹĽ masz crew?)'};
  const crewId=created[0].id;
  /* INSERT moje czĹ‚onkostwo jako leader */
  const memberInsert=await _lbFetch('crew_members',{
    method:'POST',
    headers:{'Prefer':'return=minimal'},
    body:JSON.stringify({crew_id:crewId, member_uuid:G.playerUUID, member_nick:myNick, role:'leader'})
  });
  if(memberInsert===null){
    /* Rollback: usuĹ„ crew */
    await _lbFetch(`crews?id=eq.${crewId}`,{method:'DELETE'});
    return {ok:false,error:'BĹ‚Ä…d dodania lidera (moĹĽe juĹĽ jesteĹ› w innym crew?)'};
  }
  await _crewFetchMyCrew();
  if(typeof showMsg==='function') showMsg('đźŹ† Crew "'+name+'" utworzona â€” zapraszaj znajomych!','g',4500);
  return {ok:true,crewId};
};
window._crewLeave=async function(){
  if(!G.playerCrew) return;
  const crewId=G.playerCrew.id;
  const wasLeader=G.playerCrew.isLeader;
  const otherMembers=G.playerCrew.members.filter(m=>m.userId!==G.playerUUID);
  if(wasLeader && otherMembers.length>0){
    /* Transfer leadership na najwczeĹ›niej doĹ‚Ä…czonego czĹ‚onka */
    const newLeader=otherMembers[0];
    await _lbFetch(`crews?id=eq.${crewId}`,{
      method:'PATCH',
      body:JSON.stringify({leader_uuid:newLeader.userId, leader_nick:newLeader.nick})
    });
    await _lbFetch(`crew_members?crew_id=eq.${crewId}&member_uuid=eq.${newLeader.userId}`,{
      method:'PATCH',
      body:JSON.stringify({role:'leader'})
    });
  }
  /* UsuĹ„ moje czĹ‚onkostwo */
  await _lbFetch(`crew_members?crew_id=eq.${crewId}&member_uuid=eq.${G.playerUUID}`,{method:'DELETE'});
  /* JeĹ›li byĹ‚em leaderem i nikt nie zostaĹ‚ â†’ disband */
  if(wasLeader && otherMembers.length===0){
    await _lbFetch(`crews?id=eq.${crewId}`,{method:'DELETE'});
  }
  G.playerCrew=null;
  if(typeof saveGameSilent==='function') saveGameSilent();
  if(typeof showMsg==='function') showMsg('đź‘‹ OpuĹ›ciĹ‚eĹ› crew','i');
};
window._crewDisband=async function(){
  if(!G.playerCrew||!G.playerCrew.isLeader) return;
  await _lbFetch(`crews?id=eq.${G.playerCrew.id}`,{method:'DELETE'});
  G.playerCrew=null;
  if(typeof saveGameSilent==='function') saveGameSilent();
  if(typeof showMsg==='function') showMsg('đź’Ą Crew rozwiÄ…zane','r');
};
window._crewKickMember=async function(memberUuid,memberNick){
  if(!G.playerCrew||!G.playerCrew.isLeader) return;
  await _lbFetch(`crew_members?crew_id=eq.${G.playerCrew.id}&member_uuid=eq.${memberUuid}`,{method:'DELETE'});
  await _crewFetchMyCrew();
  if(typeof showMsg==='function') showMsg('đźšŞ WyrzuciĹ‚eĹ›: '+memberNick,'i');
};
window._crewInviteMember=async function(toUserId,toNick){
  if(!G.playerCrew||!G.playerCrew.isLeader) return {ok:false,error:'Tylko leader moĹĽe zapraszaÄ‡'};
  if(G.playerCrew.members.length>=(G.playerCrew.max_members||4)) return {ok:false,error:'Crew peĹ‚na (max 4)'};
  if(G.playerCrew.members.some(m=>m.userId===toUserId)) return {ok:false,error:toNick+' juĹĽ jest w crew'};
  /* v2.1.11: KRYTYCZNY FIX. WczeĹ›niej `ignore-duplicates` + UNIQUE (crew_id, to_uuid) constraint w bazie
     powodowaĹ‚ ĹĽe gdy invite juĹĽ istniaĹ‚ z status='rejected' (lub starsze pending), nowy POST byĹ‚ IGNORE â†’ brak nowego pending.
     Druga osoba NIE WIDZIAĹA zaproszenia bo w bazie pozostaĹ‚ stary rekord z innym statusem.
     Fix: usuĹ„ stary rekord PRZED INSERT â€” wtedy nowy POST stworzy fresh pending invite z aktualnym crew_name/from_nick. */
  await _lbFetch(`crew_invites?crew_id=eq.${G.playerCrew.id}&to_uuid=eq.${toUserId}`,{method:'DELETE'});
  const r=await _lbFetch('crew_invites',{
    method:'POST',
    headers:{'Prefer':'return=minimal'},
    body:JSON.stringify({
      crew_id:G.playerCrew.id, from_uuid:G.playerUUID, to_uuid:toUserId,
      from_nick:G.globalNick||'Leader', crew_name:G.playerCrew.name, status:'pending'
    })
  });
  if(r===null) return {ok:false,error:'BĹ‚Ä…d serwera â€” sprawdĹş czy crew_invites tabela istnieje w Supabase'};
  return {ok:true};
};
window._crewFetchPendingInvites=async function(){
  if(!G.playerUUID) return [];
  const rows=await _lbFetch(`crew_invites?to_uuid=eq.${G.playerUUID}&status=eq.pending&limit=10`);
  if(!Array.isArray(rows)) return [];
  return rows;
};
window._crewAcceptInvite=async function(inviteId,crewId,crewName){
  if(G.playerCrew){
    if(typeof showMsg==='function') showMsg('đźš« JuĹĽ jesteĹ› w crew â€” opuĹ›Ä‡ je najpierw','r');
    return;
  }
  /* SprawdĹş czy crew nie peĹ‚na */
  const members=await _lbFetch(`crew_members?crew_id=eq.${crewId}&limit=10`);
  if(Array.isArray(members) && members.length>=4){
    if(typeof showMsg==='function') showMsg('đźš« Crew juĹĽ peĹ‚na','r');
    await _lbFetch(`crew_invites?id=eq.${inviteId}`,{method:'PATCH',body:JSON.stringify({status:'rejected'})});
    return;
  }
  /* Update invite na accepted */
  await _lbFetch(`crew_invites?id=eq.${inviteId}`,{method:'PATCH',body:JSON.stringify({status:'accepted'})});
  /* Insert do crew_members */
  const myNick=G.globalNick||'Member';
  const insert=await _lbFetch('crew_members',{
    method:'POST',
    headers:{'Prefer':'return=minimal'},
    body:JSON.stringify({crew_id:crewId, member_uuid:G.playerUUID, member_nick:myNick, role:'member'})
  });
  if(insert===null){
    if(typeof showMsg==='function') showMsg('đźš« BĹ‚Ä…d doĹ‚Ä…czania (moĹĽe jesteĹ› juĹĽ w innym crew?)','r');
    return;
  }
  await _crewFetchMyCrew();
  if(typeof showMsg==='function') showMsg('đźŹ† DoĹ‚Ä…czyĹ‚eĹ› do crew: '+crewName,'g',4000);
  renderPhoneCrew();
};
window._crewRejectInvite=async function(inviteId,crewName){
  await _lbFetch(`crew_invites?id=eq.${inviteId}`,{method:'PATCH',body:JSON.stringify({status:'rejected'})});
  if(typeof showMsg==='function') showMsg('đźš« Odrzucono zaproszenie do: '+crewName,'i');
  renderPhoneCrew();
};
/* â”€â”€â”€ CREW CHAT (Faza D) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
window._crewFetchMessages=async function(){
  if(!G.playerCrew) return [];
  const rows=await _lbFetch(`crew_messages?crew_id=eq.${G.playerCrew.id}&order=sent_at.desc&limit=50`);
  if(!Array.isArray(rows)) return [];
  /* Reverse: chcemy chronologicznie (najstarsze gĂłrze, najnowsze dole) */
  return rows.reverse();
};
window._crewSendMessage=async function(text){
  if(!G.playerCrew||!text) return false;
  text=String(text).trim();
  if(text.length<1||text.length>200) return false;
  const myNick=G.globalNick||'Member';
  const r=await _lbFetch('crew_messages',{
    method:'POST',
    headers:{'Prefer':'return=minimal'},
    body:JSON.stringify({crew_id:G.playerCrew.id, from_uuid:G.playerUUID, from_nick:myNick, text})
  });
  return r!==null;
};
window._openCrewChat=async function(){
  if(!G.playerCrew){if(typeof showMsg==='function') showMsg('Nie jesteĹ› w ĹĽadnym crew','r');return;}
  const _esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const ph=document.getElementById('ph-content');
  if(!ph) return;
  document.getElementById('ph-title')&&(document.getElementById('ph-title').textContent='đź’¬ Czat crew: '+_esc(G.playerCrew.name));
  ph.innerHTML='<div style="text-align:center;color:#aac;padding:30px">âŹł ĹadujÄ™ wiadomoĹ›ci...</div>';
  const msgs=await _crewFetchMessages();
  const bubbles=msgs.length===0?'<div style="text-align:center;color:#556;padding:30px">Brak wiadomoĹ›ci. Napisz pierwszy!</div>':msgs.map(m=>{
    const mine=m.from_uuid===G.playerUUID;
    return `<div style="text-align:${mine?'right':'left'};margin:8px 0">
      ${!mine?`<div style="font-size:10px;color:#f1c40f;font-weight:700;margin-bottom:2px;padding:0 6px">${_esc(m.from_nick||'?')}</div>`:''}
      <div style="display:inline-block;max-width:80%;background:${mine?'#1a3a5a':'#2a1a3a'};color:#fff;padding:8px 12px;border-radius:12px;font-size:13px">${_esc(m.text)}</div>
    </div>`;
  }).join('');
  ph.innerHTML=`
    <div style="padding:10px 14px;border-bottom:1px solid #1a2535;background:rgba(241,196,15,.06)">
      <div style="display:flex;align-items:center;gap:8px">
        <span style="font-size:24px">đźŹ†</span>
        <div style="flex:1">
          <div style="color:#f1c40f;font-weight:800;font-size:14px">${_esc(G.playerCrew.name)}</div>
          <div style="color:#aac;font-size:10px">${G.playerCrew.members.length} czĹ‚onkĂłw Â· grupa</div>
        </div>
      </div>
    </div>
    <div id="crew-chat-msgs" style="padding:6px 14px;max-height:340px;overflow-y:auto">${bubbles}</div>
    <div style="padding:10px 14px;display:flex;gap:8px;border-top:1px solid #1a2535">
      <input id="crew-chat-input" type="text" placeholder="WiadomoĹ›Ä‡ do crew..." maxlength="200" style="flex:1;background:#0a1525;border:1px solid #2a4a6a;color:#fff;padding:8px 10px;border-radius:6px" onkeydown="if(event.key==='Enter') window._crewSendChatMsg()">
      <button onclick="window._crewSendChatMsg()" class="cbtn" style="background:#27ae60;color:#fff">đź“¨</button>
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneCrew()">â† Crew</button></div>`;
  setTimeout(()=>{
    const c=document.getElementById('crew-chat-msgs');
    if(c) c.scrollTop=c.scrollHeight;
    document.getElementById('crew-chat-input')?.focus();
  },50);
};
window._crewSendChatMsg=async function(){
  const inp=document.getElementById('crew-chat-input');
  if(!inp) return;
  const text=inp.value.trim();
  if(text.length<1) return;
  inp.value='';
  const ok=await _crewSendMessage(text);
  if(ok) _openCrewChat(); /* refresh */
  else if(typeof showMsg==='function') showMsg('đźš« BĹ‚Ä…d wysyĹ‚ania','r');
};
/* â”€â”€â”€ CREW UI (renderPhoneCrew) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
window.renderPhoneCrew=async function(){
  const ph=document.getElementById('ph-content');
  if(!ph) return;
  const _esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  document.getElementById('ph-title')&&(document.getElementById('ph-title').textContent='đźŹ† Crew');
  if(!G.globalNick||!G.playerUUID){
    ph.innerHTML=`<div style="padding:18px;text-align:center">
      <div style="font-size:36px;margin-bottom:8px">đźŹ†</div>
      <h3 style="color:#f1c40f;margin:0 0 8px 0">Najpierw ustaw nick globalny</h3>
      <p style="color:#aac;font-size:12px;line-height:1.5;margin-bottom:14px">Crew wymaga konta â€” ustaw nick w đźŚŤ Tablicy wynikĂłw.</p>
      <button class="cbtn" style="width:100%;background:#1a3a5a;border-color:#7ec8e3;color:#fff" onclick="renderPhoneLeaderboard()">â†’ OtwĂłrz TablicÄ™ wynikĂłw</button>
      <button class="cbtn" style="width:100%;margin-top:6px" onclick="renderPhoneHome()">â† WrĂłÄ‡</button>
    </div>`;
    return;
  }
  ph.innerHTML=`<div style="padding:20px;text-align:center;color:#aac">âŹł ĹadujÄ™ Crew...</div>`;
  /* Sync crew + pending invites */
  await _crewFetchMyCrew();
  const invites=await _crewFetchPendingInvites();
  if(G.playerCrew){
    /* === JESTEM W CREW === */
    const challenge=await _crewFetchChallenge();
    const isLeader=G.playerCrew.isLeader;
    const memberRows=G.playerCrew.members.map(m=>{
      const isMe=m.userId===G.playerUUID;
      const isMemberLeader=m.role==='leader';
      const kickBtn=(isLeader && !isMe)?`<button onclick="_crewKickConfirm('${m.userId}','${_esc(m.nick).replace(/'/g,"\\'")}')" title="WyrzuÄ‡" style="background:transparent;border:1px solid #5a1a1a;color:#e74c3c;padding:3px 6px;border-radius:4px;cursor:pointer;font-size:10px">âś•</button>`:'';
      return `<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:${isMe?'rgba(241,196,15,.10)':'rgba(255,255,255,.03)'};border-radius:6px;margin-bottom:4px;border:1px solid ${isMe?'rgba(241,196,15,.3)':'#1a2535'}">
        <span style="font-size:18px">${isMemberLeader?'đź‘‘':'đźŽ¤'}</span>
        <div style="flex:1;min-width:0">
          <div style="color:${isMe?'#f1c40f':'#fff'};font-weight:700;font-size:13px;word-break:break-word;line-height:1.2">${_esc(m.nick)}${isMe?' (Ty)':''}</div>
          <div style="color:#778;font-size:10px">${isMemberLeader?'Leader':'CzĹ‚onek'}</div>
        </div>
        ${kickBtn}
      </div>`;
    }).join('');
    /* Challenge HTML */
    let challengeHtml='';
    if(challenge){
      const pct=Math.min(100,Math.round((challenge.progress||0)/challenge.target*100));
      const isDone=challenge.completed;
      challengeHtml=`
        <div style="background:linear-gradient(135deg,#2a1a05,#3a2a05);border:1px solid #c8a520;border-radius:10px;padding:10px 12px;margin-bottom:10px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
            <div style="display:flex;align-items:center;gap:6px">
              <span style="font-size:18px">${challenge.emoji||'đźŽŻ'}</span>
              <span style="font-size:10px;color:#c8a520;letter-spacing:1px;text-transform:uppercase;font-weight:700">Wyzwanie tygodnia</span>
            </div>
            ${isDone?'<span style="font-size:10px;color:#27ae60;font-weight:800">âś… UKOĹCZONE</span>':''}
          </div>
          <div style="color:#fff;font-weight:700;font-size:13px;margin-bottom:6px">${_esc(challenge.title)}</div>
          <div style="background:#0a0a14;height:8px;border-radius:4px;overflow:hidden;margin-bottom:4px">
            <div style="width:${pct}%;height:100%;background:linear-gradient(90deg,#c8a520,#f1c40f);transition:width .4s"></div>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:10px;color:#aac">
            <span>${(challenge.progress||0).toLocaleString('pl')} / ${(challenge.target||0).toLocaleString('pl')}</span>
            <span>${pct}%</span>
          </div>
          ${!isDone?`<div style="font-size:10px;color:#778;margin-top:6px">đźŽ Nagroda: +${challenge.reward_xp} XP, +${challenge.reward_money} zĹ‚ dla kaĹĽdego</div>`:''}
        </div>`;
    } else {
      challengeHtml=`<div style="background:rgba(155,89,182,.08);border:1px solid rgba(155,89,182,.3);border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:11px;color:#aac;text-align:center">âŹł Czekamy na nowe wyzwanie tygodnia${isLeader?'':' (leader je wygeneruje gdy wejdzie)'}</div>`;
    }
    /* Akcje wg roli */
    let actionBtns='';
    if(isLeader){
      const canInvite=G.playerCrew.members.length<4 && (G.friends||[]).length>0;
      actionBtns=`
        ${canInvite?'<button onclick="renderCrewInviteList()" class="cbtn" style="width:100%;margin-bottom:6px;background:#1a3a5a;border-color:#7ec8e3;color:#fff">âž• ZaproĹ› znajomego</button>':''}
        <button onclick="_openCrewChat()" class="cbtn" style="width:100%;margin-bottom:6px;background:#1a5a3a;border-color:#27ae60;color:#fff">đź’¬ OtwĂłrz czat crew</button>
        <button onclick="_crewDisbandConfirm()" class="cbtn" style="width:100%;margin-bottom:6px;background:#3a1a1a;border-color:#e74c3c;color:#e74c3c">đź’Ą RozwiÄ…ĹĽ crew</button>`;
    } else {
      actionBtns=`
        <button onclick="_openCrewChat()" class="cbtn" style="width:100%;margin-bottom:6px;background:#1a5a3a;border-color:#27ae60;color:#fff">đź’¬ OtwĂłrz czat crew</button>
        <button onclick="_crewLeaveConfirm()" class="cbtn" style="width:100%;margin-bottom:6px;background:#3a1a1a;border-color:#e74c3c;color:#e74c3c">đź‘‹ OpuĹ›Ä‡ crew</button>`;
    }
    ph.innerHTML=`<div style="padding:10px 12px">
      <div style="background:linear-gradient(135deg,#2a1a05,#1a0f3a);border:2px solid #f1c40f;border-radius:10px;padding:12px;margin-bottom:10px;text-align:center;box-shadow:0 0 20px rgba(241,196,15,.18)">
        <div style="font-size:32px;margin-bottom:2px">đźŹ†</div>
        <div style="color:#f1c40f;font-weight:900;font-size:18px;letter-spacing:.5px">${_esc(G.playerCrew.name)}</div>
        <div style="color:#aac;font-size:11px;margin-top:2px">${G.playerCrew.members.length} / 4 czĹ‚onkĂłw Â· ${isLeader?'JesteĹ› liderem':'CzĹ‚onek'}</div>
      </div>
      ${challengeHtml}
      <div style="background:#060e18;border:1px solid #1a2535;border-radius:10px;padding:8px 10px;margin-bottom:10px">
        <div style="font-size:10px;color:#7ec8e3;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;padding:0 2px">đź‘Ą CzĹ‚onkowie crew</div>
        ${memberRows}
      </div>
      ${actionBtns}
      <button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† Telefon</button>
    </div>`;
  } else {
    /* === NIE JESTEM W CREW === */
    const invitesHtml=invites.length>0?`
      <div style="background:rgba(243,156,18,.14);border:2px solid rgba(243,156,18,.5);border-radius:10px;padding:10px 12px;margin-bottom:10px;box-shadow:0 0 16px rgba(243,156,18,.18)">
        <div style="font-size:10px;color:#f39c12;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:6px">đź“Ą Zaproszenia do crew (${invites.length})</div>
        ${invites.map(inv=>`<div style="display:flex;align-items:center;gap:6px;padding:6px 0;font-size:12px;border-bottom:1px solid rgba(243,156,18,.15)">
          <span style="font-size:18px">đźŹ†</span>
          <div style="flex:1;min-width:0">
            <div style="color:#fff;font-weight:700;font-size:13px;word-break:break-word;line-height:1.2">${_esc(inv.crew_name||'Crew')}</div>
            <div style="color:#aac;font-size:10px">Od: ${_esc(inv.from_nick||'Leader')}</div>
          </div>
          <button onclick="_crewAcceptInvite(${inv.id},${inv.crew_id},'${_esc(inv.crew_name||'crew').replace(/'/g,"\\'")}')" title="Akceptuj" style="background:#1a5a1a;border:1px solid #2ecc71;color:#2ecc71;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">âś“ Akceptuj</button>
          <button onclick="_crewRejectInvite(${inv.id},'${_esc(inv.crew_name||'crew').replace(/'/g,"\\'")}')" title="OdrzuÄ‡" style="background:#3a1a1a;border:1px solid #e74c3c;color:#e74c3c;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">âś— OdrzuÄ‡</button>
        </div>`).join('')}
      </div>`:'';
    ph.innerHTML=`<div style="padding:10px 12px">
      <div style="background:linear-gradient(135deg,#1a0a25,#0a0f1a);border:1px solid #2a3a4a;border-radius:10px;padding:14px;margin-bottom:10px;text-align:center">
        <div style="font-size:36px;margin-bottom:6px">đźŹ†</div>
        <h3 style="color:#f1c40f;margin:0 0 6px 0;font-size:16px">Nie jesteĹ› w crew</h3>
        <p style="color:#aac;font-size:11px;line-height:1.5;margin:0">ZaĹ‚ĂłĹĽ wĹ‚asnÄ… paczkÄ™ albo czekaj na zaproszenie od znajomego.</p>
      </div>
      ${invitesHtml}
      <div style="background:#0a1018;border:1px solid #2a3a4a;border-radius:10px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;color:#aab;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">ZaĹ‚ĂłĹĽ crew</div>
        <div style="display:flex;gap:6px;margin-bottom:6px">
          <input id="crew-name-input" type="text" placeholder="Nazwa crew (2-30 znakĂłw)" maxlength="30" style="flex:1;background:#050a14;border:1px solid #2a4a6a;color:#fff;padding:8px 10px;border-radius:6px;font-size:13px">
          <button onclick="_crewCreateBtn()" style="background:#2a1a05;border:1px solid #f1c40f;color:#f1c40f;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:700;font-family:inherit">đźŹ† ZaĹ‚ĂłĹĽ</button>
        </div>
        <div id="crew-create-status" style="font-size:11px;min-height:14px;text-align:center;color:#aac"></div>
        <div style="font-size:10px;color:#778;line-height:1.4;margin-top:6px">đź’ˇ Crew = max 4 znajomych razem. WspĂłlny czat + tygodniowe wyzwania + nagrody.</div>
      </div>
      <button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† Telefon</button>
    </div>`;
  }
};
window._crewCreateBtn=async function(){
  const inp=document.getElementById('crew-name-input');
  const status=document.getElementById('crew-create-status');
  if(!inp||!status) return;
  const name=inp.value.trim();
  if(name.length<2){status.style.color='#e74c3c';status.textContent='âťŚ Min 2 znaki';return;}
  status.style.color='#aac';status.textContent='âŹł TworzÄ™...';
  const r=await _crewCreate(name);
  if(!r.ok){status.style.color='#e74c3c';status.textContent='âťŚ '+r.error;return;}
  status.style.color='#27ae60';status.textContent='âś… Utworzono!';
  setTimeout(()=>renderPhoneCrew(),700);
};
window._crewLeaveConfirm=function(){
  if(typeof gameConfirm==='function'){
    gameConfirm('Na pewno opuĹ›ciÄ‡ crew "'+G.playerCrew.name+'"?',async()=>{await _crewLeave();renderPhoneCrew();});
  }
};
window._crewDisbandConfirm=function(){
  if(typeof gameConfirm==='function'){
    gameConfirm('RozwiÄ…zaÄ‡ crew "'+G.playerCrew.name+'"?\nWszyscy czĹ‚onkowie zostanÄ… wyrzuceni, czat i postÄ™p wyzwaĹ„ zniknÄ….',async()=>{await _crewDisband();renderPhoneCrew();});
  }
};
window._crewKickConfirm=function(memberUuid,memberNick){
  if(typeof gameConfirm==='function'){
    gameConfirm('WyrzuciÄ‡ "'+memberNick+'" z crew?',async()=>{await _crewKickMember(memberUuid,memberNick);renderPhoneCrew();});
  }
};
window.renderCrewInviteList=async function(){
  const ph=document.getElementById('ph-content');
  if(!ph||!G.playerCrew||!G.playerCrew.isLeader) return;
  const _esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  document.getElementById('ph-title')&&(document.getElementById('ph-title').textContent='âž• ZaproĹ› do crew');
  const inCrewIds=new Set(G.playerCrew.members.map(m=>m.userId));
  /* SprawdĹş outstanding pending invites tej crew */
  const outstanding=await _lbFetch(`crew_invites?crew_id=eq.${G.playerCrew.id}&status=eq.pending&limit=20`);
  const pendingIds=new Set(Array.isArray(outstanding)?outstanding.map(i=>i.to_uuid):[]);
  const available=(G.friends||[]).filter(f=>!inCrewIds.has(f.userId) && !pendingIds.has(f.userId));
  if(available.length===0){
    ph.innerHTML=`<div style="padding:20px;text-align:center;color:#778;font-size:13px">
      <div style="font-size:36px;margin-bottom:8px">đź“­</div>
      ${pendingIds.size>0?'Wszyscy znajomi juĹĽ majÄ… wysĹ‚ane zaproszenia lub sÄ… w crew.':'Nie masz znajomych do zaproszenia.<br>Dodaj kogoĹ› w đź‘Ą Znajomi.'}
      <div style="padding:14px 0 0"><button class="cbtn" style="width:100%" onclick="renderPhoneCrew()">â† Crew</button></div>
    </div>`;
    return;
  }
  const rows=available.map(f=>{
    const safeNick=_esc(f.nick).replace(/'/g,"\\'");
    return `<div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:rgba(126,200,227,.05);border:1px solid #2a3a4a;border-radius:6px;margin-bottom:5px">
      <span style="font-size:18px">đź‘¤</span>
      <span style="flex:1;color:#fff;font-weight:600;font-size:13px;word-break:break-word;line-height:1.2">${_esc(f.nick)}</span>
      <button onclick="_crewInviteBtn('${_esc(f.userId)}','${safeNick}',this)" style="background:#1a3a5a;border:1px solid #7ec8e3;color:#7ec8e3;padding:4px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">đź“¤ ZaproĹ›</button>
    </div>`;
  }).join('');
  ph.innerHTML=`<div style="padding:10px 12px">
    <div style="background:rgba(241,196,15,.06);border:1px solid rgba(241,196,15,.25);border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:11px;color:#aac;text-align:center">
      ZaproĹ› znajomych do <b style="color:#f1c40f">${_esc(G.playerCrew.name)}</b> Â· ${G.playerCrew.members.length}/4 w crew
    </div>
    ${rows}
    <button class="cbtn" style="width:100%;margin-top:8px" onclick="renderPhoneCrew()">â† Crew</button>
  </div>`;
};
window._crewInviteBtn=async function(userId,nick,btn){
  if(btn){btn.disabled=true;btn.textContent='âŹł WysyĹ‚am...';}
  const r=await _crewInviteMember(userId,nick);
  if(r.ok){
    if(btn){btn.style.background='#1a5a1a';btn.style.borderColor='#2ecc71';btn.style.color='#2ecc71';btn.textContent='âś“ WysĹ‚ano';}
    if(typeof showMsg==='function') showMsg('đź“¤ Zaproszenie do crew wysĹ‚ane do: '+nick,'g',3500);
  } else {
    if(btn){btn.disabled=false;btn.textContent='đź“¤ ZaproĹ›';}
    if(typeof showMsg==='function') showMsg('đźš« '+r.error,'r');
  }
};

/* â”€â”€â”€ CREW CHALLENGES (Faza E) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const CREW_CHALLENGE_TYPES=[
  {type:'earn_money',  emoji:'đź’°', title:'Zarobcie razem 100 000 zĹ‚', target:100000},
  {type:'play_concerts',emoji:'đźŽ¤',title:'Zagrajcie razem 5 koncertĂłw', target:5},
  {type:'record_tracks',emoji:'đź’ż',title:'Nagrajcie razem 3 tracki', target:3},
  /* v2.1.141: gain_fans aktywowane â€” refactor G.fans hooks ukoĹ„czony, wszystkie 11 miejsc uĹĽywa addFans() wrapper (L12270+). */
  {type:'gain_fans',   emoji:'đź‘Ą', title:'ZdobÄ…dĹşcie razem 5 000 fanĂłw', target:5000},
];
function _crewWeekKey(){
  /* ISO week format YYYY-WXX */
  const d=new Date();
  d.setHours(0,0,0,0);
  d.setDate(d.getDate()+4-(d.getDay()||7));
  const yearStart=new Date(d.getFullYear(),0,1);
  const weekNum=Math.ceil(((d-yearStart)/86400000+1)/7);
  return d.getFullYear()+'-W'+String(weekNum).padStart(2,'0');
}
window._crewFetchChallenge=async function(){
  if(!G.playerCrew) return null;
  const wk=_crewWeekKey();
  const rows=await _lbFetch(`crew_challenges?crew_id=eq.${G.playerCrew.id}&week_key=eq.${wk}&limit=1`);
  if(!Array.isArray(rows)||rows.length===0){
    /* Auto-generate wyzwanie dla tego tygodnia jeĹ›li jestem leaderem */
    if(G.playerCrew.isLeader){
      const t=CREW_CHALLENGE_TYPES[Math.floor(Math.random()*CREW_CHALLENGE_TYPES.length)];
      await _lbFetch('crew_challenges',{
        method:'POST',
        headers:{'Prefer':'resolution=ignore-duplicates,return=minimal'},
        body:JSON.stringify({
          crew_id:G.playerCrew.id, week_key:wk, type:t.type, emoji:t.emoji, title:t.title,
          target:t.target, progress:0, reward_xp:500, reward_money:1000
        })
      });
      const refetch=await _lbFetch(`crew_challenges?crew_id=eq.${G.playerCrew.id}&week_key=eq.${wk}&limit=1`);
      return Array.isArray(refetch)&&refetch.length>0?refetch[0]:null;
    }
    return null;
  }
  return rows[0];
};
/* v2.1.55 Amper: NAPRAWA race condition w postÄ™pie crew challenge.
   WczeĹ›niej: kaĹĽdy earn() (kilkanaĹ›cie/min) wywoĹ‚ywaĹ‚ async _crewAddProgress â†’ fetch + patch.
   Wszystkie rĂłwnoczesne wywoĹ‚ania czytaĹ‚y TÄ SAMÄ„ starÄ… wartoĹ›Ä‡ progress i nadpisywaĹ‚y siÄ™ â€” Amper zarobiĹ‚ >100k ale progress utknÄ…Ĺ‚ na ~10k bo wszystko poza ostatnim patchem ginÄ™Ĺ‚o.
   Naprawa: lokalna kolejka per-type + atomowy flush co max 5s. Wielokrotne earn() sumujÄ… siÄ™ lokalnie, jeden patch wysyĹ‚a sumÄ™. */
window._crewProgressQueue=window._crewProgressQueue||{};
window._crewProgressLastFlush=window._crewProgressLastFlush||0;
window._crewProgressFlushing=false;
window._crewAddProgress=function(type,amount){
  if(!G.playerCrew||!amount||amount<=0) return;
  window._crewProgressQueue[type]=(window._crewProgressQueue[type]||0)+amount;
  const now=Date.now();
  if(now-window._crewProgressLastFlush>5000){
    window._crewProgressLastFlush=now;
    _crewFlushProgress();
  }
};
async function _crewFlushProgress(){
  if(window._crewProgressFlushing) return;
  if(!G.playerCrew) return;
  window._crewProgressFlushing=true;
  try{
    const challenge=await _crewFetchChallenge();
    if(!challenge||challenge.completed){window._crewProgressQueue={};return;}
    const amount=window._crewProgressQueue[challenge.type]||0;
    if(amount<=0) return;
    window._crewProgressQueue[challenge.type]=0;
    const newProgress=Math.min(challenge.target,(challenge.progress||0)+amount);
    const willComplete=newProgress>=challenge.target;
    await _lbFetch(`crew_challenges?id=eq.${challenge.id}`,{
      method:'PATCH',
      body:JSON.stringify(willComplete?{progress:newProgress,completed:true,completed_at:new Date().toISOString()}:{progress:newProgress})
    });
    if(willComplete){
      if(typeof earn==='function') earn(challenge.reward_money||1000);
      if(typeof addXP==='function') addXP(challenge.reward_xp||500);
      if(typeof showMsg==='function') showMsg(`đźŹ† CREW WYZWANIE UKOĹCZONE! +${challenge.reward_xp||500} XP, +${challenge.reward_money||1000} zĹ‚`,'g',6000);
      if(typeof addNotif==='function') addNotif(`đźŹ† Crew "${G.playerCrew.name}" ukoĹ„czyĹ‚o: ${challenge.title}`);
    }
  }catch(e){console.warn('[crew flush]',e);}
  finally{window._crewProgressFlushing=false;}
}
/* Okresowy flush â€” gwarantuje ĹĽe nawet jeĹ›li gracz nie wywoĹ‚a earn() przez kilka minut,
   nazbierany progres (np. z koncertu z duĹĽÄ… wypĹ‚atÄ…) trafi do bazy. */
setInterval(()=>{
  if(G.playerCrew && Object.keys(window._crewProgressQueue||{}).some(k=>window._crewProgressQueue[k]>0)){
    _crewFlushProgress();
  }
},30000);
/* Flush przy zamkniÄ™ciu karty â€” best-effort, nie blokujemy unload.
   v2.1.123: Wave 2 W17 / Wave 4 W45 â€” persist queue do localStorage przy beforeunload, retry on next load. */
window.addEventListener('beforeunload',()=>{
  if(G.playerCrew && Object.keys(window._crewProgressQueue||{}).some(k=>window._crewProgressQueue[k]>0)){
    _crewFlushProgress();
    try{localStorage.setItem('snowy_crew_queue',JSON.stringify(window._crewProgressQueue));}catch(_){}
  }
});
/* v2.1.123: Restore queue at load â€” if Supabase fail at beforeunload, retry. */
try{
  const _savedQ=localStorage.getItem('snowy_crew_queue');
  if(_savedQ){
    const _q=JSON.parse(_savedQ);
    if(_q && typeof _q==='object'){
      window._crewProgressQueue=window._crewProgressQueue||{};
      for(const k in _q) window._crewProgressQueue[k]=(window._crewProgressQueue[k]||0)+(_q[k]||0);
      localStorage.removeItem('snowy_crew_queue');
    }
  }
}catch(_){}

function scaleGame(){
  /* v2.1.155: Mobile portrait fix v2 â€” character creator/menu byĹ‚y mikroskopijne (scale 0.29 dla 375x667).
     Strategy: detect mobile + pre-game state (menu/creator visible) â†’ DISABLE #wrap transform, pokaĹĽ natywne UI.
     Po startGame (gameplay) â€” normalne scaling (gracz widzi canvas z auto-zoom przez #wrap scale).
     Plus: rotate hint na bardzo maĹ‚ych portraitach (<420px). */
  const isMobile=window.innerWidth<900;
  const el=document.getElementById('wrap');
  /* v2.1.163: null guard â€” scaleGame moĹĽe byÄ‡ wywoĹ‚ywane podczas init przed peĹ‚nym DOM parse */
  if(!el) return;
  /* Pre-game state detection: menu visible LUB creator visible (nie zaczÄ™ta gra) */
  const menuEl=document.getElementById('menu');
  const creatorEl=document.getElementById('creator');
  const inPreGame = (menuEl && window.getComputedStyle(menuEl).display!=='none') ||
                    (creatorEl && window.getComputedStyle(creatorEl).display!=='none');
  if(isMobile && inPreGame){
    /* Pre-game na mobile: NATIVE UI, no scaling â€” #wrap full viewport, menu/creator natywne pixele */
    el.style.transform='none';
    el.style.left='0';
    el.style.top='0';
    el.style.width='100vw';
    el.style.height='100vh';
    document.body.classList.add('mobile-pregame');
  } else {
    /* Gameplay scaling (lub desktop) */
    document.body.classList.remove('mobile-pregame');
    el.style.width='1280px';
    el.style.height='720px';
    const s=Math.min(window.innerWidth/1280,window.innerHeight/720);
    const scaledW=1280*s, scaledH=720*s;
    el.style.transform=`scale(${s})`;
    el.style.left=Math.max(0,(window.innerWidth-scaledW)/2)+'px';
    el.style.top=Math.max(0,(window.innerHeight-scaledH)/2)+'px';
  }
  const isPortrait=window.innerHeight>window.innerWidth;
  /* v2.1.153: rotate hint dla bardzo maĹ‚ych portrait (<420px width) */
  let hint=document.getElementById('rotate-hint');
  if(isMobile && isPortrait && window.innerWidth<420){
    if(!hint){
      hint=document.createElement('div');
      hint.id='rotate-hint';
      hint.style.cssText='position:fixed;top:8px;left:50%;transform:translateX(-50%);background:rgba(40,80,140,.92);color:#fff;padding:8px 14px;border-radius:8px;border:1px solid #7ec8e3;font-family:inherit;font-size:12px;font-weight:700;z-index:9998;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.5)';
      hint.innerHTML='đź”„ ObrĂłÄ‡ telefon poziomo dla lepszej rozgrywki';
      document.body.appendChild(hint);
      setTimeout(()=>{if(hint)hint.style.opacity='0.7';},4000);
    }
  } else if(hint){
    hint.remove();
  }
}
window.addEventListener('resize',scaleGame);
scaleGame();
// v1.8.57: generowanie gwiazd i Ĺ›niegu w menu (deterministyczne â€” wartoĹ›ci staĹ‚e miÄ™dzy startami ĹĽeby nie migotaĹ‚y)
(function _initMenuFx(){
  const stars=document.getElementById('menu-stars');
  if(stars && !stars.children.length){
    // 80 gwiazd na caĹ‚e tĹ‚o menu, rozsiane po niebie (gĂłrne 60% ekranu)
    for(let i=0;i<80;i++){
      const sp=document.createElement('span');
      // pseudo-random deterministyczny (sin)
      const x=((i*37)%97)/97*100;
      const y=((i*53)%89)/89*55; // tylko gĂłrne 55% (niebo)
      const dur=2.2+((i*7)%30)/10;
      const delay=((i*13)%30)/10;
      const size=1+(i%3)*0.5;
      sp.style.cssText=`left:${x}%;top:${y}%;width:${size}px;height:${size}px;animation-duration:${dur}s;animation-delay:${delay}s;`;
      stars.appendChild(sp);
    }
  }
  const snow=document.getElementById('menu-snow');
  if(snow && !snow.children.length){
    // 35 pĹ‚atkĂłw Ĺ›niegu losowo rozsianych (Unicode glyph)
    const glyphs=['âť„','âś¦','âť…','*'];
    for(let i=0;i<35;i++){
      const sp=document.createElement('span');
      const x=((i*41)%101)/101*100;
      const dur=8+((i*11)%80)/10;
      const delay=((i*17)%120)/10;
      const size=10+((i*23)%14);
      const glyph=glyphs[i%4];
      sp.textContent=glyph;
      sp.style.cssText=`left:${x}%;font-size:${size}px;animation-duration:${dur}s;animation-delay:-${delay}s;`;
      snow.appendChild(sp);
    }
  }
})();
// WymuĹ› ĹĽeby elementy z position:fixed byĹ‚y w body (poza skalowanym #wrap)
// position:fixed wewnÄ…trz transformowanego rodzica Ĺ‚amie siÄ™ â€” pozycja jest Ă—scale
// v1.8.39: dodane 'msg' (komunikaty showMsg) â€” wczeĹ›niej na 2k/4k pojawiaĹ‚y siÄ™ poza ekranem.
function _moveFixedElementsOutOfWrap(){
  ['hud-tooltip','admin-panel','audio-panel','msg'].forEach(id=>{
    const el=document.getElementById(id);
    if(el && el.parentElement && el.parentElement !== document.body){
      document.body.appendChild(el);
    }
  });
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',_moveFixedElementsOutOfWrap);
else _moveFixedElementsOutOfWrap();
setTimeout(_moveFixedElementsOutOfWrap,500); // backup
loop();
</script>
