<!-- CHARACTER CREATOR -->
<div id="creator">
  <h2>StwĂłrz postaÄ‡</h2>
  <p class="csub">Wybierz wyglÄ…d swojej postaci</p>
  <div class="creator-body">
    <div>
      <!-- F4.6: wiÄ™kszy podglÄ…d 240x340 (byĹ‚o 180x260) -->
      <div class="char-preview" style="background:linear-gradient(180deg,#1a2840,#0a1020);border:1px solid #2a3a5a;border-radius:8px;padding:8px"><canvas id="char-canvas" width="240" height="340"></canvas></div>
      <button class="copt-btn" onclick="randomizeCharacter()" style="width:100%;margin-top:8px;background:linear-gradient(135deg,#9b59b6,#3498db);border:1px solid #cf9be8;color:#fff;font-weight:700;padding:10px;font-size:13px;letter-spacing:1px">đźŽ˛ LOSUJ POSTAÄ†</button>
    </div>
    <div class="creator-opts">
      <div class="copt">
        <label>ImiÄ™</label>
        <input class="name-inp" id="char-name" type="text" value="Traper" maxlength="16" pattern="[a-zA-Z0-9 Ä…Ä‡Ä™Ĺ‚Ĺ„ĂłĹ›ĹşĹĽÄ„Ä†ÄĹĹĂ“ĹšĹąĹ»_-]{2,16}" onkeydown="if(event.key==='Enter' && typeof startGame==='function'){event.preventDefault();startGame();}"> <!-- v2.1.117: W66/W67 â€” pattern alphanum+PL chars 2-16 + Enter handler -->
      </div>
      <div class="copt">
        <label>Kolor skĂłry</label>
        <div class="copt-btns">
          <!-- F4.6: 3 â†’ 6 odcieni skĂłry -->
          <button class="copt-btn" onclick="setSkin('verylight')" id="skin-verylight">Bardzo jasna</button>
          <button class="copt-btn active" onclick="setSkin('light')" id="skin-light">Jasna</button>
          <button class="copt-btn" onclick="setSkin('medium')" id="skin-medium">Ĺšrednia</button>
          <button class="copt-btn" onclick="setSkin('olive')" id="skin-olive">Oliwkowa</button>
          <button class="copt-btn" onclick="setSkin('dark')" id="skin-dark">Ciemna</button>
          <button class="copt-btn" onclick="setSkin('verydark')" id="skin-verydark">Bardzo ciemna</button>
        </div>
      </div>
      <div class="copt">
        <label>Fryzura</label>
        <div class="copt-btns">
          <button class="copt-btn active" onclick="setHair(0)" id="hair-0">KrĂłtka</button>
          <button class="copt-btn" onclick="setHair(1)" id="hair-1">DĹ‚uga</button>
          <button class="copt-btn" onclick="setHair(2)" id="hair-2">Dredy</button>
          <button class="copt-btn" onclick="setHair(3)" id="hair-3">Ĺysy</button>
          <button class="copt-btn" onclick="setHair(4)" id="hair-4">Afro</button>
          <button class="copt-btn" onclick="setHair(5)" id="hair-5">Irokez</button>
          <button class="copt-btn" onclick="setHair(6)" id="hair-6">Bokser</button>
          <button class="copt-btn" onclick="setHair(7)" id="hair-7">Loczki</button>
          <button class="copt-btn" onclick="setHair(8)" id="hair-8">Quiff</button>
          <button class="copt-btn" onclick="setHair(9)" id="hair-9">Buzz cut</button>
        </div>
      </div>
      <div class="copt">
        <label>Kolor ubrania</label>
        <div class="copt-btns">
          <!-- F4.6: 4 â†’ 8 kolorĂłw ubrania -->
          <button class="copt-btn active" onclick="setCloth('#2a5080',this)" style="color:#7ec8e3">Niebieski</button>
          <button class="copt-btn" onclick="setCloth('#802a2a',this)" style="color:#e74c3c">Czerwony</button>
          <button class="copt-btn" onclick="setCloth('#2a6030',this)" style="color:#27ae60">Zielony</button>
          <button class="copt-btn" onclick="setCloth('#0a0a0a',this)" style="color:#aaa">Czarny</button>
          <button class="copt-btn" onclick="setCloth('#e8e0d0',this)" style="color:#e8e0d0">BiaĹ‚y</button>
          <button class="copt-btn" onclick="setCloth('#7a3aa3',this)" style="color:#c89adb">Fioletowy</button>
          <button class="copt-btn" onclick="setCloth('#e0a020',this)" style="color:#f1c40f">Ĺ»ĂłĹ‚ty</button>
          <button class="copt-btn" onclick="setCloth('#e07820',this)" style="color:#e67e22">PomaraĹ„czowy</button>
        </div>
      </div>
      <div class="copt">
        <label>Kolor spodni</label>
        <div class="copt-btns">
          <button class="copt-btn active" onclick="setPants('#1a2a3a',this)" id="pants-0" style="color:#7ec8e3">Granat</button>
          <button class="copt-btn" onclick="setPants('#0a0a0a',this)" id="pants-1" style="color:#aaa">Czarny</button>
          <button class="copt-btn" onclick="setPants('#3a2a1a',this)" id="pants-2" style="color:#c8a060">BrÄ…zowy</button>
          <button class="copt-btn" onclick="setPants('#4a4a4a',this)" id="pants-3" style="color:#999">Szary</button>
          <!-- F4.6: dodane 4 kolory -->
          <button class="copt-btn" onclick="setPants('#1a3a1a',this)" id="pants-4" style="color:#27ae60">Khaki</button>
          <button class="copt-btn" onclick="setPants('#5a2a3a',this)" id="pants-5" style="color:#e91e8c">Bordowy</button>
          <button class="copt-btn" onclick="setPants('#3a5a8a',this)" id="pants-6" style="color:#5a8acf">Jeansy</button>
          <button class="copt-btn" onclick="setPants('#e8e8e0',this)" id="pants-7" style="color:#e8e8e0">BiaĹ‚e</button>
        </div>
      </div>
      <div class="copt">
        <label>Kolor butĂłw</label>
        <div class="copt-btns">
          <button class="copt-btn active" onclick="setShoes('#0a0a0a',this)" id="shoes-0" style="color:#aaa">Czarne</button>
          <button class="copt-btn" onclick="setShoes('#4a2a0a',this)" id="shoes-1" style="color:#c87040">BrÄ…zowe</button>
          <button class="copt-btn" onclick="setShoes('#e8e0d0',this)" id="shoes-2" style="color:#e8e0d0">BiaĹ‚e</button>
          <button class="copt-btn" onclick="setShoes('#c83020',this)" id="shoes-3" style="color:#e74c3c">Czerwone</button>
          <!-- F4.6: dodane 4 kolory -->
          <button class="copt-btn" onclick="setShoes('#3a5a8a',this)" id="shoes-4" style="color:#5a8acf">Niebieskie</button>
          <button class="copt-btn" onclick="setShoes('#e0a020',this)" id="shoes-5" style="color:#f1c40f">Ĺ»ĂłĹ‚te</button>
          <button class="copt-btn" onclick="setShoes('#7a3aa3',this)" id="shoes-6" style="color:#c89adb">Fioletowe</button>
          <button class="copt-btn" onclick="setShoes('#5a5a5a',this)" id="shoes-7" style="color:#aaa">Szare</button>
        </div>
      </div>
      <button class="start-btn" onclick="startGame()">Zaczynaj â–¶</button>
    </div>
  </div>
</div>

