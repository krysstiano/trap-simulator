    {
      em:'đź›’', title:'JEDZENIE I PICIE',
      desc:'Sklep SpoĹĽywczy (codzienne zakupy), Zbyszek (street food + przyjaĹşĹ„), Restauracja (eleganckie posiĹ‚ki), Targ (Ĺ›wieĹĽe produkty), Pizzeria (na wynos).',
      places:[
        {wx:184, wy:749, label:'SKLEP SPOĹ»YWCZY', zoom:1.7},
        {wx:1545, wy:748, label:'ZBYSZEK (KEBAB)', zoom:1.8}, /* FIX: 1180 â†’ 1545 (npc_vendor) */
        {wx:1474, wy:2285, label:'RESTAURACJA', zoom:1.6},
