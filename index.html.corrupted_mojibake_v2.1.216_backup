    <button onclick="adminMaxFans()" style="background:#1a1a3a;border:1px solid #3498db;color:#3498db;padding:8px;border-radius:6px;font-size:12px;cursor:pointer">đź‘Ą Maks. fani (1mln)</button>
    <button onclick="adminAddMoney(1000000)" style="background:#1a2a1a;border:1px solid #2ecc71;color:#2ecc71;padding:8px;border-radius:6px;font-size:12px;cursor:pointer">đź’° +1mln zĹ‚</button>
