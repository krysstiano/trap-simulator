          'đź“¸ Kulisy studia':['#3a0a4a','#1a0a2a','đźŽ™'],
          'đźŽµ Teaser nowego bitu':['#0a3a4a','#051a25','đźŽ¶'],
          'đźŚ† Lifestyle':['#2a3a5a','#1a2a3a','đźŚ'],
          'đźŽ¤ Po koncercie':['#5a0a3a','#2a0510','đźŽ¤'],
