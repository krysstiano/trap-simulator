    case 'park':         drawBuilding(sx,sy,w,h,'#1a4a1a','Park','#27ae60');break;
    case 'silownia':     drawBuilding(sx,sy,w,h,'#3a1a0a','SiĹ‚ownia','#e67e22','đźŹ‹ď¸Ź',false,{commercial:true});drawGymExtras(sx,sy,w,h);break;
    case 'szpital':      drawBuilding(sx,sy,w,h,'#d0e0f0','Szpital','#e74c3c','đźŹĄ',false,{commercial:true});drawHospitalCross(sx,sy,w,h);break;
