const parkPeds = [];
function initParkLife(){
  parkPeds.length=0;
  // Park: x:96-672, y:864-1200. NPC w wewnÄ™trznej strefie 130-640, 900-1180.
  // F4.1 FIX: gardener â†’ business (przerwa lunchowa w parku), pozostaĹ‚e typy lepsze
  const startPos=[
    {wx:200,wy:950,type:'runner'},
    {wx:380,wy:1050,type:'dogwalker'},
    {wx:550,wy:1100,type:'business'},
    {wx:600,wy:950,type:'elderly'},
    {wx:250,wy:1080,type:'couple1'},
    {wx:260,wy:1080,type:'couple2'},
    // F+ 2026-05-12 #87: 4 dodatkowi NPC w parku (user feedback "wszyscy NPC zniknÄ™li")
    {wx:150,wy:1100,type:'casual'},
    {wx:480,wy:950,type:'casual'},
    {wx:330,wy:1150,type:'kid'},
    {wx:580,wy:1050,type:'runner'},
  ];
  for(const sp of startPos){
    parkPeds.push({
      wx:sp.wx, wy:sp.wy, type:sp.type,
      dx:(Math.random()>.5?1:-1)*(sp.type==='runner'?1.0:0.25+Math.random()*0.25),
      dy:(Math.random()>.5?1:-1)*0.12,
      anim:rnd(0,100), phase:rnd(0,60),
      idleTimer:0
    });
  }
}
function initCityLife(){
  // Pedestrians near all 3 roads and zones
  // Bezpieczne wy â€” stopy NPC sÄ… ~51px niĹĽej, ĹĽeby NIE wpadaĹ‚y na drogÄ™ uwzglÄ™dniamy caĹ‚e ciaĹ‚o
  // Drogi poziome: H1=384-576, H2=1920-2112, H3=2880-3072
  const pedYs=[
    290,320,         // North sidewalk (288-383): stopy 341/371 â‰¤ 383 âś“
    590,615,         // H1 south sidewalk (576-671): stopy 641/666 â‰¤ 671 âś“
    // 720/900/1100 USUNIÄTE â€” kolidowaĹ‚y z budynkami CENTRAL Z2/Z3 i ROW A/B,
    // przez co ped odbijaĹ‚ siÄ™ w miejscu obok sali koncertowej, IKEA, parku.
    1830,1860,       // H2 north sidewalk (1824-1919): stopy 1881/1911 â‰¤ 1919 âś“
    2120,2150,       // H2 south sidewalk (2112-2207): stopy 2171/2201 â‰¤ 2207 âś“
    2790,            // Strefa przed H3 (gĹ‚owa<2835) â€” 2600 usuniÄ™te (zbyt blisko drapaczy chmur)
    3080,            // H3 south sidewalk (3072-3167): stopy 3131 â‰¤ 3167 âś“
    290,615,1830,2150,  // dublujemy bezpieczne wartoĹ›ci aby utrzymaÄ‡ 14 ped'Ăłw
  ];
  // Sesja 2: typed NPCs â€” 24 sztuk, 6 typĂłw + system TRAS WAYPOINT
  const npcTypes=[
    'casual','casual','casual','casual','casual','casual','casual','casual','casual','casual','casual','casual',
    'runner','runner',
    'business','business','business',
    'elderly','elderly',
    'kid','kid',
    'dogwalker','dogwalker','dogwalker',
  ];
  const skinPalette=['#f4d3a8','#e0a870','#c07840','#a06030','#704020','#d4905a','#b87640','#8a4a20'];
  const hairPalette=['#1a1a1a','#3a2a18','#5a3a18','#8a5a28','#c89858','#f0d090','#5a3a2a','#202020','#a85820'];
  const clothPalette=['#2a3a5a','#3a2a4a','#1a3a2a','#3a1a1a','#4a3a1a','#5a2a1a','#2a4a4a','#704020','#5a3a8a','#3a5a2a','#a04020','#205a40'];
  const accentPalette=['#e74c3c','#3498db','#2ecc71','#f39c12','#9b59b6','#e91e8c','#ffffff','#ffd700','#ff6347'];

  // Bezpieczne pasy chodnikĂłw (gdzie NPC moĹĽe siÄ™ poruszaÄ‡)
  const SIDEWALK_YS=[320,625,1860,2150,2820,3110];

  // F+ NPC spawn DODATKOWO blisko pasĂłw zebra (ĹĽeby gracz zawsze widziaĹ‚ kogoĹ› przy pasach)
  // 6 NPC w pasie po obu stronach 3 V-roads (V1, V2, V3) â€” wy=290 (chodnik H_N H1)
  const _crosswalkSpawns=[
    {wx:735, wy:290},  // V1 pas W, chodnik N H1
    {wx:990, wy:615},  // V1 pas E, chodnik S H1
    {wx:2180, wy:290}, // V2 pas W, chodnik N H1
    {wx:2430, wy:615}, // V2 pas E, chodnik S H1
    {wx:3430, wy:1830},// V3 pas W, chodnik N H2
    {wx:3680, wy:2150},// V3 pas E, chodnik S H2
  ];
  for(const cs of _crosswalkSpawns){
    /* v2.1.118: Wave 8 W82 â€” NPC speed scaling z player level (lvl 1â†’0.9, lvl 50â†’1.17 â€” +30% gradient ĹĽeby NPC nie wyglÄ…daĹ‚y jak posÄ…gi w late game). */
    const _npcSpd=0.9+Math.min(0.27,(G.level||1)*0.005);
    cityPeds.push({
      wx:cs.wx, wy:cs.wy,
      baseSpd:_npcSpd,
      dx:(Math.random()>.5?0.9:-0.9),
      phase:rnd(0,60), anim:rnd(0,100), idleTimer:0, idleType:0,
      type:'casual',
      _colors:{sc:skinPalette[Math.floor(Math.random()*skinPalette.length)],
               cc:clothPalette[Math.floor(Math.random()*clothPalette.length)],
               scarfC:accentPalette[Math.floor(Math.random()*accentPalette.length)],
               hatC:accentPalette[Math.floor(Math.random()*accentPalette.length)],
               hairC:hairPalette[Math.floor(Math.random()*hairPalette.length)],
               hasHat:Math.random()<0.4, height:1.0},
    });
  }
  for(let i=0;i<24;i++){
    const type=npcTypes[i%npcTypes.length];
    const baseSpd=type==='runner'?2.2:type==='kid'?1.8:type==='elderly'?0.35:type==='business'?1.1:type==='dogwalker'?0.65:0.85+Math.random()*0.3;
    const speedVar=baseSpd*(0.9+Math.random()*0.2);
    const _skin=skinPalette[Math.floor(Math.random()*skinPalette.length)];
    const _hair=type==='elderly'?'#d8d8d8':hairPalette[Math.floor(Math.random()*hairPalette.length)];
    const _cloth=type==='runner'?accentPalette[Math.floor(Math.random()*accentPalette.length)]:
                 type==='business'?'#1a1a2a':
                 type==='kid'?accentPalette[Math.floor(Math.random()*accentPalette.length)]:
                 clothPalette[Math.floor(Math.random()*clothPalette.length)];
    const _accent=accentPalette[Math.floor(Math.random()*accentPalette.length)];
    const _hasHat=type==='casual'?(Math.random()<0.4):type==='kid'?true:type==='runner'?(Math.random()<0.5):false;
    const _height=type==='kid'?0.75:type==='elderly'?0.92:1.0;
    // Start: losowy chodnik, losowa pozycja X â€” z MIN spacing 90px (F+ 2026-05-12 #54 fix "NPC zlani")
    const startY=SIDEWALK_YS[Math.floor(Math.random()*SIDEWALK_YS.length)];
    let startX=200+Math.random()*4000;
    for(let attempt=0;attempt<8;attempt++){
      let collide=false;
      for(const other of cityPeds){
        if(other.wy===startY && Math.abs(other.wx-startX)<90){collide=true;break;}
      }
      if(!collide) break;
      startX=200+Math.random()*4000;
    }
    cityPeds.push({
      wx:startX, wy:startY,
      baseSpd:speedVar,
      dx:(Math.random()>.5?1:-1)*speedVar,
      phase:rnd(0,60), anim:rnd(0,100), idleTimer:0, idleType:0,
      type,
      _colors:{sc:_skin,cc:_cloth,scarfC:_accent,hatC:_accent,hairC:_hair,
               hasHat:_hasHat,height:_height},
    });
  }
  // Cars on H1/H2/H3 â€” gĂłrna poĹ‚owa drogi jedzie w lewo (dx<0), dolna w prawo (dx>0)
  // H1: wy=384-576, Ĺ›rodek=480; H2: wy=1920-2112, Ĺ›rodek=2016; H3: wy=2880-3072, Ĺ›rodek=2976
  const carData=[
    {wy:415,dx:-3.6},{wy:448,dx:-4.2},{wy:492,dx:3.5},{wy:525,dx:4.0},
    {wy:1942,dx:-4.2},{wy:1976,dx:-3.6},{wy:2042,dx:3.5},{wy:2076,dx:4.2},
    {wy:2912,dx:-3.6},{wy:3018,dx:3.5},
  ];
  carData.forEach((d,i)=>{
    const maxX=4200; // H3 idzie peĹ‚nÄ… szerokoĹ›Ä‡ mapy
    // F+ Punkt #11: 2 taksĂłwki ĹĽĂłĹ‚te z czarnym dachem (na H1 i H2)
    const isTaxi=(i===0||i===5);
    const col=isTaxi?'#f1c40f':CAR_COLORS[i%CAR_COLORS.length];
    cityCars.push({wx:rnd(0,maxX),wy:d.wy,dx:d.dx,color:col,anim:0,shape:CAR_SHAPES[i%3],taxi:isTaxi});
  });
  // F+ Punkt #12: 2 autobusy miejskie (wiÄ™ksze, dĹ‚ugie, na H2 i H3)
  cityCars.push({wx:rnd(0,4200), wy:1960, dx:-2.8, color:'#3498db', anim:0, shape:'bus', bus:true, lbl:'12'});
  cityCars.push({wx:rnd(0,4200), wy:2912, dx:-3.0, color:'#e67e22', anim:0, shape:'bus', bus:true, lbl:'5'});
}

// â”€â”€ Ptaki â”€â”€
const cityBirds=[];
(function initBirds(){
  for(let i=0;i<10;i++){
    cityBirds.push({
      wx:rnd(200,4000),
      alt:rnd(68,108), // altitude â€” screen y just below HUD (above road level)
      dx:(Math.random()>.5?1:-1)*(0.8+Math.random()*1.2),
      phase:rnd(0,360),
      flock:Math.floor(i/3),
    });
  }
})();

function drawBirds(){
  if(currentRoom!=='ulica') return;
  const t=Date.now()*0.003;
  X.save();
  for(const b of cityBirds){
    b.wx+=b.dx;
    if(b.wx>4600) b.wx=-200;
    if(b.wx<-200) b.wx=4600;
    const sx=wx2sx(b.wx);
    if(sx<-20||sx>1320) continue;
    const sy=b.alt+Math.sin(t+b.phase*0.1)*3;
    const wingFold=Math.sin(t*3+b.phase)*0.5+0.5; // 0=folded, 1=open
    const spread=8*wingFold+2;
    X.strokeStyle='rgba(30,30,40,0.6)';X.lineWidth=1.5;
    X.beginPath();
    X.moveTo(sx-spread,sy-spread*0.4);
    X.quadraticCurveTo(sx,sy-spread*0.2*wingFold,sx+spread,sy-spread*0.4);
    X.stroke();
  }
  X.restore();
}

const K = {};
/* v2.1.146: TOUCH/MOBILE SUPPORT â€” virtual joystick + action button + phone button.
   Detection: 'ontouchstart' in window OR navigator.maxTouchPoints>0. Toggle body.touch-device class.
   CSS @media (min-width:900px) ukrywa na desktopach (chyba ĹĽe body.touch-force).
   Mapuje pozycjÄ™ thumb na K['ArrowUp/Down/Left/Right'] ĹĽeby reuĹĽyÄ‡ istniejÄ…cy movement code (L8633+).
   Action button â†’ tryInteract() (jak 'E' keypress). Phone button â†’ togglePhone() (jak 'P' keypress). */
(function _initTouchControls(){
  const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints>0);
  if(!isTouchDevice) return;
  /* Build DOM â€” append to document.body (NIE #wrap! memory rule: position:fixed + transform:scale = bug w #wrap) */
  const jx=document.createElement('div');
  jx.id='touch-joystick'; jx.className='touch-control';
  const thumb=document.createElement('div');
  thumb.id='touch-joystick-thumb';
  jx.appendChild(thumb);
  const act=document.createElement('div');
  act.id='touch-action'; act.className='touch-control';
  act.textContent='E';
  act.title='Interakcja (E)';
  const ph=document.createElement('div');
  ph.id='touch-phone'; ph.className='touch-control';
  ph.textContent='đź“±';
  ph.title='Telefon (P)';
  document.body.appendChild(jx);
  document.body.appendChild(act);
  document.body.appendChild(ph);
  document.body.classList.add('touch-device');
  /* Joystick state */
  let activeTouchId=null;
  let centerX=0, centerY=0;
  const RADIUS=50; /* max thumb offset */
  const DEAD_ZONE=12; /* poniĹĽej tego nie ruszamy */
  /* Mapowanie pozycji thumb (dx,dy) na K[] virtual keys */
  function updateKeys(dx,dy){
    const dist=Math.hypot(dx,dy);
    if(dist<DEAD_ZONE){
      K['ArrowUp']=K['ArrowDown']=K['ArrowLeft']=K['ArrowRight']=false;
      return;
    }
    const angle=Math.atan2(dy,dx); /* -PI..PI */
    /* 8-way movement: 8 sektorĂłw po 45Â° */
    const deg=(angle*180/Math.PI+360)%360;
    K['ArrowUp']=(deg>=202.5 && deg<337.5);
    K['ArrowDown']=(deg>=22.5 && deg<157.5);
    K['ArrowLeft']=(deg>=112.5 && deg<247.5);
    K['ArrowRight']=(deg>=292.5 || deg<67.5);
  }
  function resetThumb(){
    thumb.style.transform='translate(0,0)';
    K['ArrowUp']=K['ArrowDown']=K['ArrowLeft']=K['ArrowRight']=false;
  }
  /* Touch handlers â€” joystick */
  jx.addEventListener('touchstart',e=>{
    if(activeTouchId!==null) return;
    const t=e.changedTouches[0];
    activeTouchId=t.identifier;
    const rect=jx.getBoundingClientRect();
    centerX=rect.left+rect.width/2; centerY=rect.top+rect.height/2;
    e.preventDefault();
  },{passive:false});
  jx.addEventListener('touchmove',e=>{
    for(const t of e.changedTouches){
      if(t.identifier!==activeTouchId) continue;
      let dx=t.clientX-centerX, dy=t.clientY-centerY;
      const dist=Math.hypot(dx,dy);
      if(dist>RADIUS){ dx=dx/dist*RADIUS; dy=dy/dist*RADIUS; }
      thumb.style.transform=`translate(${dx}px,${dy}px)`;
      updateKeys(dx,dy);
      e.preventDefault();
    }
  },{passive:false});
  const endHandler=e=>{
    for(const t of e.changedTouches){
      if(t.identifier!==activeTouchId) continue;
      activeTouchId=null;
      resetThumb();
    }
  };
  jx.addEventListener('touchend',endHandler);
  jx.addEventListener('touchcancel',endHandler);
  /* Action button â€” tryInteract() */
  act.addEventListener('touchstart',e=>{
    e.preventDefault();
    if(typeof tryInteract==='function') tryInteract();
  },{passive:false});
  /* Phone button â€” togglePhone() */
  ph.addEventListener('touchstart',e=>{
    e.preventDefault();
    if(typeof togglePhone==='function') togglePhone();
  },{passive:false});
})();
let _adminSeq='',_adminTargets=['snowy','amper'];
document.addEventListener('keydown', e => {
  // JeĹ›li gracz pisze w polu tekstowym (np. nick) â€” ignoruj globalne skrĂłty (M/P/S/E, secret admin, ruch)
  // Escape zostawiamy aktywne â€” pozwala wyjĹ›Ä‡ z menu
  const _ae=document.activeElement;
  const _typing=!!(_ae && (_ae.tagName==='INPUT'||_ae.tagName==='TEXTAREA'||_ae.isContentEditable));
  if(_typing && e.key!=='Escape') return;
  K[e.key] = true;
  /* v1.9.90: anti-spam E â€” ignore auto-repeat + 250ms debounce. User: "4 razy pod rzÄ…d wyskoczyĹ‚y mi interakcje" */
  if(e.key==='e'||e.key==='E'){
    if(e.repeat) return;
    const _now=Date.now();
    if(window._lastInteractE && _now-window._lastInteractE<250) return;
    window._lastInteractE=_now;
    tryInteract();
  }
  if(e.key==='Escape'){
    if(sleepInterval){wakeUp();return;}
    if(_restTimer){stopRest();return;}
    if(_paused){togglePause();return;}
    const wasMapOpen=!!document.getElementById('fullmap-overlay');
    const wasHelpOpen=!!document.getElementById('help-panel');
    const wasOpen=overlayOpen()||phoneOpen()||mgOpen()||npcDlgOpen()||wasMapOpen||wasHelpOpen||document.getElementById('char-panel')?.style.display==='flex'||document.getElementById('admin-panel')?.style.display==='block';
    closeOverlay(); closePhone(); closeMG(); closeNPCDlg(); const cp=document.getElementById('char-panel');if(cp)cp.style.display='none';
    const ap=document.getElementById('admin-panel');if(ap)ap.style.display='none';
    document.getElementById('fullmap-overlay')?.remove();
    document.getElementById('help-panel')?.remove();
    // v1.9.15: ESC zamyka teĹĽ dynamiczne modale (poprzednio tylko mysz mogĹ‚a je zamknÄ…Ä‡)
    const _dynModals=['friend-profile-modal','prestige-info-modal','lb-player-card','storyline-details','tutorial-popup','order-picker'];
    let _anyDyn=false;
    for(const id of _dynModals){const el=document.getElementById(id);if(el){el.remove();_anyDyn=true;}}
    if(_anyDyn) return;
    // JeĹ›li nic nie byĹ‚o otwarte (w tym mapy) i jesteĹ›my w grze â€” pauza
    if(!wasOpen && document.getElementById('menu').style.display==='none'){
      togglePause();
    }
  }
  // Czy gra przyjmuje globalne skrĂłty? (nie podczas minigier/snu/odpoczynku/dialogĂłw)
  const _busyMG = (typeof mgOpen==='function'&&mgOpen()) || (typeof sleepInterval!=='undefined'&&sleepInterval) || (typeof _restTimer!=='undefined'&&_restTimer) || (typeof npcDlgOpen==='function'&&npcDlgOpen());
  if(e.key==='p'||e.key==='P'){
    if(!_busyMG) togglePhone();
  }
  // #17: V â€” wsiÄ…dĹş/wysiÄ…dĹş z auta (wymaga ulicy + posiadania auta)
  // v1.8.41: gdy auto jest na parkingu (G._carParkedAt set), V dziaĹ‚a TYLKO przy parkingu â€”
  // gracz musi wrĂłciÄ‡ na parking, ĹĽeby odebraÄ‡ auto (koniec teleportowania V z dowolnego miejsca).
  if(e.key==='v'||e.key==='V'){
    if(!_busyMG && G.car && currentRoom==='ulica'){
      if(G._carParkedAt && !G._inCar){
        /* v2.1.60 Amper: sprawdĹş czy gracz blisko ZAPISANEJ POZYCJI AUTA, nie parkingu.
           v2.1.65 Amper: gdy auto stoi w obszarze parkingu, pokazuj DEDYKOWANY komunikat "Auto na parkingu" zamiast bezpĹ‚ciowego "X px stÄ…d". */
        const px=P.wx+P.w/2, py=P.wy+P.h/2;
        const carX=G._carParkedAt.wx+P.w/2, carY=G._carParkedAt.wy+P.h/2;
        const dist=Math.hypot(px-carX, py-carY);
        if(dist>=80){
          /* Czy auto stoi w prostokÄ…cie parkingu? */
          const parkObj=ROOMS.ulica.objects.find(o=>o.id==='parking');
          const carOnParking=parkObj && G._carParkedAt.wx>=parkObj.wx-10 && G._carParkedAt.wx<=parkObj.wx+parkObj.w+10 && G._carParkedAt.wy>=parkObj.wy-10 && G._carParkedAt.wy<=parkObj.wy+parkObj.h+10;
          if(carOnParking){
            if(typeof showMsg==='function') showMsg('đź…żď¸Ź Twoje auto jest zaparkowane na parkingu miejskim â€” idĹş tam, ĹĽeby je odebraÄ‡ (zobacz ĹĽĂłĹ‚ty marker đźš— na mapie).','r',5000);
          } else {
            if(typeof showMsg==='function') showMsg(`đźš— Twoje auto stoi ${Math.round(dist)} px stÄ…d â€” wrĂłÄ‡ do niego (zobacz ĹĽĂłĹ‚ty marker đźš— na mapie).`,'r');
          }
          return;
        }
        // Gracz przy aucie â€” wsiada
        G._carParkedAt=null;
        G._inCar=true;
        if(typeof notify==='function') notify(`đźš— WsiadĹ‚eĹ› do ${G.car.name} (V = wysiÄ…dĹş)`);
      } else {
        // v1.9.17: BUG FIX â€” wysiadanie z auta poza parkingiem ustawia _carParkedAt na obecnej pozycji (anti-teleport exploit: walk daleko, V = teleport do auta)
        if(G._inCar){
          G._inCar=false;
          G._carParkedAt={wx:P.wx,wy:P.wy};
          if(typeof notify==='function') notify(`đźš¶ WysiadĹ‚eĹ› z ${G.car.name}. Auto zaparkowane tutaj â€” wrĂłÄ‡ aby je odebraÄ‡.`);
        } else {
          G._inCar=true;
          if(typeof notify==='function') notify(`đźš— WsiadĹ‚eĹ› do ${G.car.name} (V = wysiÄ…dĹş)`);
        }
      }
    } else if(!G.car && !_busyMG){
      if(typeof showMsg==='function') showMsg('đźš— Nie masz auta. Kup w Salonie Samochodowym.','r');
    } else if(currentRoom!=='ulica' && G.car && !_busyMG){
      if(typeof showMsg==='function') showMsg('đźš— Auto moĹĽna uĹĽywaÄ‡ tylko na ulicy.','r');
    }
  }
  if(e.key==='m'||e.key==='M'){
    if(!_busyMG){
      if(document.getElementById('fullmap-overlay')) document.getElementById('fullmap-overlay').remove();
      else openFullMap();
    }
  }
  // v1.8.86: Ctrl+S = rÄ™czny zapis (zgĹ‚oszenie Ampera). Browser intercept zablokowany przez preventDefault.
  if(e.ctrlKey && (e.key==='s'||e.key==='S')){
    e.preventDefault();
    if(!_busyMG && document.getElementById('menu')?.style.display==='none'){
      try{ saveGameSilent(); if(typeof showMsg==='function') showMsg('đź’ľ Gra zapisana','g'); }catch(_){}
    }
    return;
  }
  if(e.key==='F1'||e.key==='?'||(e.key==='/'&&e.shiftKey)){
    e.preventDefault();
    if(document.getElementById('help-panel')) closeHelpPanel();
    else openHelpPanel();
  }
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key)) e.preventDefault();
  // Secret admin shortcut: wpisz "snowy" lub "amper" â€” tylko gdy gra nie jest zajÄ™ta
  /* v1.9.58: guard !_typing ĹĽeby admin sekwencja nie budowaĹ‚a siÄ™ gdy gracz pisze w input/textarea (audyt keyboard shortcuts) */
  if(!_busyMG && !_typing && e.key.length===1&&!e.ctrlKey&&!e.altKey){
    const maxLen=Math.max(..._adminTargets.map(t=>t.length));
    _adminSeq=(_adminSeq+e.key.toLowerCase()).slice(-maxLen);
    if(_adminTargets.some(t=>_adminSeq.endsWith(t))) openAdminPanel();
  }
});
/* v1.9.22: BUG FIX shift-stuck-key â€” usuwamy obie wersje case (Shift+W stores K['W']=true, releaseShift+W generuje keyup 'w' â†’ K['W'] zostawaĹ‚o true forever, postaÄ‡ szĹ‚a sama) */
document.addEventListener('keyup', e => {
  delete K[e.key];
  if(e.key && e.key.length===1){
    delete K[e.key.toLowerCase()];
    delete K[e.key.toUpperCase()];
  }
});
// Anti-stuck-key: gdy okno traci focus (alt-tab, switch tab, modal browser),
// keyup moĹĽe nie odpaliÄ‡ â€” gracz idzie sam non-stop. CzyĹ›cimy wszystkie klawisze.
window.addEventListener('blur', () => { for(const k in K) delete K[k]; });
// Visibility API â€” gdy karta przechodzi w tĹ‚o
document.addEventListener('visibilitychange', () => {
  if(document.hidden) for(const k in K) delete K[k];
});

function sr(s){const x=Math.sin(s*9301+49297)*233280;return x-Math.floor(x);}
function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
function rnd(a,b){return Math.floor(Math.random()*(b-a+1))+a;}

// â•â•â• Skill effect helpers (F3-FIX FAZA B: hierarchia skill < power-up < evolution) â•â•â•
// Wzor uniwersalny:
//   bonus = lvl*BASE + pu*PU_STEP + evo*EVO_BONUS
//   gdzie PU_STEP > BASE i EVO_BONUS > PU_STEP*3 (evolution = NAJWIEKSZA)
// Power-ups daja BAZOWE +30/+60/+90% (PU_STEP=0.30 Ă— count, max count=3) (PU_STEP = 0.30 czyli pu*0.30)
// Evolution = +50-100% extra (unikatowy bonus)

// Helper bezpieczny do skill access (chroni przed undefined w early game)
function _sk(key){ return (typeof getSkillLvl==='function')?getSkillLvl(key):0; }
function _pu(key){ return (typeof getSkillPowerUps==='function')?getSkillPowerUps(key):0; }
function _evo(key){ return (typeof hasSkillEvolution==='function' && hasSkillEvolution(key))?1:0; }

// Negocjacje â€” discount w sklepach (skill -5%/pkt = max -15%, +PU -10/-20/-30, +Evo Master Trader -50%)
// v1.8.95: evo bonus 0.20 â†’ 0.50 (zgodnie z opisem evolution "Wszystkie sklepy majÄ… -50% cen")
function getShopDiscount(){
  const lvl=_sk('negocjacje'), pu=_pu('negocjacje'), evo=_evo('negocjacje');
  /* v1.9.45: pre-clamp ĹĽeby BF stack nie startowaĹ‚ z ujemnego multiplikatora (audyt shop logic) */
  let d = Math.max(0.20, 1 - lvl*0.05 - pu*0.10 - evo*0.50);
  // v1.8.97: Black Friday â€” wszystkie sklepy -20% (holidayBonus('shop') = 0.8)
  if(typeof holidayBonus==='function'){
    const hb=holidayBonus('shop');
    if(hb<1) d *= hb;
  }
  return Math.max(0.20, d); // cap rozszerzony do 80% discount aby BF stackowaĹ‚ siÄ™ z evo
}
function applyShopDiscount(price){ return Math.floor(price * getShopDiscount()); }
// F3-FIX-D: DRIP_MASTER evo "Trendsetter" â€” wszystkie ubrania -20% extra (kumulacja z negocjacjami)
// v1.8.95: _repBoost50 (-5%) i _repBoost75 (-10%) realnie aplikowane przy outfitach (wczeĹ›niej fake)
function applyOutfitDiscount(price){
  let d = getShopDiscount();
  if(_evo('drip_master')) d *= 0.80; // -20% extra dla outfit (Trendsetter)
  if(G._repBoost75) d *= 0.90; // -10% Drip District przy rep 75 (priorytet nad 50)
  else if(G._repBoost50) d *= 0.95; // -5% Drip District przy rep 50
  // v1.8.97: PrzyjaĹşĹ„ z Wiktorem â€” zniĹĽka w sklepie ubraĹ„ (1/1.05/1.15/1.3/1.5 -> 0/5/13/23/33% off)
  if(typeof getFriendshipBonus==='function'){
    const wfb=getFriendshipBonus('wiktor');
    if(wfb>1) d *= (1/wfb);
  }
  return Math.floor(price * d);
}

// Bieg (UKRYTE) â€” bonus prÄ™dkoĹ›ci gracza
/* v2.1.196: funkcja Ĺşle nazwana â€” NIE wpĹ‚ywa na prÄ™dkoĹ›Ä‡ gracza (P.spd uses additive formula in updateHUD L30142+).
   Tylko treadmill XP gain multiplier (L25445). WartoĹ›ci tu sÄ… niezaleĹĽne od UI SKILL_DEF Bieg labels.
   ZachowujÄ™ starÄ… nazwÄ™ dla backward compat. */
function getBiegSpeedBonus(){
  return 1 + _sk('bieg')*0.05 + _pu('bieg')*0.10 + _evo('bieg')*0.20;
}
/* v2.1.196: alias z jasnÄ… nazwÄ… dla treadmill */
function getBiegTreadmillXpMult(){ return getBiegSpeedBonus(); }

// v2.1.196: komentarz update â€” PU faktycznie daje +30/60/90% (cumulative, NIE 100%). Evo +50%, skill +5%/pkt max 25%.
// Drip Master â€” bonus sĹ‚awy z outfitĂłw
function getDripFameBonus(){
  return 1 + _sk('drip_master')*0.05 + _pu('drip_master')*0.30 + _evo('drip_master')*0.50;
}
// v1.8.98: Autopromocja 4 "Personal brand" â€” Drip dziaĹ‚a Ă—1.5 dla wszystkich akcji
function getEffectiveDrip(){
  const base=G.drip||0;
  const mult=(typeof getRaperST==='function' && getRaperST('autopromocja')>=4)?1.5:1;
  return base*mult;
}

// Dieta â€” bonus energii z gotowania (max skill +15%, PU +15/30/50%, Evo: +25%)
function getDietaEnergyBonus(){
  return 1 + _sk('dieta')*0.05 + _pu('dieta')*0.15 + _evo('dieta')*0.25;
}

// Medytacja â€” bonus regen energii podczas snu (skill +15%, PU +15/30/50%)
// F3-FIX-D: Wewnetrzny spokoj evo daje 2x energy (+100%)
function getMedytacjaStressBonus(){
