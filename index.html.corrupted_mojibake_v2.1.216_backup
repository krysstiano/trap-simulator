        if(G.money<_enerPrice){showMsg('Za maĹ‚o pieniÄ™dzy!','r');return;}
        G.money-=_enerPrice;G.energy=clampStat('energy', G.energy+20);G.health=clampStat('health', G.health-1);
        G._kebabBought=(G._kebabBought||0)+1; // v1.8.47: kaĹĽdy zakup u Zbyszka liczy siÄ™ do side questu
        if(typeof addFriendship==='function')addFriendship('zbyszek',1);
        notify('âšˇ Tani energetyk! +20 energia, -1 HP'+(_zFM>1?' ('+_enerPrice+' zĹ‚ â€” zniĹĽka przyjaĹşni)':''));updateHUD();openNPCDialogue('vendor');
      }},
      // v1.8.18: zakup budki jako biznesu pasywnego â€” +180 zĹ‚/dzieĹ„ (auto co rano)
      {text:()=>G.kebabStand?.owned?`âś… Budka twoja (+${G.kebabStand.dailyIncome||300} zĹ‚/dzieĹ„)`:'đź’Ľ Kup budkÄ™ kebab (8 000 zĹ‚ â€” +300 zĹ‚/dzieĹ„)', fn:()=>{
        if(G.kebabStand?.owned){showMsg('JuĹĽ posiadasz budkÄ™! DochĂłd przychodzi codziennie rano.','g');return;}
        if(G.money<8000){showMsg('Za maĹ‚o pieniÄ™dzy! Potrzeba 8000 zĹ‚','r');return;}
        if(!confirm('KupiÄ‡ budkÄ™ kebab od Zbyszka za 8000 zĹ‚?\nDochĂłd: 300 zĹ‚/dzieĹ„ (przelew rano). ROI: ~27 dni.')) return;
        G.money-=8000;
        G.kebabStand={owned:true,dailyIncome:300,boughtDay:G.day};
        addNotif('đź’Ľ Budka kebab Twoja! Pasywny dochĂłd 300 zĹ‚/dzieĹ„.');
        addXP(50);
        closeNPCDlg();
        // v1.8.31: cinematic przy zakupie pierwszego biznesu (analogicznie do studio cinematic v1.8.18)
        if(typeof showMilestoneCinematic==='function'){
          showMilestoneCinematic({
            emoji:'đźŚ®',
            title:'TWĂ“J PIERWSZY BIZNES',
            subtitle:'Budka kebab Royal',
            tagline:'Zbyszek pracuje Â· Ty bierzesz zysk Â· +300 zĹ‚ / dzieĹ„',
            accentColor:'#f39c12',
            accent2:'#e67e22',
            duration:4500,
            onDone:()=>{
              if(typeof confetti==='function')confetti(35);
              if(typeof sfxCash==='function')sfxCash();
            }
          });
        } else {
          showMsg('đźŚ® Zbyszek zostaje jako menadĹĽer â€” bÄ™dzie sprzedawaĹ‚, a Ty bierzesz zysk!','g',6000);
        }
      }},
      // v1.8.45: dialog side quest dla Zbyszka (z_buy20kebab â€” 10 kebabĂłw, 1000 zĹ‚)
      {text:()=>{const q=SIDE_QUESTS.zbyszek[0];const p=(G._kebabBought||0);const done=G.mainQuest?.completed?.includes(q.id);return done?'âś“ '+q.name:`đź“‹ Side: ${q.name} (${p}/${q.target})`;},
        cond:()=>true,
        fn:()=>{
          const q=SIDE_QUESTS.zbyszek[0];
          if(G.mainQuest?.completed?.includes(q.id)){notify('âś“ JuĹĽ odebrane');closeNPCDlg();return;}
          const p=(G._kebabBought||0);
          if(p>=q.target){
            G.mainQuest=G.mainQuest||{currentStep:0,completed:[]};
            G.mainQuest.completed.push(q.id);
            if(q.reward.money) earn(q.reward.money,false);
            if(q.reward.stress) G.stress=clamp(G.stress+q.reward.stress,0,100);
            G._sideQuestsCompleted=(G._sideQuestsCompleted||0)+1;
            showMsg(`đź“‹ ${q.name} â€” wykonane! Zbyszek dorzuciĹ‚ Ci +${q.reward.money} zĹ‚ od staĹ‚ego klienta.`);
          } else {
            notify(`đź“‹ ${q.desc}: ${p}/${q.target}`);
          }
          closeNPCDlg();
        }
      },
      {text:'WyjdĹş', fn:closeNPCDlg},
    ]
  },
