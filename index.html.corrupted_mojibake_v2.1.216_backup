    {cost:5,label:'Arena shows',desc:'+500 fanĂłw za kaĹĽdy event, ikoniczny status',effect:'scena_arena'},
  ]},
  // Kondycja przeniesiona do gĹ‚Ăłwnego drzewka umiejÄ™tnoĹ›ci (G.skills.kondycja, SKILL_DEF) â€” to stat fizyczny, nie raperski.
};

function canUnlockRSTBranch(branch){
  const def=RAPER_ST_DEF[branch];
  if(def.minFans){if((G.fans||0)<def.minFans)return false;}
  if(def.needsItem&&!G[def.needsItem]) return false;
  if(!def.requires) return true;
  for(const [req,minLvl] of Object.entries(def.requires)){
    if(getRaperST(req)<minLvl) return false;
  }
  return true;
}

function renderPhoneRaper(){
  const r=G.careers.raper||{level:0,freestyles:0,tracks:0,xp:0,skillPts:0};
  const raperLvl=getRaperLevel();
  /* v2.1.88 Amper: BUG FIX â€” gdy gracz osiÄ…gnÄ…Ĺ‚ MAX (Legend lvl 5), nextLvl wracaĹ‚ ten sam poziom przez Math.min, wiÄ™c UI pokazywaĹ‚o "2843/1800 XP" sugerujÄ…c ĹĽe moĹĽna jeszcze rosnÄ…Ä‡. Teraz: gdy max, nextLvl=null i UI pokazuje "MAX". */
  const _maxRaperLvl=RAPER_LEVELS[RAPER_LEVELS.length-1].level;
  const _isMaxRaper=raperLvl.level>=_maxRaperLvl;
  const nextLvl=_isMaxRaper?null:RAPER_LEVELS[raperLvl.level+1];
  const xpPct=_isMaxRaper?100:(nextLvl?Math.min(100,(r.xp/nextLvl.xpReq)*100):100);
  const sp=r.skillPts||0;
  document.getElementById('ph-title').textContent='đźŽ¤ Kariera Rapera';
  /* v2.1.147: 22 levels â€” unlock messages tylko dla main tier transitions (1=Underground, 5=Rising, 9=Known, 13=Famous, 17=Legend, 22=GOAT). Sub-levels w obrÄ™bie tier nie majÄ… unique unlock, tylko +2 pkt umiejÄ™tnoĹ›ci. */
  const LVL_UNLOCKS={
    1:'Underground â€” odblokowane streamingi, wiÄ™cej XP z freestylĂłw',
    5:'Rising â€” streaming zarabia wiÄ™cej, kontrakty z labelem',
    9:'Known â€” festiwale odblokowane, label deals',
    13:'Famous â€” trasy koncertowe, zarzÄ…dzanie ekipÄ…',
    17:'Legend â€” Arena shows, status legendy',
    22:'GOAT â€” niezrĂłwnany status, max mnoĹĽniki',
  };
  const nextUnlk=nextLvl?(LVL_UNLOCKS[nextLvl.level]||'+2 pkt umiejÄ™tnoĹ›ci'):'';

  // â”€â”€ Node graph layout â”€â”€
  // Left col (x=0): independent nodes. Right col (x=168): dependent nodes.
  const _GP={
    flow:        {x:0,  y:0},   teksty:  {x:168,y:0},
    produkcja:   {x:0,  y:70},  scena:   {x:168,y:70},
    realizacja:  {x:0,  y:140}, mikser:  {x:168,y:140},
    autopromocja:{x:0,  y:210}, biznes:  {x:168,y:210},
    // Kondycja przeniesiona do gĹ‚Ăłwnego drzewka umiejÄ™tnoĹ›ci (Avatar HUD â†’ Drzewko)
  };
  const NW=122,NH=52;
  // Bezier edges between dependent pairs
  const _EDGES=[
    {f:'flow',t:'teksty',c:'#c8a52088'},
    {f:'flow',t:'scena', c:'#e91e8c77'},
    {f:'realizacja',t:'mikser',c:'#00bcd466'},
    {f:'autopromocja',t:'biznes',c:'#4caf5066'},
  ];
  let _sel=null;

  function _buildGraph(sel){
    const st=G.raperST||{};
    let svg='';
    for(const {f,t,c} of _EDGES){
      const fp=_GP[f],tp=_GP[t];
      const x1=fp.x+NW,y1=fp.y+NH/2,x2=tp.x,y2=tp.y+NH/2,mx=(x1+x2)/2;
      svg+=`<path d="M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}" fill="none" stroke="${c}" stroke-width="1.5" stroke-dasharray="5,3"/>`;
    }
    let nodes='';
    for(const [branch,pos] of Object.entries(_GP)){
      const def=RAPER_ST_DEF[branch];
      const lvl=st[branch]||0;
      const ok=canUnlockRSTBranch(branch);
      const active=sel===branch;
      const dots=Array.from({length:5},(_,i)=>`<div style="width:12px;height:4px;border-radius:1px;background:${i<lvl?'#c8a520':'#1a2a3a'}"></div>`).join('');
      nodes+=`<div onclick="window._rstSel('${branch}')" style="position:absolute;left:${pos.x}px;top:${pos.y}px;width:${NW}px;height:${NH}px;
        background:${active?'#181e00':lvl>0?'#0b140a':'#060e18'};
        border:1.5px solid ${active?'#c8a520':lvl>0?'#4a7020':ok?'#1e3855':'#151525'};
        border-radius:8px;cursor:pointer;display:flex;flex-direction:column;
        align-items:center;justify-content:center;gap:2px;
        box-shadow:${active?'0 0 10px #c8a52055':'none'}">
        <div style="font-size:13px;line-height:1">${def.emoji}${ok?'':' <span style="font-size:9px;opacity:.7">đź”’</span>'}</div>
        <div style="font-size:10px;color:${ok?'#9dd':'#3a4555'};font-weight:700;text-align:center;line-height:1.2">${def.label}</div>
        <div style="display:flex;gap:2px;margin-top:2px">${dots}</div>
      </div>`;
    }
    return `<div style="position:relative;width:293px;height:338px;margin:0 auto 6px">
      <svg style="position:absolute;top:0;left:0;width:293px;height:338px;pointer-events:none;overflow:visible">${svg}</svg>
      ${nodes}
    </div>`;
  }

  function _buildDetails(sel){
    if(!sel) return `<div style="text-align:center;color:#2a3a44;font-size:11px;padding:10px 0">â† Kliknij wÄ™zeĹ‚ aby zobaczyÄ‡ szczegĂłĹ‚y</div>`;
    const def=RAPER_ST_DEF[sel];
    const st=G.raperST||{};
    const lvl=st[sel]||0;
    const ok=canUnlockRSTBranch(sel);
    const sp2=G.careers.raper?.skillPts||0;
    const canBuy=ok&&sp2>0&&lvl<5;
    const reqParts=[];
    if(def.requires) Object.entries(def.requires).forEach(([k,v])=>reqParts.push(`${RAPER_ST_DEF[k].label} ${v}+`));
    if(def.minFans) reqParts.push(`${def.minFans} fanĂłw`);
    if(def.needsItem) reqParts.push(def.needsItemLabel||def.needsItem);
    const nextN=lvl<5?def.nodes[lvl]:null;
    return `<div style="background:#060e18;border:1px solid ${lvl>0?'#c8a520':'#1a2a3a'};border-radius:8px;padding:10px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px">
        <span style="font-size:20px">${def.emoji}</span>
        <div>
          <div style="font-size:13px;font-weight:700;color:#7ec8e3">${def.label}</div>
          <div style="font-size:11px;color:#c8a520">Poziom ${lvl}/5${lvl>=5?' âś“':''}</div>
        </div>
      </div>
      ${!ok&&reqParts.length?`<div style="font-size:11px;color:#c0392b;margin-bottom:5px">đź”’ Wymaga: ${reqParts.join(', ')}</div>`:''}
      ${nextN?`<div style="font-size:11px;color:#667;margin-bottom:5px"><span style="color:#8bd">â†’ ${nextN.label}:</span> ${nextN.desc}</div>`:`<div style="font-size:11px;color:#4a7020;margin-bottom:5px">â… Maksymalny poziom!</div>`}
      <button style="background:${canBuy?'#1a1200':'#0a0a14'};border:1px solid ${canBuy?'#c8a520':'#1a2a3a'};color:${canBuy?'#c8a520':'#334'};padding:5px 14px;border-radius:5px;cursor:${canBuy?'pointer':'not-allowed'};font-size:12px"
        onclick="window.buyRaperST('${sel}')">${lvl>=5?'MAX':canBuy?'Ulepsz (1 pkt)':'Brak pkt / đź”’'}</button>
    </div>`;
  }

  document.getElementById('ph-content').innerHTML=`<div class="ph-screen" style="padding:10px">
    <div style="background:#0a1220;border:1px solid #1a3a5a;border-radius:10px;padding:12px;margin-bottom:10px">
      <div style="font-size:16px;color:#e91e8c;font-weight:700">đźŽ¤ ${raperLvl.name}</div>
      <div style="font-size:12px;color:#667;margin-bottom:6px">${r.freestyles} freestylĂłw Â· ${r.tracks} trackĂłw${r.freestyleHighScore?` Â· <span style="color:#f1c40f">đźŹ† Rekord: ${r.freestyleHighScore} pkt</span>`:''}</div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
        <div style="flex:1;background:#0a0a1a;border-radius:4px;height:8px;overflow:hidden">
          <div style="width:${xpPct}%;height:100%;background:linear-gradient(90deg,#e91e8c,#9b59b6)"></div>
        </div>
        <span style="font-size:11px;color:#667">${_isMaxRaper?'MAX (Legend)':r.xp+'/'+nextLvl.xpReq+' XP'}</span>
      </div>
      <div style="font-size:12px;color:#c8a520">đź’Ž Pkt umiejÄ™tnoĹ›ci: <strong>${sp}</strong></div>
      ${nextLvl&&nextLvl.level>raperLvl.level?`<div style="font-size:11px;color:#445;margin-top:4px">NastÄ™pny poziom (${nextLvl.name}): ${nextUnlk}</div>`:''}
    </div>
    ${(()=>{
      /* v2.1.48 Amper: sekcja "Wydaj album" w panelu rapera â€” storyline pkt 17 wymaga wydania albumu, ale wczeĹ›niej nie byĹ‚o tu UI. */
      const _albTracks=G.careers.raper?.tracks||0;
      const _albUsed=G.careers.raper?.tracksInAlbums||0;
      const _albAvail=_albTracks-_albUsed;
      const _albMic=G.mic?.quality||0;
      const _albMicOk=_albMic>=50;
      const _albMoneyOk=(G.money||0)>=2000;
      const _albTrackOk=_albAvail>=5;
      const _albCanRelease=_albTrackOk&&_albMicOk&&_albMoneyOk;
      const _albCount=G.albumsReleased||0;
      return `<div style="background:linear-gradient(135deg,#1a1a3a,#0a0a14);border:1px solid #9b59b6;border-radius:8px;padding:10px 14px;margin-bottom:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
          <div style="color:#c8a520;font-weight:800;font-size:13px">đź’ż Wydaj Album</div>
          <div style="color:#aac;font-size:11px">Wydane: <b style="color:#fff">${_albCount}</b></div>
        </div>
        <div style="font-size:11px;color:#bbc;line-height:1.5;margin-bottom:8px">Skompiluj <b style="color:#fff">5 swoich trackĂłw</b> w album. Wielkie wydawnictwo daje ogromny boost streamĂłw (Spotify+Tidal), fanĂłw, fame +20 i wypĹ‚atÄ™. Tracki zostajÄ… w katalogu, ale kaĹĽdy album zuĹĽywa 5 nowych z puli.</div>
        <div style="display:flex;flex-direction:column;gap:3px;margin-bottom:8px;font-size:11px;font-weight:600">
          <span style="color:${_albTrackOk?'#27ae60':'#c0392b'}">${_albTrackOk?'âś“':'âś—'} DostÄ™pne tracki: ${_albAvail}/5 <span style="color:#778;font-weight:400">(masz ${_albTracks}, uĹĽyte w albumach: ${_albUsed})</span></span>
          <span style="color:${_albMicOk?'#27ae60':'#c0392b'}">${_albMicOk?'âś“':'âś—'} Mikrofon: jakoĹ›Ä‡ ${_albMic}%/50%</span>
          <span style="color:${_albMoneyOk?'#27ae60':'#c0392b'}">${_albMoneyOk?'âś“':'âś—'} Koszt produkcji: ${(G.money||0).toLocaleString('pl')}/2 000 zĹ‚</span>
        </div>
        <button onclick="releaseRaperAlbum()" ${_albCanRelease?'':'disabled'} style="width:100%;background:${_albCanRelease?'linear-gradient(135deg,#c8a520,#9b59b6)':'#1a1a25'};border:1px solid ${_albCanRelease?'#c8a520':'#2a3a4a'};color:${_albCanRelease?'#000':'#445'};padding:8px 12px;border-radius:6px;cursor:${_albCanRelease?'pointer':'not-allowed'};font-weight:800;font-size:12px;letter-spacing:1px">đź’ż ${_albCanRelease?'WYDAJ ALBUM!':'Brakuje wymagaĹ„'}</button>
      </div>`;
    })()}
    <div style="background:#1a0a25;border:1px solid #4a1a4a;border-radius:8px;padding:10px 14px;margin-bottom:10px;font-size:12px;color:#ccc;line-height:1.55">
      <div style="color:#e91e8c;font-weight:700;margin-bottom:4px">đźŽ¤ Freestyle na ulicy</div>
      IdĹş do <b style="color:#fff">rĂłĹĽowego kĂłĹ‚ka đźŽ¤</b> w okolicy IKEA/Sali Koncertowej i wciĹ›nij <kbd style="background:#0a0a14;border:1px solid #2a3a50;color:#7ec8e3;padding:1px 6px;border-radius:4px">E</kbd>.
      KaĹĽdy freestyle daje <b style="color:#c8a520">+XP rapera</b> i <b style="color:#7ec87e">+fanĂłw</b>. Bez cooldownu â€” koszt 15 energii (zagrasz dopĂłki nie zabraknie).
    </div>
    <h3 style="color:#f1c40f;font-size:12px;margin-bottom:6px;display:flex;align-items:center;gap:6px">
      đźŚł Drzewko UmiejÄ™tnoĹ›ci
      <span style="font-size:10px;color:#334;font-weight:400">lewo = niezaleĹĽne Â· prawo = wymaga linii</span>
    </h3>
    <div id="rst-graph"></div>
    <div id="rst-details" style="margin-top:6px"></div>
    <button class="cbtn" style="margin-top:10px" onclick="renderPhoneHome()">â† PowrĂłt</button>
  </div>`;

  document.getElementById('rst-graph').innerHTML=_buildGraph(null);
  document.getElementById('rst-details').innerHTML=_buildDetails(null);

  window._rstSel=(branch)=>{
    _sel=(_sel===branch)?null:branch;
    document.getElementById('rst-graph').innerHTML=_buildGraph(_sel);
    document.getElementById('rst-details').innerHTML=_buildDetails(_sel);
    if(_sel) document.getElementById('rst-details').scrollIntoView({behavior:'smooth',block:'nearest'});
  };
  window.buyRaperST=(branch)=>{
    const r2=G.careers.raper;
    if((r2.skillPts||0)<=0){showMsg('Brak punktĂłw umiejÄ™tnoĹ›ci rapera!','r');return;}
    if(!canUnlockRSTBranch(branch)){showMsg('Nie speĹ‚niasz wymagaĹ„!','r');return;}
    const cur=(G.raperST[branch]||0);
    if(cur>=5){return;}
    r2.skillPts--;
    if(!G.raperST) G.raperST={};
    G.raperST[branch]=cur+1;
    const def=RAPER_ST_DEF[branch];
    const node=def.nodes[cur];
    notify(`âś… ${def.emoji} ${def.label} â†’ poziom ${cur+1}: ${node.label}`);
    addNotif(`đźŚł Raper: ${def.label} ${cur+1}`);
    renderPhoneRaper();
  };
  window.triggerFreestyle=()=>{closePhone();startFreestyleMG();};
}

