// v1.8.62: rebalans cen â€” power-up 5/15/40k â†’ 3/9/22k (-43% total). User: 150k+evo+300/d = 500 dni ROI to za drogo.
const _PU = (n1,n2,n3, c1=3000,c2=9000,c3=22000) => [
  {name:n1, cost:c1}, {name:n2, cost:c2}, {name:n3, cost:c3}
];
// v1.8.62: evolution default 150k â†’ 50k (-67%). Pasywne dochody majÄ… jeszcze niĹĽszÄ… cenÄ™ override (ROI ~35-50 dni).
const _EVO = (n, desc, cost=50000, sp=1) => ({name:n, desc, cost, skillPointCost:sp});

