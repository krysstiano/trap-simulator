          ${friendsList.length>0?'<span style="font-size:10px;color:#778">Klik kartÄ™ aby zobaczyÄ‡ profil</span>':''}
        </div>
        <div id="friends-list">${friendsList.length===0?'<div style="text-align:center;color:#778;font-size:12px;padding:20px 10px;line-height:1.5">Nie masz jeszcze znajomych.<br>Wpisz kod TRAP-XXXX-XXXX powyĹĽej ĹĽeby dodaÄ‡.</div>':'<div style="text-align:center;color:#778;padding:14px">âŹł ĹadujÄ™ dane...</div>'}</div>
      </div>
      <!-- Activity feed -->
      <div id="friends-feed" style="display:none"></div>
      <!-- Suggested -->
      <div id="suggested-friends" style="display:none"></div>
      <button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button>
    </div>`;
  // v2.1.0: synchronizuj G.friends z serwerem (handle: drugi gracz mnie zaakceptowaĹ‚ offline)
  await _lbSyncFriendsFromServer();
  /* Re-read friends po sync â€” drugi gracz mĂłgĹ‚ zaakceptowaÄ‡ odkÄ…d ostatnio byliĹ›my online */
  friendsList=G.friends||[];
  /* Update counter "Znajomi (N)" w nagĹ‚Ăłwku jeĹ›li siÄ™ zmieniĹ‚ po sync */
  const _hdrSpan=document.querySelector('#ph-content .ph-screen span[style*="7ec8e3"]');
  if(_hdrSpan) _hdrSpan.textContent=`đź‘Ą Znajomi (${friendsList.length})`;
  // Asynchronicznie: scores, suggested, incoming (pending), outgoing (pending wysĹ‚ane)
  /* v2.1.117: Wave 6 W59 â€” Promise.allSettled zamiast Promise.all (jeden fetch fail nie crashuje caĹ‚ego panelu). */
  const _results=await Promise.allSettled([
    fetchAllFriendsData(),
    fetchSuggestedFriends(),
    fetchIncomingRequests(),
    fetchOutgoingRequests()
  ]);
  const data=_results[0].status==='fulfilled'?_results[0].value:[];
  const suggested=_results[1].status==='fulfilled'?_results[1].value:[];
  const incoming=_results[2].status==='fulfilled'?_results[2].value:[];
  const outgoing=_results[3].status==='fulfilled'?_results[3].value:[];
  const _anyFailed=_results.some(r=>r.status==='rejected');
  if(_anyFailed && typeof showMsg==='function') showMsg('âš ď¸Ź CzÄ™Ĺ›Ä‡ danych znajomych niedostÄ™pna (network). PokazujÄ™ co siÄ™ udaĹ‚o.','w',3000);
  _lbAllFriendsCache=data;
  // Render aggregate
  if(friendsList.length>0){
    const aggEl=document.getElementById('friends-aggregate');
    if(aggEl){
      aggEl.style.display='';
      aggEl.innerHTML=`
        <div style="background:linear-gradient(135deg,rgba(155,89,182,.18),rgba(241,196,15,.12));border:1px solid rgba(241,196,15,.35);border-radius:10px;padding:10px 12px;margin-bottom:10px">
          <div style="font-size:10px;color:#f1c40f;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:6px">đź“Š Twoje Crew (${friendsList.length})</div>
          <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:#aac">
            <span>đź’° <b style="color:#f1c40f">${data.aggregateMoney.toLocaleString('pl')} zĹ‚</b></span>
            <span>đźŽ¤ <b style="color:#e91e8c">${data.aggregateFans.toLocaleString('pl')} fanĂłw</b></span>
          </div>
          ${data.latestActivityFriend?`<div style="font-size:10px;color:#778;margin-top:4px">NajĹ›wieĹĽsza aktywnoĹ›Ä‡: <b style="color:#7ec8e3">${data.latestActivityFriend}</b> Â· ${_timeAgoLB(data.latestActivity)}</div>`:''}
        </div>`;
    }
  }
  // v2.1.0: Render incoming PENDING requests â€” Akceptuj/OdrzuÄ‡
  if(incoming.length>0){
    const ic=document.getElementById('incoming-requests');
    if(ic){
      ic.style.display='';
      ic.innerHTML=`
        <div style="background:rgba(243,156,18,.14);border:2px solid rgba(243,156,18,.5);border-radius:10px;padding:10px 12px;margin-bottom:10px;box-shadow:0 0 16px rgba(243,156,18,.18)">
          <div style="font-size:10px;color:#f39c12;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:6px">đź“Ą Zaproszenia do znajomych (${incoming.length})</div>
          ${incoming.map(r=>{
            const av=_renderMiniAvatar(r.avatar);
            const fl=_renderFlag(r.country||'PL');
            const safeNick=(r.nick||'').replace(/'/g,"\\'");
            return `<div style="display:flex;align-items:center;gap:6px;padding:6px 0;font-size:12px;border-bottom:1px solid rgba(243,156,18,.15)">
              ${av}${fl}
              <span style="flex:1;color:#fff;font-weight:600;word-break:break-word;line-height:1.2">${_escHtml(r.nick||'Nieznany')}</span>
              <button onclick="_lbAcceptFriendRequest('${r.userId}','${safeNick}')" title="Akceptuj zaproszenie" style="background:#1a5a1a;border:1px solid #2ecc71;color:#2ecc71;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700;font-family:inherit">âś“ Akceptuj</button>
              <button onclick="_lbRejectFriendRequest('${r.userId}','${safeNick}')" title="OdrzuÄ‡ zaproszenie" style="background:#3a1a1a;border:1px solid #e74c3c;color:#e74c3c;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700;font-family:inherit">âś— OdrzuÄ‡</button>
            </div>`;
          }).join('')}
        </div>`;
    }
  }
  // v2.1.0: Render OUTGOING pending â€” zaproszenia ktĂłre JA wysĹ‚aĹ‚em, czekajÄ…
  if(outgoing.length>0){
    const og=document.getElementById('outgoing-requests');
    if(og){
      og.style.display='';
      og.innerHTML=`
        <div style="background:rgba(155,89,182,.10);border:1px solid rgba(155,89,182,.35);border-radius:10px;padding:8px 12px;margin-bottom:10px">
          <div style="font-size:10px;color:#9b59b6;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:4px">đź“¤ WysĹ‚ane zaproszenia (${outgoing.length})</div>
          ${outgoing.map(r=>{
            const fl=_renderFlag(r.country||'PL');
            return `<div style="display:flex;align-items:center;gap:6px;padding:3px 0;font-size:11px;color:#aac">
              ${fl}
              <span style="flex:1;word-break:break-word;line-height:1.2">${_escHtml(r.nick||'Nieznany')}</span>
              <span style="color:#778;font-size:10px;font-style:italic">âŹł czeka</span>
            </div>`;
          }).join('')}
        </div>`;
    }
  }
  // Render friend cards
  if(friendsList.length>0){
    const container=document.getElementById('friends-list');
    if(!container) return;
    container.innerHTML=friendsList.map(f=>{
      const sc=data.scoreMap.get(f.userId)||{};
      const theme=_friendThemeColor(f.nick);
      const status=_statusIndicator(sc.updated_at);
      const avatar=_renderMiniAvatar(sc.avatar||null);
      const flag=_renderFlag(sc.country||'PL');
      const money=(sc.money||0).toLocaleString('pl');
      const fans=(sc.fans||0).toLocaleString('pl');
      const daysSinceAdd=Math.max(0,(G.day||0)-(f.addedDay||0));
      return `<div onclick="renderFriendProfile('${f.userId}')" style="background:linear-gradient(135deg,${theme.primary}22,${theme.accent}11);border:1px solid ${theme.primary}55;border-left:4px solid ${theme.primary};border-radius:8px;padding:8px 10px;margin-bottom:6px;cursor:pointer;transition:transform .15s,box-shadow .15s" onmouseover="this.style.transform='translateX(2px)';this.style.boxShadow='0 4px 12px ${theme.primary}33'" onmouseout="this.style.transform='';this.style.boxShadow=''">
        <div style="display:flex;align-items:center;gap:8px">
          ${avatar}${flag}
          <div style="flex:1;min-width:0">
            <div style="display:flex;align-items:center;gap:6px">
              <span style="color:#fff;font-weight:700;font-size:13px;word-break:break-word;line-height:1.2">${_escHtml(f.nick)}</span>
              <span style="font-size:9px;color:${status.color};font-weight:600">${status.dot} ${status.label}</span>
            </div>
            <div style="color:#aab;font-size:10px;margin-top:2px">đź’° ${money} zĹ‚ Â· đźŽ¤ ${fans} Â· ${daysSinceAdd} dni razem</div>
          </div>
          <button onclick="event.stopPropagation();_lbRemoveFriendBtn('${f.userId}','${(f.nick||'').replace(/'/g,'')}')" style="background:transparent;border:1px solid #5a1a1a;color:#e74c3c;padding:3px 6px;border-radius:4px;cursor:pointer;font-size:10px;font-family:inherit">âś•</button>
        </div>
      </div>`;
    }).join('');
  }
  // v1.8.92: Render activity feed
  if(friendsList.length>0){
    const feedItems=_lbActivityFeed(data.scoreMap);
    if(feedItems.length>0){
      const fd=document.getElementById('friends-feed');
      if(fd){
        fd.style.display='';
        fd.innerHTML=`
          <div style="background:rgba(241,196,15,.06);border:1px solid rgba(241,196,15,.25);border-radius:10px;padding:10px 12px;margin-bottom:10px">
            <div style="font-size:10px;color:#f1c40f;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:6px">đź“ś Co u znajomych</div>
            ${feedItems.map(it=>{
              const t=_friendThemeColor(it.nick);
              return `<div style="display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12px;border-bottom:1px solid rgba(241,196,15,.1)">
                <span style="font-size:18px;flex-shrink:0">${it.milestone.emoji}</span>
                <div style="flex:1;min-width:0">
                  <span style="color:${t.primary};font-weight:700">${it.nick}</span>
                  <span style="color:#aac"> Â· ${it.milestone.label}</span>
                </div>
                <span style="color:#778;font-size:10px;white-space:nowrap">${_timeAgoLB(it.updated_at)}</span>
              </div>`;
            }).join('')}
          </div>`;
      }
    }
  }
  // Render suggested
  if(suggested.length>0){
    const sg=document.getElementById('suggested-friends');
    if(sg){
      sg.style.display='';
      sg.innerHTML=`
        <div style="background:rgba(126,200,227,.06);border:1px solid rgba(126,200,227,.25);border-radius:10px;padding:10px 12px;margin-bottom:10px">
          <div style="font-size:10px;color:#7ec8e3;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:6px">đź’ˇ MoĹĽe znasz? (TOP gracze)</div>
          ${suggested.map(r=>{
            const av=_renderMiniAvatar(r.avatar);
            const fl=_renderFlag(r.country||'PL');
            const money=(r.score||0).toLocaleString('pl');
            return `<div style="display:flex;align-items:center;gap:6px;padding:4px 0;font-size:11px">
              ${av}${fl}
              <div style="flex:1;min-width:0">
                <span style="color:#fff;font-weight:600;word-break:break-word;line-height:1.2">${r.nick}</span>
                <span style="color:#778;font-size:10px;margin-left:4px">đź’° ${money} zĹ‚</span>
              </div>
              <button onclick="_lbAddBackBtn('${r.user_id}','${(r.nick||'').replace(/'/g,'')}')" style="background:#0a3a5a;border:1px solid #7ec8e3;color:#7ec8e3;padding:3px 7px;border-radius:4px;cursor:pointer;font-size:10px;font-weight:700;font-family:inherit">âž•</button>
            </div>`;
          }).join('')}
        </div>`;
    }
  }
}

// Klik znajomego â†’ modal z porĂłwnaniem Ty vs Friend
async function renderFriendProfile(userId){
  const friend=(G.friends||[]).find(f=>f.userId===userId);
  if(!friend) return;
  document.getElementById('friend-profile-modal')?.remove();
  const modal=document.createElement('div');
  modal.id='friend-profile-modal';
  modal.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px;cursor:pointer';
  modal.onclick=(e)=>{if(e.target===modal) modal.remove();};
  modal.innerHTML='<div style="color:#aac;font-size:14px">âŹł ĹadujÄ™ profil...</div>';
  document.body.appendChild(modal);
  // Fetch obu profili
  const [friendData,myData]=await Promise.all([
    _lbFetch(`leaderboard?user_id=eq.${userId}&period_key=eq.alltime&limit=10`),
    _lbFetch(`leaderboard?user_id=eq.${G.playerUUID}&period_key=eq.alltime&limit=10`)
  ]);
  const fStats={};const mStats={};
  if(Array.isArray(friendData)) for(const r of friendData) fStats[r.category]={score:r.score,updated_at:r.updated_at,country:r.country,avatar:r.avatar,nick:r.nick};
  if(Array.isArray(myData)) for(const r of myData) mStats[r.category]={score:r.score,updated_at:r.updated_at,country:r.country,avatar:r.avatar,nick:r.nick};
  // Liczymy ranking globalny w money (najpopularniejsza kategoria)
  const friendMoneyScore=fStats.money?.score||0;
  const myMoneyScore=mStats.money?.score||0;
  const friendRankResp=await _lbFetch(`leaderboard?category=eq.money&period_key=eq.alltime&score=gt.${friendMoneyScore}&select=user_id&limit=10000`);
  const friendRank=Array.isArray(friendRankResp)?friendRankResp.length+1:'?';
  const myRankResp=await _lbFetch(`leaderboard?category=eq.money&period_key=eq.alltime&score=gt.${myMoneyScore}&select=user_id&limit=10000`);
  const myRank=Array.isArray(myRankResp)?myRankResp.length+1:'?';
  const theme=_friendThemeColor(friend.nick);
  const cats=['money','level','fans','achievements','casino','speedrun'];
  const catLabels={money:'đź’° Kasa',level:'â­ Poziom',fans:'đźŽ¤ Fani',achievements:'đźŹ† Trofea',casino:'đźŽ° Kasyno',speedrun:'âŹ± Speedrun'};
  const rowsHtml=cats.map(c=>{
    const my=mStats[c]?.score||0;
    const fr=fStats[c]?.score||0;
    const fmt=v=>c==='speedrun'?(v>0?v+' dni':'â€”'):(v||0).toLocaleString('pl');
    const winner=c==='speedrun'?(my>0&&fr>0?(my<fr?'me':my>fr?'fr':'tie'):(my>0?'me':fr>0?'fr':'tie')):(my>fr?'me':my<fr?'fr':'tie');
    return `<tr style="border-bottom:1px solid #1a2535">
      <td style="padding:8px;color:#aac;font-size:12px">${catLabels[c]}</td>
      <td style="padding:8px;text-align:right;color:${winner==='me'?'#27ae60':'#fff'};font-weight:${winner==='me'?'900':'600'};font-size:13px">${fmt(my)}${winner==='me'?' đź‘‘':''}</td>
      <td style="padding:8px;text-align:right;color:${winner==='fr'?theme.primary:'#fff'};font-weight:${winner==='fr'?'900':'600'};font-size:13px">${fmt(fr)}${winner==='fr'?' đź‘‘':''}</td>
    </tr>`;
  }).join('');
  modal.innerHTML=`<div style="background:linear-gradient(180deg,#0a1018,#06101e);border:2px solid ${theme.primary};border-radius:14px;padding:18px;max-width:480px;width:100%;cursor:default;box-shadow:0 16px 48px rgba(0,0,0,.7),0 0 60px ${theme.primary}44" onclick="event.stopPropagation()">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
          ${_renderMiniAvatar(fStats.money?.avatar)}
          ${_renderFlag(fStats.money?.country||'PL')}
          <h2 style="margin:0;color:${theme.primary};font-size:20px">${_escHtml(friend.nick)}</h2>
        </div>
        <div style="font-size:11px;color:#778">Globalna pozycja: <b style="color:${theme.primary}">#${friendRank}</b> Â· Z paczki od ${Math.max(0,(G.day||0)-(friend.addedDay||0))} dni</div>
      </div>
      <div style="display:flex;gap:6px;align-items:flex-start">
        <button onclick="document.getElementById('friend-profile-modal')?.remove();window._openPlayerChat('${userId}','${_escHtml(friend.nick).replace(/'/g,"\\'")}')" style="background:#1a5a3a;border:1px solid #27ae60;color:#2ecc71;padding:6px 10px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:700;font-family:inherit" title="OtwĂłrz czat z tym znajomym">đź’¬ Czat</button>
        <button onclick="document.getElementById('friend-profile-modal')?.remove()" style="background:transparent;border:1px solid #2a3a4a;color:#aaa;width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:14px;font-family:inherit">âś•</button>
      </div>
    </div>
    <div style="background:#050a14;border-radius:8px;padding:8px;margin-bottom:12px">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr style="border-bottom:1px solid #2a3a4a">
            <th style="padding:6px;text-align:left;font-size:10px;color:#778;font-weight:700;letter-spacing:1px;text-transform:uppercase">Kategoria</th>
            <th style="padding:6px;text-align:right;font-size:10px;color:#27ae60;font-weight:700;letter-spacing:1px;text-transform:uppercase">TY (#${myRank})</th>
            <th style="padding:6px;text-align:right;font-size:10px;color:${theme.primary};font-weight:700;letter-spacing:1px;text-transform:uppercase">${_escHtml(friend.nick.slice(0,8).toUpperCase())}</th>
          </tr>
        </thead>
        <tbody>${rowsHtml}</tbody>
      </table>
    </div>
    <div style="font-size:10px;color:#778;text-align:center">Ostatnia aktywnoĹ›Ä‡: ${_timeAgoLB(fStats.money?.updated_at)}</div>
  </div>`;
}
// v1.8.92: Activity feed â€” derived from current friends' state (highest milestone per friend)
const _LB_MILESTONES_FANS=[
  {threshold:1000000,emoji:'đźŹ†',label:'Milion fanĂłw â€” LEGENDA'},
  {threshold:100000,emoji:'đź’Ž',label:'100k fanĂłw â€” gwiazda'},
  {threshold:10000,emoji:'đźŚź',label:'10k fanĂłw'},
  {threshold:1000,emoji:'đźŽ¤',label:'1000 fanĂłw'},
];
const _LB_MILESTONES_MONEY=[
  {threshold:10000000,emoji:'đź’¸',label:'10 milionĂłw zĹ‚'},
  {threshold:1000000,emoji:'đź’°',label:'Milionerem'},
  {threshold:100000,emoji:'đź’µ',label:'100k zĹ‚'},
  {threshold:10000,emoji:'đź’˛',label:'Pierwsze 10k'},
];
function _lbBestMilestone(friend, stats){
  // Zwraca najlepszy milestone (priorytet: prestige > fans > money > kasyno > speedrun > level)
  const moneyM=_LB_MILESTONES_MONEY.find(m=>(stats.money||0)>=m.threshold);
  const fansM=_LB_MILESTONES_FANS.find(m=>(stats.fans||0)>=m.threshold);
  const lvlScore=stats.level||0;
  if(lvlScore>=100) return {emoji:'â­',label:'WszedĹ‚ w Prestige '+Math.floor(lvlScore/100)};
  if(fansM) return fansM;
  if(moneyM) return moneyM;
  if((stats.casino||0)>=100000) return {emoji:'đźŽ°',label:'Big winner â€” 100k+ w kasynie'};
  if((stats.achievements||0)>=50) return {emoji:'đźŹ†',label:'50+ trofei'};
  if((stats.speedrun||0)>0) return {emoji:'âŹ±',label:'Speedrun do 1M w '+stats.speedrun+' dni'};
  if(lvlScore>=10) return {emoji:'â­',label:'Poziom '+lvlScore};
  return null;
}
function _lbActivityFeed(scoreMap){
  // Zbuduj listÄ™ aktywnoĹ›ci: dla kaĹĽdego znajomego znajdĹş jego "headline" milestone + updated_at
  const items=[];
  for(const [uid,stats] of scoreMap){
    const f=(G.friends||[]).find(fr=>fr.userId===uid);
    if(!f) continue;
    const m=_lbBestMilestone(f,stats);
    if(!m) continue;
    items.push({nick:f.nick,milestone:m,updated_at:stats.updated_at||'',userId:uid});
  }
  // Sort po updated_at desc, top 5
  items.sort((a,b)=>(b.updated_at||'').localeCompare(a.updated_at||''));
  return items.slice(0,5);
}

// v1.8.92: Detect milestone crossing â€” porĂłwnaj poprzedni snapshot z aktualnym, wykryj przekroczone progi â†’ push notif
async function _lbCheckFriendsMilestones(){
  if(!G.leaderboardOptIn||!G.playerUUID) return;
  const friendsList=G.friends||[];
  if(friendsList.length===0) return;
  const userIds=friendsList.map(f=>f.userId).join(',');
  const rows=await _lbFetch(`leaderboard?user_id=in.(${userIds})&period_key=eq.alltime&limit=500`);
  if(!Array.isArray(rows)) return;
  // Zbuduj aktualne score'y per user_id per category
  const current={};
  for(const r of rows){
    if(!current[r.user_id]) current[r.user_id]={};
    current[r.user_id][r.category]=r.score||0;
  }
  if(!G.friendsSnapshots||typeof G.friendsSnapshots!=='object') G.friendsSnapshots={};
  // Dla kaĹĽdego znajomego sprawdĹş czy ktĂłryĹ› prĂłg zostaĹ‚ wĹ‚aĹ›nie przekroczony
  for(const f of friendsList){
    const cur=current[f.userId];
    if(!cur) continue;
    const prev=G.friendsSnapshots[f.userId]||{};
    // Fans milestones
    for(const m of _LB_MILESTONES_FANS){
      if((cur.fans||0)>=m.threshold && (prev.fans||0)<m.threshold){
        if(typeof addNotif==='function') addNotif(`đźŽ‰ ${f.nick}: ${m.emoji} ${m.label}!`);
      }
    }
    // Money milestones
    for(const m of _LB_MILESTONES_MONEY){
      if((cur.money||0)>=m.threshold && (prev.money||0)<m.threshold){
        if(typeof addNotif==='function') addNotif(`đźŽ‰ ${f.nick}: ${m.emoji} ${m.label}!`);
      }
    }
    // Prestige milestone (level >= 100 = prestige 1+)
    const curPrestige=Math.floor((cur.level||0)/100);
    const prevPrestige=Math.floor((prev.level||0)/100);
    if(curPrestige>prevPrestige && curPrestige>=1){
      if(typeof addNotif==='function') addNotif(`đźŽ‰ ${f.nick}: â­ WszedĹ‚ w Prestige ${curPrestige}!`);
    }
    // Update snapshot
    G.friendsSnapshots[f.userId]=cur;
  }
}

// Add back / accept incoming request â€” uĹĽywamy istniejÄ…cego addFriend ale z UUID bezpoĹ›rednio
async function _lbAddBackBtn(userId,nick){
  /* v2.1.0: zmieniona logika â€” friend request system z akceptacjÄ….
     WczeĹ›niej: klik Dodaj natychmiast tworzyĹ‚ jednostronnÄ… znajomoĹ›Ä‡ (bez wiedzy drugiej strony).
     Teraz: tworzy 'pending' invite â†’ odbiorca widzi w đź“Ą Zaproszenia â†’ klik Akceptuj/OdrzuÄ‡.
     Akceptacja tworzy DWUSTRONNÄ„ znajomoĹ›Ä‡ (oba rekordy 'accepted').
     Edge case: jeĹ›li odbiorca wczeĹ›niej zaprosiĹ‚ MNIE (pending) â†’ auto-akceptuj obie strony. */
  if(!userId) return;
  if(userId===G.playerUUID){if(typeof showMsg==='function') showMsg('Nie moĹĽesz dodaÄ‡ siebie','r');return;}
  if((G.friends||[]).some(f=>f.userId===userId)){
    if(typeof showMsg==='function') showMsg('Ten gracz jest juĹĽ Twoim znajomym','i');
    return;
  }
  if(!Array.isArray(G.friends)) G.friends=[];
  if(G.friends.length>=50){if(typeof showMsg==='function')showMsg('đźš« Limit znajomych (50). UsuĹ„ kogoĹ› ĹĽeby dodaÄ‡ nowÄ… osobÄ™.','r');return;}
  /* SprawdĹş czy gracz wczeĹ›niej wysĹ‚aĹ‚ MI zaproszenie â€” jeĹ›li tak, auto-akceptuj zamiast tworzyÄ‡ nowe */
  const incoming=await _lbFetch(`friendships?from_user_id=eq.${userId}&to_user_id=eq.${G.playerUUID}&status=eq.pending&limit=1`);
  if(Array.isArray(incoming) && incoming.length>0){
    /* Symultaniczne dodanie z obu stron â€” od razu akceptujemy */
    return await _lbAcceptFriendRequest(userId,nick||'Nieznany');
  }
  /* SprawdĹş czy nie ma juĹĽ pending wysĹ‚anego ode mnie do tego usera */
  const existing=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${userId}&limit=1`);
  if(Array.isArray(existing) && existing.length>0){
    const e=existing[0];
    if(e.status==='pending'){
      if(typeof showMsg==='function') showMsg('đź“¤ Zaproszenie juĹĽ wysĹ‚ane â€” czekaj na akceptacjÄ™','i');
      return;
    }
    if(e.status==='rejected'){
      /* SprĂłbuj wysĹ‚aÄ‡ ponownie â€” update status na pending */
      await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${userId}`,{
        method:'PATCH',
        body:JSON.stringify({status:'pending'})
      });
      if(typeof showMsg==='function') showMsg('đź“¤ Zaproszenie wysĹ‚ane ponownie','g');
      return;
    }
  }
  /* v2.1.11: merge-duplicates ĹĽeby resend po rejected dziaĹ‚aĹ‚o */
  await _lbFetch('friendships?on_conflict=from_user_id,to_user_id',{
    method:'POST',
    headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
    body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:userId,status:'pending'})
  });
  if(typeof showMsg==='function') showMsg('đź“¤ Zaproszenie wysĹ‚ane do: '+(nick||'gracza')+' â€” czeka na akceptacjÄ™','g',4000);
  renderPhoneFriends();
}
/* v2.1.0: Akceptacja zaproszenia â€” zmienia oryginaĹ‚ na 'accepted' + tworzy reverse 'accepted'.
   Wynik: oba rekordy w bazie 'accepted' â†’ dwustronna znajomoĹ›Ä‡. */
async function _lbAcceptFriendRequest(fromUserId,fromNick){
  if(!fromUserId) return;
  if(!Array.isArray(G.friends)) G.friends=[];
  if(G.friends.length>=50){if(typeof showMsg==='function')showMsg('đźš« Limit znajomych (50). UsuĹ„ kogoĹ› ĹĽeby zaakceptowaÄ‡.','r');return;}
  /* Update oryginalnego rekordu (from=fromUserId, to=me) na 'accepted' */
  await _lbFetch(`friendships?from_user_id=eq.${fromUserId}&to_user_id=eq.${G.playerUUID}`,{
    method:'PATCH',
    body:JSON.stringify({status:'accepted'})
  });
  /* Insert reverse (from=me, to=fromUserId) z 'accepted' */
  await _lbFetch('friendships',{
    method:'POST',
    headers:{'Prefer':'resolution=ignore-duplicates,return=minimal'},
    body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:fromUserId,status:'accepted'})
  });
  /* Dodaj lokalnie do G.friends */
  if(!G.friends.some(f=>f.userId===fromUserId)){
    G.friends.push({userId:fromUserId,nick:fromNick||'Nieznany',addedDay:G.day||0});
    if(typeof saveGameSilent==='function') saveGameSilent();
  }
  if(typeof showMsg==='function') showMsg('âś… Zaakceptowano: '+(fromNick||'gracza'),'g');
  renderPhoneFriends();
}
async function _lbRejectFriendRequest(fromUserId,fromNick){
  if(!fromUserId) return;
  /* Update na 'rejected' (zostawiamy rekord ĹĽeby nie spam-wysyĹ‚aĹ‚ ponownie) */
  await _lbFetch(`friendships?from_user_id=eq.${fromUserId}&to_user_id=eq.${G.playerUUID}`,{
    method:'PATCH',
    body:JSON.stringify({status:'rejected'})
  });
  if(typeof showMsg==='function') showMsg('đźš« Odrzucono zaproszenie od: '+(fromNick||'gracza'),'i');
  renderPhoneFriends();
}
function _lbCopyFriendCode(){
  const code=getFriendCode();
  if(!code) return;
  try{
    navigator.clipboard.writeText(code);
    if(typeof showMsg==='function') showMsg('đź“‹ Skopiowano: '+code,'g');
  }catch(e){
    if(typeof showMsg==='function') showMsg('âš ď¸Ź Skopiuj rÄ™cznie: '+code,'r');
  }
}
async function _lbAddFriendBtn(){
  const input=document.getElementById('add-friend-input');
  const status=document.getElementById('add-friend-status');
  if(!input||!status) return;
  const code=input.value.trim().toUpperCase();
  if(!code){status.style.color='#e74c3c';status.textContent='âťŚ Wpisz kod';return;}
  /* v2.1.115: Wave 4 W44 â€” rate limit per-user (anti-spam zaproszeĹ„). */
  const _now=Date.now();
  if(window._lastFriendReqTime && (_now-window._lastFriendReqTime)<60000){
    const _s=Math.ceil((60000-(_now-window._lastFriendReqTime))/1000);
    status.style.color='#f39c12';status.textContent=`âŹł Poczekaj ${_s}s przed kolejnym zaproszeniem`;return;
  }
  window._lastFriendReqTime=_now;
  status.style.color='#aac';status.textContent='âŹł WyszukujÄ™...';
  /* v2.1.115: Wave 4 W43 â€” try/catch dla Supabase fetch (offline mode â†’ komunikat zamiast silent fail). */
  let r;
  try{
    r=await addFriend(code);
  }catch(e){
    status.style.color='#e74c3c';status.textContent='âťŚ Brak poĹ‚Ä…czenia z serwerem. SprawdĹş internet i sprĂłbuj ponownie.';return;
  }
  if(!r.ok){status.style.color='#e74c3c';status.textContent='âťŚ '+r.error;return;}
  /* v2.1.0: rĂłĹĽny komunikat dla auto-accept (drugi gracz juĹĽ zaprosiĹ‚ mnie) vs pending */
  if(r.autoAccepted){
    status.style.color='#27ae60';status.textContent='âś… Dodano: '+r.friend.nick+' (auto-akceptacja)';
  } else {
    status.style.color='#9b59b6';status.textContent='đź“¤ Zaproszenie wysĹ‚ane do '+r.friend.nick+' â€” czeka na akceptacjÄ™';
  }
  input.value='';
  setTimeout(()=>renderPhoneFriends(),900);
}
function _lbRemoveFriendBtn(uuid,nick){
  if(typeof gameConfirm==='function'){
    gameConfirm(`UsunÄ…Ä‡ znajomego "${nick}"?`,async()=>{
      await removeFriend(uuid);
      renderPhoneFriends();
    });
  } else if(confirm(`UsunÄ…Ä‡ znajomego "${nick}"?`)){
    removeFriend(uuid).then(()=>renderPhoneFriends());
  }
}

function renderPhoneMuzyka(){
  document.getElementById('ph-title').textContent='đźŽµ Moja Muzyka';
  const tracks=G.studioTracks||[];
  const distr=G.distributor;
  const totStreams=tracks.reduce((s,t)=>s+(t.streams||0),0);
  const totRoy=G.spotify?G.spotify.royalties||0:0;
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen">
      <div style="background:#0a1018;border-radius:8px;padding:10px 12px;margin-bottom:12px;font-size:13px">
        <div style="display:flex;justify-content:space-between;margin-bottom:4px">
          <span style="color:#aaa">Dystrybutor:</span>
          <span style="color:${distr?'#2ecc71':'#e74c3c'}">${distr?distr.name:'Brak â€” kup w DAW'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:4px">
          <span style="color:#aaa">ĹÄ…czne streamy:</span><span style="color:#3498db">${totStreams.toLocaleString('pl')}</span>
        </div>
        <div style="display:flex;justify-content:space-between">
          <span style="color:#aaa">ĹÄ…czne royalties:</span><span style="color:#f1c40f">${totRoy} zĹ‚</span>
        </div>
      </div>
      ${tracks.length===0?`<div style="text-align:center;padding:30px;color:#555"><div style="font-size:36px">đźŽµ</div><p>Brak wydanych singli.<br>Nagraj i wydaj przez DAW w studio!</p></div>`:
        tracks.map((t,i)=>`
          <div style="background:#0a1018;border:1px solid #1a1a2a;border-radius:8px;padding:10px 12px;margin-bottom:8px">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
              <div><div style="color:#fff;font-weight:700;font-size:14px">${t.name}</div>
              <div style="color:#666;font-size:11px;margin-top:2px">DzieĹ„ ${t.releaseDay} Â· ${(GENRES[t.genre]?.name)||t.genre||'Trap'} Â· JakoĹ›Ä‡: ${t.quality||0}%</div></div>
              <div style="text-align:right"><div style="color:#3498db;font-size:13px">${(t.streams||0).toLocaleString('pl')} str.</div>
              <div style="color:#f1c40f;font-size:12px">Royalty: +${Math.floor((t.streams||0)*0.004*((G.distributor?G.distributor.royaltyPct:80)/100)*(t.quality/100+0.2))} zĹ‚/tydz.</div></div>
            </div>
            <div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap">
              ${t.beatQ?`<span style="background:#1a0a2a;padding:2px 6px;border-radius:4px;font-size:10px;color:#9b59b6">Beat ${t.beatQ}%</span>`:''}
              ${t.vocalQ?`<span style="background:#0a1a2a;padding:2px 6px;border-radius:4px;font-size:10px;color:#3498db">Wokal ${t.vocalQ}%</span>`:''}
              ${t.mixQ?`<span style="background:#0a2a1a;padding:2px 6px;border-radius:4px;font-size:10px;color:#27ae60">Mix ${t.mixQ}%</span>`:''}
              ${t.masterQ?`<span style="background:#2a1a0a;padding:2px 6px;border-radius:4px;font-size:10px;color:#f39c12">Master ${t.masterQ}%</span>`:''}
            </div>
          </div>`).join('')}
      <button class="cbtn" onclick="renderPhoneHome()" style="margin-top:8px">â† WrĂłÄ‡</button>
    </div>`;
}

function renderPhoneQuest(){
  document.getElementById('ph-title').textContent='đź“‹ Dzienne Zadanie';
  if(!G.dailyQuest) generateDailyQuest();
  const q=G.dailyQuest;
  const pct=Math.min(100,Math.floor(q.progress/q.count*100));
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen">
      <div style="background:#0a1a2a;border:1px solid #1a3a5a;border-radius:8px;padding:16px;margin-bottom:12px">
        <div style="font-size:12px;color:#3498db;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">DzieĹ„ ${q.day} â†’ DzieĹ„ ${G.day}</div>
        <div style="font-size:17px;color:#7ec8e3;margin-bottom:12px;line-height:1.4">${q.desc}</div>
        <div style="background:#0a0a14;border-radius:6px;overflow:hidden;height:10px;margin-bottom:8px">
          <div style="height:100%;width:${pct}%;background:linear-gradient(90deg,#1a5a8a,#3498db);transition:width .3s"></div>
        </div>
        <div style="font-size:14px;color:#aaa;margin-bottom:8px">PostÄ™p: <strong style="color:#fff">${q.progress}/${q.count}</strong> (${pct}%)</div>
        <div style="font-size:13px;color:#27ae60">Nagroda: ${q.reward} zĹ‚ + ${q.xp} XP</div>
      </div>
      ${q.completed&&!q.claimed?`<div style="background:#0a1a0a;border:1px solid #1a5a1a;border-radius:8px;padding:12px;margin-bottom:10px;color:#7ec87e;font-size:14px">âś… Zadanie ukoĹ„czone! IdĹş do Wiktora lub odbierz tutaj.</div>
      <button class="bbtn" onclick="claimQuestRewardPhone()">đź’° Odbierz nagrodÄ™</button>`:''}
      ${q.completed&&q.claimed?`<div style="color:#27ae60;font-size:15px;text-align:center;padding:10px">âś… Nagroda odebrana! Jutro nowe zadanie.</div>`:''}
    </div>
    <div style="padding:8px 14px"><button class="cbtn" style="width:100%" onclick="renderPhoneHome()">â† WrĂłÄ‡</button></div>
  `;
}
window.claimQuestRewardPhone=()=>{
  claimQuestReward();renderPhoneQuest();
};

// v1.8.94: SkalujÄ…ce wymogi prestige
window.getPrestigeReqs=function(rank){
  const r=rank||((G.prestige||0)+1);
  return {level:15+(r-1)*3, fans:100000*Math.pow(2,r-1)}; // P1=lvl15+100k, P2=lvl18+200k, P3=lvl21+400k, P5=lvl27+1.6M, P10=lvl42+51M
};
/* v2.1.160: Prestige Skill Tree â€” 6 permanentnych perkĂłw, kaĹĽde Prestige = 1 punkt. PersystujÄ… przez kolejne Prestige.
   Per-perk: koszt 1 pt, dziaĹ‚a permanentnie na top of base prestige bonuses. */
const PRESTIGE_SKILLS={
  studio_mogul:{name:'Studio Mogul',emoji:'đźŽ™',desc:'+10% royalties (Spotify/Tidal/SoundCloud)',cost:1},
  cult_following:{name:'Cult Following',emoji:'đź‘‘',desc:'+20% addFans (kaĹĽde ĹşrĂłdĹ‚o fanĂłw)',cost:1},
  iron_discipline:{name:'Iron Discipline',emoji:'đź’Ş',desc:'-15% energy drain (mniej szybkie zmÄ™czenie)',cost:1},
  diamond_hands:{name:'Diamond Hands',emoji:'đź’Ž',desc:'+10% money (na top of Prestige moneyMult)',cost:1},
  legend_status:{name:'Legend Status',emoji:'đźŚź',desc:'+8% fame gain (na top of Prestige fameMult)',cost:1},
  tour_magnate:{name:'Tour Magnate',emoji:'đźŚŤ',desc:'+15% concert earnings',cost:1},
};
/* Helper functions dla perks */
function hasPrestigeSkill(key){return !!(G.prestigeSkills && G.prestigeSkills[key]);}
function getPrestigeSkillMult(key){return hasPrestigeSkill(key) ? {studio_mogul:1.10,cult_following:1.20,iron_discipline:0.85,diamond_hands:1.10,legend_status:1.08,tour_magnate:1.15}[key] : 1;}
window.buyPrestigeSkill=(key)=>{
  if(!PRESTIGE_SKILLS[key]){return;}
  if(!G.prestigeSkills) G.prestigeSkills={};
  if(G.prestigeSkills[key]){if(typeof showMsg==='function')showMsg('âš ď¸Ź JuĹĽ posiadasz ten perk','r');return;}
  if((G.prestigePoints||0)<1){if(typeof showMsg==='function')showMsg(`âš ď¸Ź Brak Prestige Points (masz ${G.prestigePoints||0}, potrzeba 1)`,'r');return;}
  G.prestigeSkills[key]=true;
  G.prestigePoints=(G.prestigePoints||0)-1;
  if(typeof notify==='function')notify(`đźŚź Prestige Skill: ${PRESTIGE_SKILLS[key].emoji} ${PRESTIGE_SKILLS[key].name} odblokowany!`);
  if(typeof renderPrestigeSkillsOverlay==='function')renderPrestigeSkillsOverlay();
};
window.renderPrestigeSkillsOverlay=()=>{
  if(typeof openOverlay!=='function')return;
  const _pts=G.prestigePoints||0;
  let html=`<h2>đźŚź Prestige Skill Tree</h2>
    <p class="sub">Permanentne perki â€” persystujÄ… przez kolejne Prestige. KaĹĽdy Prestige rank daje 1 punkt.</p>
    <p style="color:#f1c40f;font-size:14px;text-align:center;margin-bottom:12px">Twoje Prestige Points: <b>${_pts}</b> Â· Prestige rank: <b>${G.prestige||0}</b></p>
    <div class="shopgrid">`;
  for(const [k,p] of Object.entries(PRESTIGE_SKILLS)){
    const owned=hasPrestigeSkill(k);
    html+=`<div class="sitem" style="${owned?'border-color:#27ae60;background:rgba(40,180,90,.08)':''}">
      <h3>${p.emoji} ${p.name}</h3>
      <p>${p.desc}</p>
      <div class="cost">Koszt: ${p.cost} pkt Prestige</div>
      ${owned?`<div style="color:#27ae60;font-size:12px;font-weight:700">âś… Odblokowany</div>`:
        `<button class="bbtn" onclick="buyPrestigeSkill('${k}')" ${_pts<p.cost?'disabled':''}>Odblokuj</button>`}
    </div>`;
  }
  html+=`</div><button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>`;
  document.getElementById('ov-content').innerHTML=html;
  openOverlay();
};
window.doPrestige=()=>{
  const rank=(G.prestige||0)+1;
  /* v1.9.48: cap Prestige na 10 (audyt late-game: bez capa = unbounded scaling, P100 = 6x multiplier) */
  if(rank>10){showMsg('đźŹ† Maksymalny Prestige (10) osiÄ…gniÄ™ty! Bez dalszych progresĂłw rankingu.','r');return;}
  const reqs=getPrestigeReqs(rank);
  if(G.level<reqs.level){showMsg(`Prestige ${rank} wymaga poziomu ${reqs.level} (masz ${G.level})`,'r');return;}
  if((G.fans||0)<reqs.fans){showMsg(`Prestige ${rank} wymaga ${reqs.fans.toLocaleString('pl')} fanĂłw (masz ${(G.fans||0).toLocaleString('pl')})`,'r');return;}
  // v1.8.94: wykĹ‚adnicze nagrody (rankÂ˛ zamiast rank)
  const reward=rank*rank*5000;
  const fanBonus=rank*rank*1000;
  const skillPtBonus=1+Math.floor(rank/2);
  G.prestige=rank;G.level=1;G.xp=0;
  /* v2.1.160: Prestige Skill Points +1 za kaĹĽdy Prestige rank */
  G.prestigePoints=(G.prestigePoints||0)+1;
  if(typeof addNotif==='function')addNotif(`đźŚź +1 Prestige Skill Point! Razem masz: ${G.prestigePoints}. Wydaj w Telefon â†’ Prestige Skills.`);
  G.money+=reward;G.totalEarned=(G.totalEarned||0)+reward;
  G.followers+=fanBonus;G.fame=clamp(G.fame+10,0,500);
  G.skillPoints=(G.skillPoints||0)+skillPtBonus;
  G.sleepDebt=0;
  // v1.9.15: anuluj aktywny kontrakt (poprzednio orphan â€” deadline pozostawaĹ‚ w przyszĹ‚oĹ›ci, nigdy nie wygasaĹ‚)
  if(G.contract){addNotif('đź“ś Kontrakt anulowany przez Prestige â€” zacznij od nowa.');G.contract=null;}
  // v1.9.19: BUG FIX â€” Crew teĹĽ siÄ™ resetuje na Prestige (poprzednio survival crew dawaĹ‚ compound permanent +15+15+20% przez wieczne uruchomienia)
  if(Array.isArray(G.crew) && G.crew.length>0){
    addNotif('đź‘Ą Ekipa rozeszĹ‚a siÄ™ przy Prestige â€” rekrutuj na nowo!');
    G.crew=[];
  }
  /* v1.9.21: Career levels teĹĽ siÄ™ resetujÄ… na Prestige. WczeĹ›niej "Legend" raper przy gracz lvl 1 = career flags persistowaĹ‚y, unlock check `c.gamer.unlocked` true mimo G.level=1. */
  if(G.careers){
    if(G.careers.raper){G.careers.raper.xp=0;G.careers.raper.level=0;G.careers.raper.skillPts=0;}
    /* v1.9.46: career counters teĹĽ resetuj (sponsorships/posts/projects/beats) â€” wczeĹ›niej cyfry rosĹ‚y infinit przez kolejne playthrough'y (audyt sponsor system) */
    ['gamer','beatmaker','youtuber','influencer','soundeng'].forEach(c=>{
      if(G.careers[c]){
        G.careers[c].unlocked=false;
        // zachowaj structural fields, ale wyzeruj counters
        Object.keys(G.careers[c]).forEach(k=>{
          if(typeof G.careers[c][k]==='number' && k!=='unlocked') G.careers[c][k]=0;
        });
      }
    });
    addNotif('đź’Ľ Kariery zresetowane przy Prestige â€” odblokuj na nowo!');
  }
  /* v1.9.30: SMS _triggeredEvents reset â€” milestones zerujÄ… siÄ™ przy Prestige, wiÄ™c SMS od NPC powinny mĂłc firowac ponownie (poprzednio fans1k/first_freestyle nigdy nie firowaĹ‚o w drugim playthrough) */
  if(G.sms?._triggeredEvents){G.sms._triggeredEvents={};addNotif('đź’¬ Kontakty zresetowane â€” NPC odezwÄ… siÄ™ ponownie po milestone\'ach.');}
  /* v1.9.34: BUG FIX â€” reset milestone flags ĹĽeby gracz mĂłgĹ‚ znowu wbiÄ‡ milestonery (poprzednio fanBonus dawaĹ‚ rankÂ˛k followersĂłw = od razu mile1k/10k/100k locked, +62k zĹ‚ zarobkĂłw permanently lost) */
  G._mile1k=false;G._mile10k=false;G._mile100k=false;G._mile1m=false;G._mile1mDay=0;
  G._repBoost25=false;G._repBoost50=false;G._repBoost75=false;
  /* v1.9.59: cinematics flags reset (audyt cinematics: zostawaĹ‚y po prestige â†’ kolejne playthrough'y bez animacji debut/spotify/forma100) */
  G._debutAlbumShown=false;G._firstBeatShown=false;G._firstConcertShown=false;G._spotifyVerifyCinematic=false;G._milestonesShown={};G._formaWasAt100=false; /* v2.1.140: _firstConcertShown reset */
  /* v1.9.62: reset bills na prestige â€” wczeĹ›niej gracz mĂłgĹ‚ nieĹ›Ä‡ debt do kolejnego playthrough (audyt bills) */
  G.bills={pending:[],history:[],evicted:false};
  /* v1.9.64: reset notifications na prestige â€” fresh log dla nowego playthrough (audyt phone notif) */
  G.notifications=[];
  G._gymFirstEntry=false;
  /* v2.1.97: reset casino stats na prestige â€” wczeĹ›niej totalWon persystowaĹ‚ co dawaĹ‚o VIP unlock (10k) od dnia 1 nowego playthrough.
     ZachowujÄ™ _vipUnlocked + _firstCasinoVisit + _gotRoyalFlush (lifetime achievement flags). Statystyki = fresh start. */
  G.casinoStats={slotsSpins:0,slotsWon:0,rouletteSpins:0,rouletteWon:0,blackjackPlayed:0,blackjackWon:0,warPlayed:0,warWon:0,plinkoWon:0,wheelWon:0,baccaratWon:0,crapsWon:0,biggestWin:0,totalWon:0,totalLost:0};
  G._dailyWheelSpins=0;G._lastDailyWheel=-1;G._lastVipDailyWheel=-1;
  addNotif('đźŽ° Statystyki kasyna zresetowane przy Prestige â€” nowy bilans, VIP access pozostaje.');
  /* v2.1.123: Wave 8 W80 â€” storyline _startDay marker (wymĂłg 2 dni delay przed quest checks ĹĽeby gracz nie zaliczaĹ‚ automaticznie z persisted fans/followers). */
  /* v2.1.100: PEĹNY persist reset â€” Wave 1+5+7+8 znalazĹ‚y 12 obiektĂłw ktĂłre persistowaĹ‚y. */
  /* G.npcFriendship â€” friendship Wiktora/Zbyszka/Kamila/Marcina/Producenta resetuje siÄ™ ĹĽeby gracz zaczynaĹ‚ od zera */
  if(G.npcFriendship) G.npcFriendship={};
  /* G.dailyQuest â€” Wave 6 K53: persist quest metadata z poprzedniego playthrough = ghost */
  G.dailyQuest=null;
  /* G.bank â€” Wave 1 K14 / Wave 6 K56: loan + investments persystowaĹ‚y cross-playthrough */
  G.bank={loan:0,investments:[],totalInvestmentProfit:G.bank?.totalInvestmentProfit||0};
  /* G.spotify/tidal/soundcloud/yt royalties tracker â€” Wave 1 K22 */
  if(G.spotify) G.spotify.royalties=0;
  if(G.tidal) G.tidal.royalties=0;
  if(G.soundcloud) G.soundcloud.royalties=0;
  if(G.radio) G.radio.royalties=0;
  if(G.yt) G.yt.adsense=0;
  /* G.managementDeal â€” Wave 1 K23: deal persistowaĹ‚ = passive bonus na kaĹĽdym playthrough */
  G.managementDeal=false;G.managementBonus=1;G._lastManagementDay=-1;
  /* G.studioTracks â€” Wave 1 K24: tracki z prev playthrough persystowaĹ‚y, milionowe streamy na start */
  G.studioTracks=[];G.albumsReleased=0;
  /* G.distributor + G.label â€” Wave 1 K25
     v2.1.165: ZACHOWAJ label.artists (gracz po Prestige nadal wĹ‚aĹ›ciciel wytwĂłrni â€” artyĹ›ci pozostajÄ… signed, kontynuujÄ… passive income).
     Zerujemy tylko `type` (gracz moĹĽe podpisaÄ‡ nowy kontrakt z innym major label). */
  G.distributor=null;
  const _preservedArtists=Array.isArray(G.label?.artists)?G.label.artists:[];
  G.label={type:null,advance:0,signedMajorBefore:G.label?.signedMajorBefore||false,signedGlobalBefore:G.label?.signedGlobalBefore||false,contractEndsDay:0,brokenAt:0,artists:_preservedArtists};
  if(_preservedArtists.length>0 && typeof addNotif==='function') addNotif(`đźŽĽ WytwĂłrnia: ${_preservedArtists.length} artystĂłw zachowanych przez Prestige â€” kontynuujÄ… passive income.`);
  /* G.ytStreak / G._ytLastUploadDay â€” Wave 1 W27 + Wave 4 W34 */
  G.ytStreak=0;G._ytLastUploadDay=-1;G.streamingStreak=0;G._lastStreamDay=-1;
  /* G._lastConcertAbs â€” Wave 1 W28 */
  G._lastConcertAbs=-99999;G._concertsCounter={day:0,count:0};
  /* G._eventCounts + G._lastChoiceEventDay â€” Wave 7 K70 */
  G._eventCounts={day:G.day,counts:{}};G._lastChoiceEventDay=-1;
  /* G.mainQuest + G.sideQuests â€” Wave 8 K76/K77: storyline soft-lock fix */
  G.mainQuest={currentStep:0,completed:[],_startDay:G.day};G.sideQuests={}; /* v2.1.123: W80 _startDay marker */
  /* G.activeHoliday + G.activeFestival â€” Wave 5 K45 */
  G.activeHoliday=null;G.activeFestival=null;
  /* G._tourActive â€” Wave 5 K43: orphan state fix */
  G._tourActive=null;G._firstTourStarted=false;
  /* G.drip/outfit/hair â€” Wave 1 K13 (intencjonalne? â€” drip jest "metric postÄ™pu" jak fame. Hair = cosmetic OK persistuje. Outfit = posiadane OK. Drip number = NIE resetuj, to lifetime stat). */
  /* G.haters â€” partial reset, hejt po Prestige moĹĽe zostaÄ‡ (signal ĹĽe dawne kontrowersje przetrwaĹ‚y) â€” opcja: peĹ‚ny reset */
  G.haters=0; // fresh start z hejtu
  /* v2.1.108: Magazine covers counter teĹĽ reset na Prestige (Wave 7 K64 â€” gdyby gracz miaĹ‚ 5+ pre-Prestige) */
  G._magazineCovers=0;
  /* v2.1.169: Awards counters reset na Prestige (analog do magazineCovers â€” counter milestone per playthrough) */
  G._awardsWonTotal=0;G._awardsCount=0;
  /* v2.1.122: Wave 2 K13 â€” Drip/outfit/hair reset Prestige (audit EXPLOIT â€” gracz Prestige #5 startuje z drip=200 = max bonus od dnia 1).
     ZachowujÄ™ G._ownedOutfits/_ownedCars/_ownedApts (sprzÄ™t) ale RESET aktywny outfit i drip number. Hair = cosmetic OK persistuje. */
  G.drip=0;
  G.outfit={top:'default'};
  /* v2.1.122: Wave 2 W23 â€” merchStore.trend reset Prestige (wczeĹ›niej zostawaĹ‚ â€” gracz miaĹ‚ stary 7-dniowy trend mimo fresh playthrough). */
  if(G.merchStore) G.merchStore.trend=null;
  /* v2.1.110: Wave 4 K40 â€” Aerial Flythrough cinematic reset (gracz po Prestige powinien mĂłc obejrzeÄ‡ ponownie jako fresh playthrough) */
  G._cinematicCompleted=false;
  /* v2.1.111: Wave 1 W7 â€” YT series progress reset (gracz po Prestige #2 ma 4/5 series â†’ jednym filmem 2x bonus, bez wysiĹ‚ku) */
  if(G.yt) G.yt.seriesProgress=0;
  /* v2.1.111: Wave 1 W8 â€” streamBoostRemaining decay reset (boost z poprzedniego playthrough persistowaĹ‚ permamentnie) */
  G.streamBoostRemaining=0;
  /* v2.1.111: Wave 4 W42 â€” _introductionSeen reset (gracz w fresh playthrough moĹĽe obejrzeÄ‡ tutorial ponownie) */
  G._introductionSeen=false;G._introductionActive=false;
  /* v2.1.110: Wave 4 K41 â€” SMS conversations cap przed memory leak (~50 NPC Ă— 1000 wiadomoĹ›ci = MB save bloat).
     Trim per-contact do 100 ostatnich wiadomoĹ›ci przy kaĹĽdym Prestige. */
  if(G.sms?.conversations){
    for(const cid in G.sms.conversations){
      const conv=G.sms.conversations[cid];
      if(Array.isArray(conv) && conv.length>100){
        G.sms.conversations[cid]=conv.slice(-100); /* zachowaj 100 ostatnich */
      }
    }
  }
  /* v2.1.110: Wave 4 K42 â€” Bills history cap przed memory leak. Zachowaj 50 ostatnich. */
  if(G.bills?.history && Array.isArray(G.bills.history) && G.bills.history.length>50){
    G.bills.history=G.bills.history.slice(-50);
  }
  /* v2.1.120: Wave 6 W60 â€” skillPoints reset na Prestige (audyt: "Decision needed", wybraĹ‚em reset jak inne fresh-start). Niewydane SP zachowane jako oszczÄ™dnoĹ›Ä‡ = exploit (gracz farm SP w wave 1, wydaje w wave 2). */
  G.skillPoints=0;
  addNotif('đźŽŻ Skill points zresetowane przy Prestige (fresh start).');
  /* Per-event cooldowns (NPC, cookies, etc.) â€” pre-event przygotowanie */
  G._lastFanTalkDay=-1;G._lastAutographDay=-1;G._lastTherapyDay=-1;G._lastVipTipDay=-1;G._lastSponsorDay=-1;G._lastCampaignDay=-1;G._lastGhostDay=-1;G._lastBoxsetDay=-1;
  /* IG post counters â€” fresh feed */
  G.igPosts=[];G._igPostCount=0;G._igMaxPosts=150;
  /* v2.1.138: outdated comment fix â€” _introductionSeen JEST resetowany w L27412 od v2.1.111 (gracz w fresh playthrough moĹĽe obejrzeÄ‡ tutorial ponownie). WczeĹ›niej byĹ‚ nie-resetowany. */
  addNotif('đź”„ PeĹ‚ny reset Prestige: friendships, bank, royalties, tracki, kontrakty, storyline, festiwale, tour â€” wszystko od zera.');
  // Permanentne flagi prestiĹĽu â€” realnie uĹĽywane w earn() od v1.8.94
  G.prestigeBonus={moneyMult:1+rank*0.05, fameMult:1+rank*0.03};
  // v1.9.15: save synchronicznie przed cinematic (anti-stale-state przy crash mid-animation)
  if(typeof saveGameSilentNow==='function') saveGameSilentNow();
  checkAchievements();
  // v1.9.39: SFX prestige cinematic (audyt audio: prestige byĹ‚ silent mimo importance)
  if(typeof sfxSparkle==='function'){try{sfxSparkle();setTimeout(()=>sfxSparkle(),250);}catch(e){}}
  // v1.8.94: Cinematic dla kaĹĽdego prestige (zamiast prostego toast)
  if(typeof showMilestoneCinematic==='function'){
    const colors={1:{c1:'#7ec8e3',c2:'#3498db'},2:{c1:'#9b59b6',c2:'#e91e8c'},3:{c1:'#f1c40f',c2:'#e67e22'},5:{c1:'#c8a520',c2:'#e91e8c'},10:{c1:'#e91e8c',c2:'#c8a520'}};
    const col=colors[rank]||colors[Math.min(...Object.keys(colors).map(Number).filter(k=>k<=rank))]||colors[1];
    showMilestoneCinematic({
      emoji:'â­'.repeat(Math.min(rank,5)),
      title:`PRESTIGE ${rank}`,
      subtitle:`+${reward.toLocaleString('pl')} zĹ‚ Â· +${fanBonus.toLocaleString('pl')} fanĂłw Â· +${skillPtBonus} skill`,
      tagline:`Permanentny bonus: +${rank*5}% zarobkĂłw, +${rank*3}% sĹ‚awy. Reset poziomu â†’ 1.`,
      accentColor:col.c1,accent2:col.c2,duration:5000
    });
  } else {
    showMsg(`â­ PRESTIGE ${rank}! Reset poziomu â†’ 1. +${reward.toLocaleString('pl')} zĹ‚, +${fanBonus.toLocaleString('pl')} fanĂłw, +${skillPtBonus} pkt skill. Permanentny +${rank*5}% zarobkĂłw!`);
  }
  addNotif(`â­ Prestige ${rank} osiÄ…gniÄ™ty!`);
  if(typeof submitAllScores==='function') submitAllScores();
  closePhone();
};
// v1.8.94: Dedykowany ekran "Co to Prestige?"
window.showPrestigeInfo=function(){
  const rank=(G.prestige||0);
  const nextRank=rank+1;
  const reqs=getPrestigeReqs(nextRank);
  const nextReward=nextRank*nextRank*5000;
  const nextFanBonus=nextRank*nextRank*1000;
  const nextSkill=1+Math.floor(nextRank/2);
  const currentMult=G.prestigeBonus?.moneyMult||1;
  const currentPct=Math.round((currentMult-1)*100);
  const lvlOk=G.level>=reqs.level;
  /* v2.1.37 [Amper]: Prestige sprawdza fanĂłw lojalnych â€” spĂłjnoĹ›Ä‡ z HUD */
  const fansOk=(G.fans||0)>=reqs.fans;
  document.getElementById('prestige-info-modal')?.remove();
  const m=document.createElement('div');
  m.id='prestige-info-modal';
  m.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:9000;display:flex;align-items:center;justify-content:center;padding:18px;cursor:pointer';
  m.onclick=(e)=>{if(e.target===m) m.remove();};
  m.innerHTML=`<div onclick="event.stopPropagation()" style="background:linear-gradient(180deg,#0a0a1a,#1a0a2a);border:2px solid #c8a520;border-radius:14px;padding:20px 24px;max-width:560px;width:100%;max-height:90vh;overflow-y:auto;color:#fff;font-family:inherit;box-shadow:0 16px 60px rgba(0,0,0,.7),0 0 80px rgba(200,165,32,.4)">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px">
      <div>
        <h2 style="margin:0;color:#f1c40f;font-size:22px;letter-spacing:2px">â­ PRESTIGE</h2>
        <p style="margin:4px 0 0 0;color:#aac;font-size:12px">System "new game plus" â€” endgame loop</p>
      </div>
      <button onclick="document.getElementById('prestige-info-modal')?.remove()" style="background:transparent;border:1px solid #2a3a4a;color:#aaa;width:32px;height:32px;border-radius:6px;cursor:pointer;font-size:16px;font-family:inherit">âś•</button>
    </div>
    <div style="background:rgba(241,196,15,.08);border:1px solid rgba(241,196,15,.25);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-size:11px;color:#f1c40f;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px">đźŽŻ TwĂłj aktualny status</div>
      <div style="font-size:14px;color:#fff;margin-bottom:4px">Prestige <b style="color:#f1c40f">${rank}</b> ${rank>0?'â…'.repeat(Math.min(rank,5)):''}</div>
      ${currentPct>0?`<div style="font-size:13px;color:#27ae60;margin-bottom:4px">âś“ Permanentny bonus: <b>+${currentPct}% wszystkich zarobkĂłw</b></div>`:'<div style="font-size:12px;color:#778">Brak aktywnego bonusu â€” wykonaj pierwsze Prestige</div>'}
    </div>
    <div style="background:#0a0a14;border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-size:12px;color:#7ec8e3;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px">đź“– Co to znaczy?</div>
      <div style="font-size:14px;color:#fff;line-height:1.65">
        Po osiÄ…gniÄ™ciu wysokiego poziomu w grze (15+) i zebraniu fanĂłw (100k+) moĹĽesz "WejĹ›Ä‡ w Prestige" â€” gra resetuje Ci poziom do 1 w zamian za <b style="color:#f1c40f">permanentne bonusy</b>. To system endgame loop â€” pozwala grindowaÄ‡ ten sam Ĺ›wiat wielokrotnie, za kaĹĽdym razem silniejszym.
      </div>
    </div>
    <!-- v2.1.79 Amper: czcionki zwiÄ™kszone z 10/11px â†’ 12/13px, kolor #dde â†’ #fff dla lepszego kontrastu (wczeĹ›niej nieostre, wyglÄ…daĹ‚y na sĹ‚abÄ… jakoĹ›Ä‡). -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
      <div style="background:rgba(39,174,96,.08);border:1px solid rgba(39,174,96,.3);border-radius:8px;padding:12px">
        <div style="font-size:12px;color:#27ae60;font-weight:800;letter-spacing:1px;margin-bottom:8px">âś“ ZOSTAJE</div>
        <div style="font-size:13px;color:#fff;line-height:1.7">đź’° CaĹ‚a kasa<br>đźŽ¤ Wszyscy fani<br>đźŹ† Achievements<br>đźŽŻ Punkty umiejÄ™tnoĹ›ci<br>đźŹ  Mieszkania, auta<br>đź’Ž Outfity, drip<br>đźŽĽ SprzÄ™t muzyczny<br>đźŽ¤ Drzewko rapera</div>
      </div>
      <div style="background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.3);border-radius:8px;padding:12px">
        <div style="font-size:12px;color:#e74c3c;font-weight:800;letter-spacing:1px;margin-bottom:8px">âś— RESETUJE SIÄ</div>
        <div style="font-size:13px;color:#fff;line-height:1.7">â­ Poziom postaci â†’ 1<br>đź“ XP â†’ 0<br>đź´ NiedobĂłr snu â†’ 0<br><br>(reszta zostaje nietkniÄ™ta)</div>
      </div>
    </div>
    <div style="background:#0a0a14;border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-size:11px;color:#9b59b6;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px">đźŽ Nagrody za Prestige ${nextRank}</div>
      <div style="display:flex;flex-direction:column;gap:5px;font-size:13px;color:#dde">
        <div>đź’° Jednorazowo: <b style="color:#f1c40f">+${nextReward.toLocaleString('pl')} zĹ‚</b></div>
        <div>đźŽ¤ Jednorazowo: <b style="color:#e91e8c">+${nextFanBonus.toLocaleString('pl')} fanĂłw</b></div>
        <div>đźŽŻ Jednorazowo: <b style="color:#3498db">+${nextSkill} pkt umiejÄ™tnoĹ›ci</b></div>
        <div>đźŚź Jednorazowo: <b style="color:#f1c40f">+10 sĹ‚awy</b></div>
        <div style="border-top:1px solid #2a3a4a;padding-top:6px;margin-top:4px">â­ <b style="color:#27ae60">Permanentnie</b>: +${nextRank*5}% wszystkich zarobkĂłw, +${nextRank*3}% sĹ‚awy/zarobkĂłw</div>
        <div>đźŹ† ZĹ‚ota gwiazdka â… obok nicka na HUD</div>
      </div>
    </div>
    <div style="background:rgba(231,76,60,.05);border:1px solid rgba(231,76,60,.25);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-size:11px;color:#e74c3c;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px">đźŽŻ Wymogi Prestige ${nextRank}</div>
      <div style="display:flex;flex-direction:column;gap:6px;font-size:13px">
        <div style="display:flex;justify-content:space-between"><span>â­ Poziom postaci</span><span style="color:${lvlOk?'#27ae60':'#e74c3c'};font-weight:700">${G.level} / ${reqs.level} ${lvlOk?'âś“':'âś—'}</span></div>
        <div style="display:flex;justify-content:space-between"><span>đźŽ¤ Fani</span><span style="color:${fansOk?'#27ae60':'#e74c3c'};font-weight:700">${(G.fans||0).toLocaleString('pl')} / ${reqs.fans.toLocaleString('pl')} ${fansOk?'âś“':'âś—'}</span></div>
      </div>
      <div style="font-size:10px;color:#778;margin-top:8px;font-style:italic">Wymogi rosnÄ… z kaĹĽdym poziomem prestige (lvl: +3, fani: Ă—2)</div>
    </div>
    <div style="display:flex;gap:8px">
      <button class="cbtn" style="flex:1;${lvlOk&&fansOk?'background:linear-gradient(135deg,#c8a520,#f1c40f);border-color:#f1c40f;color:#000;font-weight:900':''}" ${lvlOk&&fansOk?'':'disabled'} onclick="document.getElementById('prestige-info-modal')?.remove();doPrestige()">${lvlOk&&fansOk?'â­ WejdĹş w Prestige '+nextRank+' â†’':'đź”’ Wymogi niespeĹ‚nione'}</button>
      <button class="cbtn" style="flex:0 0 100px" onclick="document.getElementById('prestige-info-modal')?.remove()">Zamknij</button>
    </div>
  </div>`;
  document.body.appendChild(m);
};
window.collectRoyalties=(platform)=>{
  const p=G[platform];const amount=p.royalties;
  if(amount<=0){notify('Brak tantiem.');return;}
  /* v2.1.96: Prestige moneyMult przez earn() (K4 bypass fix) */
  if(typeof earn==='function') earn(amount,false); else {G.money+=amount;G.totalEarned=(G.totalEarned||0)+amount;}
  p.royalties=0;
  notify(`đź’° Zebrano ${amount} zĹ‚ z ${platform}`);renderPhoneApp(platform);
};
// Max liczba RĂ“WNOCZEĹšNIE aktywnych inwestycji (anti-spam)
const BANK_INVEST_MAX=3;
window.invest=(amount,days,pct)=>{
  if(!G.bank.investments) G.bank.investments=[];
  if(G.bank.investments.length>=BANK_INVEST_MAX){
    notify(`đź“ Limit aktywnych inwestycji: ${BANK_INVEST_MAX}. Poczekaj na zwrot lub zamknij ktĂłrÄ…Ĺ›.`);
    return;
  }
  if(G.money<amount){notify('Za maĹ‚o pieniÄ™dzy!');return;}
  G.money-=amount;
  const returnAmount=Math.floor(amount*(1+pct/100));
  G.bank.investments.push({amount,returnAmount,returnDay:G.day+days});
  notify(`đź“ Zainwestowano ${amount.toLocaleString('pl')} zĹ‚ â†’ zwrot ${returnAmount.toLocaleString('pl')} zĹ‚ za ${days} dni`);
  renderPhoneApp('bank');
};
window.takeLoan=()=>{
  if(G.bank.loan>0) return;
  G.money+=1000;G.bank.loan=1200;
  G._loansTaken=(G._loansTaken||0)+1; // tracker dla osiÄ…gniÄ™cia "PoĹĽyczka"
  notify('đź’ł Kredyt 1000 zĹ‚. Start: 1200 zĹ‚ do spĹ‚aty + 1% dziennie odsetek');renderPhoneApp('bank'); /* v2.1.133: opis transparency */
};
window.repayLoan=()=>{
  if(G.bank.loan<=0||G.money<1) return;
  // v1.9.10: BUG FIX â€” nie zapĹ‚aÄ‡ wiÄ™cej niĹĽ wynosi resztka dĹ‚ugu. WczeĹ›niej 100 zĹ‚ "przepadaĹ‚o" jeĹ›li loan byĹ‚ mniejszy.
  const pay=Math.min(100,G.bank.loan,G.money);
  G.money-=pay;G.bank.loan=Math.max(0,G.bank.loan-pay);
  notify('đź’ł SpĹ‚acono '+pay+' zĹ‚. PozostaĹ‚o: '+G.bank.loan+' zĹ‚');renderPhoneApp('bank');
};

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  POWIADOMIENIA
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function addNotif(text){
  // v1.8.50: dedup window â€” jeĹ›li ostatnia notyfikacja ma ten sam tekst i wystawiona ostatnio (3 ostatnie wpisy), pomiĹ„
  const _last=G.notifications.length>0?G.notifications.slice(-3):[];
  if(_last.some(n=>n.text===text)) return; // skip duplicate
  G.notifications.push({text,time:'Dz.'+G.day+' '+CFG.PORA[G.timeOfDay]});
  if(G.notifications.length>100) G.notifications.shift();
  /* v2.1.182 (Agent phone audit): increment unread counter â€” renderPhoneNotifs resetuje. */
  G.notifsUnread=(G.notifsUnread||0)+1;
  /* v1.9.96: NO sfx w trakcie cinematic â€” dodaj do log, ale bez dĹşwiÄ™ku */
  if(G._cinematicActive) return;
  sfxPhone();
  const _hp=document.getElementById('hphone'); if(_hp) _hp.classList.add('has-new');
}
function notify(text){showMsg(text);addNotif(text);}

// Help panel â€” F1 lub ? (Shift+/) otwiera/zamyka. ĹšciÄ…gawka skrĂłtĂłw + tipy.
function openHelpPanel(){
  document.getElementById('help-panel')?.remove();
  const el=document.createElement('div');
  el.id='help-panel';
  el.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(135deg,#0a0a1a,#0a1525);border:2px solid #7ec8e3;border-radius:14px;padding:24px 32px;max-width:560px;width:520px;z-index:250;box-shadow:0 0 60px rgba(126,200,227,.4);color:#fff;font-family:inherit;max-height:80vh;overflow-y:auto';
  el.innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <div style="font-size:22px;color:#7ec8e3;font-weight:900">âť“ Pomoc â€” SkrĂłty i wskazĂłwki</div>
      <button onclick="closeHelpPanel()" style="background:transparent;border:1px solid #2a4a6a;color:#aaa;width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:16px">âś•</button>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:13px;color:#ccc">
      <div>
        <div style="color:#f1c40f;font-weight:700;margin-bottom:6px">âŚ¨ď¸Ź Sterowanie</div>
        <div style="line-height:1.8">
          <kbd>WASD</kbd>/<kbd>â†‘â†“â†â†’</kbd> â€” ruch<br>
          <kbd>E</kbd> â€” interakcja<br>
          <kbd>P</kbd> â€” telefon<br>
          <kbd>M</kbd> â€” mapa<br>
          <kbd>Ctrl+S</kbd> â€” szybki zapis<br>
          <kbd>Esc</kbd> â€” pauza/zamknij<br>
          <kbd>F1</kbd>/<kbd>?</kbd> â€” ta pomoc
        </div>
      </div>
      <div>
        <div style="color:#27ae60;font-weight:700;margin-bottom:6px">đźŽŻ Pierwsze kroki</div>
        <div style="line-height:1.7">
          â€˘ IdĹş do <b>Wiktora</b> po dzienne zlecenie<br>
          â€˘ Pracuj w <b>Pizzerii/Kurierze/Myjni</b><br>
          â€˘ Kup mikrofon w <b>Sklepie muzycznym</b><br>
          â€˘ Wbij <b>poziom 2</b> aby otworzyÄ‡ kariery<br>
          â€˘ SprawdĹş <b>đź“± Telefon</b> â€” bank, kontrakty, social
        </div>
      </div>
    </div>
    <div style="margin-top:16px;padding-top:14px;border-top:1px solid #1a2a3a;font-size:13px;color:#ccc">
      <div style="color:#e91e8c;font-weight:700;margin-bottom:6px">đź’ˇ Tipy zaawansowane</div>
      <div style="line-height:1.7">
        â€˘ <b>Streak</b>: graj codziennie w real-time â†’ bonus +20% do zarobkĂłw<br>
        â€˘ <b>Domowe gotowanie</b> na pĹ‚ycie indukcyjnej > kupne (wiÄ™ksze bonusy)<br>
        â€˘ <b>Forma</b> (siĹ‚a) na Ĺ‚awce/wyciÄ…gu, <b>Kondycja</b> (cardio) na bieĹĽni<br>
        â€˘ <b>Manager Kamil</b> +20% do wszystkich zarobkĂłw (1000 zĹ‚)<br>
        â€˘ <b>Spanie</b> w mieszkaniu â€” Premium/Lux daje bonus regeneracji
      </div>
    </div>
    <div style="text-align:center;margin-top:16px"><button onclick="closeHelpPanel()" style="background:#0a3a5a;border:1px solid #7ec8e3;color:#7ec8e3;padding:10px 24px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700">â–¶ Wracam do gry</button></div>
  `;
  document.body.appendChild(el);
}
function closeHelpPanel(){document.getElementById('help-panel')?.remove();}
window.openHelpPanel=openHelpPanel;window.closeHelpPanel=closeHelpPanel;

// WyraĹşny powitalny popup centered (NIE showMsg ktĂłry ucieka po 3.5s).
// Auto-dismiss po 8s. Klik na backdrop, ESC lub "Zaczynaj" zamyka wczeĹ›niej.
// â”€â”€ In-game zamienniki dla browser confirm()/alert() â”€â”€
// gameConfirm(msg, onYes [, onNo]) â€” modal "Tak/Nie" w stylu gry
// gameAlert(msg, onOk?) â€” modal "OK" pojedynczy
window.gameConfirm=function(msg,onYes,onNo){
  document.getElementById('game-modal')?.remove();
  document.getElementById('game-modal-bd')?.remove();
  const bd=document.createElement('div');
  bd.id='game-modal-bd';
  bd.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.55);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);z-index:300;animation:bdFadeIn .2s ease-out';
  document.body.appendChild(bd);
  const m=document.createElement('div');
  m.id='game-modal';
  m.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(135deg,#0a0a1a,#1a0a2a);border:2px solid #f1c40f;border-radius:14px;padding:26px 34px;max-width:540px;z-index:301;box-shadow:0 0 60px rgba(241,196,15,.5);color:#fff;font-family:inherit;text-align:center;animation:welcomeIn .3s ease-out';
  m.innerHTML=`
    <div style="font-size:14px;color:#ddd;line-height:1.55;margin-bottom:20px;white-space:pre-line">${msg}</div>
    <div style="display:flex;gap:14px;justify-content:center">
      <button id="gm-yes" style="background:linear-gradient(135deg,#0a3a1a,#1a4a2a);border:2px solid #27ae60;color:#7ec87e;padding:10px 26px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700">âś“ Tak</button>
      <button id="gm-no"  style="background:linear-gradient(135deg,#3a0a0a,#4a1a1a);border:2px solid #e74c3c;color:#e07070;padding:10px 26px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700">âś— Nie</button>
    </div>`;
  document.body.appendChild(m);
  /* v1.9.20: BUG FIX â€” double-fire guard. Rapid double-click "Tak" wczeĹ›niej wykonywaĹ‚ onYes() 2Ă— â†’ duplicate state mutations (np. double-delete save, double-charge G.money). */
  let _fired=false;
  const close=()=>{if(_fired)return false;_fired=true;m.remove();bd.remove();document.removeEventListener('keydown',escH);return true;};
  const escH=e=>{if(e.key==='Escape'){if(close())if(onNo)onNo();}};
  document.addEventListener('keydown',escH);
  m.querySelector('#gm-yes').onclick=()=>{if(close())if(onYes)onYes();};
  m.querySelector('#gm-no').onclick=()=>{if(close())if(onNo)onNo();};
  bd.onclick=()=>{if(close())if(onNo)onNo();};
};
window.gameAlert=function(msg,onOk){
  document.getElementById('game-modal')?.remove();
  document.getElementById('game-modal-bd')?.remove();
  const bd=document.createElement('div');
  bd.id='game-modal-bd';
  bd.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.55);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);z-index:300;animation:bdFadeIn .2s ease-out';
  document.body.appendChild(bd);
  const m=document.createElement('div');
  m.id='game-modal';
  m.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(135deg,#0a0a1a,#1a0a2a);border:2px solid #3498db;border-radius:14px;padding:24px 32px;max-width:520px;z-index:301;box-shadow:0 0 60px rgba(52,152,219,.5);color:#fff;font-family:inherit;text-align:center;animation:welcomeIn .3s ease-out';
  m.innerHTML=`
    <div style="font-size:14px;color:#ddd;line-height:1.55;margin-bottom:18px;white-space:pre-line">${msg}</div>
    <button id="gm-ok" style="background:linear-gradient(135deg,#0a2a4a,#1a3a5a);border:2px solid #3498db;color:#7ec8e3;padding:10px 30px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700">OK</button>`;
  document.body.appendChild(m);
  /* v1.9.20: gameAlert teĹĽ double-fire guard */
  let _fired=false;
  const close=()=>{if(_fired)return false;_fired=true;m.remove();bd.remove();document.removeEventListener('keydown',keyH);return true;};
  const keyH=e=>{if(e.key==='Escape'||e.key==='Enter'){if(close())if(onOk)onOk();}};
  document.addEventListener('keydown',keyH);
  m.querySelector('#gm-ok').onclick=()=>{if(close())if(onOk)onOk();};
  bd.onclick=()=>{if(close())if(onOk)onOk();};
};

// #53 Cinematic intro przy nowej grze â€” 4.5s spektakularnego intro przed welcome popup
function showIntroCinematic(name,onDone){
  document.getElementById('intro-cinematic')?.remove();
  const ov=document.createElement('div');
  ov.id='intro-cinematic';
  ov.style.cssText='position:fixed;top:0;left:0;width:100vw;height:100vh;background:#000;z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#fff;font-family:inherit;overflow:hidden';
  // Animowane tĹ‚o â€” gradient + particles
  ov.innerHTML=`
    <div id="ic-bg" style="position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(circle at 50% 50%, rgba(241,196,15,.15), rgba(0,0,0,1) 70%);opacity:0;transition:opacity 1s ease-out"></div>
    <div id="ic-particles" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:hidden"></div>
    <div id="ic-stage" style="position:relative;text-align:center;z-index:2">
      <!-- STAGE 1: Logo "TRAP SIMULATOR" -->
      <div id="ic-logo" style="font-family:'Russo One','Orbitron',Impact,sans-serif;font-size:88px;font-weight:900;letter-spacing:6px;background:linear-gradient(135deg,#f1c40f,#e91e8c,#9b59b6);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 60px rgba(241,196,15,.5);opacity:0;transform:scale(.5);transition:opacity .8s ease-out,transform 1.2s cubic-bezier(.34,1.56,.64,1)">TRAP<br><span style="font-size:0.7em;letter-spacing:14px;color:transparent;-webkit-text-stroke:2px #f1c40f">SIMULATOR</span></div>
      <div id="ic-tagline" style="font-size:14px;color:#7ec8e3;letter-spacing:6px;margin-top:14px;opacity:0;transition:opacity .6s">TWOJA DROGA NA SZCZYT</div>
      <!-- STAGE 2: Witaj [name] -->
      <div id="ic-greet" style="font-size:42px;font-weight:900;color:#fff;margin-top:50px;opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s">Witaj, <span style="color:#f1c40f">${name}</span></div>
      <!-- STAGE 3: Tagline drogi -->
      <div id="ic-quote" style="font-size:18px;color:#aac;margin-top:20px;font-style:italic;opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s">Twoja droga do sĹ‚awy zaczyna siÄ™ <strong style="color:#e91e8c">TERAZ</strong></div>
    </div>
    <button id="ic-skip" style="position:absolute;bottom:30px;right:30px;background:transparent;border:1px solid #555;color:#778;padding:8px 16px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px;letter-spacing:2px;opacity:.6;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.6">POMIĹ â–şâ–ş</button>
  `;
  document.body.appendChild(ov);
  // Particle stars w tle
  const partCt=document.getElementById('ic-particles');
  for(let i=0;i<40;i++){
    const star=document.createElement('div');
    const s=Math.random()*3+1;
    star.style.cssText=`position:absolute;width:${s}px;height:${s}px;background:rgba(241,196,15,${Math.random()*.6+.3});border-radius:50%;left:${Math.random()*100}%;top:${Math.random()*100}%;animation:icStarTwinkle ${2+Math.random()*3}s ease-in-out infinite ${Math.random()*2}s`;
    partCt.appendChild(star);
  }
  if(!document.getElementById('ic-anim-style')){
    const s=document.createElement('style');s.id='ic-anim-style';
    s.textContent='@keyframes icStarTwinkle{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}';
    document.head.appendChild(s);
  }
  let skipped=false;
  const finish=()=>{
    if(skipped) return;skipped=true;
    ov.style.transition='opacity .5s';ov.style.opacity='0';
    setTimeout(()=>{ov.remove();if(typeof onDone==='function')onDone();},500);
  };
  document.getElementById('ic-skip').onclick=finish;
  // STAGE 1: 0-1.5s â€” logo fade-in + bg
  // v1.8.74: null-safe â€” gdy gracz kliknie "Skip", overlay znika a opĂłĹşnione setTimeout'y
  // wczeĹ›niej crashowaĹ‚y prĂłbujÄ…c animowaÄ‡ nieistniejÄ…ce juĹĽ elementy.
  setTimeout(()=>{
    const bg=document.getElementById('ic-bg'),logo=document.getElementById('ic-logo');
    if(bg)bg.style.opacity='1';
    if(logo){logo.style.opacity='1';logo.style.transform='scale(1)';}
  },200);
  setTimeout(()=>{const el=document.getElementById('ic-tagline');if(el)el.style.opacity='1';},900);
  // STAGE 2: 1.8s â€” Witaj name
  setTimeout(()=>{
    const el=document.getElementById('ic-greet');
    if(el){el.style.opacity='1';el.style.transform='translateY(0)';}
  },1800);
  // STAGE 3: 2.8s â€” quote
  setTimeout(()=>{
    const el=document.getElementById('ic-quote');
    if(el){el.style.opacity='1';el.style.transform='translateY(0)';}
  },2800);
  // Auto-close 4.5s
  setTimeout(finish,4500);
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MILESTONE CINEMATIC â€” reusable dramatic overlay dla waĹĽnych momentĂłw
// (zakup auta/mieszkania/studio, level up, pierwszy koncert/album, fan milestones)
// UĹĽywa estetyki intro-cinematic ale z moĹĽliwoĹ›ciÄ… konfiguracji koloru/tytuĹ‚u/tagline
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function showMilestoneCinematic(opts){
  /* v1.9.24: skip cinematic podczas snu (poprzednio milestone wpadaĹ‚ na z-index nad sleep overlay) */
  if(document.getElementById('sleep-overlay')?.classList.contains('on')) return;
  // opts: {emoji, title, subtitle, tagline, accentColor, accent2, duration, onDone}
  const o=Object.assign({
    emoji:'â­',title:'OSIÄ„GNIÄCIE',subtitle:'',tagline:'',
    accentColor:'#f1c40f',accent2:'#e91e8c',duration:3500,onDone:null
  },opts||{});
  // Defensywnie usun WSZYSTKIE istniejace instancje (na wypadek duplikatow)
  document.querySelectorAll('#milestone-cinematic').forEach(el=>el.remove());
  const ov=document.createElement('div');
  ov.id='milestone-cinematic';
  ov.style.cssText='position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,.85);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:9998;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#fff;font-family:inherit;overflow:hidden;cursor:pointer';
  ov.innerHTML=`
    <div id="ms-bg" style="position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(circle at 50% 50%, ${o.accentColor}22, rgba(0,0,0,1) 70%);opacity:0;transition:opacity .8s ease-out"></div>
    <div id="ms-particles" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:hidden"></div>
    <div id="ms-stage" style="position:relative;text-align:center;z-index:2;padding:0 40px">
      <div id="ms-emoji" style="font-size:120px;line-height:1;margin-bottom:18px;opacity:0;transform:scale(.3) rotate(-30deg);transition:opacity .5s,transform .8s cubic-bezier(.34,1.56,.64,1);text-shadow:0 0 40px ${o.accentColor},0 0 80px ${o.accent2}aa">${o.emoji}</div>
      <div id="ms-title" style="font-family:'Russo One','Orbitron',Impact,sans-serif;font-size:54px;font-weight:900;letter-spacing:5px;background:linear-gradient(135deg,${o.accentColor},${o.accent2});-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 50px ${o.accentColor}80;opacity:0;transform:translateY(30px);transition:opacity .6s,transform .6s ease-out">${o.title}</div>
      ${o.subtitle?`<div id="ms-sub" style="font-size:24px;font-weight:700;color:#fff;margin-top:16px;opacity:0;transform:translateY(20px);transition:opacity .5s,transform .5s">${o.subtitle}</div>`:''}
      ${o.tagline?`<div id="ms-tag" style="font-size:14px;color:#aac;margin-top:14px;font-style:italic;opacity:0;transform:translateY(20px);transition:opacity .5s,transform .5s;letter-spacing:1px">${o.tagline}</div>`:''}
    </div>
    <button id="ms-skip" style="position:absolute;bottom:24px;right:24px;background:transparent;border:1px solid #555;color:#778;padding:6px 14px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:10px;letter-spacing:2px;opacity:.5;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.5">POMIĹ â–ş</button>
  `;
  document.body.appendChild(ov);
  // Particles â€” confetti-style streaming z dolnej czÄ™Ĺ›ci
  const partCt=document.getElementById('ms-particles');
  for(let i=0;i<60;i++){
    const p=document.createElement('div');
    const colors=[o.accentColor,o.accent2,'#fff','#7ec8e3'];
    const col=colors[Math.floor(Math.random()*colors.length)];
    const s=2+Math.random()*4;
    p.style.cssText=`position:absolute;width:${s}px;height:${s}px;background:${col};border-radius:${Math.random()<.5?'50%':'2px'};left:${Math.random()*100}%;bottom:-20px;opacity:${.5+Math.random()*.5};animation:msConfetti ${1.5+Math.random()*2}s ease-out ${Math.random()*1.5}s forwards;box-shadow:0 0 6px ${col}88`;
    partCt.appendChild(p);
  }
  if(!document.getElementById('ms-anim-style')){
    const s=document.createElement('style');s.id='ms-anim-style';
    s.textContent=`@keyframes msConfetti{0%{transform:translateY(0) rotate(0deg);opacity:1}100%{transform:translateY(-${window.innerHeight+100}px) rotate(720deg);opacity:0}}`;
    document.head.appendChild(s);
  }
  let closed=false;
  const finish=()=>{
    if(closed) return;closed=true;
    try { ov.style.transition='opacity .4s';ov.style.opacity='0'; } catch(e) {}
    setTimeout(()=>{
      try { ov.remove(); } catch(e) {}
      // Defensywnie usun wszystkie ewentualne pozostale instancje
      try { document.querySelectorAll('#milestone-cinematic').forEach(el=>el.remove()); } catch(e) {}
      if(typeof o.onDone==='function') {
        try { o.onDone(); } catch(e) { console.error('milestone onDone:', e); }
      }
    },400);
  };
  // SAFETY CLEANUP: nawet jesli finish() crashuje, force remove po duration+5s
  // To gwarantuje ze element zniknie i ruch sie odblokuje (DOM-first guard)
  setTimeout(()=>{
    if(document.getElementById('milestone-cinematic')===ov){
      console.warn('milestone-cinematic safety cleanup po duration+5s');
      try { ov.remove(); } catch(e) {}
    }
  }, o.duration + 5000);
  document.getElementById('ms-skip').onclick=(e)=>{e.stopPropagation();finish();};
  ov.onclick=finish; // klik gdziekolwiek = zamknij (po pierwszym 1s)
  // SFX
  if(typeof sfxSparkle==='function') try{sfxSparkle();}catch(e){}
  // Animacje stages
  setTimeout(()=>{
    document.getElementById('ms-bg').style.opacity='1';
    const em=document.getElementById('ms-emoji');
    em.style.opacity='1';em.style.transform='scale(1) rotate(0deg)';
  },50);
  setTimeout(()=>{
    const t=document.getElementById('ms-title');
    t.style.opacity='1';t.style.transform='translateY(0)';
  },500);
  if(o.subtitle) setTimeout(()=>{
    const s=document.getElementById('ms-sub');if(s){s.style.opacity='1';s.style.transform='translateY(0)';}
  },900);
  if(o.tagline) setTimeout(()=>{
    const t=document.getElementById('ms-tag');if(t){t.style.opacity='1';t.style.transform='translateY(0)';}
  },1200);
  setTimeout(finish,o.duration);
}
window.showMilestoneCinematic=showMilestoneCinematic;

// Helper â€” Ĺ›ledzi ktĂłre milestones juĹĽ pokazane (ĹĽeby nie powtarzaĹ‚y siÄ™)
function _milestoneShown(key){
  G._milestonesShown=G._milestonesShown||{};
  if(G._milestonesShown[key]) return true;
  G._milestonesShown[key]=true;return false;
}
window._milestoneShown=_milestoneShown;

// SMS od Gym Bro â€” przy 2 dniach bez treningu (mechanika "use it or lose it")
function sendGymBroSms(){
  const messages = [
    'Bracie! Musisz wbijac na silke bo spadnie Ci pompa! đź’Ş',
    'Hej, ostatnio Cie nie widzialem na silce. Wracaj bo zniknie progress!',
    'Pamietaj â€” use it or lose it. Nie pozwol zeby forma uciekla!',
    'Hej bracie, kiedy widzimy sie na silce? Czuje ze zaraz spadnie pompa!',
  ];
  const msg = messages[Math.floor(Math.random()*messages.length)];
  G.gymBroMessages = G.gymBroMessages || [];
  G.gymBroMessages.push({day: G.day, msg: msg});
  /* v2.1.181 (Agent SMS audit): refactor â†’ uĹĽyj centralnego _smsSend zamiast manualnego push.
     Naprawia inconsistency: from:'them' â†’ from:'gymbro' (spĂłjne z _smsSend L26425),
     time intâ†’"HH:MM" string (spĂłjne z innymi SMS), bezpĹ‚atnie dostaje cap 100 + addNotif gdy phone closed.
     showMsg toast zostaje bo _smsSend addNotif TYLKO gdy phone closed â€” player powinien widzieÄ‡ notif game-wide. */
  if(typeof _smsSend==='function') _smsSend('gymbro', msg);
  if(typeof showMsg === 'function') showMsg(`đź’Ş SMS od Gym Bro: "${msg}"`,'i');
}
window.sendGymBroSms = sendGymBroSms;

// CINEMATIC SIĹOWNI #1 â€” Tutorial epicki, pierwsze wejĹ›cie, NIE auto-close
