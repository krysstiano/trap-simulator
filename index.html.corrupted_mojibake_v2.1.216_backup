    },
    {
      em:'đźŹ‹ď¸Ź', title:'ZDROWIE I FORMA',
      /* v1.9.99: USUNIÄTO fryzjera â€” to nie zdrowie tylko styl. Przeniesiony do osobnego topica niĹĽej. */
      desc:'SiĹ‚ownia (Ĺ‚awka, bieĹĽnia, wyciÄ…g â€” Forma 100 = +10 max statystyk), Szpital (leczenie po krytycznym zdrowiu, terapia podnosi nastrĂłj).',
      places:[
        {wx:1324, wy:210, label:'SIĹOWNIA', zoom:1.7},
        {wx:1974, wy:749, label:'SZPITAL', zoom:1.7},
      ],
      durPerPlace:4000,
    },
    {
      em:'đź’Ž', title:'DRIP DISTRICT â€” LUKSUS',
      /* v1.9.99: PAN SWEEP zamiast osobnych zoomĂłw per butik.
         Kamera pĹ‚ynnie przelatuje po wszystkich 8 butikach z umiarkowanym zoomem. */
      desc:'8 butikĂłw premium: Louis Vuitton, Chanel, HermĂ¨s, Gucci (gĂłra), Balenciaga, Bottega, Dior, Prada (dĂłĹ‚). Drip 0-200 daje bonusy do koncertĂłw, royalties, Instagrama.',
      places:[
        /* PĹ‚ynny przelot â€” start nad pierwszym, koniec nad ostatnim â€” kamera "pan" */
        {wx:2596, wy:2706, label:'GĂ“RNY RZÄ„D (LV â†’ GUCCI)', zoom:1.25},
        {wx:3244, wy:2706, label:'GĂ“RNY RZÄ„D (LV â†’ GUCCI)', zoom:1.25},
        {wx:3244, wy:3245, label:'DOLNY RZÄ„D (BALENCIAGA â†’ PRADA)', zoom:1.25},
        {wx:2596, wy:3245, label:'DOLNY RZÄ„D (BALENCIAGA â†’ PRADA)', zoom:1.25},
        {wx:2920, wy:2975, label:'CAĹA DZIELNICA â€” 8 BUTIKĂ“W', zoom:1.05},
      ],
      durPerPlace:3500,
      panSweep:true, /* v1.9.99: dripie jeden ciÄ…gĹ‚y pan zamiast osobnych zoomĂłw */
    },
    {
      em:'đźŽ°', title:'KASYNO ROYAL',
      desc:'Parter: Sloty, Ruletka, Blackjack, War, KoĹ‚o Fortuny, Daily Wheel (darmowy spin). 1 piÄ™tro VIP po wygraniu Ĺ‚Ä…cznie 10 000 zĹ‚: Baccarat, Craps, Poker, Keno, Plinko, High-Roller Sloty.',
      places:[
        {wx:3837, wy:749, label:'KASYNO ROYAL', zoom:1.6},
      ],
      durPerPlace:6000,
    },
    {
      em:'âś‚ď¸Ź', title:'STYL I ROZRYWKA',
      /* v1.9.99: nowy topic dla fryzjera + park */
      desc:'Fryzjer (zmiana fryzury â€” wpĹ‚ywa na atrakcjonalnoĹ›Ä‡ u NPC), Park Miejski (chill, freestyle, bboying, skatepark, staw â€” boost nastroju).',
      places:[
        {wx:505, wy:749, label:'FRYZJER', zoom:1.7},
        {wx:384, wy:1032, label:'PARK MIEJSKI', zoom:1.3},
      ],
      durPerPlace:4000,
    },
    {
      em:'đźš', title:'TRANSPORT I MOBILNOĹšÄ†',
      desc:'Salon Aut (kup samochĂłd = szybsze podrĂłĹĽe), Parking miejski, Helipad VIP (transport prywatnym Ĺ›migĹ‚owcem dla bogatych graczy).',
      places:[
        {wx:3084, wy:210, label:'SALON AUT', zoom:1.6},
        {wx:1584, wy:1620, label:'PARKING', zoom:1.2},
        {wx:2070, wy:3470, label:'HELIPAD VIP', zoom:1.5},
      ],
      durPerPlace:3500,
    },
    {
      em:'đźŽ®', title:'WYBIERZ SWOJÄ„ ĹšCIEĹ»KÄ',
      desc:'Wiele Ĺ›cieĹĽek kariery: rap, beatmaker, YouTuber, streamer, influencer, realizator dĹşwiÄ™ku, biznes, label. KaĹĽda z wĹ‚asnym drzewkiem skilli. WybĂłr naleĹĽy do Ciebie!',
      places:[
        {wx:2000, wy:1600, label:'MIASTO', zoom:1.0},
      ],
      durPerPlace:6000,
    },
  ];
  /* SpĹ‚aszczona lista shots â€” kaĹĽdy item = jeden cel kamery */
  const SHOTS=[];
  TOPICS.forEach((topic, topicIdx)=>{
    topic.places.forEach((place, placeIdx)=>{
      SHOTS.push({
        topicIdx, placeIdx,
        em:topic.em,
        title:topic.title,
        desc:topic.desc,
        placeLabel: place.label,
        placeCount: topic.places.length,
        wx:place.wx, wy:place.wy,
        zoom:place.zoom||1.5,
        dur:topic.durPerPlace||3500,
        panSweep:!!topic.panSweep, /* v1.9.99: ciÄ…gĹ‚y pan zamiast osobnych zoom-in */
        isLastInTopic: placeIdx === topic.places.length-1,
        isFirstInTopic: placeIdx === 0,
      });
    });
  });
  let shotIdx=0;
  let _hlAnimRaf=null;
  /* v2.1.21: manual control strzaĹ‚kami â€” wyĹ‚Ä…cz auto-advance, gracz sam przechodzi po krokach. */
  let _autoAdvanceTimer=null;
  let _shotTransitioning=false;
  const _animateHighlight=(targetOpacity, dur)=>{
    if(_hlAnimRaf){cancelAnimationFrame(_hlAnimRaf);_hlAnimRaf=null;}
    const startO = window._cinemCam.hlOpacity||0;
    const t0 = Date.now();
    const step=()=>{
      const t = Math.min(1, (Date.now()-t0)/dur);
      const e = t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2;
      window._cinemCam.hlOpacity = startO + (targetOpacity - startO) * e;
      if(t<1) _hlAnimRaf = requestAnimationFrame(step);
      else _hlAnimRaf=null;
    };
    _hlAnimRaf = requestAnimationFrame(step);
  };
  /* v2.1.199: tracker zmiany topica â€” wczeĹ›niej `s.isFirstInTopic` byĹ‚o uĹĽywane jako sygnaĹ‚ "nowy topic". ALE gdy gracz cofa siÄ™ strzaĹ‚kÄ… w lewo z pierwszego place nowego topica do ostatniego place poprzedniego topica, `isFirstInTopic=false` â†’ overlay NIE updateowaĹ‚ tytuĹ‚u/opisu. User feedback: "przeszedĹ‚em na Zdrowie i Forma, cofnÄ…Ĺ‚em â†, w okienku dalej Zdrowie i Forma". Fix: porĂłwnuj topicIdx z ostatnim renderowanym, NIE uĹĽywaj isFirstInTopic. */
  let _lastRenderedTopicIdx = -1;
  const _showOverlay=(s)=>{
    let o=document.getElementById('cinem-overlay');
    const isNew=!o;
    const isTopicChange = s.topicIdx !== _lastRenderedTopicIdx;
    if(isNew){
      o=document.createElement('div');
      o.id='cinem-overlay';
      o.style.cssText='position:fixed;left:50%;bottom:60px;transform:translateX(-50%) translateY(40px) scale(.92);background:linear-gradient(135deg,rgba(10,10,30,.96),rgba(20,10,40,.96));border:2px solid #c8a520;border-radius:14px;padding:22px 36px;max-width:720px;text-align:center;z-index:9997;box-shadow:0 12px 48px rgba(0,0,0,.7),0 0 40px rgba(200,165,32,.5);opacity:0;transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1)';
      document.body.appendChild(o);
    } else if(isTopicChange){
      o.style.opacity='0';
      o.style.transform='translateX(-50%) translateY(20px) scale(.96)';
    }
    const renderHTML=()=>{
      o.innerHTML=`
        <div style="font-size:62px;margin-bottom:10px;animation:emojiFloat 2s ease-in-out infinite;text-shadow:0 0 30px rgba(200,165,32,.7)">${s.em}</div>
        <h2 style="color:#c8a520;font-size:26px;letter-spacing:3px;margin:0 0 8px;text-shadow:0 0 20px rgba(200,165,32,.6)">${s.title}</h2>
        <div id="cinem-place-label" style="color:#fff;font-size:14px;font-weight:700;margin-bottom:10px;letter-spacing:2px;background:rgba(200,165,32,.18);display:inline-block;padding:4px 14px;border-radius:14px;border:1px solid rgba(200,165,32,.4);transition:opacity .3s">đź“Ť ${s.placeLabel} <span style="opacity:.6;font-weight:400">(${s.placeIdx+1}/${s.placeCount})</span></div>
        <div style="color:#e8e8f0;font-size:14px;line-height:1.65">${s.desc}</div>
        <div style="margin-top:12px;color:#778;font-size:11px;letter-spacing:1px">Topic ${s.topicIdx+1}/${TOPICS.length}</div>`;
    };
    if(isTopicChange){
      setTimeout(()=>{
        renderHTML();
        requestAnimationFrame(()=>{
          o.style.opacity='1';
          o.style.transform='translateX(-50%) translateY(0) scale(1)';
        });
      }, isNew ? 50 : 350);
    } else {
      const lbl=document.getElementById('cinem-place-label');
      if(lbl){
        lbl.style.opacity='0';
        setTimeout(()=>{
          lbl.innerHTML=`đź“Ť ${s.placeLabel} <span style="opacity:.6;font-weight:400">(${s.placeIdx+1}/${s.placeCount})</span>`;
          lbl.style.opacity='1';
        }, 300);
      } else {
        renderHTML();
      }
    }
    _lastRenderedTopicIdx = s.topicIdx;
  };
  const _next=()=>{
    if(!G._cinematicActive) return;
    if(shotIdx>=SHOTS.length){window._closeCinematic();return;}
    const s=SHOTS[shotIdx];
    /* v1.9.99: PAN SWEEP topic = ciÄ…gĹ‚y gĹ‚adki ruch z lerpMul=0.6 i utrzymaniem zoom miÄ™dzy places.
       Normal topic = leÄ‡ szeroko (zoom 1.05) â†’ zoom in (zoom z place) + highlight. */
    /* v2.1.9: target BEZ Math.max(0,...) â€” clamp robi updateCamera z zoom-aware bounds.
       WczeĹ›niej Math.max(0, ...) odcinaĹ‚o ujemne target dla budynkĂłw blisko lewego/gĂłrnego brzegu mapy
       (TRAPHOUSE wx:170 wymaga cam.x=-470, STUDIO wy:210 wymaga cam.y=-119 etc.). */
    window._cinemCam.targetX=s.wx-640;
    window._cinemCam.targetY=s.wy-329;
    if(s.panSweep){
      /* PAN: utrzymaj zoom z first place przez caĹ‚y topic, ciÄ…gĹ‚y ruch BEZ przerw highlight */
      window._cinemCam.lerpMul = 0.6; /* WOLNIEJSZE = bardziej "filmowo" */
      window._cinemCam.targetZoom = s.zoom||1.25;
      /* Highlight tylko przy first place, potem ciÄ…gĹ‚y bez podĹ›wietlenia (panoramic feel) */
      if(s.isFirstInTopic){
        _animateHighlight(0, 250);
        setTimeout(()=>{
          if(!G._cinematicActive) return;
          window._cinemCam.highlight={wx:s.wx, wy:s.wy, r:300}; /* duĹĽe highlight area */
          _animateHighlight(0.4, 800); /* delikatne podĹ›wietlenie, nie peĹ‚ne */
        }, 900);
      } else {
        /* przesuwaj highlight razem z kamerÄ… */
        window._cinemCam.highlight={wx:s.wx, wy:s.wy, r:300};
      }
    } else {
      /* v2.1.26: prawdziwy efekt PRZELOTU. Sekwencja:
         1. Zoom-OUT do 1.0 (kamera oddala siÄ™, gracz widzi miasto z lotu ptaka)
         2. Lerp camera do nowej pozycji (pĹ‚ynny "przelot" nad miastem)
         3. Po 1200ms: zoom-IN do s.zoom (kamera lÄ…duje na celu) + highlight
         User: "Kamera powinna siÄ™ oddalaÄ‡, przelatywaÄ‡ na kolejne miejsce, dopiero wtedy zoomowaÄ‡". */
      window._cinemCam.lerpMul = 1;
      window._cinemCam.targetZoom = 1.0; /* ZOOM OUT â€” szeroki widok */
      _animateHighlight(0, 300);
      window._cinemCam.highlight=null;
      setTimeout(()=>{
        if(!G._cinematicActive) return;
        /* ZOOM IN po dotarciu kamery do celu */
        window._cinemCam.targetZoom = s.zoom||1.5;
        window._cinemCam.highlight={wx:s.wx, wy:s.wy, r:Math.max(110, 140 - (s.zoom-1)*60)};
        _animateHighlight(1, 800);
      }, 1200);
    }
    _showOverlay(s);
    /* v2.1.21: MANUAL CONTROL. Auto-advance USUNIÄTY â€” gracz steruje strzaĹ‚kami â†/â†’.
       WczeĹ›niej `setTimeout(_next, s.dur)` automatycznie przeskakiwaĹ‚. */
    shotIdx++;
    _shotTransitioning=false;
  };
  /* v2.1.21: _prev() do cofania strzaĹ‚kÄ… â† */
  const _prev=()=>{
    if(!G._cinematicActive) return;
    if(_shotTransitioning) return;
    if(shotIdx<=1) return; /* juĹĽ na pierwszym shot */
    _shotTransitioning=true;
    shotIdx-=2; /* shotIdx-1 to obecny shot (juĹĽ incrementowany), shotIdx-2 to poprzedni */
    if(shotIdx<0) shotIdx=0;
    _next();
  };
  /* v2.1.21: keyboard event handler dla cinematic */
  window._cinemKeyHandler=(e)=>{
    if(!G._cinematicActive) return;
    if(e.key==='ArrowRight' || e.key==='d' || e.key==='D'){
      e.preventDefault();
      if(!_shotTransitioning && shotIdx<SHOTS.length){_shotTransitioning=true; _next();}
    } else if(e.key==='ArrowLeft' || e.key==='a' || e.key==='A'){
      e.preventDefault();
      _prev();
    } else if(e.key==='Escape'){
      e.preventDefault();
      window._closeCinematic();
    }
  };
  window.addEventListener('keydown', window._cinemKeyHandler);
  window._closeCinematic=()=>{
    G._cinematicActive=false;
    G._cinematicCompleted=true;
    document.body.classList.remove('cinematic-active'); /* v1.9.99: przywrĂłÄ‡ HUD */
    if(_hlAnimRaf){cancelAnimationFrame(_hlAnimRaf);_hlAnimRaf=null;}
    /* v2.1.21: cleanup keyboard handler */
    if(window._cinemKeyHandler){
      window.removeEventListener('keydown', window._cinemKeyHandler);
      window._cinemKeyHandler=null;
    }
    if(window._cinemCam){window._cinemCam.active=false;window._cinemCam.highlight=null;window._cinemCam.hlOpacity=0;window._cinemCam.targetZoom=1;}
    const ov=document.getElementById('cinem-overlay');
    if(ov){ov.style.opacity='0';ov.style.transform='translateX(-50%) translateY(40px) scale(.9)';setTimeout(()=>ov.remove(),600);}
    const lt=document.getElementById('cinem-letterbox-top');const lb=document.getElementById('cinem-letterbox-bot');
    if(lt){lt.style.transition='opacity .8s,height .8s';lt.style.opacity='0';lt.style.height='0';setTimeout(()=>lt.remove(),800);}
    if(lb){lb.style.transition='opacity .8s,height .8s';lb.style.opacity='0';lb.style.height='0';setTimeout(()=>lb.remove(),800);}
    document.getElementById('cinem-skipbar')?.remove();
    if(typeof _paused!=='undefined') _paused=G._introPausedBefore===true;
    delete G._introPausedBefore;
    /* WyĹ›mietl kolejkÄ™ przegapionych toastĂłw (jeĹ›li kod chciaĹ‚ coĹ› wysĹ‚aÄ‡ podczas cinematic) */
    if(window._cinemQueuedMsgs && window._cinemQueuedMsgs.length>0){
      const queued = window._cinemQueuedMsgs.slice(-3); /* max 3 ostatnie */
      window._cinemQueuedMsgs=[];
      queued.forEach((m,i)=>setTimeout(()=>showMsg(m.t,m.type,m.duration), 1100+i*4500));
    }
    if(typeof saveGameSilent==='function') saveGameSilent();
    if(typeof showMsg==='function') setTimeout(()=>showMsg('đźŽ¬ Przelot zakoĹ„czony. Powodzenia w grze!','g',5000),900);
  };
  /* Letterbox bars (czarne paski u gĂłry/doĹ‚u â€” efekt kinowy z slide-in).
     v2.1.21: 80â†’15vh + 60â†’12vh â€” ĹĽeby zakryÄ‡ HUD na kaĹĽdej skali (1080p HUD=93px, 4K=186px). */
  const lt=document.createElement('div');
  lt.id='cinem-letterbox-top';
  lt.style.cssText='position:fixed;top:-15vh;left:0;right:0;height:15vh;background:#000;z-index:9996;transition:top .9s cubic-bezier(.4,.0,.2,1)';
  const lb=document.createElement('div');
  lb.id='cinem-letterbox-bot';
  lb.style.cssText='position:fixed;bottom:-12vh;left:0;right:0;height:12vh;background:#000;z-index:9996;transition:bottom .9s cubic-bezier(.4,.0,.2,1)';
  document.body.appendChild(lt);document.body.appendChild(lb);
  requestAnimationFrame(()=>{lt.style.top='0';lb.style.bottom='0';});
  /* Skip button */
  const sk=document.createElement('div');
  sk.id='cinem-skipbar';
  sk.style.cssText='position:fixed;top:14px;right:24px;z-index:9998;opacity:0;transition:opacity .8s';
  sk.innerHTML=`
    <div style="display:flex;gap:8px;align-items:center">
      <button onclick="window._cinemPrev&&window._cinemPrev()" id="cinem-prev-btn" style="background:rgba(0,0,0,.85);color:#c8a520;border:1px solid #c8a520;padding:10px 14px;border-radius:8px;cursor:pointer;font-size:18px;font-weight:700;font-family:inherit" title="Poprzedni (â†)">â†</button>
      <div style="background:rgba(0,0,0,.6);color:#aac;padding:8px 12px;border-radius:6px;font-size:11px;letter-spacing:1px">Steruj strzaĹ‚kami â† â†’</div>
      <button onclick="window._cinemNext&&window._cinemNext()" id="cinem-next-btn" style="background:rgba(0,0,0,.85);color:#c8a520;border:1px solid #c8a520;padding:10px 14px;border-radius:8px;cursor:pointer;font-size:18px;font-weight:700;font-family:inherit" title="NastÄ™pny (â†’)">â†’</button>
      <button onclick="window._closeCinematic()" style="background:rgba(0,0,0,.85);color:#c8a520;border:1px solid #c8a520;padding:12px 20px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:700;letter-spacing:1px;font-family:inherit">PomiĹ„ przelot âś•</button>
    </div>`;
  /* v2.1.21: expose _prev/_next dla klikĂłw buttonĂłw */
  window._cinemPrev=()=>_prev();
  window._cinemNext=()=>{if(!_shotTransitioning && shotIdx<SHOTS.length){_shotTransitioning=true; _next();}};
  document.body.appendChild(sk);
  setTimeout(()=>{sk.style.opacity='1';},400);
  setTimeout(_next,900); /* delay 900ms na letterbox slide-in */
};

window.openIntroduction=()=>{
  /* v1.9.82/v1.9.84: pause game time + zachowaj poprzedni stan _paused (audyt) */
  G._introductionActive=true;
  G._introPausedBefore=(typeof _paused!=='undefined')?_paused:false;
  if(typeof _paused!=='undefined') _paused=true;
  /* v2.1.123: Wave 4 S32 â€” Tutorial Introduction cinematic audio (sparkle fanfare). */
  if(typeof sfxSparkle==='function') try{sfxSparkle();setTimeout(()=>sfxSparkle(),300);}catch(_){}
  const SLIDES=[
    {em:'đźŽ¤',title:'Witaj w Trap Simulator',body:'Sandboxowa gra o budowaniu kariery artysty. Zaczynasz biednie w traphouse, ale rozwijaÄ‡ siÄ™ moĹĽesz w wielu kierunkach: rap, beatmaker, YouTuber, streamer/gamer, influencer, realizator dĹşwiÄ™ku, biznes, merch.<br><br>1 000 000 fanĂłw to jeden z milestone\'Ăłw, ale gra nie koĹ„czy siÄ™ tam â€” moĹĽesz dalej rozwijaÄ‡ postaÄ‡, wchodziÄ‡ w Prestige, prĂłbowaÄ‡ innych Ĺ›cieĹĽek.'},
    {em:'âť¤ď¸Ź',title:'Statystyki ĹĽyciowe',body:'<b style="color:#e74c3c">âť¤ď¸Ź Zdrowie</b> â€” spada gdy gĹ‚Ăłd=0 lub energia=0. Lecz w szpitalu.<br><br><b style="color:#3498db">âšˇ Energia</b> â€” spada przy akcjach (praca, koncert). IdĹş spaÄ‡ w Ĺ‚ĂłĹĽku.<br><br><b style="color:#27ae60">đźŤ” GĹ‚Ăłd</b> â€” spada z czasem. LodĂłwka, restauracja, sklep.<br><br><b style="color:#9b59b6">đź§  NastrĂłj</b> â€” wartoĹ›Ä‡ 0-100 (100=zen, 0=wypalenie). Odpoczywaj na sofie/Ĺ‚awce.'},
    {em:'â­',title:'SĹ‚awa i Fani (statystyki)',body:'<b style="color:#f1c40f">â­ SĹ‚awa (0-100)</b> â€” wartoĹ›Ä‡ otwierajÄ…ca koncerty, sklepy luksusowe, sponsorĂłw. RoĹ›nie z koncertĂłw, wydanych trackĂłw, eventĂłw.<br><br><b style="color:#7ec8e3">đź‘Ą Fani (licznik)</b> â€” statystyka kumulujÄ…ca. Milestone\'y: 1K â†’ 10K â†’ 100K â†’ 1M. KaĹĽdy z osobnymi nagrodami. Po 1M gra trwa dalej, kierujÄ…c na Prestige.'},
    {em:'đź’Ž',title:'Drip (styl/luksus)',body:'<b style="color:#c8a520">đź’Ž Drip 0-200</b> â€” luksusowy styl. Kupuj ubrania w Drip District (Balenciaga, Bottega, Dior).<br><br>Bonusy (per pkt, liniowo):<br>â€˘ Koncerty (zarobki + fani) +0.1%/pkt â€” drip 200 = <b>+20%</b> (z Ulepszeniem "Personal brand": <b>+30%</b>)<br>â€˘ Spotify/Tidal royalties +0.2%/pkt â€” drip 200 = <b>+40%</b> (z Ulepszeniem: <b>+60%</b>)<br>â€˘ Zaliczki Major/Global +0.8-1.2%/pkt â€” drip 200 = <b>+40-50%</b> (z Ulepszeniem: <b>+60-75%</b>)<br>â€˘ Instagram zasiÄ™g +0.5%/pkt â€” drip 200 = <b>+100%</b> (z Ulepszeniem: <b>+150%</b>)<br><br>đź“˘ Ulepszenie "Personal brand" (Autopromocja 4 w drzewku rapera): rozszerza wszystkie capy dripowe.'},
    {em:'đź’Ş',title:'Forma i Kondycja',body:'<b style="color:#00bcd4">đź’Ş Forma 0-100</b> â€” siĹ‚ownia: bench press, treadmill, cable. Forma 100 daje +10 max do zdrowia/energii/gĹ‚odu. Bez treningu 3+ dni â†’ spada 10-20%/dzieĹ„.<br><br><b>Skill Kondycja</b> (drzewko) spowalnia spadek energii (-8%/pkt, max -40%).<br><br><b>Skill Apetyt</b> spowalnia gĹ‚Ăłd, <b>OdpornoĹ›Ä‡</b> chroni zdrowie.'},
    {em:'đźŽŻ',title:'Drzewko umiejÄ™tnoĹ›ci + Ulepszenia + Ewolucje',body:'9 gaĹ‚Ä™zi skill tree dla rapera: Flow, Teksty, Produkcja, Realizacja, Mikser, Autopromocja, Biznes, Scena, Kondycja. KaĹĽda kariera ma wĹ‚asne drzewko.<br><br>Wydawaj <b style="color:#f1c40f">Skill Points</b> (z lvl up) na bonusy 1-5.<br><br><b>Ulepszenia (Power-Ups)</b> dodajÄ… bonusy kumulatywnie: 1. Ulepszenie = +30%, 2. = +60%, 3. = +100% (max 3 Ulepszenia per skill).<br><br><b>Ewolucje</b> â€” zaawansowane bonusy odblokowywane po max skill+Ulepszenia (3 evo per gaĹ‚Ä…Ĺş: Strateg / Master / Specjalista).'},
    {em:'đź“‹',title:'Linia fabularna + Side stories',body:'<b>GĹ‚Ăłwna linia</b> â€” milestone fanĂłw: 100 â†’ 250 â†’ 500 â†’ 1000. Po 1000 odblokowujÄ… siÄ™ kolejne Ĺ›cieĹĽki (kariery, sponsorzy, label).<br><br><b>Linie boczne</b> (6): Drip, Forma, Mieszkanie, YouTuber, Beatmaker, Gamer â€” kaĹĽda z wĹ‚asnymi questami i nagrodami.<br><br><b>Daily Quests</b> od Wiktora â€” codzienne mini-zadania (+XP, +zĹ‚).'},
    {em:'đź¤ť',title:'NPC i PrzyjaĹşnie',body:'7 staĹ‚ych NPC w mieĹ›cie. KaĹĽdy z poziomem przyjaĹşni 0-100. WyĹĽszy poziom â†’ wiÄ™kszy bonus do zwiÄ…zanych mechanik (np. Zbyszek = zniĹĽki, Marcin = +zarobki koncertĂłw).<br><br>Buduj przez: zakupy, side quests, SMS odpowiedzi, prezenty.<br><br>Telefon â†’ đź¤ť NPC â†’ PrzyjaĹşnie pokazuje wszystko.'},
    {em:'â­',title:'Prestige (po endgame)',body:'Po osiÄ…gniÄ™ciu wysokiego poziomu + 100K+ fanĂłw odblokujesz <b style="color:#c8a520">PRESTIGE</b>: reset poziomu, ale permanentny bonus +5% kasa, +3% sĹ‚awa per rank.<br><br>Max Prestige 10. Po kaĹĽdym ranku moĹĽesz wybraÄ‡ innÄ… Ĺ›cieĹĽkÄ™ kariery i graÄ‡ dalej.'},
    {em:'đźš€',title:'Gotowy do startu!',body:'<b>Sterowanie:</b> WASD = ruch Â· E = interakcja Â· P = telefon Â· M = mapa Â· Esc = pauza Â· Ctrl+S = save<br><br><b style="color:#f1c40f">Wybierz swojÄ… Ĺ›cieĹĽkÄ™:</b> Pizzeria, Kurier, Carwash, Construction, Zmywak (prace dorywcze)... albo idĹş do Wiktora po zlecenie, do Studio na pierwszy track, albo w Galaxy ĹĽeby kupiÄ‡ sprzÄ™t. WybĂłr naleĹĽy do Ciebie. Powodzenia! đźŽ¤<br><br><div style="background:linear-gradient(135deg,rgba(200,165,32,.2),rgba(241,196,15,.1));border:1px solid #c8a520;padding:14px;border-radius:10px;margin-top:12px;color:#f1c40f;font-weight:700;text-align:center">đźŽ¬ Po zamkniÄ™ciu zobaczysz <b>PRZELOT KAMERÄ„ PO MIEĹšCIE</b> â€” pokaĹĽemy Ci kluczowe lokacje z lotu ptaka.</div>'}
  ];
  let idx=0;
  /* v1.9.82: in-place update zamiast remove+create (zapobiega flicker/jump) */
  const _ensureModal=()=>{
    let m=document.getElementById('intro-modal');
    if(!m){
      m=document.createElement('div');
      m.id='intro-modal';
      m.style.cssText='position:fixed;inset:0;background:linear-gradient(135deg,rgba(10,10,30,.96),rgba(20,10,40,.96));z-index:9998;display:flex;align-items:center;justify-content:center;animation:bdFadeIn .25s';
      document.body.appendChild(m);
    }
    return m;
  };
  const _render=()=>{
    const s=SLIDES[idx];
    const m=_ensureModal();
    m.innerHTML=`
      <div style="max-width:680px;padding:36px 50px;text-align:center">
        <div style="font-size:84px;margin-bottom:18px;animation:emojiFloat 2.5s ease-in-out infinite">${s.em}</div>
        <h1 style="color:#c8a520;font-size:32px;letter-spacing:2px;margin:0 0 20px;text-shadow:0 0 24px rgba(200,165,32,.5)">${s.title}</h1>
        <div style="color:#d8d8e8;font-size:15px;line-height:1.8;margin-bottom:30px;text-align:left">${s.body}</div>
        <div style="display:flex;gap:14px;justify-content:center;margin-bottom:18px">
          ${idx>0?`<button onclick="window._introNav(-1)" style="background:#1a2535;color:#aac;border:1px solid #2a3a4a;padding:10px 20px;border-radius:8px;cursor:pointer">â† Poprzedni</button>`:''}
          ${idx<SLIDES.length-1?`<button onclick="window._introNav(1)" style="background:linear-gradient(135deg,#c8a520,#f1c40f);color:#000;border:none;padding:10px 24px;border-radius:8px;font-weight:800;cursor:pointer">Dalej â†’</button>`:`<button onclick="window._introClose()" style="background:linear-gradient(135deg,#27ae60,#1a7838);color:#fff;border:none;padding:12px 28px;border-radius:8px;font-weight:800;cursor:pointer;letter-spacing:1px">â–¶ ZACZNIJ GRAÄ†</button>`}
        </div>
        <div style="display:flex;gap:6px;justify-content:center;margin-bottom:14px">
          ${SLIDES.map((_,i)=>`<div style="width:${i===idx?32:8}px;height:8px;background:${i===idx?'#c8a520':i<idx?'#7ec87e':'#3a3a4a'};border-radius:4px;transition:all .25s"></div>`).join('')}
        </div>
        <button onclick="window._introClose()" style="background:transparent;color:#778;border:none;font-size:12px;cursor:pointer;text-decoration:underline">PomiĹ„ tutorial</button>
      </div>`;
  };
  window._introNav=(dir)=>{idx=Math.max(0,Math.min(SLIDES.length-1,idx+dir));_render();};
  window._introClose=()=>{
    document.getElementById('intro-modal')?.remove();
    G._introductionSeen=true;
    G._introductionActive=false;
    if(typeof _paused!=='undefined') _paused=G._introPausedBefore===true;
    delete G._introPausedBefore;
    if(typeof saveGameSilent==='function')saveGameSilent();
    /* v1.9.96: AUTOMATYCZNE uruchomienie cinematic flythrough po zakoĹ„czeniu Wprowadzenia.
       NIE pytamy gracza â€” to naturalna czÄ™Ĺ›Ä‡ intro. Tylko jeĹ›li na ulicy + nie odbyĹ‚ wczeĹ›niej. */
    if(currentRoom==='ulica' && !G._cinematicCompleted){
      setTimeout(()=>{
        if(typeof window.openCinematicFlythrough==='function') window.openCinematicFlythrough();
      }, 800);
    } else if(typeof showMsg==='function'){
      showMsg('đź’ˇ MoĹĽesz uruchomiÄ‡ Wprowadzenie ponownie w telefonie (app đźŽ¬)','f',5000);
    }
  };
  _render();
};

function showWelcomePopup(title,body){
  document.getElementById('welcome-popup')?.remove();
  document.getElementById('welcome-backdrop')?.remove();
  // Backdrop â€” semi-transparent, klikalny zeby zamknac
  const bd=document.createElement('div');
  bd.id='welcome-backdrop';
  bd.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);z-index:299;animation:bdFadeIn .25s ease-out;cursor:pointer';
  bd.onclick=()=>_closeWelcome();
  document.body.appendChild(bd);
  // Popup
  const el=document.createElement('div');
  el.id='welcome-popup';
  el.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(135deg,#0a0a1a,#1a0a2a);border:2px solid #f1c40f;border-radius:14px;padding:30px 40px;max-width:520px;z-index:300;box-shadow:0 0 80px rgba(241,196,15,.6);animation:welcomeIn .4s ease-out;color:#fff;font-family:inherit;text-align:center;cursor:default';
  el.onclick=e=>e.stopPropagation();
  el.innerHTML=`
    <div style="font-size:24px;color:#f1c40f;font-weight:900;margin-bottom:14px;letter-spacing:1px">${title}</div>
    <div style="font-size:14px;color:#ccc;line-height:1.6;margin-bottom:18px">${body}</div>
    <button id="welcome-btn" style="background:linear-gradient(135deg,#0a3a1a,#1a4a2a);border:2px solid #27ae60;color:#7ec87e;padding:12px 36px;border-radius:10px;cursor:pointer;font-family:inherit;font-size:15px;font-weight:800;letter-spacing:.8px;transition:all .15s;box-shadow:0 4px 12px rgba(39,174,96,.25)">â–¶ Zaczynaj</button>
    <div style="margin-top:10px;font-size:11px;color:#556;opacity:.8">klik poza okno Â· ESC Â· auto-zamkniÄ™cie za <span id="welcome-cd">8</span>s</div>
  `;
  document.body.appendChild(el);
  // Hover effect na przycisku
  const btn=el.querySelector('#welcome-btn');
  btn.onclick=_closeWelcome;
  btn.onmouseover=()=>{btn.style.background='linear-gradient(135deg,#1a5a2a,#2a6a3a)';btn.style.transform='translateY(-1px)';btn.style.boxShadow='0 6px 16px rgba(39,174,96,.45)';};
  btn.onmouseout=()=>{btn.style.background='linear-gradient(135deg,#0a3a1a,#1a4a2a)';btn.style.transform='';btn.style.boxShadow='0 4px 12px rgba(39,174,96,.25)';};
  // Countdown UI
  let _wcd=8;
  const cdT=setInterval(()=>{
    _wcd--;
    const cdEl=document.getElementById('welcome-cd');
    if(cdEl)cdEl.textContent=_wcd;
    if(_wcd<=0)clearInterval(cdT);
  },1000);
  // ESC support
  const escH=e=>{
    if(e.key==='Escape'){_closeWelcome();}
  };
  document.addEventListener('keydown',escH);
  function _closeWelcome(){
    clearInterval(cdT);
    document.removeEventListener('keydown',escH);
    document.getElementById('welcome-popup')?.remove();
    document.getElementById('welcome-backdrop')?.remove();
  }
  setTimeout(_closeWelcome,8000);
}
// â”€â”€ Floating gain text â”€â”€
// F+ 2026-05-12 #74: stagger overlapping money popups
// WczeĹ›niej WSZYSTKIE floaty lÄ…dowaĹ‚y na top:200px â€” wiele zarobkĂłw w krĂłtkim odstÄ™pie nakĹ‚adaĹ‚o siÄ™.
// Teraz: jeĹ›li ostatni floaty < 600ms temu, kolejny przesuniÄ™ty o 28px w dĂłĹ‚ (max 5 slotĂłw = 140px).
let _lastGainTime=0, _gainOffset=0;
function showGain(text,color='#f1c40f',x,y){
  const _now=Date.now();
  if(_now-_lastGainTime<600){
    _gainOffset=(_gainOffset+28)%140;
  } else {
    _gainOffset=0;
  }
  _lastGainTime=_now;
  const el=document.createElement('div');
  el.className='float-gain';
  el.textContent=text;
  el.style.color=color;
  el.style.left=(x!==undefined?x:Math.random()*60+20)+'%';
  el.style.top=(y!==undefined?y:200+_gainOffset)+'px';
  el.style.fontSize='18px';
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),1200);
}

// â”€â”€ Confetti burst on big wins â”€â”€
function confetti(count=30){
  const colors=['#f1c40f','#e91e8c','#3498db','#2ecc71','#9b59b6','#e74c3c','#7ec8e3'];
  for(let i=0;i<count;i++){
    const el=document.createElement('div');
    el.style.cssText=`position:fixed;width:8px;height:8px;border-radius:${Math.random()>.5?'50%':'2px'};background:${colors[Math.floor(Math.random()*colors.length)]};left:${Math.random()*97}%;top:10%;pointer-events:none;z-index:9999;animation:confettiFall ${.8+Math.random()*.8}s ${Math.random()*.5}s ease-out forwards`; /* v1.9.15: 100%â†’97% â€” confetti nie wylatuje poza prawÄ… krawÄ™dĹş */
    document.body.appendChild(el);
    /* v1.9.31: cleanup 1600â†’2300 â€” animacja moĹĽe trwaÄ‡ do 2.1s (dur 1.6 + delay 0.5), wczeĹ›niej elementy znikaĹ‚y mid-flight */
    setTimeout(()=>el.remove(),2300);
  }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  HUD
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function checkMissionMilestones(){
  const mm=G.mainMission;if(!mm||!mm.active||mm.failed) return;
  /* v2.1.37 [Amper]: mainMission "Pierwsze 100/250/500/1000 fanĂłw" = G.fans lojalnych (spĂłjnoĹ›Ä‡ z HUD) */
  const totalFans=(G.fans||0);
  for(const ms of mm.milestones){
    if(!ms.done&&totalFans>=ms.fans){
      ms.done=true;
      if(ms.reward.money){G.money+=ms.reward.money;G.totalEarned=(G.totalEarned||0)+ms.reward.money;}
      if(ms.reward.xp) addXP(ms.reward.xp);
      if(ms.reward.followers) G.followers=(G.followers||0)+ms.reward.followers;
      if(ms.reward.fame) G.fame=clamp((G.fame||0)+ms.reward.fame,0,500);
      showMsg(`đźŽŻ ${ms.label}${ms.reward.money?' +'+ms.reward.money+' zĹ‚':''}${ms.reward.xp?' +'+ms.reward.xp+' XP':''}!`);
      addNotif(`đźŹ† Misja: ${ms.label}`);
      if(ms.fans>=1000) mm.active=false;
    }
  }
}
let _missionTick=0;
function updateHUD(){
  // SprawdĹş milestone'y misji co 60 klatek
  if(++_missionTick>=60){_missionTick=0;checkMissionMilestones();}
  /* v2.1.195: REBALANS PRÄDKOĹšCI â€” additive formula, cap 3.3, FAKTYCZNE max levels skilli (Bieg max 3 NIE 5).
     - Baza 2.0
     - Fitness (0-100): +0.0 do +0.38 (linear G.fitness/100 Ă— 0.38, +19% nad bazÄ…)
     - Kondycja skill (0-5): +0.04/lvl â†’ max +0.20 (+10% nad bazÄ…)
     - Skill Bieg (0-3): +0.04/lvl â†’ max +0.12 (+6% nad bazÄ…) â€” max skill 3 w SKILL_DEF
     - PU Bieg (0-3): +0.10/lvl â†’ max +0.30 (+15%)
     - Evo Bieg (0/1): +0.30 (+15%)
     Suma max: 2.0 + 0.38 + 0.20 + 0.12 + 0.30 + 0.30 = 3.30 âś“ (+65% nad bazÄ… = Ă—1.65)
  */
  const _kondLvl=(G.skills&&getSkillLvl('kondycja'))||0;
  const _kondSpdBonus=Math.min(5,_kondLvl)*0.04;
  const _skBieg=Math.min(3,(typeof _sk==='function')?_sk('bieg'):0); /* v2.1.195: max 3 (SKILL_DEF) */
  const _puBieg=(typeof _pu==='function')?_pu('bieg'):0;
  const _evoBieg=(typeof _evo==='function')?_evo('bieg'):0;
  const _fitSpdBonus=(G.fitness||0)/100*0.38; /* v2.1.195: 0.30â†’0.38, dopeĹ‚nia cap 3.3 z faktycznymi max levels */
  const _bgsSpdBonus=_skBieg*0.04 + _puBieg*0.10 + _evoBieg*0.30;
  const _spdRaw=2.0 + _fitSpdBonus + _kondSpdBonus + _bgsSpdBonus;
  /* v2.1.175: defensive Math.max(2.0,...) â€” minimum bazowa 2.0 nawet gdy stats glitch. */
  /* v2.1.189: admin override â€” gdy G._adminSpeedCap >= 2.0, wymuszamy konkretnÄ… wartoĹ›Ä‡ (ignorujemy formuĹ‚Ä™). */
  if(typeof G._adminSpeedCap==='number' && G._adminSpeedCap>=2.0){
    P.spd=G._adminSpeedCap;
  } else {
    P.spd=Math.min(3.3, Math.max(2.0, _spdRaw));
  }
  // Critical stats (life-affecting) â€” pulsujÄ… gdy niskie. Non-critical (sĹ‚awa) â€” nie pulsujÄ….
  const setBar=(id,val,vid,critical=true,maxVal=100)=>{
    const el=document.getElementById(id);const vEl=document.getElementById(vid);
    /* v1.9.19: BUG FIX overflow â€” przy evo i milestonach (forma100, fitness100, sila/dieta evo) stats mogÄ… siÄ™gaÄ‡ 110-120. Bar % liczony jako val/maxVal*100, label pokazuje raw value. */
    const pctWidth=Math.min(100,Math.max(0,(val/maxVal)*100));
    el.style.width=pctWidth+'%';vEl.textContent=Math.floor(val);
    if(critical){
      el.style.filter=val<=20?'brightness(1.5)':'';
      el.parentElement.parentElement.style.opacity=val<=10?(.5+Math.sin(Date.now()/200)*.5).toString():'1';
      if(el.parentElement)el.parentElement.classList.toggle('crit',val<=25);
    } else {
      el.style.filter='';
      el.parentElement.parentElement.style.opacity='1';
      if(el.parentElement)el.parentElement.classList.remove('crit');
    }
  };
  // Krytyczne (zdrowie/energia/gĹ‚Ăłd/nastrĂłj â€” niski poziom zagraĹĽa graczowi)
  /* v1.9.19: max value przekazane do setBar (getMaxStat zwraca 110-120 dla zewolveowanych stats â€” wczeĹ›niej bar przekraczaĹ‚ kontener) */
  const _maxHP=typeof getMaxStat==='function'?getMaxStat('health'):100;
  const _maxEN=typeof getMaxStat==='function'?getMaxStat('energy'):100;
  const _maxHU=typeof getMaxStat==='function'?getMaxStat('hunger'):100;
  setBar('bhp',G.health,'vhp',true,_maxHP);setBar('ben',G.energy,'ven',true,_maxEN);setBar('bhu',G.hunger,'vhu',true,_maxHU);setBar('bst',G.stress,'vst',true);
  // Niekrytyczne (sĹ‚awa â€” niski poziom nie zabija)
  /* v2.1.212 [Amper]: fame bar cap 500 + tier color + X/500 label */
  setBar('bfa',G.fame,'vfa',false,500);
  const _bfaEl=document.getElementById('bfa');
  if(_bfaEl){
    const _tier=typeof getFameTier==='function'?getFameTier():0;
    const _tierColors=[
      'linear-gradient(90deg,#602080,#9b59b6,#c78dde)',
      'linear-gradient(90deg,#a8501a,#e67e22,#f0a060)',
      'linear-gradient(90deg,#922020,#e74c3c,#f08070)',
      'linear-gradient(90deg,#502070,#9b59b6,#c08adb)',
      'linear-gradient(90deg,#c8a520,#f1c40f,#fde680)'
    ];
    _bfaEl.style.background=_tierColors[_tier];
  }
  const _vfaEl=document.getElementById('vfa');
  if(_vfaEl) _vfaEl.textContent=Math.floor(G.fame)+'/500';
  const fo=G.forma||0;
  document.getElementById('hbarfo').style.width=fo+'%';
  /* v2.1.142: toLocaleString consistency dla forma/drip/fitness (analogicznie do money/fame/followers w HUD). WartoĹ›ci <1000 wiÄ™c separator tysiÄ™cy nie zmienia wizualizacji, ale spĂłjnoĹ›Ä‡ z resztÄ… UI. */
  document.getElementById('hvfo').textContent=Math.round(fo).toLocaleString('pl');
  const dripEl=document.getElementById('hvdrip');if(dripEl)dripEl.textContent=(G.drip||0).toLocaleString('pl');
  const fitEl=document.getElementById('hvfit');if(fitEl)fitEl.textContent=Math.round(G.fitness||0).toLocaleString('pl');
  // Red vignette overlay for low health
  const dmgEl=document.getElementById('dmg-overlay');
  if(dmgEl){
    if(G.health<40){
      const intensity=(40-G.health)/40;
      const alpha=0.2+intensity*0.65;
      dmgEl.style.display='block';
      const pulse=0.5+Math.sin(Date.now()/300)*0.5;
      dmgEl.style.boxShadow=`inset 0 0 ${100+intensity*140}px ${30+intensity*50+pulse*20}px rgba(200,0,0,${alpha})`;
      dmgEl.style.background=`radial-gradient(ellipse at center, transparent 30%, rgba(200,0,0,${alpha*0.7}) 100%)`;
      // Critical warning flash
      if(G.health<20&&Math.sin(Date.now()/250)>0.7){
        dmgEl.style.background=`rgba(180,0,0,${0.12+intensity*0.2})`;
      }
    } else if(G.health<60){
      const intensity=(60-G.health)/60;
      const alpha=intensity*0.3;
      dmgEl.style.display='block';
      dmgEl.style.boxShadow=`inset 0 0 ${80+intensity*80}px ${15+intensity*25}px rgba(180,0,0,${alpha})`;
      dmgEl.style.background='none';
    } else {
      dmgEl.style.display='none';
    }
  }
  const fmtBig=n=>{
    if(n>=950000) return (n/1e6).toFixed(n>=1e7?0:1).replace('.0','')+'M';
    if(n>=10000) return Math.round(n/1000)+'k';
    return n.toLocaleString('pl');
  };
  // v2.1.174: HUD hmoney TYLKO kwota â€” usuniÄ™to bills/rentals indicators ktĂłre:
  // (a) rozszerzaĹ‚y hmoney przez `_billsIcon`/`_rentalsIcon` â†’ flex pushed hclock-block RIGHT â†’ zasĹ‚aniaĹ‚ đź”Š/đź“± buttons
  // (b) byĹ‚y niezrozumiaĹ‚e ("co to za druga kwota?", "3 ĹĽĂłĹ‚te kropki" = text-overflow:ellipsis truncating long content)
  // Bills nadal widoczne w: Phone â†’ Rachunki + Biuro NieruchomoĹ›ci (sekcja "đź“§ Rachunki za mieszkanie").
  // Rentals widoczne w: Biuro NieruchomoĹ›ci (sekcja "đź’° Wynajem posiadanych mieszkaĹ„").
  // v1.8.20: num-tick animacja gdy kasa roĹ›nie
  const _hmoney=document.getElementById('hmoney');
  const _prevMoney=window._prevHudMoney||0;
  _hmoney.innerHTML='đź’° '+fmtBig(Math.floor(G.money))+' zĹ‚';
  if(G.money>_prevMoney+5){
    _hmoney.classList.remove('num-tick');
    void _hmoney.offsetWidth; // restart animation
    _hmoney.classList.add('num-tick');
  }
  window._prevHudMoney=Math.floor(G.money);
  /* v2.1.34: HUD pokazuje FANĂ“W (lojalnych) â€” G.fans. ObserwujÄ…cy (G.followers) widoczni w telefonie/IG/Twitter. */
  const _hfol=document.getElementById('hfollow');
  const _prevFol=window._prevHudFollow||0;
  _hfol.textContent='đź‘Ą '+fmtBig(G.fans);
  if(G.fans>_prevFol+5){
    _hfol.classList.remove('num-tick');
    void _hfol.offsetWidth;
    _hfol.classList.add('num-tick');
  }
  window._prevHudFollow=G.fans;
  document.getElementById('hday').textContent='DzieĹ„ '+G.day;
  // Pora dnia jako emoji obok zegara (Rano/PoĹ‚udnie/WieczĂłr/Noc)
  const _poraIco=['đźŚ…','â€ď¸Ź','đźŚ†','đźŚ™'][G.timeOfDay]||'đźŚ…';
  const _hpIcon=document.getElementById('hporaIcon');
  if(_hpIcon){_hpIcon.textContent=_poraIco;_hpIcon.title=CFG.PORA[G.timeOfDay]||'';}
  const _hcb=document.getElementById('hclock-block');
  if(_hcb)_hcb.title=`DzieĹ„ ${G.day} Â· ${CFG.PORA[G.timeOfDay]||''}`;
  const _hlvl=document.getElementById('hlvl');
  _hlvl.textContent='Lvl '+G.level+(G.skillPoints>0?' đźŽŻ'+G.skillPoints:'');
  // Pulsuj gdy sÄ… nieuĹĽyte punkty umiejÄ™tnoĹ›ci
  const _hf=document.getElementById('hud-face');
  if(G.skillPoints>0){
    _hlvl.classList.add('skillpt-ready');
    if(_hf)_hf.classList.add('skillpt-ready');
  } else {
    _hlvl.classList.remove('skillpt-ready');
    if(_hf)_hf.classList.remove('skillpt-ready');
  }
  // F4.4 FIX: dodane Variation Selector-16 (ď¸Ź) do brakujacych emoji + zmiana đźŚ¤ â†’ âď¸Ź (lepiej widoczne)
  const _wIcons=['â€ď¸Ź','âď¸Ź','đźŚ§ď¸Ź','âť„ď¸Ź','đźŚ«ď¸Ź','â›ď¸Ź'];
  const _wNames=['SĹ‚onecznie','Pochmurno','Deszcz','Ĺšnieg','MgĹ‚a','Burza'];
  const _s=getSeason();
  const _wIdx=Math.max(0,Math.min(5,G.weather||0));
  document.getElementById('hweath').textContent=_wIcons[_wIdx];
  document.getElementById('hweath').title=`Pogoda: ${_wNames[_wIdx]} Â· Sezon: ${_s.name} ${_s.emoji}`;
  // Game clock
  const totalMins=Math.floor(gameMin)%1440;
  const hrs=Math.floor(totalMins/60),mins=totalMins%60;
  const clockEl=document.getElementById('hclock');
  if(clockEl) clockEl.textContent=`${hrs.toString().padStart(2,'0')}:${mins.toString().padStart(2,'0')}`;
  // Player status icons
  const outfitIco={street:'đź§Ą',suit:'đź‘”',sport:'đźŹ‹',music:'đźŽ¤',luxury:'đź’Ž',tracksuit:'đźĄ‹',leather_jacket:'đź§Ą',designer_hoodie:'đź‘•',default:''}[G.outfit.top||'default']||''; /* v2.1.148 hotfix: 3 nowe outfity HUD icons */
  const sleepIcon=(G.sleepDebt||0)>=3?' đź’¤':'';
  const moodIcon=(G.stress||0)<30?' đź“':'';
  const prestigeStars=(G.prestige||0)>0?' '+'â­'.repeat(Math.min(G.prestige,5)):'';
  const hname=document.getElementById('hname');
  if(hname) hname.textContent=G.name+outfitIco+(G.car?' đźš—':'')+(G.label.type?' đźŽĽ':'')+sleepIcon+moodIcon+prestigeStars;
  // Kontrakt w HUD
  const hc=document.getElementById('hcontract');
  if(G.contract){
    hc.textContent=`đź“‹ ${G.contract.desc}: ${G.contract.progress}/${G.contract.target} [Do dnia ${G.contract.deadline}]`;
    hc.style.display='block';
  } else hc.style.display='none';
  // Quest w HUD
  const hq=document.getElementById('hquest');
  if(G.dailyQuest&&!G.dailyQuest.claimed){
    if(G.dailyQuest.completed){hq.textContent='âś… Quest gotowy! (đź“± Telefon)';hq.style.color='#27ae60';}
    else{hq.textContent=`đź“‹ Quest: ${G.dailyQuest.progress}/${G.dailyQuest.count} â€” đź“±`;hq.style.color='#3498db';}
    hq.style.display='block';
    hq.onclick=()=>togglePhone();
  } else {hq.style.display='none';}
  updateQuestWidget();
}
// â”€â”€â”€ Smart hints â€” kontekstowe podpowiedzi â”€â”€
/* v2.1.42 [Amper]: Naprawiony bug powtarzajÄ…cych siÄ™ hintĂłw. Flag setowany jako `_hintShown_<id>`,
   ale warunki sprawdzaĹ‚y skrĂłcone nazwy â†’ niezgodnoĹ›Ä‡ â†’ hint odpalaĹ‚ siÄ™ co minutÄ™. Ujednolicone nazwy. */
const SMART_HINTS=[
  {id:'casino_intro', cond:()=>G.day>=2 && !G._firstCasinoVisit && !G._hintShown_casino_intro, msg:'đźŽ° NowoĹ›Ä‡: Kasyno Royal â€” wschodnia czÄ™Ĺ›Ä‡ miasta, przy chodniku S gĹ‚Ăłwnej drogi H1 (na wschĂłd od Sali Koncertowej). Szukaj neonu CASINO! 4 gry: ruletka, blackjack, sloty, war + daily spin w kantorze!'},
  {id:'helipad_vip', cond:()=>G.apartment==='luxury' && !G._hintShown_helipad_vip, msg:'đźš VIP Helipad obok Penthouse! MoĹĽesz darmowo lecieÄ‡ helikopterem do 7 miejsc w mieĹ›cie. Klik na helipad (wschĂłd od Penthouse).'},
  {id:'casino_milestone_5k', cond:()=>(G.casinoStats?.totalWon||0)>=5000 && !G._hintShown_casino_milestone_5k, msg:'đźŽ° Gratulacje! WygraĹ‚eĹ› Ĺ‚Ä…cznie 5000+ zĹ‚ w kasynie! Royal jest Twoim drugim domem đź’Ž'},
  {id:'casino_milestone_jackpot', cond:()=>(G.casinoStats?.biggestWin||0)>=10000 && !G._hintShown_casino_milestone_jackpot, msg:'đź’Ž LEGENDARNA WYGRANA! Twoja najwiÄ™ksza wygrana przekroczyĹ‚a 10 000 zĹ‚. Ulica o Tobie mĂłwi!'},
  {id:'rental_milestone', cond:()=>Object.values(G.rentals||{}).filter(v=>v===true).length>=2 && !G._hintShown_rental_milestone, msg:'đźŹ  Magnat nieruchomoĹ›ci! Wynajmujesz 2+ mieszkania. Pasywny dochĂłd: ' + Object.entries(G.rentals||{}).filter(([k,v])=>v===true).reduce((s,[k])=>s+({traphouse:25,basic:80,premium:200,luxury:500}[k]||0),0) + ' zĹ‚/dzieĹ„'}, /* v2.1.110: S36 â€” aktualne stawki (byĹ‚o 100/400/1200/5000 outdated, faktyczne to 25/80/200/500) */
  {id:'merch_unlocked', cond:()=>(G.fans||0)>=5000 && !G._hintShown_merch_unlocked, msg:'đź§˘ 5000 fanĂłw! Studio Projektowania odblokowane â€” wschodnia strona miasta. MoĹĽesz tam projektowaÄ‡ i sprzedawaÄ‡ wĹ‚asny merch.'},
  {id:'gamer_unlocked', cond:()=>G.level>=2 && !G._hintShown_gamer_unlocked, msg:'đźŽ® Lvl 2! Komputer w domu otwiera teraz Gaming/Stream. Streaming zarabia donacje, a mecze rankingowe podnoszÄ… rangÄ™.'},
  {id:'beatmaker_unlock', cond:()=>G.level>=3 && !G._hintShown_beatmaker_unlock, msg:'đźĄ Lvl 3! Kariera Beatmaker odblokowana. WejdĹş do Studio nagraĹ„ i otwĂłrz Mikser, ĹĽeby tworzyÄ‡ bity.'},
  {id:'soundeng_unlock', cond:()=>G.level>=4 && !G._hintShown_soundeng_unlock, msg:'đźŽ™ Lvl 4! Realizator DĹşwiÄ™ku odblokowany â€” kabina nagraĹ„ w Studio.'},
  {id:'apt_premium', cond:()=>G.level>=4 && (G.fans||0)>=2000 && G.apartment==='traphouse' && !G._hintShown_apt_premium, msg:'đźŹ˘ SpeĹ‚niasz wymogi do Apartamentu Premium (60k zĹ‚). IdĹş do Biura NieruchomoĹ›ci â€” wiÄ™ksza przestrzeĹ„, regaĹ‚ z trofeami, kuchnia.'}, /* v2.1.110: W40 â€” aktualna cena 60k */
  {id:'apt_lux', cond:()=>G.level>=7 && (G.fans||0)>=10000 && G.fame>=50 && G.apartment!=='luxury' && !G._hintShown_apt_lux, msg:'đź’Ž MoĹĽesz kupiÄ‡ Penthouse (250k zĹ‚)! Basen, sauna, jacuzzi i ognisko z panoramÄ… miasta. Biuro NieruchomoĹ›ci czeka.'}, /* v2.1.110: W41 â€” aktualna cena 250k (byĹ‚o 60k pre-v2.1.51) */
  /* v2.1.167: hint Mansion â€” tier 5 endgame apartament */
  {id:'apt_mansion', cond:()=>G.level>=15 && (G.fans||0)>=100000 && G.fame>=90 && G.apartment!=='mansion' && !G._hintShown_apt_mansion, msg:'đźŹ° MoĹĽesz kupiÄ‡ RezydencjÄ™ (1 500 000 zĹ‚)! Luksusowa rezydencja w prestiĹĽowej dzielnicy obok Biura NieruchomoĹ›ci, prywatne studio. Biuro NieruchomoĹ›ci.'},
  /* v2.1.215 [Amper]: Mega Villa hint — gdy gracz hit wymogi Tier 3 */
  {id:'apt_mega_villa', cond:()=>G.level>=18 && (G.fans||0)>=300000 && G.fame>=250 && (G.apartment==='mansion'||(G._ownedApts||[]).includes('mansion')) && (G.apartment==='luxury'||(G._ownedApts||[]).includes('luxury')) && G.apartment!=='mega_villa' && !G._hintShown_apt_mega_villa, msg:'🏖 Możesz kupić Mega Villa (3 000 000 zł) — Tier 3 Legendary! +50% regen, +20 mood, +30 fame, +2 fame/dzień pasywnie. Biuro Nieruchomości.'},
  {id:'concert_small', cond:()=>G.fame>=20 && G.events.performed===0 && !G._hintShown_concert_small, msg:'đźŽ¤ SĹ‚awa 20+! IdĹş do Booking Agenta (chodnik wschodni) â€” zagraj pierwszy koncert. Daje kasÄ™ i fanĂłw.'},
  {id:'concert_big', cond:()=>G.fame>=55 && G.events.performed<3 && !G._hintShown_concert_big, msg:'đźŚź SĹ‚awa 55+! Wielki koncert (1000 zĹ‚ wpisowe â†’ ~3500 zĹ‚ zysku). Booking Agent zarezerwuje.'},
  {id:'tour_unlock', cond:()=>(G.fans||0)>=50000 && !G._tourActive && !G._hintShown_tour_unlock, msg:'đźŚŤ 50k fanĂłw! World Tour odblokowany u Booking Agenta â€” 5 miast, ogromne zarobki i fani.'},
  {id:'prestige_unlock', cond:()=>G.level>=15 && (G.fans||0)>=100000 && (G.prestige||0)===0 && !G._hintShown_prestige_unlock, msg:'â­ PRESTIGE dostÄ™pny! Zresetuj poziom z permanentnym bonusem. Telefon â†’ Statystyki â†’ Prestige.'},
  {id:'low_health', cond:()=>G.health<25 && G.health>0 && !G._hintShown_lowhealth_today, msg:'âť¤ď¸Ź KRYTYCZNE ZDROWIE! IdĹş do szpitala (centrum miasta) lub jedz/Ĺ›pij. Inaczej trafisz do szpitala â€” koszt leczenia 500 zĹ‚.'},
  {id:'low_energy', cond:()=>G.energy<20 && !G._hintShown_lowenergy_today, msg:'âšˇ Niska energia. IdĹş spaÄ‡ w Ĺ‚ĂłĹĽku w mieszkaniu â€” szybkie 100% regeneracji.'},
  {id:'low_hunger', cond:()=>G.hunger<25 && !G._hintShown_lowhunger_today, msg:'đźŤ” Spada gĹ‚Ăłd! Opcje: lodĂłwka (kupne), restauracja, kebab Zbyszka, stĂłĹ‚ (Ĺ›niadanie), albo đź”Ą pĹ‚yta indukcyjna â€” domowe gotowanie daje NAJWIÄKSZE bonusy (gĹ‚Ăłd + zdrowie + nastrĂłj + zwrot energii). Kup skĹ‚adniki w sklepie/na targu i ugotuj!'},
  {id:'has_save_money', cond:()=>G.money>=20000 && !G._hintShown_has_save_money, msg:'đź’° Masz 20k+ zĹ‚ â€” pomyĹ›l o inwestycjach (Telefon â†’ Bank), kupnie samochodu, lub Apartamentu Premium.'},
  {id:'first_singiel', cond:()=>(G.studioTracks?.length||0)===0 && G.fame>=15 && !G._hintShown_first_singiel, msg:'đźŽµ Wydaj swĂłj pierwszy singiel! Studio nagraĹ„ â†’ komputer/DAW. Zarabiaj royalties pasywnie.'}
];
let _lastHintTime=0;
function checkSmartHints(){
  if(_paused) return;
  if(document.getElementById('menu').style.display!=='none') return;
  // Nie pokazuj wskazĂłwek gdy gracz jest zajÄ™ty: minigra / telefon / overlay / NPC dialog / peĹ‚na mapa / pomoc / kreator postaci / admin panel
  if(typeof mgOpen==='function' && mgOpen()) return;
  if(typeof phoneOpen==='function' && phoneOpen()) return;
  if(typeof overlayOpen==='function' && overlayOpen()) return;
  if(typeof npcDlgOpen==='function' && npcDlgOpen()) return;
  if(document.getElementById('fullmap-overlay')) return;
  if(document.getElementById('help-panel')) return;
  if(document.getElementById('char-panel')?.style.display==='flex') return;
  if(document.getElementById('admin-panel')?.style.display==='block') return;
  if(document.getElementById('welcome-popup')) return;
  /* v1.9.19: NIE pokazuj smart hintu gdy tutorial popup aktywny */
  if(document.getElementById('tutorial-popup')) return;
  const now=Date.now();
  if(now-_lastHintTime<60000) return; // max 1 hint na minutÄ™
  // Reset dziennych hintĂłw (zdrowie/energia/gĹ‚Ăłd)
  if(G._lastHintResetDay!==G.day){
    G._lastHintResetDay=G.day;
    delete G._hintShown_lowhealth_today;
    delete G._hintShown_lowenergy_today;
    delete G._hintShown_lowhunger_today;
  }
  for(const h of SMART_HINTS){
    if(h.cond()){
      G[`_hintShown_${h.id.replace(/_today$/,'')}`]=true;
      // Per-day hints
      if(h.id.endsWith('low_health')) G._hintShown_lowhealth_today=true;
      if(h.id.endsWith('low_energy')) G._hintShown_lowenergy_today=true;
      if(h.id.endsWith('low_hunger')) G._hintShown_lowhunger_today=true;
      showSmartHint(h.msg);
      _lastHintTime=now;
      return;
    }
  }
}
function showSmartHint(msg){
  // Zapisz w historii
  if(!G._hintHistory) G._hintHistory=[];
  G._hintHistory.push({msg, day:G.day, time:Date.now()});
  if(G._hintHistory.length>20) G._hintHistory.shift();
  // Renderuj
  document.getElementById('smart-hint')?.remove();
  const p=document.createElement('div');
  p.id='smart-hint';
  p.style.cssText='position:fixed;top:120px;left:50%;transform:translateX(-50%);width:420px;background:linear-gradient(135deg,rgba(20,16,4,.98),rgba(40,30,8,.98));border:3px solid #f1c40f;border-radius:12px;padding:14px 18px;z-index:200;color:#fff;font-size:14px;line-height:1.55;box-shadow:0 6px 30px rgba(241,196,15,.5),0 0 60px rgba(241,196,15,.2);font-family:inherit;opacity:0;transition:opacity .35s,transform .35s;pointer-events:all';
  p.innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">
      <div style="flex:1">
        <div style="display:flex;align-items:center;gap:6px;color:#f1c40f;font-weight:900;font-size:12px;letter-spacing:2px;margin-bottom:6px;text-transform:uppercase"><span style="font-size:18px">đź’ˇ</span>WSKAZĂ“WKA</div>
        <div style="color:#fff">${msg}</div>
        <div style="color:#aaa;font-size:11px;margin-top:8px">Historia: đź“± Telefon â†’ WskazĂłwki</div>
      </div>
      <button onclick="this.parentElement.parentElement.remove()" style="background:#1a1100;border:1px solid #5a4a10;color:#f1c40f;font-size:14px;cursor:pointer;padding:4px 10px;border-radius:6px;font-weight:700">âś•</button>
    </div>
  `;
  document.body.appendChild(p);
  requestAnimationFrame(()=>{p.style.opacity='1';p.style.transform='translateX(-50%) translateY(0)';});
  // Pulse animation
  let pulseCount=0;
  const pulseId=setInterval(()=>{
    if(!document.getElementById('smart-hint')){clearInterval(pulseId);return;}
    p.style.boxShadow=pulseCount%2===0?'0 6px 30px rgba(241,196,15,.8),0 0 80px rgba(241,196,15,.4)':'0 6px 30px rgba(241,196,15,.4),0 0 40px rgba(241,196,15,.2)';
    pulseCount++;
    if(pulseCount>4) clearInterval(pulseId);
  },400);
  setTimeout(()=>{const e=document.getElementById('smart-hint');if(e){e.style.opacity='0';setTimeout(()=>e.remove(),350);}},12000);
}
function renderHintHistory(){
  const hist=G._hintHistory||[];
  document.getElementById('ph-title').textContent='đź’ˇ Historia wskazĂłwek';
  document.getElementById('ph-content').innerHTML=`
    <div class="ph-screen">
      <p style="color:#aaa;font-size:12px;margin-bottom:10px">WskazĂłwki ktĂłre siÄ™ pojawiĹ‚y. Najnowsze na dole.</p>
      ${hist.length===0?'<div style="color:#556;text-align:center;padding:30px">Brak wskazĂłwek (jeszcze).</div>':
        hist.slice().reverse().map(h=>`<div style="background:#0a1525;border-left:3px solid #f1c40f;border-radius:6px;padding:10px 12px;margin-bottom:8px;font-size:12px;color:#ccc;line-height:1.5">${h.msg}<div style="color:#556;font-size:10px;margin-top:4px">DzieĹ„ ${h.day}</div></div>`).join('')}
      <button class="cbtn" style="width:100%;margin-top:8px" onclick="renderPhoneHome()">â† WrĂłÄ‡</button>
    </div>
  `;
}
// â”€â”€â”€ PeĹ‚na mapa â”€â”€
const MAP_LANDMARKS=[
  // North row
