  audio: {
    name:'đźŽ¤ Janek â€” Audio Consultant',
    lines:[
      'Hej! Pomagam w Sklepie muzycznym â€” wybiorÄ™ Ci idealny sprzÄ™t.',
      'Mikrofon to twĂłj gĹ‚os. Bez dobrego mikrofonu nawet najlepszy talent siÄ™ gubi.',
