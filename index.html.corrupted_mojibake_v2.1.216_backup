};
const MERCH_MATERIALS={
  standard:{name:'Standard', priceMult:1,    qualityScore:1, popularityMod:1.0},
  premium: {name:'Premium',  priceMult:1.6,  qualityScore:2, popularityMod:0.9},
  luxury:  {name:'Luxury',   priceMult:2.5,  qualityScore:3, popularityMod:0.7}
};
const MERCH_DESIGNS={
  logo:    {name:'Logo gracza',    unlock:0,     popMod:1.0},
  citation:{name:'Cytat',          unlock:0,     popMod:0.95},
  abstract:{name:'Abstrakcja',     unlock:0,     popMod:0.9},
  album:   {name:'Cover albumu',   unlock:'singiel', popMod:1.4, requiresTrack:true},
  tour:    {name:'Tour Edition',   unlock:'koncert', popMod:1.3},
  hardcore:{name:'Hardcore Fans',  unlock:50,    popMod:1.5},
  legend:  {name:'Legendary',      unlock:50,    popMod:1.7, requiresFame:50}
};
const MERCH_UPGRADES=[
  /* v2.1.84 Amper: BUFF capacity â€” gracz late game potrzebuje wyĹĽszych limitĂłw ĹĽeby skalowaÄ‡ z growthem followers.
     WartoĹ›ci: 15 base / 30 capacity2 / 60 capacity3 / 120 capacity4. */
  {id:'capacity2',  name:'Druga linia produkcyjna',   cost:5000,  desc:'+15 sztuk dziennego limitu produkcji (15 â†’ 30)'},
  {id:'capacity3',  name:'Trzecia linia produkcyjna', cost:15000, desc:'+30 sztuk dziennego limitu produkcji (30 â†’ 60)', requires:'capacity2'},
  {id:'capacity4',  name:'Czwarta linia produkcyjna', cost:50000, desc:'+60 sztuk dziennego limitu produkcji (60 â†’ 120). Wymaga fame 80.', requires:'capacity3', reqFame:80},
  {id:'premium_mat',name:'Premium materiaĹ‚y',         cost:3000,  desc:'DostÄ™p do materiaĹ‚u Premium'},
  {id:'luxury_mat', name:'Luxury materiaĹ‚y',          cost:12000, desc:'DostÄ™p do materiaĹ‚u Luxury', requires:'premium_mat'},
  {id:'dist_local', name:'Dystrybucja krajowa',       cost:8000,  desc:'+30% popytu na wszystkie produkty'},
  {id:'dist_global',name:'Dystrybucja globalna',      cost:25000, desc:'+80% popytu (zastÄ™puje krajowÄ…)', requires:'dist_local'},
  {id:'marketing',  name:'Marketing online',          cost:6000,  desc:'+20% popytu, automatyczne posty na IG'},
  {id:'collab',     name:'Influencer collab',         cost:14000, desc:'Co tydzieĹ„ bonus +500 sprzedaĹĽy'},
  {id:'brand',      name:'Brand identity',            cost:4000,  desc:'+1 slot designu (limited editions)'},
  {id:'slot2',      name:'Drugi slot designu',        cost:2000,  desc:'MoĹĽesz wystawiÄ‡ 2 produkty rĂłwnolegle'},
  {id:'slot3',      name:'Trzeci slot designu',       cost:7000,  desc:'MoĹĽesz wystawiÄ‡ 3 produkty rĂłwnolegle', requires:'slot2'},
  {id:'slot5',      name:'PeĹ‚na linia produktĂłw',     cost:20000, desc:'MoĹĽesz wystawiÄ‡ 5 produktĂłw', requires:'slot3'}
];
function ensureMerchStore(){
  if(!G.merchStore) G.merchStore={
    products:[],            // aktywne produkty
    upgrades:{},            // {capacity2:true, ...}
    unlockedDesigns:['logo','citation','abstract'],
    history:[],             // ostatnie 30 dni: {day, totalSold, totalRevenue}
    trend:null,             // {type, multiplier, expiresDay}
    totalLifetimeRevenue:0,
    totalLifetimeSold:0,
    nextProductId:1
  };
}
function merchSlotCount(){
  ensureMerchStore();
  const u=G.merchStore.upgrades;
  if(u.slot5) return 5;
  if(u.slot3) return 3;
  if(u.slot2) return 2;
  return 1;
}
function merchCapacity(){
  ensureMerchStore();
  const u=G.merchStore.upgrades;
  /* v2.1.84 Amper: BUFF capacity â€” 10/18/28 â†’ 15/30/60/120. Plus nowy capacity4 dla late game (fame 80). */
  let cap=15;
  if(u.capacity2) cap+=15;
  if(u.capacity3) cap+=30;
  if(u.capacity4) cap+=60;
  return cap;
}
function merchPopularityMult(){
  ensureMerchStore();
  const u=G.merchStore.upgrades;
  // MnoĹĽniki popytu zmniejszone (wczeĹ›niej dist_global+marketing dawaĹ‚y 2.8Ă—)
  let m=1;
  if(u.dist_global) m+=0.8;
  else if(u.dist_local) m+=0.3;
  if(u.marketing) m+=0.2;
  return m;
}
// Dzienne koszty utrzymania merch studio â€” payable w merchDailyTick
// Niskie na starcie (early game opĹ‚acalne), rosnÄ… z upgrade'ami (late game balans)
function merchDailyOperatingCost(){
  ensureMerchStore();
  const ms=G.merchStore;
  if(ms.products.length===0) return 0;
  let cost=100; // base studio rent
  if(ms.upgrades.capacity2) cost+=30;
  if(ms.upgrades.capacity3) cost+=50;
  if(ms.upgrades.dist_local) cost+=30;
  if(ms.upgrades.dist_global) cost+=80;
  if(ms.upgrades.marketing) cost+=30;
  if(ms.upgrades.collab) cost+=30;
  cost+=ms.products.length*25; // pensje per slot
  return cost;
}
function merchAvailableTypes(){
  return Object.entries(MERCH_TYPES).filter(([id,t])=>G.followers>=t.unlock).map(([id])=>id);
}
function merchAvailableMaterials(){
  ensureMerchStore();
  const u=G.merchStore.upgrades;
  const avail=['standard'];
  if(u.premium_mat) avail.push('premium');
  if(u.luxury_mat) avail.push('luxury');
  return avail;
}
function merchAvailableDesigns(){
  ensureMerchStore();
  const ms=G.merchStore;
  const list=[...ms.unlockedDesigns];
  // Album cover: jeĹ›li wydany singiel
  if(G.studioTracks?.length>=1 && !list.includes('album')) list.push('album');
  // Tour: jeĹ›li byĹ‚ wielki koncert (gracz fame >=20)
  if(G.fame>=20 && !list.includes('tour')) list.push('tour');
  // Hardcore â€” 50+ hardcore fans
  if((G.fans||0)>=50 && !list.includes('hardcore')) list.push('hardcore');
  // Legend â€” sĹ‚awa 50+
  if(G.fame>=50 && !list.includes('legend')) list.push('legend');
  return list;
}
function calcSuggestedPrice(typeId, material){
  const t=MERCH_TYPES[typeId];
  const m=MERCH_MATERIALS[material];
  return Math.round(t.basePrice * m.priceMult);
}
function calcDemand(product){
  /* popyt = (followers * 0.0008) * marĹĽaModifier * trendMult * upgradesMult * fameMult * hardcoreMult * designMod * materialMod
     v2.1.57 Amper: NERF mnoĹĽnikĂłw popytu. WczeĹ›niej hardcoreMult=1+G.fans*0.005 â€” przy 10k fanĂłw dawaĹ‚o 51Ă—, przy 50k fanĂłw 251Ă—.
     Po v2.1.40 (fani jako gĹ‚Ăłwna mechanika) G.fans roĹ›nie szybko i mnoĹĽnik eksplodowaĹ‚ â†’ gracz dostawaĹ‚ 15-25k zĹ‚/dzieĹ„ gry pasywnie z merchu (co 6 min realnego czasu).
     Nowe wzory: fameMult cap 1.5Ă— (przy fame=100), hardcoreMult cap 2Ă— (przy fansâ‰Ą20k). Bardziej spĂłjne z resztÄ… balansu. */
  const t=MERCH_TYPES[product.type];
  const m=MERCH_MATERIALS[product.material];
  const d=MERCH_DESIGNS[product.design];
  const sugPrice=calcSuggestedPrice(product.type,product.material);
  const priceMod=Math.max(0.1, 1 - (product.price/sugPrice - 1) * 0.8);
  const fameMult = Math.min(1.5, 1 + (G.fame||0)*0.005);
  const hardcoreMult = Math.min(2.0, 1 + (G.fans||0)*0.00005);
  const trendMult=(G.merchStore.trend?.type===product.type)?G.merchStore.trend.multiplier:1;
  // Pogoda: zĹ‚a pogoda â†’ +30% popyt (zostajÄ… w domu, kupujÄ… online)
  const weatherMult=[2,3,4,5].includes(G.weather)?1.3:1.0;
  // Sezon: wpĹ‚ywa na popyt na konkretne produkty (zima â†’ bluzy, lato â†’ tshirty/czapki)
  const seasonMult=typeof seasonMerchMult==='function'?seasonMerchMult(product.type):1.0;
  // Festiwal: Black Friday â†’ Ă—3 sprzedaĹĽ na 1 dzieĹ„
  const festMult=typeof festivalEffect==='function'?(festivalEffect('merchSalesMult')||1):1;
  /* v2.1.116: Wave 5 S46 â€” Holiday BlackFriday Ă— Festival BlackFriday dual channel fix.
     WczeĹ›niej calcDemand czytaĹ‚ tylko festival, nie Holiday. Teraz oba aplikujÄ… (jeĹ›li oba aktywne = stack Ă—9, ale Holiday BF deterministic day 49 vs Festival BF random â€” rzadko razem). */
  const holidayMerchMult=typeof holidayBonus==='function'?(holidayBonus('merch')||1):1;
  /* v2.1.84 Amper: BUFF coefficient 0.0002 â†’ 0.0005 (Ă—2.5). Plus podniesione capacity (15/30/60/120) i wyĹĽszy hard cap (8k â†’ 50k). Razem daje late game ~10-15k zĹ‚/dzieĹ„ netto merch. */
  let base = (G.followers||0) * 0.0005 * priceMod * fameMult * hardcoreMult * (d?.popMod||1) * (m.popularityMod||1) * trendMult * merchPopularityMult() * weatherMult * seasonMult * festMult * holidayMerchMult;
  if(product.isLimited) base*=0.6;
  return Math.max(0, Math.floor(base));
}
function merchDailyTick(){
  ensureMerchStore();
  const ms=G.merchStore;
  if(ms.products.length===0) return;
  /* v2.1.64 Amper: IDEMPOTENCY GUARD â€” root cause raportu "300k w kilka minut".
     `nextPeriod()` (a wiÄ™c i merchDailyTick) moĹĽe byÄ‡ wywoĹ‚any WIELOKROTNIE per real-time minuta:
     - World Tour: 5 miast Ă— `nextPeriod()` w sekwencji (linia 20088) â†’ 5Ă— tick w ciÄ…gu ~30s
     - Sleep multi-day: jeĹ›li sleepDebt skacze przez 3 dni, 3Ă— tick
     - Inne skip-day akcje (np. eviction respawn)
     Bez guard'a Amper mĂłgĹ‚ dostaÄ‡ 30+ tickĂłw Ă— ~10k = 300k. Naprawione: tick wykonuje siÄ™ max RAZ per G.day. */
  if(G._lastMerchTickDay===G.day) return;
  G._lastMerchTickDay=G.day;
  const cap=merchCapacity();
  let totalSold=0, totalRevenue=0;
  const slotsCount=ms.products.length;
  const capPerSlot=Math.floor(cap/slotsCount);
  /* v2.1.62 Amper: zbieramy breakdown per-produkt do szczegĂłĹ‚owych faktur i toastĂłw. */
  const breakdown=[];
  for(const p of ms.products){
    const demand=calcDemand(p);
    const sold=Math.min(demand, capPerSlot);
    if(sold>0){
      const t=MERCH_TYPES[p.type], m=MERCH_MATERIALS[p.material];
      const unitProfit=p.price-t.baseCost*m.priceMult;
      const profit=sold*unitProfit;
      const roundedProfit=Math.max(0,Math.floor(profit));
      if(typeof earn==='function') earn(roundedProfit,false); else {G.money+=roundedProfit;G.totalEarned=(G.totalEarned||0)+roundedProfit;}
      p.dailySales=sold;
      p.totalSold=(p.totalSold||0)+sold;
      p.totalRevenue=(p.totalRevenue||0)+sold*p.price;
      totalSold+=sold;
      totalRevenue+=roundedProfit;
      breakdown.push({emoji:t.emoji, name:`${t.name} ${m.name}`, sold, gross:sold*p.price, profit:roundedProfit, unitPrice:p.price});
    } else p.dailySales=0;
  }
  // Tygodniowy bonus collab â€” co 7 dni +500 sprzedaĹĽy podzielonych proporcjonalnie
  let collabBonus=0;
  if(ms.upgrades.collab && G.day%7===0 && ms.products.length>0){
    const bonus=500;
    const perProd=Math.floor(bonus/ms.products.length);
    for(const p of ms.products){
      const profit=perProd*(p.price-MERCH_TYPES[p.type].baseCost*MERCH_MATERIALS[p.material].priceMult);
      const _mProfit=Math.max(0,Math.floor(profit));
      if(typeof earn==='function') earn(_mProfit,false); else {G.money+=_mProfit;}
      p.totalSold=(p.totalSold||0)+perProd;
      p.totalRevenue=(p.totalRevenue||0)+perProd*p.price;
      collabBonus+=_mProfit;
      totalSold+=perProd;
      totalRevenue+=_mProfit;
    }
    addNotif(`đź¤ť Influencer collab: +${bonus} sprzedaĹĽy, +${collabBonus.toLocaleString('pl')} zĹ‚!`);
  }
  // Marketing â€” automatyczne wzmianki
  if(ms.upgrades.marketing && Math.random()<0.3){
    const fanGain=rnd(20,50);
    G.followers+=fanGain;
    addNotif(`đź“± Marketing online: +${fanGain} fanĂłw`);
  }
  /* v2.1.84 Amper: HARD DAILY CAP podniesiony 8000 â†’ 50000 zĹ‚. Late-game gracz z 1mln+ followers + max upgrades + Black Friday i tak rzadko bÄ™dzie blisko 50k â€” to safety net na exploity, nie ograniczenie progresu. WczeĹ›niej 8k zatrzymywaĹ‚ gracza na ~3-4k netto/dzieĹ„ co byĹ‚o demotywujÄ…ce. */
  const HARD_DAILY_CAP=50000;
  if(totalRevenue>HARD_DAILY_CAP){
    const excess=totalRevenue-HARD_DAILY_CAP;
    G.money=Math.max(0,G.money-excess);
    G.totalEarned=Math.max(0,(G.totalEarned||0)-excess);
    totalRevenue=HARD_DAILY_CAP;
    addNotif(`âš–ď¸Ź Merch â€” dzienny limit zysku ${HARD_DAILY_CAP.toLocaleString('pl')} zĹ‚ osiÄ…gniÄ™ty.`);
  }
  /* v2.1.84 Amper: KLIENCI â†’ FANI. KaĹĽda sprzedaĹĽ buduje lojalnoĹ›Ä‡ â€” klienci merchu zostajÄ… fanami.
     FormuĹ‚a: sqrt(totalSold) Ă— 0.5 fanĂłw dziennie. 10 sztuk sprzedanych = +1.5 fana, 100 = +5 fanĂłw, 500 = +11 fanĂłw. */
  if(totalSold > 0){
    const _merchFans = Math.floor(Math.sqrt(totalSold) * 0.5);
    if(_merchFans > 0){
      addFans(_merchFans); /* v2.1.141: merch trend fans */
      if(Math.random() < 0.3 && typeof addNotif==='function') addNotif(`đźŽ¤ Klienci merchu â†’ +${_merchFans} fanĂłw (lojalnoĹ›Ä‡)`);
    }
  }
  // Koszty utrzymania
  const opCost=merchDailyOperatingCost();
  if(opCost>0){
    G.money=Math.max(0,G.money-opCost);
    totalRevenue-=opCost;
  }
  ms.history.push({day:G.day,totalSold,totalRevenue,products:ms.products.length,opCost,breakdown});
  if(ms.history.length>30) ms.history.shift();
  ms.totalLifetimeRevenue+=Math.max(0,totalRevenue);
  ms.totalLifetimeSold+=totalSold;
  if(G.merch){
    G.merch.sold=(G.merch.sold||0)+totalSold;
    G.merch.revenue=(G.merch.revenue||0)+Math.max(0,totalRevenue);
  }
  /* v2.1.62 Amper: szczegĂłĹ‚owa FAKTURA â€” gracz widzi co dokĹ‚adnie siÄ™ sprzedaĹ‚o, po jakiej cenie, ile kosztĂłw. */
  if(totalSold>0){
    const _itemsStr=breakdown.map(b=>`${b.emoji} ${b.sold}Ă— ${b.name} â†’ ${b.gross.toLocaleString('pl')} zĹ‚`).join('\n');
    const _grossTotal=breakdown.reduce((s,b)=>s+b.gross,0);
    addNotif(`đź“‹ Faktura merch #${ms.history.length} (dzieĹ„ ${G.day}):\n${_itemsStr}\nđź’Ľ Brutto: ${_grossTotal.toLocaleString('pl')} zĹ‚ Â· Koszty: -${opCost} zĹ‚ Â· NETTO: ${totalRevenue.toLocaleString('pl')} zĹ‚`);
    if(typeof showGain==='function' && totalRevenue>0){
      const _toastBreakdown=breakdown.slice(0,2).map(b=>`${b.emoji}${b.sold}`).join(' ');
      const _extras=breakdown.length>2?` +${breakdown.length-2}`:'';
      showGain(`đź§˘ Merch ${_toastBreakdown}${_extras} Â· +${totalRevenue.toLocaleString('pl')} zĹ‚`,'#9b59b6');
    }
  }
  else if(opCost>0) addNotif(`đź’¸ Merch â€” brak sprzedaĹĽy dziĹ›, koszty utrzymania: -${opCost} zĹ‚`);
  // Trend update co 7 dni
  if(!ms.trend || ms.trend.expiresDay<=G.day){
    const types=merchAvailableTypes();
    const newTrend=types[Math.floor(Math.random()*types.length)];
    /* v2.1.109: trend multiplier skaluje z fame (Wave 7 N20) â€” wczeĹ›niej zawsze Ă—2.0 niezaleĹĽnie od progress.
       Skala: fame 0 â†’ Ă—2.0 (base), fame 50 â†’ Ă—2.5, fame 100 â†’ Ă—3.0. Late game gracz dostaje bigger boost (utrzymuje relevancy). */
    const _trendMult = 2.0 + Math.min(1.0, (G.fame||0)/100);
    ms.trend={type:newTrend, multiplier:_trendMult, expiresDay:G.day+7};
    addNotif(`đź“ Nowy trend: "${MERCH_TYPES[newTrend].name}" na topie przez 7 dni! Boost Ă—${_trendMult.toFixed(1)}`);
  }
  /* v2.1.62 Amper: TYGODNIOWY RAPORT co 7 dni gry â€” podsumowanie sprzedaĹĽy, najlepszy produkt, wykres. */
  if(G.day%7===0 && ms.history.length>=2){
    const last7=ms.history.slice(-7);
    const _weekRev=last7.reduce((s,h)=>s+(h.totalRevenue||0),0);
    const _weekSold=last7.reduce((s,h)=>s+(h.totalSold||0),0);
    if(_weekSold>0 && typeof showMsg==='function'){
      const _avgDay=Math.round(_weekRev/last7.length);
      const _bestDay=last7.reduce((a,b)=>(a.totalRevenue||0)>(b.totalRevenue||0)?a:b);
      showMsg(`đź“Š Tygodniowy raport merch (dzieĹ„ ${G.day})\nSprzedaĹĽ: ${_weekSold} szt Â· Netto: ${_weekRev.toLocaleString('pl')} zĹ‚\nĹšrednia dzienna: ${_avgDay.toLocaleString('pl')} zĹ‚ Â· Najlepszy dzieĹ„: ${_bestDay.day} (${(_bestDay.totalRevenue||0).toLocaleString('pl')} zĹ‚)`,'g',8000);
    }
  }
}

// â”€â”€â”€ MERCH STUDIO UI â”€â”€
let _merchDesignerState={typeId:'tshirt',material:'standard',design:'logo',price:80,isLimited:false};
function renderMerchDesigner(){
  ensureMerchStore();
  const ms=G.merchStore;
  const types=merchAvailableTypes();
  const mats=merchAvailableMaterials();
  const designs=merchAvailableDesigns();
  if(!types.includes(_merchDesignerState.typeId)) _merchDesignerState.typeId=types[0];
  if(!mats.includes(_merchDesignerState.material)) _merchDesignerState.material='standard';
  if(!designs.includes(_merchDesignerState.design)) _merchDesignerState.design=designs[0];
  const sug=calcSuggestedPrice(_merchDesignerState.typeId,_merchDesignerState.material);
  if(_merchDesignerState.price<10) _merchDesignerState.price=sug;
  const previewProduct={...{type:_merchDesignerState.typeId,material:_merchDesignerState.material,design:_merchDesignerState.design,price:_merchDesignerState.price,isLimited:_merchDesignerState.isLimited}};
  const demand=calcDemand(previewProduct);
  const t=MERCH_TYPES[_merchDesignerState.typeId];
  const m=MERCH_MATERIALS[_merchDesignerState.material];
  const cost=Math.round(t.baseCost*m.priceMult);
  const profitPer=_merchDesignerState.price-cost;
  const slotsUsed=ms.products.length, slotsMax=merchSlotCount();
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŽ¨ StĂłĹ‚ projektanta</h2>
    <p class="sub">Zaprojektuj nowy produkt. Sloty: ${slotsUsed}/${slotsMax}. ${slotsUsed>=slotsMax?'<strong style="color:#e74c3c">PeĹ‚ne â€” wycofaj produkt z magazynu lub kup upgrade.</strong>':''}</p>
    <div style="background:#0a1525;border:1px solid #1a3050;border-radius:10px;padding:14px 16px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-weight:700;margin-bottom:8px">đź“ Typ produktu</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        ${types.map(id=>{const tt=MERCH_TYPES[id];const sel=id===_merchDesignerState.typeId;return `<button onclick="window._mDes('typeId','${id}')" style="background:${sel?'#1a3a5a':'#0a1a2a'};border:1px solid ${sel?'#7ec8e3':'#1a2535'};color:${sel?'#fff':'#aaa'};padding:8px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px">${tt.emoji} ${tt.name} <span style="color:#778;font-size:10px">(${tt.baseCost}/${tt.basePrice}zĹ‚)</span></button>`;}).join('')}
      </div>
      ${Object.keys(MERCH_TYPES).filter(id=>!types.includes(id)).length?`<div style="color:#445;font-size:11px;margin-top:6px">đź”’ ${Object.entries(MERCH_TYPES).filter(([id])=>!types.includes(id)).map(([id,t])=>`${t.emoji} ${t.name} (${t.unlock.toLocaleString('pl')} fanĂłw)`).join(' Â· ')}</div>`:''}
    </div>
    <div style="background:#0a1525;border:1px solid #1a3050;border-radius:10px;padding:14px 16px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-weight:700;margin-bottom:8px">đźŽ¨ MateriaĹ‚</div>
      <div style="display:flex;gap:6px">
        ${mats.map(id=>{const mm=MERCH_MATERIALS[id];const sel=id===_merchDesignerState.material;return `<button onclick="window._mDes('material','${id}')" style="background:${sel?'#1a3a5a':'#0a1a2a'};border:1px solid ${sel?'#7ec8e3':'#1a2535'};color:${sel?'#fff':'#aaa'};padding:8px 14px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px">${mm.name} <span style="color:#778;font-size:10px">Ă—${mm.priceMult}</span></button>`;}).join('')}
        ${mats.length<3?`<span style="color:#445;font-size:11px;align-self:center">đź”’ Premium/Luxury â€” kup upgrade w fabryce</span>`:''}
      </div>
    </div>
    <div style="background:#0a1525;border:1px solid #1a3050;border-radius:10px;padding:14px 16px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-weight:700;margin-bottom:8px">âś¨ Design</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        ${designs.map(id=>{const dd=MERCH_DESIGNS[id];const sel=id===_merchDesignerState.design;return `<button onclick="window._mDes('design','${id}')" style="background:${sel?'#1a3a5a':'#0a1a2a'};border:1px solid ${sel?'#7ec8e3':'#1a2535'};color:${sel?'#fff':'#aaa'};padding:8px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px">${dd.name} <span style="color:#778;font-size:10px">Ă—${dd.popMod}</span></button>`;}).join('')}
      </div>
    </div>
    <div style="background:#0a1525;border:1px solid #1a3050;border-radius:10px;padding:14px 16px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-weight:700;margin-bottom:8px">đź’° Cena (sugerowana: ${sug} zĹ‚)</div>
      <input type="range" min="${cost+5}" max="${sug*3}" value="${_merchDesignerState.price}" step="5" oninput="window._mDes('price',+this.value)" style="width:100%;accent-color:#e91e63">
      <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:12px;color:#aaa">
        <span>Cena: <strong style="color:#f1c40f;font-size:14px">${_merchDesignerState.price} zĹ‚</strong></span>
        <span>MarĹĽa: <strong style="color:${profitPer>0?'#27ae60':'#e74c3c'};font-size:14px">${profitPer>0?'+':''}${profitPer} zĹ‚/szt</strong></span>
      </div>
      <label style="display:flex;align-items:center;gap:8px;margin-top:10px;color:#c8a3e3;font-size:12px;cursor:pointer">
        <input type="checkbox" ${_merchDesignerState.isLimited?'checked':''} onchange="window._mDes('isLimited',this.checked)" style="accent-color:#9b59b6">
        đź’Ž Limited edition (maĹ‚a seria, Ă—0.6 popytu, ale prestige)
      </label>
    </div>
    <div style="background:#1a0a2a;border:2px solid #9b59b6;border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="color:#c8a3e3;font-weight:700;margin-bottom:8px">đź“Š PodglÄ…d produktu</div>
      <div style="display:flex;justify-content:space-between;font-size:13px;line-height:1.7">
        <div>
          <div>Typ: <strong style="color:#fff">${t.emoji} ${t.name}</strong></div>
          <div>MateriaĹ‚: <strong style="color:#fff">${m.name}</strong></div>
          <div>Design: <strong style="color:#fff">${MERCH_DESIGNS[_merchDesignerState.design].name}</strong></div>
        </div>
        <div style="text-align:right">
          <div>Koszt produkcji: <strong style="color:#aaa">${cost} zĹ‚/szt</strong></div>
          <div>Cena sprzedaĹĽy: <strong style="color:#f1c40f">${_merchDesignerState.price} zĹ‚/szt</strong></div>
          <div>Szacowany popyt: <strong style="color:#7ec87e">${demand} szt/dzieĹ„</strong></div>
          ${(()=>{
            // Realistyczna prognoza: uwzglÄ™dnia cap (max produkcja/dzieĹ„) i koszty utrzymania
            const slotsExisting=ms.products.length;
            const slotsAfter=slotsExisting+1;
            const cap=merchCapacity();
            const capPerSlot=Math.floor(cap/slotsAfter);
            const sold=Math.max(0,Math.min(demand,capPerSlot));
            const grossThisProd=sold*profitPer;
            // OpCost wzroĹ›nie o pensjÄ™ slotu (25 zĹ‚)
            const opCostNow=ms.products.length>0?merchDailyOperatingCost():0;
            const opCostAfter=opCostNow+25+(ms.products.length===0?100:0); // jeĹ›li pierwszy produkt - dolicz base rent
            const opCostDelta=opCostAfter-opCostNow;
            const nettoDelta=grossThisProd-opCostDelta;
            const capWarn=demand>capPerSlot?`<div style="color:#f39c12;font-size:11px">âš ď¸Ź popyt > limit produkcji (${capPerSlot}/dzieĹ„ przy ${slotsAfter} slotach)</div>`:'';
            return `<div style="color:#27ae60;font-size:15px;margin-top:4px">Prognoza sprzedaĹĽy: <strong>${sold} szt Ă— ${profitPer} = ${Math.max(0,grossThisProd)} zĹ‚/dzieĹ„</strong></div>
            <div style="color:#e07070;font-size:11px">Koszty utrzymania: -${opCostDelta} zĹ‚/dzieĹ„</div>
            <div style="color:${nettoDelta>0?'#27ae60':'#e07070'};font-size:13px;margin-top:2px">Netto z tego produktu: <strong>${nettoDelta>0?'+':''}${nettoDelta} zĹ‚/dzieĹ„</strong></div>
            ${capWarn}`;
          })()}
        </div>
      </div>
    </div>
    <button class="dbtn" style="width:100%;padding:14px;font-size:15px" ${slotsUsed>=slotsMax||profitPer<=0?'disabled':''} onclick="window._mDesPublish()">đźš€ Wystaw produkt na sprzedaĹĽ</button>
    <button class="cbtn" style="margin-top:10px" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
}
window._mDes=(key,val)=>{_merchDesignerState[key]=val;renderMerchDesigner();};
window._mDesPublish=()=>{
  ensureMerchStore();
  const ms=G.merchStore;
  if(ms.products.length>=merchSlotCount()){showMsg('âš ď¸Ź Brak slotĂłw. Wycofaj produkt lub kup upgrade.','r');return;}
  const s=_merchDesignerState;
  const t=MERCH_TYPES[s.typeId];
  const m=MERCH_MATERIALS[s.material];
  const cost=Math.round(t.baseCost*m.priceMult);
  if(s.price<=cost){showMsg('âš ď¸Ź Cena musi byÄ‡ wyĹĽsza niĹĽ koszt produkcji.','r');return;}
  ms.products.push({
    id:ms.nextProductId++,
    type:s.typeId, material:s.material, design:s.design,
    price:s.price, isLimited:s.isLimited,
    cost:cost,
    releaseDay:G.day,
    dailySales:0, totalSold:0, totalRevenue:0
  });
  notify(`đźš€ Wystawiono "${t.name} ${m.name}" za ${s.price} zĹ‚!`);
  /* v2.1.53 Amper: wymuszony zapis â€” wystawienie produktu zmienia G.merchStore.products, bez tego refresh strony usuwaĹ‚ produkt z RAM. */
  if(typeof saveGameSilent==='function') saveGameSilent();
  renderMerchDesigner();
};
function renderMerchFactory(){
  ensureMerchStore();
  const ms=G.merchStore;
  const cap=merchCapacity();
  const slots=merchSlotCount();
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŹ­ Fabryka â€” upgrade'y</h2>
    <p class="sub">Aktualnie: ${cap} sztuk/dzieĹ„, ${slots} slotĂłw produktu, popyt Ă—${merchPopularityMult().toFixed(2)}</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-bottom:16px">
      ${MERCH_UPGRADES.map(u=>{
        const owned=!!ms.upgrades[u.id];
        const reqMet=!u.requires || ms.upgrades[u.requires];
        const canBuy=!owned && reqMet && G.money>=u.cost;
        return `<div style="background:${owned?'#0a2a1a':'#0a1525'};border:1px solid ${owned?'#27ae60':reqMet?'#1a3050':'#1a1a1a'};border-radius:8px;padding:12px">
          <div style="font-weight:700;color:${owned?'#7ec87e':'#7ec8e3'};margin-bottom:4px">${owned?'âś… ':''}${u.name}</div>
          <div style="color:#aaa;font-size:11px;margin-bottom:8px;line-height:1.4">${u.desc}</div>
          ${u.requires&&!ms.upgrades[u.requires]?`<div style="color:#e74c3c;font-size:11px;margin-bottom:8px">đź”’ Wymaga: ${MERCH_UPGRADES.find(x=>x.id===u.requires)?.name}</div>`:''}
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span style="color:#f1c40f;font-weight:700">${u.cost.toLocaleString('pl')} zĹ‚</span>
            <button onclick="window._mBuyUp('${u.id}')" ${owned||!canBuy?'disabled':''} style="background:${canBuy?'#0a3a1a':'#1a1a1a'};border:1px solid ${canBuy?'#27ae60':'#2a2a2a'};color:${canBuy?'#7ec87e':'#445'};padding:6px 14px;border-radius:5px;cursor:${canBuy?'pointer':'not-allowed'};font-family:inherit;font-size:12px">${owned?'Kupione':'Kup'}</button>
          </div>
        </div>`;
      }).join('')}
    </div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
}
window._mBuyUp=(id)=>{
  ensureMerchStore();
  const u=MERCH_UPGRADES.find(x=>x.id===id);
  if(!u||G.money<u.cost) return;
  if(u.requires && !G.merchStore.upgrades[u.requires]) return;
  if(G.merchStore.upgrades[id]) return;
  G.money-=u.cost;
  G.merchStore.upgrades[id]=true;
  notify(`âś… Upgrade kupiony: ${u.name}`);
  /* v2.1.53 Amper: KRYTYCZNY FIX â€” wymuszony zapis po wydaniu pieniÄ™dzy. Bez tego po refresh wracaĹ‚a stara wartoĹ›Ä‡ G.money (pieniÄ…dze "wracaĹ‚y"), ale upgrade zostawaĹ‚ w G.merchStore bo byĹ‚ zapisany pĂłĹşniej przy innej akcji. */
  if(typeof saveGameSilent==='function') saveGameSilent();
  renderMerchFactory();
};
function renderMerchWarehouse(){
  ensureMerchStore();
  const ms=G.merchStore;
  document.getElementById('ov-content').innerHTML=`
    <h2>đź“¦ Magazyn â€” aktywne produkty</h2>
    <p class="sub">${ms.products.length} z ${merchSlotCount()} slotĂłw. PojemnoĹ›Ä‡ produkcji: ${merchCapacity()} szt/dzieĹ„. <span style="color:#e07070">Koszty utrzymania: -${merchDailyOperatingCost()} zĹ‚/dzieĹ„</span></p>
    ${ms.trend?`<div style="background:#1a0a2a;border:1px solid #9b59b6;border-radius:8px;padding:10px 14px;margin-bottom:14px;color:#c8a3e3">đź“ <strong>Trend: ${MERCH_TYPES[ms.trend.type]?.name}</strong> Ă—${ms.trend.multiplier} popytu (do dnia ${ms.trend.expiresDay})</div>`:''}
    ${ms.products.length===0?'<div style="text-align:center;color:#556;padding:40px">Brak produktĂłw. IdĹş do stoĹ‚u projektanta i wystaw pierwszy!</div>':
      `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px;margin-bottom:16px">
        ${ms.products.map(p=>{
          const t=MERCH_TYPES[p.type], m=MERCH_MATERIALS[p.material], d=MERCH_DESIGNS[p.design];
          const trendActive=ms.trend?.type===p.type;
          return `<div style="background:#0a1525;border:1px solid ${trendActive?'#9b59b6':'#1a3050'};border-radius:8px;padding:12px">
            <div style="font-weight:700;color:#fff;margin-bottom:4px">${t.emoji} ${t.name} ${m.name}${p.isLimited?' đź’Ž':''}${trendActive?' đź“':''}</div>
            <div style="color:#778;font-size:11px;margin-bottom:8px">${d.name} Â· Wystawiony dzieĹ„ ${p.releaseDay}</div>
            <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px">
              <span>Cena: <strong style="color:#f1c40f">${p.price} zĹ‚</strong></span>
              <span>Wczoraj: <strong style="color:#7ec87e">${p.dailySales||0} szt</strong></span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:8px">
              <span>ĹÄ…cznie sprzedano: <strong>${(p.totalSold||0).toLocaleString('pl')}</strong></span>
              <span>PrzychĂłd: <strong style="color:#27ae60">${(p.totalRevenue||0).toLocaleString('pl')} zĹ‚</strong></span>
            </div>
            <button onclick="window._mWithdraw(${p.id})" style="width:100%;background:#2a0a0a;border:1px solid #e74c3c;color:#e07070;padding:6px;border-radius:5px;cursor:pointer;font-family:inherit;font-size:11px">đź—‘ď¸Ź Wycofaj produkt</button>
          </div>`;
        }).join('')}
      </div>`}
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
}
window._mWithdraw=(id)=>{
  ensureMerchStore();
  G.merchStore.products=G.merchStore.products.filter(p=>p.id!==id);
  notify('đź—‘ď¸Ź Produkt wycofany ze sprzedaĹĽy');
  /* v2.1.53 Amper: wymuszony zapis po zmianie listy produktĂłw. */
  if(typeof saveGameSilent==='function') saveGameSilent();
  renderMerchWarehouse();
};
function renderMerchReport(){
  ensureMerchStore();
  const ms=G.merchStore;
  const last7=ms.history.slice(-7);
  const max=Math.max(1,...last7.map(h=>h.totalRevenue||0));
  const total7=last7.reduce((s,h)=>s+(h.totalRevenue||0),0);
  const sold7=last7.reduce((s,h)=>s+(h.totalSold||0),0);
  document.getElementById('ov-content').innerHTML=`
    <h2>đź“Š Raport sprzedaĹĽy</h2>
    <p class="sub">Statystyki z ostatnich 30 dni i prognoza</p>
    <div class="statrow">
      <div class="sbox"><div class="l">Ĺ»ycie firmy â€” przychĂłd</div><div class="v" style="color:#27ae60">${(ms.totalLifetimeRevenue||0).toLocaleString('pl')} zĹ‚</div></div>
      <div class="sbox"><div class="l">Ĺ»ycie firmy â€” sprzedanych</div><div class="v">${(ms.totalLifetimeSold||0).toLocaleString('pl')} szt</div></div>
      <div class="sbox"><div class="l">Ostatnie 7 dni â€” zysk</div><div class="v" style="color:#f1c40f">${total7.toLocaleString('pl')} zĹ‚</div></div>
      <div class="sbox"><div class="l">Ostatnie 7 dni â€” szt</div><div class="v">${sold7.toLocaleString('pl')}</div></div>
    </div>
    ${last7.length>0?`<div style="background:#0a1525;border:1px solid #1a3050;border-radius:8px;padding:16px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-weight:700;margin-bottom:10px">đź“ Wykres przychodu (ostatnie ${last7.length} dni)</div>
      <div style="display:flex;align-items:flex-end;height:140px;gap:8px;border-bottom:1px solid #1a2535;padding-bottom:6px">
        ${last7.map(h=>{const pct=h.totalRevenue/max*100;return `<div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%"><div style="background:linear-gradient(180deg,#27ae60,#0a3a1a);width:100%;height:${pct}%;border-radius:3px 3px 0 0;min-height:2px" title="DzieĹ„ ${h.day}: ${h.totalRevenue} zĹ‚"></div><div style="color:#778;font-size:10px;margin-top:4px">D${h.day}</div></div>`;}).join('')}
      </div>
    </div>`:'<div style="text-align:center;color:#556;padding:30px">Brak danych â€” wystaw produkt i poczekaj na pierwszy dzieĹ„ sprzedaĹĽy.</div>'}
    <div style="background:#0a1525;border:1px solid #1a3050;border-radius:8px;padding:14px;margin-bottom:14px">
      <div style="color:#7ec8e3;font-weight:700;margin-bottom:8px">đź“ Aktualny trend</div>
      ${ms.trend?`<div style="color:#c8a3e3;font-size:14px"><strong>${MERCH_TYPES[ms.trend.type]?.emoji} ${MERCH_TYPES[ms.trend.type]?.name}</strong> â€” produkty tego typu majÄ… Ă—${ms.trend.multiplier} popytu. Trend koĹ„czy siÄ™ dnia ${ms.trend.expiresDay}.</div>`:'<div style="color:#778">Brak aktywnego trendu (resetuje siÄ™ co 7 dni)</div>'}
    </div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
}

// â”€â”€â”€ APARTAMENTY: wejĹ›cie, gotowanie, trofea, luksusowe udogodnienia â”€â”€
const APT_ROOMS={traphouse:'mieszkanie',basic:'mieszkanie',premium:'mieszkanie_premium',luxury:'mieszkanie_lux',mansion:'mieszkanie_lux',mega_villa:'mieszkanie_lux'}; /* v2.1.163: mansion reuses lux interior · v2.1.215: Mega Villa reuses lux (MVP — większy budynek na mapie, identyczny interior) */
const APT_ENTRY_SPAWN={mieszkanie:{wx:686,wy:540},mieszkanie_premium:{wx:838,wy:600},mieszkanie_lux:{wx:1550,wy:670}}; /* v2.1.163: mansion reuses mieszkanie_lux spawn */
function enterApartment(){
  // #73: Eksmisja blokuje wejĹ›cie â€” pokaĹĽ list komorniczy
  if(G.bills?.evicted){showEvictionLetter();return;}
  G._lastEnterDoor=G.apartment; // F+ track ostatnio uĹĽyte drzwi (traphouse jeĹ›li aktualne)
  const room=APT_ROOMS[G.apartment]||'mieszkanie';
  const sp=APT_ENTRY_SPAWN[room]||{wx:530,wy:480};
  startRoomFade(room,sp.wx,sp.wy);
}
// Wejscie do KONKRETNEGO mieszkania (z dedykowanego budynku na mapie)
function enterSpecificApartment(aptId){
  G._ownedApts=G._ownedApts||[];
  // v1.8.83: traphouse jest ZAWSZE owned (startowe mieszkanie). PozostaĹ‚e â€” sprawdĹş w G._ownedApts.
  const isOwned=aptId==='traphouse'||G.apartment===aptId||G._ownedApts.includes(aptId);
  if(!isOwned){
    /* v2.1.172: dodany mansion (poprzednio raw "mansion" w errorze) */
    const aptName=({basic:'Mieszkanie Podstawowe',premium:'Apartament Premium',luxury:'Penthouse',mansion:'Rezydencja'})[aptId]||aptId;
    showMsg(`đź”’ Nie posiadasz tego mieszkania (${aptName}). Wykup w Biurze NieruchomoĹ›ci w mieĹ›cie.`,'r');
    return;
  }
  // F+ 2026-05-12: blokada wejĹ›cia gdy mieszkanie aktualnie wynajÄ™te
  if(G.rentals && G.rentals[aptId]===true && aptId!==G.apartment){
    const aptName=({basic:'Mieszkanie Podstawowe',premium:'Apartament Premium',luxury:'Penthouse',mansion:'Rezydencja'})[aptId]||aptId;
    const noticeDay=G._rentalNotice?.[aptId];
    const noticeTxt=noticeDay?` Wypowiedzenie zĹ‚oĹĽone â€” najem koĹ„czy siÄ™ Dnia ${noticeDay}.`:'';
    showMsg(`đź”’ ${aptName} jest aktualnie WYNAJÄTE. Aby wejĹ›Ä‡ â€” zakoĹ„cz najem w Biurze NieruchomoĹ›ci.${noticeTxt}`,'r');
    return;
  }
  // #73: Eksmisja blokuje wejĹ›cie â€” pokaĹĽ list komorniczy
  if(G.bills?.evicted){showEvictionLetter();return;}
  G._lastEnterDoor=aptId; // F+ track ostatnio uĹĽyte drzwi (apt_basic/apt_premium/apt_penthouse/traphouse)
  const room=APT_ROOMS[aptId]||'mieszkanie';
  const sp=APT_ENTRY_SPAWN[room]||{wx:530,wy:480};
  // v1.8.83: NIE zmieniamy G.apartment przy zwykĹ‚ym wejĹ›ciu (to "main home" â€” zmienia siÄ™ tylko w Biurze NieruchomoĹ›ci).
  // WczeĹ›niejszy bug: wejĹ›cie do traphouse po kupieniu premium nadpisywaĹ‚o G.apartment='traphouse' â€” gracz traciĹ‚ bonusy premium.
  // Inny kierunek tego buga: gracz miaĹ‚ G.apartment='premium' z wczeĹ›niejszego wejĹ›cia, pressE na traphouse szedĹ‚ do PREMIUM (act enter_apt routowaĹ‚ przez G.apartment).
  // Teraz kaĹĽde drzwi (traphouse/basic/premium/luxury) prowadzÄ… do ich wĹ‚asnego pokoju.
  startRoomFade(room,sp.wx,sp.wy);
}
// #73: List komorniczy â€” ekran przy prĂłbie wejĹ›cia do mieszkania po eksmisji
function showEvictionLetter(){
  document.getElementById('eviction-letter')?.remove();
  const totalDue=G.bills.pending.reduce((s,b)=>s+b.amount,0);
  const ov=document.createElement('div');
  ov.id='eviction-letter';
  ov.style.cssText='position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,.85);z-index:9000;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(3px)';
  ov.innerHTML=`
    <div style="background:linear-gradient(160deg,#3a2810,#2a1a08);border:3px solid #c8a520;border-radius:8px;padding:30px 40px;max-width:520px;color:#f5e8c8;font-family:'Georgia',serif;box-shadow:0 0 60px rgba(200,165,32,.4);position:relative">
      <div style="text-align:center;font-size:13px;letter-spacing:3px;color:#c8a520;margin-bottom:6px">URZÄ„D MIASTA Â· WYDZIAĹ EGZEKUCJI</div>
      <div style="height:1px;background:#c8a520;margin-bottom:20px"></div>
      <div style="font-size:22px;font-weight:900;color:#e74c3c;margin-bottom:16px;text-align:center">đź“ś LIST KOMORNICZY</div>
      <div style="font-size:14px;line-height:1.7;margin-bottom:16px">
        Szanowny <b>${G.name||'MieszkaĹ„cu'}</b>,<br><br>
        W zwiÄ…zku z brakiem regulowania naleĹĽnoĹ›ci za czynsz mieszkania <b>"${({basic:'Mieszkanie Podstawowe',premium:'Apartament Premium',luxury:'Penthouse',mansion:'Rezydencja'})[G._evictedFromApt]||CFG.APT_NAMES[G._evictedFromApt]||'mieszkanie'}"</b> przez okres przekraczajÄ…cy <b>5 dni</b>, niniejszym informujemy o <b style="color:#e74c3c">EKSMISJI</b>.
        <br><br>
        DostÄ™p do mieszkania zostaĹ‚ <b style="color:#e74c3c">ZABLOKOWANY</b>. Aby odzyskaÄ‡ klucze, naleĹĽy uregulowaÄ‡ zalegĹ‚e rachunki w peĹ‚nej kwocie:
      </div>
      <div style="background:rgba(0,0,0,.3);border:1px solid #c8a520;border-radius:6px;padding:14px;margin-bottom:18px;text-align:center">
        <div style="color:#c8a520;font-size:11px;letter-spacing:2px;margin-bottom:6px">SUMA DO ZAPĹATY</div>
        <div style="color:#e74c3c;font-size:28px;font-weight:900">${totalDue} zĹ‚</div>
        <div style="color:#a89060;font-size:11px;margin-top:4px">${G.bills.pending.length} aktywne rachunki</div>
      </div>
      <div style="font-size:12px;color:#a89060;margin-bottom:18px;font-style:italic;text-align:center">
        PĹ‚atnoĹ›Ä‡ realizowana przez aplikacjÄ™ bankowÄ… w telefonie (đź“± â†’ đź’¸ Rachunki).
      </div>
      <button onclick="document.getElementById('eviction-letter')?.remove()" style="width:100%;background:#1a1005;border:1px solid #c8a520;color:#c8a520;padding:10px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700">âś• ZrozumiaĹ‚em</button>
    </div>
  `;
  document.body.appendChild(ov);
}
function cookMeal(){
  // Anti-clicker: cooldown 5h gry + max 2x/dobÄ™. Lepsze efekty daje đź”Ą pĹ‚yta indukcyjna z minigrÄ….
  if(G.energy<10){showMsg('âš ď¸Ź Za maĹ‚o energii (potrzeba 10).','r');return;}
  if((G.hunger||0)>=100){showMsg('đźŤ˝ JuĹĽ jesteĹ› najedzony.','r');return;}
  const _now=gameMin||0;
  if(_now-(G._lastQuickCookMin||-9999)<300){
    const _m=Math.ceil(300-(_now-(G._lastQuickCookMin||0)));
    showMsg(`đźŤł Niedawno gotowaĹ‚eĹ› szybki posiĹ‚ek â€” odczekaj ${_m} min`,'r');return;
  }
  if(G._quickCookDay!==G.day){G._quickCookDay=G.day;G._quickCookCount=0;}
  if((G._quickCookCount||0)>=2){showMsg('đźŤł JuĹĽ 2Ă— dzisiaj robiĹ‚eĹ› szybki posiĹ‚ek. SprĂłbuj ugotowaÄ‡ coĹ› na đź”Ą pĹ‚ycie!','r');return;}
  G._lastQuickCookMin=_now;
  G._quickCookCount=(G._quickCookCount||0)+1;
  G.energy=clampStat('energy', G.energy-10);
  G.hunger=eatFood(38);
  G.health=clampStat('health', G.health+5);
  G.stress=clamp(G.stress+5,0,100);
  /* v2.1.26: XP przywrĂłcone z capem */
  addXPFoodCapped(4);
  notify('đźŤł Szybki posiĹ‚ek na wyspie (+38 gĹ‚Ăłd, +5 zdrowie, +5 nastrĂłj). Lepsze efekty na đź”Ą pĹ‚ycie!');
}
function showTrofea(){
  const tracks=G.studioTracks||[];
  const ach=G.achievements||[];
  const goldTracks=tracks.filter(t=>(t.streams||0)>=10000).length;
  const platTracks=tracks.filter(t=>(t.streams||0)>=100000).length;
  document.getElementById('ov-content').innerHTML=`
    <h2>đźŹ† RegaĹ‚ z trofeami</h2>
    <p class="sub">Twoje osiÄ…gniÄ™cia w branĹĽy muzycznej</p>
    <div class="statrow">
      <div class="sbox"><div class="l">ZĹ‚ote pĹ‚yty</div><div class="v" style="color:#f1c40f">${goldTracks}</div></div>
      <div class="sbox"><div class="l">Platynowe pĹ‚yty</div><div class="v" style="color:#aaa">${platTracks}</div></div>
      <div class="sbox"><div class="l">Wydane single</div><div class="v">${tracks.length}</div></div>
      <div class="sbox"><div class="l">ĹÄ…czne streamy</div><div class="v">${tracks.reduce((s,t)=>s+(t.streams||0),0).toLocaleString('pl')}</div></div>
      <div class="sbox"><div class="l">SĹ‚awa</div><div class="v">${Math.floor(G.fame||0)}</div></div>
      <div class="sbox"><div class="l">OsiÄ…gniÄ™cia</div><div class="v">${ach.length}</div></div>
    </div>
    ${tracks.length===0?'<p style="color:#556;text-align:center;margin:20px 0">Brak singli â€” wydaj pierwszy w studiu!</p>':
      `<div style="margin:14px 0"><p style="color:#778;font-size:12px;margin-bottom:8px">SINGLE:</p>${tracks.slice(-8).reverse().map(t=>{
        const s=t.streams||0;
        const status=s>=100000?'đź’Ž Platyna':s>=10000?'đźŹ† ZĹ‚oto':'đźŽµ';
        return `<div style="background:#0a0a0a;border-radius:5px;padding:8px 12px;margin-bottom:5px;font-size:13px;display:flex;justify-content:space-between"><span style="color:#fff">${status} ${t.name}</span><span style="color:#666">${s.toLocaleString('pl')} streamĂłw</span></div>`;
      }).join('')}</div>`}
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
}
function useLuxFacility(kind){
  G._luxToday=G._luxToday||{};
  if(G._luxToday[kind]===G.day){showMsg('âŹł JuĹĽ z tego korzystaĹ‚eĹ› dzisiaj. SprĂłbuj jutro.','r');return;}
  if(G.energy<5){showMsg('âš ď¸Ź Za maĹ‚o energii.','r');return;}
  G._luxToday[kind]=G.day;
  let label='',eg=0,sg=0,hg=0,fg=0;
  if(kind==='pool'){label='đźŹŠ Basen â€” orzeĹşwiajÄ…ca pĹ‚ywalnia.';eg=15;sg=20;G.fitness=Math.min(getMaxStat('fitness'),(G.fitness||0)+1);} /* v2.1.191: cap respect (wczeĹ›niej brak cap) */
  else if(kind==='jacuzzi'){label='â™¨ď¸Ź Jacuzzi â€” bÄ…belki rozluĹşniajÄ….';sg=30;eg=8;}
  else if(kind==='sauna'){label='đź§– Sauna â€” pot wyparowuje stres.';sg=35;eg=-5;hg=4;}
  else if(kind==='firepit'){label='đź”Ą WieczĂłr przy ognisku z widokiem na miasto.';sg=25;fg=2;}
  G.energy=clampStat('energy', G.energy+eg);
  G.stress=clamp(G.stress+sg,0,100);
  G.health=clampStat('health', G.health+hg);
  if(fg>0) G.fame=clamp(G.fame+fg,0,500);
  addXP(4);
  notify(`${label} +${sg} nastrĂłj${eg!==0?', '+(eg>0?'+':'')+eg+' energii':''}${hg?', +'+hg+' zdrowia':''}${fg?', +'+fg+' sĹ‚awy':''}`);
}

// â”€â”€â”€ SAVE/LOAD: auto-save w tle + opcjonalny plik dyskowy via File System Access API â”€â”€
let _autoSaveTimer=null;
let _saveFileHandle=null;
let _fsPromptShown=false;
let _currentSlot=parseInt(localStorage.getItem('snowy_active_slot')||'1',10);
function getSaveKey(){return `snowy_v5_slot${_currentSlot}`;}
// SAVE_KEY zachowane jako alias dla kompatybilnoĹ›ci wstecznej
const SAVE_KEY_LEGACY='snowy_v5';
Object.defineProperty(window,'SAVE_KEY',{get:()=>getSaveKey()});
// Jednorazowa migracja: stary 'snowy_v5' â†’ slot 1
// v1.9.11: try/catch dla quota errors
try{
  if(localStorage.getItem(SAVE_KEY_LEGACY) && !localStorage.getItem('snowy_v5_slot1')){
    localStorage.setItem('snowy_v5_slot1', localStorage.getItem(SAVE_KEY_LEGACY));
    localStorage.removeItem(SAVE_KEY_LEGACY);
  }
}catch(e){console.warn('Legacy save migration quota error:',e);}
function getSlotMeta(slot){
  const raw=localStorage.getItem(`snowy_v5_slot${slot}`);
  if(!raw) return null;
  try{
    const p=JSON.parse(raw);
    /* v2.1.145: slotLabel = custom name dla slotu (override character name jeĹ›li ustawione). Fallback na character name. */
    const label=p._slotLabel || p.G?.name || '?';
    return {slot, name:label, charName:p.G?.name||'?', day:p.G?.day||1, money:p.G?.money||0, savedAt:p.savedAt, customLabel:!!p._slotLabel};
  }catch{return null;}
}
/* v2.1.145: rename slot â€” pozwala graczowi nazwaÄ‡ slot (np. "Speedrun", "Test Prestige"). Override character name w slot picker. */
window.renameSlot=(slot)=>{
  const raw=localStorage.getItem(`snowy_v5_slot${slot}`);
  if(!raw){if(typeof showMsg==='function')showMsg('âš ď¸Ź Slot pusty','r');return;}
  const meta=getSlotMeta(slot);
  if(!meta) return;
  /* Modal z input dla nowej nazwy slotu */
  const ov=document.createElement('div');
  ov.style.cssText='position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.8);z-index:9001;display:flex;align-items:center;justify-content:center;font-family:inherit';
  const card=document.createElement('div');
  card.style.cssText='background:#0a0f18;border:1px solid #2a3a5a;border-radius:10px;padding:20px;max-width:380px;width:90%';
  card.innerHTML=`
    <div style="color:#7ec8e3;font-weight:800;font-size:14px;margin-bottom:8px">âśŹď¸Ź ZmieĹ„ nazwÄ™ slotu ${slot}</div>
    <div style="color:#aac;font-size:11px;margin-bottom:12px">Aktualnie: ${meta.customLabel?`<b style="color:#fff">${_escHtml(meta.name)}</b> (postaÄ‡: ${_escHtml(meta.charName)})`:`<b style="color:#fff">${_escHtml(meta.name)}</b>`}</div>
    <input id="slot-rename-input" type="text" maxlength="24" value="${_escHtml(meta.customLabel?meta.name:'')}" placeholder="Nazwa slotu (np. Speedrun, Prestige run)" style="width:100%;background:#050a14;border:1px solid #2a4a6a;color:#fff;padding:8px 10px;border-radius:6px;font-family:inherit;font-size:13px;margin-bottom:12px;box-sizing:border-box">
    <div style="display:flex;gap:8px;justify-content:flex-end">
      ${meta.customLabel?`<button id="slot-rename-reset" style="background:transparent;border:1px solid #5a3a1a;color:#c08550;padding:6px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px">â†ş PrzywrĂłÄ‡</button>`:''}
      <button id="slot-rename-cancel" style="background:transparent;border:1px solid #2a2535;color:#778;padding:6px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px">âś• Anuluj</button>
      <button id="slot-rename-save" style="background:#0a3a1a;border:1px solid #27ae60;color:#7ec87e;padding:6px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px;font-weight:700">âś“ Zapisz</button>
    </div>`;
  ov.appendChild(card);
  document.body.appendChild(ov);
  const inp=card.querySelector('#slot-rename-input');
  inp.focus();inp.select();
  const close=()=>ov.remove();
  card.querySelector('#slot-rename-cancel').onclick=close;
  card.querySelector('#slot-rename-save').onclick=()=>{
    const newLabel=inp.value.trim().slice(0,24);
    try{
      const p=JSON.parse(localStorage.getItem(`snowy_v5_slot${slot}`));
      if(newLabel) p._slotLabel=newLabel; else delete p._slotLabel;
      localStorage.setItem(`snowy_v5_slot${slot}`,JSON.stringify(p));
      close();
      if(typeof refreshContinueButton==='function')refreshContinueButton();
    }catch(e){if(typeof showMsg==='function')showMsg('âš ď¸Ź BĹ‚Ä…d zapisu: '+e.message,'r');}
  };
  const resetBtn=card.querySelector('#slot-rename-reset');
  if(resetBtn){resetBtn.onclick=()=>{
    try{
      const p=JSON.parse(localStorage.getItem(`snowy_v5_slot${slot}`));
      delete p._slotLabel;
      localStorage.setItem(`snowy_v5_slot${slot}`,JSON.stringify(p));
      close();
      if(typeof refreshContinueButton==='function')refreshContinueButton();
    }catch(e){}
  };}
  /* Enter zapisuje */
  inp.addEventListener('keydown',e=>{if(e.key==='Enter')card.querySelector('#slot-rename-save').click();});
};
function selectSlot(slot){
  _currentSlot=slot;
  localStorage.setItem('snowy_active_slot',String(slot));
}
