window.applyVerification = function(){
  if(!G.spotify) G.spotify = {listeners:0,streams:0,royalties:0};
  if(G.spotify.verified) return;
  if(G.spotify.verifyAppliedDay) return;
  G.spotify.verifyAppliedDay = G.day;
  if(typeof addNotif==='function') addNotif('đź“¤ Wniosek o weryfikacjÄ™ wysĹ‚any â€” odpowiedĹş za 3 dni');
  if(typeof renderPhoneApp==='function') renderPhoneApp('spotify');
};
/* v2.0.26: oznacz ĹĽe admin cheat zostaĹ‚ uĹĽyty â€” zapobiega chain reaction cinematicktĂłw kariera.
   PowĂłd: maxStats ustawia fame/streetRep/etc. â†’ checkAchievements odpala wiele achievementĂłw â†’
   addXP() â†’ level roĹ›nie â†’ checkCareerUnlocks â†’ cinematic gamer/etc. To irytujÄ…ce dla gracza
   bo wyglÄ…da jak "losowy" cinematic. Z flagÄ… set, cinematic kariera sÄ… od razu zaznaczone jako
   "shown" â€” nie odpalÄ… siÄ™ ani teraz, ani w przyszĹ‚oĹ›ci. */
function _adminMarkCheatUsed(){
  G._adminCheatUsed = true;
  G._careerCinemEverShown = G._careerCinemEverShown || {};
  ['youtuber','gamer','beatmaker','influencer','soundeng','merch'].forEach(k=>{G._careerCinemEverShown[k]=true;});
}
function adminMaxStats(){
  _adminMarkCheatUsed();
  /* v2.1.196: adminMaxStats â€” drip bug fix Math.max â†’ Math.min(...,200). WczeĹ›niej `Math.max(G.drip||0, 100)` ustawiaĹ‚ MIN 100 (NIE max), drip pozostawaĹ‚ poniĹĽej 200 (UI max). */
  G.fitness=getMaxStat('fitness'); G.forma=getMaxStat('forma'); G.drip=Math.min(200,Math.max(G.drip||0,200));
  G.health=getMaxStat('health');G.energy=getMaxStat('energy');G.hunger=getMaxStat('hunger');G.stress=100;
  G.money=Math.max(G.money,10000);G.fame=500;G.streetRep=100; /* v2.1.212: admin max fame 100→500 (nowy cap) */
  updateHUD();
  document.getElementById('adm-msg').textContent='âś… Statystyki zmaks. (forma/drip/health/energy/hunger/fame/streetRep)';
}
function adminMaxRaperTree(){
  _adminMarkCheatUsed();
  G.raperST={flow:5,teksty:5,produkcja:5,realizacja:5,mikser:5,autopromocja:5,biznes:5,scena:5,kondycja:5};
  document.getElementById('adm-msg').textContent='âś… Drzewko rapera zmaks. (9 gaĹ‚Ä™zi Ă— 5 lvl)';
}
function adminMaxAllSkills(){
  _adminMarkCheatUsed();
  if(!G.skills) G.skills={};
  let count=0;
  for(const key in SKILL_DEF){
    const def=SKILL_DEF[key];
    setSkillLvl(key, def.max);
    if(def.powerUps && def.powerUps.length){ setSkillPowerUps(key, def.powerUps.length); }
    if(def.evolution){ setSkillEvolution(key, true); }
    count++;
  }
  document.getElementById('adm-msg').textContent=`âś… Wszystkie ${count} skills zmaks. (lvl + power-ups + evolution)`;
}
function adminMaxFans(){
  _adminMarkCheatUsed();
  /* v2.1.34: dwie niezaleĹĽne metryki â€” 1mln obserwujÄ…cych + 200k fanĂłw lojalnych */
  G.followers=Math.max(G.followers||0,1000000);
  G.fans=Math.max(G.fans||0,200000);
  updateHUD();
  document.getElementById('adm-msg').textContent='âś… 1mln obserwujÄ…cych + 200k fanĂłw lojalnych';
}
function adminMaxAll(){
  adminMaxStats();
  adminMaxRaperTree();
  adminMaxAllSkills();
  adminMaxFans();
  adminGiveGear();
  if(typeof adminUnlockAll==='function') adminUnlockAll();
  G.skillPoints=(G.skillPoints||0)+50;
  G.money=Math.max(G.money||0,1000000);
  updateHUD();
  document.getElementById('adm-msg').textContent='đźŚź MAKS WSZYSTKO: staty + drzewko rapera + skille + fani + sprzÄ™t + odblokowane + 1mln zĹ‚ + 50 SP';
}
