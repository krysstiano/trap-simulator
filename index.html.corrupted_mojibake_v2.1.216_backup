  document.getElementById('ov-content').innerHTML=`
    <h2>đźĄ¬ Targ</h2><p class="sub">Tanie jedzenie prosto od sprzedawcĂłw â€” wszystkie zakupy lÄ…dujÄ… w lodĂłwce. Zjedz potem przy stole đźŤ˝ lub ugotuj đź”Ą.</p>
    <p style="color:#667;font-size:13px;margin-bottom:8px">đź§Š W lodĂłwce: <strong style="color:#7ec87e">${fridgeQty}</strong> sztuk</p>
    <div class="shopgrid">
      <div class="sitem"><h3>đźĄ– Chleb</h3><p>+25 gĹ‚Ăłd Â· tanio</p><div class="pr">5 zĹ‚</div><button class="bbtn" onclick="buyItemTarg('targ_bread','đźĄ– Chleb',5,25,0,0,0)">Do lodĂłwki</button></div>
      <div class="sitem"><h3>đźĄš Jajka</h3><p>+30 gĹ‚Ăłd Â· +5 zdrowie</p><div class="pr">8 zĹ‚</div><button class="bbtn" onclick="buyItemTarg('targ_eggs','đźĄš Jajka',8,30,0,5,0)">Do lodĂłwki</button></div>
      <div class="sitem"><h3>đźŤŽ Warzywa</h3><p>+35 gĹ‚Ăłd Â· +8 zdrowie</p><div class="pr">10 zĹ‚</div><button class="bbtn" onclick="buyItemTarg('targ_veg','đźŤŽ Warzywa',10,35,0,8,0)">Do lodĂłwki</button></div>
      <div class="sitem"><h3>đźŤ— Kurczak</h3><p>+55 gĹ‚Ăłd Â· +12 zdrowie</p><div class="pr">18 zĹ‚</div><button class="bbtn" onclick="buyItemTarg('targ_chicken','đźŤ— Kurczak',18,55,0,12,0)">Do lodĂłwki</button></div>
      <div class="sitem"><h3>đźŤ˛ Zupa</h3><p>+45 gĹ‚Ăłd Â· +10 nastrĂłj</p><div class="pr">12 zĹ‚</div><button class="bbtn" onclick="buyItemTarg('targ_soup','đźŤ˛ Zupa',12,45,0,0,10)">Do lodĂłwki</button></div>
      <div class="sitem"><h3>đźĄ— SaĹ‚atka</h3><p>+20 gĹ‚Ăłd Â· +5 zdrowie Â· +8 nastrĂłj</p><div class="pr">9 zĹ‚</div><button class="bbtn" onclick="buyItemTarg('targ_salad','đźĄ— SaĹ‚atka',9,20,0,5,8)">Do lodĂłwki</button></div>
    </div>
    <div class="res" id="targ-res">Wybierz produkt â€” wszystko trafia do lodĂłwki.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  window.buyItemTarg=(id,name,cost,hunger,energy,health,mood)=>{
    if(G.money<cost){document.getElementById('targ-res').textContent='âťŚ Za maĹ‚o pieniÄ™dzy!';return;}
    G.money-=cost;
    if(!G.fridgeItems) G.fridgeItems=[];
    const existing=G.fridgeItems.find(i=>i.id===id);
    if(existing) existing.qty++;
    else G.fridgeItems.push({id,name,hunger,energy,health,mood,price:cost,qty:1});
    progressQuest('eat');updateHUD();
    renderTarg(); // refresh â€” pokaĹĽ zaktualizowanÄ… liczbÄ™ w lodĂłwce
  };
}

function renderWarsztat(){
  const camBroken=G.camera&&G.camera.quality<(G.camera.origQuality||G.camera.quality)*0.9;
  const micBroken=G.mic&&G.mic.quality<(G.mic.origQuality||G.mic.quality)*0.9;
  const midiB=G.midiCtrl&&G.midiCtrl.quality<(G.midiCtrl.origQuality||G.midiCtrl.quality)*0.9;
  document.getElementById('ov-content').innerHTML=`
    <h2>đź”§ Warsztat â€” Serwis SprzÄ™tu</h2><p class="sub">Napraw sprzÄ™t muzyczny (kamera đź“ą / mikrofon đźŽ¤ / MIDI đźŽą) i samochĂłd đźš—. Uszkodzony sprzÄ™t obniĹĽa jakoĹ›Ä‡ Twoich nagraĹ„.</p>
    <div class="shopgrid">
      <div class="sitem"><h3>đź“ą Kamera</h3>
        <p>${G.camera?G.camera.name+' (jakoĹ›Ä‡: '+G.camera.quality+'%)':'Brak kamery'}</p>
        ${G.camera?`<div class="pr">Naprawa: ${Math.max(50,Math.floor((100-G.camera.quality)*15))} zĹ‚</div>
        <button class="bbtn" ${G.camera.quality>=100||G.money<Math.max(50,(100-G.camera.quality)*15)?'disabled':''} onclick="repairGear('camera')">Napraw</button>`:'<div style="color:#556;font-size:12px">Nie posiadasz</div>'}
      </div>
      <div class="sitem"><h3>đźŽ¤ Mikrofon</h3>
        <p>${G.mic?G.mic.name+' (jakoĹ›Ä‡: '+G.mic.quality+'%)':'Brak mikrofonu'}</p>
        ${G.mic?`<div class="pr">Naprawa: ${Math.max(50,Math.floor((100-G.mic.quality)*12))} zĹ‚</div>
        <button class="bbtn" ${G.mic.quality>=100||G.money<Math.max(50,(100-G.mic.quality)*12)?'disabled':''} onclick="repairGear('mic')">Napraw</button>`:'<div style="color:#556;font-size:12px">Nie posiadasz</div>'}
      </div>
      <div class="sitem"><h3>đźŽą MIDI</h3>
        <p>${G.midiCtrl?G.midiCtrl.name+' (jakoĹ›Ä‡: '+G.midiCtrl.quality+'%)':'Brak kontrolera'}</p>
        ${G.midiCtrl?`<div class="pr">Naprawa: ${Math.max(30,Math.floor((100-G.midiCtrl.quality)*8))} zĹ‚</div>
        <button class="bbtn" ${G.midiCtrl.quality>=100||G.money<Math.max(30,(100-G.midiCtrl.quality)*8)?'disabled':''} onclick="repairGear('midi')">Napraw</button>`:'<div style="color:#556;font-size:12px">Nie posiadasz</div>'}
      </div>
      <div class="sitem"><h3>đźš— SamochĂłd</h3>
        <p>${G.car?G.car.name+' (stan: OK)':'Brak samochodu'}</p>
        ${G.car?`<div class="pr">PrzeglÄ…d: 200 zĹ‚</div>
        <button class="bbtn" ${G.money<200?'disabled':''} onclick="repairGear('car')">PrzeglÄ…d</button>`:'<div style="color:#556;font-size:12px">Nie posiadasz</div>'}
      </div>
    </div>
    <div class="res" id="warz-res">Wybierz co naprawiÄ‡.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  window.repairGear=(type)=>{
    let cost=0,msg='';
    if(type==='camera'&&G.camera){cost=Math.max(50,Math.floor((100-G.camera.quality)*15));G.camera.quality=100;msg='đź“ą Kamera naprawiona â€” jakoĹ›Ä‡ 100%!';}
    else if(type==='mic'&&G.mic){cost=Math.max(50,Math.floor((100-G.mic.quality)*12));G.mic.quality=100;G.mic.origQuality=100;msg='đźŽ¤ Mikrofon naprawiony â€” jakoĹ›Ä‡ 100%!';}
    else if(type==='midi'&&G.midiCtrl){cost=Math.max(30,Math.floor((100-G.midiCtrl.quality)*8));G.midiCtrl.quality=100;msg='đźŽą MIDI naprawiony â€” jakoĹ›Ä‡ 100%!';}
    else if(type==='car'&&G.car){cost=200;msg='đźš— PrzeglÄ…d wykonany!';}
    if(cost>0){G.money-=cost;document.getElementById('warz-res').textContent=`âś… ${msg} -${cost} zĹ‚`;renderWarsztat();}
  };
}

