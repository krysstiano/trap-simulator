        ${scTracks.slice(0,8).map(t=>`
        <div style="display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid #1a0a05">
          <div style="font-size:14px">đźŽµ</div>
          <div style="flex:1;min-width:0">
            <div style="color:#fff;font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.name||'(bez nazwy)'}</div>
            <div style="color:#a87;font-size:10px">${(GENRES[t.genre]?.name)||t.genre||'?'} Â· ${(t.streams||0).toLocaleString('pl')} â–¶</div>
