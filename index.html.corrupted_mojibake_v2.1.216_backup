  /* Tier 2 Famous (fame 200+) — International tour, cooldown 30 dni gry */
  {name:'International tour offer', chance:0.004, maxPerDay:1,
    cond:()=>_evPhoneSpot()&&(G.fame||0)>=200&&(G.fans||0)>=10000&&((G.day||0)-(G._lastIntlTourDay||0))>=30,
    fn:()=>{
      G._lastIntlTourDay=G.day;
      const cash=rnd(10000,25000);
      if(typeof earn==='function') earn(cash,false); else {G.money+=cash;G.totalEarned=(G.totalEarned||0)+cash;}
      /* addFame(24) — przy Tier 2 (fame 200-300) ÷2 = +12 fame final */
      if(typeof addFame==='function') addFame(24); else G.fame=Math.min(500,(G.fame||0)+12);
      if(typeof addFans==='function') addFans(500);
      if(typeof confetti==='function') confetti(40);
