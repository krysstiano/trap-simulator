function generateDailyQuest(){
  /* v2.1.118: Wave 6 N18 â€” anti repeat (gracz nie dostaje tego samego target 2 dni z rzÄ™du). */
  const _lastTarget=G._lastDailyQuestTarget||null;
  // Filtruj questy dostÄ™pne dla aktualnego stanu gracza
  let available=QUEST_POOL.filter(q=>!q.cond||q.cond());
  if(_lastTarget){
    const _filtered=available.filter(q=>q.target!==_lastTarget);
    if(_filtered.length>0) available=_filtered; /* preferuj inne, ale jeĹ›li ĹĽadnego â€” pozwĂłl repeat */
  }
  const pool=available.length>0?available:QUEST_POOL.filter(q=>!q.cond); // fallback do zawsze-dostÄ™pnych
  const q=pool[rnd(0,pool.length-1)];
  G.dailyQuest={...q,progress:0,completed:false,day:G.day};
  G._lastDailyQuestTarget=q.target;
  addNotif('âť“ Nowe zlecenie dnia: '+q.desc+' (Nagroda: '+q.reward+' zĹ‚)');
}

function progressQuest(target){
  // Licznik wykonanych prac dorywczych (storyline #1 â€” Pierwsza wypĹ‚ata)
  // Zlicza TYLKO faktyczne ukoĹ„czenia minigier prac, nie eventĂłw/darowizn.
  if(['pizza','supermarket','carwash','construction','kurier','zmywak'].includes(target)){
    G._jobsCompleted=(G._jobsCompleted||0)+1;
  }
  // Storyline natychmiast â€” bez czekania na tickDecay (6s) â€” naprawia opĂłĹşnienie zaliczania krokĂłw
  if(typeof checkStoryline==='function') checkStoryline();
  if(!G.dailyQuest||G.dailyQuest.completed) return;
  if(G.dailyQuest.target===target){
    G.dailyQuest.progress++;
    if(G.dailyQuest.progress>=G.dailyQuest.count){
      G.dailyQuest.completed=true;
      G.dailyQuest.claimed=false;
      showMsg(`âś… Zlecenie dnia wykonane! Odbierz nagrodÄ™ od Wiktora.`);
      addNotif(`âś… Quest gotowy: "${G.dailyQuest.desc}" â€” idĹş do Wiktora!`);
    }
  }
}
function claimQuestReward(){
  if(!G.dailyQuest||!G.dailyQuest.completed||G.dailyQuest.claimed) return;
  const charMult=getCharyzmaBonus(); // F3-FIX-B: hierarchia skill+PU+evo
  const reward=Math.floor(G.dailyQuest.reward*charMult);
  earn(reward,false);addXP(G.dailyQuest.xp);G.dailyQuest.claimed=true;
  if(typeof addFriendship==='function')addFriendship('wiktor',5);
  G._sideQuestsCompleted=(G._sideQuestsCompleted||0)+1;
  notify(`đź’° Nagroda odebrana: +${reward} zĹ‚, +${G.dailyQuest.xp} XP${charMult>1?' âś¨':''}`);
  closeOverlay();
}

