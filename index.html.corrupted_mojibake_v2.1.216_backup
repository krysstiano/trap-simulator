  booking: {
    name:'đź“… Booking Agent â€” Marcin',
    lines:[
      'Sam koncerty zagrasz w Sali Koncertowej â€” ja organizujÄ™ EKSKLUZYWNE eventy poza miastem.',
      'Festiwale, trasy miÄ™dzynarodowe, prywatne gale. Tutaj kasa jest wiÄ™ksza.',
      'Mam kontakty z duĹĽymi promotorami. Ale potrzebujÄ™ sĹ‚awy.',
    ],
    opts:[
      // Marcin daje TYLKO: Festiwal + World Tour. Standardowe koncerty (maĹ‚a/klub/arena) sÄ… w Sali Koncertowej.
      /* v2.1.50 Amper: festiwal mocno znerfowany â€” duĹĽe wymogi, cooldown 7 dni, baza 2500-7000 zamiast 8000-25000.
         Bez cooldownu moĹĽna byĹ‚o graÄ‡ codziennie po 15k+ zĹ‚, Ĺ‚amiÄ…c caĹ‚y balans early-mid game. */
      {text:()=>{
          const lastFest=G._lastFestivalDay||0;
          const daysSince=(G.day||0)-lastFest;
          const cooldownLeft=Math.max(0,7-daysSince);
          if(cooldownLeft>0) return `đźŽŞ Slot na Festiwalu (cooldown: ${cooldownLeft} ${cooldownLeft===1?'dzieĹ„':'dni'})`;
          return 'đźŽŞ Slot na Festiwalu (5000 zĹ‚, 70 sĹ‚awy, 10 000 fanĂłw, đźŽŞ Scena 4+)';
        },
        cond:()=>(getRaperST('scena')||0)>=4,
        fn:()=>{
          const lastFest=G._lastFestivalDay||0;
          const daysSince=(G.day||0)-lastFest;
          if(daysSince<7){showMsg(`đźŽŞ Festiwale sÄ… raz na tydzieĹ„. NastÄ™pny za ${7-daysSince} dni gry.`,'r');return;}
          if(G.fame<70){showMsg('Potrzebujesz 70 sĹ‚awy! Buduj rozpoznawalnoĹ›Ä‡ koncertami i mediami.','r');return;}
          if((G.fans||0)<10000){showMsg(`Festiwale wymagajÄ… minimum 10 000 fanĂłw (masz ${(G.fans||0).toLocaleString('pl')}).`,'r');return;}
          if(G.money<5000){showMsg('Potrzebujesz 5 000 zĹ‚ wpisowego!','r');return;}
          if((G.energy||0)<50){showMsg('âšˇ Za maĹ‚o energii (potrzeba 50)','r');return;}
          if(G.weather===5){showMsg('â›ď¸Ź Burza! Festiwal plenerowy odwoĹ‚any â€” wrĂłÄ‡ po pogodzie.','r');return;}
          G.money-=5000;G.energy=Math.max(0,G.energy-50);
          G._lastFestivalDay=G.day||0;
          // Pogoda wpĹ‚ywa na zarobek koncertu plenerowego
          let earnMult=1;
          if(G.weather===0) earnMult=1.2;       // sĹ‚oĹ„ce â€” wiÄ™cej publiki
          else if(G.weather===2) earnMult=0.8;  // deszcz
          else if(G.weather===3) earnMult=0.85; // Ĺ›nieg
          /* v2.1.203 [Amper]: cinematic przeniesiony do endConcert (post-minigame) â€” wczeĹ›niej blokowaĹ‚ widocznoĹ›Ä‡ minigry. */
          closeNPCDlg();
          startConcertMG('Festiwal',5000,70,Math.round(2500*earnMult),Math.round(7000*earnMult));
        }
      },
      {text:'đźŚŤ World Tour (50k fanĂłw, 10k zĹ‚, đźŽŞ Scena lvl 4+) â€” 5 miast',
        cond:()=>(getRaperST('scena')||0)>=4,
        fn:()=>{
          // v1.8.65: jeĹ›li trasa juĹĽ aktywna (np. wstrzymana z powodu energii) â€” kontynuuj zamiast blokowaÄ‡
          if(G._tourActive){
            closeNPCDlg();
            const t=G._tourActive;
            showMsg(`đźŚŤ Wracasz do trasy â€” ${t.cities[t.day]} (${t.day+1}/${t.cities.length})`,'p');
            runTourDay();
            return;
          }
          if((G.fans||0)<50000){showMsg(`World Tour wymaga 50 000 fanĂłw (masz ${(G.fans||0).toLocaleString('pl')}).`,'r');return;}
          if(G.money<10000){showMsg('Potrzebujesz 10 000 zĹ‚ zaliczki na koszty produkcji.','r');return;}
          G.money-=10000;
          G._tourActive={cities:['Warszawa','Berlin','Londyn','NYC','Tokio'],day:0,totalEarned:0,totalFans:0};
          addFriendship('marcin',15);
          closeNPCDlg();
          runTourDay();
        }
      },
      {text:()=>{const q=SIDE_QUESTS.marcin[0];const p=getSideQuestProgress(q);const done=G.mainQuest?.completed?.includes(q.id);return done?'âś“ '+q.name:`đź“‹ Side: ${q.name} (${p}/${q.target}) Â· đź’š ${G.npcFriendship?.marcin||0}/100`;},
        cond:()=>true,
        fn:()=>{
          const q=SIDE_QUESTS.marcin[0];
          if(G.mainQuest?.completed?.includes(q.id)){notify('âś“ JuĹĽ wykonane');closeNPCDlg();return;}
          const p=getSideQuestProgress(q);
          if(p>=q.target){
            G.mainQuest=G.mainQuest||{currentStep:0,completed:[]};
            G.mainQuest.completed.push(q.id);
            if(q.reward.money) earn(q.reward.money,false);
            if(q.reward.fame){if(typeof addFame==='function')addFame(q.reward.fame);else G.fame=clamp((G.fame||0)+q.reward.fame,0,500);}
            G._sideQuestsCompleted=(G._sideQuestsCompleted||0)+1; // tracker dla "Wielokierunkowy"
            addFriendship('marcin',20);
            showMsg(`đź“‹ ${q.name} â€” wykonane! +${q.reward.money} zĹ‚, +${q.reward.fame} sĹ‚awy. Marcin CiÄ™ zapamiÄ™ta!`);
          } else {
            notify(`đź“‹ ${q.desc}: ${p}/${q.target}`);
          }
          closeNPCDlg();
        }
      },
      {text:'â„ąď¸Ź Standardowe koncerty (MaĹ‚a/Klub/Arena) â†’ Sala Koncertowa',
        fn:()=>{closeNPCDlg();notify('đźŽ¤ IdĹş do Sali Koncertowej (centrum miasta) â€” tam zarezerwujesz MaĹ‚Ä… ScenÄ™, Klub lub ArenÄ™.');}
      },
      {text:'đź”’ Wbij gaĹ‚Ä…Ĺş đźŽŞ Scena (drzewko rapera) do poziomu 3+',
        cond:()=>(getRaperST('scena')||0)<3,
        fn:()=>{closeNPCDlg();notify('đź“… OtwĂłrz Telefon â†’ đźŽ¤ Raper â†’ Drzewko. GaĹ‚Ä…Ĺş đźŽŞ Scena wymaga: Flow lvl 3 + 500 fanĂłw lojalnych. Odblokuj 3 poziomy ĹĽeby graÄ‡ u mnie.');}
      },
      {text:'WyjdĹş', fn:closeNPCDlg},
    ]
  },
