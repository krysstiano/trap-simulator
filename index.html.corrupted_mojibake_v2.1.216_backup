    <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;margin:6px 0 14px">
      ${foods.map(f=>`<div onclick="window.casinoBuyFood('${f.id}')" style="cursor:pointer;background:linear-gradient(150deg,${f.bg},rgba(8,12,24,0.7));border:1px solid ${f.accent}66;border-radius:14px;padding:18px 14px;width:160px;text-align:center;transition:all .25s cubic-bezier(0.22,0.61,0.36,1);backdrop-filter:blur(8px);box-shadow:0 8px 24px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);position:relative;overflow:hidden" onmouseover="this.style.transform='translateY(-4px) scale(1.03)';this.style.boxShadow='0 14px 36px rgba(0,0,0,.55),0 0 22px ${f.accent}40,inset 0 1px 0 rgba(255,255,255,.08)';this.style.borderColor='${f.accent}'" onmouseout="this.style.transform='';this.style.boxShadow='0 8px 24px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04)';this.style.borderColor='${f.accent}66'">
        <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,${f.accent}80,transparent)"></div>
        <div class="emoji-float" style="font-size:42px;filter:drop-shadow(0 4px 14px rgba(0,0,0,.4))">${f.em}</div>
        <div style="color:${f.accent};font-weight:800;margin-top:8px;letter-spacing:.5px;font-size:13px">${f.name}</div>
        <div style="color:#778;font-size:9px;font-style:italic;margin-top:3px">${f.desc}</div>
        <div style="color:#aaa;font-size:10px;line-height:1.5;margin-top:6px">
          đźŤ´ +${f.hunger} gĹ‚Ăłd${f.energy?' Â· âšˇ +'+f.energy:''}<br>
          ${f.mood?'đźŠ +'+f.mood+' nastrĂłj':''}${f.health?' Â· âť¤ď¸Ź +'+f.health+' zdr.':''}${f.fame?' Â· â­ +'+f.fame+' sĹ‚awa':''}
        </div>
        <div style="color:#2eaf5a;margin-top:8px;font-weight:700;font-size:14px">${f.cost} zĹ‚</div>
      </div>`).join('')}
    </div>
    <div id="bar-result" style="text-align:center;min-height:24px;margin:14px;color:#f1c40f"></div>
    <div style="text-align:center"><button onclick="closeOverlay()" class="cbtn">â† WrĂłÄ‡</button></div>
  `;
  openOverlay();
}
/* v2.1.54 Amper: kupno jedzenia w barze kasyna. Identyczna struktura jak drinki, plus aktualizacja gĹ‚odu przez eatFood() (skill Dieta bonus aplikowany). */
window.casinoBuyFood=(type)=>{
  const foods={
    tapas:{cost:50,hunger:35,mood:8},
    burger_royal:{cost:90,hunger:65,energy:12,mood:5},
    sushi_premium:{cost:160,hunger:70,energy:18,mood:12,health:8},
    steak_royal:{cost:220,hunger:85,energy:22,mood:15,fame:1},
    creme_brulee:{cost:70,hunger:25,mood:25},
  };
  const names={tapas:'tapas',burger_royal:'Burger Royal',sushi_premium:'Sushi Premium',steak_royal:'Steak Royal',creme_brulee:'CrĂ¨me BrĂ»lĂ©e'};
  const emojis={tapas:'đźŤ¤',burger_royal:'đźŤ”',sushi_premium:'đźŤŁ',steak_royal:'đźĄ©',creme_brulee:'đźŤ®'};
  const f=foods[type];
  if(!f) return;
  if(G.money<f.cost){
    document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">âš ď¸Ź Brak kasy na to danie!</span>';return;
  }
  /* Anti-exploit: steak Royal max 2/dzieĹ„ (fame), pozostaĹ‚e bez limitu */
  if(type==='steak_royal'){
    if(G._steakRoyalDay!==G.day){G._steakRoyalDay=G.day;G._steakRoyalCount=0;}
    if((G._steakRoyalCount||0)>=2){
      document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">âš ď¸Ź JuĹĽ 2Ă— Steak Royal dziĹ› â€” wrĂłÄ‡ jutro.</span>';return;
    }
  }
  G.money-=f.cost;
  if(typeof spent==='function') spent(f.cost);
  /* eatFood() aplikuje bonus skill Dieta + reset overeat penalty */
  if(typeof eatFood==='function'){G.hunger=eatFood(f.hunger);} else {G.hunger=Math.min(100,(G.hunger||0)+f.hunger);}
  if(f.energy) G.energy=Math.min(100,(G.energy||0)+f.energy);
  if(f.mood) G.stress=Math.min(100,(G.stress||50)+f.mood);
  if(f.health) G.health=Math.min(100,(G.health||0)+f.health);
  let msg=`${emojis[type]} ZjadĹ‚eĹ› ${names[type]}. +${f.hunger} gĹ‚Ăłd`;
  if(f.energy) msg+=`, +${f.energy} energia`;
  if(f.mood) msg+=`, +${f.mood} nastrĂłj`;
  if(f.health) msg+=`, +${f.health} zdrowie`;
  if(type==='steak_royal'){
    /* v2.1.123: Wave 3 K33 â€” addFame Prestige aware */
    if(typeof addFame==='function') addFame(1); else G.fame=Math.min(500,(G.fame||0)+1);
    G._steakRoyalCount=(G._steakRoyalCount||0)+1;
    msg+=`. +1 sĹ‚awa (${G._steakRoyalCount}/2 dziĹ›)`;
  }
  if(typeof progressQuest==='function') progressQuest('eat');
  document.getElementById('bar-result').innerHTML=`<span style="color:#27ae60">${msg}</span>`;
  if(typeof updateHUD==='function') updateHUD();
  if(typeof playEat==='function') playEat();
};
window.casinoBuyDrink=(type,cost,moodGain,energyGain)=>{
  if(G.money<cost){
    document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">âš ď¸Ź Brak kasy!</span>';return;
  }
  /* v2.0.9 EXPLOIT FIX: szampan/whiskey dawaĹ‚y sĹ‚awÄ™ bez limitu â€” 4000 zĹ‚ = +100 sĹ‚awy (full bar = max stat).
     SĹ‚awa to krytyczna stat (sklepy lux, koncerty, sponsorzy) â€” normalnie wymaga tygodni gameplay.
     Limit: szampan max 1 dziennie, whiskey max 3 dziennie. SĹ‚awa z drinkĂłw = "okazjonalny boost", nie farm. */
  if(type==='champagne'){
    if(G._lastChampagneDay===G.day){
      document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">âš ď¸Ź JuĹĽ dziĹ› piĹ‚eĹ› szampana â€” wrĂłÄ‡ jutro.</span>';return;
    }
  }
  if(type==='whiskey'){
    if(G._whiskeyCountDay!==G.day){G._whiskeyCountDay=G.day;G._whiskeyCount=0;}
    if((G._whiskeyCount||0)>=3){
      document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">âš ď¸Ź JuĹĽ 3Ă— whiskey dziĹ› â€” wrĂłÄ‡ jutro.</span>';return;
    }
  }
  G.money-=cost;
  if(typeof spent==='function')spent(cost);
  G.stress=Math.min(100,(G.stress||50)+moodGain);
  G.energy=Math.min(100,(G.energy||50)+energyGain);
  const names={beer:'piwo',cocktail:'koktajl',whiskey:'whiskey',champagne:'szampan'};
  let msg=`đźŤ» WypiĹ‚eĹ› ${names[type]}. +${moodGain} nastrĂłj, +${energyGain} energia.`;
  if(type==='whiskey'){
    /* v2.1.123: Wave 3 K33 â€” addFame Prestige aware */
    if(typeof addFame==='function') addFame(1); else G.fame=Math.min(500,(G.fame||0)+1);
    G._whiskeyCount=(G._whiskeyCount||0)+1;
    msg+=` +1 sĹ‚awa. (${G._whiskeyCount}/3 dziĹ›)`;
  }
  if(type==='champagne'){
    /* v2.1.123: Wave 3 K33 â€” addFame Prestige aware */
    if(typeof addFame==='function') addFame(5); else G.fame=Math.min(500,(G.fame||0)+5);
    G._lastChampagneDay=G.day;
    msg+=' +5 sĹ‚awy! (1Ă— dziennie)';
  }
  document.getElementById('bar-result').innerHTML=`<span style="color:#27ae60">${msg}</span>`;
  if(typeof updateHUD==='function')updateHUD();
  if(typeof sfxCash==='function')sfxCash();
};

