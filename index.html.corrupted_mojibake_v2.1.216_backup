function checkAchievements(){
  // v1.8.18: "anti-achievement" badges (sleep_dep, ewentualnie inne za zĹ‚e zachowanie)
  // dostajÄ… tylko +XP, BEZ +200 zĹ‚ â€” nagradzanie zaniedbaĹ„ nie ma sensu.
  const NEG_ACHIEVEMENTS=['sleep_dep'];
  // v1.9.14: Tiery nagrĂłd zamiast flat 200 zĹ‚. Ĺatwe (first_*) â€” 100, Ĺ›rednie â€” 500, trudne (millionaire, fans100k) â€” 2000, legendary (1M fanĂłw, prestige) â€” 10000.
  /* v2.1.110: REBALANS TIERĂ“W â€” dodane brakujÄ…ce achievementy do tier arrays (Wave 1 W10, Wave 4 K39/W46/S22-S30, Wave 8 S62).
     WczeĹ›niej wiele osiÄ…gniÄ™Ä‡ trudnych dostawaĹ‚o default 100 zĹ‚ zamiast wĹ‚aĹ›ciwego tieru. */
  const TIER_LEGENDARY=['fans_1m','1m_followers','penthouse','prestige5','tracks_50','million_plays','mansion_owner', /* v2.1.167 */
    'casino_whale', /* W4 K39: 100k zĹ‚ kasyno = legendary */
    'casino_megajackpot', /* S22-S30: 50k win = legendary */
    'cover_legend', /* v2.1.108: 5+ okĹ‚adek */
    'awards_legend', /* v2.1.169: 10 awards wins = legendary */
    'signed_phantom' /* v2.1.169: Phantom MC sign 500k zĹ‚ = legendary */];
  const TIER_HARD=['millionaire','100k_followers','tracks_10','signed_label','indie_label','helipad_ride','foodie','old_dog','first_apt_owner',
    'drip_200', /* S22: 200 drip max */
    'music_empire', /* S22: 50k YT subs */
    'investor_pro', /* S22: 50k z inwestycji */
    'casino_poker_royal', /* S22: Royal Flush */
    'awards_5', /* v2.1.169: 5 awards wins = hard */
    'max_forma', /* v2.1.182 (Agent audit): 100/100 forma â€” najtrudniejszy stat (siĹ‚a/bench), powinno byÄ‡ hard tier (2000zĹ‚) zamiast default 100zĹ‚ */
    'max_fitness' /* v2.1.182 (Agent audit): 100/100 fitness â€” analog forma (cardio/bieĹĽnia) */];
  const TIER_MEDIUM=['1k_followers','first_album','first_concert','tracks_5','first_track','10k_followers','social_butterfly','fame_75',
    'fans_500', /* W1 W10: 500 fanĂłw */
    'casino_high_roller', /* W4 W46: 10k zĹ‚ kasyno */
    'casino_jackpot', /* W8 S62: 5k+ win */
    'courier_pro', /* S22: 50 dostaw */
    'all_freestyle', /* S22: 25 freestyle */
    '5_day_streak', /* S22 */
    'concert_star', /* S22: 10 koncertĂłw */
    'all_careers', /* S22: 5 karier */
    'cover_boy', /* v2.1.108: pierwsza okĹ‚adka */
    'all_genres', /* v2.1.169: analog all_careers â€” wydaj singla w 9 gatunkach */
    'first_award', /* v2.1.169: 1 awards win = medium */
    'label_first_artist' /* v2.1.169: pierwszy podpisany artist = medium */];
  const _tierReward=(id)=>{
    if(NEG_ACHIEVEMENTS.includes(id)) return 0;
    if(TIER_LEGENDARY.includes(id)) return 10000;
    if(TIER_HARD.includes(id)) return 2000;
    if(TIER_MEDIUM.includes(id)) return 500;
    return 100; // easy/default
  };
  /* v2.1.110: Wave 8 K75 â€” anty double-claim per achievement.
     `G.achievements` moĹĽe byÄ‡ wyczyszczone przez quit-load exploit, ale `_achievementsClaimed` persistuje raz-uzyskane nagrody. */
  if(!Array.isArray(G._achievementsClaimed)) G._achievementsClaimed=[];
  for(const ach of ACHIEVEMENTS){
    if(!G.achievements.includes(ach.id)&&ach.check()){
      G.achievements.push(ach.id);
      showAchievementPopup(ach);
      const _r=_tierReward(ach.id);
      addNotif(`${ach.icon} OsiÄ…gniÄ™cie: ${ach.name}${_r>0?` (+${_r} zĹ‚)`:''}`);
      addXP(25);
      /* v2.1.110: WypĹ‚aÄ‡ reward TYLKO jeĹ›li nigdy wczeĹ›niej (lifetime claim flag). */
      if(_r>0 && !G._achievementsClaimed.includes(ach.id)){
        G._achievementsClaimed.push(ach.id);
        if(typeof earn==='function') earn(_r,false); else {G.money+=_r;G.totalEarned=(G.totalEarned||0)+_r;}
      }
    }
  }
  // FOLLOWER MILESTONES â€” cinematic dla 1k/10k/100k/1M fanĂłw
  if(typeof showMilestoneCinematic==='function' && typeof _milestoneShown==='function'){
    const f=G.followers||0;
    const milestones=[
      {n:1000,key:'fans1k',emoji:'đź‘Ą',title:'1 000 FANĂ“W',sub:'Twoja pierwsza tysiÄ…czka',tag:'Robisz siÄ™ rozpoznawalny w mieĹ›cie',c:'#7ec8e3',c2:'#3498db'},
      {n:10000,key:'fans10k',emoji:'đź”Ą',title:'10 000 FANĂ“W',sub:'Lokalna gwiazda',tag:'Ludzie ciÄ™ rozpoznajÄ… na ulicy',c:'#e91e8c',c2:'#9b59b6'},
      {n:100000,key:'fans100k',emoji:'â­',title:'100 000 FANĂ“W',sub:'Nazwisko warte coĹ› w branĹĽy',tag:'WytwĂłrnie zaczynajÄ… pukaÄ‡ do drzwi',c:'#f1c40f',c2:'#e67e22'},
      {n:1000000,key:'fans1m',emoji:'đź’Ž',title:'MILION FANĂ“W',sub:'Status legendy',tag:'Twoje nazwisko zna caĹ‚a Polska',c:'#c8a520',c2:'#e91e8c'},
    ];
    for(const m of milestones){
      if(f>=m.n && !_milestoneShown(m.key)){
        showMilestoneCinematic({emoji:m.emoji,title:m.title,subtitle:m.sub,tagline:m.tag,accentColor:m.c,accent2:m.c2,duration:m.n>=100000?5000:4000});
        break;
      }
    }
  }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  LOSOWE EVENTY
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// â•â•â• RANDOM_EVENTS (~1694) â•â•â•
// F+ Audyt 2026-05-11: helpery kontekstu lokacji dla random events
// _isHome â€” mieszkanie (4 warianty) gdzie gracz moĹĽe odebraÄ‡ mail/telefon/list
// _isOnPhoneSpot â€” miejsca gdzie gracz moĹĽe spojrzeÄ‡ w telefon (mieszk + ulica + studio)
const _evHome = () => currentRoom==='mieszkanie' || currentRoom==='mieszkanie_premium' || currentRoom==='mieszkanie_lux';
const _evPhoneSpot = () => _evHome() || currentRoom==='ulica' || currentRoom==='studio';

/* v2.1.214 [Amper]: Sponsor Inbox (Tier 2 Famous, fame 200+) — 6 marek z NPC PR Managers.
   10-dniowy kontrakt, daily payments, renewal/scandal break. Max 2 aktywne. Cooldown 7 dni. */
const SPONSOR_BRANDS = [
  {id:'nike',    name:'Nike',    emoji:'🏃', baseDaily:1000, pr:'Justin',  pers:'sport, motywacyjny', reqFame:200},
  {id:'adidas',  name:'Adidas',  emoji:'🏃', baseDaily:1100, pr:'Klaus',   pers:'precyzja, niemiecki', reqFame:220},
  {id:'supreme', name:'Supreme', emoji:'🧥', baseDaily:1200, pr:'Drake',   pers:'streetwear, ekipowy', reqFame:230, reqRep:50},
  {id:'gucci',   name:'Gucci',   emoji:'👜', baseDaily:1300, pr:'Mara',    pers:'włoska klasa, exclusive', reqFame:240, reqDrip:100},
  {id:'bmw',     name:'BMW',     emoji:'🚗', baseDaily:1400, pr:'Hans',    pers:'biznesowy, niemiecki', reqFame:260, reqLuxCar:true},
  {id:'rolex',   name:'Rolex',   emoji:'⌚', baseDaily:1500, pr:'Dimitri', pers:'prestiżowy, tylko top', reqFame:270},
];
const SPONSOR_LUXCARS = ['Porsche 911','Lamborghini','Ferrari','Rolls-Royce Phantom','Bugatti Chiron'];
function getSponsorBrand(id){return SPONSOR_BRANDS.find(b=>b.id===id);}
function getSponsorDripBoost(){
  const d=G.drip||0;
  if(d>=200) return 1.20;
  if(d>=100) return 1.10;
  return 1.0;
}
function sponsorBrandAvailable(b){
  if((G.activeSponsors||[]).some(s=>s.brandId===b.id)) return false;
  if((G.fame||0)<b.reqFame) return false;
  if(b.reqRep && (G.streetRep||0)<b.reqRep) return false;
  if(b.reqDrip && (G.drip||0)<b.reqDrip) return false;
  if(b.reqLuxCar && !(G.car && SPONSOR_LUXCARS.includes(G.car.name))) return false;
  /* Cooldown 7 dni po wygaśnięciu kontraktu */
  const lastEnd=((G.sponsorHistory||[]).filter(h=>h.brandId===b.id).slice(-1)[0]||{}).endDay||0;
  if(lastEnd>0 && (G.day-lastEnd)<7) return false;
  /* Cooldown 5 dni gdy oferta już wisi */
  if((G.sponsorOffers||[]).some(o=>o.brandId===b.id)) return false;
  return true;
}
/* PR drama messages — różnice osobowości NPCs */
function _sponsorMsgTemplate(type, brand){
  const pr=brand.pr, em=brand.emoji, name=brand.name;
  const templates={
    new_offer: {
      nike:    `Cześć! Justin z Nike. Widziałem Twoje wystąpy — masz energię sportowca. Daily 1000 zł przez 10 dni. Wchodzisz?`,
      adidas:  `Klaus, Adidas Brand Manager. Analizowałem Twoje metryki — pasujesz do naszego ekosystemu. 1100 zł/dzień, 10 dni kontrakt.`,
      supreme: `Yo, Drake z Supreme. Twój styl uliczny pasuje do naszych dropów. 1200 zł na dzień, 10 dni. Pogadamy?`,
      gucci:   `Buongiorno, Mara da Gucci Milano. Twoja estetyka rozpoznana przez naszych dyrektorów. 1300 zł giornalmente, 10 dni esclusiva.`,
      bmw:     `Dzień dobry, Hans z BMW Brand Partnerships. Zauważyliśmy Twoją kolekcję samochodów. 1400 zł dziennie, 10 dni kontraktu.`,
      rolex:   `Greetings. Dimitri, Rolex Cultural Patronage. Twoja pozycja na rynku zasługuje na naszą współpracę. 1500 PLN per day, 10 dni.`,
    },
    expired: {
      nike:    `Kontrakt z Nike skończony. Daj znać czy chcesz odnowienie! - Justin`,
      adidas:  `Kontrakt Adidas zakończony zgodnie z planem. Czekam na decyzję ws. odnowienia. - Klaus`,
      supreme: `Drake tu — kontrakt Supreme się skończył. Wracaj jak będziesz gotowy. - D.`,
      gucci:   `Cara, kontrakt Gucci dobiegł końca. Twoja decyzja o renewal? - Mara`,
      bmw:     `Kontrakt BMW zakończony. Oczekujemy decyzji ws. kontynuacji. - Hans`,
      rolex:   `Contract concluded. We await your renewal decision. - Dimitri`,
    },
    scandal_break: {
      nike:    `Justin: "Niestety musimy zerwać kontrakt po skandalu medialnym. Nike dba o reputację." - SPONSOR LOST`,
      adidas:  `Klaus: "Skandal w mediach naruszył umowę. Kończymy współpracę natychmiast." - SPONSOR LOST`,
      supreme: `Drake: "Ten beef był za grubo bracie. Wycofujemy się." - SPONSOR LOST`,
      gucci:   `Mara: "Mi dispiace, ale po skandalu Gucci wycofuje swoje wsparcie." - SPONSOR LOST`,
      bmw:     `Hans: "Skandal medialny narusza zasady BMW. Zrywamy kontrakt." - SPONSOR LOST`,
      rolex:   `Dimitri: "Rolex nie toleruje skandali. Współpraca anulowana." - SPONSOR LOST`,
    },
    /* v2.1.216 [Amper] AUDIT FIX: 'signed' template — brakowało, fallback dawał generyczny "wiadomość typu signed" */
    signed: {
      nike:    `Justin: "Witaj w rodzinie Nike! Pierwsza wypłata już dzisiaj." 🏃`,
      adidas:  `Klaus: "Adidas-Familie. Pierwsza wypłata aktywowana. Kontrakt formalnie zaczęty."`,
      supreme: `Drake: "Yo, jesteś w! Supreme team welcomes you. Daily money flowing."`,
      gucci:   `Mara: "Benvenuto in Gucci! Kontrakt aktywny — daily 1300 zł trafią na konto."`,
      bmw:     `Hans: "Witamy w BMW Brand Ambassador Program. Daily płatność aktywna."`,
      rolex:   `Dimitri: "Welcome to Rolex elite. First payment processed."`,
    },
  };
  return templates[type]?.[brand.id] || `${em} ${name}: wiadomość typu ${type}`;
}

const RANDOM_EVENTS = [
  {name:'Viral moment!', chance:0.015, maxPerDay:1, cond:()=>{
    // F+ WymĂłg: gracz musi mieÄ‡ przynajmniej 1 wrzucony post/film/wydany utwĂłr
    // F+ Audyt: gracz dowiaduje siÄ™ o viralu przez telefon â€” wymagamy miejsca gdzie go uĹĽywasz
    if(!_evPhoneSpot()) return false;
    if(G.followers <= 100) return false;
    const hasIgPosts = (G.careers && G.careers.influencer && G.careers.influencer.posts > 0);
    const hasYtVideos = (G.yt && G.yt.videos && G.yt.videos.length > 0);
    const hasReleases = (G.studioTracks||[]).some(t => !t.isDemo);
    return hasIgPosts || hasYtVideos || hasReleases;
  }, fn:()=>{
    const gain=Math.floor(G.followers*rnd(10,30)/100);G.followers+=gain;G.yt.subs+=Math.floor(gain*.5);
    /* v2.1.99: Wave 7 K59 â€” Viral moment ZAIMPLEMENTUJ fame reward (Viral beat daje +3 fame, gĹ‚Ăłwny viral event brak â€” naprawiamy obietnicÄ™ "viralowego momentu"). */
    if(typeof addFame==='function') addFame(3); else G.fame=clamp((G.fame||0)+3,0,500);
    /* v2.1.120: Wave 6 W69 â€” cross-platform spillover (viral na 1 platform = +5% pozostaĹ‚e). */
    const _spill=Math.floor(gain*0.05);
    if(G.spotify) G.spotify.listeners=(G.spotify.listeners||0)+_spill;
    if(G.tidal) G.tidal.listeners=(G.tidal.listeners||0)+Math.floor(_spill*0.6);
    if(G.soundcloud) G.soundcloud.listeners=(G.soundcloud.listeners||0)+Math.floor(_spill*0.5);
    // F+ Lepsze frazowanie â€” wskazuje konkretne ĹşrĂłdĹ‚o
    const platform = ((G.yt && G.yt.videos && G.yt.videos.length > 0) ? 'YouTube' :
                     (G.careers && G.careers.influencer && G.careers.influencer.posts > 0) ? 'Instagramie' :
                     'Spotify');
    notify(`đź”Ą TwĂłj ostatni post na ${platform} staĹ‚ siÄ™ viralowy! +${gain} obserwujÄ…cych, +3 sĹ‚awy + spillover na inne platformy!`);
  }},
  {name:'Sponsorship offer', chance:0.02, maxPerDay:1, cond:()=>_evHome()&&G.followers>=1000, fn:()=>{
    /* v2.1.86 Amper: BUFF sponsorship â€” base 80-400 + skalowanie z followers i fame (sponsorzy pĹ‚acÄ… za zasiÄ™g). */
    const pay=Math.floor((rnd(300,1500) + (G.followers||0)*0.02 + Math.min(100,G.fame||0)*15) * (1 + Math.min(0.5, (G.followers||0)/100000))); /* v2.1.212: cap fame coef 100 — fame >100 NIE eksploduje sponsor payout */
    if(typeof earn==='function')earn(pay,false);else{G.money+=pay;G.totalEarned=(G.totalEarned||0)+pay;}
    notify(`đź’Ľ DostaĹ‚eĹ› mail od marki â€” kontrakt sponsorski! +${pay.toLocaleString('pl')} zĹ‚.`);
  }},
  {name:'Equipment broken', chance:0.01, maxPerDay:1, cond:()=>(currentRoom==='studio'||_evHome())&&(G.camera!==null||G.mic!==null), fn:()=>{
    if(G.camera&&Math.random()>.5){G.camera.quality=Math.max(10,G.camera.quality-15);notify('âš ď¸Ź Kamera siÄ™ popsuĹ‚a podczas uĹĽywania! JakoĹ›Ä‡ -15%. Napraw w warsztacie.');}
    else if(G.mic){G.mic.quality=Math.max(10,G.mic.quality-15);notify('âš ď¸Ź Mikrofon zaszwankowaĹ‚! JakoĹ›Ä‡ -15%. Napraw w warsztacie.');}
  }},
  {name:'Lucky day', chance:0.025, maxPerDay:2, cond:()=>currentRoom==='ulica'&&G.timeOfDay<=2, fn:()=>{
    // #84 NERF random events Ă·2 â€” gracz prosiĹ‚ wiÄ™kszy grind
