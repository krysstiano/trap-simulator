// Dynamiczne dodanie NPC z prawdziwych pozycji ROOMS.ulica.objects
// (poprzednio hardkodowane pozycje byĹ‚y nieaktualne â€” Producent pokazywaĹ‚ siÄ™ w innym miejscu niĹĽ faktycznie stoi)
function _refreshMapNpcs(){
  // UsuĹ„ stare wpisy NPC
  for(let i=MAP_LANDMARKS.length-1;i>=0;i--){
    if(MAP_LANDMARKS[i].cat==='npc') MAP_LANDMARKS.splice(i,1);
  }
  if(!ROOMS.ulica||!ROOMS.ulica.objects) return;
  const npcMap={
    'npc_quest':{name:'âť“ Wiktor',emoji:'âť“'},
    'npc_fan':{name:'đź™‹ Fan',emoji:'đź™‹'},
    'npc_manager':{name:'đź¤µ Manager',emoji:'đź¤µ'},
    'npc_booking':{name:'đź“… Booking Agent',emoji:'đź“…'},
    'npc_producer':{name:'đźŽ§ Producent',emoji:'đźŽ§'},
    'npc_vendor':{name:'đźĄ™ Zbyszek (kebab)',emoji:'đźĄ™'},
    'npc_crew':{name:'đź‘Ą Rekrutuj ekipÄ™',emoji:'đź‘Ą'},
  };
  for(const obj of ROOMS.ulica.objects){
    if(!obj.id.startsWith('npc_')) continue;
    const def=npcMap[obj.id];
    if(!def) continue;
    MAP_LANDMARKS.push({wx:obj.wx+(obj.w||34)/2, wy:obj.wy+(obj.h||56)/2, name:def.name, cat:'npc'});
  }
}
if(typeof window!=='undefined') window._refreshMapNpcs=_refreshMapNpcs;
let _mapZoom=1;
let _mapDragHandlers=null; // kontener handlerow do cleanup przy zamykaniu mapy
function openFullMap(){
  if(currentRoom!=='ulica') return;
  if(!G._tutStat)G._tutStat={};G._tutStat.mapOpened=(G._tutStat.mapOpened||0)+1;
  // OdĹ›wieĹĽ pozycje NPC (rzeczywiste z ROOMS.ulica.objects)
  if(typeof _refreshMapNpcs==='function') _refreshMapNpcs();
  document.getElementById('fullmap-overlay')?.remove();
  // Cleanup poprzednie handlery
  if(_mapDragHandlers){_mapDragHandlers.cleanup();_mapDragHandlers=null;}
  const wW=ROOMS.ulica.wT*T, wH=ROOMS.ulica.hT*T;
  const maxW=1140, maxH=560;
  const baseScale=Math.min(maxW/wW, maxH/wH);
  _mapZoom=1;
  const o=document.createElement('div');
  o.id='fullmap-overlay';
  const hudEl=document.getElementById('hud');
  const hudBottom=hudEl?Math.round(hudEl.getBoundingClientRect().bottom)+4:66;
  o.style.cssText=`position:fixed;top:${hudBottom}px;left:0;right:0;bottom:0;background:rgba(0,0,0,.94);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:60;padding:14px;font-family:inherit`;
  o.innerHTML=`
    <div style="color:#7ec8e3;font-size:20px;font-weight:900;letter-spacing:2px;margin-bottom:6px">đź—ş MAPA MIASTA</div>
    <div id="fmap-controls" style="margin-bottom:6px;color:#aaa;font-size:11px">Scroll/+ -/przyciski = zoom Â· Drag = przesuwaj Â· ESC/M = zamknij Â· Zoom: <span id="fmap-zoom">100%</span></div>
    <div id="fmap-scroll-container" style="overflow:auto;max-width:96vw;max-height:80vh;border:2px solid #2a4a6a;border-radius:8px;background:#0a0a14;box-shadow:0 0 40px rgba(0,0,0,.8);user-select:none"><div id="fmap-canvas-wrap" style="position:relative;transform-origin:top left"></div></div>
  `;
  document.body.appendChild(o);
  const wrap=document.getElementById('fmap-canvas-wrap');

  // â”€â”€ Algorytm staggering label-i â€” unika nakladania (lepszy: 2D candidates) â”€â”€
  function placeLabels(zoom){
    const scale=baseScale*zoom;
    const dripIds=['LV','Chanel','HermĂ¨s','Gucci','Balenciaga','Bottega','Dior','Prada'];
    const filtered=MAP_LANDMARKS.filter(lm=>!dripIds.some(d=>lm.name.includes(d)));
    // Sortuj po wy potem wx
    const sorted=filtered.slice().sort((a,b)=>(a.wy-b.wy)||(a.wx-b.wx));
    /* v1.9.90: per-label szerokoĹ›Ä‡ zamiast staĹ‚ej (dĹ‚uĹĽsze nazwy = wiÄ™kszy promieĹ„) */
    const measureLbl=(name)=>{
      const len=name.length;
      /* v2.1.184: 4.2â†’4.6 px/znak + wiÄ™kszy padding â€” dĹ‚uĹĽsze labels (emoji) majÄ… lepsze size estimation */
      return Math.max(60, len*4.6+22);
    };
    /* v2.1.184: vertical half-height 13â†’20 (faktyczna wysokoĹ›Ä‡ labelu z padding to ~24-26 px â†’ halfH=13 dawaĹ‚o overlap) */
    const lblHalfH=20;
    /* v1.9.90: wiÄ™cej kandydatĂłw (33 zamiast 19) â€” wiÄ™kszy promieĹ„ awaryjny */
    const candidates=[
      {dx:0,dy:0},
      {dx:0,dy:-30},{dx:0,dy:30},
      {dx:-90,dy:0},{dx:90,dy:0},
      {dx:0,dy:-60},{dx:0,dy:60},
      {dx:-90,dy:-30},{dx:90,dy:-30},
      {dx:-90,dy:30},{dx:90,dy:30},
      {dx:0,dy:-90},{dx:0,dy:90},
      {dx:-180,dy:0},{dx:180,dy:0},
      {dx:-90,dy:-60},{dx:90,dy:-60},
      {dx:-90,dy:60},{dx:90,dy:60},
      {dx:-180,dy:-30},{dx:180,dy:-30},
      {dx:-180,dy:30},{dx:180,dy:30},
      {dx:0,dy:-120},{dx:0,dy:120},
      {dx:-180,dy:-60},{dx:180,dy:-60},
      {dx:-180,dy:60},{dx:180,dy:60},
      {dx:-270,dy:0},{dx:270,dy:0},
      {dx:0,dy:-150},{dx:0,dy:150},
    ];
    const placed=[];
    /* v2.1.184: anti-overlap fix â€” user feedback "ĹĽĂłĹ‚te paski na Ĺ›rodku ulicy obok dripu, kurier+pizzeria stacked".
       (a) reqX factor 0.95â†’1.08 (tighter horizontal separation),
       (b) reqY=lblHalfH*2.4 â†’ 2.6 (wiÄ™cej vertical space),
       (c) fallback awaryjny zamiast random â€” preferuj wymuszenie y-offset stacking pionowy nad oryginalnÄ… pozycjÄ…. */
    return sorted.map(lm=>{
      const x=lm.wx*scale, y=lm.wy*scale;
      const myHalfW=measureLbl(lm.name);
      for(const c of candidates){
        const tx=x+c.dx, ty=y+c.dy;
        const overlaps=placed.some(p=>{
          const reqX=(myHalfW+p.w)*0.52; /* full widths Ă— 0.52 = avg half-width separation 1.04Ă— */
          const reqY=lblHalfH*2.6;
          return Math.abs(p.x-tx)<reqX && Math.abs(p.y-ty)<reqY;
        });
        if(!overlaps){
          placed.push({x:tx,y:ty,w:myHalfW});
          return {lm,x:tx,y:ty};
        }
      }
      /* Fallback: forsuj y-offset stacking (szukaj wolnego slotu w pionie Â±200px od oryginaĹ‚u) */
      for(let dy=lblHalfH*3; dy<=200; dy+=lblHalfH*2.5){
        for(const sign of [1,-1]){
          const ty=y+dy*sign;
          const overlapsV=placed.some(p=>Math.abs(p.x-x)<(myHalfW+p.w)*0.52 && Math.abs(p.y-ty)<lblHalfH*2.6);
          if(!overlapsV){
            placed.push({x,y:ty,w:myHalfW});
            return {lm,x,y:ty};
          }
        }
      }
      /* Ostateczny fallback â€” daleki offset losowy (rzadko triggered po fix) */
      const fx=x+(Math.random()-0.5)*200, fy=y+(Math.random()-0.5)*120;
      placed.push({x:fx,y:fy,w:myHalfW});
      return {lm,x:fx,y:fy};
    });
  }

  function renderMap(zoom){
    _mapZoom=zoom;
    document.getElementById('fmap-zoom').textContent=Math.round(zoom*100)+'%';
    const scale=baseScale*zoom;
    const mw=wW*scale, mh=wH*scale;
    wrap.innerHTML='';
    wrap.style.width=mw+'px';wrap.style.height=mh+'px';
    const cv=document.createElement('canvas');
    cv.width=mw;cv.height=mh;
    cv.style.display='block';
    const cx=cv.getContext('2d');
    // Kafelki
    for(let r=0;r<ROOMS.ulica.hT;r++){
      for(let c=0;c<ROOMS.ulica.wT;c++){
        const t=ROOMS.ulica.map[r][c];
        const colors={road:'#3a3a3a',side:'#9a9a9a',grass:'#2a5e2a',park:'#3a8030',sand:'#c8b070',water:'#3a7a9a',gdark:'#0a1a0a',flowerbed:'#7a3030'};
        cx.fillStyle=colors[t]||'#1a1a1a';
        cx.fillRect(c*T*scale, r*T*scale, T*scale+0.5, T*scale+0.5);
      }
    }
    // Budynki â€” filtrujemy NPC, park objects i zagospodarowanie mieszkaĹ„ (apt1_*, apt2_*, apt4_*).
    // W prostokÄ…tach 1/2/4 (Mieszkanie/Penthouse/Apartament Premium) widoczne ma byÄ‡ TYLKO gĹ‚Ăłwny budynek.
    ROOMS.ulica.objects.forEach(obj=>{
      if(obj.id.startsWith('npc_')||obj.id.startsWith('park_')) return;
      if(obj.id.startsWith('apt1_')||obj.id.startsWith('apt2_')||obj.id.startsWith('apt4_')) return;
      if(['fountain','pond','skate','bboying','bench','bench2'].includes(obj.id)) return;
      if(obj.w<60||obj.h<60) return;
      cx.fillStyle='rgba(0,0,0,.4)';cx.fillRect((obj.wx+2)*scale,(obj.wy+2)*scale,obj.w*scale,obj.h*scale);
      cx.fillStyle='#5a6a7a';cx.fillRect(obj.wx*scale,obj.wy*scale,obj.w*scale,obj.h*scale);
      cx.strokeStyle='#1a2a3a';cx.lineWidth=1;cx.strokeRect(obj.wx*scale+.5,obj.wy*scale+.5,obj.w*scale-1,obj.h*scale-1);
    });
    wrap.appendChild(cv);
    const fontSize=12,padding=3;
    // Drip district label
    const dripLabel=document.createElement('div');
    dripLabel.style.cssText=`position:absolute;left:${(2596*scale+3244*scale)/2}px;top:${(2629-30)*scale}px;background:#c8a520;color:#000;padding:4px 8px;border-radius:5px;font-size:14px;font-weight:900;white-space:nowrap;pointer-events:none;transform:translate(-50%,-50%);box-shadow:0 2px 8px rgba(200,165,32,.6);font-family:inherit;letter-spacing:1px`;
    dripLabel.textContent='đź’Ž DZIELNICA DRIPU';
    wrap.appendChild(dripLabel);
    /* v2.1.184: User feedback "ĹĽĂłĹ‚te paski na Ĺ›rodku ulicy obok dripu" â€” quest target piny (np. firstjob multi-target Myjnia/Budowa/Kurier/Pizzeria z wy=2280) NAKĹADAĹY SIÄ na zwykĹ‚e MAP_LANDMARKS labels (te same wx, wy=2288 â€” rĂłĹĽnica 8px). Fix: tolerancja Â±20px na wx/wy match. */
    const _qTgt=(typeof _storylineTargetLoc==='function')?_storylineTargetLoc():null;
    const _qTgtList=_qTgt?(_qTgt.multi?_qTgt.targets:[_qTgt]):[];
    const _isQuestTarget=(lm)=>_qTgtList.some(t=>Math.abs(t.wx-lm.wx)<20 && Math.abs(t.wy-lm.wy)<20);
    // Labele z stagger â€” pomijamy landmarks ktĂłre sÄ… quest targetami (zostanÄ… pokazane jako wyrĂłĹĽnione piny niĹĽej)
    const placed=placeLabels(zoom);
    for(const {lm,x,y} of placed){
      if(lm.wx<0||lm.wx>wW||lm.wy<0||lm.wy>wH) continue;
      if(_isQuestTarget(lm)) continue; /* v2.1.184: pomiĹ„ landmark â€” quest pin nim siÄ™ zajmie */
      const lab=document.createElement('div');
      const colors={home:'#7ec8e3',shop:'#c8a3e3',gym:'#f39c12',career:'#5dade2',park:'#7ec87e',merch:'#f48fb1',health:'#ec7063',concert:'#bb8fce',job:'#f5b041',lux:'#f1c40f',npc:'#e8e8a0',freestyle:'#e91e8c'};
      const isNpc=lm.cat==='npc';
      const isFreestyle=lm.cat==='freestyle';
      // NPC i freestyle majÄ… inny styl (wyrĂłĹĽnione obramowanie)
      const border=isNpc?'border:2px solid #5a5a30;':isFreestyle?'border:2px solid #fff;animation:pl 1.5s ease-in-out infinite;':'';
      lab.style.cssText=`position:absolute;left:${x}px;top:${y}px;background:${colors[lm.cat]||'#888'};color:#000;padding:${padding}px ${padding*2}px;border-radius:${isNpc?'10px':'4px'};font-size:${fontSize}px;font-weight:700;white-space:nowrap;pointer-events:none;transform:translate(-50%,-50%);box-shadow:0 1px 3px rgba(0,0,0,.7);font-family:inherit;${border}`;
      lab.textContent=lm.name;
      wrap.appendChild(lab);
    }
    // â”€â”€ Player marker â€” separate element, updated live â”€â”€
    const playerDot=document.createElement('div');
    playerDot.id='fmap-player-dot';
    playerDot.style.cssText=`position:absolute;width:14px;height:14px;border-radius:50%;background:#7ec8e3;border:2px solid #fff;transform:translate(-50%,-50%);box-shadow:0 0 12px rgba(126,200,227,.9);pointer-events:none;z-index:5`;
    wrap.appendChild(playerDot);
    const playerLbl=document.createElement('div');
    playerLbl.id='fmap-player-lbl';
    playerLbl.style.cssText=`position:absolute;background:#7ec8e3;color:#000;padding:${padding}px ${padding*2+2}px;border-radius:4px;font-size:${fontSize+1}px;font-weight:900;transform:translate(-50%,-50%);box-shadow:0 0 10px rgba(126,200,227,.9);font-family:inherit;pointer-events:none;z-index:6;animation:pl 1.2s ease-in-out infinite`;
    playerLbl.textContent='đź“Ť TY';
    wrap.appendChild(playerLbl);
    updatePlayerMarker();
    /* v2.1.65 Amper: ZAPARKOWANE AUTO na peĹ‚nej mapie â€” duĹĽy ĹĽĂłĹ‚ty marker z etykietÄ… "TWOJE AUTO". */
    if(G.car && G._carParkedAt && !G._inCar){
      const acx=G._carParkedAt.wx*scale, acy=G._carParkedAt.wy*scale;
      const carHalo=document.createElement('div');
      carHalo.style.cssText=`position:absolute;left:${acx}px;top:${acy}px;width:44px;height:44px;border-radius:50%;background:radial-gradient(circle,rgba(241,196,15,.7) 0%,rgba(241,196,15,0) 70%);transform:translate(-50%,-50%);pointer-events:none;animation:fmapHalo 1.4s ease-in-out infinite;z-index:4`;
      wrap.appendChild(carHalo);
      const carDot=document.createElement('div');
      carDot.style.cssText=`position:absolute;left:${acx}px;top:${acy}px;width:16px;height:16px;border-radius:50%;background:#f1c40f;border:2px solid #fff;transform:translate(-50%,-50%);box-shadow:0 0 14px rgba(241,196,15,1);pointer-events:none;z-index:5`;
      wrap.appendChild(carDot);
      const carLbl=document.createElement('div');
      carLbl.style.cssText=`position:absolute;left:${acx}px;top:${acy-22*zoom}px;background:linear-gradient(135deg,#f1c40f,#c8a520);color:#000;padding:5px 10px;border-radius:10px 10px 10px 4px;font-size:${fontSize+1}px;font-weight:900;transform:translate(-50%,0);box-shadow:0 3px 10px rgba(241,196,15,.8);font-family:inherit;letter-spacing:.5px;border:1.5px solid #8a6e10;pointer-events:none;z-index:6`;
      carLbl.innerHTML=`đźš— ${G.car.name}`;
      wrap.appendChild(carLbl);
    }
    // Quest target
    const tgt=_storylineTargetLoc();
    if(tgt){
      // Multi-target (firstjob): rysuj pin dla KAĹ»DEGO celu, gracz sam wybiera
      const targets=tgt.multi?tgt.targets:[tgt];
      /* v2.1.184: dla multi-target (firstjob 6 prac na wy=2280, blisko siebie ~320px wx step) â€” peĹ‚ne piny z tekstem ("đźš— Myjnia") NAKĹADAĹY SIÄ. Fix: gdy multi-target â†’ kompaktowe piny tylko emoji bez tekstu (kaĹĽdy ~40px wide zamiast ~150px). User feedback "ĹĽĂłĹ‚te paski na Ĺ›rodku ulicy obok dripu". */
      const _compact=tgt.multi && targets.length>2;
      for(const target of targets){
        const tx=target.wx*scale, ty=target.wy*scale;
        const halo=document.createElement('div');
        halo.style.cssText=`position:absolute;left:${tx}px;top:${ty}px;width:48px;height:48px;border-radius:50%;background:radial-gradient(circle,rgba(241,196,15,.6) 0%,rgba(241,196,15,0) 70%);transform:translate(-50%,-50%);pointer-events:none;animation:fmapHalo 1.4s ease-in-out infinite`;
        wrap.appendChild(halo);
        const pin=document.createElement('div');
        if(_compact){
          /* Kompaktowy pin: tylko emoji w okrÄ…gĹ‚ej ĹĽĂłĹ‚tej kropce + tooltip title */
          pin.style.cssText=`position:absolute;left:${tx}px;top:${ty-26*zoom}px;width:30px;height:30px;background:linear-gradient(135deg,#f1c40f,#e6a814);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;transform:translate(-50%,0);box-shadow:0 3px 10px rgba(241,196,15,.7),inset 0 1px 0 rgba(255,255,255,.5);border:1.5px solid #c8a020;pointer-events:auto;cursor:help`;
          pin.title=target.hint||'Cel';
          pin.innerHTML=target.em||'đźŽŻ';
        } else {
          pin.style.cssText=`position:absolute;left:${tx}px;top:${ty-26*zoom}px;background:linear-gradient(135deg,#f1c40f,#e6a814);color:#0a0a0a;padding:5px 10px 5px 8px;border-radius:14px 14px 14px 4px;font-size:${fontSize+2}px;font-weight:900;transform:translate(-50%,0);box-shadow:0 3px 10px rgba(241,196,15,.7),inset 0 1px 0 rgba(255,255,255,.5);font-family:inherit;letter-spacing:.5px;border:1.5px solid #c8a020;pointer-events:none`;
          pin.innerHTML=`${target.em||'đźŽŻ'} ${target.hint||'Cel'}`;
        }
        wrap.appendChild(pin);
      }
    }
  }

  // Live player marker update (kazda klatka â€” bez re-renderu calej mapy)
  function updatePlayerMarker(){
    const dot=document.getElementById('fmap-player-dot');
    const lbl=document.getElementById('fmap-player-lbl');
    if(!dot||!lbl) return;
    const scale=baseScale*_mapZoom;
    const px=P.wx*scale, py=P.wy*scale;
    dot.style.left=px+'px';
    dot.style.top=py+'px';
    lbl.style.left=px+'px';
    lbl.style.top=(py-22*_mapZoom)+'px';
  }

  let trackingFrame=null;
  function trackPlayer(){
    updatePlayerMarker();
    trackingFrame=requestAnimationFrame(trackPlayer);
  }

  renderMap(1.5);
  trackPlayer();

  const sc=document.getElementById('fmap-scroll-container');
  // Scroll zoom
  const wheelH=e=>{
    e.preventDefault();
    let z=_mapZoom;
    z+=(e.deltaY<0?0.2:-0.2);
    z=Math.max(0.5, Math.min(3, z));
    if(Math.abs(z-_mapZoom)>0.01) renderMap(z);
  };
  sc.addEventListener('wheel',wheelH,{passive:false});
  // Drag â€” chwyc i przesuwaj
  let dragging=false, dragStartX=0, dragStartY=0, scrollStartL=0, scrollStartT=0;
  sc.style.cursor='grab';
  const downH=e=>{
    if(e.button!==0) return;
    // Zacznij drag tylko gdy klikniecie na scroll-container, nie na elementach (label/pin)
    dragging=true;
    dragStartX=e.clientX;dragStartY=e.clientY;
    scrollStartL=sc.scrollLeft;scrollStartT=sc.scrollTop;
    sc.style.cursor='grabbing';
    e.preventDefault();
  };
  const moveH=e=>{
    if(!dragging) return;
    const dx=e.clientX-dragStartX, dy=e.clientY-dragStartY;
    sc.scrollLeft=scrollStartL-dx;
    sc.scrollTop=scrollStartT-dy;
    e.preventDefault();
  };
  const upH=()=>{
    if(dragging){dragging=false;sc.style.cursor='grab';}
  };
  sc.addEventListener('mousedown',downH);
  window.addEventListener('mousemove',moveH);
  window.addEventListener('mouseup',upH);
  // Touch support
  const touchH=e=>{
    if(e.touches.length!==1) return;
    dragging=true;
    dragStartX=e.touches[0].clientX;dragStartY=e.touches[0].clientY;
    scrollStartL=sc.scrollLeft;scrollStartT=sc.scrollTop;
  };
  const touchMove=e=>{
    if(!dragging||e.touches.length!==1) return;
    sc.scrollLeft=scrollStartL-(e.touches[0].clientX-dragStartX);
    sc.scrollTop=scrollStartT-(e.touches[0].clientY-dragStartY);
    e.preventDefault();
  };
  const touchEnd=()=>{dragging=false;};
  sc.addEventListener('touchstart',touchH,{passive:true});
  sc.addEventListener('touchmove',touchMove,{passive:false});
  sc.addEventListener('touchend',touchEnd);

  // â”€â”€ Klawiatura: + / - dla zoom, ESC/M zamyka â”€â”€
  const keyH=e=>{
    if(e.key==='+'||e.key==='='){e.preventDefault();window._mapZoomIn();}
    else if(e.key==='-'||e.key==='_'){e.preventDefault();window._mapZoomOut();}
  };
  window.addEventListener('keydown',keyH);

  // Zoom buttons
  const ctrls=document.getElementById('fmap-controls');
  if(ctrls){
    const btnStyle='background:#1a3a5a;border:1px solid #7ec8e3;color:#7ec8e3;width:26px;height:24px;border-radius:5px;cursor:pointer;font-size:14px;font-weight:700;line-height:1;padding:0;margin:0 2px;vertical-align:middle';
    ctrls.innerHTML='đź–±ď¸Ź Scroll/<kbd style="background:#1a2535;padding:1px 5px;border-radius:3px;color:#7ec8e3">+</kbd>/<kbd style="background:#1a2535;padding:1px 5px;border-radius:3px;color:#7ec8e3">-</kbd> = zoom Â· Drag = przesuwaj Â· <kbd style="background:#1a2535;padding:1px 5px;border-radius:3px;color:#7ec8e3">ESC</kbd>/<kbd style="background:#1a2535;padding:1px 5px;border-radius:3px;color:#7ec8e3">M</kbd> = zamknij Â· Zoom: <span id="fmap-zoom">'+Math.round(_mapZoom*100)+'%</span>'+
      ' <button onclick="window._mapZoomOut()" style="'+btnStyle+'" title="Pomniejsz (-)">â’</button>'+
      '<button onclick="window._mapZoomIn()" style="'+btnStyle+'" title="PowiÄ™ksz (+)">+</button>';
  }
  window._mapZoomIn=()=>{const z=Math.min(3,_mapZoom+0.2);if(z!==_mapZoom)renderMap(z);};
  window._mapZoomOut=()=>{const z=Math.max(0.5,_mapZoom-0.2);if(z!==_mapZoom)renderMap(z);};

  // Cleanup gdy mapa zamknieta
  _mapDragHandlers={cleanup:()=>{
    window.removeEventListener('mousemove',moveH);
    window.removeEventListener('mouseup',upH);
    window.removeEventListener('keydown',keyH);
    if(trackingFrame)cancelAnimationFrame(trackingFrame);
  }};

  // Klik poza mapa zamyka (tylko na czarnym tle, NIE na scroll container)
  o.addEventListener('click',e=>{
    if(e.target===o){
      if(_mapDragHandlers){_mapDragHandlers.cleanup();_mapDragHandlers=null;}
      o.remove();
    }
  });
}
// â”€â”€â”€ Pauza â”€â”€
let _paused=false;
function togglePause(){
  _paused=!_paused;
  // Anti-stuck-key: czyĹ›cimy klawisze przy kaĹĽdym wejĹ›ciu/wyjĹ›ciu z pauzy
  // (przeniesienie focusa do modal pauzy / wracanie z menu moĹĽe zablokowaÄ‡ keyup)
  for(const k in K) delete K[k];
  /* v2.1.175: clear P.moving ĹĽeby step sound nie graĹ‚ gdy gracz trzymaĹ‚ klawisz przed esc */
  P.moving=false;
  if(_paused){
    document.getElementById('pause-overlay')?.remove();
    const p=document.createElement('div');
    p.id='pause-overlay';
    /* v2.1.175: top 62â†’0 â€” pause overlay pokrywa CAĹY ekran wraz z HUD. WczeĹ›niej top:62 powodowaĹ‚ dziwne odciÄ™cie (HUD jasny + reszta ciemna na granicy). */
    p.style.cssText='position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:50;color:#fff;font-family:inherit;backdrop-filter:blur(4px)';
    // Statystyki sesji
    const sessMs=Date.now()-(_sessionStats.startReal||Date.now());
    const sessMin=Math.floor(sessMs/60000);
    const sessH=Math.floor(sessMin/60),sessM=sessMin%60;
    const sessTime=sessH>0?`${sessH}h ${sessM}min`:`${sessM} min`;
    const earnedToday=(_sessionStats.earnedToday||0).toLocaleString('pl');
    const earnedSess=(_sessionStats.earnedSession||0).toLocaleString('pl');
    const totalEarn=(G.totalEarned||0).toLocaleString('pl');
    const streak=G.playStreak||0;
    const streakBonus=streak>1?Math.min(20,(streak-1)*2):0;
    p.innerHTML=`
      <div style="text-align:center;background:#0a0f1a;border:2px solid #f1c40f;border-radius:14px;padding:26px 36px;box-shadow:0 0 60px rgba(241,196,15,.5);min-width:340px">
        <div style="font-size:56px;margin-bottom:4px;line-height:1">âŹ¸ď¸Ź</div>
        <div style="font-size:24px;color:#f1c40f;font-weight:900;letter-spacing:4px;margin-bottom:14px">PAUZA</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;margin-bottom:18px;font-size:12px;text-align:left">
          <div style="color:#888">âŹ± Sesja:</div><div style="color:#7ec8e3;font-weight:700;text-align:right">${sessTime}</div>
          <div style="color:#888">đź’° Zarobiono dziĹ›:</div><div style="color:#27ae60;font-weight:700;text-align:right">${earnedToday} zĹ‚</div>
          <div style="color:#888">đź’° Tej sesji:</div><div style="color:#27ae60;font-weight:700;text-align:right">${earnedSess} zĹ‚</div>
          <div style="color:#888">đź’Ž ĹÄ…cznie:</div><div style="color:#f1c40f;font-weight:700;text-align:right">${totalEarn} zĹ‚</div>
          <div style="color:#888">đź”Ą Streak:</div><div style="color:${streak>=3?'#e91e8c':'#aaa'};font-weight:700;text-align:right">${streak} ${streak===1?'dzieĹ„':'dni'}${streakBonus>0?` (+${streakBonus}%)`:''}</div>
          <div style="color:#888">đźŽ¤ Koncerty:</div><div style="color:#9b59b6;font-weight:700;text-align:right">${G.events?.performed||0}</div>
        </div>
        <div style="font-size:11px;color:#556;margin-bottom:14px;font-style:italic">Czas, gĹ‚Ăłd, energia i postÄ™p stojÄ… w miejscu.</div>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
          <button onclick="togglePause()" style="background:#0a3a1a;border:1px solid #27ae60;color:#7ec87e;padding:11px 28px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700">â–¶ WznĂłw  Â·  Esc</button>
          <button onclick="returnToMenu()" style="background:#3a0a1a;border:1px solid #c01020;color:#f4a097;padding:11px 28px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;font-weight:700">đźŹ  PowrĂłt do menu</button>
        </div>
        <div style="font-size:10px;color:#556;margin-top:10px">PowrĂłt do menu zapisuje grÄ™ automatycznie.</div>
      </div>
    `;
    document.body.appendChild(p);
  } else {
    document.getElementById('pause-overlay')?.remove();
    lastClockReal=Date.now(); // ĹĽeby gameMin nie zrobiĹ‚ skoku po wznowieniu
    lastDecay=Date.now();
  }
}
function isPaused(){return _paused;}

/* v2.1.27: powrĂłt do menu z pauzy (auto-save + reset state).
   User: "Jak gracz naciska 'esc' powinna byÄ‡ teĹĽ opcja powrĂłt do menu + automatyczny save". */
function returnToMenu(){
  /* 1) Auto-save NATYCHMIAST (synchroniczny, bypass debounce) */
  try{
    if(typeof saveGameSilentNow==='function') saveGameSilentNow();
    else if(typeof saveGameSilent==='function') saveGameSilent();
    else if(typeof saveGame==='function') saveGame();
  }catch(e){console.error('Auto-save przed menu failed:',e);}

  /* 2) Stop wszystkie aktywne timery/animacje */
  try{
    if(typeof stopAutoSave==='function') stopAutoSave();
    if(typeof _restTimer!=='undefined' && _restTimer){clearInterval(_restTimer);_restTimer=null;}
    if(typeof sleepInterval!=='undefined' && sleepInterval){clearInterval(sleepInterval);sleepInterval=null;}
    if(typeof _stopSocialPoller==='function') _stopSocialPoller();
    else if(typeof window._stopSocialPoller==='function') window._stopSocialPoller();
  }catch(e){console.error('Cleanup timers failed:',e);}

  /* 3) Zamknij wszystkie overlay/pauza/cinematic */
  document.getElementById('pause-overlay')?.remove();
  if(typeof closeOverlay==='function') try{closeOverlay();}catch(e){}
  if(typeof closeNPCDlg==='function') try{closeNPCDlg();}catch(e){}
  /* Cleanup cinematic state jeĹ›li aktywny */
  if(window._cinemCam) try{window._cinemCam.active=false;}catch(e){}
  if(typeof G!=='undefined'){G._cinematicActive=false;G._introductionActive=false;G._resting=false;}
  document.body.classList.remove('cinematic-active');
  document.querySelectorAll('[id^="cinem-"],[id^="intro-modal"]').forEach(e=>e.remove());

  /* 4) Reset pauzy i flag */
  _paused=false;
  window._gameStarted=false;

  /* 5) PokaĹĽ menu */
  document.getElementById('menu').style.display='flex';
  document.getElementById('creator').style.display='none';
  if(typeof showMsg==='function') showMsg('đź’ľ Zapisano. WrĂłciĹ‚eĹ› do menu.','g',3000);
}
window.returnToMenu=returnToMenu;
// â”€â”€â”€ Tutorial pierwszego dnia (interaktywny, krokowy) â”€â”€
// v1.8.41: kaĹĽdy step ma `goal` (cel akcji) i `done` (warunek speĹ‚nienia).
// Tutorial przesuwa siÄ™ do nastÄ™pnego stepu po faktycznym wykonaniu akcji,
// nie po upĹ‚ywie czasu â€” gracz uczy siÄ™ przez dziaĹ‚anie.
const TUTORIAL_STEPS=[
  {icon:'âŚ¨ď¸Ź',color:'#7ec8e3',title:'Pierwszy krok',
   body:'Steruj <strong>WASD</strong> lub strzaĹ‚kami. PostaÄ‡ na ekranie to Ty. Pasek u gĂłry to Twoje statystyki.',
   goal:'Rusz siÄ™ â€” wciĹ›nij W, A, S lub D',
   done:()=>(G._tutStat?.moved||0)>30},
  {icon:'đźŽŻ',color:'#27ae60',title:'Interakcje',
   body:'Klawisz <strong>E</strong> to interakcja â€” podejdĹş do budynku, NPC lub obiektu, ĹĽeby z nim wejĹ›Ä‡ w interakcjÄ™. Na ekranie pojawi siÄ™ podpowiedĹş "[E]".',
   goal:'PodejdĹş do drzwi swojego mieszkania (Traphouse na pĂłĹ‚nocy) i wciĹ›nij E',
   done:()=>(G._tutStat?.entered||0)>0 || currentRoom==='mieszkanie'},
  {icon:'đź’Ľ',color:'#f39c12',title:'Pierwsza wypĹ‚ata',
   body:'W <strong>centrum mapy</strong> znajdziesz prace dorywcze (Pizzeria, Supermarket, Myjnia, Budowa, Kurier). To gĹ‚Ăłwne ĹşrĂłdĹ‚o kasy na poczÄ…tku â€” 50â€“200 zĹ‚ za zmianÄ™.',
   goal:'ZarĂłb pierwsze 100 zĹ‚ na pracy dorywczej',
   done:()=>(G.totalEarned||0)>=100},
  {icon:'đźŤ”',color:'#e74c3c',title:'Jedz i pij',
   body:'<strong>LodĂłwka</strong> w mieszkaniu jest darmowa (po zakupie jedzenia w sklepie spoĹĽywczym). Restauracje sÄ… droĹĽsze, ale szybciej zaspokojÄ… gĹ‚Ăłd.',
   goal:'Zjedz coĹ› â€” z lodĂłwki w mieszkaniu albo w sklepie',
   done:()=>(G._tutStat?.ate||0)>0},
  {icon:'đź“±',color:'#e91e8c',title:'Telefon = centrum',
   body:'Klawisz <strong>P</strong> otwiera telefon. Znajdziesz tam: statystyki, sklepy muzyczne (Spotify, YouTube), bank, rachunki, listÄ™ zadaĹ„.',
   goal:'OtwĂłrz telefon (P) i przejrzyj aplikacje',
   done:()=>(G._tutStat?.phoneOpened||0)>0},
  {icon:'đź—şď¸Ź',color:'#3498db',title:'Mapa miasta',
   body:'Klawisz <strong>M</strong> otwiera peĹ‚nÄ… mapÄ™ miasta. Minimapa w lewym dolnym rogu pokazuje Twoje poĹ‚oĹĽenie caĹ‚y czas.',
   goal:'OtwĂłrz mapÄ™ (M) i zobacz gdzie jesteĹ›',
   done:()=>(G._tutStat?.mapOpened||0)>0},
  {icon:'đź´',color:'#9b59b6',title:'Sen = regeneracja',
   body:'Gdy energia spada poniĹĽej 30%, <strong>idĹş spaÄ‡ w Ĺ‚ĂłĹĽku</strong>. Bez snu nie regenerujesz zdrowia, a po 3+ dniach niedoboru snu energia spada szybciej.',
   goal:'PrzeĹ›pij siÄ™ w Ĺ‚ĂłĹĽku w swoim mieszkaniu',
   done:()=>(G._tutStat?.slept||0)>0},
  {icon:'đź’ľ',color:'#1abc9c',title:'Auto-save',
   body:'Gra <strong>zapisuje siÄ™ sama co 30 sekund</strong>. RÄ™czny zapis ikonÄ… dyskietki w mieszkaniu. <strong style="color:#f1c40f">Powodzenia w karierze rapera!</strong> đźŽ¤',
   goal:'',
   done:()=>true}
];
function tutorialTick(){
  if(G._tutorialSeen) return;
  if(G._introductionActive) return; /* v1.9.82: suppress normalny tutorial podczas Wprowadzenia */
  if(G._cinematicActive) return; /* v1.9.96: NIC nie pojawia siÄ™ w trakcie cinematic */
  if(_paused) return;
  if(document.getElementById('menu').style.display!=='none') return;
  // #66: Nie pokazuj tutorial gdy gracz zajÄ™ty (regresja ) â€” minigra/telefon/overlay/NPC/full mapa/help/admin/welcome
  if(typeof mgOpen==='function' && mgOpen()) return;
  if(typeof phoneOpen==='function' && phoneOpen()) return;
  if(typeof overlayOpen==='function' && overlayOpen()) return;
  if(typeof npcDlgOpen==='function' && npcDlgOpen()) return;
  if(document.getElementById('fullmap-overlay')) return;
  if(document.getElementById('help-panel')) return;
  if(document.getElementById('char-panel')?.style.display==='flex') return;
  if(document.getElementById('admin-panel')?.style.display==='block') return;
  if(document.getElementById('welcome-popup')) return;
  if(document.getElementById('mg-job')?.classList.contains('on')) return;
  if(document.getElementById('sleep-overlay')?.classList.contains('on')) return;
  if(!G._tutorial) G._tutorial={step:0, lastShownAt:0};
  if(G._tutorial.step>=TUTORIAL_STEPS.length){G._tutorialSeen=true;return;}
  // v1.8.41: interaktywny tutorial â€” pokazuje step gdy popup nie jest widoczny, advance gdy warunek speĹ‚niony.
  const cur=TUTORIAL_STEPS[G._tutorial.step];
  const popupVisible=!!document.getElementById('tutorial-popup');
  // JeĹ›li warunek speĹ‚niony â€” przejdĹş dalej (popup siÄ™ usuwa w showTutorialMessage przed re-render)
  if(cur.done && cur.done()){
    G._tutorial.step++;
    G._tutorial.lastShownAt=Date.now();
    return; // nastÄ™pna klatka pokaĹĽe kolejny step
  }
  // PokaĹĽ step jeĹ›li popup nie jest aktualnie widoczny
  if(!popupVisible){
    const elapsed=Date.now()-(G._tutorial.lastShownAt||0);
    /* v1.9.88: gdy gracz zamknÄ…Ĺ‚ rÄ™cznie X, czekaj 60s zanim pokaĹĽ ten sam step ponownie */
    if(G._tutorial.closedManual){
      const sinceClose=Date.now()-G._tutorial.closedManual;
      if(sinceClose<60000) return;
    }
    const minDelay=G._tutorial.step===0?3000:1500;
    if(elapsed<minDelay) return;
    showTutorialMessage(TUTORIAL_STEPS[G._tutorial.step], null, G._tutorial.step);
    G._tutorial.lastShownAt=Date.now();
    G._tutorial.closedManual=0;
  }
  G._tutorial.lastShownAt=Date.now();
}
function showTutorialMessage(stepObj, label, idx){
  if(typeof idx!=='number') idx=(G._tutorial?.step||1)-1;
  // Backwards compat â€” gdy stepObj jest stringiem (stary format)
  const step=typeof stepObj==='string'?{icon:'đź’ˇ',color:'#7ec8e3',title:'WskazĂłwka',body:stepObj}:stepObj;
  document.getElementById('tutorial-popup')?.remove();
  const p=document.createElement('div');
  p.id='tutorial-popup';
  // #53 Spektakularny popup â€” slide-up z doĹ‚u, glow, gradient header z color theme
  const c=step.color||'#7ec8e3';
  p.style.cssText=`position:fixed;bottom:-260px;left:50%;transform:translateX(-50%);background:linear-gradient(160deg,rgba(8,12,24,.99),rgba(12,16,32,.99));border:2px solid ${c};border-radius:14px;padding:0;z-index:200;width:560px;max-width:90vw;font-family:inherit;box-shadow:0 8px 40px ${c}70,0 0 80px ${c}30;pointer-events:all;transition:bottom .55s cubic-bezier(.34,1.56,.64,1),opacity .3s;opacity:0;overflow:hidden`;
  const total=TUTORIAL_STEPS.length;
  p.innerHTML=`
    <!-- HEADER bar z color theme -->
    <div style="background:linear-gradient(135deg,${c}40,${c}10);padding:10px 18px;border-bottom:1px solid ${c}50;display:flex;align-items:center;gap:10px">
      <div style="font-size:12px;color:${c};font-weight:900;letter-spacing:2px">đź’ˇ PORADNIK</div>
      <div style="flex:1"></div>
      <div style="display:flex;gap:3px">
        ${Array.from({length:total},(_,i)=>`<div style="width:18px;height:4px;background:${i<=idx?c:'#1a2535'};border-radius:2px;transition:background .3s"></div>`).join('')}
      </div>
      <div style="color:${c}aa;font-size:11px;font-weight:700;margin-left:6px">${idx+1}/${total}</div>
      <button onclick="document.getElementById('tutorial-popup')?.remove();if(G._tutorial){G._tutorial.lastShownAt=Date.now();G._tutorial.closedManual=Date.now();}" style="background:transparent;border:none;color:#778;font-size:18px;cursor:pointer;padding:0 0 0 8px;line-height:1">âś•</button>
    </div>
    <!-- BODY z big icon -->
    <div style="padding:18px 20px;display:flex;gap:16px;align-items:flex-start">
      <div style="font-size:54px;flex-shrink:0;filter:drop-shadow(0 0 12px ${c}80);animation:tutorialIconBounce 1s ease-out">${step.icon}</div>
      <div style="flex:1">
        <div style="font-size:18px;color:${c};font-weight:900;margin-bottom:6px;text-shadow:0 0 10px ${c}50">${step.title}</div>
        <div style="color:#dde;font-size:13px;line-height:1.6;margin-bottom:${step.goal?'10px':'0'}">${step.body}</div>
        ${step.goal?`<div style="background:linear-gradient(135deg,${c}25,${c}08);border-left:3px solid ${c};padding:8px 12px;border-radius:4px;font-size:12px;color:#fff"><span style="color:${c};font-weight:900;letter-spacing:1px;margin-right:6px">đźŽŻ CEL:</span>${step.goal}</div>`:''}
      </div>
    </div>
    <!-- NAV bar -->
    <div style="background:rgba(0,0,0,.3);padding:10px 16px;border-top:1px solid ${c}30;display:flex;gap:10px;align-items:center;justify-content:flex-end">
      <button onclick="window._tutNav(-1)" ${idx<=0?'disabled':''} style="background:#0a1525;border:1px solid #2a4a6a;color:#7ec8e3;padding:7px 14px;border-radius:6px;cursor:${idx<=0?'not-allowed':'pointer'};font-family:inherit;font-size:12px;opacity:${idx<=0?.4:1};transition:all .15s">â† Poprzedni</button>
      <button onclick="window._tutNav(1)" ${idx>=total-1?'disabled':''} style="background:linear-gradient(135deg,${c}30,${c}10);border:1px solid ${c};color:${c};padding:7px 18px;border-radius:6px;cursor:${idx>=total-1?'not-allowed':'pointer'};font-family:inherit;font-size:12px;font-weight:700;opacity:${idx>=total-1?.4:1};transition:all .15s">${idx>=total-1?'Koniec âś“':'NastÄ™pny â†’'}</button>
    </div>
  `;
  // Style animacji icon bounce (jednorazowo)
  if(!document.getElementById('tut-icon-bounce-style')){
    const s=document.createElement('style');s.id='tut-icon-bounce-style';
    s.textContent='@keyframes tutorialIconBounce{0%{transform:scale(.3);opacity:0}50%{transform:scale(1.15)}100%{transform:scale(1);opacity:1}}';
    document.head.appendChild(s);
  }
  document.body.appendChild(p);
  // Slide-up animation â€” v1.9.89: tutorial wraca na bottom 80px, ale toast (#msg) ma listener ktĂłry chowa tutorial
  requestAnimationFrame(()=>{p.style.bottom='80px';p.style.opacity='1';});
  // Auto-znikniÄ™cie po 25s (wiÄ™kszy popup = wiÄ™cej czasu na czytanie)
  setTimeout(()=>{const e=document.getElementById('tutorial-popup');if(e){e.style.opacity='0';e.style.bottom='-260px';setTimeout(()=>e.remove(),550);}},25000);
}
window._tutNav=(dir)=>{
  if(!G._tutorial) G._tutorial={step:0,lastShownAt:0};
  let cur=G._tutorial.step-1; // step juĹĽ post-incremented w tutorialTick
  const newIdx=Math.max(0,Math.min(TUTORIAL_STEPS.length-1, cur+dir));
  G._tutorial.step=newIdx+1;
  G._tutorial.lastShownAt=Date.now();
  showTutorialMessage(TUTORIAL_STEPS[newIdx], null, newIdx);
};
window.restartTutorial=()=>{
  G._tutorialSeen=false;
  G._tutorial={step:0, lastShownAt:0, startDay:G.day||1};
  // v1.9.17: BUG FIX â€” reset _tutStat (counters), ĹĽeby kroki 0-5 nie auto-skipowaĹ‚y silnie po `done()` z poprzedniego runu
  G._tutStat={};
  showMsg('đź’ˇ Tutorial uruchomiony od nowa! Pierwszy tip pojawi siÄ™ za moment.');
};
// â”€â”€â”€ Stats summary â”€â”€
function buildStatsSummary(){
  const tracks=G.studioTracks||[];
  const topTrack=tracks.reduce((a,b)=>(b.streams||0)>(a?.streams||0)?b:a,null);
  return `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;font-size:13px;line-height:1.7">
      <div><span style="color:#778">đź“… DzieĹ„:</span> <strong style="color:#fff">${G.day}</strong></div>
      <div><span style="color:#778">â­ SĹ‚awa:</span> <strong style="color:#f1c40f">${G.fame||0}</strong></div>
      <div><span style="color:#778">đź‘Ą Fani:</span> <strong style="color:#9b59b6">${(G.followers||0).toLocaleString('pl')}</strong></div>
      <div><span style="color:#778">đź’° ĹÄ…cznie zarobione:</span> <strong style="color:#27ae60">${(G.totalEarned||0).toLocaleString('pl')} zĹ‚</strong></div>
      <div><span style="color:#778">đźŽ¤ Koncerty:</span> <strong>${G.events?.performed||0}</strong></div>
      <div><span style="color:#778">đź“ş YT subĂłw:</span> <strong>${(G.yt?.subs||0).toLocaleString('pl')}</strong></div>
      <div><span style="color:#778">đźŽµ Singli:</span> <strong>${tracks.length}</strong></div>
      <div><span style="color:#778">đźĄ Bity:</span> <strong>${(G.careers?.beatmaker?.beats||0)+(G.careers?.beatmaker?.beatsSold||0)}</strong></div>
      <div><span style="color:#778">đź§˘ Merch sprzedany:</span> <strong>${(G.merchStore?.totalLifetimeSold||0).toLocaleString('pl')}</strong></div>
      <div><span style="color:#778">đźŹ† OsiÄ…gniÄ™cia:</span> <strong>${(G.achievements?.length||0)}/${ACHIEVEMENTS.length}</strong></div>
      <div><span style="color:#778">â­ Prestige:</span> <strong>${G.prestige||0}</strong></div>
      <div><span style="color:#778">đź’€ Ĺšmierci:</span> <strong>${G._deaths||0}</strong></div>
    </div>
    ${topTrack?`<div style="margin-top:14px;padding-top:14px;border-top:1px solid #1a2535;font-size:13px"><span style="color:#778">đźŹ… Najpopularniejszy singiel:</span> <strong style="color:#f1c40f">${topTrack.name}</strong> (${(topTrack.streams||0).toLocaleString('pl')} streamĂłw)</div>`:''}
  `;
}
// â”€â”€â”€ Achievement popup â”€â”€
const _achQueue=[];
let _achShowing=false;
function showAchievementPopup(ach){
  _achQueue.push(ach);
  if(!_achShowing) _drainAchQueue();
}
function _drainAchQueue(){
  if(_achQueue.length===0){_achShowing=false;return;}
  _achShowing=true;
  const ach=_achQueue.shift();
  /* v2.1.118: Wave 4 S33 â€” Drip God / TIER_LEGENDARY achievements dostajÄ… EPIC cinematic (wiÄ™kszy popup, dĹ‚uĹĽszy, audio fanfare). */
  const _isEpic=['drip_200','fans_1m','1m_followers','prestige5','million_plays','tracks_50','penthouse','casino_whale','casino_megajackpot','cover_legend'].includes(ach.id);
  if(_isEpic && typeof showMilestoneCinematic==='function'){
    showMilestoneCinematic({emoji:ach.icon,title:ach.name.toUpperCase(),subtitle:ach.desc,tagline:'đźŹ† Legendarne osiÄ…gniÄ™cie',accentColor:'#f1c40f',accent2:'#e91e8c',duration:5000});
    if(typeof sfxJackpot==='function')try{sfxJackpot();}catch{}
    setTimeout(()=>{_achShowing=false;_drainAchQueue();},5200);
    return;
  }
  const old=document.getElementById('ach-popup'); if(old) old.remove();
  const p=document.createElement('div');
  p.id='ach-popup';
  p.style.cssText='position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.5);background:linear-gradient(135deg,#1a0a2a,#3a1a4a);border:3px solid #f1c40f;border-radius:18px;padding:28px 36px;z-index:300;text-align:center;box-shadow:0 0 60px rgba(241,196,15,.6),0 12px 40px rgba(0,0,0,.8);font-family:inherit;opacity:0;transition:transform .4s cubic-bezier(.2,1.6,.5,1),opacity .25s;min-width:380px;pointer-events:none';
  p.innerHTML=`
    <div style="font-size:14px;color:#f1c40f;letter-spacing:3px;font-weight:700;margin-bottom:6px;text-transform:uppercase">đźŹ† OsiÄ…gniÄ™cie odblokowane</div>
    <div style="font-size:64px;line-height:1;margin:10px 0;text-shadow:0 0 30px rgba(241,196,15,.8)">${ach.icon}</div>
    <div style="font-size:22px;color:#fff;font-weight:900;margin-bottom:6px;text-shadow:0 2px 8px rgba(0,0,0,.6)">${ach.name}</div>
    <div style="font-size:13px;color:#c8a3e3;margin-bottom:12px;max-width:340px">${ach.desc}</div>
    <div style="font-size:13px;color:#7ec87e;font-weight:700">+25 XP Â· +200 zĹ‚</div>
  `;
  document.body.appendChild(p);
  requestAnimationFrame(()=>{p.style.opacity='1';p.style.transform='translate(-50%,-50%) scale(1)';});
  if(typeof confetti==='function') confetti(40);
  // v1.9.39: peĹ‚na fanfara zamiast samego click (audyt audio: achievement byĹ‚ muted)
  if(typeof sfxSparkle==='function') try{sfxSparkle();setTimeout(()=>sfxSparkle(),180);}catch{}
  else if(typeof playClick==='function') try{playClick();}catch{}
  setTimeout(()=>{p.style.opacity='0';p.style.transform='translate(-50%,-50%) scale(0.85)';setTimeout(()=>{p.remove();_drainAchQueue();},350);},2800);
}
// HUD tooltip â€” info o statystykach
// F5.1 FIX: tooltips zgodne z faktycznÄ… mechanikÄ… + max stat dynamiczny + skill kondycja zamiast G.fitness
const _HUD_TIPS={
  health:    ()=>`<strong style="color:#e74c3c;font-size:17px;display:block;margin-bottom:6px">âť¤ď¸Ź Zdrowie ${Math.floor(G.health||0)}/${typeof getMaxStat==='function'?getMaxStat('health'):100}</strong><br>Spada gdy gĹ‚Ăłd lub energia = 0. Lecz w szpitalu â€” koszt zaleĹĽny od ubytku:<br>â€˘ Lekkie leczenie: 3 zĹ‚ Ă— brakujÄ…ce %<br>â€˘ PeĹ‚ne leczenie: 8 zĹ‚ Ă— brakujÄ…ce %<br>Skill â€žOdpornoĹ›Ä‡" = wolniejszy spadek (max -30% przy lvl 3).`,
  energy:    ()=>`<strong style="color:#3498db;font-size:17px;display:block;margin-bottom:6px">âšˇ Energia ${Math.floor(G.energy||0)}/${typeof getMaxStat==='function'?getMaxStat('energy'):100}</strong><br>Spada przy kaĹĽdej akcji (praca, freestyle, koncert). IdĹş spaÄ‡ w Ĺ‚ĂłĹĽku gdy poniĹĽej 30%. Przy 0 traci zdrowie.<br>đź’Ş Forma spowalnia spadek energii (max -5% przy formie 100).<br>âšˇ Skill â€žKondycja" = -8% / pkt (max -40%).`,
  hunger:    ()=>{
    const overEat = Math.floor(G.overeat||0);
    let overTxt = '';
    if(overEat > 0){
      const tier = overEat >= 70 ? {emoji:'đź¤®', col:'#c01020', lbl:'POWAĹ»NE', bgInt:'33'} : overEat >= 40 ? {emoji:'đź¤˘', col:'#e67e22', lbl:'ĹšREDNIE', bgInt:'33'} : overEat >= 15 ? {emoji:'đź¬', col:'#f1c40f', lbl:'LEKKIE', bgInt:'33'} : {emoji:'đź‹', col:'#7ec87e', lbl:'BEZPIECZNE', bgInt:'22'};
      let efekty = '';
      if(overEat >= 70) efekty = '<br><span style="color:#fff;font-size:12px">Aktywne kary:</span><br>â€˘ Forma <b style="color:#c01020">â’18 pkt</b> (jednorazowo)<br>â€˘ Kondycja <b style="color:#c01020">â’18 pkt</b> (jednorazowo)<br>â€˘ Zdrowie <b style="color:#c01020">â’5 pkt</b><br>â€˘ NastrĂłj <b style="color:#c01020">â’10 pkt</b>';
      else if(overEat >= 40) efekty = '<br><span style="color:#fff;font-size:12px">Aktywne kary:</span><br>â€˘ Forma <b style="color:#e67e22">â’8 pkt</b> (jednorazowo)<br>â€˘ Kondycja <b style="color:#e67e22">â’8 pkt</b> (jednorazowo)<br>â€˘ NastrĂłj <b style="color:#e67e22">â’5 pkt</b>';
      else if(overEat >= 15) efekty = '<br><span style="color:#fff;font-size:12px">Aktywne kary:</span><br>â€˘ Forma <b style="color:#f1c40f">â’3 pkt</b> (jednorazowo)<br>â€˘ Kondycja <b style="color:#f1c40f">â’3 pkt</b> (jednorazowo)';
      else efekty = '<br><span style="color:#7ec87e;font-size:12px">âś“ Bez kar (prĂłg 15+ aktywuje skutki)</span>';
      overTxt = `<br><br><div style="background:${tier.col}${tier.bgInt};border:2px solid ${tier.col};padding:10px;border-radius:8px;margin-top:8px;box-shadow:0 0 8px ${tier.col}44">
        <strong style="color:${tier.col};font-size:15px">${tier.emoji} Przejedzenie: ${overEat}</strong> <span style="color:#fff;font-size:12px;background:${tier.col}66;padding:2px 8px;border-radius:4px">${tier.lbl}</span>${efekty}<br>
        <span style="color:#aac;font-size:11px;display:block;margin-top:6px">âŹł Spada o <b>3 pkt na minutÄ™</b> realnÄ…. Trening = szybciej (siĹ‚ownia â’5, bieĹĽnia â’8).</span></div>`;
    }
    return `<strong style="color:#27ae60;font-size:17px;display:block;margin-bottom:6px">đźŤ” GĹ‚Ăłd ${Math.floor(G.hunger||0)}/${typeof getMaxStat==='function'?getMaxStat('hunger'):100}</strong><br>Spada z czasem. Jedz w lodĂłwce, restauracji, sklepie. Przy 0 traci zdrowie. Skill â€žApetyt" = wolniejszy gĹ‚Ăłd (-8% / pkt, max -24% przy lvl 3).<br><br><span style="color:#aac;font-size:12px">âš ď¸Ź Jedzenie gdy gĹ‚Ăłd=100 = <b style="color:#f1c40f">przejedzenie</b> (kary natychmiastowe + brak XP z jedzenia).</span>${overTxt}`;
  },
  fame:      ()=>{const _f=Math.floor(G.fame||0);const _t=typeof getFameTier==='function'?getFameTier():0;const _tn=typeof getFameTierName==='function'?getFameTierName():'Underground';const _tC=['#778','#e67e22','#e74c3c','#9b59b6','#f1c40f'];const _tE=['','','','',''];const _tB=['Standardowe mechaniki. Mala Scena 10+, Klub 25+, Arena 55+.','Premium sponsor offers, Documentary event, Magazine cover x1.5 reward.','Sponsor Inbox apka (6 marek), International tour event, Biography deal, Magazine cover x2 reward.','Hall of Fame event (50k zł + statua), Mega Villa (3M zł, +50% regen, +20 mood, +2 fame/dzień), Auto-promo +5 fame/tydzień gry.','Fame x1.2 mult dla concert earn, Crown of Hip-Hop outfit (+20% concert), Atelier app w telefonie, NPC chatter na ulicy, złota aureola.'];const _nT=_t<4?[100,200,300,400,500][_t]:null;const _toN=_nT?' . do '+_nT+' brakuje '+(_nT-_f)+' fame':' (MAX TIER)';const _dim=typeof getFameDimMult==='function'?getFameDimMult():1;const _dimN=_dim<1?' . nagrody fame x'+_dim+' (diminishing)':'';return '<strong style="color:#f1c40f;font-size:17px;display:block;margin-bottom:6px">Slawa '+_f+'/500</strong><div style="color:'+_tC[_t]+';font-size:13px;margin-bottom:6px"><b>Tier '+_t+': '+_tn+'</b>'+_toN+_dimN+'</div><div style="font-size:12px;color:#aaa;line-height:1.4">'+_tB[_t]+'</div><br>Otwiera koncerty (Mala Scena 10+, Klub 25+, Arena 55+), sklepy luksusowe, eventy. Rosnie z koncertow, albumow, eventow. Diminishing returns: 0-100 x1, 100-300 /2, 300-500 /4.';},
  stress:    ()=>`<strong style="color:#9b59b6;font-size:17px;display:block;margin-bottom:6px">đź§  NastrĂłj ${Math.floor(G.stress||0)}/100</strong><br>WpĹ‚ywa na ogĂłlne samopoczucie. Odpoczywaj na sofie/Ĺ‚awce, korzystaj z luksusowych udogodnieĹ„ (sauna, jacuzzi). Niski nastrĂłj = wolniejsza regeneracja.`,
  fitness:   ()=>`<strong style="color:#00bcd4;font-size:17px;display:block;margin-bottom:6px">đź’Ş Forma ${Math.floor(G.forma||0)}/${typeof getMaxStat==='function'?getMaxStat('forma'):100}</strong><br>Trening na Ĺ‚awce/wyciÄ…gu w siĹ‚owni. Forma 100 â†’ +10 max do zdrowia/energii/gĹ‚odu + cinematic milestone. Brak treningu 3+ dni â†’ spada o 10-20% dziennie.`,
  drip:      ()=>{
    const _hasPU=(typeof getRaperST==='function' && getRaperST('autopromocja')>=4);
    const _puNote=_hasPU?'<br><span style="color:#27ae60">đź“˘ Ulepszenie "Personal brand" AKTYWNE â€” capy rozszerzone do +30% / +60% / +75% / +150%</span>':'<br><span style="color:#778">đź“˘ Ulepszenie "Personal brand" (Autopromocja 4 w drzewku rapera): rozszerza capy do +30% / +60% / +75% / +150%</span>';
    return `<strong style="color:#c8a520;font-size:17px;display:block;margin-bottom:6px">đź’Ž Drip ${Math.floor(G.drip||0)}/200</strong>Luksusowy styl. Bonusy liniowo:<br>â€˘ Koncerty (zarobki + fani): +0.1% / pkt â€” drip 200 = +20% (z Ulepszeniem: +30%)<br>â€˘ Spotify/Tidal tantiemy: +0.2% / pkt â€” drip 200 = +40% (z Ulepszeniem: +60%)<br>â€˘ Zaliczki Major/Global Label: +0.8-1.2% / pkt â€” drip 200 = +40-50% (z Ulepszeniem: +60-75%)<br>â€˘ Instagram zasiÄ™g: +0.5% / pkt â€” drip 200 = +100% (z Ulepszeniem: +150%)${_puNote}<br>Kup luksusowe ubrania (Dzielnica Dripu).`;
  },
  /* v2.1.195: tooltip Kondycja z UI % spĂłjnymi z formuĹ‚Ä… (bazÄ… 2.0). Max stat 100 daje +19% prÄ™dkoĹ›Ä‡, skill Kondycja max +10%, skill Bieg max +6%, PU Bieg max +15%, Evo Bieg +15%. Suma 65% nad bazÄ… = cap 3.3. */
  kondycja:  ()=>`<strong style="color:#00bcd4;font-size:17px;display:block;margin-bottom:6px">đźŹ Kondycja ${Math.floor(G.fitness||0)}/100</strong><br>Trening na bieĹĽni w siĹ‚owni â†’ <b>+19% prÄ™dkoĹ›Ä‡ pieszego</b> przy 100/100 + spadek mocy/decay. Plus skill â€žKondycja" w drzewku (${typeof getSkillLvl==='function'?getSkillLvl('kondycja'):0}/5) â†’ +2%/poziom prÄ™dkoĹ›ci (max +10%).`
};
function showHudTooltip(e, key){
  const tip=document.getElementById('hud-tooltip');
  if(!tip || !_HUD_TIPS[key]) return;
  tip.innerHTML=_HUD_TIPS[key]();
  tip.style.display='block';
  // Pozycja: bierz element z data-tip (mouseenter ma currentTarget, mouseover ma target.closest)
  const el=(e.currentTarget&&e.currentTarget.dataset&&e.currentTarget.dataset.tip)?e.currentTarget:(e.target&&e.target.closest?e.target.closest('[data-tip]'):null);
  if(!el) return;
  const rect=el.getBoundingClientRect();
  // Nie pozwĂłl wyjĹ›Ä‡ poza prawÄ… krawÄ™dĹş ekranu
  const tipW=tip.offsetWidth||280;
  tip.style.left=Math.max(8, Math.min(window.innerWidth-tipW-8, rect.left))+'px';
  tip.style.top=(rect.bottom+6)+'px';
}
function hideHudTooltip(){
  const tip=document.getElementById('hud-tooltip');
  if(tip) tip.style.display='none';
}
document.addEventListener('mouseover',e=>{
  if(!e.target||!e.target.closest) return;
  const target=e.target.closest('[data-tip]');
  if(target) showHudTooltip(e, target.dataset.tip);
});
document.addEventListener('mouseout',e=>{
  if(!e.target||!e.target.closest) return;
  const oldTip=e.target.closest('[data-tip]');
  if(!oldTip) return;
  // Nie chowaj jeĹ›li mouse przeszedĹ‚ wewnÄ…trz tego samego data-tip (np. icoâ†’hv)
  const newTip=e.relatedTarget&&e.relatedTarget.closest&&e.relatedTarget.closest('[data-tip]');
  if(newTip===oldTip) return;
  hideHudTooltip();
});
// Per-element listenery jako backup (mouseenter/leave nie bublujÄ…, ale sÄ… niezawodne)
function _attachHudTipListeners(){
  document.querySelectorAll('[data-tip]').forEach(el=>{
    if(el._hudTipBound) return;
    el._hudTipBound=true;
    el.addEventListener('mouseenter',e=>showHudTooltip(e,el.dataset.tip));
    el.addEventListener('mouseleave',hideHudTooltip);
  });
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',_attachHudTipListeners);
else _attachHudTipListeners();
// ZnajdĹş najbliĹĽszy cel/milestone do osiÄ…gniÄ™cia. Zwraca {label, desc, pct, color} lub null.
// Sprawdzane od najwyĹĽszego progu (gdy gracz blisko ukoĹ„czenia) â€” pokazuje pierwszy nieosiÄ…gniÄ™ty.
function findNextGoal(){
  /* v2.1.37 [Amper]: cele bazujÄ… na G.fans lojalnych (HUD) */
  const fans=(G.fans||0);
  const fol=G.followers||0;
  const fame=G.fame||0;
  const lvl=G.level||0;
  // Definicje celĂłw: warunki + progress %.
  const goals=[
    {id:'first_concert',cond:fame<20,label:'đźŽ¤ PIERWSZY KONCERT',desc:`SĹ‚awa ${fame}/20`,pct:Math.min(100,fame/20*100),color:'#e91e8c'},
    {id:'apt_premium',cond:G.apartment==='traphouse'&&fol<2000,label:'đźŹ˘ APARTAMENT PREMIUM',desc:`${fol.toLocaleString('pl')}/2000 fanĂłw (lvl ${lvl}/4)`,pct:Math.min(100,fol/2000*100),color:'#3498db'},
    {id:'merch_unlock',cond:fol<5000&&fol>=1000,label:'đź§˘ STUDIO PROJEKTOWANIA',desc:`${fol.toLocaleString('pl')}/5000 fanĂłw`,pct:Math.min(100,fol/5000*100),color:'#e91e63'},
    {id:'apt_lux',cond:G.apartment!=='luxury'&&fol>=2000&&(fol<10000||fame<50),label:'đź’Ž PENTHOUSE LUX',desc:`${fol.toLocaleString('pl')}/10k fanĂłw Â· sĹ‚awa ${fame}/50`,pct:Math.min(100,Math.min(fol/10000,fame/50)*100),color:'#f1c40f'},
    /* v2.1.167: Mansion goal w widget â€” top tier endgame */
    {id:'apt_mansion',cond:G.apartment==='luxury'&&fame>=80&&(fol<100000||fame<90||lvl<15),label:'đźŹ° REZYDENCJA',desc:`${fol.toLocaleString('pl')}/100k fanĂłw Â· sĹ‚awa ${fame}/90 Â· lvl ${lvl}/15`,pct:Math.min(100,Math.min(fol/100000,fame/90,lvl/15)*100),color:'#e91e8c'},
    /* v2.1.215: Mega Villa goal w widget — Tier 3 Legendary endgame */
    {id:'apt_mega_villa',cond:G.apartment==='mansion'&&fame>=200&&(fol<300000||fame<250||lvl<18),label:'🏖 MEGA VILLA',desc:`${fol.toLocaleString('pl')}/300k fanów · sława ${fame}/250 · lvl ${lvl}/18`,pct:Math.min(100,Math.min(fol/300000,fame/250,lvl/18)*100),color:'#c8a520'},
    {id:'world_tour',cond:fol>=10000&&fol<50000,label:'đźŚŤ WORLD TOUR',desc:`${fol.toLocaleString('pl')}/50k fanĂłw`,pct:Math.min(100,fol/50000*100),color:'#9b59b6'},
    {id:'fame_50',cond:fame>=20&&fame<50,label:'đźŚź GWIAZDA (sĹ‚awa 50)',desc:`SĹ‚awa ${fame}/50`,pct:Math.min(100,fame/50*100),color:'#bb8fce'},
    /* v2.1.216 [Amper]: Tier 1-4 fame milestone goals (system sławy cap 500) */
    {id:'tier_rising',cond:fame>=50&&fame<100,label:'⭐ TIER 1 RISING (fame 100)',desc:`Sława ${fame}/100 — odblokowuje Premium sponsor + Documentary`,pct:Math.min(100,fame/100*100),color:'#e67e22'},
    {id:'tier_famous',cond:fame>=100&&fame<200,label:'🌟 TIER 2 FAMOUS (fame 200)',desc:`Sława ${fame}/200 — odblokowuje Sponsor Inbox + Intl Tour + Biography`,pct:Math.min(100,fame/200*100),color:'#e74c3c'},
    {id:'tier_legendary',cond:fame>=200&&fame<300,label:'🌟 TIER 3 LEGENDARY (fame 300)',desc:`Sława ${fame}/300 — odblokowuje Hall of Fame + Mega Villa + Auto-promo`,pct:Math.min(100,fame/300*100),color:'#9b59b6'},
    {id:'tier_goat',cond:fame>=300&&fame<400,label:'👑 TIER 4 GOAT (fame 400)',desc:`Sława ${fame}/400 — odblokowuje Atelier + Crown + aureola`,pct:Math.min(100,fame/400*100),color:'#f1c40f'},
    {id:'mile_100k',cond:fol>=10000&&!G._mile100k,label:'đź’Ž MILESTONE 100K',desc:`${fol.toLocaleString('pl')}/100 000 fanĂłw`,pct:Math.min(100,fol/100000*100),color:'#c8a520'},
    {id:'prestige',cond:lvl>=10&&lvl<15&&fol>=50000,label:'â­ PRESTIGE (lvl 15)',desc:`Lvl ${lvl}/15`,pct:Math.min(100,lvl/15*100),color:'#f39c12'},
  ];
  // Wybierz pierwszy speĹ‚niony cel
  return goals.find(g=>g.cond&&g.pct<100)||null;
}
let _questWidgetCollapsed=false;
function toggleQuestWidget(){
  _questWidgetCollapsed=!_questWidgetCollapsed;
  document.getElementById('qw-toggle').textContent=_questWidgetCollapsed?'â–˛':'â–Ľ';
  document.getElementById('qw-body').style.display=_questWidgetCollapsed?'none':'';
}
function updateQuestWidget(){
  const w=document.getElementById('quest-widget');
  if(!w) return;
  if(document.getElementById('menu').style.display!=='none'){w.style.display='none';return;}
  // v1.8.77: ukryj widget celĂłw gdy DOWOLNY blokujÄ…cy UI jest otwarty
  if(typeof _uiIsBlocking==='function' && _uiIsBlocking()){w.style.display='none';return;}
  // v1.8.88: ukryj widget celĂłw w pokojach gdzie zasĹ‚ania waĹĽne elementy (kasyno, sklep, kantor, biuro, studio).
  // Pokazuj tylko na ulicy i w mieszkaniach (gdzie gracz spÄ™dza duĹĽo czasu).
  const _allowedRooms=['ulica','mieszkanie','mieszkanie_premium','mieszkanie_lux'];
  if(typeof currentRoom!=='undefined' && !_allowedRooms.includes(currentRoom)){w.style.display='none';return;}
  const items=[];
  // GĹ‚Ăłwna misja
  if(G.mainMission && G.mainMission.active && !G.mainMission.failed){
    /* v2.1.37 [Amper]: storyline pill pokazuje fany lojalnych â€” spĂłjnoĹ›Ä‡ z HUD */
    const totalFans=(G.fans||0);
    const nextMs=G.mainMission.milestones.find(m=>!m.done);
    if(nextMs){
      const pct=Math.min(100, Math.round(totalFans/nextMs.fans*100));
      items.push(`<div style="margin-bottom:8px"><div style="color:#c8a3e3;font-weight:700;font-size:10px;letter-spacing:.5px">đźŽŻ GĹĂ“WNA MISJA</div><div style="color:#ccc;font-size:11px;margin:2px 0">${nextMs.fans.toLocaleString('pl')} fanĂłw<br><span style="color:#888">(${totalFans.toLocaleString('pl')}/${nextMs.fans.toLocaleString('pl')})</span></div><div style="background:#1a1a2a;height:4px;border-radius:2px;overflow:hidden"><div style="background:linear-gradient(90deg,#9b59b6,#c8a3e3);height:100%;width:${pct}%;transition:width .3s"></div></div></div>`);
    }
  }
  // Kontrakt
  if(G.contract && !G.contract.completed){
    const c=G.contract;
    const pct=Math.min(100, Math.round(c.progress/c.target*100));
    const daysLeft=c.deadline-G.day;
    const dlColor=daysLeft<=1?'#e74c3c':daysLeft<=3?'#f39c12':'#aaa';
    items.push(`<div style="margin-bottom:8px"><div style="color:#f1c40f;font-weight:700;font-size:10px;letter-spacing:.5px">đź“‹ KONTRAKT</div><div style="color:#ccc;font-size:11px;margin:2px 0">${c.desc||c.type}<br><span style="color:#888">${c.progress}/${c.target} Â·</span> <span style="color:${dlColor}">${daysLeft>0?daysLeft+' dni':daysLeft===0?'DziĹ›!':'PRZEDAWNIONE'}</span></div><div style="background:#1a1a2a;height:4px;border-radius:2px;overflow:hidden"><div style="background:linear-gradient(90deg,#f39c12,#f1c40f);height:100%;width:${pct}%;transition:width .3s"></div></div></div>`);
  }
  // Daily quest
  if(G.dailyQuest && !G.dailyQuest.claimed){
    const q=G.dailyQuest;
    const pct=Math.min(100, Math.round(q.progress/q.count*100));
    const ready=q.completed===true;
    const headerLine=ready
      ? `<div style="color:#f1c40f;font-weight:700;font-size:10px;letter-spacing:.5px;animation:pulseGold 1.2s ease-in-out infinite">âś… ZADANIE GOTOWE â€” ODBIERZ U WIKTORA!</div>`
      : `<div style="color:#7ec87e;font-weight:700;font-size:10px;letter-spacing:.5px">â­ DZIENNE ZADANIE</div>`;
    items.push(`<div style="margin-bottom:6px">${headerLine}<div style="color:#ccc;font-size:11px;margin:2px 0">${q.desc}<br><span style="color:#888">${q.progress}/${q.count} Â·</span> <span style="color:#f1c40f">+${q.reward}zĹ‚ +${q.xp}XP</span></div><div style="background:#1a1a2a;height:4px;border-radius:2px;overflow:hidden"><div style="background:linear-gradient(90deg,${ready?'#f1c40f,#fff8d0':'#27ae60,#7ec87e'});height:100%;width:${pct}%;transition:width .3s"></div></div></div>`);
  }
  // Festiwal aktywny
  if(G.activeFestival){
    const f=G.activeFestival;
    const daysLeft=f.expiresDay-G.day;
    /* v2.1.114: Wave 2 K15 â€” pokaĹĽ konkretne bonusy festiwalu (gracz wczeĹ›niej nie wiedziaĹ‚ co aktywuje). */
    const _effects=[];
    if(f.effect){
      if(f.effect.concertFameMult) _effects.push(`Koncert sĹ‚awa Ă—${f.effect.concertFameMult}`);
      if(f.effect.merchSalesMult) _effects.push(`Merch Ă—${f.effect.merchSalesMult}`);
      if(f.effect.repMult) _effects.push(`Rep uliczna Ă—${f.effect.repMult}`);
      if(f.effect.freestyleBoost) _effects.push(`Freestyle XP Ă—${f.effect.freestyleBoost}`);
      if(f.effect.recordingQualityBoost) _effects.push(`Nagrania jakoĹ›Ä‡ Ă—${f.effect.recordingQualityBoost}`);
      if(f.effect.labelOfferBoost) _effects.push(`Label A&R deals +25%`);
    }
    const _bonusText=_effects.length>0?`<div style="color:#e9b8ff;font-size:10px;margin-top:3px;line-height:1.4">${_effects.join(' Â· ')}</div>`:'';
    items.push(`<div style="margin-bottom:6px;background:#1a0a2a;border-radius:6px;padding:6px 8px"><div style="color:#e91e8c;font-weight:700;font-size:10px;letter-spacing:.5px">${f.name}</div><div style="color:#ccc;font-size:11px;margin-top:2px">${daysLeft} ${daysLeft===1?'dzieĹ„':'dni'} pozostaĹ‚o</div>${_bonusText}</div>`);
  }
  /* v2.1.114: Wave 2 K15 â€” aktywne Ĺ›wiÄ™to teĹĽ z bonusami */
  if(G.activeHoliday){
    const h=G.activeHoliday;
    const _hEffects=[];
    if(h.id==='sylwester') _hEffects.push('Koncerty Ă—2.0 + 100 fanĂłw');
    else if(h.id==='majowka') _hEffects.push('Koncerty Ă—1.5');
    else if(h.id==='halloween') _hEffects.push('Rep uliczna Ă—1.5');
    else if(h.id==='blackfriday') _hEffects.push('Merch Ă—3 + sklepy -20%');
    else if(h.id==='walentynki') _hEffects.push('Insta +25% zasiÄ™g');
    else if(h.id==='wigilia') _hEffects.push('+500 zĹ‚ od fanĂłw');
    const _holidayBonusText=_hEffects.length>0?`<div style="color:#7ec8e3;font-size:10px;margin-top:3px;line-height:1.4">${_hEffects.join(' Â· ')}</div>`:'';
    items.push(`<div style="margin-bottom:6px;background:#0a1a2a;border-radius:6px;padding:6px 8px"><div style="color:#7ec8e3;font-weight:700;font-size:10px;letter-spacing:.5px">đźŽ‰ ${h.name||h.id.toUpperCase()}</div>${_holidayBonusText}</div>`);
  }
  // NastÄ™pny milestone â€” automatyczny goal tracker (najbliĹĽszy odblokowany cel)
  const goal=findNextGoal();
  if(goal){
    items.push(`<div style="margin-bottom:6px;background:#0a1a2a;border-radius:6px;padding:6px 8px;border-left:2px solid ${goal.color||'#7ec8e3'}"><div style="color:${goal.color||'#7ec8e3'};font-weight:700;font-size:10px;letter-spacing:.5px">${goal.label}</div><div style="color:#ccc;font-size:11px;margin:2px 0">${goal.desc}</div><div style="background:#1a1a2a;height:4px;border-radius:2px;overflow:hidden"><div style="background:linear-gradient(90deg,${goal.color||'#7ec8e3'},#fff);height:100%;width:${goal.pct}%;transition:width .3s"></div></div></div>`);
  }
  if(items.length===0){w.style.display='none';return;}
  w.style.display='';
  if(!_questWidgetCollapsed) document.getElementById('qw-body').innerHTML=items.join('');
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  OVERLAY HELPERS
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function openOverlay(){
  const ov=document.getElementById('overlay');
  ov.classList.add('on');
  // v1.8.20: ambient particles w tle duĹĽych overlay'i (kasyno/studio/itp.)
  try{
    if(!ov.querySelector('.ambient-bg-particles')){
      const layer=document.createElement('div');
      layer.className='ambient-bg-particles';
      layer.style.cssText='position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0;';
      for(let i=0;i<14;i++){
        const p=document.createElement('div');
        p.className='ambient-particle';
        const size=2+Math.random()*3;
        const dur=12+Math.random()*10;
        const delay=Math.random()*14;
        const hue=Math.floor(Math.random()*60)+180; // niebieski-cyan zakres
        p.style.cssText=`position:absolute;left:${Math.random()*100}%;bottom:-20px;width:${size}px;height:${size}px;border-radius:50%;background:hsla(${hue},70%,70%,.5);box-shadow:0 0 ${size*3}px hsla(${hue},80%,70%,.5);animation:ambientFloat ${dur}s linear ${delay}s infinite;`;
        layer.appendChild(p);
      }
      ov.appendChild(layer);
    }
  }catch(_){}
}
function closeOverlay(){
  // v1.8.17: finalize aktywny spin kasyna PRZED zamkniÄ™ciem (zapobiega exploitowi
  // gdzie gracz uruchamiaĹ‚ spin â†’ wychodziĹ‚ â†’ wracaĹ‚ â†’ przyspieszaĹ‚ animacjÄ™)
  try{if(typeof window._activeCasinoFinalize==='function'){window._activeCasinoFinalize();}}catch(e){}
  // v1.8.53: zerujemy hook nawet jeĹ›li finalize siÄ™ wywaliĹ‚o â€” unikniÄ™cie ghost-callback'a
  window._activeCasinoFinalize=null;
  document.getElementById('overlay').classList.remove('on');
  document.getElementById('ov-content').innerHTML='';
}
function overlayOpen(){return document.getElementById('overlay').classList.contains('on');}
function isOverlayOpen(){
  // F+ 2026-05-12 #66: dodano sprawdzenie cinematic â€” gdy gracz dostaje milestone cinematic,
  // kroki nie powinny byÄ‡ sĹ‚yszalne (bo P.moving moĹĽe byÄ‡ true gdy gracz szedĹ‚ w momencie wyskoczenia)
  return document.getElementById('overlay').classList.contains('on')||
         document.getElementById('mg-pizza').classList.contains('on')||
         document.getElementById('mg-edit').classList.contains('on')||
         document.getElementById('mg-job').classList.contains('on')||
         document.getElementById('mg-yt').classList.contains('on')||
         document.getElementById('npc-dlg').classList.contains('on')||
         (document.getElementById('phone')&&document.getElementById('phone').classList.contains('on'))||
         !!document.querySelector('[id$="-cinematic"]');
}
function closeMG(){
  sfxOvenStop();
  document.getElementById('mg-yt').classList.remove('on');
  document.getElementById('mg-pizza').classList.remove('on');
  document.getElementById('mg-edit').classList.remove('on');
  const mjob=document.getElementById('mg-job');
  mjob.classList.remove('on');
  mjob.style.display='none';
  if(recBarAnim){clearInterval(recBarAnim);recBarAnim=null;}
  if(window._ytMgCleanup){window._ytMgCleanup();window._ytMgCleanup=null;}
  if(window._jobMgCleanup){window._jobMgCleanup();window._jobMgCleanup=null;}
  // Ensure mg-job-content child exists for old-style jobs
  if(!document.getElementById('mg-job-content')){
    mjob.innerHTML='<div id="mg-job-content"></div>';
  }
}
function mgOpen(){
  return document.getElementById('mg-yt').classList.contains('on')||
         document.getElementById('mg-pizza').classList.contains('on')||
         document.getElementById('mg-edit').classList.contains('on')||
         document.getElementById('mg-job').classList.contains('on');
}
