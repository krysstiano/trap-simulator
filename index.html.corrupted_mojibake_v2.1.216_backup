  document.getElementById('cinem-offer')?.remove();
  const m=document.createElement('div');
  m.id='cinem-offer';
  m.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:9998;display:flex;align-items:center;justify-content:center;animation:bdFadeIn .3s';
  m.innerHTML=`
    <div style="background:linear-gradient(135deg,#0a1525,#1a0a3a);border:2px solid #c8a520;border-radius:20px;padding:36px 44px;max-width:540px;text-align:center;box-shadow:0 0 80px rgba(200,165,32,.5)">
      <div style="font-size:54px;margin-bottom:14px">đźŽ¬</div>
      <h2 style="color:#c8a520;margin:0 0 14px;font-size:24px;letter-spacing:2px">PRZELOT KAMERÄ„ PO MIEĹšCIE</h2>
      <p style="color:#d8d8e8;font-size:14px;line-height:1.6;margin-bottom:20px">Nie odbyĹ‚eĹ› jeszcze przelotu po mieĹ›cie. PokaĹĽemy Ci kluczowe lokacje z lotu ptaka: gdzie mieszkasz, gdzie pracujesz, gdzie kupisz lepsze mieszkania, jak wyglÄ…da Drip District, Kasyno i wiele wiÄ™cej.<br><br><span style="color:#7ec87e;font-size:13px">đź’ˇ Trwa okoĹ‚o 2 minuty. MoĹĽesz pominÄ…Ä‡ w kaĹĽdej chwili.</span></p>
      <button onclick="document.getElementById('cinem-offer').remove();window.openCinematicFlythrough();" style="background:linear-gradient(135deg,#c8a520,#f1c40f);color:#000;border:none;padding:14px 28px;font-size:16px;font-weight:800;border-radius:10px;cursor:pointer;margin:0 8px;letter-spacing:1px;font-family:inherit">â–¶ URUCHOM PRZELOT</button>
      <button onclick="document.getElementById('cinem-offer').remove();G._cinematicCompleted=true;if(typeof saveGameSilent==='function')saveGameSilent();" style="background:transparent;color:#aac;border:1px solid #3a4a5a;padding:14px 24px;font-size:14px;border-radius:10px;cursor:pointer;margin:0 8px;font-family:inherit">PomiĹ„ (juĹĽ nie pytaj)</button>
    </div>`;
  document.body.appendChild(m);
};

/* v1.9.87/v1.9.89: AERIAL CAMERA FLYTHROUGH â€” prawdziwy cinematic przelot przez miasto */
window.openCinematicFlythrough=()=>{
  if(currentRoom!=='ulica'){
    if(typeof showMsg==='function') showMsg('đźŽ¬ WyjdĹş z mieszkania ĹĽeby zobaczyÄ‡ przelot po mieĹ›cie','f',4500);
    return;
  }
  G._cinematicActive=true;
  G._introPausedBefore=(typeof _paused!=='undefined')?_paused:false;
  if(typeof _paused!=='undefined') _paused=true;
  /* v1.9.99: HUD off podczas cinematic */
  document.body.classList.add('cinematic-active');
  window._cinemCam={active:true,targetX:cam.x,targetY:cam.y,highlight:null,targetZoom:1.0,hlOpacity:0,hlPhase:0,lerpMul:1};
  cam.zoom=1.0;
  /* v1.9.99: POPRAWNE pozycje (verified z ROOMS.ulica.objects):
     - Zbyszek (kebab): npc_vendor wx:1528 wy:720 â†’ centrum 1545,748 (BYĹO 1180,752 = Studio Merch!)
     - Wszystkie pozycje wybraĹ‚em na podstawie wx+w/2, wy+h/2 z ROOMS.ulica.objects
     "panSweep:true" w topic = jeden pĹ‚ynny przelot przez places z ciÄ…gĹ‚ym zoomem (nie osobne zoomy per budynek) */
  const TOPICS=[
    {
      em:'đźŹ ', title:'TWĂ“J DOM â€” START I PROGRESJA',
      desc:'Zaczynasz w biednym Traphouse. Z czasem moĹĽesz kupiÄ‡ lepsze mieszkania w Biurze NieruchomoĹ›ci: Mieszkanie Basic (komfort), Penthouse (luksus), Apartament Premium (basen+jacuzzi), Rezydencja (mansion z helipadem).',
      places:[
