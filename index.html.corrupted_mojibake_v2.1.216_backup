      <div class="sitem"><h3>đź’» PC Starter + DAW Basic</h3><p>Podstawowy setup â€” nagrywanie i prosty miks. +15 pkt jakoĹ›ci nagraĹ„.</p><p style="color:#00bcd4;font-size:12px">DAW Basic Â· +15 jakoĹ›ci</p><div class="pr">2 000 zĹ‚</div>${G.hasDaw&&G.dawTier===1?'<div class="owned">âś… Posiadasz</div>':''}<button class="bbtn" onclick="buyDaw(1,2000)" ${(G.hasDaw&&G.dawTier>=1)||G.money<2000?'disabled':''}>Kup</button></div>
      <div class="sitem"><h3>đź’» PC Gaming + DAW Pro</h3><p>Szybszy procesor, Pro Tools/FL Studio. +25 pkt jakoĹ›ci, lepszy mix.</p><p style="color:#00bcd4;font-size:12px">DAW Pro Â· +25 jakoĹ›ci</p><div class="pr">5 500 zĹ‚</div>${G.hasDaw&&G.dawTier===2?'<div class="owned">âś… Posiadasz</div>':''}<button class="bbtn" onclick="buyDaw(2,5500)" ${(G.hasDaw&&G.dawTier>=2)||G.money<5500?'disabled':''}>Kup</button></div>
      <div class="sitem"><h3>đź–Ąď¸Ź Mac Studio + Logic Pro</h3><p>Profesjonalna stacja robocza. +40 pkt jakoĹ›ci nagraĹ„, top brzmienie.</p><p style="color:#00bcd4;font-size:12px">DAW Top Â· +40 jakoĹ›ci</p><div class="pr">12 000 zĹ‚</div>${G.hasDaw&&G.dawTier===3?'<div class="owned">âś… Posiadasz</div>':''}<button class="bbtn" onclick="buyDaw(3,12000)" ${(G.hasDaw&&G.dawTier>=3)||G.money<12000?'disabled':''}>Kup</button></div>
    </div>
    <div class="res" id="shop-res">Wybierz produkt.</div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
}

// Szafa w mieszkaniu â€” TYLKO zmiana posiadanych outfitĂłw (bez kupowania).
// KupowaÄ‡ moĹĽna w 'shop:ubrania' (Ubrania w mieĹ›cie).
// F5.4 E2: Palety kolorĂłw
const _PALETTE_BODY = [
  {hex:'#2a3050',name:'Granat'},
  {hex:'#1a1a2a',name:'Czarny'},
  {hex:'#5a1a1a',name:'Burgund'},
  {hex:'#1a3a1a',name:'Las'},
  {hex:'#3a2010',name:'BrÄ…z'},
  {hex:'#5a4a1a',name:'Khaki'},
  {hex:'#4a1a4a',name:'Fiolet'},
  {hex:'#888888',name:'Szary'},
  {hex:'#f5f5f5',name:'BiaĹ‚y'},
];
const _PALETTE_ACCENT = [
  {hex:'#e74c3c',name:'Czerwony'},
  {hex:'#3498db',name:'Niebieski'},
  {hex:'#2ecc71',name:'Zielony'},
  {hex:'#f1c40f',name:'ZĹ‚oty'},
  {hex:'#bdc3c7',name:'Srebrny'},
  {hex:'#e91e8c',name:'RĂłĹĽowy'},
  {hex:'#e67e22',name:'PomaraĹ„czowy'},
  {hex:'#9b59b6',name:'Fioletowy'},
  {hex:'#1a1a1a',name:'Czarny'},
];

// F5.4 E2: Definicja jakie kolory wybiera gracz dla kaĹĽdego outfit
const _OUTFIT_COLOR_SLOTS = {
  default: [],
  street: [{key:'body', label:'Kolor bluzy', palette:_PALETTE_BODY, def:'#2a2a3a'}],
  suit: [{key:'body', label:'Kolor marynarki', palette:_PALETTE_BODY, def:'#0a0a1a'}, {key:'tie', label:'Kolor krawatu', palette:_PALETTE_ACCENT, def:'#8b1a2a'}],
  sport: [{key:'body', label:'Kolor koszulki', palette:_PALETTE_BODY, def:'#f5f5f5'}, {key:'accent', label:'Kolor opaski', palette:_PALETTE_ACCENT, def:'#3498db'}],
  sport_pro: [{key:'body', label:'Kolor koszulki', palette:_PALETTE_BODY, def:'#1a1a1a'}, {key:'accent', label:'Kolor swoosha', palette:_PALETTE_ACCENT, def:'#e74c3c'}],
  music: [{key:'accent', label:'Kolor Ĺ‚aĹ„cucha', palette:_PALETTE_ACCENT, def:'#f1c40f'}],
  luxury: [{key:'body', label:'Kolor koszulki', palette:_PALETTE_BODY, def:'#2a5080'}, {key:'accent', label:'Kolor akcentĂłw', palette:_PALETTE_ACCENT, def:'#f1c40f'}],
  // F5.4 E3: nowe ubrania
  polo: [{key:'body', label:'Kolor koszulki', palette:_PALETTE_BODY, def:'#3a8a5a'}],
  jeansowa: [{key:'body', label:'Kolor jeansu', palette:_PALETTE_BODY, def:'#2a4a7a'}],
  zimowa: [{key:'body', label:'Kolor kurtki', palette:_PALETTE_BODY, def:'#3a3a4a'}],
  smoking: [{key:'accent', label:'Kolor poszetki', palette:_PALETTE_ACCENT, def:'#e74c3c'}],
  designer_concert: [{key:'body', label:'Kolor stroju', palette:_PALETTE_BODY, def:'#1a0a3a'}, {key:'accent', label:'Kolor akcentĂłw', palette:_PALETTE_ACCENT, def:'#e91e8c'}],
  /* v2.1.148 hotfix: color palettes dla 3 nowych outfitĂłw */
  tracksuit: [{key:'body', label:'Kolor dresika', palette:_PALETTE_BODY, def:'#1a3a4a'}],
  leather_jacket: [{key:'body', label:'Kolor skĂłry', palette:_PALETTE_BODY, def:'#1a0a0a'}],
  designer_hoodie: [{key:'body', label:'Kolor bluzy', palette:_PALETTE_BODY, def:'#2a1a3a'}],
};

// F5.4 E4: Mini-podglÄ…d postaci w danym outfit (uproszczony â€” emoji + kolor body)
window.drawPreviewPlayer = function(canvasEl, outfitId){
  const ctx = canvasEl.getContext('2d');
  ctx.clearRect(0,0,canvasEl.width,canvasEl.height);
  const scale = canvasEl.width / 32;
  ctx.save();
  ctx.scale(scale, scale);
  const cw = canvasEl.width/scale;
  const ch = canvasEl.height/scale;
  const cx = cw/2;
  const sy = 2;
  const w = 28, h = 36;
  const sc = SKIN_COLS[P.skin]||SKIN_COLS.light;
  const oc = (G.outfitColors && G.outfitColors[outfitId]) || {};
  // Default body color z _OUTFIT_COLOR_SLOTS
  const defSlot = (_OUTFIT_COLOR_SLOTS[outfitId] || []).find(s => s.key === 'body');
  const defAccentSlot = (_OUTFIT_COLOR_SLOTS[outfitId] || []).find(s => s.key === 'accent');
  const cc = oc.body || (defSlot && defSlot.def) || P.cloth || '#2a5080';
  const accent = oc.accent || (defAccentSlot && defAccentSlot.def) || '#f1c40f';
  const pc = P.pants||G.pants||'#1a2a3a';
  const shc = P.shoes||G.shoes||'#0a0a0a';
  // CieĹ„
  ctx.fillStyle='rgba(0,0,0,.3)';
  ctx.beginPath(); ctx.ellipse(cx, sy+h-1, 11, 3, 0, 0, Math.PI*2); ctx.fill();
  // Spodnie
  ctx.fillStyle = pc;
  ctx.fillRect(cx-9, sy+h*.64, 9, h*.32);
  ctx.fillRect(cx, sy+h*.64, 9, h*.32);
  // Buty
  ctx.fillStyle = shc;
  ctx.beginPath(); ctx.ellipse(cx-5, sy+h-2, 6, 3, 0, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(cx+5, sy+h-2, 6, 3, 0, 0, Math.PI*2); ctx.fill();
  // Tors (kolor outfit)
  ctx.fillStyle = cc;
  ctx.fillRect(cx-12, sy+h*.42, 24, h*.24);
  // KoĹ‚nierz lighter
  ctx.fillStyle = lightenHex(cc, 15);
  ctx.fillRect(cx-12, sy+h*.42, 24, 3);
  // Ramiona â€” outfit overlay (sport/sport_pro majÄ… skin, inne kolor outfit)
  if(outfitId === 'sport' || outfitId === 'sport_pro') ctx.fillStyle = sc;
  else if(outfitId === 'default') ctx.fillStyle = sc;
  else ctx.fillStyle = cc;
  ctx.fillRect(cx-17, sy+h*.43, 5, h*.22);
  ctx.fillRect(cx+12, sy+h*.43, 5, h*.22);
  // Szyja
  ctx.fillStyle = sc;
  ctx.fillRect(cx-4, sy+h*.36, 8, h*.07);
  // GĹ‚owa
  ctx.fillRect(cx-11, sy+h*.10, 22, 18);
  ctx.beginPath(); ctx.arc(cx, sy+h*.10+3, 11, Math.PI, 0); ctx.fill();
  // WĹ‚osy
  ctx.fillStyle = '#3a2010';
  ctx.beginPath(); ctx.arc(cx, sy+h*.10+5, 10, Math.PI, 0); ctx.fill();
  // Oczy â€” sync z drawPlayer v1.8.29 (biaĹ‚ka + Ĺşrenice + highlight)
  ctx.fillStyle = 'rgba(255,255,255,.85)';
  ctx.beginPath(); ctx.arc(cx-4, sy+h*.24, 2.4, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+4, sy+h*.24, 2.4, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = 'rgba(20,20,40,.95)';
  ctx.beginPath(); ctx.arc(cx-4, sy+h*.24, 1.4, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+4, sy+h*.24, 1.4, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,.9)';
  ctx.beginPath(); ctx.arc(cx-4.4, sy+h*.235, 0.5, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+3.6, sy+h*.235, 0.5, 0, Math.PI*2); ctx.fill();
  // UĹ›miech â€” szerszy, Ĺ‚agodniejszy Ĺ‚uk
  ctx.strokeStyle = 'rgba(40,15,15,.7)';
  ctx.lineWidth = 1.3; ctx.lineCap = 'round';
  ctx.beginPath(); ctx.arc(cx, sy+h*.31, 3.5, 0.15*Math.PI, 0.85*Math.PI); ctx.stroke();
  ctx.lineCap = 'butt';

  // OUTFIT-SPECIFIC ZNACZNIK (uproszczony â€” kluczowy element)
  const torsoY = sy + h*.42;
  const torsoH = h*.24;
  if(outfitId === 'suit'){
    // Marynarka czarna na Ĺ›rodku V + krawat
    ctx.fillStyle = '#0a0a1a';
    ctx.beginPath();
    ctx.moveTo(cx-12, torsoY); ctx.lineTo(cx-3, torsoY); ctx.lineTo(cx-1, torsoY+5);
    ctx.lineTo(cx-3, torsoY+torsoH); ctx.lineTo(cx-12, torsoY+torsoH); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx+12, torsoY); ctx.lineTo(cx+3, torsoY); ctx.lineTo(cx+1, torsoY+5);
    ctx.lineTo(cx+3, torsoY+torsoH); ctx.lineTo(cx+12, torsoY+torsoH); ctx.closePath(); ctx.fill();
    // Krawat
    ctx.fillStyle = oc.tie || '#8b1a2a';
    ctx.fillRect(cx-2, torsoY+1, 4, torsoH-1);
  } else if(outfitId === 'smoking'){
    ctx.fillStyle = '#000';
    ctx.fillRect(cx-12, torsoY, 24, torsoH);
    // BiaĹ‚a koszula V
    ctx.fillStyle = '#fff';
    ctx.fillRect(cx-3, torsoY, 6, torsoH);
    // Mucha
    ctx.fillStyle = '#000';
    ctx.beginPath();
    ctx.moveTo(cx-3, torsoY); ctx.lineTo(cx-3, torsoY+3); ctx.lineTo(cx, torsoY+1.5);
    ctx.lineTo(cx+3, torsoY+3); ctx.lineTo(cx+3, torsoY); ctx.closePath(); ctx.fill();
  } else if(outfitId === 'street' || outfitId === 'zimowa'){
    // Kaptur za gĹ‚owÄ…
    ctx.fillStyle = darkenHex(cc, 25);
    ctx.beginPath();
    ctx.ellipse(cx, sy+h*.36, 13, 5, 0, 0, Math.PI);
    ctx.fill();
  } else if(outfitId === 'sport' || outfitId === 'sport_pro'){
    // Opaska
    ctx.fillStyle = accent;
    ctx.fillRect(cx-11, sy+h*.16, 22, 2);
    // Akcent dol koszulki
    ctx.fillRect(cx-12, torsoY+torsoH-1.5, 24, 1.5);
  } else if(outfitId === 'music'){
    // ZĹ‚oty Ĺ‚aĹ„cuch
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.ellipse(cx, torsoY+1, 6, 1.5, 0, 0, Math.PI);
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx, torsoY+3); ctx.lineTo(cx-2.5, torsoY+5.5);
    ctx.lineTo(cx, torsoY+8); ctx.lineTo(cx+2.5, torsoY+5.5); ctx.closePath();
    ctx.fill();
  } else if(outfitId === 'luxury'){
    // Gruby Ĺ‚aĹ„cuch + diamond
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.ellipse(cx, torsoY+1, 7, 2, 0, 0, Math.PI);
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx, torsoY+3); ctx.lineTo(cx-3, torsoY+6.5);
    ctx.lineTo(cx, torsoY+10); ctx.lineTo(cx+3, torsoY+6.5); ctx.closePath();
    ctx.fill();
    // Epolety
    ctx.fillRect(cx-17, torsoY+1, 5, 1.5);
    ctx.fillRect(cx+12, torsoY+1, 5, 1.5);
  } else if(outfitId === 'designer_concert'){
    // Zigzag akcent
    ctx.strokeStyle = accent;
    ctx.lineWidth = 1.3;
    ctx.beginPath();
    ctx.moveTo(cx-10, torsoY+3); ctx.lineTo(cx-7, torsoY+5);
    ctx.lineTo(cx-3, torsoY+3); ctx.lineTo(cx, torsoY+5);
    ctx.lineTo(cx+3, torsoY+3); ctx.lineTo(cx+7, torsoY+5);
    ctx.lineTo(cx+10, torsoY+3);
    ctx.stroke();
  } else if(outfitId === 'jeansowa'){
    // 2 kieszenie
    ctx.fillStyle = darkenHex(cc, 25);
    ctx.fillRect(cx-9, torsoY+5, 5, 3);
    ctx.fillRect(cx+4, torsoY+5, 5, 3);
    // MosiÄ™ĹĽne guziki
    ctx.fillStyle = '#c89020';
    ctx.beginPath(); ctx.arc(cx-6.5, torsoY+6.5, 0.5, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx+6.5, torsoY+6.5, 0.5, 0, Math.PI*2); ctx.fill();
  } else if(outfitId === 'polo'){
    // KoĹ‚nierzyk V
    ctx.fillStyle = lightenHex(cc, 25);
    ctx.beginPath();
    ctx.moveTo(cx-7, torsoY); ctx.lineTo(cx-2, torsoY+4); ctx.lineTo(cx-2, torsoY); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx+7, torsoY); ctx.lineTo(cx+2, torsoY+4); ctx.lineTo(cx+2, torsoY); ctx.closePath(); ctx.fill();
  }
  ctx.restore();
};

window.setOutfitColor = function(outfitId, key, hex){
  if(!G.outfitColors) G.outfitColors = {};
  if(!G.outfitColors[outfitId]) G.outfitColors[outfitId] = {};
  G.outfitColors[outfitId][key] = hex;
  // JeĹ›li zmieniany jest aktywny outfit â€” od razu zaktualizuj P.cloth dla "body"
  if(G.outfit && G.outfit.top === outfitId && key === 'body'){
    P.cloth = hex;
  }
  if(typeof renderWardrobeChange === 'function') renderWardrobeChange();
};

function _renderColorPalette(outfitId){
  const slots = _OUTFIT_COLOR_SLOTS[outfitId] || [];
  if(slots.length === 0) return '';
  const oc = (G.outfitColors && G.outfitColors[outfitId]) || {};
  let html = '<div style="background:#1a1a2a;border:1px solid #2a3a50;border-radius:8px;padding:12px;margin-top:10px">';
  html += '<div style="color:#7ec87e;font-size:11px;font-weight:700;letter-spacing:1px;margin-bottom:8px">đźŽ¨ KOLORY OUTFITA</div>';
  for(const slot of slots){
    const cur = oc[slot.key] || slot.def;
    html += `<div style="margin-bottom:10px"><div style="color:#aac;font-size:12px;margin-bottom:4px">${slot.label}: <span style="color:${cur};font-weight:700">${(slot.palette.find(p=>p.hex===cur)||{}).name||'wĹ‚asny'}</span></div>`;
    html += '<div style="display:flex;gap:4px;flex-wrap:wrap">';
    for(const c of slot.palette){
      const sel = c.hex === cur ? 'border:2px solid #fff;box-shadow:0 0 8px rgba(255,255,255,0.5)' : 'border:2px solid #333';
      html += `<button onclick="setOutfitColor('${outfitId}','${slot.key}','${c.hex}')" title="${c.name}" style="width:28px;height:28px;background:${c.hex};${sel};border-radius:6px;cursor:pointer;padding:0"></button>`;
    }
    html += '</div></div>';
  }
  html += '</div>';
  return html;
}

function renderWardrobeChange(){
  const allOutfits=[
    {id:'default',name:'Podstawowy',emoji:'đź‘•',desc:'ZwykĹ‚e ubranie',bonus:'Brak'},
    {id:'polo',name:'Koszulka polo',emoji:'đź§µ',desc:'Casualowo-elegancki, z koĹ‚nierzykiem',bonus:'+1 sĹ‚awa przy zaĹ‚ozeniu'},
    {id:'street',name:'Streetwear',emoji:'đź§Ą',desc:'Uliczny styl',bonus:'+3 rep przy zaĹ‚ozeniu'},
    {id:'jeansowa',name:'Kurtka jeansowa',emoji:'đźĄľ',desc:'Uliczny vibe, denim z kieszeniami',bonus:'+2 rep + â’50% utraty ZDROWIA w mrozie + +4% koncerty'}, /* v2.1.129: FORMYâ†’ZDROWIA (kod aplikuje do G.health), dodano +4% koncerty (kod 20934) */
    {id:'zimowa',name:'Kurtka zimowa',emoji:'đź§Ł',desc:'Gruba puchĂłwka z kapturem futrzanym',bonus:'â’85% utraty zdrowia w mrozie + +2% koncerty'}, /* v2.1.129: dodano +2% koncerty (kod 20933) */
    {id:'suit',name:'Garnitur',emoji:'đź‘”',desc:'Elegancki',bonus:'+5 sĹ‚awa przy zaĹ‚ozeniu + +5% koncerty'}, /* v2.1.129: dodano +5% koncerty (kod 20928) */
    {id:'smoking',name:'Smoking',emoji:'đźŽ©',desc:'Luksusowy event-only',bonus:'+15 sĹ‚awa (pierwszy zakup) Â· +10% koncerty'},
    {id:'sport',name:'StrĂłj sportowy',emoji:'đźŹ‹',desc:'Do treningu',bonus:'+20% przyrost forma/kondycja w siĹ‚owni + +3% koncerty'}, /* v2.1.129: dodano +3% koncerty (kod 20930) */
    {id:'sport_pro',name:'StrĂłj treningowy PRO',emoji:'đźĄ‹',desc:'Profesjonalny do treningu',bonus:'+25% przyrost + 1 dodatkowa sesja siĹ‚y i cardio + +5% koncerty'}, /* v2.1.129: dodano +5% koncerty (kod 20931) */
    {id:'music',name:'Outfit muzyczny',emoji:'đźŽ¤',desc:'Sceniczny',bonus:'+5% koncerty'},
    {id:'designer_concert',name:'Designerski koncertowy',emoji:'đźŚź',desc:'Sceniczny z wzorem geometrycznym',bonus:'+15% zarobki z koncertĂłw + +5 sĹ‚awy'},
    {id:'luxury',name:'Luxury drip',emoji:'đź’Ž',desc:'WyrĂłĹĽnia siÄ™',bonus:'+10 sĹ‚awa przy zaĹ‚oĹĽeniu + +12% koncerty'}, /* v2.1.129: dodano +12% koncerty (kod 20932) */
    /* v2.1.148: 3 nowe outfity â€” tracksuit (street/casual), leather_jacket (rock), designer_hoodie (drip premium) */
    {id:'tracksuit',name:'Dresik',emoji:'đźĄ‹',desc:'Wygodny street look',bonus:'+2 rep + +2% koncerty + +3% siĹ‚ownia'},
    {id:'leather_jacket',name:'Kurtka skĂłrzana',emoji:'đź§Ą',desc:'Rock vibe',bonus:'+5 sĹ‚awa przy zakupie + +6% koncerty + +2 rep'},
    {id:'designer_hoodie',name:'Designer hoodie',emoji:'đź‘•',desc:'Premium streetwear z logiem',bonus:'+8 sĹ‚awa przy zakupie + +8% koncerty + +10 drip'},
  ];
  G._ownedOutfits=G._ownedOutfits||[];
  const owned=allOutfits.filter(o=>o.id==='default'||G._ownedOutfits.includes(o.id)||G.outfit.top===o.id);
  const outfitNames={default:'Podstawowy đź‘•',polo:'Polo đź§µ',street:'Streetwear đź§Ą',jeansowa:'Jeansowa đźĄľ',zimowa:'Zimowa đź§Ł',suit:'Garnitur đź‘”',smoking:'Smoking đźŽ©',sport:'Sportowy đźŹ‹',sport_pro:'Treningowy PRO đźĄ‹',music:'Muzyczny đźŽ¤',designer_concert:'Designerski đźŚź',luxury:'Luxury đź’Ž',tracksuit:'Dresik đźĄ‹',leather_jacket:'Kurtka skĂłrzana đź§Ą',designer_hoodie:'Designer hoodie đź‘•'}; /* v2.1.148 hotfix: 3 nowe outfity */
  const activeId = G.outfit.top || 'default';
  const palette = _renderColorPalette(activeId);
  // F5.4 E4: sekcje
  const SECTIONS = [
    {label:'đź‘• Casualowe', color:'#3498db', ids:['default','polo','street','jeansowa']},
    {label:'đź§Ł Zimowe', color:'#5dade2', ids:['zimowa']},
    {label:'đź‘” Eleganckie', color:'#9b59b6', ids:['suit','smoking']},
    {label:'đźŹ‹ Sportowe', color:'#e67e22', ids:['sport','sport_pro']},
    {label:'đźŽ¤ Sceniczne', color:'#e91e8c', ids:['music','designer_concert']},
    {label:'đź’Ž Luksusowe', color:'#f1c40f', ids:['luxury']},
  ];
  // Uniqe canvas ID per outfit
  let sectionsHtml = '';
  for(const sec of SECTIONS){
    const ownedInSec = owned.filter(o => sec.ids.includes(o.id));
    if(ownedInSec.length === 0) continue;
    sectionsHtml += `<div style="margin-top:18px"><div style="color:${sec.color};font-size:13px;font-weight:700;letter-spacing:1.5px;margin-bottom:8px;border-bottom:1px solid ${sec.color}33;padding-bottom:4px">${sec.label} (${ownedInSec.length})</div>`;
    sectionsHtml += '<div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:8px">';
    for(const o of ownedInSec){
      const isActive = G.outfit.top === o.id;
      const borderCol = isActive ? '#27ae60' : '#2a3a50';
      const bgCol = isActive ? 'linear-gradient(135deg,#0a3a1a,#0a2a0a)' : '#1a1a2a';
      sectionsHtml += `<div style="background:${bgCol};border:2px solid ${borderCol};border-radius:8px;padding:8px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px">
        <canvas id="prev_${o.id}" width="80" height="100" style="background:#0a0a0a;border-radius:4px"></canvas>
        <div style="color:#fff;font-size:12px;font-weight:700">${o.emoji} ${o.name}</div>
        <div style="color:#7ec87e;font-size:10px;line-height:1.2">${o.bonus}</div>
        ${isActive
          ? '<div style="background:#27ae60;color:#fff;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:700">âś… ZAĹOĹ»ONY</div>'
          : `<button class="bbtn" style="padding:4px 10px;font-size:11px" onclick="changeWardrobeOutfit('${o.id}')">ZaĹ‚ĂłĹĽ</button>`}
      </div>`;
    }
    sectionsHtml += '</div></div>';
  }
  document.getElementById('ov-content').innerHTML=`
    <h2>đź‘” Szafa</h2>
    <p class="sub">ZmieĹ„ outfit na jeden z posiadanych i wybierz kolory. <span style="color:#7ec87e">Nowe outfity kupisz w đź›Ť Sklepie z ubraniami w mieĹ›cie.</span></p>
    <p style="color:#667;font-size:14px;margin-bottom:12px">Aktualnie: <strong style="color:#7ec8e3">${outfitNames[activeId]||activeId}</strong></p>
    ${palette}
    ${sectionsHtml}
    ${owned.length<=1?'<div style="background:#1a2030;border:1px solid #2a3a50;border-radius:8px;padding:14px;margin-top:14px;color:#aac;font-size:13px;text-align:center">đź“¦ Szafa pusta â€” masz tylko podstawowy outfit. Kup nowy w sklepie z ubraniami!</div>':''}
    <div class="res" id="shop-res"></div>
    <button class="cbtn" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
  // F5.4 E4: po wstawieniu DOM rysuj mini-podglÄ…dy
  setTimeout(() => {
    for(const o of owned){
      const cv = document.getElementById('prev_' + o.id);
      if(cv && typeof drawPreviewPlayer === 'function') drawPreviewPlayer(cv, o.id);
    }
  }, 50);
}
window.renderWardrobeChange=renderWardrobeChange;
window.changeWardrobeOutfit=function(id){
  if(G.outfit.top===id){return;}
  G.outfit.top=id;
  const outfitColors={default:null,street:'#1a1a2a',suit:'#2a3050',sport:'#1a5030',music:'#4a0a5a',luxury:'#3a1a0a',polo:'#3a8a5a',jeansowa:'#2a4a7a',zimowa:'#3a3a4a',smoking:'#000000',designer_concert:'#1a0a3a',tracksuit:'#1a3a4a',leather_jacket:'#1a0a0a',designer_hoodie:'#2a1a3a'}; /* v2.1.148 hotfix: 3 nowe outfity colors */
  // JeĹ›li gracz wybraĹ‚ wĹ‚asny kolor body w palecie â€” uĹĽyj go zamiast default
  const userCol = G.outfitColors && G.outfitColors[id] && G.outfitColors[id].body;
  P.cloth=userCol||outfitColors[id]||G.cloth;
  const names={default:'Podstawowy',polo:'Polo',street:'Streetwear',jeansowa:'Jeansowa',zimowa:'Zimowa',suit:'Garnitur',smoking:'Smoking',sport:'Sportowy',sport_pro:'Treningowy PRO',music:'Muzyczny',designer_concert:'Designerski koncertowy',luxury:'Luxury drip'};
  notify(`đź‘” ZaĹ‚oĹĽyĹ‚eĹ›: ${names[id]||id}`);
  renderWardrobeChange();
};

