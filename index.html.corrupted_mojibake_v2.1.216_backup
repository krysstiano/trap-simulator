  /* v2.1.114: Wave 7 W76 â€” 2 nowe negative events (balance: ratio negative 20.7%â†’25%). */
  {name:'Health scare', chance:0.006, maxPerDay:1, cond:()=>currentRoom!=='hospital'&&G.day>=15&&(G.health||0)>30, fn:()=>{
    const _hpLoss=rnd(15,30);G.health=Math.max(5,(G.health||100)-_hpLoss);G.stress=clamp((G.stress||0)-15,0,100);
    notify(`đź¤’ NagĹ‚e zachorowanie! Stracone ${_hpLoss} HP + nastrĂłj. IdĹş do szpitala lub odpocznij.`,'r');
  }},
  {name:'Label scandal', chance:0.005, maxPerDay:1, cond:()=>G.label?.type&&(G.fame||0)>=40, fn:()=>{
    const _famePenalty=rnd(3,8);const _haters=rnd(20,50);
    G.fame=Math.max(0,(G.fame||0)-_famePenalty);G.haters=(G.haters||0)+_haters;G.stress=clamp((G.stress||0)-20,0,100);
    notify(`📰 Skandal w mediach — wytwórnia obwinia Ciebie! -${_famePenalty} sławy, +${_haters} hejterów, -20 nastrój.`,'r');
    /* v2.1.214 [Amper]: 30% szans że scandal zerwie jeden z aktywnych sponsorów */
    if((G.activeSponsors||[]).length>0 && Math.random()<0.3){
      const breakIdx=Math.floor(Math.random()*G.activeSponsors.length);
      const broken=G.activeSponsors[breakIdx];
      if(!G.sponsorHistory) G.sponsorHistory=[];
      G.sponsorHistory.push({...broken, endDay:G.day, endReason:'scandal_break'});
      _pushSponsorMessage('scandal_break', broken.brandId);
      G.activeSponsors.splice(breakIdx,1);
      const brand=getSponsorBrand(broken.brandId);
      if(typeof addNotif==='function') addNotif(`💔 ${brand?.emoji} ${brand?.name} zerwał kontrakt po skandalu!`);
    }
  }},
  /* v2.1.108: Wave 7 K64 Magazine cover event ZAIMPLEMENTOWANE â€” wczeĹ›niej pure ghost ("Cover of magazine" tylko w aspiracji audytu).
     Trigger: telefon spot + fame >=35 + 2000+ followers (magazyn dzwoni do osoby z zasiÄ™giem). Skala nagrody zaleĹĽy od fame. */
  {name:'Magazine cover offer', chance:0.004, maxPerDay:1, cond:()=>_evPhoneSpot()&&(G.fame||0)>=35&&(G.followers||0)>=2000, fn:()=>{
    /* Scale nagrody z fame (35→100 = 1.0→1.7×, cap 2.0× przy fame >=135 — user req "random eventy małymi smaczkami, nie eksplozja") */
    const _fameScale = 1 + Math.min(1.0, Math.max(0,(G.fame||0)-35)/100);
    /* v2.1.213 [Amper]: Tier scaling — Tier 1 Rising ×1.5, Tier 2+ Famous ×2.0 (cap). */
    const _tier = (typeof getFameTier==='function')?getFameTier():0;
    const _tierMult = _tier===0 ? 1.0 : (_tier===1 ? 1.5 : 2.0);
    const _magNames = ['Hip-Hop Magazine','Street Style','Music Today','Urban Beat','Drip Quarterly','Sound Wave Mag'];
    const _mag = _magNames[Math.floor(Math.random()*_magNames.length)];
    const _fameGain = Math.round(rnd(5,12)*_fameScale*_tierMult);
    const _followersGain = Math.round(rnd(500,2000)*_fameScale*_tierMult);
    const _money = Math.round(rnd(800,3000)*_fameScale*_tierMult);
    if(typeof addFame==='function') addFame(_fameGain); else G.fame=clamp((G.fame||0)+_fameGain,0,500);
    G.followers += _followersGain;
    if(typeof earn==='function') earn(_money,false); else {G.money+=_money;G.totalEarned=(G.totalEarned||0)+_money;}
    G._magazineCovers = (G._magazineCovers||0)+1;
    if(typeof confetti==='function') confetti(40);
    notify(`đź“¸ ${_mag} chce CiÄ™ na okĹ‚adce! Sesja zdjÄ™ciowa: +${_fameGain} sĹ‚awy, +${_followersGain} fanĂłw, +${_money} zĹ‚!`);
    if(typeof showMilestoneCinematic==='function' && G._magazineCovers===1){
      showMilestoneCinematic({emoji:'đź“¸',title:'PIERWSZA OKĹADKA',subtitle:_mag,tagline:'Twoja twarz na milionie kioskĂłw',accentColor:'#9b59b6',accent2:'#e91e8c',duration:4500});
    }
  }},
  // F+ Audyt 2026-05-11: 4 nowe immersyjne eventy
  {name:'SÄ…siad puka', chance:0.012, maxPerDay:1, cond:()=>_evHome()&&G.day>=2&&G.timeOfDay<=2, fn:()=>{
