  {id:'casino_whale',name:'Wieloryb kasynowy',desc:'Wygraj Ĺ‚Ä…cznie 100 000 zĹ‚ w kasynie',icon:'đźł',check:()=>(G.casinoStats?.totalWon||0)>=100000},
