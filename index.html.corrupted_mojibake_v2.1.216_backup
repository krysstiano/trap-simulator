 items:[
 {t:'fix',d:'KRYTYCZNY: Reputacja uliczna 50 obiecywaĹ‚a "Dzielnica Dripu daje Ci 5% zniĹĽki" ale flaga _repBoost50 byĹ‚a ustawiana i nigdy nie czytana w applyOutfitDiscount(). Naprawione â€” przy rep 50+ ubrania faktycznie -5% taniej.'},
