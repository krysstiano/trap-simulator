    {id:'sushi_premium',em:'đźŤŁ',name:'Sushi Premium',cost:160,hunger:70,energy:18,mood:12,health:8,bg:'rgba(26,42,58,0.6)',accent:'#3498db',desc:'TuĹ„czyk bĹ‚Ä™kitnopĹ‚etwy'},
    {id:'steak_royal',em:'đźĄ©',name:'Steak Royal',cost:220,hunger:85,energy:22,mood:15,fame:1,bg:'rgba(42,16,16,0.6)',accent:'#e74c3c',desc:'Dry-aged woĹ‚owina + foie gras'},
    {id:'creme_brulee',em:'đźŤ®',name:'CrĂ¨me BrĂ»lĂ©e',cost:70,hunger:25,mood:25,bg:'rgba(58,42,26,0.7)',accent:'#f1c40f',desc:'Klasyczny francuski deser'},
