    },
    {
      em:'đź”§', title:'SERWIS I NAPRAWA',
      /* v2.1.199: nowy topic â€” Warsztat naprawia sprzÄ™t muzyczny (kamera/mikrofon/MIDI) i samochĂłd. User feedback "warsztat pominiÄ™ty, ma sens jako serwis". */
      desc:'Warsztat â€” napraw uszkodzony sprzÄ™t: kamery (đź“ą), mikrofony (đźŽ¤), kontrolery MIDI (đźŽą) oraz samochody (đźš— przeglÄ…d). Random event "sprzÄ™t kapryszy" â†’ warsztat. NiezbÄ™dny gdy jakoĹ›Ä‡ sprzÄ™tu spadnie.',
      places:[
        {wx:3274, wy:2285, label:'WARSZTAT (SERWIS SPRZÄTU + AUTO)', zoom:1.6},
      ],
