    {wx:2510,wy:2430,w:150,h:148,c:'#1e2a18'},{wx:2678,wy:2430,w:150,h:148,c:'#2a1e28'},
    {wx:2846,wy:2430,w:150,h:148,c:'#181e28'},{wx:3014,wy:2430,w:150,h:148,c:'#281e18'},
