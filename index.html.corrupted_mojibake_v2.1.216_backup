<div id="minimap-wrap" style="position:absolute;left:8px;top:634px;width:232px;height:82px;z-index:11;pointer-events:all;cursor:pointer;background:transparent;border:2px solid rgba(220,180,40,.95);border-radius:8px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.7)" onclick="openFullMap()" title="Klik â€” duĹĽa mapa">
  <div id="minimap-header" style="height:18px;background:linear-gradient(90deg,rgba(155,89,182,.3),rgba(241,196,15,.22) 50%,rgba(126,200,227,.3));border-bottom:1px solid rgba(200,165,32,.4);display:flex;align-items:center;padding:0 8px;font-family:'Russo One','Orbitron',Impact,sans-serif">
