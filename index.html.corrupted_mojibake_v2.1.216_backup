}

// v2.1.196: PU faktycznie +15/30/45% cumulative (NIE 50%). Evo +50%, skill +5%/pkt max 25%.
// Scena â€” bonus zarobkĂłw z koncertĂłw
function getScenaEnergyBonus(){
