            if(typeof earn==='function') earn(_cashback,false); else {G.money+=_cashback;G.totalEarned=(G.totalEarned||0)+_cashback;}
            if(typeof addFame==='function') addFame(5); else G.fame=clamp((G.fame||0)+5,0,500);
            G.skillPoints=(G.skillPoints||0)+1;
            closeNPCDlg();
            if(typeof showMsg==='function') showMsg(`đź’» Janek: "Komplet pro-producent! 30% cashback od ${_dawPrice} zĹ‚. +${_cashback} zĹ‚, +5 sĹ‚awy, +1 punkt umiejÄ™tnoĹ›ci"`,'g',6000);
          } else {
            closeNPCDlg();
            if(typeof notify==='function') notify('đź’» Kup komputer z DAW (Sklep muzyczny, od 2000 zĹ‚). Cashback 30%.');
          }
        }
      },
      {text:'âś“ Quest "Mikrofon" + "DAW" odebrane',
        cond:()=>G._questAudioMicDone && G._questAudioDawDone,
        fn:()=>{closeNPCDlg();notify('đźŽ¤ Wszystkie questy Janka wykonane. Wpadaj po sprzÄ™t!');}
      },
      {text:'âť“ Co dalej kupiÄ‡?', fn:()=>{
        closeNPCDlg();
        if(typeof showMsg==='function') showMsg('đźŽ¤ Najpierw mikrofon (od 800 zĹ‚). Potem komputer z DAW (od 2000 zĹ‚). To minimum ĹĽeby zaczÄ…Ä‡ produkcjÄ™. PĂłĹşniej: lepsze mikrofony zwiÄ™kszajÄ… jakoĹ›Ä‡ nagraĹ„ w studio.','f',9000);
      }},
      {text:'WyjdĹş', fn:closeNPCDlg},
    ]
  },
  promoter: {
    name:'đźŽ¤ Anita â€” Promoter Sali',
    lines:[
      'Hej! Promotorka tej sceny. WidziaĹ‚am TwĂłj wystÄ™p â€” masz potencjaĹ‚.',
      'Sala koncertowa to nie tylko muzyka â€” to miejsce gdzie buduje siÄ™ legendy.',
      'Mam dla Ciebie deal. Jeden koncert tygodniowo, ja ogarniam promo.',
    ],
    opts:[
      {text:()=>`đźŽ¤ Side quest: Zagraj 3 koncerty (${G.events?.performed||0}/3)`,
        cond:()=>!(G._questPromoterC3Done),
        fn:()=>{
          const p=G.events?.performed||0;
          if(p>=3){
            G._questPromoterC3Done=true;
            if(typeof earn==='function') earn(3000,false); else {G.money+=3000;G.totalEarned=(G.totalEarned||0)+3000;}
            if(typeof addFame==='function') addFame(6); else G.fame=clamp((G.fame||0)+6,0,500);
            if(typeof addFans==='function') addFans(100);
            closeNPCDlg();
            if(typeof showMsg==='function') showMsg('đźŽ¤ Anita: "Trzy koncerty zaliczone! Publika CiÄ™ kocha. +3000 zĹ‚, +6 sĹ‚awy, +100 fanĂłw"','g',6000);
          } else {
            closeNPCDlg();
            if(typeof notify==='function') notify(`đźŽ¤ Zagraj jeszcze ${3-p} koncertĂłw (Sala Koncertowa obok).`);
          }
        }
      },
      {text:()=>`đźŹź Side quest 2: Zagraj koncert na Arenie (${(G._arenaPlayed||0)}/1)`,
        cond:()=>G._questPromoterC3Done && !G._questPromoterArenaDone,
        fn:()=>{
          if((G._arenaPlayed||0)>=1){
            G._questPromoterArenaDone=true;
            if(typeof earn==='function') earn(10000,false); else {G.money+=10000;G.totalEarned=(G.totalEarned||0)+10000;}
            if(typeof addFame==='function') addFame(15); else G.fame=clamp((G.fame||0)+15,0,500);
            if(typeof addFans==='function') addFans(500);
            closeNPCDlg();
            if(typeof showMsg==='function') showMsg('đźŹź Anita: "ARENA! WszedĹ‚eĹ› do ligi top. +10 000 zĹ‚, +15 sĹ‚awy, +500 fanĂłw"','g',7000);
          } else {
            closeNPCDlg();
            if(typeof notify==='function') notify('đźŹź Wymagania Areny: 55 sĹ‚awy, scena 4, 1500 fanĂłw lojalnych.');
          }
        }
      },
      {text:'âś“ Wszystkie questy Anity odebrane',
        cond:()=>G._questPromoterC3Done && G._questPromoterArenaDone,
        fn:()=>{closeNPCDlg();notify('đźŽ¤ Anita docenia TwojÄ… scenÄ™. Wracaj jak bÄ™dÄ… nowe okazje.');}
      },
      {text:'âť“ Jak rozpoczÄ…Ä‡ koncert?', fn:()=>{
        closeNPCDlg();
        if(typeof showMsg==='function') showMsg('đźŽ¤ WejdĹş do Sali Koncertowej (budynek obok) â†’ wybierz scenÄ™ (MaĹ‚a/Klub/Arena). KaĹĽda ma wymogi sĹ‚awy/sceny/fanĂłw. Im wiÄ™ksza scena, tym wiÄ™kszy zarobek i wiÄ™cej fanĂłw.','f',9000);
      }},
      {text:'WyjdĹş', fn:closeNPCDlg},
    ]
  },
};

const NPC_COOLDOWN_MS = 20000; // 20s cooldown per NPC option

function openNPCDialogue(type){
  const data=NPC_DATA[type];if(!data) return;
  /* v1.9.79/v1.9.86: zaliczenie pending SMS visit przy podejĹ›ciu.
     Mapping NPC_DATA â†’ SMS_CONTACTS (vendor=zbyszek, fan=fan, crew=crew, etc.) */
  /* v2.1.116: Wave 4 W35 â€” dodane mapowanie questâ†’wiktor (wczeĹ›niej SMS od Wiktora nigdy nie firowaĹ‚). */
  const _smsKey={vendor:'zbyszek',fan:'fan',crew:'crew',marcin:'marcin',kamil:'kamil',producent:'producent',quest:'wiktor',booking:'marcin',manager:'kamil'}[type]||type;
  if(typeof window._smsCheckPendingVisit==='function') window._smsCheckPendingVisit(_smsKey);
  const dlg=document.getElementById('npc-dlg');
  // Wyciagnij emoji z poczatku name (np. "đźŠ TwĂłj fan" -> "đźŠ")
  const emoMatch=data.name.match(/^(\p{Extended_Pictographic}|[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}])+/u);
  dlg.dataset.emoji=emoMatch?emoMatch[0]:'đź‘¤';
  // Bez emoji w nazwie (avatar je zawiera)
  const cleanName=emoMatch?data.name.replace(emoMatch[0],'').trim():data.name;
  document.getElementById('npc-dlg-name').textContent=cleanName;
  const line=data.lines[rnd(0,data.lines.length-1)];
  document.getElementById('npc-dlg-text').textContent='"'+line+'"';
  const optsDiv=document.getElementById('npc-dlg-opts');
  optsDiv.innerHTML='';
  data.opts.forEach((opt,i)=>{
    if(opt.cond && !opt.cond()) return;
    const key=`${type}_${i}`;
    const lastUsed=npcCooldowns[key]||0;
    const now=Date.now();
    const optText=typeof opt.text==='function'?opt.text():opt.text;
    // v1.8.16: BEZ cooldown dla akcji info-only (SprawdĹş ekipÄ™, WyjdĹş, Nie teraz, Nie interesuje mnie)
    const onCooldown=now-lastUsed<NPC_COOLDOWN_MS&&optText!=='WyjdĹş'&&optText!=='Nie teraz'&&optText!=='Nie interesuje mnie'&&optText!=='SprawdĹş ekipÄ™';
    const btn=document.createElement('button');btn.className='npc-opt';
    btn.textContent=onCooldown?`${optText} (${Math.ceil((NPC_COOLDOWN_MS-(now-lastUsed))/1000)}s)`:optText;
    btn.disabled=onCooldown;
    btn.style.opacity=onCooldown?'.45':'1';
    // v1.8.16: NIE ustawiaj cooldown dla akcji info-only (jak SprawdĹş ekipÄ™)
    // v1.9.16: BUG FIX â€” cooldown po fn() z guardem opt.fn().__noCooldown. WczeĹ›niej "Za maĹ‚o kasy" bĹ‚Ä…d dawaĹ‚ 20s cooldown chociaĹĽ nic siÄ™ nie wydarzyĹ‚o.
    btn.onclick=()=>{
      const noCooldownTexts=['WyjdĹş','Nie teraz','Nie interesuje mnie','SprawdĹş ekipÄ™'];
      // ZapamiÄ™taj money/energy/streetRep PRZED akcjÄ… â€” jeĹ›li ĹĽaden siÄ™ nie zmieniĹ‚, prawdopodobnie byĹ‚ "Za maĹ‚o kasy" error i nie chcemy cooldownu
      const _beforeMoney=G.money,_beforeEnergy=G.energy;
      opt.fn();
      const _changed=(G.money!==_beforeMoney)||(G.energy!==_beforeEnergy);
      if(!noCooldownTexts.includes(optText) && _changed) npcCooldowns[key]=Date.now();
    };
    optsDiv.appendChild(btn);
  });
  dlg.classList.add('on');
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  DECAY
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let lastDecay=Date.now();
function tickDecay(){
  if(_paused) return;
  // Admin: freeze statystyk â€” zatrzymaj decay hunger/energy/health/stress
  if(G._adminFreezeStat){lastDecay=Date.now();return;}
  /* v1.9.26: BUG FIX â€” tickDecay drenuje statystyki PODCZAS snu. sleepInterval ma wĹ‚asne drain (200ms tick), wiÄ™c tickDecay przy 6s daje double drain. */
  if(typeof sleepInterval!=='undefined' && sleepInterval){lastDecay=Date.now();return;}
  const now=Date.now();
  if(isOverlayOpen()){lastDecay=now;return;}
  if(now-lastDecay<CFG.decayInterval) return;
  lastDecay=now;

  const fitFactor=1-Math.floor(G.fitness/25)*0.05; // max -20% decay at fitness 100 (legacy â€” uzyte w hunger)
  const kondLvl=(G.skills&&getSkillLvl('kondycja')||0);
  // v2.1.29: kondycja PU faktycznie aplikowane (wczeĹ›niej GHOST). PU1=-3, PU2=-6, PU3=-10 â†’ kumulacja -19%
  const kondPU=(typeof _pu==='function'?_pu('kondycja'):0);
  const kondPUBonus=kondPU>=3?0.19:(kondPU===2?0.09:(kondPU===1?0.03:0));
  const kondMult=1-(kondLvl*0.08)-kondPUBonus; // GĹ‚Ăłwne drzewko: -8% spadku energii / pkt + PU
  const apetMult=getApetytMult(); // F3-FIX-B: skill+PU+evo (max -50% przy evo)
  // FORMA â†’ ENERGIA: delikatna mechanika -5% spadku energii przy formie 100 (liniowo)
  const formaEnergyMult=1-(G.forma||0)/100*0.05; // 0â†’1.0, 100â†’0.95
  // KONDYCJA â†’ ZDROWIE: delikatna mechanika -5% spadku zdrowia przy kondycji 100 (liniowo)
  const fitnessHealthMult=1-(G.fitness||0)/100*0.05; // 0â†’1.0, 100â†’0.95
  G.hunger=clampStat('hunger', G.hunger-Math.ceil(CFG.hungerDecay*fitFactor*apetMult));
  /* v2.1.164: Iron Discipline FIX â€” `Math.ceil(2*0.85)=Math.ceil(1.7)=2` neutralizowaĹ‚o skill (zero efektu).
     Naprawa: probabilistic skip â€” Iron Discipline daje 15% szansÄ™ ĹĽe tick nie odejmuje energii.
     Ĺšrednio = -15% drain over time, ale kaĹĽdy tick jest integer (zachowuje precision). */
  const _ironDisciplineSkip = (typeof hasPrestigeSkill==='function' && hasPrestigeSkill('iron_discipline')) && Math.random()<0.15;
  const _energyDrain = _ironDisciplineSkip ? 0 : Math.ceil(CFG.energyDecay*formaEnergyMult*kondMult);
  G.energy=clampStat('energy', G.energy-_energyDrain);
  // Kondycja 5 â†’ passive energy regen (z gĹ‚Ăłwnego drzewka)
  // v1.8.96: Evolution "Pasywna regeneracja" (Kondycja evo) â€” REALNIE aplikowane: szybsza regen 5%â†’20% chance, +2 zamiast +1
  if((typeof _evo==='function'&&_evo('kondycja'))&&G.energy<getMaxStat('energy')&&Math.random()<0.20){
    G.energy=Math.min(getMaxStat('energy'),G.energy+2);
  } else if(kondLvl>=5&&G.energy<getMaxStat('energy')&&Math.random()<0.05){
    G.energy=Math.min(getMaxStat('energy'),G.energy+1);
  }

  if(G.hunger<=0||G.energy<=0){
    const odpMult=getOdpornoscMult(); // F3-FIX-B: skill+PU+evo (max -50% przy evo)
    G.health=clampStat('health', G.health-Math.ceil(CFG.healthDecayAmt*odpMult*fitnessHealthMult));
    if(G.hunger<=0) showMsg('âš ď¸Ź GĹĂ“D! Tracisz zdrowie! IdĹş do sklepu lub restauracji!','r');
    if(G.energy<=0) showMsg('âš ď¸Ź WYCZERPANIE! IdĹş spaÄ‡ natychmiast!','r');
  }

  /* v2.1.26: PRZEJEDZENIE â€” TYLKO decay (kary sÄ… natychmiastowe w eatFood).
     v2.1.30: decayInterval 7.2s â†’ ~8.3 ticki/min real, 0.3/tick = ~2.5 pkt/min real. */
  if(typeof G.overeat !== 'number') G.overeat = 0;
  if(G.overeat > 0){
    G.overeat = Math.max(0, G.overeat - 0.3);
  }
  // F5.4 E3: MrĂłz (Ĺ›nieg/mgĹ‚a) na ulicy = -1 zdrowia co 30s, kurtka zimowa redukuje 85%
  if(currentRoom==='ulica' && (G.weather===3||G.weather===4||G.weather===5)){
    G._frostTick = (G._frostTick||0)+1;
    if(G._frostTick >= 5){ // co 5 tickĂłw decay (30s)
      G._frostTick = 0;
      const winterCoatMult = (G.outfit && (G.outfit.top==='zimowa')) ? 0.15 : 1.0;
      const jeansowaMult = (G.outfit && (G.outfit.top==='jeansowa')) ? 0.5 : 1.0;
      const frostDmg = Math.ceil(1 * winterCoatMult * jeansowaMult);
      if(frostDmg > 0){
        G.health = clampStat('health', G.health-frostDmg);
        if(G.health<50 && Math.random()<0.3) showMsg('đźĄ¶ MrĂłz wyziÄ™biĹ‚ ciÄ™! ZaĹ‚ĂłĹĽ kurtkÄ™ zimowÄ….','r');
      }
    }
  }
  if(G.health<=25&&G.health>0){
    const msgs=['âť¤ď¸Ź KRYTYCZNE ZDROWIE! IdĹş do szpitala!','đźŹĄ Zdrowie poniĹĽej 25%! Potrzebujesz pomocy!','âť— Umierasz! Szpital lub jedz!'];
    if(Math.random()<0.4) showMsg(msgs[Math.floor(Math.random()*msgs.length)],'r');
    /* v2.1.123: Wave 6 W65 â€” pulsing HP bar + audio cue + once-per-state cinematic. */
    if(!G._lowHpWarning){
      G._lowHpWarning=true;
      try{
        const _hpEl=document.getElementById('hhealth');
        if(_hpEl){_hpEl.style.animation='hpPulse 0.8s ease-in-out infinite';_hpEl.style.textShadow='0 0 8px #e74c3c';}
        /* Inject CSS keyframes raz */
        if(!document.getElementById('hpPulseStyle')){
          const _st=document.createElement('style');_st.id='hpPulseStyle';
          _st.textContent='@keyframes hpPulse{0%,100%{opacity:1;color:#e74c3c}50%{opacity:0.5;color:#fff}}';
          document.head.appendChild(_st);
        }
        if(typeof playDangerSound==='function') playDangerSound();
      }catch(_){}
      if(typeof showMilestoneCinematic==='function' && !G._lowHpCinematicShown){
        G._lowHpCinematicShown=true;
        showMilestoneCinematic({emoji:'âť¤ď¸Ź',title:'KRYTYCZNE ZDROWIE',subtitle:'Zdrowie poniĹĽej 25%',tagline:'IdĹş do szpitala, zjedz coĹ› lub siÄ™ przeĹ›pij!',accentColor:'#e74c3c',accent2:'#c0392b',duration:3500});
      }
    }
  } else if(G._lowHpWarning && G.health>40){
    /* Reset visual jeĹ›li HP siÄ™ odbudowaĹ‚o */
    G._lowHpWarning=false;
    /* v2.1.137: reset _lowHpCinematicShown â€” wczeĹ›niej cinematic fires raz na CAĹY playthrough (nigdy nie reset). Teraz reset gdy HP odbudowane â†’ kolejny spadek poniĹĽej 25% pokaĹĽe cinematic znowu. */
    G._lowHpCinematicShown=false;
    try{const _hpEl=document.getElementById('hhealth');if(_hpEl){_hpEl.style.animation='';_hpEl.style.textShadow='';}}catch(_){}
  }

  G.stress=clamp(G.stress-CFG.stressDecay,0,100);
  if((G.sleepDebt||0)>=3) G.energy=clampStat('energy', G.energy-Math.floor((G.sleepDebt||0)*.5));

  /* v2.1.80 Amper: REBALANS streaming royalties â€” sqrt-based (zawsze roĹ›nie, brak hard cap).
     Filozofia: gracz = raper â†’ muzyka = main passive income. Stary system (cap 50 zĹ‚ Spotify, cap 40 Tidal) zatrzymywaĹ‚ progres late game.
     Nowe formuĹ‚y: liniowy * 0.00001 + sqrt * 0.045 (Spotify), 0.00001 + sqrt * 0.025 (Tidal â€” HiFi premium ale mniej sĹ‚uchaczy).
     Targety dzienne: Spotify early 75/mid 1200/late 5500/maxed 17500 zĹ‚. Tidal early 30/mid 400/late 1400/maxed 3300. */
  /* v2.1.116: Wave 5 W55 â€” per-tick check expiration label kontraktu (global label 60 dni). WczeĹ›niej gracz traciĹ‚ dzieĹ„ 70% cut przed reset. */
  let _activeLabelType=G.label.type;
  if(_activeLabelType==='global' && G.label.contractEndsDay && G.day>=G.label.contractEndsDay){
    _activeLabelType=null; /* kontrakt wygasĹ‚ â€” peĹ‚ne royalty od TEGO ticka */
  }
  const labelCut=_activeLabelType==='global'?0.3:_activeLabelType==='major'?0.5:1.0; // major 50%, global 70%
  /* v2.1.163: Prestige Skill "Studio Mogul" +10% royalties */
  const _studioMogulMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('studio_mogul'):1;
  if(G.label.type==='major'){G.spotify.listeners+=rnd(1,5);G.tidal.listeners+=rnd(0,2);}
  if(G.label.type==='global'){G.spotify.listeners+=rnd(3,8);G.tidal.listeners+=rnd(1,4);} // global +50% sĹ‚uchaczy
  if(G.spotify.listeners>0){
    const r=Math.floor((G.spotify.listeners*0.000015*labelCut + Math.sqrt(G.spotify.listeners)*0.045*labelCut)*_studioMogulMult);
    if(r>0){if(typeof earn==='function')earn(r,false);else{G.money+=r;G.totalEarned=(G.totalEarned||0)+r;}G.spotify.royalties+=r;addNotif('đźŽµ Spotify: +'+r+' zĹ‚'+(G.label.type==='major'?' (major -50%)':''));} /* v2.1.96: Prestige moneyMult przez earn() */
  }
  if(G.tidal.listeners>0){
    const r=Math.floor((G.tidal.listeners*0.00001*labelCut + Math.sqrt(G.tidal.listeners)*0.025*labelCut)*_studioMogulMult);
    if(r>0){if(typeof earn==='function')earn(r,false);else{G.money+=r;G.totalEarned=(G.totalEarned||0)+r;}G.tidal.royalties+=r;addNotif('đźŚŠ Tidal: +'+r+' zĹ‚'+(G.label.type==='major'?' (major -50%)':''));} /* v2.1.96: Prestige moneyMult przez earn() */
  }
  // v1.8.48: Spotify verify auto-grant niezaleĹĽnie od tego, czy gracz otworzy aplikacjÄ™ (wczeĹ›niej tylko w renderPhoneApp)
  if(G.spotify && G.spotify.verifyAppliedDay && (G.day - G.spotify.verifyAppliedDay) >= 3 && !G.spotify.verified){
    G.spotify.verified = true;
    if(typeof addNotif==='function') addNotif('đźŽ‰ Profil Spotify zweryfikowany! âś“');
    if(typeof showMilestoneCinematic==='function' && !G._spotifyVerifyCinematic){
      G._spotifyVerifyCinematic = true;
      /* v2.1.122: Wave 4 S32 â€” Spotify Verify cinematic audio (wczeĹ›niej silent). */
      if(typeof sfxSparkle==='function') try{sfxSparkle();setTimeout(()=>sfxSparkle(),250);setTimeout(()=>{if(typeof sfxCash==='function')sfxCash();},500);}catch(_){}
      showMilestoneCinematic({emoji:'âś“',title:'ZWERYFIKOWANY ARTYSTA',subtitle:'TwĂłj profil Spotify ma teraz oficjalnÄ… odznakÄ™',tagline:'WyrĂłĹĽniasz siÄ™ wĹ›rĂłd milionĂłw twĂłrcĂłw',accentColor:'#1ed760',accent2:'#1aa84a',duration:5000});
    }
  }

  /* v2.1.80 Amper: AdSense YT REBALANS â€” sqrt-based, brak capu 60 zĹ‚.
     Liczy views (filmy) + subs (kanaĹ‚) + sqrt boost. Targety dzienne: early 20/mid 600/late 3500/maxed 8000 zĹ‚. */
  if(G.yt.views>0&&G.yt.subs>=1000){
    const ytSkMult=getKarieraBonus('youtuber'); // F3-FIX-B: skill+PU+evo
    // v1.8.99: Biurko Pro â€” +10% zarobek z YT (zgodnie z opisem mebla)
    const deskMult=G.aptPurchases?.furniture?.includes('desk_pro')?1.10:1;
    const a=Math.floor((G.yt.views*0.000003 + G.yt.subs*0.00003 + Math.sqrt(G.yt.views)*0.005)*ytSkMult*deskMult);
    if(a>0){if(typeof earn==='function')earn(a,false);else{G.money+=a;G.totalEarned=(G.totalEarned||0)+a;}G.yt.adsense+=a;addNotif('đź“ş AdSense: +'+a+' zĹ‚');} /* v1.9.67: Prestige dla adSense (audyt ad revenue) */
  }

  /* v2.1.80 Amper: Radio REBALANS â€” stawka *0.8 â†’ *0.5 ale + sqrt(beats) + fame multiplier.
     v2.1.176 AUDYT: tier multiplier dodany (G.radio.tierRate Ĺ›ledzony przy send). WczeĹ›niej daily ignorowaĹ‚ royPerPlay z UI (Street 0.6 / Prime 1.2 / Hit 2.5) â€” tylko UI ghost. */
  if(G.radio.beats>0){
    const plays=rnd(0,Math.floor(G.radio.beats*2));
    if(plays>0){
      G.radio.plays+=plays;
      /* Tier rate mult: 0.6â†’1.0, 1.2â†’1.5, 2.5â†’2.5 (relative do bazy 0.5 zĹ‚/play) */
      const _tierRate=G.radio.tierRate||0.6;
      const _tierMult=Math.max(1.0, _tierRate/0.6); /* Street=1.0, Prime=2.0, Hit=4.2 */
      const roy=Math.floor((plays*0.5 + Math.sqrt(G.radio.beats)*0.3 + (G.fame||0)*0.02)*_tierMult);
      /* v2.1.96: Prestige moneyMult przez earn() */
      if(typeof earn==='function') earn(roy,false); else {G.money+=roy;G.totalEarned=(G.totalEarned||0)+roy;}
      G.radio.royalties+=roy;
      if(Math.random()<.3) addNotif('đź“» Radio Street: '+plays+' odtworzyĹ‚. +'+roy+' zĹ‚');
    }
  }

  // Stary tickowy merch wyĹ‚Ä…czony â€” peĹ‚na mechanika w Studio Projektowania (sprint 3)

  // v1.8.18: pasywny dochĂłd z budki kebab (jeĹ›li kupiona)
  // v1.9.25: KRYTYCZNY BUG FIX â€” daily income byĹ‚ wypĹ‚acany co 6s (tickDecay) zamiast raz dziennie! 300 zĹ‚ Ă— 600 ticks/h = ~180k/h exploit. Naprawione: gate _lastKebabPayDay.
  if(G.kebabStand?.owned && G._lastKebabPayDay!==G.day){
    G._lastKebabPayDay=G.day;
    const _inc=G.kebabStand.dailyIncome||300;
    /* v1.9.66: Prestige multiplier dla kebab passive (audyt remaining bypasses) */
    if(typeof earn==='function') earn(_inc,false); else {G.money+=_inc;G.totalEarned=(G.totalEarned||0)+_inc;}
    if(typeof addNotif==='function')addNotif(`đźŚ® Budka kebab â€” dochĂłd: +${_inc} zĹ‚`);
  }

  // Kontrakt â€” sprawdĹş deadline
  if(G.contract){
    if(G.day>G.contract.deadline&&!G.contract.completed){
      showMsg('đź“‹ Kontrakt wygasĹ‚! Nie zdÄ…ĹĽyĹ‚eĹ› â€” nastrĂłj -30','r');
      G.stress=clamp(G.stress-30,0,100);G.streetRep=clamp(G.streetRep-5,0,100);
      G.contract=null;
    }
  }

  // v1.8.18: NERF organic growth â€” wymaga REALNEGO output (â‰Ą3 wideo / â‰Ą3 bity / â‰Ą5 postĂłw).
  // Bez min(1, ...) â€” jeĹ›li followers=0, growth=0. Brak darmowych followersĂłw na starcie.
  // USUNIÄTY auto-fill yt.subs z followers (z 0.6 do 0). Subs TYLKO z uploadĂłw/streamĂłw.
  if(G.yt.videos.length>=3||G.careers.beatmaker.beatsSold>=3||G.careers.influencer.posts>=5){
    const hypeBonus=G.crew.some(c=>c.role==='hype')?1.2:1.0;
    const growRate=Math.floor(G.followers*0.003*(Math.min(1.0,G.fame/100)+0.1)*hypeBonus); /* v2.1.212: clamp fame/100 do 1.0 (fame >100 NIE eksploduje daily growth) */
    if(growRate>0){
      G.followers+=growRate;
      G.totalEarned=G.totalEarned||0;
    }
  }

  // v2.1.36: auto-sync USUNIÄTA. Fani (G.fans) i obserwujÄ…cy (G.followers) to NIEZALEĹ»NE mechaniki.
  // WczeĹ›niej (v1.8.18 i przed v2.1.34) "casual/hardcore/haters" byĹ‚y pod-licznikami G.followers â€” dolewane proporcjonalnie.
  // Po refaktorze v2.1.36: kaĹĽdy licznik roĹ›nie tylko z wĹ‚asnych ĹşrĂłdeĹ‚ (Twitter/IG â†’ followers, koncerty/freestyle â†’ fans, hejt â†’ haters).

  // ZuĹĽycie sprzÄ™tu â€” stopniowa degradacja jakoĹ›ci
  if(G.camera&&Math.random()<.04){G.camera.quality=clamp(G.camera.quality-1,5,100);}
  if(G.mic&&Math.random()<.04){G.mic.quality=clamp(G.mic.quality-1,5,100);}
  if(G.midiCtrl&&Math.random()<.03){G.midiCtrl.quality=clamp(G.midiCtrl.quality-1,5,100);}

  checkCareerUnlocks();
  checkAchievements();
  checkStoryline();
  checkRandomEvents();
  // v1.8.76: throttled auto-submit do leaderboardu (max raz na 60s realnego czasu)
  if(typeof maybeAutoSubmitScores==='function') maybeAutoSubmitScores();
  // v1.9.9 Faza 3: sprawdĹş triggery SMS od NPC (raz per tick â€” _smsTriggerOnce zapobiega duplikatom)
  if(typeof _smsCheckTriggers==='function') _smsCheckTriggers();
  /* v1.9.20: Pogoda min 1 timeOfDay slot przed kolejnÄ… zmianÄ… + bias 60% sĹ‚oĹ„ca */
  const _wTime=(G.day||0)*4+(G.timeOfDay||0);
  if(_wTime>(G._lastWeatherTime||0) && Math.random()<.012){
    G._lastWeatherTime=_wTime;
    G.weather=Math.random()<0.6?0:rnd(0,5); /* 60% sĹ‚oĹ„ca, reszta losowo */
  }
  // Generuj dzienne zadanie jeĹ›li brak â€” NIE nadpisuj jeĹ›li ukoĹ„czone i nieodebrane
  if(!G.dailyQuest) generateDailyQuest();
  // Ekipa â€” cotygodniowe koszty (co 28 decayTick = ok. 1 cykl dnia)
  // v1.9.19: Wynagrodzenie skalowane przez followers (poprzednio flat 150 trywialne late-game)
  if(G.crew.length>0&&G.decayTick>0&&G.decayTick%56===0){
    const wages=G.crew.length*Math.floor(150*(1+(G.followers||0)/10000));
    if(G.money>=wages){G.money-=wages;addNotif(`đź’¸ WypĹ‚ata ekipy: -${wages} zĹ‚ (${G.crew.length} osĂłb)`);}
    else{
      /* v1.9.19: BUG FIX â€” pokaĹĽ KTO odszedĹ‚ i co to oznacza dla bonusĂłw */
      const _gone=G.crew.pop();
      const roleLabels={dj:'đźŽ§ DJ (-15% sprzedaĹĽ bitĂłw)',grafik:'đźŽ¨ Grafik (-10% jakoĹ›Ä‡ vlogĂłw)',hype:'đź“˘ Hype man (-20% wzrost fanĂłw)'};
      const _label=roleLabels[_gone?.role]||(_gone?.role||'czĹ‚onek ekipy');
      showMsg(`âš ď¸Ź Brak kasy na ekipÄ™! Brakuje ${wages-G.money} zĹ‚ â€” ${_label} odszedĹ‚.`,'r',5000);
      if(typeof updateHUD==='function') updateHUD();
    }
  }
  // Instagram post growth
  if(G.igPosts&&G.igPosts.length>0){
    G.igPosts.forEach(post=>{
      if(post.growStage===undefined) post.growStage=5; // old format compat
      if(post.growStage<5){
        post.growStage++;
        post.likes=Math.floor((post.maxLikes||50)*post.growStage/5);
        post.comments=Math.floor((post.maxComments||10)*post.growStage/5);
        if(post.growStage>=5&&!post.followersAdded){
          post.followersAdded=true;
          if(post.pendingFollowers>0){
            G.followers+=post.pendingFollowers;
            /* v2.1.99: Prestige fameMult przez addFame() (IG post pendingFame bypass fix) */
            const _pf=post.pendingFame||0;
            if(_pf>0){if(typeof addFame==='function')addFame(_pf);else G.fame=clamp(G.fame+_pf,0,500);}
            addNotif(`đź“¸ Post urĂłsĹ‚! +${post.pendingFollowers} obserwujÄ…cych âť¤ď¸Ź`);
          }
        }
      }
    });
  }
  G.decayTick++;
  if(G.health<=0) gameOver();
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  CZAS / POZIOMY / ODBLOKOWANIA
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
/* v2.1.158: Awards Ceremony â€” odbywa siÄ™ co 10 dni w grze. 5 kategorii z procentem szans wygranej.
   Wygrane: +fame, +fans, +money. Cinematic z winnerem kaĹĽdej kategorii (gracz lub NPC). */
const AWARDS_NPCS=['Lex Local','MC Riser','Kid Drip','Top One','Vex Major','Phantom MC','Solo Wave','Doja Light'];
function triggerAwardsCeremony(){
  if(G._awardsActive) return; /* anti double-trigger */
  G._awardsActive=true;
  /* 5 kategorii z thresholdami player win chance */
  const _pickNpc=()=>AWARDS_NPCS[Math.floor(Math.random()*AWARDS_NPCS.length)];
  const _fame=G.fame||0, _fans=G.fans||0, _albums=G.albumsReleased||0;
  const _tracks=(G.studioTracks||[]).filter(t=>!t.isDemo).length;
  /* v2.1.176: AUDYT â€” best_single uĹĽywaĹ‚ avgQ z wszystkich trackĂłw. Gracz z 1 super track (100%) + 9 zĹ‚a (30%) miaĹ‚ avgQ=37% â†’ ~30% chance.
     Zmiana: topQ (max masterQ) â€” nagradza focused perfection zamiast slurring. */
  const _topQ=_tracks>0?Math.max(...(G.studioTracks||[]).filter(t=>!t.isDemo).map(t=>t.masterQ||t.quality||0)):0;
  const categories=[
    {key:'best_single',name:'Najlepszy Singiel',emoji:'đźŽµ',winChance:Math.min(0.85,_topQ/100*0.8),reward:{money:2000,fame:5,fans:500},requires:_tracks>=1},
    /* v2.1.176: AUDYT â€” newcomer scaling z fame/60 (day 10 fame 10 = 16% chance, day 59 fame 60 = 100% capped 75%). Bardziej responsywne na fame. */
    {key:'best_newcomer',name:'Debiut Roku',emoji:'â­',winChance:Math.min(0.75,_fame/40),reward:{money:3000,fame:8,fans:1000},requires:G.day<60},
    {key:'album_of_year',name:'Album Roku',emoji:'đź’ż',winChance:Math.min(0.7,_albums*0.2),reward:{money:8000,fame:12,fans:3000},requires:_albums>=1},
    {key:'artist_of_year',name:'Artysta Roku',emoji:'đź‘‘',winChance:Math.min(0.8,(_fame+_fans/10000)/100*0.7),reward:{money:15000,fame:20,fans:8000},requires:_fame>=40},
    {key:'lifetime',name:'Lifetime Achievement',emoji:'đźŹ†',winChance:Math.min(0.9,(G.prestige||0)*0.18),reward:{money:50000,fame:30,fans:15000},requires:(G.prestige||0)>=2},
  ];
  const eligible=categories.filter(c=>c.requires);
  if(eligible.length===0){G._awardsActive=false;return;}
  /* Awarduj wszystkie eligible kategorie, kaĹĽdÄ… z winChance */
  const results=[];
  for(const cat of eligible){
    const won=Math.random()<cat.winChance;
    results.push({...cat,won,winner:won?(G.name||'You'):_pickNpc()});
  }
  /* Apply rewards za wygrane */
  let totalMoney=0,totalFame=0,totalFans=0;
  for(const r of results){
    if(r.won){
      totalMoney+=r.reward.money;
      totalFame+=r.reward.fame;
      totalFans+=r.reward.fans;
    }
  }
  if(totalMoney>0 && typeof earn==='function') earn(totalMoney,false);
  if(totalFame>0 && typeof addFame==='function') addFame(totalFame);
  if(totalFans>0 && typeof addFans==='function') addFans(totalFans);
  /* v2.1.169: Awards tracking â€” total ceremonies + cumulative wins (dla achievementĂłw first_award/awards_5/awards_legend) */
  const _wonNow=results.filter(r=>r.won).length;
  G._awardsCount=(G._awardsCount||0)+1;
  G._awardsWonTotal=(G._awardsWonTotal||0)+_wonNow;
  /* v2.1.169: SMS od NPC po wygranej Lifetime Achievement (top tier) â€” analog do mansion_bought SMS w v2.1.168 */
  if(typeof _smsTriggerOnce==='function' && results.some(r=>r.won && r.key==='lifetime')){
    _smsTriggerOnce('awards_lifetime_won','marcin','đźŹ† Lifetime Achievement?! Ty juĹĽ legenda. PamiÄ™taj o starych ziomkach jak bÄ™dziesz w wieczornych newsach! đźŽ¤');
  }
  /* Cinematic */
  if(typeof showMilestoneCinematic==='function'){
    const _wonCount=results.filter(r=>r.won).length;
    const _title=_wonCount>0?`AWARDS â€” ${_wonCount} ${_wonCount===1?'WYGRANA':'WYGRANE'}`:'AWARDS CEREMONY';
    const _list=results.map(r=>`${r.emoji} ${r.name}: ${r.won?'<b style="color:#27ae60">'+r.winner+' đźŹ†</b>':'<span style="color:#778">'+r.winner+'</span>'}`).join('<br>');
    showMilestoneCinematic({
      emoji:'đźŹ†',title:_title,subtitle:`DzieĹ„ ${G.day} Â· ${_wonCount}/${eligible.length} kategorii`,
      tagline:_wonCount>0?`+${totalMoney.toLocaleString('pl')} zĹ‚ Â· +${totalFame} sĹ‚awy Â· +${totalFans.toLocaleString('pl')} fanĂłw`:'SprĂłbuj nastÄ™pnym razem za 10 dni',
      accentColor:'#f1c40f',accent2:'#e91e8c',duration:5500
    });
  }
  if(typeof addNotif==='function') addNotif(`đźŹ† AWARDS Day ${G.day}: ${results.filter(r=>r.won).length}/${eligible.length} wygrane`);
  G._awardsActive=false;
}
function nextPeriod(){
  /* v2.1.113: Wave 2 S15 â€” sanity clamp G.money za kaĹĽdy tick (chroni przed ujemnymi wartoĹ›ciami z konsoli / corrupted save / race conditions) */
  if((G.money||0)<0) G.money=0;
  G.timeOfDay++;
  if(G.timeOfDay>=4){
    G.timeOfDay=0;G.day++;G.hunger=clampStat('hunger', G.hunger-15);
    /* v2.1.158: Awards Ceremony co 10 dni â€” odpalane przy G.day++ gdy day%10===0 (Day 10, 20, 30...) */
    if(G.day>0 && G.day%10===0 && (G.fame||0)>=10){
      setTimeout(()=>triggerAwardsCeremony(),1200); /* delay ĹĽeby nie kolidowaÄ‡ z innymi day-tick eventami */
    }
    /* v2.1.214 [Amper]: Sponsor Inbox — daily payments + offer check + PR drama check */
    if(typeof processSponsorDailyPayments==='function') processSponsorDailyPayments();
    if(typeof checkSponsorOffers==='function') checkSponsorOffers();
    if(typeof checkSponsorDrama==='function') checkSponsorDrama();
    if((G.lastSleepDay||0)<G.day-1){G.sleepDebt=clamp((G.sleepDebt||0)+1,0,5);if((G.sleepDebt||0)>=3)showMsg(`đź´ NiedobĂłr snu (${G.sleepDebt}/5)! Energia spada szybciej. IdĹş spaÄ‡!`,'r');}
    /* v2.1.81 Amper: DAILY ORGANIC GROWTH â€” pasywny przyrost sĹ‚uchaczy/subĂłw/followers z katalogu.
       Filozofia: muzyka ĹĽyje swoim ĹĽyciem â€” gracz nie musi spamowaÄ‡ releases. "ĹšwieĹĽy artysta" mnoĹĽnik dni 1-60 daje szybszy onboarding.
       Plus SoundCloud daily royalty (NOWA wypĹ‚ata â€” wczeĹ›niej tylko jednorazowo przy upload, ~1 zĹ‚). */
    {
      /* v2.1.178: smooth decay zamiast schodkĂłw (audit Agent 2) â€” day 1 = 1.5Ă—, day 30 = 1.25Ă—, day 60+ = 1.0Ă— linear */
      const _freshArtist = G.day < 60 ? Math.max(1.0, 1.5 - (G.day/60)*0.5) : 1.0;
      const _tracksTotal = (G.studioTracks||[]).length;
      const _videosTotal = (G.yt && G.yt.videos ? G.yt.videos.length : 0);
      const _fameG = G.fame || 1;
      if(_tracksTotal > 0){
        /* v2.1.122: Wave 3 S21 â€” hard cap daily organic growth ĹĽeby late game (500+ trackĂłw Ă— fame 100) nie eksplodowaĹ‚. */
        /* v2.1.133: Spotify verified +15% bonus do daily growth (badge wczeĹ›niej tylko kosmetyczny â€” teraz daje realny boost) */
        const _verifiedMult = G.spotify?.verified ? 1.15 : 1.0;
        G.spotify.listeners = (G.spotify.listeners||0) + Math.min(5000, Math.floor(_tracksTotal * _fameG * 0.3 * _freshArtist * _verifiedMult));
        G.tidal.listeners = (G.tidal.listeners||0) + Math.min(2000, Math.floor(_tracksTotal * _fameG * 0.2 * _freshArtist));
      }
      if(G.soundcloud && (G.soundcloud.tracksUploaded||0) > 0){
        G.soundcloud.listeners = (G.soundcloud.listeners||0) + Math.floor(G.soundcloud.tracksUploaded * _fameG * 0.2 * _freshArtist);
      }
      if(_videosTotal > 0){
        G.yt.subs = (G.yt.subs||0) + Math.floor(_videosTotal * _fameG * 0.1 * _freshArtist);
        G.yt.views = (G.yt.views||0) + Math.floor(_videosTotal * _fameG * 2 * _freshArtist);
      }
      G.followers = (G.followers||0) + Math.floor((_fameG + (G.fans||0) * 0.005) * _freshArtist);
      /* v2.1.201 [Amper]: DRIP daily passive â€” recognized image. Drip 50+ daje pasywny przyrost followers i lojalnych fanĂłw.
         Filozofia: gracz inwestujÄ…cy 8-18k zĹ‚ w 1 luxury item powinien widzieÄ‡ daily retention. */
      const _dripDay = (typeof getEffectiveDrip==='function'?getEffectiveDrip():(G.drip||0));
      if(_dripDay >= 50){
        const _dripFollowers = Math.floor(_dripDay * 0.05 * _freshArtist); // drip 200 = ~10 followers/dzieĹ„
        const _dripFans = Math.floor(_dripDay * 0.015 * _freshArtist); // drip 200 = ~3 fans/dzieĹ„
        if(_dripFollowers > 0) G.followers = (G.followers||0) + _dripFollowers;
        if(_dripFans > 0 && typeof addFans==='function') addFans(_dripFans);
      }
      /* v2.1.201 [Amper]: Street Rep 100 â€” Legenda ulicy = +1 pasywny fan/dzieĹ„ (recognized lokal). */
      if((G.streetRep||0)>=100 && typeof addFans==='function'){
        addFans(1);
      }
      /* v2.1.118: Wave 6 W68 â€” Radio platform daily growth (wczeĹ›niej offline â€” tylko jednorazowo plays). */
      if(G.radio && (G.radio.beats||0) > 0){
        const _radioDaily = Math.floor((G.radio.beats||0) * _fameG * 0.5 * _freshArtist);
        G.radio.plays = (G.radio.plays||0) + _radioDaily;
      }
      /* v2.1.120: Wave 8 W83 â€” NPC rotation co 14 dni gry (refresh kolorĂłw ĹĽeby gracz nie widziaĹ‚ tych samych "posÄ…gĂłw"). */
      if(G.day%14===0 && Array.isArray(cityPeds)){
        cityPeds.forEach(p=>{
          if(p._colors){
            try{
              const skinPal=['#f4d4b8','#e8c096','#c89878','#9a7050','#6e4830','#3e2820'];
              const clothPal=['#1a3a5a','#5a1a1a','#1a5a1a','#5a3a0a','#3a1a5a','#5a5a1a','#2a4a4a','#4a2a4a'];
              p._colors.cc=clothPal[Math.floor(Math.random()*clothPal.length)];
            }catch(_){}
          }
        });
      }
      /* SoundCloud daily royalty */
      if(G.soundcloud && ((G.soundcloud.tracksUploaded||0) > 0 || (G.soundcloud.listeners||0) > 0)){
        const _scDaily = Math.floor(
          (G.soundcloud.tracksUploaded||0) * 5 +
          (G.soundcloud.listeners||0) * 0.0005 +
          (G.fame||0) * 0.5
        );
        if(_scDaily > 0){
          if(typeof earn==='function') earn(_scDaily,false); else {G.money += _scDaily; G.totalEarned = (G.totalEarned||0) + _scDaily;}
          G.soundcloud.royalties = (G.soundcloud.royalties||0) + _scDaily;
          if(typeof addNotif === 'function') addNotif('đźź  SoundCloud: +'+_scDaily+' zĹ‚ (dzienna tantiema)');
        }
      }
    }
    // â”€â”€ GYM DECAY: "use it or lose it" â€” spadek formy/kondycji gdy gracz nie cwiczy â”€â”€
    if(G._lastGymDay != null){
      const daysSince = G.day - G._lastGymDay;
      if(daysSince === 2){
        // SMS od Gym Bro (rano dnia 3 â€” 2 dni od ostatniego treningu)
        if(typeof sendGymBroSms === 'function') sendGymBroSms();
      } else if(daysSince >= 3){
        // Spadek formy i kondycji 10-20% (random, kazdy dzien bez treningu)
        const decay = 10 + Math.floor(Math.random()*11);
        const formaPrev = G.forma||0, fitnessPrev = G.fitness||0;
        G.forma = Math.max(0, formaPrev - decay);
        G.fitness = Math.max(0, fitnessPrev - decay);
        if(typeof addNotif === 'function') addNotif(`đź’Ş Brak treningu od ${daysSince} dni â€” forma -${decay}%, kondycja -${decay}%`);
        if(typeof showMsg === 'function') showMsg(`đź’Ş Spadek formy i kondycji o ${decay}% (brak treningu)`,'r');
        if(typeof updateHUD === 'function') updateHUD();
      }
    }
    // Bonus mieszkaniowy: lepsze mieszkanie = lepszy nastrĂłj dziennie (komfort, mniej stresu)
    const _aptMoodBonus=G.apartment==='basic'?1:G.apartment==='premium'?3:G.apartment==='luxury'?6:G.apartment==='mansion'?10:G.apartment==='mega_villa'?20:0; /* v2.1.159: mansion · v2.1.215: Mega Villa +20 mood/doba */
    /* v2.1.215 [Amper]: Mega Villa pasywny +2 fame/dzień gry (recognized brand — bez diminishing returns) */
    if(G.apartment==='mega_villa') G.fame=Math.min(500,(G.fame||0)+2);
    /* v2.1.215 [Amper]: Auto-promo z mediów Tier 3+ — +5 fame/tydzień gry (G.day%7===0 + fame >=300), bez diminishing */
    if((G.fame||0)>=300 && G.day>0 && G.day%7===0 && G._lastAutoPromoDay!==G.day){
      G._lastAutoPromoDay=G.day;
      G.fame=Math.min(500,(G.fame||0)+5);
      if(typeof addNotif==='function') addNotif('📣 Media o Tobie piszą — auto-promo: +5 sławy.');
    }
    if(_aptMoodBonus>0){G.stress=clamp(G.stress+_aptMoodBonus,0,100);}
    // #71 U Wynajem mieszkaĹ„ â€” dochĂłd pasywny + obsĹ‚uga wypowiedzeĹ„ (#73)
    // v1.9.14: BUG FIX (OP EXPLOIT) â€” rates zharmonizowane z UI tooltip (16319). WczeĹ›niej UI mĂłwiĹ‚o 25/80/200/500 zĹ‚/dzieĹ„ ale kod dawaĹ‚ 100/400/1200/5000 (Ă—4-10!).
    // Z penthouse rentem 5k zĹ‚/dzieĹ„ + niskimi billami w traphouse = ~2M zĹ‚/rok zero-effort. Naprawione.
    if(G.rentals){
      const _rates={traphouse:25,basic:80,premium:200,luxury:500};
      let _rentTotal=0;
      // SprawdĹş czy notice period skoĹ„czony (najem siÄ™ koĹ„czy)
      if(G._rentalNotice){
        for(const id of Object.keys(G._rentalNotice)){
          if((G.day||1) >= G._rentalNotice[id]){
            G.rentals[id]=false;
            delete G._rentalNotice[id];
            if(typeof addNotif==='function')addNotif(`đź“ś Najem ${id} zakoĹ„czony â€” masz znĂłw dostÄ™p.`);
          }
        }
      }
      for(const id of Object.keys(G.rentals)){
        if(G.rentals[id]===true && id!==G.apartment){
          _rentTotal += (_rates[id]||0);
        }
      }
      if(_rentTotal>0){
        if(typeof earn==='function') earn(_rentTotal,false); else {G.money+=_rentTotal;G.totalEarned=(G.totalEarned||0)+_rentTotal;}
        if(typeof addNotif==='function')addNotif(`đźŹ  Czynsz z najmu: +${_rentTotal.toLocaleString('pl')} zĹ‚`);
        if(typeof showGain==='function')showGain('+'+_rentTotal.toLocaleString('pl')+' zĹ‚ đźŹ ','#f1c40f');
      }
    }
    // F+ 2026-05-12 #73: stary duplikat usuniÄ™ty â€” uĹĽywa siÄ™ istniejÄ…cego tickBills() z G.bills (wywoĹ‚ywane wyĹĽej w nextPeriod)
    /* v2.1.151+v2.1.161: Label Management passive income + promotion + evolution + studio costs */
    if(G.label?.type==='indie' && Array.isArray(G.label.artists) && G.label.artists.length>0){
      let _labelIncome=0;
      const _evolutionsTriggered=[];
      for(const a of G.label.artists){
        let def=typeof SIGNABLE_ARTISTS!=='undefined'?SIGNABLE_ARTISTS.find(d=>d.id===a.id):null;
        if(!def) continue;
        /* v2.1.161: Evolution check â€” artist signed >evolveAfter days ago, evoluuje do next tier */
        if(def.evolveAfter && def.evolveTo && (G.day-a.signedDay)>=def.evolveAfter && !a._evolved){
          const newDef=SIGNABLE_ARTISTS.find(d=>d.id===def.evolveTo);
          if(newDef){
            a.id=def.evolveTo; a._evolved=true; a.evolvedFrom=def.id; a.evolvedDay=G.day;
            _evolutionsTriggered.push({old:def.name,new:newDef.name,emoji:newDef.emoji});
            def=newDef;
          }
        }
        /* v2.1.161: Promotion boost +50% jeĹ›li active */
        const _promo=(a.promoteUntil && a.promoteUntil>G.day)?1.5:1;
        _labelIncome+=Math.floor(def.dailyIncome*_promo);
      }
      /* v2.1.201 [Amper]: Label income FAME scaling â€” gracz z wiÄ™kszÄ… sĹ‚awÄ… przyciÄ…ga lepszych klientĂłw reklam, kontraktĂłw merch, sync deals.
         FormuĹ‚a: +(fame/100) Ă— 30% bonus. Fame 50 = +15%, Fame 100 = +30%. CAP +30% ĹĽeby nie zĹ‚amaÄ‡ balansu. */
      const _fameMult=1 + Math.min(0.30, (G.fame||0)/100 * 0.30);
      _labelIncome=Math.floor(_labelIncome*_fameMult);
      /* v2.1.161: Studio operating costs â€” 10% of total income, anti-snowball */
      const _studioCost=Math.floor(_labelIncome*0.10);
      const _netIncome=_labelIncome-_studioCost;
      if(_netIncome>0){
        if(typeof earn==='function') earn(_netIncome,false); else {G.money+=_netIncome;G.totalEarned=(G.totalEarned||0)+_netIncome;}
        const _fameMultPct=Math.round((_fameMult-1)*100);
        if(typeof addNotif==='function') addNotif(`đźŽĽ WytwĂłrnia (${G.label.artists.length} ${G.label.artists.length===1?'artysta':'artyĹ›ci'}): +${_labelIncome.toLocaleString('pl')} zĹ‚ brutto${_fameMultPct>0?` (sĹ‚awa +${_fameMultPct}%)`:''} Â· -${_studioCost.toLocaleString('pl')} koszty = ${_netIncome.toLocaleString('pl')} netto`);
      }
      /* Evolution notifications */
      for(const ev of _evolutionsTriggered){
        if(typeof notify==='function')notify(`đźŽ† EWOLUCJA ARTYSTY! ${ev.old} â†’ ${ev.emoji} ${ev.new}! WyĹĽszy daily income.`);
        if(typeof addNotif==='function')addNotif(`đźŽ† ${ev.old} â†’ ${ev.new} (evolution)`);
      }
    }
    // F+ 2026-05-12 #65: rep uliczna DECAY â€” nie utrzymuje siÄ™ 100/100 wiecznie bez aktywnoĹ›ci
    // v1.8.22: zĹ‚agodzony decay â€” bez decay'u poniĹĽej 90, Ĺ‚agodniejszy powyĹĽej
    if(G.streetRep>=90)G.streetRep=clamp(G.streetRep-1,0,100);
    // #77 BUG FIX: TV/RoĹ›liny dajÄ… DZIENNY bonus nastroju (nie tylko jednorazowy przy zakupie)
    const _furn=G.aptPurchases?.furniture||[];
    let furnMood=0;
    if(_furn.includes('tv')) furnMood+=5;
    if(_furn.includes('plant')) furnMood+=3;
    if(furnMood>0){G.stress=clamp(G.stress+furnMood,0,100); addNotif(`đź›‹ Bonus mebli: +${furnMood} nastrĂłj (TV/RoĹ›liny)`);}
    // â”€â”€ #64 SYSTEM RACHUNKĂ“W â”€â”€
    if(typeof tickBills==='function') tickBills();
    // v1.9.10: Global Label 60-day expiry â€” wczeĹ›niej contractEndsDay byĹ‚o ustawiane ale nigdy nie czytane (ghost mechanic)
    if(G.label?.type==='global' && G.label.contractEndsDay && G.day>=G.label.contractEndsDay){
      G.label.type=null;G.label.contractEndsDay=null;G.label.advance=0;
      addNotif('đź“ś Kontrakt Global Deal wygasĹ‚ (60 dni minÄ™Ĺ‚o). MoĹĽesz podpisaÄ‡ nowy lub przejĹ›Ä‡ na Major/Indie.');
      if(typeof showMsg==='function') showMsg('đźŚŤ Global Deal â€” kontrakt 60-dniowy wygasĹ‚. Tantiemy wracajÄ… do 100% royalties.','f',6000);
    }
    // Dzienny bonus
    const dayBonus=50+G.level*10;if(typeof earn==='function')earn(dayBonus,false);else{G.money+=dayBonus;G.totalEarned=(G.totalEarned||0)+dayBonus;} /* v1.9.66: Prestige dla daily bonus */
    addNotif(`đźŚ… Nowy dzieĹ„! Dzienny bonus: +${dayBonus} zĹ‚${_aptMoodBonus?` Â· +${_aptMoodBonus} nastrĂłj (mieszkanie)`:''}`);
    // Reset dziennego zadania â€” jeĹ›li z poprzedniego dnia i odebrane lub nieukoĹ„czone
    if(G.dailyQuest&&G.dailyQuest.day<G.day&&(G.dailyQuest.claimed||!G.dailyQuest.completed)){
      G.dailyQuest=null;generateDailyQuest();
    }
    // Tygodniowy bonus co 7 dni
    if(G.day%7===0){
      const weekBonus=500+G.level*50;if(typeof earn==='function')earn(weekBonus,false);else{G.money+=weekBonus;G.totalEarned+=weekBonus;} /* v1.9.66: Prestige dla weekly bonus */
      G.stress=clamp(G.stress+20,0,100);
      showMsg(`đźŽŠ TydzieĹ„ ${Math.floor(G.day/7)} ukoĹ„czony! Nagroda tygodniowa: +${weekBonus} zĹ‚, +20 nastrĂłj!`);
      addNotif(`đźŽŠ Nagroda tygodniowa: +${weekBonus} zĹ‚`);
      // Tygodniowe royalties ze streaming
      if(G.studioTracks&&G.studioTracks.length>0){
        let totalRoy=0;
        for(const tr of G.studioTracks){
          // Streams rosnÄ… co tydzieĹ„ zaleĹĽnie od fanĂłw i jakoĹ›ci
          const txtMult=getRaperST('teksty')>=1?1.10:1; // Teksty 1+ â†’ +10% streams
          const growth=Math.floor(((G.fans?(G.followers||0)*0.02:0)+(tr.quality||30)*0.5)*txtMult);
          tr.streams=(tr.streams||0)+growth;
          const rstPct=(G.distributor?G.distributor.royaltyPct:80)/100;
          const bizRoyMult=getRaperST('biznes')>=2?1.15:1; // Biznes 2+ â†’ +15% royalties
          const dripRoyMult=1+Math.min(0.60,(typeof getEffectiveDrip==='function'?getEffectiveDrip():(G.drip||0))*0.002); /* v2.1.209 [Amper]: cap 40â†’60% z PU Personal brand (bez PU drip 200 = +40%, z PU effective 300 = +60%) */
          /* v1.9.18: BUG FIX EXPLOIT â€” royalty liczone z GROWTH (delta tygodniowa), nie z tr.streams (cumulative). WczeĹ›niej 100k stream track pĹ‚aciĹ‚ 400zĹ‚ co tydzieĹ„ FOREVER, infinity glitch. */
          const roy=Math.floor(growth*0.004*rstPct*((tr.quality||30)/100+0.2)*bizRoyMult*dripRoyMult*20);
          totalRoy+=roy;
        }
        if(totalRoy>0){earn(totalRoy,false);G.spotify.royalties=(G.spotify.royalties||0)+totalRoy;addNotif(`đźŽµ Royalties ze streamingu: +${totalRoy} zĹ‚`);}
      }
    }
    // v1.8.42: pasywny przychĂłd zsumowany w jeden komunikat ZAMIAST 10 osobnych toastĂłw showGain.
    let _passiveTotal=0;
    // â”€â”€ Raper skill bonusy dzienne (z warunkami aktywnoĹ›ci â€” anty-AFK) â”€â”€
    // Autopromocja 5+: wymaga IG post w ostatnich 3 dniach
    if(getRaperST('autopromocja')>=5 && (G.day-(G.lastIGPostDay||0))<=3){
      G.followers=(G.followers||0)+50;addNotif('đź“± +50 followersĂłw (Social media king)');
    }
    // Produkcja 5+: wymaga min 5 wyprodukowanych bitĂłw albo aktywny merch sklep
    if(getRaperST('produkcja')>=5 && ((G.careers?.beatmaker?.beats||0)+(G.careers?.beatmaker?.beatsSold||0)>=5 || (G.merchStore?.products?.length||0)>0)){
      const passive=rnd(100,400);earn(passive,false);_passiveTotal+=passive;addNotif('đźĄ Pasywny przychĂłd z bitĂłw: +'+passive+' zĹ‚');
    }
    // Biznes 3+: wymaga zaĹ‚oĹĽonej wytwĂłrni
    if(getRaperST('biznes')>=3 && G.label?.type){
      const labelShare=rnd(50,200);earn(labelShare,false);_passiveTotal+=labelShare;addNotif('đź’Ľ WĹ‚asny label: +'+labelShare+' zĹ‚');
    }
    // Realizacja 4+: wymaga min 1 wydanego singla
    if(getRaperST('realizacja')>=4 && (G.studioTracks?.length||0)>=1){
      const zlecenia=rnd(30,100);earn(zlecenia,false);_passiveTotal+=zlecenia;addNotif('đźŽ™ď¸Ź StaĹ‚e zlecenia realizacji: +'+zlecenia+' zĹ‚');
    }
    // F3-FIX-B: EVOLUTION pasywne dochody (kazdy nowy dzien)
    // v1.8.62: rebalans pasywnych dochodĂłw â€” boost 2-3Ă— ĹĽeby ROI ewolucji wyniosĹ‚o ~30-50 dni (poprzednio 300-500 dni byĹ‚o za wolne)
    if(_evo('supermarket')){earn(1000,false);_passiveTotal+=1000;addNotif('đź›’ LojalnoĹ›Ä‡ klientĂłw: +1000 zĹ‚ (Evolution Kasjer)');}
    if(_evo('gamer')){earn(1000,false);_passiveTotal+=1000;addNotif('đźŽ® E-sport Pro: +1000 zĹ‚ kontrakt (Evolution Gamer)');}
    if(_evo('influencer')){earn(700,false);_passiveTotal+=700;addNotif('đź“± Brand Owner: +700 zĹ‚ z marki (Evolution Influencer)');}
    if(_evo('soundeng')){earn(900,false);_passiveTotal+=900;addNotif('đźŽ™ď¸Ź Studio Owner: +900 zĹ‚ (Evolution Sound Eng.)');}
    if(_evo('youtuber')){earn(1200,false);_passiveTotal+=1200;addNotif('đź“ş Algorithm Master: +1200 zĹ‚ (Evolution YouTuber)');}
    if(_evo('beatmaker')){earn(900,false);_passiveTotal+=900;addNotif('đźĄ Producent: +900 zĹ‚ z bitĂłw (Evolution Beatmaker)');}
    if(_evo('inwestycje')){earn(800,false);_passiveTotal+=800;addNotif('đź“ Magnat: +800 zĹ‚ z portfela (Evolution Inwestycje)');}
    // F3-FIX-D: EVOLUTION kreatywnosc 'Geniusz' â€” co 3 dni nieoczekiwany hit
    // v1.8.62: rebalans â€” co 5 dni +500/+50 â†’ co 3 dni +1500/+150 (~500 zĹ‚/dzieĹ„ ekwiwalent, ROI ~100 dni przy 50k cenie)
    if(_evo('kreatywnosc')){
      G._kreaLastHit=G._kreaLastHit||G.day;
      if(G.day-G._kreaLastHit>=3){
        G._kreaLastHit=G.day;
        earn(1500,false);_passiveTotal+=1500;
        const fans=150;
        /* v2.1.34: Evolution Geniusz daje LOJALNYCH fanĂłw (hit muzyczny przyciÄ…ga prawdziwÄ… publikÄ™) */
        /* v2.1.141: addFans wrapper z crew gain_fans hook */
        addFans(fans);
        addNotif(`đź’ˇ Nieoczekiwany hit! +1500 zĹ‚, +${fans} fanĂłw lojalnych (Evolution Geniusz â€” co 3 dni)`);
        if(typeof showMsg==='function') showMsg('đź’ˇ TwĂłj projekt sprzed kilku dni viralowaĹ‚! +1500 zĹ‚, +150 fanĂłw','g');
      }
    }
    // Jeden Ĺ‚Ä…czny toast dla caĹ‚ego pasywnego dochodu (ZAMIAST kilku osobnych zielonych liczb)
    if(_passiveTotal>0 && typeof showGain==='function'){
      showGain('đź’° Pasywny dochĂłd +'+_passiveTotal.toLocaleString('pl')+' zĹ‚','#27ae60');
    }
    if(getRaperST('scena')>=5){const arenaFans=Math.floor(Math.random()*5)+1;addFans(arenaFans);/* v2.1.34: arena = lojalni fani Â· v2.1.141: addFans wrapper */}
    // â”€â”€ Studio: pasywny wynajem â”€â”€
    const rentalInc=studioRentalIncome();
    if(rentalInc>0){earn(rentalInc);addNotif(`đźŽ™ď¸Ź Wynajem studia: +${rentalInc} zĹ‚`);}
    // â”€â”€ Merch â€” dzienne sprzedaĹĽe, trendy, marketing â”€â”€
    merchDailyTick();
    // â”€â”€ Festiwal tygodniowy â”€â”€
    tickFestival();
    checkHolidays();
    // â”€â”€ Misja gĹ‚Ăłwna â€” sprawdzenie po nowym dniu â”€â”€
    if(G.mainMission&&G.mainMission.active&&!G.mainMission.failed){
      const mm=G.mainMission;
      /* v2.1.36: mainMission "Pierwsze 100/250/500/1000 fanĂłw" sprawdza FANĂ“W LOJALNYCH (G.fans) */
      const totalFans=(G.fans||0);
      // SprawdĹş milestone'y
      for(const ms of mm.milestones){
        if(!ms.done&&totalFans>=ms.fans){
          ms.done=true;
          /* v2.1.176: AUDYT â€” uĹĽywaj earn() ĹĽeby aplikowaĹ‚ Prestige moneyMult + mogul + streak + diamondHands + mood. */
          if(ms.reward.money){if(typeof earn==='function')earn(ms.reward.money,false);else{G.money+=ms.reward.money;G.totalEarned=(G.totalEarned||0)+ms.reward.money;}}
          if(ms.reward.xp) addXP(ms.reward.xp);
          if(ms.reward.followers) G.followers=(G.followers||0)+ms.reward.followers;
          if(ms.reward.fame){if(typeof addFame==='function')addFame(ms.reward.fame);else G.fame=clamp((G.fame||0)+ms.reward.fame,0,500);}
          showMsg(`đźŽŻ ${ms.label}${ms.reward.money?' +'+ms.reward.money+' zĹ‚':''}${ms.reward.xp?' +'+ms.reward.xp+' XP':''}!`);
          addNotif(`đźŹ† Misja: ${ms.label}`);
          if(ms.fans>=1000){mm.active=false;} // misja ukoĹ„czona
        }
      }
      // SprawdĹş czy przegrana (30+ dni)
      if(mm.active&&!mm.failed){
        const daysElapsed=G.day-mm.startDay;
        if(daysElapsed>=mm.daysLimit&&totalFans<1000){
          mm.failed=true;
          G.money=Math.max(0,G.money-2000);
          G.fame=clamp((G.fame||0)-20,0,500);
          G.followers=Math.floor((G.followers||0)*0.7);
          showMsg('đź’” Misja nieudana! Nie zdobyĹ‚eĹ› 1000 fanĂłw w 30 dni. -2000 zĹ‚, -20 sĹ‚awy, -30% obserwujÄ…cych','r');
          addNotif('âťŚ Misja: 30 dni minÄ™Ĺ‚o bez 1000 fanĂłw');
          mm.active=false;
        }
      }
    }
    /* v2.1.133: dodano daily interest 1% â€” wczeĹ›niej poĹĽyczka byĹ‚a "free loan forever" (1000â†’1200 raz, brak kapitalizacji). Teraz kaĹĽdego dnia +1% do salda â€” gracz nie moĹĽe trzymaÄ‡ 500k loan w nieskoĹ„czonoĹ›Ä‡. */
    if(G.bank.loan>0){const _interest=Math.ceil(G.bank.loan*0.01);G.bank.loan+=_interest;if(_interest>0)addNotif(`đź’ł Odsetki kredytu: +${_interest} zĹ‚ (saldo ${G.bank.loan} zĹ‚)`);}
    // SpĹ‚ata kredytu automatyczna jeĹ›li masz pieniÄ…dze
    if(G.bank.loan>0&&G.money>=G.bank.loan){G.money-=G.bank.loan;addNotif('đź’ł Kredyt auto-spĹ‚acony!');G.bank.loan=0;}
    // SprawdĹş dojrzaĹ‚e inwestycje
    if(G.bank.investments&&G.bank.investments.length>0){
      const mature=G.bank.investments.filter(i=>i.returnDay<=G.day);
      const kept=G.bank.investments.filter(i=>i.returnDay>G.day);
      G.bank.investments=kept;
      for(const inv of mature){
        // F3-FIX: INWESTYCJE skill â€” bonus zwrotu z banku (max +15% skill, +50% PU3, evo Magnat z osobno)
        const _invMult = (typeof getInwestycjeBankBonus === 'function') ? getInwestycjeBankBonus() : 1;
        const baseRet = inv.returnAmount;
        const bonusGain = Math.floor(baseRet * (_invMult - 1));
        /* v1.9.18: Cap ROI na 2Ă— initial amount (poprzednio bonus uncapped â€” Inwestycje +15% + PU3 +50% + Magnat evo dawaĹ‚o +95% nad baseRet = +ROI bez sufitu) */
        const _capRet = inv.amount*2;
        const totalRet = Math.min(_capRet, baseRet + bonusGain);
        /* v2.1.122: Wave 3 W32 â€” bonus czÄ™Ĺ›Ä‡ (skill+PU+evo) powinna mieÄ‡ Prestige multiplier. KapitaĹ‚ (inv.amount) bez mult, zysk z earn(). */
        G.money+=inv.amount; /* kapitaĹ‚ wraca bez Prestige */
        const _profitNet=totalRet-inv.amount;
        if(_profitNet>0){if(typeof earn==='function')earn(_profitNet,false);else G.money+=_profitNet;}
        /* v2.1.41 [Amper]: do totalEarned dodajemy tylko ZYSK NETTO (totalRet - inv.amount).
           WczeĹ›niej dodawano caĹ‚y totalRet â€” kapitaĹ‚ (juĹĽ zarobione przed inwestycjÄ…) liczyĹ‚ siÄ™ drugi raz w leaderboard.
           Exploit: inwestuj 1000â†’zwrot 1200â†’totalEarned+=1200 (powinno +=200). */
        const _profit = totalRet - inv.amount;
        if(_profit > 0){
          G.totalEarned=(G.totalEarned||0)+_profit;
          G.bank.totalInvestmentProfit = (G.bank.totalInvestmentProfit||0) + _profit;
        }
        /* v2.1.120: Wave 6 S51 â€” invest history tracker (zachowaj 20 ostatnich). */
        if(!Array.isArray(G.bank.investHistory)) G.bank.investHistory=[];
        G.bank.investHistory.push({amount:inv.amount,returnAmount:totalRet,returnDay:G.day,profit:_profit});
        if(G.bank.investHistory.length>20) G.bank.investHistory=G.bank.investHistory.slice(-20);
        if(bonusGain > 0){
          addNotif(`đź“ Inwestycja: ${baseRet} zĹ‚ + ${bonusGain} zĹ‚ (skill Inwestycje +${Math.round((_invMult-1)*100)}%) = ${totalRet} zĹ‚!`);
        } else {
          addNotif(`đź“ Inwestycja zwrĂłciĹ‚a ${totalRet} zĹ‚ (zysk: +${totalRet-inv.amount} zĹ‚)!`);
        }
      }
    }
  }
}

function addXP(amount){
  // BALANS #67: User feedback "2 min = lvl 4" â€” multiplier 0.6â†’0.5, baza 100â†’150, krzywa 1.5â†’1.8
  // Stary: 100â†’150â†’225â†’337â†’506. Nowy: 150â†’270â†’486â†’874â†’1574 â€” gracz musi grindowaÄ‡.
  // F3-FIX-B: CZYTANIE skill+PU+evo (max ~+115% przy lvl 3 + PU3 + evo czyli "MÄ™drzec")
  /* v1.9.21: negative XP guard + cap G.level 100 anti-overflow */
  amount=Math.max(0, amount|0);
  if(G.level>=100) return;
  const _czytMult = 1 + _sk('czytanie')*0.05 + _pu('czytanie')*0.15;
  // Evolution MÄ™drzec: +1 darmowy pkt umie co 3 lvl postaci (osobny mechanizm â€” przy levelup)
  G.xp+=Math.round(amount*0.5*_czytMult);
  /* v1.9.21: while-loop dla multi-level â€” pojedynczy addXP(500) moĹĽe daÄ‡ 3 levele zamiast tylko 1 (poprzednio surplus carry, level skip) */
  let needed=Math.floor(150*Math.pow(1.8,G.level-1));
  while(G.xp>=needed && G.level<100){
    G.xp-=needed;G.level++;
    /* v2.1.46 [Amper]: levelup daje 2 SP zamiast 1 (buff progresji drzewka). Inne ĹşrĂłdĹ‚a (storyline, daily, achievementy, Evo MÄ™drzec) pozostajÄ… jako bonus. */
    G.skillPoints=(G.skillPoints||0)+2;
    showMsg('đźŹ† Poziom '+G.level+'! +2 punkty umiejÄ™tnoĹ›ci! (kliknij twarz)');
    addNotif('â¬†ď¸Ź Poziom '+G.level+' â€” masz '+G.skillPoints+' pkt umiej.');
    // v1.8.70: natychmiastowy unlock karier po level upie (wczeĹ›niej czekaĹ‚o do 6s na nextPeriod tick â€” bug: gracz lvl 2 widziaĹ‚ "odblokuj na lvl 2" i miaĹ‚ zablokowane)
    try{ if(typeof checkCareerUnlocks==='function') checkCareerUnlocks(); }catch(e){}
    // F3-FIX-B: EVOLUTION MÄ™drzec (czytanie evo) â€” +1 darmowy pkt umie co 3 lvl postaci
    if(_evo('czytanie') && G.level%3===0){
      G.skillPoints+=1;
      addNotif('đź“š MÄ™drzec: +1 darmowy pkt umiejÄ™tnoĹ›ci (Evolution Czytanie)');
    }
    confetti(25);
    showGain('LEVEL UP! â¬†ď¸Ź '+G.level,'#f1c40f');
    sfxSparkle();
    triggerLevelUpBurst();
    // CINEMATIC co 5 lvl (5,10,15,20...) â€” major milestone level up
    /* v2.1.120: Wave 4 S34 â€” lifetime guard ĹĽeby cinematic level X nie odpalaĹ‚ ponownie po Prestige. */
    if(!Array.isArray(G._levelMilestonesShown)) G._levelMilestonesShown=[];
    if(G.level%5===0 && !G._levelMilestonesShown.includes(G.level) && typeof showMilestoneCinematic==='function'){
      G._levelMilestonesShown.push(G.level);
      const milestones={
        5:{tag:'Pierwsze kroki w karierze',c:'#7ec8e3',c2:'#3498db'},
        10:{tag:'Stajesz siÄ™ rozpoznawalny',c:'#27ae60',c2:'#16a085'},
        15:{tag:'Liga zawodowa',c:'#9b59b6',c2:'#e91e8c'},
        20:{tag:'Lokalna gwiazda',c:'#f1c40f',c2:'#e67e22'},
        25:{tag:'Krajowa rozpoznawalnoĹ›Ä‡',c:'#c8a520',c2:'#e91e8c'},
      };
      const ms=milestones[G.level]||{tag:'NastÄ™pny poziom kariery',c:'#c8a520',c2:'#e91e8c'};
      showMilestoneCinematic({
        emoji:'â¬†ď¸Ź',
        title:`POZIOM ${G.level}`,
        subtitle:`+${G.skillPoints} punkt umiejÄ™tnoĹ›ci do wydania`,
        tagline:ms.tag,
        accentColor:ms.c,accent2:ms.c2,duration:4000
      });
    }
  }
  // Storyline natychmiast po kaĹĽdym XP â€” bez czekania na tickDecay (6s)
  // addXP jest wywoĹ‚ywane w prawie kaĹĽdej akcji (freestyle, koncert, track, post, gym, eat...)
  if(typeof checkStoryline==='function') checkStoryline();
}

// â”€â”€ LEVEL UP BURST â”€â”€ potezny wizualny efekt przy awansie â”€â”€
let _luBurst=null; // {t, max} dla shock ringu
function triggerLevelUpBurst(){
  if(currentRoom!=='ulica' || typeof emitSpark!=='function') return;
  const cx=P.wx+P.w/2, cy=P.wy+P.h/2;
  // 4 fale iskier w roznych kolorach (zloto, biel, czerwien, lawender)
  const cols=['rgba(255,220,80,','rgba(255,255,255,','rgba(255,150,200,','rgba(200,180,255,'];
  for(let i=0;i<5;i++){
    setTimeout(()=>{
      cols.forEach(col=>emitSpark(cx,cy,col));
      // duza fala zlota co kilkadziesiat ms
      for(let k=0;k<8;k++){
        const a=Math.random()*Math.PI*2, sp=2.5+Math.random()*3;
        _spawnParticle({wx:cx,wy:cy,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-0.8,life:36,max:36,col:'rgba(255,220,80,',size:2+Math.random()*2,grav:0.04});
      }
    },i*60);
  }
  _luBurst={t:0,max:30};
}
function drawLevelUpBurstFX(){
  if(!_luBurst) return;
  if(currentRoom!=='ulica'){_luBurst=null;return;}
  _luBurst.t++;
  if(_luBurst.t>=_luBurst.max){_luBurst=null;return;}
  const a=_luBurst.t/_luBurst.max;
  const cx=wx2sx(P.wx+P.w/2), cy=wy2sy(P.wy+P.h/2);
  X.save();
  // Shock ring rosnacy
  X.strokeStyle=`rgba(255,220,80,${(1-a)*0.85})`;
  X.lineWidth=3;
  X.beginPath();X.arc(cx,cy,12+a*70,0,Math.PI*2);X.stroke();
  X.strokeStyle=`rgba(255,255,255,${(1-a)*0.55})`;
  X.lineWidth=1.5;
  X.beginPath();X.arc(cx,cy,16+a*46,0,Math.PI*2);X.stroke();
  // Promienie swiatla wokol postaci
  X.strokeStyle=`rgba(255,220,80,${(1-a)*0.4})`;
  X.lineWidth=2;
  for(let i=0;i<8;i++){
    const ang=i*Math.PI/4 + a*Math.PI*0.25;
    const r1=20+a*22, r2=42+a*48;
    X.beginPath();X.moveTo(cx+Math.cos(ang)*r1,cy+Math.sin(ang)*r1);
    X.lineTo(cx+Math.cos(ang)*r2,cy+Math.sin(ang)*r2);X.stroke();
  }
  X.restore();
}
// Sesyjne + dzienne statystyki. earnedToday/spentToday/etc. resetowane przy nextPeriod (G.day++).
// Stary dzieĹ„ zachowany w _lastDayStats â€” pokazywany w Daily Summary po wakeUp.
window._sessionStats=window._sessionStats||{startReal:Date.now(),startDay:0,earnedToday:0,earnedSession:0,spentToday:0,actions:0,jobsDone:0,concertsDone:0,gymDone:0,energyAtSleep:null};
window._lastDayStats=window._lastDayStats||null;
function _updateSessionDay(){
  if(_sessionStats.startDay!==G.day){
    // Snapshot starego dnia (do daily summary)
    if(_sessionStats.startDay>0){
      _lastDayStats={
        day:_sessionStats.startDay,
        earned:_sessionStats.earnedToday||0,
        spent:_sessionStats.spentToday||0,
        jobs:_sessionStats.jobsDone||0,
        concerts:_sessionStats.concertsDone||0,
        gym:_sessionStats.gymDone||0
      };
    }
    _sessionStats.earnedToday=0;_sessionStats.spentToday=0;
    _sessionStats.jobsDone=0;_sessionStats.concertsDone=0;_sessionStats.gymDone=0;
    _sessionStats.startDay=G.day;
  }
}
/* v2.1.212 [Amper]: Fame redesign â€” cap 100â†’500, 5 tier'Ăłw, diminishing returns. */
function getFameTier(){
  const f=G.fame||0;
  if(f>=400) return 4;
  if(f>=300) return 3;
  if(f>=200) return 2;
  if(f>=100) return 1;
  return 0;
}
function getFameTierName(){
  return ['Underground','Rising','Famous','Legendary','GOAT'][getFameTier()];
}
function getFameDimMult(){
  const f=G.fame||0;
  if(f>=300) return 0.25;
  if(f>=100) return 0.5;
  return 1.0;
}
/* v1.9.31 â†’ v2.1.212: addFame z diminishing returns + cap 500 */
function addFame(n){
  if(!n||n<=0)return 0;
  const skillMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('legend_status'):1;
  const mult=(G.prestigeBonus?.fameMult||1)*skillMult;
  const dimMult=getFameDimMult();
  const final=Math.round(n*mult*dimMult);
  G.fame=Math.min(500,Math.max(0,(G.fame||0)+final));
  return final;
}
/* v2.1.141: addFans(n) wrapper â€” analogicznie do addFame()/earn(). Hook dla crew challenge 'gain_fans' (Faza E TODO L42547).
   Wszystkie miejsca przyrostu G.fans (12 lokalizacji) uĹĽywajÄ… tej funkcji â€” 1 punkt modyfikacji dla future buffĂłw (np. Marketing crew +10%).
   NIE uĹĽywa siÄ™ w defensive init / save migration / admin commands (te NIE sÄ… "gracz zdobywa fanĂłw"). */
function addFans(n){
  if(typeof n!=='number'||isNaN(n)||n<=0)return 0;
  if(typeof G.fans!=='number') G.fans=0;
  /* v2.1.160: Prestige Skill "Cult Following" +20% fans */
  const skillMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('cult_following'):1;
  const final=Math.floor(n*skillMult);
  G.fans=Math.max(0,Math.min(9999999999,G.fans+final));
  /* Crew challenge progress hook â€” analogicznie do earn() L12277, addFame poza Prestige */
  if(G.playerCrew && typeof window._crewAddProgress==='function'){
    try{window._crewAddProgress('gain_fans',final);}catch(e){}
  }
  return final;
}
/* v2.1.116: Wave 5 S43 / Wave 1 K20 â€” centralny window._esc (XSS escape) zamiast 6Ă— lokalnych definicji.
   Stare lokalne const _esc=... mogÄ… uĹĽywaÄ‡ window._esc dla spĂłjnoĹ›ci. */
window._esc=function(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');};
// DomyĹ›lnie POKAZUJE floating "+X zĹ‚" + sfxCash przy â‰Ą20 zĹ‚.
// Dla cichego zarobku (np. tickowe royalties) wywoĹ‚aj earn(amount, false).
function earn(amount,showFloat=true){
  if(amount>0){
    const mogul=getRaperST('biznes')>=5?1.3:1;
    const streak=typeof streakBonusMult==='function'?streakBonusMult():1;
    // v1.8.94: PRESTIGE bonus realnie aplikowany (wczeĹ›niej byĹ‚ FAKE â€” flaga ustawiana ale nieuĹĽywana)
    /* v2.1.160: Prestige Skill "Diamond Hands" +10% money (na top of base prestige mult) */
    const _diamondMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('diamond_hands'):1;
    const prestigeMult=(G.prestigeBonus?.moneyMult||1)*_diamondMult;
    // v1.8.95: WERYFIKACJA â€” Strateg evo (Logika) i Master Mind evo (Skupienie) DZIAĹAJÄ„ poprawnie
    // przez getKarieraBonus()/getSkupienieFocusBonus() w funkcjach karier/minigier. NIE duplikuj w earn().
    // v1.9.1: Mood/Stress effect â€” gracz w spokoju (stress 80+) zarabia +10%, wypalony (stress <20) tylko 95%
    const moodEarnMult=G.stress>=80?1.10:(G.stress<20?0.95:1);
    amount=Math.round(amount*mogul*streak*prestigeMult*moodEarnMult);
    G.money+=amount;G.totalEarned=(G.totalEarned||0)+amount;
    /* v2.1.0: Crew challenge â€” earn_money progress (jeĹ›li jestem w crew z aktywnym earn_money challenge) */
    if(G.playerCrew && typeof window._crewAddProgress==='function'){try{window._crewAddProgress('earn_money',amount);}catch(e){}}
    _updateSessionDay();
    _sessionStats.earnedToday+=amount;
    _sessionStats.earnedSession+=amount;
    if(showFloat) showGain('+'+amount.toLocaleString('pl')+' zĹ‚','#27ae60');
    if(amount>=20)sfxCash();
    // Sparkle particles przy zarobku â‰Ą50 zĹ‚ â€” prosty wow effect
    if(amount>=50&&typeof emitSpark==='function'&&currentRoom==='ulica'){
      emitSpark(P.wx+P.w/2,P.wy+P.h/2,'rgba(255,220,140,');
    }
  }
  return amount;
}
// Universal "spent" tracker â€” wywoĹ‚any rÄ™cznie lub gdy G.money- siÄ™ dzieje (key purchases).
function spent(amount){
  if(amount>0){
    _updateSessionDay();
    _sessionStats.spentToday=(_sessionStats.spentToday||0)+amount;
  }
}
// Mini helpers do trackingu akcji
window._trackJob=()=>{_updateSessionDay();_sessionStats.jobsDone=(_sessionStats.jobsDone||0)+1;};
window._trackConcert=()=>{_updateSessionDay();_sessionStats.concertsDone=(_sessionStats.concertsDone||0)+1;
  /* v2.1.0: Crew challenge â€” play_concerts progress */
  if(G.playerCrew && typeof window._crewAddProgress==='function'){try{window._crewAddProgress('play_concerts',1);}catch(e){}}
};
window._trackGym=()=>{_updateSessionDay();_sessionStats.gymDone=(_sessionStats.gymDone||0)+1;};

// â”€â”€ Raper XP + level â”€â”€
/* v2.1.147: rozszerzony z 6 do 23 entries (level 0-22). PowĂłd: drzewko rapera ma 9 branches Ă— max 5 = 45 pkt potrzebne do full max-out. WczeĹ›niej 5 levels Ă— 2 pkt + 1 startowy = 11 pkt (tylko 24% drzewka).
   Teraz 22 levels Ă— 2 pkt + 1 startowy = 45 pkt = exactly enough. Krzywa XP roĹ›nie progressywnie, max 100k XP (osiÄ…galne late-game grindem). */
const RAPER_LEVELS=[
  {level:0,name:'PoczÄ…tkujÄ…cy',xpReq:0},
  {level:1,name:'Underground I',xpReq:80},
  {level:2,name:'Underground II',xpReq:200},
  {level:3,name:'Underground III',xpReq:450},
  {level:4,name:'Underground IV',xpReq:900},
  {level:5,name:'Rising I',xpReq:1500},
  {level:6,name:'Rising II',xpReq:2300},
  {level:7,name:'Rising III',xpReq:3400},
  {level:8,name:'Rising IV',xpReq:4800},
  {level:9,name:'Known I',xpReq:6600},
  {level:10,name:'Known II',xpReq:8800},
  {level:11,name:'Known III',xpReq:11500},
  {level:12,name:'Known IV',xpReq:15000},
  {level:13,name:'Famous I',xpReq:19500},
  {level:14,name:'Famous II',xpReq:25000},
  {level:15,name:'Famous III',xpReq:32000},
  {level:16,name:'Famous IV',xpReq:40000},
  {level:17,name:'Legend I',xpReq:50000},
  {level:18,name:'Legend II',xpReq:62000},
  {level:19,name:'Legend III',xpReq:76000},
  {level:20,name:'Legend IV',xpReq:92000},
  {level:21,name:'Legend V',xpReq:110000},
  {level:22,name:'GOAT',xpReq:130000},
];
function getRaperLevel(){return RAPER_LEVELS.reduce((a,b)=>((G.careers.raper.xp||0)>=b.xpReq?b:a));}
function getRaperST(branch){return (G.raperST&&G.raperST[branch])||0;}
function addRaperXP(amount){
  /* v1.9.21: negative guard */
  amount=Math.max(0, amount|0);
  const flowBonus=getRaperST('flow')>=2?1.15:1;
  const finalAmt=Math.round(amount*flowBonus);
  if(!G.careers.raper) G.careers.raper={level:0,freestyles:0,tracks:0,xp:0,skillPts:0};
  G.careers.raper.xp=(G.careers.raper.xp||0)+finalAmt;
  const lvl=getRaperLevel();
  /* v2.1.147: rozszerzony do 22 levels â€” milestone messages tylko dla gĹ‚Ăłwnych tier transitions (1, 5, 9, 13, 17, 22). Sub-levels w obrÄ™bie tier dostajÄ… generyczny "+2 pkt" message. */
  const RAPER_LVL_UNLOCKS={
    1:'Underground â€” pierwsze kroki w branĹĽy. WiÄ™cej XP z freestylĂłw, dostÄ™p do Sali Koncertowej.',
    5:'Rising â€” wybijasz siÄ™ ponad scenÄ™ lokalnÄ…. Streaming przynosi wiÄ™cej kasy, kontrakty z labelem.',
    9:'Known â€” rozpoznawalnoĹ›Ä‡ roĹ›nie. Festiwale odblokowane, znane marki zwracajÄ… uwagÄ™.',
    13:'Famous â€” gwiazda nationalu. Trasy koncertowe, zarzÄ…dzanie wĹ‚asnÄ… ekipÄ….',
    17:'Legend â€” twoje nazwisko mĂłwi za siebie. Arena shows, status legendy, pasywny dochĂłd wszÄ™dzie.',
    22:'GOAT â€” Greatest Of All Time. NiezrĂłwnany status, maksymalne mnoĹĽniki, wszystkie umiejÄ™tnoĹ›ci mogÄ… byÄ‡ max-out.',
  };
  if(lvl.level>G.careers.raper.level){
    G.careers.raper.level=lvl.level;
    G.careers.raper.skillPts=(G.careers.raper.skillPts||0)+2;
    const unlk=RAPER_LVL_UNLOCKS[lvl.level]||'';
    showMsg(`đźŽ¤ POZIOM RAPERA: ${lvl.name}! +2 pkt umiejÄ™tnoĹ›ci! ${unlk}`);
    addNotif(`đźŽ¤ Raper ${lvl.name}! +2 skill pkt`);
    confetti(35);showGain('đźŽ¤ '+lvl.name,'#e91e8c');
    addXP(20);
  }
}

function checkCareerUnlocks(){
  const c=G.careers;
  const totalXP=G.xp+(G.level-1)*CFG.xpPerLevel;
  // v1.8.31: cinematics dla kaĹĽdej kariery odblokowanej (waĹĽny moment progresji)
  /* v2.0.26: globalny flag _careerCinemEverShown ZAPOBIEGA ponownemu odpaleniu cinematic kariera
     po Prestige reset (gdzie unlocked=false jest set). WczeĹ›niej user widziaĹ‚ cinematic ZA KAĹ»DYM Prestige
     â€” bo unlock flag byĹ‚ resetowany, ale "shown" flag nie istniaĹ‚. Plus admin maxStats teĹĽ mĂłgĹ‚
     wywoĹ‚ywaÄ‡ cinematic chain (fameâ†’achievementsâ†’addXPâ†’levelâ†’cinematic). _careerCinemEverShown nigdy
     nie jest resetowany. */
  G._careerCinemEverShown = G._careerCinemEverShown || {};
  const _careerCinematic=(emoji,title,subtitle,tagline,c1,c2,key)=>{
    if(G._careerCinemEverShown[key]) return;
    /* v2.0.27: jeĹ›li gracz kiedykolwiek uĹĽyĹ‚ admin cheat, nie odpalaj cinematic kariera
       (chain reaction adminAddXP/adminAddFollowers/etc. teĹĽ triggeruje level up â†’ cinematic). */
    if(G._adminCheatUsed){ G._careerCinemEverShown[key] = true; return; }
    G._careerCinemEverShown[key] = true;
    if(typeof showMilestoneCinematic==='function'){
      showMilestoneCinematic({emoji,title,subtitle,tagline,accentColor:c1,accent2:c2,duration:4000});
    }
  };
  /* v2.1.26: auto-cinematic USUNIÄTY â€” gracz dostaje tylko notyfikacjÄ™ gdy kariera siÄ™ odblokowuje.
     WczeĹ›niej cinematic wyskakiwaĹ‚ automatycznie nawet gdy gracz NIE robiĹ‚ nic zwiÄ…zanego z karierÄ…
     (np. levelup z koncertu odblokowuje gamer cinematic). User: "wyskoczyl mi cinematic youtuber a nic nie zrobiĹ‚em". */
  if(!c.youtuber.unlocked&&totalXP>=c.youtuber.xpReq){
    c.youtuber.unlocked=true;addNotif('đźŽ¬ YouTuber odblokowany! IdĹş do studio z komputerem.');
  }
  if(!c.gamer.unlocked&&G.level>=2){
    c.gamer.unlocked=true;addNotif('đźŽ® Gamer odblokowany! Komputer w studio â€” mecze rankingowe + streamy.');
  }
  if(!c.beatmaker.unlocked&&G.level>=3){
    c.beatmaker.unlocked=true;addNotif('đźĄ Beatmaker odblokowany! TwĂłrz bity w studio + sprzedawaj artystom.');
  }
  if(!c.influencer.unlocked&&G.followers>=500){
    c.influencer.unlocked=true;addNotif('đź“± Influencer odblokowany! Posty + sponsorzy w telefonie.');
  }
  if(!c.soundeng.unlocked&&G.level>=4){
    c.soundeng.unlocked=true;addNotif('đźŽ™ Realizator dĹşwiÄ™ku odblokowany! Wokale + zlecenia w studio.');
  }
  if(!G.merch.active&&(G.fans||0)>=5000){
    G.merch.active=true;addNotif('đź§˘ Merch odblokowany! Studio Projektowania â€” koszulki, bluzy, czapki.');
  }
  // Follower milestones
  if(!G._mile1k&&(G.fans||0)>=1000){G._mile1k=true;earn(500,false);if(typeof addFame==='function')addFame(5);else G.fame=clamp(G.fame+5,0,500);showMsg('đźŽ‰ 1 000 fanĂłw! +500 zĹ‚ premii, +5 sĹ‚awa!');addNotif('đźŽ‰ Milestone: 1K fanĂłw!');confetti(20);showGain('+500 zĹ‚ đźŽ‰','#27ae60');}
  if(!G._mile10k&&(G.fans||0)>=10000){G._mile10k=true;earn(2000,false);if(typeof addFame==='function')addFame(10);else G.fame=clamp(G.fame+10,0,500);showMsg('đźŚź 10 000 fanĂłw! +2000 zĹ‚, +10 sĹ‚awa!');addNotif('đźŚź Milestone: 10K fanĂłw!');confetti(40);showGain('+2000 zĹ‚ đźŚź','#f1c40f');}
  if(!G._mile100k&&(G.fans||0)>=100000){G._mile100k=true;earn(10000,false);if(typeof addFame==='function')addFame(20);else G.fame=clamp(G.fame+20,0,500);showMsg('đź’Ž 100 000 fanĂłw! JesteĹ› gwiazdÄ…! +10 000 zĹ‚, +20 sĹ‚awa!');addNotif('đź’Ž Milestone: 100K fanĂłw!');confetti(60);showGain('+10 000 zĹ‚ đź’Ž','#c8a520');}
  // v1.8.28: brakujÄ…cy 1M milestone â€” cinematic istniaĹ‚ (8674) ale nigdy nie dawaĹ‚ nagrody finansowej.
  if(!G._mile1m&&(G.fans||0)>=1000000){G._mile1m=true;G._mile1mDay=G.day; /* v1.8.73: speedrun tracker */ earn(50000,false); /* v2.1.212: 1M fanow = +50 fame milestone (przez addFame z diminishing returns), zamiast direct set 100. Cap nowy 500. */ /* v2.1.213+: pokazuj FAKTYCZNY fame gain (po diminishing returns) zamiast hardcoded "+50". Tier 0 = +50, Tier 1-2 = +25, Tier 3+ = +12. */ const _mile1mFameGained = (typeof addFame==='function') ? addFame(50) : 50; if(typeof addFame!=='function') G.fame=Math.min(500,(G.fame||0)+50);showMsg('🏆 MILION FANÓW! Status legendy! +50 000 zł, +'+_mile1mFameGained+' sławy!');addNotif('🏆 Milestone: 1M fanów — LEGENDA!');confetti(100);showGain('+50 000 zł 🏆','#e91e8c'); if(typeof submitAllScores==='function') submitAllScores();}
  // Street rep nagrody
  if(G.streetRep>=25&&!G._repBoost25){G._repBoost25=true;showMsg('đź”± Reputacja 25! Kurier pĹ‚aci Ci +20% wiÄ™cej.');addNotif('đź”± Rep 25 â€” Kurier bonus aktywny!');}
  if(G.streetRep>=50&&!G._repBoost50){G._repBoost50=true;showMsg('đź”± Reputacja 50! Dzielnica Dripu daje Ci 5% zniĹĽki!');addNotif('đź›Ť Rep 50 â€” Drip District -5%!');}
  if(G.streetRep>=75&&!G._repBoost75){G._repBoost75=true;/* v2.1.123: Wave 3 K33 â€” addFame Prestige aware */ if(typeof addFame==='function')addFame(10);else G.fame=clamp(G.fame+10,0,500);showMsg('đź‘‘ Reputacja 75! SĹ‚awa +10. Drip District -10%. Koncerty przynoszÄ… wiÄ™cej fanĂłw.');addNotif('đź‘‘ Rep 75 â€” SĹ‚awa +10, Drip -10%!');}
  /* v2.1.201 [Amper]: Street Rep revival â€” 2 nowe progi (90, 100) z konkretnymi nagrodami.
     Filozofia: rep byĹ‚ "dead stat" powyĹĽej 75 â€” teraz top tier daje generic shop discount + pasywny fan retention. */
  if(G.streetRep>=90&&!G._repBoost90){G._repBoost90=true;
    if(typeof addFame==='function') addFame(15); else G.fame=clamp((G.fame||0)+15,0,500);
    showMsg('đź‘‘ Reputacja 90! +15 sĹ‚awy. Sklepy uliczne (SpoĹĽywczy/Kebab/Targ/Restauracja) dajÄ… -8% rabat. +30% napiwki carwash.','g',6000);
    addNotif('đź‘‘ Rep 90 â€” sklepy uliczne -8%!');
  }
  if(G.streetRep>=100&&!G._repBoost100){G._repBoost100=true;
    if(typeof addFame==='function') addFame(25); else G.fame=clamp((G.fame||0)+25,0,500);
    if(typeof addFans==='function') addFans(500);
    showMsg('đźŚź LEGENDA ULICY! Rep 100 = max. +25 sĹ‚awy, +500 fanĂłw, wszystkie sklepy -12% (z capem), +1 pasywny fan/dzieĹ„.','g',8000);
    addNotif('đźŚź Rep 100 â€” Legenda ulicy!');
    if(typeof confetti==='function') confetti(60);
  }
}
/* v2.1.201 [Amper]: Generic shop discount based on street rep â€” kupcy "znajÄ… ciÄ™" i dajÄ… lepsze ceny.
   Aplikowane do buyItem (spoĹĽywczy/kebab), buyClothes, salon aut.
   Cap -12% przy rep 100. */
window.getStreetRepShopDiscount=()=>{
  const r=G.streetRep||0;
  if(r>=100) return 0.12;
  if(r>=90) return 0.08;
  if(r>=75) return 0.05;
  if(r>=50) return 0.03;
  return 0;
};

// â”€â”€â”€ #64 SYSTEM RACHUNKĂ“W â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Rachunki generowane co 7 dni per mieszkanie. Termin 7 dni. Odsetki +10%/dzieĹ„ po terminie.
// Eksmisja po 21+ dniach niepĹ‚acenia â†’ powrĂłt do traphouse + dĹ‚ug do spĹ‚aty.
const APT_RENT={traphouse:50, basic:250, premium:600, luxury:1800, mansion:5000, mega_villa:12000}; /* v2.1.159: Mansion · v2.1.215: Mega Villa 12k zł/tydzień (Tier 3 Legendary) */
function tickBills(){
  if(!G.bills) G.bills={pending:[], history:[], evicted:false};
  const apt=G.apartment||'traphouse';
  // v1.9.14: BUG FIX â€” czynsz pobierany za WSZYSTKIE posiadane mieszkania, nie tylko obecne (anti-OP exploit "rent out luxury, live in traphouse")
  // Owned = current + wszystkie wpisane do G._ownedApts (zakupione ale niezamieszkane)
  const _allOwned=new Set([apt]);
  if(Array.isArray(G._ownedApts)) G._ownedApts.forEach(a=>{if(a&&a!=='traphouse')_allOwned.add(a);});
  // Generowanie nowego rachunku co 7 dni (poniedziaĹ‚ek = G.day%7==1)
  if(G.day%7===1 && (G._lastBillDay||0)!==G.day){
    G._lastBillDay=G.day;
    for(const _apt of _allOwned){
      const _rent=APT_RENT[_apt]||50;
      // Mieszkania wynajmowane innym: wĹ‚aĹ›ciciel pĹ‚aci niĹĽszy "rachunek administracyjny" (~50% bills)
      const _isRented=G.rentals&&G.rentals[_apt]===true&&_apt!==apt;
      const _finalRent=_isRented?Math.floor(_rent*0.5):_rent;
      const _label=_isRented?'czynsz administracyjny (wynajmowany)':'czynsz';
      const bill={
        id:'rent_'+_apt+'_'+G.day,
        type:'czynsz',
        apt:_apt,
        amount:_finalRent,
        _baseAmount:_finalRent,
        dueDay:G.day+7,
        issuedDay:G.day,
        paid:false,
      };
      G.bills.pending.push(bill);
      addNotif(`đź“¨ Nowy rachunek: ${_finalRent} zĹ‚ ${_label} (${CFG.APT_NAMES[_apt]||_apt}). Termin: DzieĹ„ ${bill.dueDay}.`);
    }
    if(_allOwned.size>1 && typeof showSmartHint==='function') showSmartHint(`đź“¨ Posiadasz ${_allOwned.size} mieszkaĹ„ â€” wszystkie generujÄ… rachunki. SprawdĹş telefon â†’ đź’¸ Rachunki.`);
  }
  // #73: Naliczanie odsetek za KAĹ»DY dzieĹ„ opĂłĹşnienia (10% kwoty bazowej/dzieĹ„)
  G.bills.pending.forEach(b=>{
    if(b.paid) return;
    if(G.day>b.dueDay){
      const overdue=G.day-b.dueDay;
      // Odsetki â€” naliczane raz dziennie na bazie ORYGINALNEJ kwoty (nie composite)
      if(b._lastInterestDay!==G.day){
        b._lastInterestDay=G.day;
        b._baseAmount=b._baseAmount||b.amount;
        const interest=Math.round(b._baseAmount*0.10);
        b.amount+=interest;
        b.overdue=overdue;
        if(overdue===1) showMsg(`âš ď¸Ź Rachunek "${b.type}" przeterminowany! +${interest} zĹ‚ odsetek.`,'r');
        else if(overdue===3) showMsg(`đźš¨ Rachunek 3 dni po terminie! EKSMISJA za 2 dni â€” zapĹ‚aÄ‡ teraz!`,'r');
        else if(overdue===4) showMsg(`đźš¨đźš¨ EKSMISJA JUTRO! Ostatnia szansa â€” zapĹ‚aÄ‡ natychmiast!`,'r');
      }
    }
  });
  // #73 EKSMISJA po >5 dniach overdue (byĹ‚o 21) â€” z KAĹ»DEGO mieszkania (nie tylko nie-traphouse)
  const evictBill=G.bills.pending.find(b=>!b.paid && (G.day-b.dueDay)>5);
  if(evictBill && !G.bills.evicted){
    G.bills.evicted=true;
    G._evictedFromApt=G.apartment; // zachowaj do listu
    /* v1.9.58: reset apartmentu po eksmisji ĹĽeby gracz nie zachowywaĹ‚ bonusĂłw (audyt apt regen) */
    if(G.apartment && G.apartment!=='traphouse') G.apartment='traphouse';
    // Wyrzucamy gracza na ulicÄ™ jeĹ›li aktualnie jest w mieszkaniu
    if(['mieszkanie','mieszkanie_premium','mieszkanie_lux'].includes(currentRoom)){
      const sp=APT_EXIT_SPAWNS?.[G.apartment]||{wx:600,wy:500};
      changeRoom('ulica',sp.wx,sp.wy);
    }
    showMsg('đźš¨ EKSMISJA! ZostaĹ‚eĹ› wyrzucony z mieszkania za niepĹ‚acenie rachunkĂłw. SpĹ‚aÄ‡ wszystkie zalegĹ‚oĹ›ci w telefonie (đź’¸ Rachunki) by odzyskaÄ‡ dostÄ™p.','r');
    addNotif('đźš¨ EKSMISJA z mieszkania!');
  }
}
window.payAllBills=()=>{
  if(!G.bills?.pending?.length) return;
  const total=G.bills.pending.reduce((s,b)=>s+b.amount,0);
  if(G.money<total){if(typeof showMsg==='function')showMsg(`đź’¸ Brak kasy â€” potrzeba ${total} zĹ‚, masz ${G.money}.`,'r');return;}
  // SpĹ‚aÄ‡ wszystkie
  G.money-=total;
  G.bills.pending.forEach(b=>{b.paid=true;b.paidDay=G.day;G.bills.history.push(b);});
  G.bills.pending=[];
  // v1.8.56: BUG FIX â€” komunikat "EKSMISJA ZNIESIONA" pokazywaĹ‚ siÄ™ ZAWSZE po payAllBills (bo evicted byĹ‚ wĹ‚aĹ›nie ustawiony na false).
  // Teraz sprawdzamy stan PRZED zmianÄ….
  const _wasEvicted=!!G.bills.evicted;
  if(_wasEvicted){
    G.bills.evicted=false;delete G._evictedFromApt; /* v1.9.18: cleanup _evictedFromApt po recovery */
    /* v2.1.172: Auto-restore G.apartment do najlepszego posiadanego (zamiast wymagania manualnego "PrzeprowadĹş siÄ™" w biurze) */
    if(typeof window._setActiveAptToBest==='function') window._setActiveAptToBest();
  }
  if(typeof showMsg==='function')showMsg(`âś… SpĹ‚acono wszystkie rachunki za ${total} zĹ‚!${_wasEvicted?' EKSMISJA ZNIESIONA â€” wracasz do swojego najlepszego mieszkania.':''}`,'g');
  if(typeof renderPhoneApp==='function' && document.getElementById('phone')?.classList.contains('on')){
    renderPhoneApp('bills');
  }
  if(typeof updateHUD==='function')updateHUD();
};
window.payBill=(billId)=>{
  if(!G.bills) return;
  const b=G.bills.pending.find(x=>x.id===billId&&!x.paid);
  if(!b){showMsg('Rachunek nie znaleziony.','r');return;}
  // v1.8.24: defensywna walidacja â€” uszkodzony save mĂłgĹ‚by mieÄ‡ b.amount=undefined â†’ NaN poisoning G.money.
  if(typeof b.amount!=='number'||!isFinite(b.amount)||b.amount<0){
    console.error('payBill: invalid b.amount',b);
    showMsg('Uszkodzony rachunek â€” pomijam.','r');
    G.bills.pending=G.bills.pending.filter(x=>x.id!==billId);
    return;
  }
  if(G.money<b.amount){showMsg(`đź’¸ Brak kasy! Potrzeba ${b.amount} zĹ‚, masz ${G.money}.`,'r');return;}
  G.money-=b.amount;
  b.paid=true;
  b.paidDay=G.day;
  G.bills.history.push(b);
  G.bills.pending=G.bills.pending.filter(x=>x.id!==billId);
  // Odblokuj eksmisjÄ™ jeĹ›li wszystkie rachunki za nie-traphouse spĹ‚acone
  if(G.bills.evicted && !G.bills.pending.some(x=>!x.paid && x.apt!=='traphouse')){
    G.bills.evicted=false;
    showMsg('âś… Wszystkie zalegĹ‚e rachunki spĹ‚acone! System automatycznie przywraca ciÄ™ do najlepszego posiadanego mieszkania.','g');
  }
  notify(`đź’¸ ZapĹ‚acono ${b.amount} zĹ‚ za "${b.type}".`);
  if(typeof renderPhoneApp==='function' && document.getElementById('phone')?.classList.contains('on')){
    renderPhoneApp('bills');
  }
  updateHUD();
};

function gameOver(){
  // Soft reset â€” wybudzenie w szpitalu z karÄ…
  const fee=Math.min(500,Math.max(0,G.money));
  G.money=Math.max(0,G.money-500);
  /* v2.1.104: bankruptcy penalty (Wave 6 K57) â€” gracz bez 500 zĹ‚ na szpital dostaje "wyrzut z chodnika" jako kara:
     -3 sĹ‚awy + -5 rep uliczna (publicznoĹ›Ä‡ widzi ĹĽe ktoĹ› jest na dnie). NIE blokuje gameplay, ale daje feel "konsekwencji". */
  if(fee < 500){
    G.fame=Math.max(0,(G.fame||0)-3);
    G.streetRep=Math.max(0,(G.streetRep||0)-5);
    if(typeof addNotif==='function') addNotif('âš ď¸Ź Bez kasy na szpital â€” wyrzut z chodnika. â’3 sĹ‚awy, â’5 rep uliczna.');
  }
  G.health=getMaxStat('health');
  G.hunger=getMaxStat('hunger');
  G.energy=getMaxStat('energy');
  G.stress=100; /* v1.9.25: BUG FIX â€” relaxed/wypoczÄ™ty (stress jest jak mood: 100=zen, 0=burnout). WczeĹ›niej kod ustawiaĹ‚ 0=burnout chociaĹĽ UI mĂłwiĹ‚o "WypoczÄ™ty (stres zresetowany)". */
  G.sleepDebt=0;
  /* v1.9.23: BUG FIX EXPLOIT â€” gameOver() day++ przez nextPeriod() (poprzednio dying skip\\u0027owaĹ‚ bills/rent = exploit 500zĹ‚ vs full czynsz) */
  G.timeOfDay=3;
  if(typeof nextPeriod==='function') nextPeriod();
  G._deaths=(G._deaths||0)+1;
  /* v1.9.72: respi pod szpitalem zamiast w mieszkaniu (zgĹ‚oszone przez gracza â€” hospital scene powinien skoĹ„czyÄ‡ siÄ™ przy szpitalu) */
  changeRoom('ulica',1980,820);
  // Zapisz natychmiast (ĹĽeby auto-save nie utknÄ…Ĺ‚ na health=0 na chwilÄ™)
  saveGameSilent();
  document.getElementById('ov-content').innerHTML=`
    <h2 style="color:#3498db">đźŹĄ Szpital</h2>
    <p class="sub">WybudziĹ‚eĹ› siÄ™ w szpitalu po krytycznym spadku zdrowia.</p>
    <div style="background:#0a1525;border:1px solid #1a3050;border-radius:10px;padding:16px;margin-bottom:16px;font-size:14px;line-height:1.7">
      <div style="color:#7ec87e;font-weight:700;margin-bottom:8px">âś… PeĹ‚na regeneracja:</div>
      <div style="color:#aaa;margin-left:14px">â€˘ Zdrowie 100% Â· Energia 100% Â· GĹ‚Ăłd 100%</div>
      <div style="color:#aaa;margin-left:14px;margin-bottom:10px">â€˘ WypoczÄ™ty (stres zresetowany)</div>
      <div style="color:#e07070;font-weight:700;margin-bottom:8px">đź’Š OpĹ‚ata za leczenie:</div>
      <div style="color:#aaa;margin-left:14px">â€˘ Rachunek szpitalny: <strong style="color:#e74c3c">-${fee} zĹ‚</strong></div>
      <div style="color:#aaa;margin-left:14px">â€˘ Stracony dzieĹ„ (jesteĹ› w dniu ${G.day})</div>
    </div>
    <div style="background:#0a1f0a;border:1px solid #2a5a2a;border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:13px;color:#aae0aa">
      đź’ˇ <strong>WskazĂłwka:</strong> Jedz regularnie (lodĂłwka/restauracja/sklep), Ĺ›pij w Ĺ‚ĂłĹĽku gdy energia spada poniĹĽej 30%. Skille â€žApetyt" i â€žOdpornoĹ›Ä‡" spowalniajÄ… decay.
    </div>
    <details style="margin-bottom:14px">
      <summary style="cursor:pointer;color:#7ec8e3;font-size:13px;text-align:center;padding:8px;background:#0a1525;border-radius:6px;border:1px solid #1a3050">đź“Š PodglÄ…d statystyk ĹĽycia</summary>
      <div style="margin-top:10px;background:#0a0f1a;border:1px solid #1a2535;border-radius:6px;padding:14px">${buildStatsSummary()}</div>
    </details>
    <button class="dbtn" style="width:auto;padding:13px 32px;display:block;margin:0 auto" onclick="closeOverlay()">đźš¶ WstajÄ™, idÄ™ dalej</button>
  `;
  openOverlay();
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  KARIERY
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function openComputerMenu(){
  // v1.8.70: defensywny call â€” gdyby gracz wĹ‚aĹ›nie awansowaĹ‚ i unlock nie zdÄ…ĹĽyĹ‚ siÄ™ wywoĹ‚aÄ‡ przed otwarciem komputera
  try{ if(typeof checkCareerUnlocks==='function') checkCareerUnlocks(); }catch(e){}
  const yt=G.careers.youtuber, gm=G.careers.gamer;
  const totalXP=G.xp+(G.level-1)*CFG.xpPerLevel;
  // v1.8.71: lock messages zawierajÄ… obie Ĺ›cieĹĽki unlock (prĂłg automatyczny + drzewko umiejÄ™tnoĹ›ci)
  const ytLockTxt=yt.unlocked?'':`đź”’ Wymaga ${yt.xpReq} XP (masz ${totalXP}) lub punktu w drzewku đź“ş YouTuber`;
  const gmLockTxt=gm.unlocked?'':`đź”’ Wymaga poziomu 2 (jesteĹ› lvl ${G.level}) lub punktu w drzewku đźŽ® Gamer`;
  // Home Studio â€” dostÄ™pne TYLKO w apartamentach (nie w pro studio gdzie jest DAW)
  const inApartment=['mieszkanie','mieszkanie_premium','mieszkanie_lux'].includes(currentRoom);
  const homeStudioCard=inApartment?renderHomeStudioCard():'';
  document.getElementById('ov-content').innerHTML=`
    <h2>đź’» Komputer</h2>
    <p class="sub">Wybierz, czym chcesz siÄ™ zajÄ…Ä‡ przy biurku.</p>
    <div class="cards">
      <div class="card">
        <h3>đź“ş YouTube</h3>
        <p>Nagrywaj, montuj i publikuj filmy. Zarabiaj na AdSense i kolaboracjach.</p>
        <div class="cost">${yt.unlocked?`SubĂłw: ${G.yt.subs.toLocaleString('pl')} Â· FilmĂłw: ${G.yt.videos.length}`:ytLockTxt}</div>
        <button class="dbtn" ${yt.unlocked?'':'disabled'} onclick="closeOverlay();setTimeout(()=>{renderYTOverlay();openOverlay();},50)">OtwĂłrz YouTube</button>
      </div>
      <div class="card">
        <h3>đźŽ® Gaming &amp; Stream</h3>
        <p>Graj w turniejach, awansuj rangÄ™ i streamuj rozgrywkÄ™ dla widzĂłw.</p>
        <div class="cost">${gm.unlocked?`Ranga: ${gm.rank} Â· TurniejĂłw: ${gm.tourneysWon}`:gmLockTxt}</div>
        <button class="dbtn" ${gm.unlocked?'':'disabled'} onclick="closeOverlay();setTimeout(()=>{renderGamerOverlay();openOverlay();},50)">OtwĂłrz Gaming</button>
      </div>
      ${homeStudioCard}
    </div>
    <button class="cbtn" style="margin-top:14px" onclick="closeOverlay()">â† WrĂłÄ‡</button>
  `;
  openOverlay();
}

// â”€â”€â”€ HOME STUDIO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Uproszczone studio w mieszkaniu â€” niĹĽsza jakoĹ›Ä‡ niĹĽ pro studio.
// Unlock: â‰Ą3 freestyle + posiada mic + Realizacja 1 (raperskie drzewko)
// Quality multiplier per apartament: traphouse 0.30 / basic 0.50 / premium 0.75 / luxury 0.95
// Limit: 1 demo / dzieĹ„
function getHomeStudioReqs(){
  const fs=G.careers?.raper?.freestyles||0;
  const hasMic=!!G.mic;
  const realizacja=getRaperST?.('realizacja')||0;
  return {
    freestyles:fs, freestylesNeed:3, freestylesOK:fs>=3,
    hasMic, micName:G.mic?.name||'brak',
    realizacja, realizacjaNeed:1, realizacjaOK:realizacja>=1,
    allOK:fs>=3 && hasMic && realizacja>=1,
  };
}
function getApartmentDemoMult(){
  /* v2.1.165: Mansion 1.00 = peĹ‚na jakoĹ›Ä‡ (prywatne studio â€” desc obietnica zaimplementowana). */
  const map={traphouse:0.30, basic:0.50, premium:0.75, luxury:0.95, mansion:1.00};
  let m=map[G.apartment]||0.30;
  // v1.8.99: KÄ…cik studyjny â€” +15% jakoĹ›Ä‡ nagraĹ„ w mieszkaniu (Home Studio) â€” wczeĹ›niej fake
  if(G.aptPurchases?.furniture?.includes('studio_corner')) m*=1.15;
  return Math.min(1.0,m);
}
function renderHomeStudioCard(){
  const r=getHomeStudioReqs();
  const mult=getApartmentDemoMult();
  const aptName={traphouse:'Traphouse',basic:'Basic',premium:'Premium',luxury:'Penthouse',mansion:'Rezydencja'}[G.apartment]||'Traphouse';
  const usedToday=(G._lastDemoDay===G.day);
  if(!r.allOK){
    const reqs=[
      `${r.freestylesOK?'âś…':'âťŚ'} 3+ freestyle uliczne wykonane (masz ${r.freestyles}/3)`,
      `${r.hasMic?'âś…':'âťŚ'} Mikrofon (${r.micName}) â€” kup w Sklepie Muzycznym`,
      `${r.realizacjaOK?'âś…':'âťŚ'} Realizacja â‰Ą1 w drzewku rapera`,
    ].join('<br>');
    /* v2.1.95 Amper: jaĹ›niejsze opisy â€” "Ă—30% jakoĹ›ci" myli (brzmi jak boost), zmiana na "jakoĹ›Ä‡: 30% peĹ‚nego studio". */
    return `<div class="card" style="border-color:#5a3a1a">
      <h3>đźŽ™ Home Studio <span style="font-size:10px;color:#778">(zablokowane)</span></h3>
      <p style="font-size:11px;line-height:1.6">${reqs}</p>
      <div class="cost" style="color:#778">Mieszkanie: ${aptName} (jakoĹ›Ä‡ ${(mult*100).toFixed(0)}% peĹ‚nego studio)</div>
      <button class="dbtn" disabled>đź”’ Wymagania</button>
    </div>`;
  }
  return `<div class="card" style="border-color:#3a2a5a">
    <h3>đźŽ™ Home Studio <span style="font-size:10px;color:#9b59b6">${aptName}</span></h3>
    <p>Nagraj demo we wĹ‚asnym pokoju. JakoĹ›Ä‡: <strong style="color:#9b59b6">${(mult*100).toFixed(0)}%</strong> tego, co daĹ‚oby pro studio.</p>
    <p style="font-size:11px;color:#ff8c44;margin:4px 0">đźź  Demo trafia na <strong>SoundCloud</strong> â€” Ĺ‚atwy start, ale maĹ‚e zarobki (30% streamĂłw, 20% royalty vs DAW). PeĹ‚ny pipeline w studio = Spotify/Tidal/Apple Music.</p>
    <div class="cost">${usedToday?'Wykorzystano dzisiaj â€” wrĂłÄ‡ jutro':'Energia: -10 Â· Czas: ~2h gry'}</div>
    <button class="dbtn" ${usedToday||G.energy<10?'disabled':''} onclick="closeOverlay();setTimeout(()=>recordHomeDemo(),50)">${usedToday?'âŹł Jutro':'đźź  Nagraj demo â†’ SoundCloud'}</button>
  </div>`;
}
window.recordHomeDemo=()=>{
  const r=getHomeStudioReqs();
  if(!r.allOK){showMsg('đź”’ Wymagania niespeĹ‚nione','r');return;}
  if(G._lastDemoDay===G.day){showMsg('đźŽ™ Demo juĹĽ dziĹ› nagrane â€” wrĂłÄ‡ jutro','r');return;}
  if(G.energy<10){showMsg('âšˇ Za maĹ‚o energii (potrzeba 10)','r');return;}
  const mult=getApartmentDemoMult();
  const baseQ=Math.round(rnd(35,60)*mult); // bazowa jakoĹ›Ä‡ losowa, mnoĹĽona przez aptMult
  const finalQ=clamp(baseQ,8,90);
  const trackNum=(G.studioTracks||[]).length+1;
  const name=`[DEMO] Singiel #${trackNum}`;
  const streams=Math.floor((20+G.followers*0.2)*(finalQ/100+0.2)*rnd(80,120)/100);
  const royalties=Math.floor(streams*0.003*(G.distributor?G.distributor.royaltyPct/100:0.8)); /* v1.9.10: spĂłjnoĹ›Ä‡ z innymi defaults (byĹ‚o 0.6) */
  G.studioTracks=G.studioTracks||[];
  /* v2.1.179: home demo trafia na SoundCloud (nie Spotify). User feedback: "SC Ĺ‚atwiej dostÄ™pny w early game, gracz moĹĽe wrzucaÄ‡ tracki z traphouse". Streams/royalty 5Ă— mniejsze niĹĽ Spotify (SC = platforma startowa). */
  G.studioTracks.push({name,quality:finalQ,streams:Math.floor(streams*0.3),royalties:Math.floor(royalties*0.2),releaseDay:G.day,genre:'demo',isDemo:true,platform:'soundcloud'});
  /* v2.1.0: Crew challenge â€” record_tracks progress (demo) */
  if(G.playerCrew && typeof window._crewAddProgress==='function'){try{window._crewAddProgress('record_tracks',1);}catch(e){}}
  G.soundcloud=G.soundcloud||{listeners:0,streams:0,royalties:0,tracksUploaded:0};
  /* Demo na SoundCloud â€” 30% streams vs peĹ‚ny SC release, 20% royalties */
  const _scStreams=Math.floor(streams*0.3);
  const _scRoy=Math.floor(royalties*0.2);
  G.soundcloud.listeners+=Math.floor(_scStreams*0.08);
  G.soundcloud.streams+=_scStreams;
  G.soundcloud.royalties+=_scRoy;
  G.soundcloud.tracksUploaded=(G.soundcloud.tracksUploaded||0)+1;
  G.careers.raper.tracks=(G.careers.raper.tracks||0)+1;
  // v1.8.48: cinematic dla pierwszego tracku w karierze
  if(G.careers.raper.tracks===1 && typeof showMilestoneCinematic==='function'){
    showMilestoneCinematic({emoji:'đźŽµ',title:'PIERWSZY SINGIEL',subtitle:name,tagline:'Twoja muzyka trafia do uszu sĹ‚uchaczy!',accentColor:'#9b59b6',accent2:'#e91e8c',duration:4000});
  }
  const fans=Math.floor(streams*0.01);
  if(typeof G.fans!=='number') G.fans=0;G.followers+=fans;
  /* v2.1.123: Wave 3 K33 â€” demo release fame addFame Prestige aware */
  if(typeof addFame==='function') addFame(1); else G.fame=clamp((G.fame||0)+1,0,500);
  /* v2.1.96: Prestige moneyMult przez earn() (Demo recording bypass fix) */
  if(typeof earn==='function') earn(royalties,false); else {G.money+=royalties;G.totalEarned=(G.totalEarned||0)+royalties;}
  G.energy=clampStat('energy', G.energy-10);
  addRaperXP(5);addXP(15);
  G._lastDemoDay=G.day;
  gameMin=Math.min(1439,gameMin+120); // zuĹĽywa 2h gry
  /* v2.1.179: showMsg uĹĽywa rzeczywistych wartoĹ›ci SC (0.3Ă— streams, 0.2Ă— royalties) zamiast pre-mult */
  showMsg(`đźŽ™ Demo wrzucone na SoundCloud! JakoĹ›Ä‡: ${finalQ}%, ${_scStreams.toLocaleString('pl')} streamĂłw, +${_scRoy} zĹ‚, +${fans} fanĂłw`);
  addNotif(`đźź  [DEMO] SoundCloud â€” ${_scStreams.toLocaleString('pl')} streamĂłw`);
  if(typeof checkStoryline==='function')checkStoryline();
  updateHUD();
};
