      const _rep=rnd(3,5);G.stress=clamp(G.stress+5,0,100);G.streetRep=clamp((G.streetRep||0)+_rep,0,100);
      notify(`đźšŞ SÄ…siad zapukaĹ‚ â€” szybka pogaduszka o muzyce. +5 nastrĂłj, +${_rep} reputacji.`);
    } else {
