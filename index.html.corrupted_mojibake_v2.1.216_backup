    {cost:3,label:'Profesjonalna realizacja',desc:'Zlecenia od znanych artystĂłw, zarobek 800-2 000 zĹ‚'},
    {cost:4,label:'ZĹ‚ote ucho',desc:'Klienci wracajÄ…, staĹ‚e zlecenia co kilka dni'},
    {cost:5,label:'Legenda realizacji',desc:'Zarobek 5 000-15 000 zĹ‚ za sesjÄ™',effect:'real_top'},
  ]},
  mikser:{label:'Mikser',emoji:'đźŽšď¸Ź',requires:{realizacja:2},needsItem:'hasDaw',needsItemLabel:'DAW (komputer)',nodes:[
    {cost:1,label:'Podstawowy mix',desc:'+10% jakoĹ›ci wĹ‚asnych trackĂłw',effect:'mix_quality'},
    {cost:2,label:'Balans czÄ™stotliwoĹ›ci',desc:'+20% streamĂłw z trackĂłw'},
    {cost:3,label:'Miksowanie dla innych',desc:'+9 punktĂłw jakoĹ›ci do nagraĹ„ (sumuje siÄ™ z realizacjÄ…)'},
    {cost:4,label:'Signature sound',desc:'+25% fanĂłw z kaĹĽdego wydanego tracku',effect:'mix_fans'},
    {cost:5,label:'World class mix',desc:'Odblokowanie masteringu dla labelĂłw',effect:'mix_master'},
  ]},
  autopromocja:{label:'Autopromocja',emoji:'đź“±',requires:null,nodes:[
