function _phRenderTile(em,label,bg,glow,fn,isFolder,preview){
  const iconHtml=isFolder
    ? `<div class="ai">${preview.slice(0,4).map(e=>`<span>${e}</span>`).join('')}</div>`
    : `<div class="ai">${em}</div>`;
  const wrapStyle=isFolder?'':`background:${bg};border:1px solid ${glow}22`;
  return `<div class="ph-app${isFolder?' is-folder':''}" style="--app-glow:${glow}" onclick="${fn}">
    <div class="ai-wrap"${wrapStyle?` style="${wrapStyle}"`:''}>${iconHtml}</div>
    <div class="an">${label}</div>
  </div>`;
}
function renderPhoneHome(){
  document.getElementById('ph-title').textContent='đź“± Telefon';
  const folders=_getPhoneFolders();
  // Top-level shortcuts â€” wybrane apki widoczne bezpoĹ›rednio (najczÄ™Ĺ›ciej uĹĽywane / istotne)
  const _smsUnread=(G.sms&&G.sms.unread)||0;
  const shortcuts=[
    _phApp('đź””',`Powiadom. (${G.notifications.length})`,'#12100a','#f39c12',"renderPhoneNotifs()"),
    _phApp('đź’¬',`WiadomoĹ›ci${_smsUnread>0?' ('+_smsUnread+')':''}`,'#0a1525','#3498db',"renderPhoneSMS()"),
    _phApp('đźŚŤ','Tablica wynikĂłw','#0a1015','#7ec8e3',"renderPhoneLeaderboard()"),
    _phApp('đź‘Ą',`Znajomi${(G.friends||[]).length>0?' ('+G.friends.length+')':''}`,'#15102a','#9b59b6',"renderPhoneFriends()"),
    _phApp('đźŹ†',`Crew${G.playerCrew?(' Â· '+(G.playerCrew.name||'')):''}`,'#2a1a05','#f1c40f',"renderPhoneCrew()"),
  ];
  let html='';
  // Foldery
  for(const [id,f] of Object.entries(folders)){
    html+=_phRenderTile(f.em,f.label,'','#7ec8e3',`renderPhoneFolder('${id}')`,true,f.preview);
  }
  // Shortcuts
  for(const a of shortcuts){
    html+=_phRenderTile(a.em,a.label,a.bg,a.glow,a.fn,false,null);
  }
  document.getElementById('ph-content').innerHTML=`<div class="ph-apps">${html}</div>`;
}
function renderPhoneFolder(id){
  const folders=_getPhoneFolders();
  const f=folders[id];
  if(!f){renderPhoneHome();return;}
  document.getElementById('ph-title').textContent=`${f.em} ${f.label}`;
  const apps=f.apps.map(a=>_phRenderTile(a.em,a.label,a.bg,a.glow,a.fn,false,null)).join('');
  document.getElementById('ph-content').innerHTML=`
    <button class="ph-back-btn" onclick="renderPhoneHome()">â† Telefon</button>
    <div class="ph-folder-title">${f.em} ${f.label} (${f.apps.length})</div>
    <div class="ph-apps">${apps}</div>`;
}

/* v2.1.44 [Amper]: Przycisk â–¶ Spotify â€” promocja tracku (zamiast dummy notify "Odtwarzanie..."). Max 5 klikniÄ™Ä‡/dzieĹ„. */
window._spotifyPlayClick=function(){
  const tracks=(G.studioTracks||[]).slice().sort((a,b)=>(b.streams||0)-(a.streams||0));
  const top=tracks[0];
  if(!top){if(typeof notify==='function')notify('đźŽµ Najpierw nagraj track!');return;}
  if(G._spotPromoDay!==G.day){G._spotPromoDay=G.day;G._spotPromoCount=0;}
  if((G._spotPromoCount||0)>=5){
    if(typeof notify==='function')notify('đźŽµ Dzisiaj juĹĽ promowaĹ‚eĹ› â€” wrĂłÄ‡ jutro');
    return;
  }
  G._spotPromoCount=(G._spotPromoCount||0)+1;
  const gain=rnd(1,5);
  top.streams=(top.streams||0)+gain;
  if(G.spotify) G.spotify.streams=(G.spotify.streams||0)+gain;
  if(typeof notify==='function')notify(`đźŽµ SĹ‚uchasz "${top.name}" Â· +${gain} streamĂłw (${G._spotPromoCount}/5 dzisiaj)`);
  if(typeof renderPhoneApp==='function')renderPhoneApp('spotify');
};

function renderPhoneApp(app){
  const ph=document.getElementById('ph-content');
  const titles={spotify:'đźŽµ Spotify',tidal:'đźŚŠ Tidal',youtube:'đź“ş YouTube',instagram:'đź“¸ Instagram',twitter:'đź¦ Twitter',bank:'đźŹ¦ Bank',bills:'đź’¸ Rachunki',merch:'đź§˘ Merch',label:'đźŽĽ WytwĂłrnia'};
  document.getElementById('ph-title').textContent=titles[app]||app;

  if(app==='spotify'){
    const tracks=(G.studioTracks||[]).slice().sort((a,b)=>(b.streams||0)-(a.streams||0));
    const topTrack=tracks[0];
    const totalStreams=tracks.reduce((s,t)=>s+(t.streams||0),0);
    // F5.3: System weryfikacji artysty (3-stage)
    if(!G.spotify) G.spotify={listeners:0,streams:0,royalties:0};
    const releasesCount = (G.studioTracks||[]).filter(t=>!t.isDemo).length;
    const listeners = G.spotify.listeners||0;
    // Auto-grant: po 3 dniach od wniosku
    if(G.spotify.verifyAppliedDay && (G.day - G.spotify.verifyAppliedDay) >= 3 && !G.spotify.verified){
      G.spotify.verified = true;
      if(typeof addNotif==='function') addNotif('đźŽ‰ Profil Spotify zweryfikowany! âś“');
      if(typeof showMilestoneCinematic==='function' && !G._spotifyVerifyCinematic){
        G._spotifyVerifyCinematic = true;
        showMilestoneCinematic({
          emoji:'âś“', title:'ZWERYFIKOWANY ARTYSTA',
          subtitle:'TwĂłj profil Spotify ma teraz oficjalnÄ… odznakÄ™',
          tagline:'WyrĂłĹĽniasz siÄ™ wĹ›rĂłd milionĂłw twĂłrcĂłw',
          accentColor:'#1ed760', accent2:'#1aa84a', duration:5000
        });
      }
    }
    const verified = G.spotify.verified === true;
    const appliedDay = G.spotify.verifyAppliedDay;
    const daysWaited = appliedDay ? (G.day - appliedDay) : 0;
    const inProcess = appliedDay && daysWaited < 3 && !verified;
    const canApply = releasesCount > 0 && listeners >= 500 && !verified && !inProcess;
    let verifyHTML;
    if(verified){
      verifyHTML = `<div style="font-size:11px;color:#1ed760;font-weight:700">Artysta zweryfikowany âś“</div>`;
    } else if(inProcess){
      const left = Math.max(1, 3 - daysWaited);
      verifyHTML = `<div style="font-size:11px;color:#f1c40f">âŹł Weryfikacja w toku â€” ${left} ${left===1?'dzieĹ„':'dni'} do koĹ„ca</div>`;
    } else if(canApply){
      verifyHTML = `<button onclick="applyVerification()" style="background:linear-gradient(135deg,#1ed760,#1aa84a);color:#000;border:none;padding:4px 10px;border-radius:10px;font-weight:700;cursor:pointer;font-size:11px">ZĹ‚ĂłĹĽ wniosek o weryfikacjÄ™</button>`;
    } else {
      const needRel = releasesCount > 0 ? 'âś“' : 'âś—';
      const needLis = listeners >= 500 ? 'âś“ 500+ sĹ‚uchaczy' : `${listeners}/500 sĹ‚uchaczy`;
      verifyHTML = `<div style="font-size:10px;color:#888">Niezweryfikowany<br>${needRel} Wydany utwĂłr Â· ${needLis}</div>`;
    }
    // Cover gradient per gatunek
    /* v2.1.168: 4 nowe gatunki â€” unique cover gradients (Spotify-style) */
    const genreCol={trap:['#3a0a4a','#1a0a2a'],boombap:['#3a2a0a','#1a1505'],drill:['#2a0a0a','#1a0505'],reggaeton:['#0a3a2a','#051a15'],jerk:['#0a2a3a','#051a25'],afrobeat:['#3a2505','#1a1005'],electronic:['#0a2a3a','#051a25'],rnb:['#3a0a2a','#1a0515'],jazz_fusion:['#2a1a3a','#15052a'],demo:['#1a1a1a','#0a0a0a']};
    const coverHTML=(t)=>{
      const c=genreCol[t.genre]||genreCol.trap;
      const em=t.isDemo?'đźŽ™':(t.genre==='drill'?'đź”«':t.genre==='reggaeton'?'đźŚ´':t.genre==='boombap'?'đźĄ':t.genre==='afrobeat'?'đźĄ':t.genre==='electronic'?'đźŽą':t.genre==='rnb'?'đźŽ·':t.genre==='jazz_fusion'?'đźŽş':'đźŽµ');
      return `<div style="width:48px;height:48px;background:linear-gradient(135deg,${c[0]},${c[1]});border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;box-shadow:0 2px 6px rgba(0,0,0,.5)">${em}</div>`;
    };
    // Top miasta â€” losowe ale stabilne na save (seed = liczba trackĂłw)
    const cities=['Warszawa','KrakĂłw','ĹĂłdĹş','WrocĹ‚aw','PoznaĹ„','GdaĹ„sk','Lublin','Katowice'];
    const topCities=cities.slice(0,3).map((c,i)=>({name:c,pct:[42,28,18][i]}));
    ph.innerHTML=`<div class="ph-screen">
      <!-- Header â€” Artist for Spotify -->
      <div style="background:linear-gradient(135deg,#0a2a14,#0a1a0a);border-radius:10px;padding:14px;margin-bottom:10px;border:1px solid #1db95440">
        <div style="font-size:11px;color:#1db954;font-weight:700;letter-spacing:1.5px;margin-bottom:6px">SPOTIFY FOR ARTISTS</div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
          <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#1db954,#0d6633);display:flex;align-items:center;justify-content:center;font-size:24px">đźŽ¤</div>
          <div>
            <div style="font-size:16px;color:#fff;font-weight:900">${G.name}</div>
            ${verifyHTML}
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:12px">
          <div><div style="color:#778">SĹ‚uchacze/m-c</div><div style="color:#fff;font-weight:700">${G.spotify.listeners.toLocaleString('pl')}</div></div>
          <div><div style="color:#778">Odtworzenia</div><div style="color:#fff;font-weight:700">${G.spotify.streams.toLocaleString('pl')}</div></div>
          <div><div style="color:#778">Tracki</div><div style="color:#fff;font-weight:700">${tracks.length}</div></div>
          <div><div style="color:#778">Tantiemy</div><div style="color:#1db954;font-weight:700">${G.spotify.royalties} zĹ‚</div></div>
        </div>
      </div>
      ${G.spotify.royalties>0?`<button class="bbtn" style="margin-bottom:10px" onclick="collectRoyalties('spotify')">đź’° Zbierz tantiemy (${G.spotify.royalties} zĹ‚)</button>`:''}
      ${topTrack?`<!-- Now Playing â€” top track -->
      <div style="background:linear-gradient(135deg,#0a1a0a,#0a0a0a);border-radius:10px;padding:10px;margin-bottom:10px;border:1px solid #1a2a1a">
        <div style="font-size:10px;color:#1db954;letter-spacing:1px;margin-bottom:6px">â–¶ NAJPOPULARNIEJSZY</div>
        <div style="display:flex;gap:10px;align-items:center">
          ${coverHTML(topTrack)}
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;color:#fff;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${topTrack.name}</div>
            <div style="font-size:11px;color:#778">${(topTrack.streams||0).toLocaleString('pl')} odtworzeĹ„ Â· jakoĹ›Ä‡ ${topTrack.quality||0}%</div>
          </div>
          <button onclick="window._spotifyPlayClick&&window._spotifyPlayClick()" style="background:#1db954;border:none;color:#000;width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:14px;font-weight:900" title="Promuj track (max 5/dzieĹ„)">â–¶</button>
        </div>
      </div>`:''}
      ${tracks.length>0?`<!-- Track list -->
      <div style="font-size:11px;color:#1db954;letter-spacing:1px;margin-bottom:6px">đź“€ TWOJA DYSKOGRAFIA</div>
      <div style="display:flex;flex-direction:column;gap:5px;margin-bottom:10px">
        ${tracks.slice(0,8).map((t,i)=>`<div style="background:#0a0a0a;border-radius:6px;padding:6px 8px;display:flex;gap:8px;align-items:center;border:1px solid #1a1a1a">
          <span style="font-size:10px;color:#556;min-width:14px">#${i+1}</span>
          ${coverHTML(t)}
          <div style="flex:1;min-width:0">
            <div style="font-size:12px;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.name}</div>
            <div style="font-size:10px;color:#778">${(t.streams||0).toLocaleString('pl')} â–¶ Â· Dz.${t.releaseDay||'?'}</div>
          </div>
        </div>`).join('')}
        ${tracks.length>8?`<div style="font-size:10px;color:#556;text-align:center;padding:4px">+${tracks.length-8} wiÄ™cej trackĂłw</div>`:''}
      </div>`:`<div style="background:#0a0a0a;border:1px dashed #1a2a1a;border-radius:8px;padding:14px;text-align:center;color:#556;font-size:12px;margin-bottom:10px">đź“€ Brak trackĂłw. IdĹş do studia i nagraj swĂłj pierwszy singiel!</div>`}
      ${tracks.length>0?`<!-- Top miasta -->
      <div style="background:#0a0a0a;border-radius:8px;padding:10px;border:1px solid #1a1a1a">
        <div style="font-size:10px;color:#1db954;letter-spacing:1px;margin-bottom:6px">đźŚŤ TOP MIASTA SĹUCHACZY</div>
        ${topCities.map(c=>`<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;font-size:11px">
          <span style="min-width:80px;color:#aaa">${c.name}</span>
          <div style="flex:1;height:6px;background:#1a1a1a;border-radius:3px;overflow:hidden">
            <div style="width:${c.pct}%;height:100%;background:linear-gradient(90deg,#1db954,#27ae60)"></div>
          </div>
          <span style="color:#1db954;font-weight:700;min-width:30px;text-align:right">${c.pct}%</span>
        </div>`).join('')}
      </div>`:''}
    </div>`;
  } else if(app==='soundcloud'){
    /* v2.1.78 Amper: panel SoundCloud w telefonie. SpĂłjnoĹ›Ä‡ z featurem z v2.1.70 (przycisk w studio) â€” gracz musi widzieÄ‡ efekty platformy startowej. */
    if(!G.soundcloud) G.soundcloud={listeners:0,streams:0,royalties:0,tracksUploaded:0};
    const scTracks=(G.studioTracks||[]).filter(t=>t.platform==='soundcloud').sort((a,b)=>(b.streams||0)-(a.streams||0));
    ph.innerHTML=`<div class="ph-screen">
      <div style="background:linear-gradient(135deg,#1a0a05,#0a0502);border-radius:10px;padding:14px;margin-bottom:10px;border:1px solid #ff550040">
