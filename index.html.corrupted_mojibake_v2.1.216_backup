  const pts={1:15,2:25,3:40};
  document.getElementById('shop-res').textContent=`đź’» ${names[tier]} â€” DAW aktywny! +${pts[tier]} pkt jakoĹ›ci nagraĹ„`;
  /* v2.1.120: Wave 4 S32 â€” Studio purchase cinematic audio (wczeĹ›niej silent). */
  if(typeof sfxCash==='function') try{sfxCash();setTimeout(()=>{if(typeof sfxSparkle==='function')sfxSparkle();},300);}catch(_){}
