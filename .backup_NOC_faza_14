// ═══ RADIO_TIERS (~4078) ═══
const RADIO_TIERS=[
  {name:'Street Slot',req:{spotify:500,tracks:1},royPerPlay:0.6,maxPlays:200,desc:'Nocny slot dla nowych artystów',slots:2},
  {name:'Prime Time',req:{spotify:2000,tracks:3,ytSubs:500},royPerPlay:1.2,maxPlays:500,desc:'Wieczorny prime time — 18:00-22:00',slots:1},
  {name:'Hit Parade',req:{spotify:8000,tracks:5,ytSubs:2000,streetRep:50},royPerPlay:2.5,maxPlays:1200,desc:'Największy zasięg w mieście',slots:1},
];
function renderRadioStation(){
  const sp=G.spotify.listeners||0,tracks=G.careers.beatmaker?.tracks||0,ytSubs=G.yt?.subs||0,rep=G.streetRep||0;
  const tiersHtml=RADIO_TIERS.map((t,i)=>{
    const canSend=sp>=t.req.spotify&&tracks>=(t.req.tracks||0)&&(ytSubs>=(t.req.ytSubs||0))&&(rep>=(t.req.streetRep||0))&&G.careers.beatmaker?.beats>0;
    const locked=!canSend;
    const reqItems=[
      `🎵 Spotify: ${sp.toLocaleString('pl')}/${t.req.spotify.toLocaleString('pl')} słuchaczy`,
      `🎶 Tracki beatmakera: ${tracks}/${t.req.tracks}`,
      ...(t.req.ytSubs?[`📺 YouTube: ${ytSubs}/${t.req.ytSubs} sub`]:[]),
      ...(t.req.streetRep?[`🏆 Uliczna rep: ${rep}/${t.req.streetRep}`]:[]),
      `🎛️ Bit w inwentarzu: ${G.careers.beatmaker?.beats||0}`,
    ];
    const met=r=>r.split('/').length===2&&parseInt(r.split('/')[0].replace(/\D/g,''))>=parseInt(r.split('/')[1].replace(/\D/g,''));
    return `<div class="card" style="border-color:${canSend?'#e74c3c':'#1a1a2a'}">
      <h3>📻 ${t.name}</h3>
      <p style="color:#999;font-size:12px">${t.desc}</p>
      <div style="font-size:12px;color:#667;margin:8px 0">${reqItems.map(r=>`<div style="color:${r.includes('Bit')?G.careers.beatmaker?.beats>0?'#27ae60':'#e74c3c':r.split('/').length===2&&parseInt(r.replace(/.*:\s*/,'').split('/')[0].replace(/\D/g,''))>=parseInt(r.replace(/.*:\s*/,'').split('/')[1].replace(/\D/g,''))?'#27ae60':'#e74c3c'}">● ${r}</div>`).join('')}</div>
      <div style="font-size:11px;color:#f1c40f">💰 ${t.royPerPlay} zł/odtw. · maks. ${t.maxPlays} odtworzeń</div>
      <button class="dbtn" style="margin-top:8px" ${locked?'disabled':''} onclick="sendBeatToRadio(${i})">📤 Wyślij bit</button>
    </div>`;
  }).join('');
  document.getElementById('ov-content').innerHTML=`
    <h2>📻 Radio Street FM</h2>
    <p class="sub">Lokalne radio — wyślij utwór i zarabiaj na odtworzeniach. Każdy slot ma inne wymagania.</p>
    <div class="statrow">
      <div class="sbox"><div class="l">Bity na antenie</div><div class="v">${G.radio.beats}</div></div>
      <div class="sbox"><div class="l">Odtworzenia</div><div class="v">${G.radio.plays.toLocaleString('pl')}</div></div>
      <div class="sbox"><div class="l">Tantiemy</div><div class="v">${G.radio.royalties} zł</div></div>
      <div class="sbox"><div class="l">Spotify</div><div class="v">${sp.toLocaleString('pl')}</div></div>
    </div>
    <div style="background:#0a0a14;border:1px solid #2a0a0a;border-radius:8px;padding:14px;margin-bottom:14px">
      <div style="font-size:13px;color:#e74c3c;font-weight:700;margin-bottom:6px">📻 Na antenie:</div>
      <div style="font-size:15px;color:#fff">${G.radio.beats>0?(()=>{
        /* v2.1.223 BUG #29 fix: PL grammar utwór/utwory/utworów dla 1/2-4/5+ */
        const _uN=G.radio.beats;
        const _uW=_uN===1?'utwór':(_uN%10>=2&&_uN%10<=4&&(_uN%100<10||_uN%100>=20))?'utwory':'utworów';
        return `🎵 ${_uN} ${_uW} — ${G.radio.plays.toLocaleString('pl')} odtworzeń`;
      })():'(Żaden utwór nie jest na antenie)'}</div>
    </div>
    <div class="cards">${tiersHtml}</div>
    <div style="margin-top:12px">
      <button class="dbtn" ${G.radio.royalties<=0?'disabled':''} onclick="collectRadioRoyalties()">💰 Zbierz tantiemy: ${G.radio.royalties} zł</button>
    </div>
    <button class="cbtn" onclick="closeOverlay()">← Wróć</button>
  `;
}
window.sendBeatToRadio=(tierIdx)=>{
  const t=RADIO_TIERS[tierIdx||0];
  if(!t||G.careers.beatmaker?.beats<=0) return;
  const sp=G.spotify.listeners||0,tracks=G.careers.beatmaker?.tracks||0,ytSubs=G.yt?.subs||0,rep=G.streetRep||0;
  if(sp<t.req.spotify||tracks<(t.req.tracks||0)||(t.req.ytSubs&&ytSubs<t.req.ytSubs)||(t.req.streetRep&&rep<t.req.streetRep)){
    notify('❌ Nie spełniasz wymogów dla tego slotu!');return;
  }
  G.careers.beatmaker.beats--;G.radio.beats++;
  /* v2.1.176: zapisz najwyższy royPerPlay z dotychczasowych sendów — daily royalty użyje tieru */
  G.radio.tierRate=Math.max(G.radio.tierRate||0,t.royPerPlay);
  notify(`📻 Bit wysłany do "${t.name}"! ${t.royPerPlay} zł/odtworzenie`);renderRadioStation();
};
window.collectRadioRoyalties=()=>{
  if(G.radio.royalties<=0) return;
  /* v2.1.96: Prestige moneyMult przez earn() (collectRadioRoyalties bypass fix) */
  const _amount=G.radio.royalties;
  if(typeof earn==='function') earn(_amount,false); else {G.money+=_amount;G.totalEarned=(G.totalEarned||0)+_amount;}
  notify('💰 Zebrano '+_amount+' zł tantiem z radia!');
  G.radio.royalties=0;renderRadioStation();
};

// Zakupy — funkcje
window.buyItem=(item,price)=>{
  /* v2.1.201 [Amper]: Street rep discount dla sklepów ulicznych */
  const _repDisc=(typeof window.getStreetRepShopDiscount==='function')?window.getStreetRepShopDiscount():0;
  /* v2.1.218 [Amper] BALANS: Black Friday holiday -20% dla sklepów (obietnica "Wszystkie sklepy -20%" niedokończona w buyItem). */
  const _holidayMult=(typeof holidayBonus==='function')?holidayBonus('shop'):1; // 0.8 podczas BF
  const finalPrice=Math.floor(price*(1-_repDisc)*_holidayMult);
  if(G.money<finalPrice){document.getElementById('shop-res').textContent='Za mało pieniędzy!';return;}
  G.money-=finalPrice;
  price=finalPrice;
  if(item==='pizza'){G.hunger=eatFood(60);G.energy=clampStat('energy', G.energy+5);progressQuest('eat');document.getElementById('shop-res').textContent='🍕 +60 głód, +5 energia';}
  else if(item==='energy'){G.energy=clampStat('energy', G.energy+50);G.hunger=clampStat('hunger', G.hunger-5);document.getElementById('shop-res').textContent='🥤 +50 energia';}
  else if(item==='meal'){G.hunger=eatFood(80);G.energy=clampStat('energy', G.energy+20);progressQuest('eat');document.getElementById('shop-res').textContent='🍱 +80 głód, +20 energia';}
  else if(item==='coffee'){G.energy=clampStat('energy', G.energy+30);G.stress=clamp(G.stress+5,0,100);document.getElementById('shop-res').textContent='☕ +30 energia, +5 nastrój';}
  else if(item==='fruit'){G.hunger=eatFood(20);G.health=clampStat('health', G.health+5);progressQuest('eat');document.getElementById('shop-res').textContent='🍎 +20 głód, +5 zdrowie';}
  else if(item==='vitamins'){G.health=clampStat('health', G.health+15);G.stress=clamp(G.stress+10,0,100);document.getElementById('shop-res').textContent='💊 +15 zdrowie, +10 nastrój';}
};
window.buyCamera=(name,quality,price)=>{
  /* v2.1.51 Amper: kupno dodaje do inwentarza zamiast nadpisywać. Jeśli gracz już ma → tylko aktywuj. */
  if(!Array.isArray(G.camerasOwned)) G.camerasOwned=[];
  const _existing=G.camerasOwned.find(c=>c.name===name);
  if(_existing){
    G.camera=_existing;
    const r=document.getElementById('shop-res');if(r)r.textContent=`📹 ${name} już w inwentarzu — ustawiona jako aktywna.`;
    renderMediaMarkt();return;
  }
  if(G.money<price){const r=document.getElementById('shop-res');if(r)r.textContent='Za mało pieniędzy!';return;}
  G.money-=price;
  const _newCam={name,quality,price,origQuality:quality};
  G.camerasOwned.push(_newCam);
  G.camera=_newCam; /* nowy zakup = aktywny */
  document.getElementById('shop-res').textContent=`📹 Kupiono ${name}! Jakość: ${quality}% (dodano do inwentarza)`;renderMediaMarkt();
};
/* v2.1.51 Amper: setActiveCamera, sellCamera. */
window.setActiveCamera=(name)=>{
  const c=(G.camerasOwned||[]).find(x=>x.name===name);
  if(!c){showMsg('Nie posiadasz tej kamery','r');return;}
  G.camera=c;
  showMsg(`📹 Aktywna kamera: ${c.name} (${c.quality}%)`);
  if(typeof renderMediaMarkt==='function') renderMediaMarkt();
};
window.sellCamera=(name)=>{
  if(!Array.isArray(G.camerasOwned)) return;
  const idx=G.camerasOwned.findIndex(x=>x.name===name);
  if(idx<0) return;
  const c=G.camerasOwned[idx];
  const refund=Math.floor((c.price||0)*0.5);
  /* v2.1.68 Amper: gameConfirm zamiast natywnego confirm. */
  const _doSell=()=>{
    G.camerasOwned.splice(idx,1);
    if(refund>0){G.money+=refund;G.totalEarned=(G.totalEarned||0)+refund;}
    if(G.camera && G.camera.name===name){G.camera=G.camerasOwned[0]||null;}
    showMsg(`💰 Sprzedano ${c.name} za ${refund.toLocaleString('pl')} zł (50% ceny)`);
    if(typeof renderMediaMarkt==='function') renderMediaMarkt();
  };
  if(typeof gameConfirm==='function'){gameConfirm(`Sprzedać "${c.name}" za ${refund.toLocaleString('pl')} zł (50% ceny zakupu)?`,_doSell);}
  else _doSell();
};
window.buyPCUpgrade=()=>{
  if(G.money<800) return;G.money-=800;G.hasPCUpgrade=true;
  document.getElementById('shop-res').textContent='💻 PC ulepszony! +15% jakość montażu';renderMediaMarkt();
};
window.buyMic=(name,type,quality,price)=>{
