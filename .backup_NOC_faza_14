    const isFlush=suits.every(s=>s===suits[0]);
    /* Straight: vals sorted (A=0, 2-10=1-9, J=10, Q=11, K=12). A może być low (0) lub high (przy 10-J-Q-K-A vals = [0,9,10,11,12]). */
    let isStraight=false;
    const uv=[...new Set(vals)];
    if(uv.length===5){
