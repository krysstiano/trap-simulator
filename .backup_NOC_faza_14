function generateDailyQuest(){
  /* v2.1.118: Wave 6 N18 — anti repeat (gracz nie dostaje tego samego target 2 dni z rzędu). */
  const _lastTarget=G._lastDailyQuestTarget||null;
  // Filtruj questy dostępne dla aktualnego stanu gracza
  let available=QUEST_POOL.filter(q=>!q.cond||q.cond());
  if(_lastTarget){
    const _filtered=available.filter(q=>q.target!==_lastTarget);
    if(_filtered.length>0) available=_filtered; /* preferuj inne, ale jeśli żadnego — pozwól repeat */
  }
  const pool=available.length>0?available:QUEST_POOL.filter(q=>!q.cond); // fallback do zawsze-dostępnych
  const q=pool[rnd(0,pool.length-1)];
  G.dailyQuest={...q,progress:0,completed:false,day:G.day};
  G._lastDailyQuestTarget=q.target;
  addNotif('❓ Nowe zlecenie dnia: '+q.desc+' (Nagroda: '+q.reward+' zł)');
}

function progressQuest(target){
  // Licznik wykonanych prac dorywczych (storyline #1 — Pierwsza wypłata)
  // Zlicza TYLKO faktyczne ukończenia minigier prac, nie eventów/darowizn.
  if(['pizza','supermarket','carwash','construction','kurier','zmywak'].includes(target)){
    G._jobsCompleted=(G._jobsCompleted||0)+1;
  }
  // Storyline natychmiast — bez czekania na tickDecay (6s) — naprawia opóźnienie zaliczania kroków
  if(typeof checkStoryline==='function') checkStoryline();
  if(!G.dailyQuest||G.dailyQuest.completed) return;
  if(G.dailyQuest.target===target){
    G.dailyQuest.progress++;
    if(G.dailyQuest.progress>=G.dailyQuest.count){
      G.dailyQuest.completed=true;
      G.dailyQuest.claimed=false;
      showMsg(`✅ Zlecenie dnia wykonane! Odbierz nagrodę od Wiktora.`);
      addNotif(`✅ Quest gotowy: "${G.dailyQuest.desc}" — idź do Wiktora!`);
    }
  }
}
function claimQuestReward(){
  if(!G.dailyQuest||!G.dailyQuest.completed||G.dailyQuest.claimed) return;
  const charMult=getCharyzmaBonus(); // F3-FIX-B: hierarchia skill+PU+evo
  const reward=Math.floor(G.dailyQuest.reward*charMult);
