  X.textAlign='left';X.textBaseline='alphabetic';
}

/* v2.1.171: Mansion drawing — luksusowa rezydencja w prestiżowej dzielnicy (obok Biura Nieruchomości).
   Wszystkie zewnętrzne elementy (lawn/hedge/pool/helipad/topiary) usunięte — city version. */
function drawMansion(sx,sy,w,h){
