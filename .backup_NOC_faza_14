      }
    },400);
  };
  // SAFETY CLEANUP: nawet jesli finish() crashuje, force remove po duration+5s
  // To gwarantuje ze element zniknie i ruch sie odblokuje (DOM-first guard)
  setTimeout(()=>{
    if(document.getElementById('milestone-cinematic')===ov){
