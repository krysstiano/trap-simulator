  const newState={};
  list.forEach((e,i)=>{newState[e.user_id]={r:i+1,s:e.score||0};});
  // Sprawdź czy mamy w ogóle jakąś poprzednią migawkę (czy to pierwszy render — wtedy zachowaj zachowanie spokojne)
  const hadPrev=Object.keys(prevState).length>0;
  const deltaFor=(uid)=>{
    const prev=prevState[uid]; const cur=newState[uid];
    if(!cur) return '';
    if(!hadPrev) return ''; // pierwszy render kiedykolwiek — bez badge'y żeby nie spamować NEW dla każdego
