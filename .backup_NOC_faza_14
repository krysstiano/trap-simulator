    status.innerHTML=`⚡ <b style="color:#3498db">${Math.floor(G.energy)}%</b> &nbsp;·&nbsp; 🍔 <b style="color:#27ae60">${Math.floor(G.hunger)}%</b> &nbsp;·&nbsp; ❤️ <b style="color:#e74c3c">${Math.floor(G.health)}%</b>`;
    updateHUD();
    // Auto-wake: energy full OR hunger critical OR max 8 game hours (48 ticks * ~10min = 480min = 8h)
    if(G.energy>=100||G.hunger<=3||(window._sleepTicks||0)>=480){
      wakeUp();
    }
  },200);
}

