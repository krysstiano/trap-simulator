        <button onclick="window._slotsSpin()" ${spinning?'disabled':''} class="${spinning?'':'cta-pulse'}" style="background:${spinning?'linear-gradient(145deg,#2a2a2a,#1a1a1a)':'linear-gradient(145deg,#2eaf5a,#1a7838)'};color:#fff;border:1px solid ${spinning?'#3a3a3a':'rgba(46,175,90,.7)'};padding:12px 32px;font-size:16px;font-weight:700;cursor:${spinning?'progress':'pointer'};border-radius:10px;font-family:inherit;letter-spacing:1px;transition:all .18s">🎰 SPIN</button>
