      if(p.type==='spark'){
        ctx.shadowBlur=6;ctx.shadowColor=p.col;
        ctx.fillStyle=p.col;ctx.globalAlpha=a;
        ctx.beginPath();ctx.arc(p.x,p.y,1.8,0,Math.PI*2);ctx.fill();
        ctx.shadowBlur=0;
      } else if(p.type==='dust'){
        ctx.fillStyle=p.col;ctx.globalAlpha=a*0.6;
        ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();
      } else if(p.type==='drop'){
        ctx.fillStyle=p.col;ctx.globalAlpha=a;
        ctx.fillRect(p.x-1,p.y-p.size,2,p.size*2);
      }
      ctx.globalAlpha=1;
      if(p.life<=0||p.y>H+5)particles.splice(i,1);
