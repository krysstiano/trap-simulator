    // Po finalize (line 10797 _activeCasinoFinalize) wynik jest zaksięgowany, ale nowy spin
    // musi poczekać aż minie pełen czas animacji od POPRZEDNIEGO startu.
    const _now=Date.now();
    if(G._slotsCooldownUntil && _now<G._slotsCooldownUntil){
