window._crewInviteMember=async function(toUserId,toNick){
  if(!G.playerCrew||!G.playerCrew.isLeader) return {ok:false,error:'Tylko leader może zapraszać'};
  if(G.playerCrew.members.length>=(G.playerCrew.max_members||4)) return {ok:false,error:'Crew pełna (max 4)'};
  if(G.playerCrew.members.some(m=>m.userId===toUserId)) return {ok:false,error:toNick+' już jest w crew'};
  /* v2.1.11: KRYTYCZNY FIX. Wcześniej `ignore-duplicates` + UNIQUE (crew_id, to_uuid) constraint w bazie
     powodował że gdy invite już istniał z status='rejected' (lub starsze pending), nowy POST był IGNORE → brak nowego pending.
     Druga osoba NIE WIDZIAŁA zaproszenia bo w bazie pozostał stary rekord z innym statusem.
     Fix: usuń stary rekord PRZED INSERT — wtedy nowy POST stworzy fresh pending invite z aktualnym crew_name/from_nick. */
  await _lbFetch(`crew_invites?crew_id=eq.${G.playerCrew.id}&to_uuid=eq.${toUserId}`,{method:'DELETE'});
  const r=await _lbFetch('crew_invites',{
    method:'POST',
    headers:{'Prefer':'return=minimal'},
    body:JSON.stringify({
      crew_id:G.playerCrew.id, from_uuid:G.playerUUID, to_uuid:toUserId,
      from_nick:G.globalNick||'Leader', crew_name:G.playerCrew.name, status:'pending'
    })
  });
  if(r===null) return {ok:false,error:'Błąd serwera — sprawdź czy crew_invites tabela istnieje w Supabase'};
  return {ok:true};
};
