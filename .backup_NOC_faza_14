      <div style="position:relative;margin:0 auto;width:fit-content"><canvas id="roulette-cv" width="280" height="220" style="display:block;margin:0 auto;background:radial-gradient(ellipse at center,#1a0e0a 0%,#080612 100%);border-radius:12px;border:2px solid rgba(200,165,32,.4);box-shadow:0 0 32px rgba(200,165,32,.25),inset 0 0 18px rgba(200,165,32,.08)"></canvas></div>
      <div id="roulette-result" style="text-align:center;margin:4px 0;font-size:13px;min-height:20px;color:#f1c40f">${lastResult}</div>
      <div style="background:#0a0a14;border:1px solid #2a2a3a;border-radius:8px;padding:8px;margin:4px auto;max-width:540px">
        <div style="text-align:center;margin-bottom:8px;color:#aaa;font-size:12px">Wybierz zakład:</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center">
          ${[
            {t:'red',l:'🔴 Czerwone',b:'#c01020',mul:2},
            {t:'black',l:'⚫ Czarne',b:'#1a1a1a',mul:2},
            {t:'green',l:'🟢 Zero',b:'#27ae60',mul:36},
            {t:'even',l:'Parzyste',b:'#3a3a5a',mul:2},
            {t:'odd',l:'Nieparzyste',b:'#3a3a5a',mul:2},
            {t:'low',l:'1-18',b:'#3a3a5a',mul:2},
            {t:'high',l:'19-36',b:'#3a3a5a',mul:2},
            {t:'col1',l:'1-12',b:'#5a3a08',mul:3},
            {t:'col2',l:'13-24',b:'#5a3a08',mul:3},
            {t:'col3',l:'25-36',b:'#5a3a08',mul:3},
            {t:'number',l:'Liczba',b:'#c8a520',mul:36},
          ].map(b=>`<button onclick="window._rouletteSetType('${b.t}')" ${spinning?'disabled':''} style="background:${betType===b.t?b.b:'#1a1a22'};border:1px solid ${betType===b.t?'#f1c40f':'#3a3a4a'};color:#fff;padding:8px 12px;font-size:12px;cursor:${spinning?'not-allowed':'pointer'};border-radius:6px;font-family:inherit;opacity:${spinning?'0.5':'1'}">${b.l} <span style="opacity:.7">${b.mul}×</span></button>`).join('')}
        </div>
        ${betType==='number'?`
        <div style="background:#0a1525;border:1px solid #2a4a6a;border-radius:8px;padding:10px;margin:10px auto 4px;max-width:400px">
          <div style="color:#aac;font-size:11px;margin-bottom:8px;text-align:center;line-height:1.5">
            Klik na liczbę = dodaj <b style="color:#f1c40f">${bet} 🎟️</b> na tę liczbę.<br>
            Wielokrotny klik = zwiększa stawkę. Możesz obstawiać różne liczby.
          </div>
          <button onclick="window._rouletteAddNumberBet(0)" ${spinning?'disabled':''} style="background:#27ae60;border:${numBetsSum[0]>0?'2px solid #f1c40f':'1px solid #1a5a30'};color:#fff;width:100%;padding:8px 0;font-size:13px;font-weight:700;cursor:${spinning?'not-allowed':'pointer'};border-radius:4px;margin-bottom:4px;position:relative;font-family:inherit">0${numBetsSum[0]>0?`<span style='position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:10px;color:#f1c40f;background:rgba(0,0,0,.5);padding:1px 6px;border-radius:8px'>${numBetsSum[0]} 🎟️</span>`:''}</button>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px">
            ${(()=>{let h='';for(let n=1;n<=36;n++){const isRed=RED_NUMBERS.has(n);const bg=isRed?'#c01020':'#1a1a1a';const sum=numBetsSum[n]||0;const border=sum>0?'2px solid #f1c40f':'1px solid #3a3a4a';h+=`<button onclick="window._rouletteAddNumberBet(${n})" ${spinning?'disabled':''} style="background:${bg};border:${border};color:#fff;padding:6px 0;font-size:12px;font-weight:700;cursor:${spinning?'not-allowed':'pointer'};border-radius:4px;min-height:30px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:inherit">${n}${sum>0?`<div style='font-size:9px;color:#f1c40f;line-height:10px;margin-top:1px'>${sum} 🎟️</div>`:''}</button>`;}return h;})()}
          </div>
        </div>`:''}
      </div>
      <div style="text-align:center;margin:10px 0">
        <label style="color:#aaa">Stawka (żetony): </label>
        <input type="number" id="roulette-bet" value="${bet}" min="10" max="10000" oninput="window._rouletteOnBetInput&&window._rouletteOnBetInput()" style="background:#0a0a14;color:#f1c40f;border:1px solid #2a3a5a;border-radius:4px;padding:6px 10px;width:100px;font-family:inherit"> 🎟️
        <button onclick="window._rouletteAddBet()" ${spinning?'disabled':''} style="background:${spinning?'#3a3a3a':'#3498db'};color:#fff;border:none;padding:8px 16px;font-size:13px;font-weight:bold;cursor:${spinning?'progress':'pointer'};border-radius:8px;margin-left:10px;font-family:inherit">➕ DODAJ ZAKŁAD</button>
        ${lastBets.length>0&&bets.length===0?`<button onclick="window._rouletteRepeatBets()" ${spinning?'disabled':''} style="background:${spinning?'#3a3a3a':'#9b59b6'};color:#fff;border:none;padding:8px 16px;font-size:13px;font-weight:bold;cursor:${spinning?'not-allowed':'pointer'};border-radius:8px;margin-left:10px;font-family:inherit" title="Powtórz zakłady z ostatniego spinu (${lastBets.reduce((s,b)=>s+b.amount,0).toLocaleString('pl')} 🎟️)">🔁 POWTÓRZ ZAKŁADY (${lastBets.length})</button>`:''}
        <button onclick="window._rouletteSpin()" ${spinning||bets.length===0?'disabled':''} style="background:${spinning||bets.length===0?'#3a3a3a':'#27ae60'};color:#fff;border:none;padding:12px 28px;font-size:16px;font-weight:bold;cursor:${spinning||bets.length===0?'not-allowed':'pointer'};border-radius:8px;margin-left:14px;font-family:inherit">🎡 KRĘĆ (${bets.length})</button>
      </div>
      ${bets.length>0?`<div style="background:#0a1525;border:1px solid #1a3a5a;border-radius:8px;padding:8px 12px;margin:4px auto;max-width:540px"><div style="color:#aac;font-size:11px;margin-bottom:4px">Aktualne zakłady (${bets.reduce((s,b)=>s+b.amount,0)} 🎟️ total):</div>${bets.map((b,i)=>`<span style="display:inline-block;background:#1a2535;color:#fff;padding:4px 10px;border-radius:14px;margin:2px;font-size:11px">${b.label||b.type}: ${b.amount} 🎟️ <span onclick="window._rouletteRemoveBet(${i})" style="cursor:pointer;color:#e74c3c;font-weight:700">✕</span></span>`).join('')} <button onclick="window._rouletteClearBets()" style="background:#3a1a1a;color:#e8a;border:none;padding:3px 10px;border-radius:6px;cursor:pointer;font-size:11px;margin-left:6px">Wyczyść</button></div>`:''}
      <div style="text-align:center"><button onclick="window.closeOverlay&&window.closeOverlay()" class="cbtn">← Wyjdź</button></div>
    `;
    _drawWheel(currentRotation, null);
  };
  const _drawWheel=(rotation, ballAngle)=>{
    const cv=document.getElementById('roulette-cv');if(!cv)return;
    const cx=cv.getContext('2d');
    // v1.8.15: canvas 280x220 (kompaktowy, mieści w overlay bez scrollu)
    const W=280, H=220, CX=W/2, CY=H/2;
    cx.clearRect(0,0,W,H);
    cx.fillStyle='#3a2818';cx.fillRect(0,0,W,H);
    cx.fillStyle='#5a3a18';cx.beginPath();cx.arc(CX,CY,100,0,Math.PI*2);cx.fill();
    cx.fillStyle='#7a5028';cx.beginPath();cx.arc(CX,CY,95,0,Math.PI*2);cx.fill();
    for(let i=0;i<37;i++){
      const a1=(i/37)*Math.PI*2+rotation-Math.PI/2;
      const a2=((i+1)/37)*Math.PI*2+rotation-Math.PI/2;
      const num=ROULETTE_ORDER[i];
      cx.fillStyle=num===0?'#27ae60':(RED_NUMBERS.has(num)?'#c01020':'#0a0a0a');
      cx.beginPath();cx.moveTo(CX,CY);cx.arc(CX,CY,90,a1,a2);cx.closePath();cx.fill();
      const ma=(a1+a2)/2;
      cx.save();
      cx.translate(CX+Math.cos(ma)*76,CY+Math.sin(ma)*76);
      cx.rotate(ma+Math.PI/2);
      cx.fillStyle='#fff';cx.font='bold 9px Arial';cx.textAlign='center';cx.textBaseline='middle';
      cx.fillText(num,0,0);
      cx.restore();
    }
    cx.fillStyle='#8a6020';cx.beginPath();cx.arc(CX,CY,24,0,Math.PI*2);cx.fill();
    cx.fillStyle='#5a3a08';cx.beginPath();cx.arc(CX,CY,20,0,Math.PI*2);cx.fill();
    cx.fillStyle='#c8a520';cx.font='bold 10px Arial';cx.textAlign='center';cx.textBaseline='middle';cx.fillText('ROYAL',CX,CY);
    if(ballAngle!==null){
      const bx=CX+Math.cos(ballAngle-Math.PI/2)*86;
      const by=CY+Math.sin(ballAngle-Math.PI/2)*86;
      cx.fillStyle='#fff';cx.beginPath();cx.arc(bx,by,4,0,Math.PI*2);cx.fill();
      cx.fillStyle='rgba(0,0,0,.3)';cx.beginPath();cx.arc(bx,by+1,4,0,Math.PI*2);cx.fill();
      cx.fillStyle='#fff';cx.beginPath();cx.arc(bx-1,by-1,3,0,Math.PI*2);cx.fill();
    }
    // Wskaźnik na górze (skalowany do nowego canvas 280x220)
    cx.fillStyle='#c8a520';cx.beginPath();cx.moveTo(140,8);cx.lineTo(135,20);cx.lineTo(145,20);cx.closePath();cx.fill();
  };
  window._rouletteSetType=(t)=>{
    // F+ v1.8.11: BLOKADA zmiany zakładu podczas spinu (user bug: zmieniał typ widząc lecącą kulkę
    // i dostawał nienależne wygrane).
    if(spinning){if(typeof showMsg==='function')showMsg('⚠️ Nie zmieniaj zakładu podczas spinu!','r');return;}
    betType=t;_render();
  };
  /* v1.9.76: multi-bet helpers */
  window._rouletteAddBet=()=>{
    _syncBetFromInput();
    if(bet<10){lastResult='⚠️ Minimum 10 żetonów';if(typeof showMsg==='function')showMsg('⚠️ Minimum 10 żetonów','r',2500);_render();return;}
    if(bet>10000){lastResult='⚠️ Maksymalna stawka 10 000 żetonów (pojedynczy dorzut)';if(typeof showMsg==='function')showMsg('⚠️ Max stawka 10 000 żetonów','r',2500);_render();return;}
    if(bet>G.casinoChips){lastResult=`⚠️ Za mało żetonów! Masz ${G.casinoChips.toLocaleString('pl')} 🎟️, próbujesz postawić ${bet.toLocaleString('pl')}`;if(typeof showMsg==='function')showMsg(`⚠️ Za mało żetonów! Masz ${G.casinoChips.toLocaleString('pl')} 🎟️, próbujesz postawić ${bet.toLocaleString('pl')}`,'r',3500);_render();return;}
    /* v2.0.13: dla type=number gracz używa klikalnej planszy (_rouletteAddNumberBet) — zablokuj ➕ DODAJ */
    if(betType==='number'){lastResult='ℹ️ Klikaj liczby na planszy poniżej aby je obstawiać';_render();return;}
    const labels={red:'🔴 Czerwone',black:'⚫ Czarne',green:'🟢 Zero',even:'Parzyste',odd:'Nieparzyste',low:'1-18',high:'19-36',col1:'1-12',col2:'13-24',col3:'25-36'};
    /* v2.0.17: agregacja — jeśli zakład tego samego typu już istnieje, dodaj do jego stawki zamiast tworzyć duplikat */
    const existing = bets.find(b => b.type === betType);
    /* v2.1.61 Amper: limit 10 000 to MAX NA POJEDYNCZĄ OPCJĘ (czerwone, czarne, kolumna...), nie pojedynczy klik.
       Wcześniej każdy klik DODAJ ZAKŁAD agregował się ponad limit (np. 5×3000 = 15 000 na czerwone). */
    if(existing && existing.amount+bet>10000){
      lastResult=`⚠️ Limit ${labels[betType]}: 10 000 🎟️ (już masz ${existing.amount.toLocaleString('pl')} 🎟️, można dorzucić max ${(10000-existing.amount).toLocaleString('pl')})`;_render();return;
    }
    if(existing){
      existing.amount += bet;
      lastResult=`+ Dodano ${bet} 🎟️ do ${labels[betType]} (suma: ${existing.amount} 🎟️)`;
    } else {
      bets.push({type:betType,amount:bet,label:labels[betType]});
      lastResult=`+ Zakład: ${labels[betType]} ${bet} 🎟️`;
    }
    G.casinoChips-=bet;
    _render();
  };
  window._rouletteRemoveBet=(i)=>{const b=bets[i];if(b){G.casinoChips+=b.amount;bets.splice(i,1);_render();}};
  window._rouletteClearBets=()=>{bets.forEach(b=>G.casinoChips+=b.amount);bets=[];lastResult='';_render();};
  /* v2.1.56 Amper: odtwarza wszystkie zakłady z ostatniego spinu. Sprawdza czy gracz ma żetony na cały zestaw, jeśli nie — pokazuje błąd zamiast częściowego odtworzenia. */
  window._rouletteRepeatBets=()=>{
    if(spinning) return;
    if(!lastBets||lastBets.length===0){lastResult='ℹ️ Brak poprzednich zakładów do powtórzenia';_render();return;}
    if(bets.length>0){lastResult='⚠️ Najpierw wyczyść aktualne zakłady';_render();return;}
    const totalCost=lastBets.reduce((s,b)=>s+b.amount,0);
    if(totalCost>G.casinoChips){lastResult=`⚠️ Za mało żetonów (potrzeba ${totalCost.toLocaleString('pl')}, masz ${G.casinoChips.toLocaleString('pl')})`;_render();return;}
    G.casinoChips-=totalCost;
    bets=lastBets.map(b=>({...b}));
    /* v2.1.223 BUG #29 fix: PL grammar 1/2-4/5+ (zakład/zakłady/zakładów) */
    const _bN=bets.length;
    const _bW=_bN===1?'zakład':(_bN%10>=2&&_bN%10<=4&&(_bN%100<10||_bN%100>=20))?'zakłady':'zakładów';
    lastResult=`🔁 Powtórzono ${_bN} ${_bW} (${totalCost.toLocaleString('pl')} 🎟️)`;
    _render();
  };
  /* v2.0.13: klik na liczbę na klikalnej planszy dodaje zakład od razu (bez ➕ DODAJ).
     v2.0.17: agregacja — kolejne kliki tej samej liczby zwiększają jej stawkę (nie tworzą duplikatów). */
  window._rouletteAddNumberBet=(n)=>{
    if(spinning) return;
    _syncBetFromInput();
    if(bet<10){lastResult='⚠️ Minimum 10 żetonów';if(typeof showMsg==='function')showMsg('⚠️ Minimum 10 żetonów','r',2500);_render();return;}
    if(bet>10000){lastResult='⚠️ Maksymalna stawka 10 000 żetonów (pojedynczy dorzut)';if(typeof showMsg==='function')showMsg('⚠️ Max stawka 10 000 żetonów','r',2500);_render();return;}
    if(bet>G.casinoChips){lastResult=`⚠️ Za mało żetonów! Masz ${G.casinoChips.toLocaleString('pl')} 🎟️, próbujesz postawić ${bet.toLocaleString('pl')}`;if(typeof showMsg==='function')showMsg(`⚠️ Za mało żetonów! Masz ${G.casinoChips.toLocaleString('pl')} 🎟️, próbujesz postawić ${bet.toLocaleString('pl')}`,'r',3500);_render();return;}
    const existing = bets.find(b => b.type==='number' && b.number===n);
    /* v2.1.61 Amper: limit 10 000 to MAX NA POJEDYNCZĄ LICZBĘ. Każda liczba osobno (po 10k każda dozwolone). */
    if(existing && existing.amount+bet>10000){
      lastResult=`⚠️ Limit liczby ${n}: 10 000 🎟️ (masz ${existing.amount.toLocaleString('pl')}, można dorzucić max ${(10000-existing.amount).toLocaleString('pl')}). Postaw na inną liczbę.`;_render();return;
    }
    if(existing){
      existing.amount += bet;
      lastResult=`+ Dodano ${bet} 🎟️ do liczby ${n} (suma: ${existing.amount} 🎟️)`;
    } else {
      bets.push({type:'number',number:n,amount:bet,label:'Liczba '+n});
      lastResult=`+ Zakład: liczba ${n} (${bet} 🎟️)`;
    }
    G.casinoChips-=bet;
    _render();
  };
  window._rouletteSpin=()=>{
    if(spinning) return;
    if(bets.length===0){lastResult='⚠️ Dodaj zakłady przyciskiem ➕ DODAJ ZAKŁAD';_render();return;}
    // v1.8.18: cooldown anty-exploit — wyjście z kasyna NIE skraca rzeczywistego rate'u spinów.
    const _now=Date.now();
    if(G._rouletteCooldownUntil && _now<G._rouletteCooldownUntil){
      const _sec=((G._rouletteCooldownUntil-_now)/1000).toFixed(1);
      lastResult=`⏳ Poczekaj ${_sec}s — kulka jeszcze leci`;
      _render();
      return;
    }
    if(!G.casinoChips) G.casinoChips=0;
    const _bet=bets.reduce((s,b)=>s+b.amount,0); // total dla statystyk
    spinning=true;
    if(typeof sfxRouletteSpin==='function') sfxRouletteSpin();
    const lockedBetType = betType;
    const lockedBetNumber = betNumber;
    const resultNum=Math.floor(Math.random()*37);
    const resultIdx=ROULETTE_ORDER.indexOf(resultNum);
    const startRot=currentRotation;
    const startMod=((startRot%(Math.PI*2))+Math.PI*2)%(Math.PI*2);
    const targetMod=((Math.PI*2 - ((resultIdx+0.5)/37)*Math.PI*2)%(Math.PI*2)+Math.PI*2)%(Math.PI*2);
    const targetRotation = startRot + (Math.PI*2*5) + ((targetMod - startMod + Math.PI*2) % (Math.PI*2));
    const startTime=Date.now();
    const duration=3500;
    G._rouletteCooldownUntil=startTime+duration+150;
    // v1.8.17: helper finalize — wywołane gdy animacja kończy się NORMALNIE lub gdy gracz wychodzi
    let finalized=false;
    const _finalize=()=>{
      if(finalized) return;
      finalized=true;
      spinning=false;
      currentRotation = targetRotation % (Math.PI*2);
      const isRed=RED_NUMBERS.has(resultNum), isBlack=resultNum>0 && !isRed, isZero=resultNum===0;
      const colSymbol=isZero?'🟢':isRed?'🔴':'⚫';
      if(!G.casinoStats) G.casinoStats={slotsSpins:0,slotsWon:0,rouletteSpins:0,rouletteWon:0,blackjackPlayed:0,blackjackWon:0,warPlayed:0,warWon:0,biggestWin:0,totalWon:0,totalLost:0};
      G.casinoStats.rouletteSpins++;
      /* v1.9.76: sprawdź wszystkie zakłady, sumuj wygrane */
      let totalWin=0, winningBets=[];
      for(const b of bets){
        let m=0;
        if(b.type==='red' && isRed) m=2;
        else if(b.type==='black' && isBlack) m=2;
        else if(b.type==='green' && isZero) m=36;
        else if(b.type==='even' && resultNum>0 && resultNum%2===0) m=2;
        else if(b.type==='odd' && resultNum%2===1) m=2;
        else if(b.type==='low' && resultNum>=1 && resultNum<=18) m=2;
        else if(b.type==='high' && resultNum>=19 && resultNum<=36) m=2;
        else if(b.type==='col1' && resultNum>=1 && resultNum<=12) m=3;
        else if(b.type==='col2' && resultNum>=13 && resultNum<=24) m=3;
        else if(b.type==='col3' && resultNum>=25 && resultNum<=36) m=3;
        else if(b.type==='number' && resultNum===b.number) m=36;
        if(m>0){const w=b.amount*m;totalWin+=w;winningBets.push(b.label+' '+m+'×');}
      }
      if(totalWin>0){
        G.casinoChips+=totalWin;
        G.casinoStats.rouletteWon++;
        G.casinoStats.totalWon+=totalWin;
        if(totalWin>G.casinoStats.biggestWin)G.casinoStats.biggestWin=totalWin;
        lastResult=`🎉 ${colSymbol} <b>${resultNum}</b> — WYGRANA <span style="color:#27ae60">${totalWin.toLocaleString('pl')} 🎟️</span> (${winningBets.join(', ')})`;
        if(typeof sfxCash==='function')sfxCash();
        if(typeof showGain==='function')showGain('+'+totalWin.toLocaleString('pl')+' 🎟️','#27ae60');
        if(totalWin>=_bet*10 && typeof confetti==='function')confetti(30);
      } else {
        lastResult=`${colSymbol} <b>${resultNum}</b> — przegrana wszystkie zakłady (${_bet.toLocaleString('pl')} 🎟️)`;
        G.casinoStats.totalLost+=_bet;
      }
      /* v2.1.56 Amper: snapshot zakładów PRZED resetem — pozwoli przycisk "🔁 Powtórz" odtworzyć je w kolejnej rundzie. */
      lastBets=bets.map(b=>({...b}));
      bets=[]; // reset bets after spin
      if(typeof sfxRouletteBall==='function') sfxRouletteBall();
      if(typeof updateHUD==='function')updateHUD();
      _syncBetFromInput();
      window._activeCasinoFinalize=null;
      if(document.getElementById('roulette-cv')) _render();
    };
    window._activeCasinoFinalize=_finalize; // wywołane przez closeOverlay()
    const _animate=()=>{
      if(finalized) return; // już zakończone (np. gracz wyszedł)
      const elapsed=Date.now()-startTime;
      const t=Math.min(1, elapsed/duration);
      const ease=1-Math.pow(1-t,3);
      currentRotation=startRot+(targetRotation-startRot)*ease;
      const ballRot = -Math.PI*2*8*(1-ease);
      _drawWheel(currentRotation, ballRot);
      if(t<1){requestAnimationFrame(_animate);}
      else _finalize();
    };
    requestAnimationFrame(_animate);
  };
  _render();
  openOverlay();
};

// ── BLACKJACK z prawdziwym stołem + insurance + split + widoczne żetony ──
window.openBlackjack=()=>{
  let bet=100, gamePhase='bet', lastResult='', deck=[];
  // Wiele rąk gracza (dla split). Każda ręka: {cards, bet, doubled, done, busted}
  let hands=[{cards:[],bet:0,doubled:false,done:false,busted:false}];
  let activeHandIdx=0;
  let dealerHand=[];
  let insuranceBet=0; // żetony wstawione na insurance
  let cardAnims=[];
  let animRAF=null;
  const _syncBetFromInput=()=>{
    const el=document.getElementById('bj-bet');
    if(el){const v=parseInt(el.value);if(!isNaN(v)&&v>=20)bet=v;}
  };
  window._bjOnBetInput=()=>{_syncBetFromInput();};
  const _shuffleDeck=()=>{
    const suits=['♠','♥','♦','♣'];
    const ranks=[{r:'A',v:11},{r:'2',v:2},{r:'3',v:3},{r:'4',v:4},{r:'5',v:5},{r:'6',v:6},{r:'7',v:7},{r:'8',v:8},{r:'9',v:9},{r:'10',v:10},{r:'J',v:10},{r:'Q',v:10},{r:'K',v:10}];
    deck=[];
    /* v2.0.14: 2 talie (104 karty) — neutralizuje player edge ze Surrender. HE 2-deck S17 DAS LSR = ~0.11%. */
    for(let copy=0;copy<2;copy++){
      for(const s of suits) for(const r of ranks) deck.push({s, r:r.r, v:r.v});
    }
    for(let i=deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]];}
  };
  const _handValue=(hand)=>{
    let v=0, aces=0;
    for(const c of hand){v+=c.v;if(c.r==='A')aces++;}
    while(v>21 && aces>0){v-=10;aces--;}
    return v;
  };
  // === POZYCJE NA STOLE (canvas 520x360) ===
  // Krupier u góry, gracz u dołu. Stos żetonów po lewej stronie kart gracza.
  // Insurance: osobne pole nad środkiem (gdy aktywne).
  const DEALER_Y=46;
  const HAND_BASE_Y=232;
  const DECK_X=440, DECK_Y=12;
  const _handX=(handIdx, numHands)=>{
    // 1 ręka: środek 230. 2 ręce: 130 i 330.
    if(numHands===1) return 200;
    return 100+handIdx*220;
  };
  const _dealAnim=(targetX,targetY,card,faceDown=false,who='player',handIdx=0,cardIdx=0)=>{
    cardAnims.push({sx:DECK_X,sy:DECK_Y,tx:targetX,ty:targetY,t:0,dur:320,card,faceDown,who,handIdx,cardIdx,startTime:Date.now()});
    if(typeof sfxCardDeal==='function') sfxCardDeal();
  };
  const _runCanvasAnim=()=>{
    const cv=document.getElementById('bj-cv');
    if(!cv){animRAF=null;return;}
    let allDone=true;
    for(const a of cardAnims){
      a.t=Math.min(1,(Date.now()-a.startTime)/a.dur);
      if(a.t<1) allDone=false;
    }
    _renderCanvas();
    if(!allDone){animRAF=requestAnimationFrame(_runCanvasAnim);}
    else animRAF=null;
  };
  const _drawCard=(cx,x,y,card,faceDown=false)=>{
    // Cień
    cx.fillStyle='rgba(0,0,0,.35)';cx.fillRect(x+2,y+3,52,72);
    // Karta
    cx.fillStyle='#fff';cx.fillRect(x,y,52,72);
    cx.strokeStyle='#1a1a1a';cx.lineWidth=1.5;cx.strokeRect(x,y,52,72);
    if(faceDown){
      cx.fillStyle='#5a1818';cx.fillRect(x+3,y+3,46,66);
      cx.strokeStyle='#c8a520';cx.lineWidth=1;cx.strokeRect(x+5,y+5,42,62);
      // wzór rombiczny
      cx.fillStyle='#7a2828';
      for(let r=0;r<5;r++)for(let c=0;c<3;c++){
        cx.beginPath();cx.arc(x+11+c*15,y+15+r*12,2.5,0,Math.PI*2);cx.fill();
      }
      cx.fillStyle='#c8a520';cx.font='bold 18px Arial';cx.textAlign='center';cx.textBaseline='middle';cx.fillText('♛',x+26,y+36);
    } else if(card){
      const isRed=card.s==='♥'||card.s==='♦';
      cx.fillStyle=isRed?'#c01020':'#1a1a1a';
      cx.font='bold 14px Arial,sans-serif';cx.textAlign='left';cx.textBaseline='top';
      cx.fillText(card.r,x+4,y+4);
      cx.font='bold 12px Arial,sans-serif';
      cx.fillText(card.s,x+4,y+22);
      cx.font='bold 30px Arial,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
      cx.fillText(card.s,x+26,y+38);
      cx.font='bold 14px Arial,sans-serif';cx.textAlign='right';cx.textBaseline='bottom';
      cx.fillText(card.r,x+48,y+68);
    }
  };
  // === RYSOWANIE STOSU ŻETONÓW ===
  // amount żetonów, pozycja (cx,cy bottom). Rozbija na denominacje i rysuje stos.
  const _drawChipStack=(cx_ctx,cx,cy,amount,label)=>{
    if(amount<=0) return;
    // Denominacje: 500 (purple), 100 (czarny), 25 (zielony), 5 (czerwony), 1 (biały)
    const denoms=[{v:500,c:'#7a3aa3',e:'#a050d0'},{v:100,c:'#1a1a1a',e:'#3a3a3a'},{v:25,c:'#27ae60',e:'#50d080'},{v:5,c:'#c01020',e:'#e04050'},{v:1,c:'#f0f0f0',e:'#ffffff'}];
    const breakdown=[];
    let rem=amount;
    for(const d of denoms){
      const cnt=Math.floor(rem/d.v);
      if(cnt>0){breakdown.push({...d,cnt});rem-=cnt*d.v;}
    }
    // Limit do max 8 żetonów per kolumna (visual stacking)
    const maxPerCol=6;
    let colIdx=0, posInCol=0;
    for(const b of breakdown){
      for(let i=0;i<b.cnt;i++){
        const x=cx+colIdx*16;
        const y=cy-posInCol*4;
        // Żeton: czarny okrąg + kolorowy środek + biała ramka
        cx_ctx.fillStyle='rgba(0,0,0,.5)';cx_ctx.beginPath();cx_ctx.ellipse(x+1,y+2,10,3.5,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle='#1a1a1a';cx_ctx.beginPath();cx_ctx.ellipse(x,y,10,3.5,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle=b.c;cx_ctx.beginPath();cx_ctx.ellipse(x,y-1,9,3,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle=b.e;cx_ctx.beginPath();cx_ctx.ellipse(x,y-2,7,2.2,0,0,Math.PI*2);cx_ctx.fill();
        // Białe kreseczki na żetonie (4 sztuki dookoła)
        cx_ctx.fillStyle='rgba(255,255,255,.7)';
        cx_ctx.fillRect(x-9,y-2,2,1.5);cx_ctx.fillRect(x+7,y-2,2,1.5);
        posInCol++;
        if(posInCol>=maxPerCol){posInCol=0;colIdx++;}
      }
    }
    // Etykieta pod stosem
    if(label){
      cx_ctx.fillStyle='#f1c40f';cx_ctx.font='bold 11px Arial,sans-serif';cx_ctx.textAlign='center';cx_ctx.textBaseline='top';
      cx_ctx.fillText(label,cx+colIdx*8,cy+8);
    }
    // Wartość w żetonach
    cx_ctx.fillStyle='#ffe890';cx_ctx.font='bold 12px Arial,sans-serif';cx_ctx.textAlign='center';cx_ctx.textBaseline='top';
    cx_ctx.fillText(amount+' 🎟️',cx+colIdx*8,cy-4-maxPerCol*4-12);
    cx_ctx.textAlign='left';cx_ctx.textBaseline='alphabetic';
  };
  const _renderCanvas=()=>{
    const cv=document.getElementById('bj-cv');if(!cv)return;
    const cx=cv.getContext('2d');
    const W=520,H=360;
    // === TŁO — drewniany rant + zielone sukno ===
    cx.fillStyle='#3a1808';cx.fillRect(0,0,W,H); // drewniany rant
    // Filc zielony — eliptyczne pole
    cx.save();
    const _g=cx.createRadialGradient(W/2,H/2,80,W/2,H/2,W*0.6);
    _g.addColorStop(0,'#0a5a18');_g.addColorStop(0.7,'#0a4010');_g.addColorStop(1,'#082808');
    cx.fillStyle=_g;cx.beginPath();cx.ellipse(W/2,H/2,W*0.46,H*0.45,0,0,Math.PI*2);cx.fill();
    cx.restore();
    // Złoty łuk obramowania stołu
    cx.strokeStyle='#c8a520';cx.lineWidth=3;
    cx.beginPath();cx.ellipse(W/2,H/2,W*0.46,H*0.45,0,0,Math.PI*2);cx.stroke();
    cx.strokeStyle='rgba(255,235,150,.5)';cx.lineWidth=1.2;
    cx.beginPath();cx.ellipse(W/2,H/2,W*0.46-4,H*0.45-4,0,0,Math.PI*2);cx.stroke();
    // Tekst "BLACKJACK PAYS 3 TO 2" w łuku górnym
    cx.fillStyle='#c8a520';cx.font='bold 12px Arial,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
    cx.fillText('BLACKJACK PŁACI 3 DO 2',W/2,H/2-50);
    cx.font='10px Arial,sans-serif';cx.fillStyle='rgba(200,165,32,.6)';
    cx.fillText('UBEZPIECZENIE 2 DO 1 · KRUPIER DOBIERA DO 17 · PODDAJ = 50% ZWROT',W/2,H/2-32);
    // === TALIA w prawym górnym ===
    for(let k=0;k<5;k++){
      cx.fillStyle='rgba(0,0,0,.3)';cx.fillRect(DECK_X+2,DECK_Y+2-k*0.5,52,72);
      cx.fillStyle='#5a1818';cx.fillRect(DECK_X+k,DECK_Y-k*0.5,52,72);
      cx.strokeStyle='#c8a520';cx.lineWidth=0.8;cx.strokeRect(DECK_X+k,DECK_Y-k*0.5,52,72);
    }
    cx.fillStyle='#c8a520';cx.font='bold 22px Arial,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
    cx.fillText('♛',DECK_X+26+5,DECK_Y+36-2.5);
    // === KRUPIER (góra) ===
    const dealerVisible = gamePhase==='dealer' || gamePhase==='end';
    const dvShow = dealerVisible?_handValue(dealerHand):(dealerHand[0]?dealerHand[0].v:0);
    cx.fillStyle='#fff';cx.font='bold 14px Arial,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
    cx.fillText(`KRUPIER: ${dvShow}${dealerVisible?'':' + ?'}`,W/2,DEALER_Y-22);
    // Karty krupiera — centered
    const dealerStartX = W/2 - (dealerHand.length*30)/2 - 11;
    const animKeys=new Set(cardAnims.filter(a=>a.t<1).map(a=>a.who+'|'+a.handIdx+'|'+a.cardIdx));
    dealerHand.forEach((c,i)=>{
      if(animKeys.has('dealer|0|'+i)) return;
      _drawCard(cx,dealerStartX+i*30,DEALER_Y,c,!dealerVisible&&i===1);
    });
    // === GRACZ (dół) — może mieć 1 lub 2 ręce (split) ===
    const numHands=hands.length;
    hands.forEach((h,hi)=>{
      const handCenterX=_handX(hi,numHands);
      // Karty gracza
      const handStartX = handCenterX - (h.cards.length*30)/2 - 11;
      h.cards.forEach((c,ci)=>{
        if(animKeys.has('player|'+hi+'|'+ci)) return;
        _drawCard(cx,handStartX+ci*30,HAND_BASE_Y,c);
      });
      // Wartość ręki + label aktywna
      const hv=_handValue(h.cards);
      const isActive=(hi===activeHandIdx && gamePhase==='player');
      const isBusted=h.busted||hv>21;
      cx.fillStyle=isActive?'#f1c40f':(isBusted?'#e74c3c':'#fff');
      cx.font='bold 14px Arial,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
      cx.fillText(`${numHands>1?(hi===0?'RĘKA 1':'RĘKA 2')+': ':'TY: '}${hv}${isBusted?' BUST':(hv===21?' BLACKJACK!':'')}`,handCenterX,HAND_BASE_Y+82);
      if(isActive){
        // Ramka wokół aktywnej ręki
        cx.strokeStyle='rgba(241,196,15,.7)';cx.lineWidth=2;cx.setLineDash([4,3]);
        cx.strokeRect(handStartX-4,HAND_BASE_Y-4,h.cards.length*30+24,80);
        cx.setLineDash([]);
      }
      // Stos żetonów obok ręki (po lewej dla ręki 0, po prawej dla ręki 1 w split)
      const chipX = numHands===1 ? handStartX-50 : (hi===0?handStartX-50:handStartX+h.cards.length*30+38);
      const chipY = HAND_BASE_Y+40;
      _drawChipStack(cx,chipX,chipY,h.bet,h.doubled?'2× DOUBLE':'STAWKA');
    });
    // === INSURANCE STAKE — środek, nad linią stołu ===
    if(insuranceBet>0){
      _drawChipStack(cx,W/2-30,H/2+30,insuranceBet,'INSURANCE');
    }
    // === ANIMOWANE KARTY ===
    for(const a of cardAnims){
      if(a.t>=1) continue;
      const ease=1-Math.pow(1-a.t,3);
      const x=a.sx+(a.tx-a.sx)*ease;
      const y=a.sy+(a.ty-a.sy)*ease;
      const showBack=a.t<0.5||a.faceDown;
      const scaleX=Math.abs(Math.cos(a.t*Math.PI));
      cx.save();cx.translate(x+26,y+36);cx.scale(scaleX,1);cx.translate(-26,-36);
      _drawCard(cx,0,0,a.card,showBack);
      cx.restore();
    }
  };
  const _canSplit=()=>{
    const h=hands[0];
    return hands.length===1 && h.cards.length===2 && h.cards[0].v===h.cards[1].v && G.casinoChips>=h.bet;
  };
  const _canDouble=()=>{
    const h=hands[activeHandIdx];
    return h && h.cards.length===2 && !h.doubled && G.casinoChips>=h.bet;
  };
  /* v2.0.14: Surrender dostępne tylko PRZED jakąkolwiek akcją (initial 2 karty, no split, no double). */
  const _canSurrender=()=>{
    if(hands.length!==1) return false;
    const h=hands[0];
    return h && h.cards.length===2 && !h.doubled && !h.surrendered;
  };
  const _render=()=>{
    _syncBetFromInput();
    if(!G.casinoChips) G.casinoChips=0;
    const activeHand=hands[activeHandIdx];
    const showInsuranceBtn = gamePhase==='insurance';
    // v1.8.19: Blackjack Royal redesign — premium gold frame
    document.getElementById('ov-content').innerHTML=`
      <div style="text-align:center;padding:14px 0 6px;position:relative">
        <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:90px;height:2px;background:linear-gradient(90deg,transparent,#c8a520,transparent)"></div>
        <div style="font-size:22px;letter-spacing:5px;color:#c8a520;font-weight:900;text-shadow:0 0 22px rgba(200,165,32,.55)">🃏 BLACKJACK ROYAL</div>
        <div style="color:#7a8aa0;font-size:11px;margin-top:4px">Stawka: <b style="color:#c8a520">20–10 000 żetonów</b> · Cel: zbliżyć się do 21 (nie przekroczyć) · Blackjack (A+10) = 2.5× wygrana</div>
      </div>
      <p style="text-align:center;margin:0 0 10px 0;font-size:12px"><span class="chip chip-gold">🎟️ ${G.casinoChips.toLocaleString('pl')}</span></p>
      ${G.casinoChips<20?'<div style="background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.5);padding:8px;border-radius:8px;text-align:center;color:#f4a097;font-size:12px;margin:6px auto;max-width:520px">💸 <b>Brak żetonów</b> (min 20) — wymień gotówkę w Kantorze</div>':''}
      ${gamePhase==='bet'&&bet>10000?`<div style="background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.5);padding:8px;border-radius:8px;text-align:center;color:#f4a097;font-size:12px;margin:6px auto;max-width:520px">⚠️ Maksymalna stawka: <b>10 000 żetonów</b> (Twoja: ${bet})</div>`:''}
