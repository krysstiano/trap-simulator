  const _topQ=_tracks>0?Math.max(...(G.studioTracks||[]).filter(t=>!t.isDemo).map(t=>t.masterQ||t.quality||0)):0;
  const categories=[
    {key:'best_single',name:'Najlepszy Singiel',emoji:'🎵',winChance:Math.min(0.85,_topQ/100*0.8),reward:{money:2000,fame:5,fans:500},requires:_tracks>=1},
