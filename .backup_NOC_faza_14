    </div>`;
  });
  html+=`<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
    <button onclick="window._cancelMVPicker()" style="background:transparent;border:1px solid #2a2535;color:#778;padding:6px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px">✕ Anuluj (bez tracku)</button>
  </div>`;
  card.innerHTML=html;
