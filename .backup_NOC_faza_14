/* v2.1.161: Promocja artisty — gracz inwestuje budget, artist dostaje +50% dailyIncome przez 7 dni */
window.promoteArtist=(artistId)=>{
  if(!G.label||!Array.isArray(G.label.artists))return;
  const signed=G.label.artists.find(a=>a.id===artistId);
  if(!signed){if(typeof showMsg==='function')showMsg('⚠️ Nie podpisałeś tego artysty','r');return;}
  const def=SIGNABLE_ARTISTS.find(d=>d.id===artistId);
  if(!def)return;
  /* v2.1.176: cost 50%→25% expected revenue. Wcześniej break-even (cost = bonus). Teraz net = +175% extra revenue. */
  const cost=Math.floor(def.dailyIncome*7*0.25);
  if((G.money||0)<cost){if(typeof showMsg==='function')showMsg(`⚠️ Brak ${cost-G.money} zł na promocję`,'r');return;}
  if(signed.promoteUntil && signed.promoteUntil>G.day){if(typeof showMsg==='function')showMsg(`⚠️ Już promowany do dnia ${signed.promoteUntil}`,'r');return;}
  G.money-=cost;
  signed.promoteUntil=G.day+7;
  if(typeof notify==='function')notify(`📢 ${def.name} promowany przez 7 dni! +50% daily income (cost ${cost} zł).`);
  if(typeof renderLabelOverlay==='function')renderLabelOverlay();
};
/* v2.1.161: Dropowanie artisty — gracz może zerwać kontrakt (50% kary cost).
   v2.1.223 BUG #27 fix: drop po evolution → refund używa cost evolvedFrom (oryginalny sign cost),
   nie post-evolution def.cost=0. Wcześniej player dropping evolved artist tracił 100% inwestycji bez ostrzeżenia. */
window.dropArtist=(artistId)=>{
  if(!G.label||!Array.isArray(G.label.artists))return;
  const idx=G.label.artists.findIndex(a=>a.id===artistId);
  if(idx<0)return;
  const a=G.label.artists[idx];
  const def=SIGNABLE_ARTISTS.find(d=>d.id===artistId);
  /* BUG #27 fix: użyj evolvedFrom cost gdy artist evolved (post-evolution def.cost=0) */
  let originalCost=def?def.cost:0;
  if(a && a.evolvedFrom){
    const origDef=SIGNABLE_ARTISTS.find(d=>d.id===a.evolvedFrom);
    if(origDef) originalCost=origDef.cost;
  }
  const refund=Math.floor(originalCost*0.3);
  if(typeof gameConfirm==='function'){
    gameConfirm(`Zerwać kontrakt z ${def?def.name:'artistą'}? Zwrot 30% sign cost (+${refund.toLocaleString('pl')} zł).`,()=>{
      G.label.artists.splice(idx,1);
      if(refund>0){G.money+=refund;G.totalEarned=(G.totalEarned||0)+refund;}
      if(typeof notify==='function')notify(`💔 ${def?def.name:'Artysta'} zerwany. +${refund.toLocaleString('pl')} zł zwrotu.`);
      if(typeof renderLabelOverlay==='function')renderLabelOverlay();
    });
  }
};
