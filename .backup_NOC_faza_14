/* ── MENU — v1.8.57 redesign: animowane miasto + śnieg + gwiazdy ── */
#menu{position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(ellipse at 30% 30%,rgba(40,60,120,0.30) 0%,transparent 60%),radial-gradient(ellipse at 80% 70%,rgba(126,200,227,0.12) 0%,transparent 50%),linear-gradient(180deg,#02050f 0%,#040a18 35%,#06122e 65%,#0a1a3a 100%);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:80px 100px;z-index:100;overflow:hidden;}
/* warstwa miasta — sylwetka z świecącymi oknami */
#menu-city{position:absolute;left:0;right:0;bottom:0;height:42%;pointer-events:none;z-index:1;}
#menu-city svg{position:absolute;bottom:0;left:0;width:100%;height:100%;display:block;}
#menu-city svg .b{filter:drop-shadow(0 -4px 18px rgba(126,200,227,.25));}
#menu-city svg .w{fill:#ffd668;animation:winTwinkle 4s ease-in-out infinite;}
#menu-city svg .w:nth-child(odd){animation-delay:1.2s;}
#menu-city svg .w:nth-child(3n){animation-delay:2.5s;}
@keyframes winTwinkle{0%,100%{opacity:.85}50%{opacity:.45}}
/* warstwa gwiazd — kropki migoczące */
#menu-stars{position:absolute;inset:0;pointer-events:none;z-index:0;}
#menu-stars span{position:absolute;display:block;width:2px;height:2px;background:#fff;border-radius:50%;animation:starTwinkle 3s ease-in-out infinite;}
@keyframes starTwinkle{0%,100%{opacity:.2;transform:scale(.8)}50%{opacity:.95;transform:scale(1.2);box-shadow:0 0 6px rgba(255,255,255,.7)}}
/* warstwa śniegu — płatki opadające */
#menu-snow{position:absolute;inset:0;pointer-events:none;z-index:2;overflow:hidden;}
#menu-snow span{position:absolute;top:-12px;color:rgba(255,255,255,.75);font-size:14px;line-height:1;animation:snowFall linear infinite;text-shadow:0 0 4px rgba(200,220,255,.7);}
@keyframes snowFall{0%{transform:translateY(-20px) translateX(0) rotate(0deg);opacity:0}5%{opacity:.85}95%{opacity:.85}100%{transform:translateY(110vh) translateX(40px) rotate(360deg);opacity:0}}
/* księżyc/aura — subtelny glow w prawym górnym rogu */
#menu-moon{position:absolute;top:80px;right:140px;width:120px;height:120px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#e8eef8 0%,#a8b8d0 50%,#5a6a8a 100%);box-shadow:0 0 90px rgba(168,184,208,.45),0 0 180px rgba(126,200,227,.18);z-index:1;pointer-events:none;animation:moonFloat 8s ease-in-out infinite;}
@keyframes moonFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
/* zawartość menu nad warstwami — ale NIE warstwy tła (gwiazdy/miasto/snieg/księżyc), żeby ich position:absolute zostało zachowane */
#menu>*:not(#menu-stars):not(#menu-moon):not(#menu-city):not(#menu-snow):not(.ver){position:relative;z-index:5;}
#menu h1{font-family:'Russo One','Orbitron',Impact,sans-serif;font-size:84px;font-weight:900;color:#fff;letter-spacing:3px;margin-bottom:2px;text-shadow:0 0 80px rgba(126,200,227,.35),0 0 40px rgba(126,200,227,.2);background:linear-gradient(180deg,#fff 0%,#cfe7f5 70%,#7ec8e3 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 30px rgba(126,200,227,.4));}
#menu .msub{font-size:14px;color:#7ec8e3;letter-spacing:5px;text-transform:uppercase;margin-bottom:50px;opacity:.85;}
.mbtn{background:linear-gradient(145deg,rgba(20,40,72,0.6),rgba(10,22,42,0.6));border:1px solid rgba(126,200,227,0.2);color:#cfe7f5;font-family:inherit;font-size:19px;padding:22px 36px;margin-bottom:12px;cursor:pointer;letter-spacing:1px;text-transform:none;transition:all .22s cubic-bezier(0.22,0.61,0.36,1);min-width:420px;width:auto;text-align:center;border-radius:10px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 4px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);position:relative;overflow:hidden;font-weight:600;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;line-height:1;}
/* v1.8.29: shimmer w wrapper żeby nie cropować tekstu przyciskowego */
.mbtn::before{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(126,200,227,0.18),transparent);transition:left .6s ease;pointer-events:none;border-radius:inherit;clip-path:inset(0);}
.mbtn:hover:not(:disabled){background:linear-gradient(145deg,rgba(40,80,140,0.85),rgba(20,42,82,0.85));border-color:rgba(126,200,227,0.7);color:#fff;transform:translateX(6px);box-shadow:0 8px 28px rgba(126,200,227,.25),inset 0 1px 0 rgba(255,255,255,.1);}
.mbtn:hover::before{left:130%;}
.mbtn:disabled{border-color:rgba(40,60,90,0.2);color:#2a3548;cursor:not-allowed;opacity:.4;background:transparent;}
.mbtn:disabled:hover{transform:none;box-shadow:none;}
#menu .ver{position:absolute;bottom:16px;left:100px;color:#9eb0c8;font-size:12px;letter-spacing:.5px;background:rgba(8,12,24,0.78);padding:4px 10px;border-radius:6px;border:1px solid rgba(60,80,110,0.4);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:10;white-space:nowrap;}

/* ── CREATOR — v1.8.19 redesign ── */
#creator{position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(ellipse at 50% 0%,rgba(40,60,120,0.2) 0%,transparent 50%),linear-gradient(160deg,#020610,#040a18);display:none;flex-direction:column;justify-content:center;align-items:center;z-index:100;padding:40px;}
