    if(getRaperST('produkcja')>=5 && ((G.careers?.beatmaker?.beats||0)+(G.careers?.beatmaker?.beatsSold||0)>=5 || (G.merchStore?.products?.length||0)>0)){
      const passive=rnd(100,400);earn(passive,false);_passiveTotal+=passive;addNotif('🥁 Pasywny przychód z bitów: +'+passive+' zł');
    }
    // Biznes 3+: wymaga założonej wytwórni
    if(getRaperST('biznes')>=3 && G.label?.type){
      const labelShare=rnd(50,200);earn(labelShare,false);_passiveTotal+=labelShare;addNotif('💼 Własny label: +'+labelShare+' zł');
    }
    // Realizacja 4+: wymaga min 1 wydanego singla
    if(getRaperST('realizacja')>=4 && (G.studioTracks?.length||0)>=1){
      const zlecenia=rnd(30,100);earn(zlecenia,false);_passiveTotal+=zlecenia;addNotif('🎙️ Stałe zlecenia realizacji: +'+zlecenia+' zł');
