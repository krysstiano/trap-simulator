function renderRPGMg(mg){
  let pHP=30,pMP=20,eHP=0,eIdx=0,round=0,log='Walka się zaczęła!';
  const enemies=[{name:'Goblin 👺',maxHP:18,dmg:4},{name:'Ork ⚔️',maxHP:26,dmg:6},{name:'Smok 🐉',maxHP:20,dmg:9}];
  const startEnemy=()=>{eHP=enemies[eIdx].maxHP;};startEnemy();
  const render=()=>{
    const e=enemies[eIdx];const done=eIdx>=enemies.length;
    mg.innerHTML=`
    <div style="text-align:center;max-width:580px;margin:0 auto">
      <h2 style="color:#9b59b6;margin-bottom:4px">⚔️ RPG Fantasy — Walka!</h2>
      <div style="display:flex;justify-content:space-between;align-items:center;background:#08101e;border:1px solid #2a2a4a;border-radius:8px;padding:12px 20px;margin-bottom:10px">
        <div style="text-align:left">
          <div style="color:#7ec8e3;font-size:12px">🧙 Gracz</div>
          <div style="color:#fff;font-size:17px;font-weight:700">❤️ ${pHP} &nbsp;🔮 ${pMP}</div>
          <div style="width:120px;height:6px;background:#1a1a3a;border-radius:3px;margin-top:4px"><div style="width:${pHP/30*100}%;height:100%;background:#e74c3c;border-radius:3px"></div></div>
        </div>
        <div style="font-size:30px">${done?'🏆':'VS'}</div>
        <div style="text-align:right">
          <div style="color:#e74c3c;font-size:12px">${done?'ZWYCIĘSTWO!':e.name}</div>
          <div style="color:#fff;font-size:17px;font-weight:700">${done?'':('❤️ '+eHP+'/'+e.maxHP)}</div>
          ${done?'':'<div style="width:120px;height:6px;background:#1a1a3a;border-radius:3px;margin-top:4px"><div style="width:'+Math.max(0,eHP/e.maxHP*100)+'%;height:100%;background:#9b59b6;border-radius:3px"></div></div>'}
        </div>
      </div>
      <div style="background:#060e06;border:1px solid #1a3a1a;border-radius:6px;padding:9px 14px;margin-bottom:12px;font-size:14px;color:#7ec87e;min-height:36px">${log}</div>
      ${done?`<button class="dbtn" style="width:200px" onclick="window.rpgEnd()">🏆 Zakończ nagranie!</button>`:`
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
        <button class="dbtn" style="width:145px" onclick="window.rpgAct('atk')">⚔️ Atak</button>
        <button class="dbtn" style="width:145px;${pMP<5?'opacity:.3;pointer-events:none':''}" onclick="window.rpgAct('mag')">🔮 Magia (−5 MP)</button>
        <button class="dbtn" style="width:145px" onclick="window.rpgAct('def')">🛡️ Obrona</button>
      </div>`}
      <p style="color:#334;font-size:11px;margin-top:7px">Runda ${round} | Wrogowie: ${Math.min(eIdx,enemies.length)}/${enemies.length}</p>
    </div>`;
  };
  window.rpgAct=(act)=>{
    round++;const e=enemies[eIdx];let msg='';
    if(act==='atk'){const d=rnd(5,10);eHP-=d;msg=`⚔️ Zadajesz ${d} DMG!`;}
    else if(act==='mag'&&pMP>=5){const d=14;eHP-=d;pMP-=5;msg=`🔮 Magia! ${d} DMG!`;}
    else if(act==='def'){pHP=Math.min(30,pHP+9);msg='🛡️ Odzy­skujesz 9 HP!';}
    if(eHP<=0){
      eIdx++;
      if(eIdx<enemies.length){startEnemy();msg+=` ✅ Pokonałeś ${e.name}!`;}
      else{log=msg+' 🏆 Wygrałeś wszyst­kich!';render();return;}
    } else {
      const ed=rnd(2,e.dmg);pHP-=ed;msg+=` ${e.name} trafia za ${ed}.`;
    }
    if(pHP<=0){
      window.finishYTMinigame(clamp(Math.round(eIdx/enemies.length*70),0,80),`Pokonałeś ${eIdx}/${enemies.length} wrogów — Game Over`);return;
    }
    log=msg;render();
  };
  window.rpgEnd=()=>window.finishYTMinigame(98,'Epiczna walka! Pokonałeś wszystkich wrogów!');
  render();
}

// ── Horror: Jumpscare reaction ──
function renderHorrorMg(mg){
  let stage=0,totalScore=0,waiting=false,scareActive=false;
  const SCARES=[
    {emoji:'👻',delay:rnd(1500,2800)},{emoji:'🧟',delay:rnd(900,2200)},
    {emoji:'🎃',delay:rnd(2000,3500)},{emoji:'🕷️',delay:rnd(700,1800)},{emoji:'🦇',delay:rnd(1500,3000)},
  ];
  let scareT=null,startT=0;const timers=[];
  const render=(status='')=>{
    mg.innerHTML=`
    <div style="text-align:center">
      <h2 style="color:#9b59b6;margin-bottom:4px">👻 Horror Night — Jumpscares!</h2>
      <p style="color:#556;font-size:13px;margin-bottom:8px">Kliknij ekran gdy pojawi się stwór! Scena ${Math.min(stage+1,SCARES.length)}/${SCARES.length}</p>
      <div id="horror-scene" style="position:relative;width:620px;height:310px;background:radial-gradient(ellipse at center,#0a0015 0%,#020008 100%);border:2px solid #3a0a4a;border-radius:8px;display:flex;align-items:center;justify-content:center;margin:0 auto;overflow:hidden;cursor:pointer" onclick="window.horrorClick()">
        <div style="font-size:90px;opacity:.05;position:absolute">🏚️</div>
        <div id="horror-monster" style="font-size:90px;display:none;animation:scare .12s ease-out"></div>
        <div id="horror-label" style="font-size:15px;color:#4a2a5a;position:absolute">${waiting?'⏳ Czekaj...':status||'Przygotuj się...'}</div>
      </div>
      <div id="horror-result" style="margin-top:10px;color:#e74c3c;font-size:16px;font-weight:700;min-height:22px"></div>
      <p style="color:#334;font-size:11px;margin-top:4px">Kliknij jak najszybciej po pojawieniu się stwora</p>
    </div>`;
  };
  const runScare=()=>{
    if(stage>=SCARES.length){
      const sc=clamp(Math.round(totalScore/SCARES.length),0,100);
      window.finishYTMinigame(sc,`Śr. reakcja: ${Math.round(1500-sc*14)}ms`);return;
    }
    scareActive=false;waiting=true;render();
    const s=SCARES[stage];
    scareT=setTimeout(()=>{
      waiting=false;scareActive=true;startT=Date.now();
      const monster=document.getElementById('horror-monster');
      const label=document.getElementById('horror-label');
      const scene=document.getElementById('horror-scene');
      if(monster){monster.style.display='block';monster.textContent=s.emoji;}
      if(label) label.style.display='none';
      if(scene) scene.style.background='radial-gradient(ellipse at center,#200030 0%,#0a0018 100%)';
      scareT=setTimeout(()=>{
        if(scareActive){totalScore+=0;stage++;const r=document.getElementById('horror-result');if(r)r.textContent='⏱️ Za wolno! Zmarnowałeś ujęcie.';scareActive=false;setTimeout(runScare,800);}
      },1600);timers.push(scareT);
    },s.delay);timers.push(scareT);
  };
  window.horrorClick=()=>{
    if(!scareActive)return;
    clearTimeout(scareT);
    const react=Date.now()-startT;
    const pts=clamp(Math.round(110-react/12),10,100);
    totalScore+=pts;stage++;scareActive=false;
    const r=document.getElementById('horror-result');
    if(r)r.textContent=`😱 Reakcja: ${react}ms — +${pts} pkt!`;
    setTimeout(runScare,900);
  };
  window._ytMgCleanup=()=>timers.forEach(t=>clearTimeout(t));
  render();setTimeout(runScare,1000);
}

// ── Racing: Dodge obstacles ──
function renderRacingMg(mg){
  let lane=1,score=0,timeLeft=12,crashed=false;
  const LANES=[150,310,470];
  const obstacles=[];const timers=[];
  const renderTrack=()=>{
    mg.innerHTML=`
    <div style="text-align:center">
      <h2 style="color:#f39c12;margin-bottom:4px">🏎️ Racing — Unikaj przeszkód!</h2>
      <p style="color:#556;font-size:13px;margin-bottom:6px">← → strzałki = zmiana pasa | Czas: <b id="race-t" style="color:#f1c40f">${timeLeft}s</b> | Omijasz: <b id="race-s" style="color:#7ec87e">${score}</b></p>
      <div id="race-track" style="position:relative;width:620px;height:310px;background:linear-gradient(180deg,#141414,#1e1e1e);border:2px solid #3a3a1a;border-radius:8px;overflow:hidden;margin:0 auto">
        <div style="position:absolute;left:${LANES[0]-2}px;top:0;width:4px;height:100%;background:rgba(255,220,0,.15)"></div>
        <div style="position:absolute;left:${LANES[1]-2}px;top:0;width:4px;height:100%;background:rgba(255,220,0,.15)"></div>
        <div style="position:absolute;left:${LANES[2]-2}px;top:0;width:4px;height:100%;background:rgba(255,220,0,.15)"></div>
        <div id="race-car" style="position:absolute;bottom:18px;left:${LANES[lane]-22}px;font-size:38px;transition:left .1s">🏎️</div>
        <div id="race-obs"></div>
        ${crashed?'<div style="position:absolute;inset:0;background:rgba(255,0,0,.4);display:flex;align-items:center;justify-content:center;font-size:56px">💥</div>':''}
      </div>
      <p style="color:#334;font-size:11px;margin-top:5px">← → aby zmieniać pas</p>
    </div>`;
  };
  const updateObs=()=>{
    const el=document.getElementById('race-obs');if(!el)return;
    el.innerHTML='';for(const ob of obstacles){const d=document.createElement('div');d.style.cssText=`position:absolute;left:${LANES[ob.lane]-20}px;top:${ob.y}px;font-size:34px`;d.textContent='🚧';el.appendChild(d);}
  };
  const onKey=(e)=>{
    if(crashed)return;
    if(e.key==='ArrowLeft'&&lane>0){lane--;const c=document.getElementById('race-car');if(c)c.style.left=(LANES[lane]-22)+'px';e.preventDefault();}
    if(e.key==='ArrowRight'&&lane<2){lane++;const c=document.getElementById('race-car');if(c)c.style.left=(LANES[lane]-22)+'px';e.preventDefault();}
  };
  document.addEventListener('keydown',onKey);
  const spawnI=setInterval(()=>{if(!crashed)obstacles.push({lane:rnd(0,2),y:-40});},1100);timers.push(spawnI);
  const tickI=setInterval(()=>{
    if(crashed)return;
    for(let i=obstacles.length-1;i>=0;i--){
      obstacles[i].y+=16;
      if(obstacles[i].y>270){
        if(obstacles[i].lane===lane){crashed=true;document.removeEventListener('keydown',onKey);renderTrack();setTimeout(()=>window.finishYTMinigame(clamp(score*7,0,85),`Omijałeś ${score} przeszkód — Crash!`),1600);return;}
        obstacles.splice(i,1);score++;const s=document.getElementById('race-s');if(s)s.textContent=score;
      }
    }
    updateObs();
  },70);timers.push(tickI);
  const countI=setInterval(()=>{
    timeLeft--;const t=document.getElementById('race-t');if(t)t.textContent=timeLeft+'s';
    if(timeLeft<=0){timers.forEach(t=>{clearInterval(t);clearTimeout(t);});document.removeEventListener('keydown',onKey);window.finishYTMinigame(clamp(score*8,score>0?25:0,100),`Omijałeś przez 12s! Przeszkód: ${score}`);}
  },1000);timers.push(countI);
  window._ytMgCleanup=()=>{timers.forEach(t=>{clearInterval(t);clearTimeout(t);});document.removeEventListener('keydown',onKey);};
  renderTrack();
}

// ── Cooking: Recipe sequence ──
function renderCookingMg(mg){
  const RECIPES=[
    {name:'🍕 Pizza',steps:['🧀','🍅','🍄','🫒']},
    {name:'🍣 Sushi',steps:['🍚','🐟','🥒','🌿']},
    {name:'🍔 Burger',steps:['🥩','🧀','🥬','🍅']},
  ];
  const INGR=['🧀','🍅','🍄','🫒','🍚','🐟','🥒','🌿','🥩','🥬'];
  let recIdx=0,stepIdx=0,score=0;
  const render=()=>{
    if(recIdx>=RECIPES.length){window.finishYTMinigame(clamp(Math.round(score*9),5,100),`Ugotowałeś ${RECIPES.length} przepisy! Score: ${score}`);return;}
    const rec=RECIPES[recIdx];
    mg.innerHTML=`
    <div style="text-align:center">
      <h2 style="color:#27ae60;margin-bottom:4px">🍳 Cooking Sim — Gotuj!</h2>
      <p style="color:#556;font-size:13px;margin-bottom:8px">Przepis ${recIdx+1}/${RECIPES.length}: <b style="color:#fff">${rec.name}</b></p>
      <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:8px;padding:12px;margin-bottom:14px;display:inline-block">
        <p style="color:#7ec87e;font-size:13px;margin-bottom:8px">Kolejność składników:</p>
        <div style="display:flex;gap:8px;justify-content:center">
          ${rec.steps.map((s,i)=>`<div style="width:54px;height:54px;background:${i<stepIdx?'#1a4a1a':i===stepIdx?'#2a6a2a':'#0a1a0a'};border:2px solid ${i===stepIdx?'#27ae60':'#1a3a1a'};border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:28px">${i<stepIdx?'✅':s}</div>`).join('')}
        </div>
        <p style="color:#445;font-size:13px;margin-top:8px">Dodaj: <b style="color:#f1c40f;font-size:22px">${rec.steps[stepIdx]||'✅ Gotowe!'}</b></p>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;max-width:520px;margin:0 auto">
        ${INGR.map(i=>`<div onclick="window.cookPick('${i}')" style="width:58px;height:58px;background:#0a1a0a;border:1px solid #1a3a1a;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:30px;cursor:pointer">${i}</div>`).join('')}
      </div>
      <div id="cook-msg" style="margin-top:10px;font-size:15px;min-height:22px"></div>
    </div>`;
  };
  window.cookPick=(ingr)=>{
    const rec=RECIPES[recIdx];
    if(ingr===rec.steps[stepIdx]){
      stepIdx++;score++;const m=document.getElementById('cook-msg');if(m){m.style.color='#7ec87e';m.textContent='✅ Dobrze!';}
      if(stepIdx>=rec.steps.length){recIdx++;stepIdx=0;setTimeout(render,600);}else render();
    } else {
      const m=document.getElementById('cook-msg');if(m){m.style.color='#e74c3c';m.textContent='❌ Nie ten składnik!';}
      score=Math.max(0,score-.5);
    }
  };
  render();
}

