function publishYT(){
  if(!G.ytRecorded||!G.ytEdited) return;
  const grafikBonus=G.crew.some(c=>c.role==='grafik')?1.10:1.0;
  const q=Math.min(100,Math.floor(G.ytQuality*grafikBonus));
  const gameBonus={'FPS Action':1.3,'RPG Fantasy':1.1,'Horror Night':1.4,'Racing':1.0,'Minecraft Build':1.5,'Cooking Sim':0.9,'Vlog Dzienny':1.2,'Muzyczny':1.3}[G.ytGame]||1;
  const ytSkMult=1+Math.max(0,(G.skills&&getSkillLvl('youtuber')||0)-1)*0.15+(typeof _pu==='function'?_pu('youtuber')*0.30:0); /* v1.9.63: Power-Ups +30/60/100% (audyt PU — wcześniej pomijane w publishYT) */
  const baseViews=Math.floor(q*gameBonus*(1+G.yt.subs*.001)*rnd(80,120)/100*ytSkMult);
  // v1.9.10: BUG FIX — ytSkMult NIE jest ponownie aplikowany do newSubs/income, bo baseViews już go ma. Wcześniej x²=2.56× przy skill 5.
  /* v2.1.85 Amper: CONSECUTIVE UPLOADS STREAK BONUS — aktywni YouTuberzy nagradzani.
     Streak = dni z rzędu z uploadem. Reset jeśli pominął dzień. Max bonus +300 subów per video po 30 dniach streaku. */
  if(!G._ytLastUploadDay || G.day - G._ytLastUploadDay > 1){
    G._ytStreak = 1;
  } else if(G.day !== G._ytLastUploadDay){
    G._ytStreak = Math.min(30, (G._ytStreak||0) + 1);
  }
  G._ytLastUploadDay = G.day;
  const _streakBonus = (G._ytStreak||1) * 10;
  const newSubs=Math.floor(baseViews*(q/1000+.01)) + _streakBonus;
  let income=Math.floor(baseViews*.005+q*0.5*ytSkMult);
  if(G.managementDeal) income=Math.floor(income*G.managementBonus);
  G.yt.views+=baseViews;G.yt.subs+=newSubs;
  /* v2.1.112: S11 — notify już od dnia 2 (wcześniej tylko ≥7, gracz nie miał feedbacku że streak rośnie). */
  if(G._ytStreak >= 2 && typeof addNotif==='function'){
    if(G._ytStreak >= 7) addNotif(`🔥 YT streak ${G._ytStreak} dni — bonus +${_streakBonus} subów! Mistrzowski rytm!`);
    else addNotif(`📈 YT streak ${G._ytStreak} dni — bonus +${_streakBonus} subów. Kontynuuj!`);
  }
  /* v1.9.30: Prestige moneyMult przez earn() */
  if(typeof earn==='function') earn(income,false); else {G.money+=income;G.totalEarned=(G.totalEarned||0)+income;}
  // v1.8.85: BUG FIX — wcześniej `G.followers=G.yt.subs` kasowało fanów z innych źródeł (Spotify, koncerty, Insta).
  // Poprawnie: dodajemy TYLKO nowych subskrybentów do total followers, nie nadpisujemy.
  G.followers+=newSubs;
  /* v2.1.44 [Amper]: custom tytuł filmu — user-input z karty Publikuj, fallback do G.ytGame */
  const _customYtTitle=(G._ytCustomTitle||'').trim().slice(0,40);
  G.yt.videos.push({title:_customYtTitle||G.ytGame,quality:q,views:baseViews,date:'Dzień '+G.day,genre:G.ytGame});
  G._ytCustomTitle=''; /* reset po publikacji */
  /* v1.9.34: Memory cap — anti-bloat save */
  if(G.yt.videos.length>50) G.yt.videos.shift();
  /* v1.9.31: Prestige fameMult przez addFame() */
  if(typeof addFame==='function') addFame(Math.floor(q/16)); else G.fame=clamp(G.fame+Math.floor(q/16),0,500);
  G.ytRecorded=false;G.ytEdited=false;G.ytQuality=0;
  G.spotify.listeners+=Math.floor(newSubs*.1);
  // Cross-career: świeży film daje boost ×1.5 na 3 kolejne streamy
  G.streamBoostRemaining=3;
  /* v2.1.111: Wave 1 W8 — time-limit expiration (gracz nie może gromadzić boostów w nieskończoność). 7 dni gry = jeden tydzień. */
  G._streamBoostExpiresDay=G.day+7;
  // Sprawdź kontrakt wideo
  if(G.contract&&G.contract.type==='video'){
    G.contract.progress++;
    if(G.contract.progress>=G.contract.target) completeContract();
  }
  addXP(20);progressQuest('yt_video');
  notify(`📤 "${G.ytGame}"! +${baseViews.toLocaleString('pl')} views, +${newSubs} sub, +${income} zł · 🔥 Boost streamu ×1.5 na 3 streamy`);
  renderYTOverlay();
}

