function checkSideStorylines(){
  if(!G.sideQuests) G.sideQuests={};
  Object.entries(SIDE_STORYLINES).forEach(([lineId,line])=>{
    if(!G.sideQuests[lineId]) G.sideQuests[lineId]={step:0,completed:[]};
    const prog=G.sideQuests[lineId];
    if(prog.step>=line.quests.length) return;
    const q=line.quests[prog.step];
    if(q.check()){
      prog.completed.push(q.id);prog.step++;
      /* v1.9.33: BUG FIX side-storyline reward — Prestige money/fame mult przez earn()/addFame() */
      if(q.reward.money){if(typeof earn==='function')earn(q.reward.money,true); else {G.money+=q.reward.money;G.totalEarned=(G.totalEarned||0)+q.reward.money;}}
      if(q.reward.fame){if(typeof addFame==='function')addFame(q.reward.fame); else G.fame=clamp(G.fame+q.reward.fame,0,500);}
      if(q.reward.xp) addXP(q.reward.xp);
      if(q.reward.skillPts) G.skillPoints=(G.skillPoints||0)+q.reward.skillPts;
      confetti(20);
      showMsg(`${line.name} — ${q.em} ${q.name}! Nagroda: +${q.reward.money||0} zł${q.reward.fame?', +'+q.reward.fame+' sławy':''}${q.reward.skillPts?', +'+q.reward.skillPts+' pkt skill':''}`);
