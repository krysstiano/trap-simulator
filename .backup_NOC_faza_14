function addNotif(text){
  /* v2.1.228 audit-fix #58: addNotif spam — gracz miał 100+ powiadomień w kilkanaście minut.
     1) Dedup window rozszerzone 3→10.
     2) Auto-group: same prefix (przed ':') w tej samej porze → UPDATE last z licznikiem ×N zamiast push.
     3) Cap 100→50. */
  const _last10=G.notifications.length>0?G.notifications.slice(-10):[];
  if(_last10.some(n=>n.text===text)) return;
  const _prefix=text.split(':')[0];
  if(_prefix && _prefix.length<=24){
    const _lastEntry=G.notifications[G.notifications.length-1];
    const _curTime='Dz.'+G.day+' '+CFG.PORA[G.timeOfDay];
    if(_lastEntry && _lastEntry.time===_curTime && _lastEntry.text.startsWith(_prefix+':')){
      _lastEntry._groupCount=(_lastEntry._groupCount||1)+1;
      _lastEntry.text=_prefix+' (×'+_lastEntry._groupCount+'): '+text.slice(_prefix.length+1).trim();
      G.notifsUnread=(G.notifsUnread||0)+1;
      return;
    }
  }
  G.notifications.push({text,time:'Dz.'+G.day+' '+CFG.PORA[G.timeOfDay]});
  if(G.notifications.length>50) G.notifications.shift();
  /* v2.1.182 (Agent phone audit): increment unread counter — renderPhoneNotifs resetuje. */
  G.notifsUnread=(G.notifsUnread||0)+1;
  /* v1.9.96: NO sfx w trakcie cinematic — dodaj do log, ale bez dźwięku */
  if(G._cinematicActive) return;
  sfxPhone();
  const _hp=document.getElementById('hphone'); if(_hp) _hp.classList.add('has-new');
}
/* v2.1.228 audit-fix #41: notify forwards type/duration do showMsg. Wcześniej notify('msg','r',5000) → tylko 'msg' dotarło do showMsg, type/duration ignorowane = wszystkie czerwone error toasty od lat były domyślnie żółte/niebieskie. */
function notify(text,type,duration){showMsg(text,type,duration);addNotif(text);}

