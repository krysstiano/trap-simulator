    // v1.8.36: poprzednio (v1.8.14) stopLine=ix±165 bez korekty o szerokość → auta jadące w prawo
    // zatrzymywały się NA pasie zebra (przód wystawał o aw=52px).
    const carW = car.shape==='bus'?92:car.shape==='suv'?56:car.shape==='sports'?60:52;
