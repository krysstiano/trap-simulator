window.finishYTMinigame=function(scorePercent,summary){
  if(window._ytMgCleanup){window._ytMgCleanup();window._ytMgCleanup=null;}
  const camQ=G.camera?G.camera.quality:10;
  const rawMicQ=G.mic?G.mic.quality:10;
  const ifMult=G.mic&&G.mic.type==='xlr'?(G.audioInterface?G.audioInterface.ifMult:0.3):1;
  const micQ=Math.floor(rawMicQ*ifMult);
  const acousticBonus=(G.acousticFoams||0)*3+(G.acousticPanels||0)*6; // #36B stackujące
  const headBonus=G.headphones?Math.floor(G.headphones.quality/20):0;
  // v1.8.97: akcesoria muzyczne (statyw/popfiltr/koszyk) + selfie ring (+8% vlog) realnie aplikowane
  const _accBonus=((G._musicAcc?.statyw)?3:0)+((G._musicAcc?.popfiltr)?2:0)+((G._musicAcc?.koszyk)?4:0);
  const _ringMult=(G._musicAcc?.ring)?1.08:1;
  G.ytQuality=clamp(Math.floor((scorePercent*(camQ/100+.3)+micQ*.12+acousticBonus+headBonus+_accBonus)*_ringMult+rnd(0,10)),5,100);
  G.ytRecorded=true;G.ytEdited=false;
  G.energy=clampStat('energy', G.energy-15);G.hunger=clampStat('hunger', G.hunger-5);
  addXP(10);
  document.getElementById('mg-yt-content').innerHTML=`
    <div style="text-align:center;padding:40px 20px">
      <div style="font-size:64px;margin-bottom:16px">${scorePercent>=80?'🏆':scorePercent>=50?'👍':'😕'}</div>
      <h2 style="color:#e74c3c;margin-bottom:10px">Nagranie gotowe — ${G.ytGame}</h2>
      <div style="font-size:19px;color:#7ec87e;margin-bottom:10px">${summary}</div>
      <div style="font-size:17px;color:#aaa">Jakość nagrania: <b style="color:#f1c40f;font-size:22px">${G.ytQuality}%</b></div>
    </div>`;
  setTimeout(()=>{closeMG();renderYTOverlay();openOverlay();},2800);
};

