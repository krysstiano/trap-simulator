  makeTile('vip_marble',c=>{
    /* v2.0.19 fix: wracamy do estetyki starego marble (czarno-złoty, żyły) ALE z tileable design.
       Problem starego: linear gradient (0,0)→(T,T) i żyły kończące się na krawędziach → widoczne cięcia
       między tilesami. Fix: RADIAL gradient od center (krawędzie tile jednolicie ciemne, znikają granice)
       + żyły wewnątrz tile (z paddingiem 10-15% od krawędzi, nie dotykają brzegu = nie widać cięć). */
    const g=c.createRadialGradient(T/2,T/2,T*0.1,T/2,T/2,T*0.75);
    g.addColorStop(0,'#241808');
    g.addColorStop(0.6,'#140e06');
    g.addColorStop(1,'#0a0a0a');
    c.fillStyle=g;c.fillRect(0,0,T,T);
    /* gold veins WEWNĄTRZ tile (padding 10-15% od krawędzi) */
    c.strokeStyle='rgba(200,165,32,.28)';c.lineWidth=0.8;
    c.beginPath();
    c.moveTo(T*0.12, T*0.42);
    c.bezierCurveTo(T*0.32, T*0.55, T*0.68, T*0.25, T*0.88, T*0.50);
    c.stroke();
    c.beginPath();
    c.moveTo(T*0.28, T*0.85);
    c.bezierCurveTo(T*0.42, T*0.62, T*0.58, T*0.78, T*0.72, T*0.18);
    c.stroke();
  });
}

