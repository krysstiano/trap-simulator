    if(_evo('gamer')){earn(1000,false);_passiveTotal+=1000;addNotif('🎮 E-sport Pro: +1000 zł kontrakt (Evolution Gamer)');}
    if(_evo('influencer')){earn(700,false);_passiveTotal+=700;addNotif('📱 Brand Owner: +700 zł z marki (Evolution Influencer)');}
    if(_evo('soundeng')){earn(900,false);_passiveTotal+=900;addNotif('🎙️ Studio Owner: +900 zł (Evolution Sound Eng.)');}
    if(_evo('youtuber')){earn(1200,false);_passiveTotal+=1200;addNotif('📺 Algorithm Master: +1200 zł (Evolution YouTuber)');}
    if(_evo('beatmaker')){earn(900,false);_passiveTotal+=900;addNotif('🥁 Producent: +900 zł z bitów (Evolution Beatmaker)');}
    if(_evo('inwestycje')){earn(800,false);_passiveTotal+=800;addNotif('📈 Magnat: +800 zł z portfela (Evolution Inwestycje)');}
    // F3-FIX-D: EVOLUTION kreatywnosc 'Geniusz' — co 3 dni nieoczekiwany hit
    // v1.8.62: rebalans — co 5 dni +500/+50 → co 3 dni +1500/+150 (~500 zł/dzień ekwiwalent, ROI ~100 dni przy 50k cenie)
    if(_evo('kreatywnosc')){
      G._kreaLastHit=G._kreaLastHit||G.day;
      if(G.day-G._kreaLastHit>=3){
        G._kreaLastHit=G.day;
        earn(1500,false);_passiveTotal+=1500;
        const fans=150;
        /* v2.1.34: Evolution Geniusz daje LOJALNYCH fanów (hit muzyczny przyciąga prawdziwą publikę) */
