  X.strokeRect(drx+6,dry+6,drw-12,drh-12);

  // Plakat TRAPLIFE — przeniesiony na górną ścianę biura, gdzie nic nie zasłania (#61)
  // Biuro: wx 820-1296, wy 340-734. Górna ściana wy=345-395. Wolne miejsce wx=950-1090.
  const pw=140, ph=50;
  const px=wx2sx(950), py=wy2sy(348);
