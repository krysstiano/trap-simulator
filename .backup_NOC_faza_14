function checkAchievements(){
  // v1.8.18: "anti-achievement" badges (sleep_dep, ewentualnie inne za złe zachowanie)
  // dostają tylko +XP, BEZ +200 zł — nagradzanie zaniedbań nie ma sensu.
  const NEG_ACHIEVEMENTS=['sleep_dep'];
  // v1.9.14: Tiery nagród zamiast flat 200 zł. Łatwe (first_*) — 100, średnie — 500, trudne (millionaire, fans100k) — 2000, legendary (1M fanów, prestige) — 10000.
  /* v2.1.110: REBALANS TIERÓW — dodane brakujące achievementy do tier arrays (Wave 1 W10, Wave 4 K39/W46/S22-S30, Wave 8 S62).
     Wcześniej wiele osiągnięć trudnych dostawało default 100 zł zamiast właściwego tieru. */
  const TIER_LEGENDARY=['fans_1m','1m_followers','penthouse','prestige5','tracks_50','million_plays','mansion_owner', /* v2.1.167 */
    'casino_whale', /* W4 K39: 100k zł kasyno = legendary */
    'casino_megajackpot', /* S22-S30: 50k win = legendary */
    'cover_legend', /* v2.1.108: 5+ okładek */
    'awards_legend', /* v2.1.169: 10 awards wins = legendary */
    'signed_phantom', /* v2.1.169: Phantom MC sign 500k zł = legendary */
    /* v2.1.217 [Amper] BALANS: Tier 3/4 fame milestones + Mega Villa + Crown + HoF — wszystkie endgame = legendary 10k zł */
    'mega_villa_owner', /* 3M zł endgame apt */
    'reach_legendary', /* Tier 3 fame 300+ */
    'reach_goat',      /* Tier 4 fame 400+ */
    'hall_of_fame',    /* Unique Tier 3 random event z statua */
    'crown_of_hh',      /* 100k zł exclusive outfit Tier 4 only */
    'megastar_complete' /* v2.1.235: 7-dniowa trasa świat (Megastar) = endgame legend */];
  const TIER_HARD=['millionaire','100k_followers','tracks_10','signed_label','indie_label','helipad_ride','foodie','old_dog','first_apt_owner',
    'drip_200', /* S22: 200 drip max */
    'music_empire', /* S22: 50k YT subs */
    'investor_pro', /* S22: 50k z inwestycji */
    'casino_poker_royal', /* S22: Royal Flush */
    'awards_5', /* v2.1.169: 5 awards wins = hard */
    'max_forma', /* v2.1.182 (Agent audit): 100/100 forma — najtrudniejszy stat (siła/bench), powinno być hard tier (2000zł) zamiast default 100zł */
    'max_fitness', /* v2.1.182 (Agent audit): 100/100 fitness — analog forma (cardio/bieżnia) */
    'story_all', /* v2.1.228: ukończ story arc ze wszystkimi 3 NPC = endgame story content */
    'wembley_played' /* v2.1.235: stadion 100k osób (Wembley) = endgame tier hard */];
  const TIER_MEDIUM=['1k_followers','first_album','first_concert','tracks_5','first_track','10k_followers','social_butterfly','fame_75',
    'fans_500', /* W1 W10: 500 fanów */
    'casino_high_roller', /* W4 W46: 10k zł kasyno */
    'casino_jackpot', /* W8 S62: 5k+ win */
    'courier_pro', /* S22: 50 dostaw */
    'all_freestyle', /* S22: 25 freestyle */
    '5_day_streak', /* S22 */
    'concert_star', /* S22: 10 koncertów */
    'all_careers', /* S22: 5 karier */
    'cover_boy', /* v2.1.108: pierwsza okładka */
    'all_genres', /* v2.1.169: analog all_careers — wydaj singla w 9 gatunkach */
    'first_award', /* v2.1.169: 1 awards win = medium */
    'label_first_artist', /* v2.1.169: pierwszy podpisany artist = medium */
    'story_marcin','story_kamil','story_producent', /* v2.1.228: 3 individual story arcs = medium */
    'coachella_played' /* v2.1.235: 3-day festival pustynia = endgame tier medium */];
  const _tierReward=(id)=>{
    if(NEG_ACHIEVEMENTS.includes(id)) return 0;
    if(TIER_LEGENDARY.includes(id)) return 10000;
    if(TIER_HARD.includes(id)) return 2000;
    if(TIER_MEDIUM.includes(id)) return 500;
    return 100; // easy/default
  };
  /* v2.1.110: Wave 8 K75 — anty double-claim per achievement.
     `G.achievements` może być wyczyszczone przez quit-load exploit, ale `_achievementsClaimed` persistuje raz-uzyskane nagrody. */
  if(!Array.isArray(G._achievementsClaimed)) G._achievementsClaimed=[];
  for(const ach of ACHIEVEMENTS){
    if(!G.achievements.includes(ach.id)&&ach.check()){
      G.achievements.push(ach.id);
      showAchievementPopup(ach);
      const _r=_tierReward(ach.id);
      addNotif(`${ach.icon} Osiągnięcie: ${ach.name}${_r>0?` (+${_r} zł)`:''}`);
      addXP(25);
      /* v2.1.110: Wypłać reward TYLKO jeśli nigdy wcześniej (lifetime claim flag). */
      if(_r>0 && !G._achievementsClaimed.includes(ach.id)){
        G._achievementsClaimed.push(ach.id);
        if(typeof earn==='function') earn(_r,false); else {G.money+=_r;G.totalEarned=(G.totalEarned||0)+_r;}
      }
    }
  }
  // FOLLOWER MILESTONES — cinematic dla 1k/10k/100k/1M fanów
  if(typeof showMilestoneCinematic==='function' && typeof _milestoneShown==='function'){
    const f=G.followers||0;
    const milestones=[
      {n:1000,key:'fans1k',emoji:'👥',title:'1 000 FANÓW',sub:'Twoja pierwsza tysiączka',tag:'Robisz się rozpoznawalny w mieście',c:'#7ec8e3',c2:'#3498db'},
      {n:10000,key:'fans10k',emoji:'🔥',title:'10 000 FANÓW',sub:'Lokalna gwiazda',tag:'Ludzie cię rozpoznają na ulicy',c:'#e91e8c',c2:'#9b59b6'},
      {n:100000,key:'fans100k',emoji:'⭐',title:'100 000 FANÓW',sub:'Nazwisko warte coś w branży',tag:'Wytwórnie zaczynają pukać do drzwi',c:'#f1c40f',c2:'#e67e22'},
      {n:1000000,key:'fans1m',emoji:'💎',title:'MILION FANÓW',sub:'Status legendy',tag:'Twoje nazwisko zna cała Polska',c:'#c8a520',c2:'#e91e8c'},
    ];
    for(const m of milestones){
      if(f>=m.n && !_milestoneShown(m.key)){
        showMilestoneCinematic({emoji:m.emoji,title:m.title,subtitle:m.sub,tagline:m.tag,accentColor:m.c,accent2:m.c2,duration:m.n>=100000?5000:4000});
        break;
      }
    }
  }
}

