const TRASH_KEY='snowy_v5_trash'; /* JSON array of {slot, data, deletedAt, meta} */
const TRASH_RETENTION_DAYS=7;
function _getTrash(){
  try{const t=localStorage.getItem(TRASH_KEY);return t?JSON.parse(t):[];}catch(e){return [];}
}
function _setTrash(arr){
  try{localStorage.setItem(TRASH_KEY,JSON.stringify(arr));}catch(e){console.warn('trash full:',e.message);}
}
function _cleanupExpiredTrash(){
  const now=Date.now();
  const cutoff=now - TRASH_RETENTION_DAYS*24*60*60*1000;
  const trash=_getTrash().filter(t=>t.deletedAt>cutoff);
  _setTrash(trash);
  return trash;
}
