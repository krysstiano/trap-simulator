// ── LEVEL UP BURST ── potezny wizualny efekt przy awansie ──
let _luBurst=null; // {t, max} dla shock ringu
function triggerLevelUpBurst(){
  if(currentRoom!=='ulica' || typeof emitSpark!=='function') return;
  const cx=P.wx+P.w/2, cy=P.wy+P.h/2;
  // 4 fale iskier w roznych kolorach (zloto, biel, czerwien, lawender)
  const cols=['rgba(255,220,80,','rgba(255,255,255,','rgba(255,150,200,','rgba(200,180,255,'];
  for(let i=0;i<5;i++){
    setTimeout(()=>{
      cols.forEach(col=>emitSpark(cx,cy,col));
      // duza fala zlota co kilkadziesiat ms
      for(let k=0;k<8;k++){
        const a=Math.random()*Math.PI*2, sp=2.5+Math.random()*3;
        _spawnParticle({wx:cx,wy:cy,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-0.8,life:36,max:36,col:'rgba(255,220,80,',size:2+Math.random()*2,grav:0.04});
      }
    },i*60);
  }
  _luBurst={t:0,max:30};
}
function drawLevelUpBurstFX(){
  if(!_luBurst) return;
  if(currentRoom!=='ulica'){_luBurst=null;return;}
  _luBurst.t++;
  if(_luBurst.t>=_luBurst.max){_luBurst=null;return;}
  const a=_luBurst.t/_luBurst.max;
  const cx=wx2sx(P.wx+P.w/2), cy=wy2sy(P.wy+P.h/2);
  X.save();
  // Shock ring rosnacy
  X.strokeStyle=`rgba(255,220,80,${(1-a)*0.85})`;
  X.lineWidth=3;
  X.beginPath();X.arc(cx,cy,12+a*70,0,Math.PI*2);X.stroke();
  X.strokeStyle=`rgba(255,255,255,${(1-a)*0.55})`;
  X.lineWidth=1.5;
  X.beginPath();X.arc(cx,cy,16+a*46,0,Math.PI*2);X.stroke();
  // Promienie swiatla wokol postaci
  X.strokeStyle=`rgba(255,220,80,${(1-a)*0.4})`;
  X.lineWidth=2;
  for(let i=0;i<8;i++){
    const ang=i*Math.PI/4 + a*Math.PI*0.25;
    const r1=20+a*22, r2=42+a*48;
    X.beginPath();X.moveTo(cx+Math.cos(ang)*r1,cy+Math.sin(ang)*r1);
    X.lineTo(cx+Math.cos(ang)*r2,cy+Math.sin(ang)*r2);X.stroke();
  }
  X.restore();
}
