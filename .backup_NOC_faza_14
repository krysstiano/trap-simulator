      const el=document.getElementById('cont-'+j);if(!el)return;
      if(j<i){el.style.background='#0a3a1a';el.style.color='#27ae60';el.style.borderColor='#27ae60';}
      else if(j===i){el.style.background='#2a1a0a';el.style.color='#f1c40f';el.style.borderColor='#f1c40f';}
      else{el.style.background='#101820';el.style.color='#444';el.style.borderColor='#222';}
    }
    const inst=document.getElementById('con-inst');if(inst)inst.textContent=TASKS[i].hint;
    const btn=document.getElementById('con-btn');
    if(btn)btn.textContent=i===0?'🧱 Połóż cegłę!':i===1?'🔨 Mieszaj!':'🔩 Zatwierdź pozycję [Enter]';
    updateProgress();
  }

  function updateProgress(){
    const prog=document.getElementById('con-progress');
    if(prog)prog.textContent=`${taskDone}/${TASKS[taskIdx]?.total||0}`;
  }

  function addFloor(quality){
    const h=16+quality/5;const hue=18+quality;
    floors.push({y:H-50-floors.length*(h+2),h,color:`hsl(${hue},50%,${20+quality/5}%)`,w:180+quality*2.5,q:quality});
  }

  window._conAction=()=>{
    if(over)return;
    const task=TASKS[taskIdx];
    if(taskDone>=task.total)return; // nie pozwol klikac po ukonczeniu etapu
    if(taskIdx===0){// Cegły — timing
      const center=pos+5;const dist=Math.abs(center-(TRACK/2));
      let pts=0,lbl='',col='';
      if(dist<30){pts=25;lbl='💯 PERFEKCJA! +25pkt';col='#f1c40f';}
      else if(dist<70){pts=15;lbl='✅ Dobra robota! +15pkt';col='#27ae60';}
      else if(dist<120){pts=6;lbl='⚠️ Ujdzie +6pkt';col='#f39c12';}
      else{pts=0;lbl='❌ Chybiony!';col='#e74c3c';}
      totalScore+=pts;taskDone++;addFloor(pts);speed=Math.min(10,speed+0.5);
      // Pył przy ułożeniu cegły, iskry przy perfekcji
      const bxCenter=W/2;emitDust(bxCenter,H-50-floors.length*18,8);
      if(pts>=25){emitSparks(bxCenter,H-60-floors.length*18,12,'#f1c40f');sfxSparkle();}
      else sfxBrick();
      const res=document.getElementById('con-result');if(res){res.style.color=col;res.textContent=lbl;}
      updateProgress();
      if(taskDone>=task.total){setTimeout(()=>setTask(1),400);}
    } else if(taskIdx===1){// Beton — szybkie klikanie
      const now=Date.now();
      if(now-lastClickTime<300)clickCombo=Math.min(clickCombo+1,5);else clickCombo=0;
      lastClickTime=now;
      const pts=1+clickCombo;totalScore+=pts;clickCount++;taskDone++;
      // Krople betonu z miksera
      emitDrops(W/2+55+30,80+18,clickCombo>=3?6:2);
      const combo=document.getElementById('con-combo');if(combo)combo.textContent=clickCombo>=3?`🔥 Combo x${clickCombo}!`:'';
      const res=document.getElementById('con-result');if(res){res.style.color=clickCombo>=3?'#e67e22':'#27ae60';res.textContent=clickCombo>=3?`🔥 Combo! +${pts}pkt`:`+${pts}pkt`;}
      updateProgress();
      if(taskDone>=task.total){setTimeout(()=>setTask(2),400);}
    } else if(taskIdx===2){// Belka — pozycja
      if(beamY>beamTarget+40){// za nisko (belka nie podniesiona)
        const res=document.getElementById('con-result');if(res){res.style.color='#e74c3c';res.textContent='❌ Belka za nisko! Trzymaj SPACJĘ dłużej';}
      } else if(beamY<beamTarget-35){// za wysoko (za długo trzymano spację)
        const res=document.getElementById('con-result');if(res){res.style.color='#e67e22';res.textContent='⚠️ Belka za wysoko!';}
      } else {
        const diff=Math.abs(beamY-beamTarget);
        const pts=diff<15?20:diff<30?12:6;totalScore+=pts;beamPlaced++;taskDone++;beamSuccessFlash=30;
        addFloor(pts);
        // Iskry przy spawaniu belki — dużo dla idealnego, mniej dla dobrego
        const bxC=W/2;emitSparks(bxC-80,beamY+11,pts>=20?20:12,'#ffe066');
