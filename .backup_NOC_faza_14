    <div style="padding:6px 12px;border-top:1px solid #1a2535">
      ${actionBtn}
      ${(()=>{
        if(_unrepliedCount===0){
          return `<div style="background:#0a1a0a;border:1px solid #1a4a1a;border-radius:6px;padding:8px 10px;font-size:11px;color:#7ec87e;text-align:center;font-style:italic">✓ Wszystkie wiadomości od ${(SMS_CONTACTS[contactId]||{}).name||contactId} odpowiedziane. Poczekaj na nowe.</div>`;
        }
        const _c=SMS_CONTACTS[contactId];
        const _smsOnly=_c && _c.physical===false;
        const _replyCounter=`<div style="background:#0a1525;border-left:3px solid #3498db;padding:6px 10px;margin-bottom:6px;font-size:10.5px;color:#aac">📨 <b>${_unrepliedCount}</b> do odpowiedzi · Odpowiadasz na: <span style="color:#cdd;font-style:italic">"${(_firstUnreplied?.text||'').slice(0,80)}${(_firstUnreplied?.text||'').length>80?'…':''}"</span></div>`;
        /* fan — fani nie zapraszają do wizyty, fani dziękują */
        if(contactId==='fan'){
          return `${_replyCounter}<div style="display:flex;gap:4px;flex-wrap:wrap">
            <button onclick="_smsQuickReply('${contactId}','thanks')" style="flex:1;background:#1a3525;border:1px solid #2a6a3a;color:#9ee89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">❤️ Dzięki za support (+1 przyjaźń)</button>
            <button onclick="_smsQuickReply('${contactId}','call')" style="flex:1;background:#2a1a35;border:1px solid #6a3a8a;color:#c89eeb;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">🎤 Wkrótce nowy track (+2 przyjaźń)</button>
            <button onclick="_smsQuickReply('${contactId}','later')" style="flex:1;background:#352525;border:1px solid #6a3a3a;color:#e89e9e;padding:8px;border-radius:6px;cursor:pointer;font-size:11px">— Ignoruj (-1 przyjaźń)</button>
