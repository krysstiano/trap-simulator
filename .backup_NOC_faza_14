    let meta={day:'?', money:'?', level:'?', nick:'?'};
    try{
      const parsed=JSON.parse(data);
      meta.day=parsed.G?.day||'?';
      meta.money=parsed.G?.money||0;
      meta.level=parsed.G?.level||1;
      meta.nick=parsed.G?.globalNick||parsed.name||'Bezimienny';
