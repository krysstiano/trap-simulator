    // Pionowe linie szyb (4 segmenty) — solid
    X.fillStyle='#2a4870';
    const sbY=sy+(isNorth?-32:4);
    X.fillRect(sx-30,sbY,1,28);X.fillRect(sx,sbY,1,28);X.fillRect(sx+29,sbY,1,28);
