// ── Muzyczny: Rhythm game ──
function renderRhythmMg(mg){
  let hits=0,misses=0,timeLeft=15;
  const KEYS=['Q','W','E','R'];
  const COLORS=['#e74c3c','#f1c40f','#27ae60','#3498db'];
  const BGRADS=['220,60,60','220,180,0','50,160,50','50,130,200'];
  const notes=[];let noteId=0;const timers=[];
  mg.innerHTML=`
  <div style="text-align:center">
    <h2 style="color:#9b59b6;margin-bottom:4px">🎵 Muzyczny — Rhythm Game!</h2>
    <p style="color:#556;font-size:13px;margin-bottom:8px">Wciskaj Q W E R gdy nuty dotrą do strefy! Czas: <b id="rhy-t" style="color:#f1c40f">15s</b> | Trafień: <b id="rhy-h" style="color:#7ec87e">0</b></p>
    <div style="position:relative;width:480px;height:310px;background:#03060f;border:2px solid #1a1a3a;border-radius:8px;margin:0 auto;overflow:hidden" id="rhy-track">
      ${KEYS.map((k,i)=>`
        <div style="position:absolute;left:${i*120}px;top:0;width:120px;height:100%;border-right:1px solid #0a0a1e">
          <div id="hz-${i}" style="position:absolute;bottom:18px;left:10px;right:10px;height:42px;background:rgba(${BGRADS[i]},.12);border:2px solid ${COLORS[i]};border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;color:${COLORS[i]}">${k}</div>
        </div>
      `).join('')}
      <div id="rhy-notes"></div>
    </div>
    <p style="color:#334;font-size:11px;margin-top:5px">Q W E R — 4 pasy | Traf gdy nuta dotknig strefy</p>
  </div>`;
  const noteEl=document.getElementById('rhy-notes');
  const spawnI=setInterval(()=>{
    const lane=rnd(0,3);const id=noteId++;
    const div=document.createElement('div');
    div.id='n'+id;div.dataset.lane=lane;div.dataset.id=id;
    div.style.cssText=`position:absolute;left:${lane*120+12}px;top:-32px;width:96px;height:30px;background:${COLORS[lane]};border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;box-shadow:0 0 10px ${COLORS[lane]}88`;
    div.textContent=KEYS[lane];
    notes.push({id,lane,y:-32,el:div});noteEl.appendChild(div);
  },680);timers.push(spawnI);
  const tickI=setInterval(()=>{
    for(let i=notes.length-1;i>=0;i--){
      notes[i].y+=5;if(notes[i].el.parentNode)notes[i].el.style.top=notes[i].y+'px';
      if(notes[i].y>310){notes[i].el.remove();notes.splice(i,1);misses++;}
    }
  },33);timers.push(tickI);
  const onKey=(e)=>{
    const ki=KEYS.indexOf(e.key.toUpperCase());if(ki<0)return;e.preventDefault();
    const c=notes.filter(n=>n.lane===ki&&n.y>=195&&n.y<=285);
    if(c.length){
      c[0].el.remove();notes.splice(notes.indexOf(c[0]),1);hits++;
      const h=document.getElementById('rhy-h');if(h)h.textContent=hits;
      const hz=document.getElementById(`hz-${ki}`);if(hz){hz.style.background=`rgba(${BGRADS[ki]},.5)`;setTimeout(()=>{if(hz)hz.style.background=`rgba(${BGRADS[ki]},.12)`;},150);}
    }
  };
  document.addEventListener('keydown',onKey);
  /* v2.1.115: Wave 4 W47 — cleanup callback usuwa keydown listener (memory leak przy early exit). */
  window._ytMgCleanup=()=>{timers.forEach(t=>{clearInterval(t);clearTimeout(t);});document.removeEventListener('keydown',onKey);};
  const countI=setInterval(()=>{
    timeLeft--;const t=document.getElementById('rhy-t');if(t)t.textContent=timeLeft+'s';
    if(timeLeft<=0){
      timers.forEach(t=>{clearInterval(t);clearTimeout(t);});document.removeEventListener('keydown',onKey);
      const total=hits+misses;const acc=total>0?Math.round(hits/total*100):0;
      /* v2.1.228 audit-fix #50: "Pudłów" niepoprawne PL → 3-form: 1 pudło, 2-4 pudła, 5+ pudeł. */
      const _pud=misses===1?'pudło':(misses%10>=2&&misses%10<=4&&(misses%100<10||misses%100>=20))?'pudła':'pudeł';
      const _traf=hits===1?'trafienie':(hits%10>=2&&hits%10<=4&&(hits%100<10||hits%100>=20))?'trafienia':'trafień';
      window.finishYTMinigame(clamp(hits*4+acc*.5,0,100),`${hits} ${_traf} · ${misses} ${_pud} · celność ${acc}%`);
    }
  },1000);timers.push(countI);
  window._ytMgCleanup=()=>{timers.forEach(t=>{clearInterval(t);clearTimeout(t);});document.removeEventListener('keydown',onKey);};
}

function startYTEdit(){
  closeOverlay();
  let clips=[false,false,false,false,false],effects=[false,false,false];
  const renderEdit=()=>{
