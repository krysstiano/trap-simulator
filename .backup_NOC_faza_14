window.previewHaircut=function(hairId,lbl){
  const cvs=document.getElementById('barber-preview');if(!cvs)return;
  const cx=cvs.getContext('2d');
  cx.clearRect(0,0,120,120);
  cx.fillStyle='#0a1220';cx.fillRect(0,0,120,120);
  // Draw simple face — G.skin może być stringiem 'light'/'medium'/'dark' (z kreatora) lub hexem
  const _skin=G.skin||P.skin||'light';
  const skinColor=SKIN_COLS[_skin]||(typeof _skin==='string'&&_skin.startsWith('#')?_skin:'#e0a870');
  const px=60,py=60;
  // v1.9.3: Twarz/szyja PRZED włosami. Oczy/usta DOPIERO PO włosach (żeby fryzura nie zakrywała oczu)
  cx.fillStyle=skinColor;cx.beginPath();cx.arc(px,py+5,28,0,Math.PI*2);cx.fill();
  cx.fillStyle=skinColor;cx.fillRect(px-8,py+28,16,14);
  // ── HAIR ──────────────────────────────────────────
  // v1.9.5/v1.9.8: 10 fryzur — clean silhouettes z gradientami
  const _hairBase=['#2a1808','#1a0a05','#221206','transparent','#150a04','#2a1408','#3a2616','#3a1f10','#2a1208','#3a2818'];
  const _hairLight=['#5a3818','#3a2010','#4a2810','transparent','#2a1606','#5a3018','#6a4a30','#6a3a20','#5a2a18','#6a4838'];
  const baseCol=_hairBase[hairId]||'#2a1808';
  const lightCol=_hairLight[hairId]||'#5a3818';
  // Pomocnik: gradient pionowy (jaśniej u góry, ciemniej u dołu — światło z góry)
  const _hairGrad=(y1,y2)=>{const g=cx.createLinearGradient(0,y1,0,y2);g.addColorStop(0,lightCol);g.addColorStop(0.5,baseCol);g.addColorStop(1,baseCol);return g;};
  if(hairId===0){
    // KRÓTKA — czysta kopuła z naturalnym frontem (grzywką po jednej stronie)
    cx.fillStyle=_hairGrad(py-34,py-2);
    cx.beginPath();
    cx.moveTo(px-26,py-3);
    cx.bezierCurveTo(px-32,py-18, px-22,py-34, px,py-34);
    cx.bezierCurveTo(px+22,py-34, px+32,py-18, px+26,py-3);
    cx.quadraticCurveTo(px+22,py-5, px+18,py-4);
    cx.quadraticCurveTo(px+8,py+2, px-2,py-3);     // przedział grzywki po prawej
    cx.quadraticCurveTo(px-12,py-7, px-22,py-4);
    cx.quadraticCurveTo(px-25,py-3, px-26,py-3);
    cx.closePath();cx.fill();
    // Highlight wzdłuż czubka
    cx.fillStyle='rgba(255,200,140,.18)';
    cx.beginPath();cx.ellipse(px-2,py-26,16,4,-.1,0,Math.PI*2);cx.fill();
  } else if(hairId===1){
    // DŁUGA — czysta sylwetka opadająca do ramion z gładkimi falami
    cx.fillStyle=_hairGrad(py-34,py+30);
    cx.beginPath();
    cx.moveTo(px-28,py+30);                                     // dolny lewy
    cx.bezierCurveTo(px-34,py+10, px-32,py-12, px-26,py-26);    // lewy łuk
    cx.bezierCurveTo(px-18,py-34, px+18,py-34, px+26,py-26);    // czubek
    cx.bezierCurveTo(px+32,py-12, px+34,py+10, px+28,py+30);    // prawy łuk
    cx.bezierCurveTo(px+22,py+32, px+18,py+28, px+15,py+18);    // prawy bok wewnątrz (do twarzy)
    cx.bezierCurveTo(px+22,py+4, px+22,py-8, px,py-10);         // wycięcie przy czole
    cx.bezierCurveTo(px-22,py-8, px-22,py+4, px-15,py+18);
    cx.bezierCurveTo(px-18,py+28, px-22,py+32, px-28,py+30);
    cx.closePath();cx.fill();
    // Subtelny highlight wzdłuż linii fali
    cx.fillStyle='rgba(255,200,140,.12)';
    cx.beginPath();cx.ellipse(px-18,py+4,3,18,-.2,0,Math.PI*2);cx.fill();
    cx.beginPath();cx.ellipse(px+18,py+4,3,18,.2,0,Math.PI*2);cx.fill();
  } else if(hairId===2){
    // v1.9.7: DREDY — styl jak w kreatorze postaci. Proste pionowe pasma z jasnym końcem (tan).
    // Czapka — rectangle + arc top (jak Krótka, ale ciemniejsza)
    const capCol='#221206';
    const tipCol='#c8a060'; // ten sam jasny tan co w kreatorze
    cx.fillStyle=capCol;
    cx.fillRect(px-22,py-22,44,12);
    cx.beginPath();cx.arc(px,py-22,22,Math.PI,0);cx.fill();
    // 9 pionowych pasm wzdłuż całej szerokości czapki
    for(let i=0;i<9;i++){
      const dx=px-22+i*5.5+0.75;
      const dl=30+(i%3)*5; // 30, 35, 40 px varying
      // Ciemna część pasma (top 72%)
      cx.fillStyle=capCol;
      cx.fillRect(dx,py-10,4,dl*0.72);
      // Jasna końcówka (bottom 28%) — tak jak w kreatorze
      cx.fillStyle=tipCol;
      cx.fillRect(dx,py-10+dl*0.72,4,dl*0.28);
      // Subtelny zaokrąglony dół (mała kropka)
      cx.beginPath();cx.arc(dx+2,py-10+dl,2,0,Math.PI*2);cx.fill();
    }
    // Subtelne ciemne linie między pasmami (sugestia przedziałków)
    cx.fillStyle='rgba(0,0,0,.35)';
    for(let i=1;i<9;i++){
      const dx=px-22+i*5.5;
      cx.fillRect(dx-0.5,py-10,1,4);
    }
  } else if(hairId===3){
    // ŁYSY — subtelny połysk na czaszce + cień przy uszach (definicja)
    cx.fillStyle='rgba(255,255,255,.07)';cx.beginPath();cx.ellipse(px-4,py-14,14,5,-.25,0,Math.PI*2);cx.fill();
    cx.fillStyle='rgba(0,0,0,.12)';cx.beginPath();cx.ellipse(px,py+2,28,5,0,0,Math.PI*2);cx.fill();
  } else if(hairId===4){
    // v1.9.7: AFRO — duża pufa NA GÓRZE głowy, NIE zasłania oczu
    // Pozycja: centrum py-25 (powyżej linii oczu), promień max 30 (bottom przy py-5, tuż nad oczami py)
    const ag=cx.createRadialGradient(px-6,py-38,4,px,py-25,30);
    ag.addColorStop(0,lightCol);
    ag.addColorStop(0.65,baseCol);
    ag.addColorStop(1,'#0a0402');
    cx.fillStyle=ag;
    cx.beginPath();cx.ellipse(px,py-24,30,22,0,0,Math.PI*2);cx.fill();
    // Krawędź dolna (gdzie afro spotyka czoło) — delikatny cień
    cx.fillStyle='rgba(0,0,0,.2)';
    cx.beginPath();cx.ellipse(px,py-4,22,3,0,0,Math.PI*2);cx.fill();
    // Tekstura — 3 subtelne fale kędzierzawych włosów na górze (zamiast bąbli)
    cx.fillStyle='rgba(0,0,0,.2)';
    cx.beginPath();cx.arc(px-12,py-32,4,Math.PI,0);cx.fill();
    cx.beginPath();cx.arc(px,py-38,5,Math.PI,0);cx.fill();
    cx.beginPath();cx.arc(px+12,py-32,4,Math.PI,0);cx.fill();
    // Subtelny highlight u góry
    cx.fillStyle='rgba(255,200,140,.18)';
    cx.beginPath();cx.ellipse(px-4,py-36,10,3,-.2,0,Math.PI*2);cx.fill();
  } else if(hairId===5){
    // IROKEZ — czyste, smukłe pasmo z gładkim profilem, boki golone (ciemny cień)
    // Boki — subtelny cień ogolonych włosów
    cx.fillStyle='rgba(0,0,0,.22)';
    cx.beginPath();cx.ellipse(px,py-6,26,20,0,Math.PI,Math.PI*2);cx.fill();
    // Linia fade po bokach
    cx.fillStyle='rgba(20,10,5,.35)';
    cx.beginPath();cx.ellipse(px,py-2,24,4,0,0,Math.PI*2);cx.fill();
    // Środkowy mohawk — wysoki, gładki bezier
    const mg=cx.createLinearGradient(0,py-38,0,py);
    mg.addColorStop(0,lightCol);mg.addColorStop(1,baseCol);
    cx.fillStyle=mg;
    cx.beginPath();
    cx.moveTo(px-9,py);
    cx.bezierCurveTo(px-11,py-22, px-10,py-36, px-2,py-38);
    cx.lineTo(px+2,py-38);
    cx.bezierCurveTo(px+10,py-36, px+11,py-22, px+9,py);
    cx.closePath();cx.fill();
    // Highlight wzdłuż lewej krawędzi mohawk
    cx.fillStyle='rgba(255,180,100,.22)';
    cx.beginPath();
    cx.moveTo(px-7,py-2);
    cx.bezierCurveTo(px-9,py-22, px-8,py-34, px-3,py-36);
    cx.lineTo(px-2,py-34);
    cx.bezierCurveTo(px-6,py-22, px-7,py-4, px-5,py-2);
    cx.closePath();cx.fill();
  } else if(hairId===6){
    // BOKSER (buzz) — bardzo krótka uniform, gradient czaszki + linia fade (bez kropek)
    cx.fillStyle=_hairGrad(py-26,py-2);
    cx.beginPath();
    cx.moveTo(px-25,py-2);
    cx.bezierCurveTo(px-30,py-16, px-22,py-26, px,py-26);
    cx.bezierCurveTo(px+22,py-26, px+30,py-16, px+25,py-2);
    cx.closePath();cx.fill();
    // Linia fade (klasyczna dla buzz)
    cx.fillStyle='rgba(255,255,255,.08)';
    cx.beginPath();cx.ellipse(px-2,py-20,12,3,-.15,0,Math.PI*2);cx.fill();
    // Subtelny cień przy hairline
    cx.fillStyle='rgba(0,0,0,.18)';
    cx.beginPath();cx.ellipse(px,py-3,25,2,0,0,Math.PI*2);cx.fill();
  } else if(hairId===7){
    // LOCZKI — średniej długości kędzierzawe z gładką "obłokową" sylwetką
    cx.fillStyle=_hairGrad(py-32,py+8);
    // Kontur loczków — falisty bezier (jak obłok)
    cx.beginPath();
    cx.moveTo(px-26,py+4);
    cx.bezierCurveTo(px-32,py-8,  px-30,py-22, px-22,py-26);
    cx.bezierCurveTo(px-18,py-32, px-8,py-34,  px,py-32);
    cx.bezierCurveTo(px+8,py-34,  px+18,py-32, px+22,py-26);
    cx.bezierCurveTo(px+30,py-22, px+32,py-8,  px+26,py+4);
    cx.bezierCurveTo(px+22,py+10, px+18,py+6,  px+14,py-2);
    cx.bezierCurveTo(px+8,py-2,   px-8,py-2,   px-14,py-2);
    cx.bezierCurveTo(px-18,py+6,  px-22,py+10, px-26,py+4);
    cx.closePath();cx.fill();
    // 3 dyskretne "fale" loczków (zamiast 12 bąbli)
    cx.fillStyle='rgba(0,0,0,.22)';
    cx.beginPath();cx.arc(px-14,py-22,5,Math.PI,0,false);cx.fill();
    cx.beginPath();cx.arc(px,py-26,5,Math.PI,0,false);cx.fill();
    cx.beginPath();cx.arc(px+14,py-22,5,Math.PI,0,false);cx.fill();
    // Highlight
    cx.fillStyle='rgba(255,180,100,.18)';
    cx.beginPath();cx.ellipse(px-6,py-24,10,3,-.2,0,Math.PI*2);cx.fill();
  } else if(hairId===8){
    // v1.9.7: QUIFF — KOMPLETNY REDESIGN. Klasyczny pomp z asymetrycznym sweep + ostre linie boków (fade)
    // Boki — niskie, "fade" wycięty pod uchem (zamiast bulgi)
    cx.fillStyle=_hairGrad(py-14,py-2);
    cx.beginPath();
    cx.moveTo(px-22,py-2);
    cx.lineTo(px-22,py-10);
    cx.quadraticCurveTo(px-22,py-14, px-16,py-14);   // ostry łuk lewy
    cx.lineTo(px+16,py-14);
    cx.quadraticCurveTo(px+22,py-14, px+22,py-10);   // ostry łuk prawy
    cx.lineTo(px+22,py-2);
    cx.closePath();cx.fill();
    // Pomp — wysoka, ASYMETRYCZNA fala (peak lekko po lewej, sweep do prawej tyłu)
    cx.fillStyle=_hairGrad(py-36,py-14);
    cx.beginPath();
    cx.moveTo(px-16,py-14);
    cx.lineTo(px-15,py-26);                                  // prawie pionowy lewy bok
    cx.quadraticCurveTo(px-12,py-36, px-2,py-36);            // peak po lewej (najwyższy punkt)
    cx.bezierCurveTo(px+8,py-36, px+14,py-30, px+16,py-22);  // gładki sweep do prawej tyłu
    cx.lineTo(px+16,py-14);
    cx.closePath();cx.fill();
    // Tekstura pasm wzdłuż quiffu — pokazuje że to gładko zaczesane
    cx.strokeStyle='rgba(0,0,0,.35)';cx.lineWidth=0.8;
    for(let i=0;i<5;i++){
      cx.beginPath();
      cx.moveTo(px-14+i*7,py-14);
      cx.bezierCurveTo(px-13+i*6, py-24, px-6+i*5, py-32, px-2+i*4, py-34);
      cx.stroke();
    }
    // Połysk żelu wzdłuż peaku
    cx.fillStyle='rgba(255,200,140,.32)';
    cx.beginPath();
    cx.moveTo(px-12,py-28);
    cx.bezierCurveTo(px-10,py-34, px-2,py-35, px+4,py-33);
    cx.lineTo(px+2,py-30);
    cx.bezierCurveTo(px-6,py-30, px-10,py-26, px-12,py-28);
    cx.closePath();cx.fill();
    // Cień ostrego fade'u (pod uchem)
    cx.fillStyle='rgba(0,0,0,.25)';
    cx.fillRect(px-22,py-3,44,2);
  } else if(hairId===9){
    // v1.9.8: BUZZ — bardzo krótki uniform, scalp widoczny, military style
    // Cień skin (zaciemnione od włosów)
    cx.fillStyle='rgba(0,0,0,.35)';
    cx.beginPath();cx.ellipse(px,py-10,24,15,0,Math.PI,Math.PI*2);cx.fill();
    // Equally distributed pattern stubble (dot grid, nie random)
    cx.fillStyle='rgba(60,30,15,.85)';
    for(let row=0;row<5;row++){
      for(let col=0;col<8;col++){
        const sx=px-21+col*6+(row%2)*3;
        const sy=py-22+row*4;
        // Mask within head ellipse
        const dx=(sx-px)/24, dy=(sy-(py-10))/15;
        if(dx*dx+dy*dy<=1.0){
          cx.fillRect(sx,sy,1.4,1.4);
        }
      }
    }
    // Hairline (linia czoła)
    cx.fillStyle='rgba(0,0,0,.5)';
    cx.fillRect(px-22,py-3,44,1.5);
    // High fade (przejście jaśniejsze przy dolnej krawędzi)
    cx.fillStyle='rgba(255,255,255,.06)';
    cx.fillRect(px-22,py-1,44,1);
  }
  // ── FACE FEATURES (po włosach żeby zawsze widoczne) ──
  // Oczy
  cx.fillStyle='rgba(255,255,255,.9)';cx.beginPath();cx.arc(px-9,py,4,0,Math.PI*2);cx.fill();
  cx.beginPath();cx.arc(px+9,py,4,0,Math.PI*2);cx.fill();
  cx.fillStyle='#1a1a2a';cx.beginPath();cx.arc(px-9,py,2.4,0,Math.PI*2);cx.fill();
  cx.beginPath();cx.arc(px+9,py,2.4,0,Math.PI*2);cx.fill();
  // Highlight w oczach
  cx.fillStyle='rgba(255,255,255,.9)';
  cx.beginPath();cx.arc(px-9.6,py-0.6,0.8,0,Math.PI*2);cx.fill();
  cx.beginPath();cx.arc(px+8.4,py-0.6,0.8,0,Math.PI*2);cx.fill();
  // Usta
  cx.strokeStyle='#8a5040';cx.lineWidth=2;cx.beginPath();cx.arc(px,py+10,6,0.2,Math.PI-0.2);cx.stroke();
  const lblEl=document.getElementById('barber-preview-lbl');
  if(lblEl)lblEl.textContent=lbl;
};

