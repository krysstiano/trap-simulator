/* ═══════════════════════════════════════════════════════════════════
   v2.1.0 CREW SYSTEM (Fazy C+D+E)
   ═══════════════════════════════════════════════════════════════════
   G.playerCrew = {id, name, leader_uuid, isLeader, members:[{userId,nick,role}],
             joinedAt, _lastFetch, _lastMsgFetch}
   ⚠ NIE myl z G.crew (legacy = ekipa muzyczna NPC: DJ Olek, grafik Bartek, hype Seba). */
window._crewFetchMyCrew=async function(){
  if(!G.playerUUID) return null;
  /* Sprawdź czy jestem w jakimś crew (crew_members where member_uuid=me) */
  const rows=await _lbFetch(`crew_members?member_uuid=eq.${G.playerUUID}&limit=1`);
  if(!Array.isArray(rows) || rows.length===0){
    if(G.playerCrew){G.playerCrew=null; if(typeof saveGameSilent==='function') saveGameSilent();}
    return null;
  }
  const myMembership=rows[0];
  const crewId=myMembership.crew_id;
  /* Fetch crew + wszystkich członków */
  const [crews,allMembers]=await Promise.all([
    _lbFetch(`crews?id=eq.${crewId}&limit=1`),
    _lbFetch(`crew_members?crew_id=eq.${crewId}&order=joined_at.asc&limit=10`)
  ]);
  if(!Array.isArray(crews) || crews.length===0){
    if(G.playerCrew){G.playerCrew=null; if(typeof saveGameSilent==='function') saveGameSilent();}
    return null;
  }
  const crew=crews[0];
  const members=Array.isArray(allMembers)?allMembers.map(m=>({
    userId:m.member_uuid, nick:m.member_nick||'Member', role:m.role||'member', joinedAt:m.joined_at
  })):[];
  G.playerCrew={
    id:crew.id, name:crew.name, leader_uuid:crew.leader_uuid,
    isLeader:crew.leader_uuid===G.playerUUID,
    members, joinedAt:myMembership.joined_at,
    _lastFetch:Date.now()
  };
  if(typeof saveGameSilent==='function') saveGameSilent();
  return G.playerCrew;
};
window._crewCreate=async function(name){
  if(!G.playerUUID) return {ok:false,error:'Najpierw ustaw nick (Tablica wyników)'};
  name=String(name||'').trim();
  if(name.length<2||name.length>30) return {ok:false,error:'Nazwa 2-30 znaków'};
  if(G.playerCrew) return {ok:false,error:'Już jesteś w crew — opuść je najpierw'};
  const myNick=G.globalNick||'Leader';
  /* INSERT crew (UNIQUE leader_uuid → jeden crew na lidera) */
  const created=await _lbFetch('crews',{
    method:'POST',
    headers:{'Prefer':'return=representation'},
    body:JSON.stringify({name, leader_uuid:G.playerUUID, leader_nick:myNick, max_members:4})
  });
  if(!Array.isArray(created)||created.length===0) return {ok:false,error:'Nie udało się utworzyć crew (może już masz crew?)'};
  const crewId=created[0].id;
  /* INSERT moje członkostwo jako leader */
  const memberInsert=await _lbFetch('crew_members',{
    method:'POST',
    headers:{'Prefer':'return=minimal'},
    body:JSON.stringify({crew_id:crewId, member_uuid:G.playerUUID, member_nick:myNick, role:'leader'})
  });
  if(memberInsert===null){
    /* Rollback: usuń crew */
    await _lbFetch(`crews?id=eq.${crewId}`,{method:'DELETE'});
    return {ok:false,error:'Błąd dodania lidera (może już jesteś w innym crew?)'};
  }
  await _crewFetchMyCrew();
  if(typeof showMsg==='function') showMsg('🏆 Crew "'+name+'" utworzona — zapraszaj znajomych!','g',4500);
  return {ok:true,crewId};
};
window._crewLeave=async function(){
  if(!G.playerCrew) return;
  const crewId=G.playerCrew.id;
  const wasLeader=G.playerCrew.isLeader;
  const otherMembers=G.playerCrew.members.filter(m=>m.userId!==G.playerUUID);
  if(wasLeader && otherMembers.length>0){
    /* Transfer leadership na najwcześniej dołączonego członka */
    const newLeader=otherMembers[0];
    await _lbFetch(`crews?id=eq.${crewId}`,{
      method:'PATCH',
      body:JSON.stringify({leader_uuid:newLeader.userId, leader_nick:newLeader.nick})
    });
    await _lbFetch(`crew_members?crew_id=eq.${crewId}&member_uuid=eq.${newLeader.userId}`,{
      method:'PATCH',
      body:JSON.stringify({role:'leader'})
    });
  }
  /* Usuń moje członkostwo */
  await _lbFetch(`crew_members?crew_id=eq.${crewId}&member_uuid=eq.${G.playerUUID}`,{method:'DELETE'});
  /* Jeśli byłem leaderem i nikt nie został → disband */
  if(wasLeader && otherMembers.length===0){
    await _lbFetch(`crews?id=eq.${crewId}`,{method:'DELETE'});
  }
  G.playerCrew=null;
  if(typeof saveGameSilent==='function') saveGameSilent();
  if(typeof showMsg==='function') showMsg('👋 Opuściłeś crew','i');
};
window._crewDisband=async function(){
  if(!G.playerCrew||!G.playerCrew.isLeader) return;
  await _lbFetch(`crews?id=eq.${G.playerCrew.id}`,{method:'DELETE'});
  G.playerCrew=null;
