    const resPieces=[];
    hands.forEach((h,hi)=>{
      const pv=_handValue(h.cards);
      const isBJ=h.cards.length===2 && pv===21;
      /* v2.0.14: surrendered handled w _bjSurrender — pomiń tutaj */
      if(h.surrendered){return;}
