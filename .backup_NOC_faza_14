// Działa dla: health, energy, hunger (3 staty z dynamicznym max)
// Inne staty (fame, stress, fitness, forma) mają swoje sztywne maxy gdzie indziej
function getMaxStat(name){
  if(!G) return 100;
  /* v2.1.194: forma ZAWSZE max 100 (user feedback "ujednolić z kondycją"). Wcześniej Evo Sila +10 i Evo Dieta +5 dawały max 115 — działało, ale dawało znikome bonusy (3-7pp w drobnych formułach). Teraz spójność z kondycją + UI bench (L24947) `/100` hardcoded już pasuje. Evo Sila i Evo Dieta zachowują inne bonusy (getSilaBonus +50%, getDietaEnergyBonus +25%). */
  if(name === 'forma'){
    return 100;
  }
  if(name === 'fitness'){
    /* v2.1.193: usunięty ghost evo bonus +max fitness (user feedback "115 nie istnieje w grze").
       Wcześniej Evo Dieta +5 i Evo Bieg +10 → teoretyczny max 115, ale gameplay capował fitness na 100.
       Teraz: kondycja ZAWSZE max 100. Evo Bieg zachowuje +0.30 do P.spd (w formule prędkości), Evo Dieta zachowuje swoje pozostałe efekty (energy bonus / hunger). */
    return 100;
  }
  if(!['health','energy','hunger'].includes(name)) return 100;
  let bonus = 0;
  if((G.forma||0) >= 100) bonus += 10;     // bonus +10 z formy=100
  if((G.fitness||0) >= 100) bonus += 10;   // bonus +10 z kondycji=100
  return 100 + bonus;
}
// Clamp do dynamicznego max (zastępuje sztywne clamp(val, 0, 100) dla 3 statów)
function clampStat(name, val){
  return Math.max(0, Math.min(getMaxStat(name), val));
}

/* v2.1.26: PRZEJEDZENIE — wszystko natychmiastowe, gracz widzi info, decay 3pkt/min real.
   Konsekwencje (NATYCHMIAST przy przekroczeniu progu, nie per-tick):
     0-15:  zdrowo, brak efektów
     15-40 (lekkie): -3 forma, -3 kondycja jednorazowo gdy wchodzi w przedział
     40-70 (średnie): dodatkowo -5 forma, -5 kondycja, -5 nastrój
     70+  (poważne): dodatkowo -10 forma, -10 kondycja, -5 zdrowie, -5 nastrój
   Decay: 3 pkt na 1 minutę real (znacznie szybciej niż v2.1.23). */
function eatFood(amount){
  if(!amount || amount <= 0) return G.hunger || 0;
  const maxH = getMaxStat('hunger');
  const cur = G.hunger || 0;
  const newH = cur + amount;
  const prevOvereat = G.overeat || 0;
  if(newH > maxH){
    G.overeat = prevOvereat + (newH - maxH);
    /* Penalty za marnowanie jedzenia przy głód>80 */
    if(cur > 80) G.overeat += 2;
    /* NATYCHMIASTOWE efekty przy przekroczeniu progów */
    const newOvereat = G.overeat;
    /* Próg 15 (lekkie) */
    if(prevOvereat < 15 && newOvereat >= 15){
      G.forma = (G.forma||0) - 3;
      G.fitness = (G.fitness||0) - 3;
      if(typeof showMsg==='function') showMsg('😬 Przejedzenie — czujesz lekki dyskomfort. -3 forma, -3 kondycja','r',4500);
    }
    /* Próg 40 (średnie) */
    if(prevOvereat < 40 && newOvereat >= 40){
      G.forma = (G.forma||0) - 5;
      G.fitness = (G.fitness||0) - 5;
      G.stress = Math.max(0, (G.stress||0) - 5);
      if(typeof showMsg==='function') showMsg('🤢 Przejedzenie ŚREDNIE — robi się ciężko. -5 forma, -5 kondycja, -5 nastrój','r',5500);
    }
    /* Próg 70 (poważne) */
    if(prevOvereat < 70 && newOvereat >= 70){
      G.forma = (G.forma||0) - 10;
      G.fitness = (G.fitness||0) - 10;
      G.health = clampStat('health', (G.health||0) - 5);
      G.stress = Math.max(0, (G.stress||0) - 5);
      if(typeof showMsg==='function') showMsg('🤮 PRZEJEDZENIE POWAŻNE — fatalnie! -10 forma, -10 kondycja, -5 zdrowie. Idź pobiegaj!','r',7000);
    }
    /* Clamp dolne — forma/kondycja max -50 */
    if(G.forma < -50) G.forma = -50;
    if(G.fitness < -50) G.fitness = -50;
    /* OSTRZEŻENIE jeśli gracz dostał JAKIEKOLWIEK przejedzenie (poniżej 15) */
    if(prevOvereat === 0 && newOvereat > 0 && newOvereat < 15){
      if(typeof showMsg==='function') showMsg(`🍔 Zjadłeś za dużo — masz +${Math.floor(newOvereat)} przejedzenia. Przy 15+ zaczną się kary dla formy/kondycji.`,'f',5000);
    }
  }
  return Math.max(0, Math.min(maxH, newH));
}

/* v2.1.26: XP cap helper — limit 1× XP per source per minutę real.
   Stosowane do jedzenia (gdy gracz NIE przejedzony) i odpoczynku (ławki/staw/akwarium). */
function addXPCapped(amount, source, capMs){
  if(!amount || amount <= 0) return false;
  if(typeof capMs !== 'number') capMs = 60000; /* domyślnie 1 minuta */
  if(!G._xpCapTimers) G._xpCapTimers = {};
  const last = G._xpCapTimers[source] || 0;
  const _now = Date.now();
  if(_now - last < capMs) return false; /* cap aktywny — bez XP */
  G._xpCapTimers[source] = _now;
  if(typeof addXP === 'function') addXP(amount);
  return true;
}

/* v2.1.26: helper dla XP z jedzenia — pomija gdy gracz ma przejedzenie ≥15 */
function addXPFoodCapped(amount){
  if((G.overeat || 0) >= 15) return false; /* przejedzony = brak XP */
  return addXPCapped(amount, 'food', 60000);
}

