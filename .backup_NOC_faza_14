async function _ensurePermission(handle,mode){
  if(!handle||!handle.queryPermission) return false;
  try{
    if((await handle.queryPermission({mode}))==='granted') return true;
    return (await handle.requestPermission({mode}))==='granted';
  }catch{return false;}
}
async function writeToFileHandle(payload){
  if(!_saveFileHandle) return false;
  try{
    if(!await _ensurePermission(_saveFileHandle,'readwrite')) return false;
    const w=await _saveFileHandle.createWritable();
    await w.write(payload);await w.close();
    return true;
  }catch{return false;}
}
async function readFromFileHandle(){
  if(!_saveFileHandle) return null;
  try{
    if(!await _ensurePermission(_saveFileHandle,'read')) return null;
    const f=await _saveFileHandle.getFile();
    const txt=await f.text();
    return txt&&txt.length>10?txt:null;
  }catch{return null;}
}
