          const passedRecently = dirSign>0 ? (car.wx < car.skipUntilWx) : (car.wx > car.skipUntilWx);
          if(passedRecently && Math.abs(dist)<200) continue;
          if(dist>0 && dist<60){
            const brake=Math.max(0,Math.min(1,(dist-8)/55));
