    document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">⚠️ Już dziś braleś — wróć jutro.</span>';return;
  }
  if((G.money||0)<1500){
    document.getElementById('bar-result').innerHTML='<span style="color:#e74c3c">⚠️ Dealer chce 1500 zł — nie masz tyle.</span>';return;
  }
  G.money-=1500;
  if(typeof spent==='function') spent(1500);
  G._lastCokeDay=G.day;
  G._drugUses=(G._drugUses||0)+1;
  /* 10% bust chance */
  if(Math.random()<0.10){
    /* Police bust */
    const fine=Math.min(G.money+1500, 5000);
    G.money=Math.max(0, G.money-fine+0); /* fine sits on remaining + reservation */
    if(typeof addFame==='function') addFame(-8); else G.fame=Math.max(0,(G.fame||0)-8);
    G.streetRep=Math.max(0,(G.streetRep||0)-10);
    G.health=Math.min(G.health||100, 25);
    document.getElementById('bar-result').innerHTML=`<span style="color:#e74c3c;font-weight:700">🚔 WPADKA! Policjanci wpadli do toalety. Mandat -${fine.toLocaleString('pl')} zł, -8 sławy, -10 rep, zdrowie spadło do 25.</span>`;
    if(typeof notify==='function') notify('🚔 Policja zrobiła Ci kontrolę w toalecie kasyna! Drogi mandat.','r',7000);
    if(typeof addNotif==='function') addNotif('🚔 Wpadka u dealera (kokaina)');
    if(typeof updateHUD==='function') updateHUD();
    return;
  }
  /* Success: stat boost */
  G.energy=Math.min(typeof getMaxStat==='function'?getMaxStat('energy'):100, (G.energy||0)+60);
  G.stress=Math.min(100, (G.stress||0)+50);
