async function _lbAddFriendBtn(){
  const input=document.getElementById('add-friend-input');
  const status=document.getElementById('add-friend-status');
  if(!input||!status) return;
  const code=input.value.trim().toUpperCase();
  if(!code){status.style.color='#e74c3c';status.textContent='❌ Wpisz kod';return;}
  /* v2.1.115: Wave 4 W44 — rate limit per-user (anti-spam zaproszeń). */
  const _now=Date.now();
  if(window._lastFriendReqTime && (_now-window._lastFriendReqTime)<60000){
    const _s=Math.ceil((60000-(_now-window._lastFriendReqTime))/1000);
    status.style.color='#f39c12';status.textContent=`⏳ Poczekaj ${_s}s przed kolejnym zaproszeniem`;return;
  }
  window._lastFriendReqTime=_now;
  status.style.color='#aac';status.textContent='⏳ Wyszukuję...';
  /* v2.1.115: Wave 4 W43 — try/catch dla Supabase fetch (offline mode → komunikat zamiast silent fail). */
  let r;
  try{
    r=await addFriend(code);
  }catch(e){
    status.style.color='#e74c3c';status.textContent='❌ Brak połączenia z serwerem. Sprawdź internet i spróbuj ponownie.';return;
  }
  if(!r.ok){status.style.color='#e74c3c';status.textContent='❌ '+r.error;return;}
  /* v2.1.0: różny komunikat dla auto-accept (drugi gracz już zaprosił mnie) vs pending */
  if(r.autoAccepted){
    status.style.color='#27ae60';status.textContent='✅ Dodano: '+r.friend.nick+' (auto-akceptacja)';
  } else {
    status.style.color='#9b59b6';status.textContent='📤 Zaproszenie wysłane do '+r.friend.nick+' — czeka na akceptację';
  }
  input.value='';
  setTimeout(()=>renderPhoneFriends(),900);
}
