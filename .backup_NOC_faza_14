      try{if(typeof bgmAudio!=='undefined' && bgmAudio){window._sqBgmPrevVol=bgmAudio.volume;bgmAudio.volume=Math.min(bgmAudio.volume,0.05);}}catch(e){}
      stepTimer=setInterval(()=>{playStep2();calcQuality();},60000/((window._sqBpm||90)*4));
    } else {
      clearInterval(stepTimer);
      // Przywróć BGM
      try{if(typeof bgmAudio!=='undefined' && bgmAudio && typeof window._sqBgmPrevVol==='number'){bgmAudio.volume=window._sqBgmPrevVol;}}catch(e){}
    }
    renderGrid(); // refresh blocked-state visualizacji
  };

  window._sqFinish=()=>{
    if(stepTimer)clearInterval(stepTimer);playing=false;
    try{if(typeof bgmAudio!=='undefined' && bgmAudio && typeof window._sqBgmPrevVol==='number'){bgmAudio.volume=window._sqBgmPrevVol;}}catch(e){}
    G.careers.beatmaker.beats++;G.energy=clampStat('energy', G.energy-20);G.streetRep=clamp(G.streetRep+5,0,100); /* v1.8.61: bit +3 → +5 (user: max 5) */
    // F3-FIX-D: KREATYWNOŚĆ + SKUPIENIE (Master Mind +25% jakości aktywności)
    quality=Math.round(quality*getMoodMod()*getSleepMod()*getKreatywnoscQualityBonus()*getSkupienieFocusBonus());
    // v1.8.95: Inspiracja bonus realnie aplikowany — +20% do jakości następnej produkcji (event Inspiracja w studio)
    // Wcześniej flaga G._inspirationBonus była ustawiana ale nigdy nie czytana.
    if((G._inspirationBonus||0)>0){
      quality=Math.round(quality*1.20);
      G._inspirationBonus=Math.max(0,(G._inspirationBonus||0)-1);
      addNotif('💡 Inspiracja boost: +20% jakości bitu!');
    }
    // v1.8.96: Studio Boom — festiwal podnosi jakość nagrań
    const _rqBoost=typeof festivalEffect==='function'?(festivalEffect('recordingQualityBoost')||1):1;
    if(_rqBoost>1){
      quality=Math.min(100,Math.round(quality*_rqBoost));
      addNotif('🎚️ Studio Boom — jakość bitu podbita!');
    }
    if(getMoodMod()<0.88) addNotif('😓 Niski nastrój obniżył jakość bitu!');
    addXP(Math.round(15*quality/100*2));
    // Store in currentTrack if launched from DAW
    if(G._dawMode){G.currentTrack.beatQ=quality;G._dawMode=false;}
    if(G.contract&&G.contract.type==='beat'){G.contract.progress++;if(G.contract.progress>=G.contract.target) completeContract();}
    progressQuest('beat');
    notify(`🎹 Bit stworzony! Jakość: ${quality}% · Łącznie: ${G.careers.beatmaker.beats}`);
    /* v2.1.137: pierwszy beat cinematic (analogicznie do debut album L17491) — wcześniej tylko toast notify, niespójność z innymi "first" events. */
    if((G.careers?.beatmaker?.beats||0)===1 && !G._firstBeatShown && typeof showMilestoneCinematic==='function'){
      G._firstBeatShown=true;
      showMilestoneCinematic({emoji:'🥁',title:'PIERWSZY BIT',subtitle:'Twój pierwszy beat stworzony',tagline:'Gotowy do sprzedaży lub nagrania wokalu',accentColor:'#9b59b6',accent2:'#e91e8c',duration:4000});
    }
    const tok=_jobPanelSession;panel.classList.remove('on');
    document.getElementById('mg-job-content').innerHTML='';
    // v1.8.18: pipeline bit → miks → master — gdy gracz w DAW, przenieś automatycznie do recording
    // (lub miksera jeśli ma już wokal), zamiast wracać do beatmaker overlay.
    setTimeout(()=>{
      if(_jobPanelSession!==tok) return;
      if(G.currentTrack?.beatQ>0 && G.hasDaw){
        // Sugerowany następny krok: jeśli brak wokalu i ma mic → recording; inaczej mixer.
        const _nextTab = (G.mic && !G.currentTrack.vocalQ) ? 'recording' : 'mixer';
