        <button onclick="window._plinkoDrop()" ${ok?'':'disabled'} style="margin-left:14px;background:${ok?'#27ae60':'#3a3a3a'};color:#fff;border:none;padding:10px 24px;border-radius:8px;font-weight:700;cursor:${ok?'pointer':'not-allowed'};font-family:inherit" title="${ok?'Spuść kulkę!':bet<10?'Minimalna stawka 10 żetonów':'Brak żetonów'}">🟡 SPUŚĆ KULKĘ</button>
      </div>
      <canvas id="plinko-canvas" width="500" height="380" style="display:block;margin:0 auto;background:linear-gradient(180deg,#0a0f1a,#1a1a2a);border:1px solid #2a3a4a;border-radius:8px"></canvas>
