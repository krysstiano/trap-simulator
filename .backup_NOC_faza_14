    if(pay>0) { if(typeof earn==='function') earn(pay,false); else { G.money+=pay; G.totalEarned=(G.totalEarned||0)+pay; } }
    else { G.money+=pay; /* negative pay = kara, no earn() */ }
    G.energy=clampStat('energy', G.energy-3); // v1.8.59: pizza 6→3 (-70% od oryginału 10)
    if(r) r.textContent=`${msg} ${pay>=0?'+':''}${pay} zł`;
    // BALANS #65: pizza +1 → +1 co 3 pizzę (rep nie powinno rosnąć tak szybko)
    if(orderCompleted%3===0) G.streetRep=clamp(G.streetRep+1,0,100);
