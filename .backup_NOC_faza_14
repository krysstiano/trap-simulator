          if(typeof showMsg==='function')showMsg(`✅ Beat zapisany (${quality}%). Następny krok: ${_nextTab==='recording'?'🎤 Nagraj wokal':'🎚️ Zmiksuj'}`,'g',5000);
          return;
        }
      }
      openCareerOverlay('beatmaker');
    },300);
  };

  window._jobMgCleanup=()=>{
    if(stepTimer)clearInterval(stepTimer);playing=false;
    try{if(typeof bgmAudio!=='undefined' && bgmAudio && typeof window._sqBgmPrevVol==='number'){bgmAudio.volume=window._sqBgmPrevVol;}}catch(e){}
    panel.classList.remove('on');panel.style.display='none';document.getElementById('mg-job-content').innerHTML='';
  };
  renderGrid();calcQuality();
} // end _initSequencer
} // end startBeatSequencerMG
function sellBeat(){
  /* v2.1.86 Amper: BUFF sellBeat — cooldown 180→90 min, base 30-120→100-300, quality scaling ×1.5→×3.
     Beatmaker był ekonomicznie martwy (max ~80 zł/dzień). Po buffie ~3-5k/dzień przy aktywnym graniu.
     v2.1.110: Wave 1 K7 — absolute timestamp (gameMin wraps przy day++ → permanent lock). Port jak v2.1.87 koncert. */
  const _nowAbs=(G.day||1)*1440 + (gameMin||0);
  const _lastAbs=G._lastBeatSellAbs||-9999;
  if(_nowAbs-_lastAbs<90){
    const _m=Math.ceil(90-(_nowAbs-_lastAbs));
    if(typeof showMsg==='function')showMsg(`💰 Klient przyjdzie po następny bit za ${_m} min gry`,'r');
    return;
  }
  const midiQ=G.midiCtrl?G.midiCtrl.quality:10;G.totalEarned=G.totalEarned||0;
  const bmSkMult=getKarieraBonus('beatmaker'); // F3-FIX-B
  // v1.8.51: cena bitu uwzględnia teraz jego JAKOŚĆ (z sekwencera) — bity 90% kosztowały tyle samo co 30%
  const _bQ = G._lastBeatQ || 50;
  let price=Math.floor((rnd(100,300)+Math.floor(midiQ*2)+Math.floor(_bQ*3))*bmSkMult);
  // v1.8.99: Skill Produkcja level scaling — +20% za poziom 2, +50% za 4 (zgodnie z opisem "Sampling" / "Ekskluzywne bity")
  if(typeof getRaperST==='function'){
    const prodLvl=getRaperST('produkcja')||0;
    if(prodLvl>=4) price=Math.floor(price*1.5);
    else if(prodLvl>=2) price=Math.floor(price*1.2);
  }
  // v1.8.99: Biurko Pro — +10% zarobek z Beat
  if(G.aptPurchases?.furniture?.includes('desk_pro')) price=Math.floor(price*1.10);
  if(G.managementDeal) price=Math.floor(price*G.managementBonus);
  if(G.crew.some(c=>c.role==='dj')) price=Math.floor(price*1.15);
  G._lastBeatSellAbs=_nowAbs;G._lastBeatSellMin=gameMin||0; /* v2.1.110: absolute timestamp + legacy field zachowany */
  /* v1.9.30: Prestige moneyMult przez earn() */
  if(typeof earn==='function') earn(price,false); else {G.money+=price;G.totalEarned=(G.totalEarned||0)+price;}
  G.careers.beatmaker.beatsSold++;G.careers.beatmaker.beats--;addXP(20);
  progressQuest('beat_sell');
  notify(`💰 Sprzedano bit za ${price} zł!${G.crew.some(c=>c.role==='dj')?' 🎧 +15% DJ bonus':''}`);renderBeatmakerOverlay();
}
function releaseBeat(){
  /* v2.1.104: K66 fix — quality DYNAMIC (z G._lastBeatQ jak w sellBeat) zamiast hardcoded 50.
     Plus skaluje streamy z jakością: niska quality (20%) = mniej słuchaczy, wysoka (90%) = więcej. */
  const _bq = Math.max(20, Math.min(100, G._lastBeatQ || 50));
  const _qualityMult = 0.5 + (_bq/100); // 1.0× przy 50%, 1.4× przy 90%, 0.7× przy 20%
  let gain=Math.round(rnd(50,200) * _qualityMult);
  /* v2.1.124: Wave 1 W5 — streamBoost dystrybutora dla beat (Empire ×1.3, AWAL ×1.2). Wcześniej tylko singel/album. */
  const _distBoostBeat=(G.distributor?.streamBoost)||1;
