  };
  /* v2.0.22: tylko sync bez _render — _render w oninput powodował że focus znikał między keystrokes (input rebuild) */
  window._slotsOnBetInput=()=>{_syncBetFromInput();};
  const _drawReels=(rel=null)=>{
    const cv=document.getElementById('slots-cv');if(!cv)return;
    const cx=cv.getContext('2d');
    cx.clearRect(0,0,320,200);
