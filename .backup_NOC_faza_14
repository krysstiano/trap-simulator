const TRAFFIC_INTERSECTIONS=[
  {wx:864,wy:480},  {wx:864,wy:2016}, {wx:864,wy:2976},  // V1
  {wx:2304,wy:480}, {wx:2304,wy:2016},{wx:2304,wy:2976}, // V2
