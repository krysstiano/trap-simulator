    {id:'skyline',label:'🌆 Skyline Tour',cost:isVip?500:2000,desc:'Lot nad centrum — 15 min nad wieżowcami. Foto op.',fame:3,followers:80,fans:15,xp:15},
    {id:'mountain',label:'⛰️ Lot widokowy',cost:isVip?800:3000,desc:'Lot poza miasto — góry + jezioro. Dłuższy lot.',fame:5,followers:150,fans:30,xp:25},
    {id:'sunset',label:'🌅 Sunset Photo Op',cost:isVip?1500:5000,desc:'Premium lot zachodnio — fotka która rozpala social media.',fame:8,followers:300,fans:60,xp:40},
  ];
  document.getElementById('ov-content').innerHTML=`
    <h2 style="color:#f1c40f;text-align:center">🚁 Helipad VIP</h2>
    <p style="text-align:center;color:#aaa;margin-bottom:8px">${isVip?'<span style="color:#27ae60">✨ Lot DARMOWY — mieszkasz w Penthouse</span>':'Cena lotu: <span style="color:#f1c40f">'+baseCost+' zł</span> (Penthouse Luxury: darmowy)'}</p>
    <div style="background:#0a1a2a;border:1px solid #1a3a5a;border-radius:8px;padding:10px 14px;margin:10px auto 14px;max-width:540px;font-size:11px;color:#7ec8e3;line-height:1.5">
      💬 <b style="color:#f1c40f">Pilot Marek</b>: "Wsiadaj szefie! Wieziemy Cię gdzie chcesz. Tym razem mam też ofertę specjalną — <b>tour widokowy</b> dla mediów społecznościowych. ${_tourCount>=5?'Jesteś już moim stałym klientem! 🏆':_tourCount>0?`Latałeś ze mną ${_tourCount} razy. Trzymaj się ${_tourCount>=3?'🥈':'👋'}`:'Pierwszy raz? Polecam Skyline Tour na start.'}"
    </div>
    <p style="text-align:center;color:#aaa;font-size:12px;margin-bottom:6px">📍 Szybki transport (-10 energii, 30 min cooldown):</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin:8px auto 16px;max-width:540px">
      ${dests.map(d=>`<button onclick="window._heliGoto('${d.id}')" style="background:#1a3a5a;border:1px solid #c8a520;color:#fff;padding:14px;cursor:pointer;border-radius:8px;font-family:inherit;font-size:14px">${d.label}</button>`).join('')}
    </div>
    <p style="text-align:center;color:#aaa;font-size:12px;margin-bottom:6px">🌆 Lot widokowy (1/dzień, większy reward):</p>
    ${_todayTour?`<div style="text-align:center;color:#778;font-size:12px;margin-bottom:14px;background:#0a1a0a;border:1px solid #1a3a1a;border-radius:6px;padding:8px 14px;max-width:540px;margin-left:auto;margin-right:auto">⏳ Tour już dziś wzięty. Wróć jutro.</div>`:`
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin:8px auto 14px;max-width:540px">
      ${tours.map(t=>{const blocked=G.money<t.cost||(G.energy||0)<15;return `<button onclick="window._heliTour('${t.id}')" ${blocked?'disabled':''} style="background:${blocked?'#0a0a0a':'#2a1f0a'};border:1px solid ${blocked?'#222':'#f1c40f'};color:${blocked?'#444':'#fff'};padding:12px;cursor:${blocked?'not-allowed':'pointer'};border-radius:8px;font-family:inherit;font-size:12px;text-align:left">
        <b>${t.label}</b><br>
        <span style="font-size:10px;color:#aaa">${t.desc}</span><br>
        <span style="font-size:10px;color:#c8a520">${t.cost.toLocaleString('pl')} zł · +${t.fame} sławy · +${t.followers} obs.</span>
      </button>`;}).join('')}
    </div>`}
    <div style="text-align:center"><button onclick="closeOverlay()" class="cbtn">← Anuluj</button></div>
  `;
  window._heliGoto=(id)=>{
    const d=dests.find(x=>x.id===id);
    if(d&&d.fn)d.fn();
  };
  window._heliTour=(id)=>{
    const t=tours.find(x=>x.id===id);
    if(!t) return;
    if(G._lastHeliTourDay===G.day){if(typeof showMsg==='function')showMsg('🚁 Już dziś brałeś tour. Wróć jutro.','r');return;}
    /* Loyalty discount: 6+ tours = -20% */
    const finalCost=((G._heliTours||0)>=5)?Math.floor(t.cost*0.80):t.cost;
    if(G.money<finalCost){if(typeof showMsg==='function')showMsg('Brak kasy na tour!','r');return;}
    if((G.energy||0)<15){if(typeof showMsg==='function')showMsg('⚡ Za mało energii (potrzeba 15).','r');return;}
    G.money-=finalCost;
    if(typeof spent==='function') spent(finalCost);
    G.energy=Math.max(0,G.energy-15);
    if(typeof gameMin==='number') gameMin+=30;
    G._lastHeliTourDay=G.day;
    G._heliTours=(G._heliTours||0)+1;
    if(typeof addFame==='function') addFame(t.fame); else G.fame=clamp((G.fame||0)+t.fame,0,500);
    G.followers=(G.followers||0)+t.followers;
    if(typeof addFans==='function') addFans(t.fans);
    if(typeof addXP==='function') addXP(t.xp);
    closeOverlay();
    if(typeof showMsg==='function') showMsg(`🚁 ${t.label} ukończony! +${t.fame} sławy, +${t.followers} obs., +${t.fans} fanów`,'g',5000);
    if(typeof confetti==='function') confetti(20);
    /* Achievement check — Pilot's Wings (5 tours) */
    if((G._heliTours||0)===5 && typeof showMsg==='function') showMsg('🏆 Pilot Marek: "Stały klient! Następny tour ze zniżką 20%." (Easter egg discount na 6+ tour aktywny)','g',6000);
    if(typeof saveGameSilent==='function') saveGameSilent();
  };
  openOverlay();
}

