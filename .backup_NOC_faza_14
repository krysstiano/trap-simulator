  }
  G.label.type=type;
  const msg=type==='indie'?'🏠 Własna wytwórnia założona! Zachowujesz 100% tantiemów.':type==='major'?(G.label.advance>0?'🏢 Kontrakt podpisany! +10 000 zł zaliczki. Wytwórnia bierze 50% tantiemów.':'🏢 Kontrakt wznowiony (bez zaliczki — była już wypłacona)'):'🌍 GLOBAL DEAL! +50k zaliczki, globalna dystrybucja, ale 70% royalties dla wytwórni przez 60 dni.';
  notify(msg);if(G.label.advance>0||type==='indie')confetti(40);showGain(type==='indie'?'🏠 Własna wytwórnia!':type==='major'?'🏢 Label deal!':'🌍 GLOBAL DEAL!','#c8a520');
  addXP(type==='global'?100:50);renderLabelOverlay();
