.ambient-particle{position:absolute;width:3px;height:3px;border-radius:50%;background:rgba(126,200,227,.5);pointer-events:none;animation:ambientFloat 14s linear infinite;box-shadow:0 0 6px rgba(126,200,227,.4);}

/* HUD bars smooth fill */
