// ── FPS: Shooting gallery ──
function renderFPSMg(mg){
  let hits=0,shots=0,timeLeft=12;const timers=[];
  mg.innerHTML=`
  <div style="text-align:center">
    <h2 style="color:#e74c3c;margin-bottom:4px">🎯 FPS Action — Shooting Gallery</h2>
    <p style="color:#556;font-size:13px;margin-bottom:8px">Klikaj cele zanim znikną! Czas: <b id="fps-t" style="color:#f1c40f">12s</b> &nbsp;|&nbsp; Trafień: <b id="fps-h" style="color:#7ec87e">0</b></p>
    <div id="fps-arena" style="position:relative;width:700px;height:340px;background:linear-gradient(180deg,#050b1a 0%,#1a2a1a 65%,#2a1a08 100%);border:2px solid #2a3a5a;border-radius:8px;overflow:hidden;cursor:crosshair;margin:0 auto">
      <div style="position:absolute;bottom:0;left:0;right:0;height:55px;background:linear-gradient(transparent,#140c04)"></div>
      <div id="fps-targets"></div>
    </div>
    <p style="color:#334;font-size:11px;margin-top:5px">Każdy cel znika po 1.8s — celuj szybko!</p>
  </div>`;
  let tId=0;
  const spawnTarget=()=>{
    const el=document.getElementById('fps-targets');if(!el)return;
    const id='fps'+tId++;
    const x=rnd(30,620),y=rnd(20,265);
    const colors=['#e74c3c','#e67e22','#f1c40f','#e91e8c','#9b59b6'];
    const div=document.createElement('div');
    div.id=id;
    div.style.cssText=`position:absolute;left:${x}px;top:${y}px;width:48px;height:48px;background:${colors[rnd(0,4)]};border:3px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;cursor:crosshair;box-shadow:0 0 14px rgba(255,100,100,.6);animation:fpspop .15s ease-out`;
    div.textContent='🎯';shots++;
    div.onclick=()=>{if(div._hit)return;div._hit=true;hits++;div.textContent='💥';div.style.background='#27ae60';div.style.boxShadow='none';setTimeout(()=>div.remove(),120);const h=document.getElementById('fps-h');if(h)h.textContent=hits;}; /* v1.9.19: _hit guard przeciw double-scoring autoclick */
    el.appendChild(div);
    const rm=setTimeout(()=>{if(div.parentNode)div.remove();},1800);timers.push(rm);
  };
  const spawnI=setInterval(spawnTarget,750);timers.push(spawnI);
  spawnTarget();spawnTarget();
  const countI=setInterval(()=>{
    timeLeft--;const t=document.getElementById('fps-t');if(t)t.textContent=timeLeft+'s';
    if(timeLeft<=0){
      timers.forEach(t=>{clearTimeout(t);clearInterval(t);});
      const acc=shots>0?Math.round(hits/shots*100):0;
      window.finishYTMinigame(clamp(hits*8+acc*.3,0,100),`Trafień: ${hits}/${shots} — Celność: ${acc}%`);
    }
  },1000);timers.push(countI);
  window._ytMgCleanup=()=>timers.forEach(t=>{clearInterval(t);clearTimeout(t);});
}

// ── Minecraft: Pattern matching ──
function renderMCMg(mg){
  const W=5,H=4;
  const BLOCKS=['🟫','🟩','🪨','🌊','🔥'];
  const target=Array.from({length:H},(_,r)=>Array.from({length:W},(_,c)=>BLOCKS[(r*W+c+rnd(0,4))%BLOCKS.length]));
  const player=Array.from({length:H},()=>Array.from({length:W},()=>'⬛'));
  let selBlock=BLOCKS[0];
  const render=()=>{
    mg.innerHTML=`
    <div style="text-align:center">
      <h2 style="color:#27ae60;margin-bottom:4px">⛏️ Minecraft Build — Zreplikuj wzór!</h2>
      <p style="color:#556;font-size:13px;margin-bottom:10px">Kliknij komórkę, wybierz blok poniżej i wypełnij swoje pole.</p>
      <div style="display:flex;gap:50px;justify-content:center;align-items:flex-start">
        <div>
          <p style="color:#7ec87e;font-size:13px;margin-bottom:6px">📋 Wzór</p>
          <div style="display:grid;grid-template-columns:repeat(${W},46px);gap:4px">
            ${target.flat().map(b=>`<div style="width:46px;height:46px;background:#1a2a1a;border:1px solid #2a4a2a;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:24px">${b}</div>`).join('')}
          </div>
        </div>
        <div>
          <p style="color:#7ec8e3;font-size:13px;margin-bottom:6px">🔨 Twoja budowla</p>
          <div style="display:grid;grid-template-columns:repeat(${W},46px);gap:4px">
            ${player.map((row,r)=>row.map((b,c)=>`<div onclick="window.mcPlace(${r},${c})" style="width:46px;height:46px;background:#0a1a0a;border:2px solid ${b!=='⬛'?'#27ae60':'#1a3a1a'};border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:24px;cursor:pointer">${b}</div>`).join('')).join('')}
          </div>
        </div>
      </div>
      <div style="margin-top:14px;display:flex;gap:8px;justify-content:center">
        ${BLOCKS.map(b=>`<div onclick="window.mcSel('${b}')" style="width:52px;height:52px;background:${selBlock===b?'#1a4a1a':'#0a1a0a'};border:2px solid ${selBlock===b?'#27ae60':'#1a3a1a'};border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer">${b}</div>`).join('')}
      </div>
      <button class="dbtn" style="width:200px;margin-top:14px" onclick="window.mcSubmit()">✅ Gotowe!</button>
    </div>`;
  };
  window.mcSel=(b)=>{selBlock=b;render();};
  window.mcPlace=(r,c)=>{player[r][c]=selBlock;render();};
  window.mcSubmit=()=>{
    let correct=0;const total=W*H;
    for(let r=0;r<H;r++)for(let c=0;c<W;c++)if(player[r][c]===target[r][c])correct++;
    window.finishYTMinigame(Math.round(correct/total*100),`Poprawnych bloków: ${correct}/${total}`);
  };
  render();
}

