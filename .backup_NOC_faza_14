// Helper: rysuje sygnalizator aut (3 światła + daszek) skierowany w stronę kierowcy.
// Orientacja zależy od kierunku jadących aut: 'left'/'right'/'up'/'down'.
function _drawCarSignal(cx,cy,facing,L){
  const carRed=L.cars==='red'?'#ff3030':'#3a1a1a';
  const carYel=L.cars==='yellow'?'#ffd820':'#3a3018';
  const carGrn=L.cars==='green'?'#30ff60':'#1a3a1a';
  // Sygnalizator dla H (lewo/prawo): pozioma orientacja świateł (czerwone-żółte-zielone od lewej do prawej z perspektywy kierowcy)
  // Sygnalizator dla V (góra/dół): pionowa orientacja
  if(facing==='left'||facing==='right'){
    // Sygnalizator wiszący nad jezdnią H, kierowca patrzy w stronę 'facing'
    // Obudowa pozioma 36x14 (czerwone, żółte, zielone w jednym rzędzie)
    X.fillStyle='#1a1a22';X.fillRect(cx-20,cy-10,40,4); // daszek górny
    X.fillStyle='#0e0e14';X.fillRect(cx-18,cy-7,36,14); // obudowa
    X.strokeStyle='#3a3a44';X.lineWidth=1;X.strokeRect(cx-17.5,cy-6.5,35,13);
    // Daszki nad każdym światłem (od strony kierowcy)
    X.fillStyle='#1a1a22';
    if(facing==='right'){ // kierowca patrzy z lewej, daszki po lewej
      X.fillRect(cx-18,cy-3,3,10); // lewa krawędź zaciemniona
    } else { // facing==='left' kierowca patrzy z prawej
      X.fillRect(cx+15,cy-3,3,10);
    }
    // 3 światła: czerwone | żółte | zielone (czerwone od strony kierowcy = po lewej dla aut→prawo, po prawej dla aut→lewo)
    const order=facing==='right'?['red','yellow','green']:['green','yellow','red']; // od lewej
    for(let i=0;i<3;i++){
      const lx=cx-12+i*12;
      const k=order[i];
      const col=k==='red'?carRed:k==='yellow'?carYel:carGrn;
      const active=L.cars===k;
      if(active){
        X.save();X.globalCompositeOperation='lighter';
        const halo=X.createRadialGradient(lx,cy,0,lx,cy,12);
        halo.addColorStop(0,col+'dd');halo.addColorStop(.5,col+'66');halo.addColorStop(1,col+'00');
        X.fillStyle=halo;X.beginPath();X.arc(lx,cy,12,0,Math.PI*2);X.fill();
        X.restore();
      }
      X.fillStyle='#0a0a0e';X.beginPath();X.arc(lx,cy,4.5,0,Math.PI*2);X.fill();
      X.fillStyle=col;X.beginPath();X.arc(lx,cy,3.5,0,Math.PI*2);X.fill();
      if(active){X.fillStyle='rgba(255,255,255,.6)';X.beginPath();X.arc(lx-1,cy-1,1.2,0,Math.PI*2);X.fill();}
    }
  } else { // up / down — pionowa orientacja
    X.fillStyle='#1a1a22';X.fillRect(cx-10,cy-22,4,40); // daszek po stronie kierowcy
    if(facing==='down') X.fillRect(cx-10,cy-22,20,3); // daszek nad
    X.fillStyle='#0e0e14';X.fillRect(cx-7,cy-20,14,40);
    X.strokeStyle='#3a3a44';X.lineWidth=1;X.strokeRect(cx-6.5,cy-19.5,13,39);
    const order=facing==='down'?['red','yellow','green']:['green','yellow','red'];
    for(let i=0;i<3;i++){
      const ly=cy-12+i*12;
      const k=order[i];
      const col=k==='red'?carRed:k==='yellow'?carYel:carGrn;
      const active=L.cars===k;
      if(active){
        X.save();X.globalCompositeOperation='lighter';
        const halo=X.createRadialGradient(cx,ly,0,cx,ly,12);
        halo.addColorStop(0,col+'dd');halo.addColorStop(.5,col+'66');halo.addColorStop(1,col+'00');
        X.fillStyle=halo;X.beginPath();X.arc(cx,ly,12,0,Math.PI*2);X.fill();
        X.restore();
      }
      X.fillStyle='#0a0a0e';X.beginPath();X.arc(cx,ly,4.5,0,Math.PI*2);X.fill();
      X.fillStyle=col;X.beginPath();X.arc(cx,ly,3.5,0,Math.PI*2);X.fill();
      if(active){X.fillStyle='rgba(255,255,255,.6)';X.beginPath();X.arc(cx-1,ly-1,1.2,0,Math.PI*2);X.fill();}
    }
  }
}

// F+ Helper: WERSJA MNIEJSZA sygnalizatora pieszych — kompaktowa obudowa 8x10 (zamiast 12x14)
function _drawPedSignalSmall(cx,cy,L,t){
  const pedLit=L.peds==='green'?'#30ff60':'#ff3030';
  X.fillStyle='#0e0e14';X.fillRect(cx-4,cy-5,8,10);
  X.strokeStyle='#3a3a44';X.lineWidth=0.7;X.strokeRect(cx-3.5,cy-4.5,7,9);
  X.save();X.globalCompositeOperation='lighter';
  const phalo=X.createRadialGradient(cx,cy,0,cx,cy,6);
  phalo.addColorStop(0,pedLit+'88');phalo.addColorStop(1,pedLit+'00');
  X.fillStyle=phalo;X.beginPath();X.arc(cx,cy,6,0,Math.PI*2);X.fill();
  X.restore();
  X.fillStyle=pedLit;
  if(L.peds==='green'){
    X.fillRect(cx-1,cy-3,2,2);  // głowa
    X.fillRect(cx-1,cy-1,2,3);  // tułów
    X.fillRect(cx-2,cy+2,2,2);  // noga lewa
    X.fillRect(cx,cy+2,2,2);    // noga prawa
  } else {
    X.fillRect(cx-1,cy-3,2,2);  // głowa
    X.fillRect(cx-2,cy-1,4,3);  // szeroki tułów
    X.fillRect(cx-2,cy+2,4,2);  // nogi razem
  }
}


function drawTrafficLights(){
  if(currentRoom!=='ulica') return;
  const L=getTrafficLight();
  const t=Date.now();
  for(const its of TRAFFIC_INTERSECTIONS){
    const sx=wx2sx(its.wx),sy=wy2sy(its.wy);
    if(sx<-200||sx>1480||sy<-200||sy>900) continue;
    // === 4 SYGNALIZATORY AUT — COFNIĘTE do stanu sprzed v1.8.11 ===
    // User: "Te które przesunąłeś cofnij z powrotem tak jak były kilka godzin temu".
    // 2 słupy z wysięgnikami do sygnałów wiszących NAD jezdnią (oryginalna konstrukcja).
    const _poleSE = {px:sx+115, py:sy+115};
    const _poleNW = {px:sx-115, py:sy-115};
    const _carSignals=[
      {f:'right', cx:sx+60, cy:sy+25, pole:_poleSE},
      {f:'down',  cx:sx+25, cy:sy+60, pole:_poleSE},
      {f:'left',  cx:sx-60, cy:sy-25, pole:_poleNW},
      {f:'up',    cx:sx-25, cy:sy-60, pole:_poleNW},
    ];
    for(const pole of [_poleSE, _poleNW]){
      const baseY = pole.py>0 ? pole.py+18 : pole.py-18;
      X.fillStyle='rgba(0,0,0,.4)';X.beginPath();X.ellipse(pole.px,baseY+1,5,1.8,0,0,Math.PI*2);X.fill();
      X.fillStyle='#2a2a30';X.fillRect(pole.px-2,Math.min(pole.py,baseY),4,Math.abs(baseY-pole.py));
      X.fillStyle='#5a5a65';X.fillRect(pole.px-2,Math.min(pole.py,baseY),1,Math.abs(baseY-pole.py));
      X.fillStyle='#1a1a20';X.fillRect(pole.px-4,baseY-(pole.py>0?3:-3),8,3);
    }
    for(const sg of _carSignals){
      X.save();
      X.strokeStyle='rgba(80,80,90,.7)';X.lineWidth=1.5;
      X.beginPath();X.moveTo(sg.pole.px,sg.pole.py);
      const midX=(sg.pole.px+sg.cx)/2, midY=Math.min(sg.pole.py,sg.cy)-8;
      X.quadraticCurveTo(midX,midY,sg.cx,sg.cy);X.stroke();
      X.restore();
      _drawCarSignal(sg.cx,sg.cy,sg.f,L);
    }

    // === 8 SYGNALIZATORÓW PIESZYCH — po obu stronach każdego z 4 crosswalk
    // Każdy crosswalk (N, S, E, W) ma 2 sygnalizatory po przeciwnych stronach,
    // skierowane W STRONĘ pieszego (czyli ku środkowi crosswalk).
    // Pozycje na ROGACH chodników (±144 od środka skrzyżowania).
    // Crosswalk N (chodnik N H, w poprzek jezdni V): sygnalizatory na NW i NE rogu
    // Crosswalk S: SW i SE
    // Crosswalk W (chodnik V lewy, w poprzek jezdni H): sygnalizatory na NW i SW
    // Crosswalk E: NE i SE
    // Każdy róg pełni więc PODWÓJNĄ rolę (sygnalizator dla 2 crosswalk),
    // ale wystarczy 1 słupek z 1 sygnalizatorem (skierowany domyślnie w środek skrzyżowania).
    // F+ Słupy peds odsunięte ±170 (z ±144) — bliżej budynków, dalej od sygnalizatorów aut
    // wiszących na ±65,±85 (sygn lewo/góra wisi na wysokości sy±85 → diagonal słupek-sygn ~135px).
    // Wcześniej przy ±144 dwa sygnalizatory wyglądały "zlane" w jeden pas dwóch kropek.
    // Chodniki: V zach 672-768 (skrajnia 672 = sx-192), V wsch 960-1056 (skrajnia 1056 = sx+192),
    //           H N 288-384 (skrajnia 288 = sy-192), H S 576-672 (skrajnia 672 = sy+192)
    // ±170 → wciąż NA chodniku (±96 jezdnia, ±192 budynki), bliżej zewnętrznej krawędzi
    // F+ 2026-05-12 rev4: pedCorners ±170 — środek chodnika narożnego (chodnik 96-192, środek 144)
    // Aktualnie ±170 = 74px od jezdni (krawężnik) i 22px od budynku. Bezpiecznie NA chodniku.
    // pc.y+30 (podstawa słupka) = sy-140 dla NW: w chodniku N H (sy-192..-96). OK.
    // COFNIĘTE: pedCorners ±170 (oryginalna pozycja)
    const pedCorners=[
      {x:sx-170,y:sy-170,facing:'SE'},
      {x:sx+170,y:sy-170,facing:'SW'},
      {x:sx-170,y:sy+170,facing:'NE'},
      {x:sx+170,y:sy+170,facing:'NW'},
    ];
    for(const pc of pedCorners){
      // Dodaj jasną kafelkę chodnikową pod słupem (wizualnie potwierdza że to chodnik)
      X.fillStyle='rgba(180,170,150,.4)';
      X.fillRect(pc.x-8,pc.y+22,16,12);
      X.fillStyle='rgba(120,110,95,.5)';
      X.strokeStyle='rgba(80,75,65,.6)';X.lineWidth=0.8;
      X.strokeRect(pc.x-8,pc.y+22,16,12);
      // Cień u podstawy
      X.fillStyle='rgba(0,0,0,.40)';X.beginPath();X.ellipse(pc.x,pc.y+30,5,1.8,0,0,Math.PI*2);X.fill();
      // Słupek (16px wysokości)
      X.fillStyle='#3a3a44';X.fillRect(pc.x-1.5,pc.y+10,3,18);
      // Podstawa
      X.fillStyle='#1a1a20';X.fillRect(pc.x-3,pc.y+26,6,3);
      // Sygnalizator pieds (kompaktowy)
      _drawPedSignalSmall(pc.x,pc.y+5,L,t);
    }
  }
}

