/* v2.1.227: Score per round — random + bonuses (fame, drip, crown, rep). */
function _tvContestRoundScore(){
  let base=50+Math.floor(Math.random()*41); /* 50-90 base */
  base += Math.min(20, Math.floor((G.fame||0)/10)); /* fame bonus max +20 */
  if((G.drip||0)>=100) base+=5;
  if(G.outfit?.top==='crown_of_hh') base+=10;
  if((G.streetRep||0)>=75) base+=5;
  /* Scena skill bonus */
  if(typeof getRaperST==='function'){
    const scena=getRaperST('scena')||0;
    if(scena>=3) base+=5;
    if(scena>=5) base+=10;
  }
  return Math.min(150, base);
}

/* v2.1.227: Daily tick — wywoływane w nextPeriod po G.day++. */
function _tvContestDailyTick(){
  if(!G._tvContest || !G._tvContest.active) return;
  const c=G._tvContest;
  const dayInContest=G.day-c.startDay; /* 1, 2, 3, ..., 7 */
  if(dayInContest<1) return; /* still day 0 */
  /* Round triggers */
  if(dayInContest===2 && c.roundsCompleted<1){
    /* Round 1 complete */
    const s=_tvContestRoundScore();
    c.playerScores.push({round:1, name:'Freestyle', score:s});
    c.roundsCompleted=1; c.currentRound=2;
    if(typeof notify==='function') notify(`📺 Runda 1 (Freestyle) — score: ${s}/150. Dalej!`);
    if(typeof addNotif==='function') addNotif(`📺 TV Round 1: ${s}/150`);
  } else if(dayInContest===4 && c.roundsCompleted<2){
    const s=_tvContestRoundScore();
    c.playerScores.push({round:2, name:'Theme song', score:s});
    c.roundsCompleted=2; c.currentRound=3;
    if(typeof notify==='function') notify(`📺 Runda 2 (Theme song) — score: ${s}/150. Final ahead!`);
    if(typeof addNotif==='function') addNotif(`📺 TV Round 2: ${s}/150`);
  } else if(dayInContest===6 && c.roundsCompleted<3){
    const s=_tvContestRoundScore();
    c.playerScores.push({round:3, name:'Live performance', score:s});
    c.roundsCompleted=3;
    if(typeof notify==='function') notify(`📺 Runda 3 (Live performance) — score: ${s}/150. Wyniki jutro!`);
    if(typeof addNotif==='function') addNotif(`📺 TV Round 3: ${s}/150`);
  } else if(dayInContest>=7 && c.roundsCompleted===3){
    /* End — compute final + announce winners */
    _tvContestFinish();
  }
}

/* v2.1.227: Compute final ranking + apply rewards. */
function _tvContestFinish(){
  const c=G._tvContest;
  if(!c) return;
  const playerTotal=c.playerScores.reduce((s,r)=>s+r.score,0); /* 3 rounds × 50-150 = 150-450 */
  /* NPC scores — random 200-400 each (5 NPCs). Plus bias z fame gracza */
  const npcs=[];
  for(let i=0;i<c.npcCount;i++){
    const npcScore=200+Math.floor(Math.random()*201); /* 200-400 */
    npcs.push({name:`Konkurent #${i+1}`, score:npcScore});
  }
  /* Combine + sort */
  const all=[...npcs.map(n=>({...n, isPlayer:false})), {name:G.name||'Ty', score:playerTotal, isPlayer:true}];
  all.sort((a,b)=>b.score-a.score);
  const playerRank=all.findIndex(e=>e.isPlayer)+1;
  /* Rewards */
  let reward={money:0, fame:0, fans:5000, prestigePoint:false};
  if(playerRank===1){reward.money=100000; reward.fame=20; reward.prestigePoint=true;}
  else if(playerRank===2){reward.money=50000; reward.fame=10;}
  else if(playerRank===3){reward.money=20000; reward.fame=5;}
  /* Apply rewards (zawsze +5k fans dla wszystkich uczestników) */
  if(reward.money>0){if(typeof earn==='function') earn(reward.money,false); else {G.money+=reward.money;G.totalEarned=(G.totalEarned||0)+reward.money;}}
  if(reward.fame>0){if(typeof addFame==='function') addFame(reward.fame); else G.fame=Math.min(500,(G.fame||0)+reward.fame);}
  if(reward.fans>0){if(typeof addFans==='function') addFans(reward.fans); else G.fans=(G.fans||0)+reward.fans;}
  if(reward.prestigePoint){G.prestigePoints=(G.prestigePoints||0)+1;}
  /* Notify + cinematic */
  const medal=playerRank===1?'🥇':playerRank===2?'🥈':playerRank===3?'🥉':'';
  const summary=playerRank<=3
    ? `${medal} ${playerRank}. miejsce w "Voice Star"! Score: ${playerTotal}. +${reward.money.toLocaleString('pl')} zł, +${reward.fame} sławy, +${reward.fans.toLocaleString('pl')} fanów${reward.prestigePoint?', +1 Prestige Skill Point':''}.`
    : `Eliminacja w "Voice Star" — ${playerRank}. miejsce z ${playerTotal} score. +5 000 fanów za udział.`;
  if(typeof notify==='function') notify(`📺 ${summary}`, playerRank<=3?'g':'f', 8000);
  if(typeof addNotif==='function') addNotif(`📺 TV Contest end: #${playerRank} (${playerTotal})`);
  if(playerRank<=3 && typeof showMilestoneCinematic==='function'){
    showMilestoneCinematic({emoji:medal||'📺', title:`TV CONTEST #${playerRank}`, subtitle:'Voice Star Finals', tagline:`Score ${playerTotal} · +${reward.money.toLocaleString('pl')} zł · +${reward.fame} sławy${reward.prestigePoint?' · +1 PSP':''}`, accentColor:playerRank===1?'#f1c40f':playerRank===2?'#aaa':'#c87810', accent2:'#e91e8c', duration:5500});
  }
  /* Save history + end contest */
  if(!Array.isArray(G.tvContestHistory)) G.tvContestHistory=[];
  G.tvContestHistory.push({day:G.day, rank:playerRank, totalScore:playerTotal, reward});
  if(G.tvContestHistory.length>20) G.tvContestHistory=G.tvContestHistory.slice(-20);
  G._tvContest=null; /* contest end */
}

