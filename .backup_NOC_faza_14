    ctx.font='bold 28px "Segoe UI"';ctx.fillStyle=win?'#27ae60':'#e74c3c';ctx.textAlign='center';
    ctx.fillText(win?`🏆 Wygrana! Nowa ranga: ${ranks[Math.min(ri+1,ranks.length-1)]}`:`📊 Wynik: ${score}pkt (${ROUNDS} rund)`,W/2,H/2-15);
