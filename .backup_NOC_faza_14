function checkStoryline(){
  if(!G.mainQuest) G.mainQuest={currentStep:0,completed:[]};
  /* v2.1.123: Wave 8 W80 — storyline soft-lock fix. Po Prestige `mainQuestStartDay` ustawione na dzień prestige, quest checks wymagają minimum 2 dni od resetu (gracz nie zalicza wszystkiego automatycznie z persisted fans/followers). */
  if(G.mainQuest._startDay && (G.day - G.mainQuest._startDay) < 2 && G.mainQuest.currentStep < 5){
    /* Pierwsze 5 questów wymaga 2 dni przerwy po Prestige — anti soft-lock */
    checkSideStorylines();return;
  }
  const step=G.mainQuest.currentStep;
  if(step>=STORYLINE_QUESTS.length){checkSideStorylines();return;}
  const q=STORYLINE_QUESTS[step];
  if(q.check()){
    G.mainQuest.completed.push(q.id);
    G.mainQuest.currentStep++;
    /* v1.9.33: BUG FIX storyline reward — money przez earn() (Prestige moneyMult), fame przez addFame() (Prestige fameMult). Wcześniej direct G.money+=/G.fame+= bypassowało prestige bonus. */
    if(q.reward.money){if(typeof earn==='function')earn(q.reward.money,true); else {G.money+=q.reward.money;G.totalEarned=(G.totalEarned||0)+q.reward.money;}}
    if(q.reward.fame){if(typeof addFame==='function')addFame(q.reward.fame); else G.fame=clamp(G.fame+q.reward.fame,0,500);}
    if(q.reward.xp) addXP(q.reward.xp);
    if(q.reward.skillPts) G.skillPoints=(G.skillPoints||0)+q.reward.skillPts;
    confetti(40);
    /* v2.1.175: dłuższy + większy notification dla storyline — user reported "nie zaliczył się" mimo że logika działa (showMsg domyślny 3s mogły być przeoczone podczas minigame end). */
    showMsg(`🎯 STORYLINE! ${q.em} ${q.name} — wykonane! Nagroda: +${q.reward.money||0} zł, +${q.reward.fame||0} sławy${q.reward.skillPts?', +'+q.reward.skillPts+' pkt skill':''}`,'g',6000);
    addNotif(`${q.em} STORYLINE: ${q.name} ✓`);
    showGain(`✓ ${q.name}`,'#f1c40f');
  }
  checkSideStorylines();
}

