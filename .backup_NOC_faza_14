    for(let i=particles2.length-1;i>=0;i--){
      const p=particles2[i];p.x+=p.vx;p.y+=p.vy;p.life-=0.05;
      if(p.life<=0){particles2.splice(i,1);continue;}
      ctx.fillStyle=`rgba(39,174,96,${p.life})`;ctx.beginPath();ctx.arc(p.x,p.y,4*p.life,0,Math.PI*2);ctx.fill();
    }
    if(!over)raf=requestAnimationFrame(draw2);
  };
  raf=requestAnimationFrame(draw2);

  function finishRanked(){
    document.removeEventListener('keydown',kh);if(keyTimeout)clearTimeout(keyTimeout);
    G.energy=clampStat('energy', G.energy-10);
    const win=score>ROUNDS*15;
    if(win&&ri<ranks.length-1){G.careers.gamer.rank=ranks[ri+1];addXP(30);notify('⬆️ Awans rangi: '+ranks[ri+1]+'!');}
