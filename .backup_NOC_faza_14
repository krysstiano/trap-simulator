        addNotif(`💡 Nieoczekiwany hit! +1500 zł, +${fans} fanów lojalnych (Evolution Geniusz — co 3 dni)`);
        if(typeof showMsg==='function') showMsg('💡 Twój projekt sprzed kilku dni viralował! +1500 zł, +150 fanów','g');
      }
    }
    // Jeden łączny toast dla całego pasywnego dochodu (ZAMIAST kilku osobnych zielonych liczb)
