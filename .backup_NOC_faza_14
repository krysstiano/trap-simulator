    X.fillStyle='#3a2008';X.fillRect(sx-44,benchY+11,88,1);
    // Nóżki ławki — solid grubsze
    X.fillStyle='#0e0804';
    X.fillRect(sx-40,benchY+14,4,5);X.fillRect(sx+36,benchY+14,4,5);
    // Tabliczka z numerem linii — większa, ostra, solid, ZAWSZE po lewej stronie
    const labelY=sy + (isNorth?-25:-1);
    X.fillStyle='#1a4488';X.fillRect(sx-86,labelY,26,32);
    X.fillStyle='#2a5aa8';X.fillRect(sx-84,labelY+2,22,28);
    X.fillStyle='#0a2858';X.fillRect(sx-86,labelY,26,3);
    X.fillStyle='#fff';X.font='bold 16px Arial';X.textAlign='center';X.textBaseline='middle';
    X.fillText(bs.line,sx-73,labelY+11);
    X.font='bold 9px Arial';X.fillStyle='#dceaff';
    X.fillText('BUS',sx-73,labelY+24);
    X.textAlign='left';X.textBaseline='alphabetic';
    // NPC pasażer — większy (~46 high jak normalny NPC), używamy drawNPC. Pozycja na ławce.
    // drawNPC oczekuje (sx, sy, w, h, skin, cloth, em). Tu sx, sy to top-left.
    const passSx = sx+10;
    const passSy = benchY-44; // pasażer stoi PRZY ławce, jego głowa nad ławką
    if(typeof drawNPC === 'function'){
      const _waitBob = Math.sin(Date.now()/600 + bs.wx*0.01)*0.4;
      // Wybór koloru ubrania per pozycja przystanku (deterministyczne, nie miga)
      const _clothPick=['#3498db','#9b59b6','#e74c3c'][Math.abs(bs.wx*7+bs.wy)%3];
      drawNPC(passSx, passSy + _waitBob, 22, 46, '#e8c8a0', _clothPick, '⏰');
