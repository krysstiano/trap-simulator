    }
    // Pionowe podzialy szyb
    X.strokeStyle='rgba(0,0,0,.5)';X.lineWidth=1.5;
    for(let c=1;c<6;c++){
      const xL=sx+10+c*(w-20)/6;
      X.beginPath();X.moveTo(xL,yL);X.lineTo(xL,yL+winH);X.stroke();
    }
    // Rama szyby — gold akcent
    X.strokeStyle=isNight?'rgba(241,196,15,.5)':'#3a4a5a';X.lineWidth=1.5;
    X.strokeRect(sx+9.5,yL-.5,w-19,winH+1);
