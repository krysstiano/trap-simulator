function canUnlockRSTBranch(branch){
  const def=RAPER_ST_DEF[branch];
  /* v2.1.226 BUG #36 fix: defensive — invalid branch (np. cheat console call) NIE crashuje gry. */
  if(!def) return false;
  if(def.minFans){if((G.fans||0)<def.minFans)return false;}
  if(def.needsItem&&!G[def.needsItem]) return false;
  if(!def.requires) return true;
  for(const [req,minLvl] of Object.entries(def.requires)){
    if(getRaperST(req)<minLvl) return false;
  }
  return true;
}

