// #16 Zielone skwery — zróżnicowanie mapy zamiast jednolitych blokowisk
// Każdy patch: trawnik + drzewa + krzewy + ścieżka. Zastępuje wizualnie obszar (DB nadal pod spodem ale przykryte zielenią).
// Strefy mapy (T=48px, dozwolone obszary patches — POZA drogami i chodnikami):
// V1 chodnik+jezdnia: wx 672-1056 | V2: 2112-2448 | V3: 3360-3744
// Strefy budynków pionowo: Z1 zach 0-672, Z2 1056-2112, Z3 2448-3360, Z4 3744-4320
// USUNIĘTE 2026-05-12 (REGRESJA park-nachodzi-na-bloki):
// Wszystkie 4 patches GREEN_PATCHES rysowały drzewa/krzewy/trawnik NA blokach DB_DECORATIVE.
// Z1 NORTH wy=1320 patch wx=400-640 nakładał na DB wx=356-504 i wx=518-664.
// Z3/Z4 patches też nakładały. Bazowy tile 'grass' + dekoracje wokół mieszkań wystarczają.
const GREEN_PATCHES=[];
function drawGreenPatches(){
  if(currentRoom!=='ulica') return;
  const sx2=wx2sx,sy2=wy2sy;
  // Pseudo-random ale stabilny per pozycja
  const sr=(s)=>{const x=Math.sin(s*9999)*43758.5453;return x-Math.floor(x);};
  // Kolizje — obiekty na które drzewa/krzewy NIE mogą nachodzić (ławki, lampy, fontanny, kosze, krzewy)
  const collidableIds=/^(bench|bench2|apt[124]_(bench|bench2|lamp\d?|fountain|trash|bush\d?))$/;
  const allCollidables=ROOMS.ulica.objects.filter(o=>collidableIds.test(o.id));
  const collidesWith=(wx,wy,r,patch)=>{
    for(const o of allCollidables){
      if(o.wx+o.w<patch.wx||o.wx>patch.wx+patch.w) continue;
      if(o.wy+o.h<patch.wy||o.wy>patch.wy+patch.h) continue;
      if(wx+r>=o.wx-2&&wx-r<=o.wx+o.w+2&&wy+r>=o.wy-2&&wy-r<=o.wy+o.h+2) return true;
    }
    return false;
  };
  for(const p of GREEN_PATCHES){
    const dsx=sx2(p.wx),dsy=sy2(p.wy);
    if(dsx<-p.w-10||dsx>1340||dsy<-p.h-10||dsy>790)continue;
    // Patches BARDZO podobne do tile grass — żeby NIE wyglądały jak doklejone prostokąty
    const hueShift=(p.seed*13)%20-10;
    // Patches z prawdziwą zielenią — kontrastują z miejskim tile grass (#2c382a)
    const baseR=37+hueShift, baseG=92+hueShift, baseB=37+hueShift;
    X.save();
    X.beginPath();X.rect(dsx,dsy,p.w,p.h);X.clip();
    // Bardzo subtelny gradient (mniejsza wariacja)
    const grad=X.createLinearGradient(dsx,dsy,dsx,dsy+p.h);
    grad.addColorStop(0,`rgb(${baseR+3},${baseG+3},${baseB+3})`);
    grad.addColorStop(1,`rgb(${baseR-3},${baseG-3},${baseB-3})`);
    X.fillStyle=grad;X.fillRect(dsx,dsy,p.w,p.h);
    // Tekstura trawy z subtelną animacją wiatru
    const windG=Date.now()/1000;
    for(let i=0;i<35;i++){
      const gx=dsx+sr(p.seed*100+i)*p.w;
      const gy=dsy+sr(p.seed*200+i)*p.h;
      const lighter=sr(p.seed*400+i)<.5;
      const gsway=Math.sin(windG*1.2+i*0.4+p.seed)*0.6;
      X.fillStyle=lighter?`rgb(${baseR+10},${baseG+15},${baseB+8})`:`rgb(${baseR-5},${baseG+5},${baseB-5})`;
      X.fillRect(gx+gsway,gy,2,sr(p.seed*500+i)*2.5+1.5);
    }
    // Krzewy — z subtelną animacją wiatru
    const windB=Date.now()/1000;
    for(let i=0;i<p.bushes;i++){
      const br=3+sr(p.seed*700+i)*3;
      const padBush=br+4;
      const bwx=p.wx+padBush+sr(p.seed*500+i)*(p.w-padBush*2);
      const bwy=p.wy+padBush+sr(p.seed*600+i)*(p.h-padBush*2);
      if(collidesWith(bwx,bwy,br+3,p)) continue;
      const bx=sx2(bwx),by=sy2(bwy);
      const bsway=Math.sin(windB*0.9+i*0.7+p.seed)*0.7;
      X.fillStyle='rgba(0,0,0,.3)';X.beginPath();X.arc(bx+1,by+2,br,0,Math.PI*2);X.fill();
      X.fillStyle='#1a4a1a';X.beginPath();X.arc(bx+bsway,by,br,0,Math.PI*2);X.fill();
      X.fillStyle='#2a6020';X.beginPath();X.arc(bx-1+bsway,by-1,br*.6,0,Math.PI*2);X.fill();
    }
    // Drzewa — z animacją kołysania od wiatru (każde z innym fazą)
    const windT=Date.now()/1000;
    for(let i=0;i<p.trees;i++){
      const tr=8+sr(p.seed*1200+i)*4;
      const padding=tr+5;
      const twx=p.wx+padding+sr(p.seed*1000+i)*(p.w-padding*2);
      const twy=p.wy+padding+sr(p.seed*1100+i)*(p.h-padding*2);
      if(collidesWith(twx,twy,tr+4,p)) continue;
      const tx=sx2(twx),ty=sy2(twy);
      // Kołysanie korony — sinusoidalne, każde drzewo z innym fazą
      const sway=Math.sin(windT*0.7+i*1.3+p.seed)*1.8;
      X.fillStyle='rgba(0,0,0,.4)';X.beginPath();X.ellipse(tx+2,ty+tr+2,tr*.9,tr*.4,0,0,Math.PI*2);X.fill();
      X.fillStyle='#4a2810';X.fillRect(tx-2,ty,4,tr);
      // Korona z swayem
      X.fillStyle='#1a4a1a';X.beginPath();X.arc(tx-tr*.5+sway,ty,tr*.7,0,Math.PI*2);X.fill();
      X.fillStyle='#2a5a20';X.beginPath();X.arc(tx+tr*.5+sway,ty-tr*.3,tr*.7,0,Math.PI*2);X.fill();
      X.fillStyle='#206018';X.beginPath();X.arc(tx+sway,ty-tr*.4,tr*.8,0,Math.PI*2);X.fill();
      X.fillStyle='rgba(120,180,80,.4)';X.beginPath();X.arc(tx-tr*.3+sway,ty-tr*.5,tr*.3,0,Math.PI*2);X.fill();
    }
    // Opcjonalny monument (mała fontanna)
    if(p.monument){
      const mx=dsx+p.w/2,my=dsy+p.h/2;
      X.fillStyle='#666';X.beginPath();X.arc(mx,my,18,0,Math.PI*2);X.fill();
      X.fillStyle='#999';X.beginPath();X.arc(mx,my,14,0,Math.PI*2);X.fill();
      X.fillStyle='#3498db';X.beginPath();X.arc(mx,my,10,0,Math.PI*2);X.fill();
      X.fillStyle='#5dade2';X.beginPath();X.arc(mx-2,my-2,4,0,Math.PI*2);X.fill();
    }
    // Opcjonalna ławka
    if(p.bench){
      const bx=dsx+p.w/2-15,by=dsy+p.h-25;
      X.fillStyle='#5a3a18';X.fillRect(bx,by,30,8);
      X.fillStyle='#4a2810';X.fillRect(bx,by+8,4,12);X.fillRect(bx+26,by+8,4,12);
    }
    X.restore(); // #82 — koniec clip dla tego patch
  }
}

