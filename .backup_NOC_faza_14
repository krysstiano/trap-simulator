function checkMissionMilestones(){
  const mm=G.mainMission;if(!mm||!mm.active||mm.failed) return;
  /* v2.1.37 [Amper]: mainMission "Pierwsze 100/250/500/1000 fanów" = G.fans lojalnych (spójność z HUD) */
  const totalFans=(G.fans||0);
  for(const ms of mm.milestones){
    if(!ms.done&&totalFans>=ms.fans){
      ms.done=true;
      /* v2.1.218 [Amper] BALANS: mainMission rewards przez earn()/addFame() (wcześniej bypass Prestige moneyMult i diminishing fame) */
      if(ms.reward.money){if(typeof earn==='function') earn(ms.reward.money,false); else {G.money+=ms.reward.money;G.totalEarned=(G.totalEarned||0)+ms.reward.money;}}
      if(ms.reward.xp) addXP(ms.reward.xp);
      if(ms.reward.followers) G.followers=(G.followers||0)+ms.reward.followers;
      if(ms.reward.fame){if(typeof addFame==='function') addFame(ms.reward.fame); else G.fame=clamp((G.fame||0)+ms.reward.fame,0,500);}
      showMsg(`🎯 ${ms.label}${ms.reward.money?' +'+ms.reward.money+' zł':''}${ms.reward.xp?' +'+ms.reward.xp+' XP':''}!`);
      addNotif(`🏆 Misja: ${ms.label}`);
      if(ms.fans>=1000) mm.active=false;
    }
  }
}
