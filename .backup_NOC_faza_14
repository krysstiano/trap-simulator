  // Walidacja koszy — usuń te na jezdniach + zbyt blisko ławek + kolidujące z hydrantami + W POBLIŻU SKRZYŻOWAŃ
  const _validTrash=trash.filter(tr=>
    !_isOnRoad(tr.wx,tr.wy) &&
    !_collidesWithSt(tr.wx,tr.wy,_benchPos,40) &&
    !_collidesWithSt(tr.wx,tr.wy,_validHydrants,30) &&
    !_nearIntersection(tr.wx,tr.wy)
  );
  for(const tr of _validTrash){
    const sx=wx2sx(tr.wx),sy=wy2sy(tr.wy);
    if(sx<-15||sx>1295||sy<32||sy>790)continue;
    X.fillStyle='rgba(0,0,0,.25)';X.beginPath();X.ellipse(sx,sy+10,7,2,0,0,Math.PI*2);X.fill();
    X.fillStyle='#3a3a40';X.fillRect(sx-5,sy-4,10,14);
    X.fillStyle='#4a4a50';X.fillRect(sx-4,sy-4,8,14);
    X.fillStyle='#2a2a30';X.fillRect(sx-5,sy+3,10,1);
