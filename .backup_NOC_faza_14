    if((G.energy||0)<10){if(typeof showMsg==='function')showMsg('⚡ Za mało energii na lot (potrzeba 10).','r');return;}
    const _lastHeli=G._lastHeliMin||-9999;
    const _now=typeof gameMin==='number'?gameMin:0;
    if(_now-_lastHeli<30){if(typeof showMsg==='function')showMsg('🚁 Helikopter musi się przygotować — odczekaj '+Math.ceil(30-(_now-_lastHeli))+' min gry.','r');return;}
    G.money-=baseCost;
    G.energy=Math.max(0,G.energy-10);
    if(typeof gameMin==='number') gameMin+=10;
    G._lastHeliMin=gameMin;
    G._heliFlights=(G._heliFlights||0)+1;
    if(baseCost>0 && typeof spent==='function')spent(baseCost);
    closeOverlay();
    if(typeof showMsg==='function')showMsg('🚁 Lecisz helikopterem...');
