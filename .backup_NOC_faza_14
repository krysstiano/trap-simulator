  if(currentRoom!=='ulica') return;
  const t=Date.now()*0.003;
  X.save();
  for(const b of cityBirds){
    b.wx+=b.dx;
    if(b.wx>4600) b.wx=-200;
    if(b.wx<-200) b.wx=4600;
    const sx=wx2sx(b.wx);
    if(sx<-20||sx>1320) continue;
    const sy=b.alt+Math.sin(t+b.phase*0.1)*3;
    const wingFold=Math.sin(t*3+b.phase)*0.5+0.5; // 0=folded, 1=open
    const spread=8*wingFold+2;
    X.strokeStyle='rgba(30,30,40,0.6)';X.lineWidth=1.5;
    X.beginPath();
    X.moveTo(sx-spread,sy-spread*0.4);
    X.quadraticCurveTo(sx,sy-spread*0.2*wingFold,sx+spread,sy-spread*0.4);
    X.stroke();
  }
  X.restore();
}

const K = {};
/* v2.1.146: TOUCH/MOBILE SUPPORT — virtual joystick + action button + phone button.
   Detection: 'ontouchstart' in window OR navigator.maxTouchPoints>0. Toggle body.touch-device class.
   CSS @media (min-width:900px) ukrywa na desktopach (chyba że body.touch-force).
   Mapuje pozycję thumb na K['ArrowUp/Down/Left/Right'] żeby reużyć istniejący movement code (L8633+).
   Action button → tryInteract() (jak 'E' keypress). Phone button → togglePhone() (jak 'P' keypress). */
(function _initTouchControls(){
  const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints>0);
  if(!isTouchDevice) return;
  /* Build DOM — append to document.body (NIE #wrap! memory rule: position:fixed + transform:scale = bug w #wrap) */
  const jx=document.createElement('div');
  jx.id='touch-joystick'; jx.className='touch-control';
  const thumb=document.createElement('div');
  thumb.id='touch-joystick-thumb';
  jx.appendChild(thumb);
  const act=document.createElement('div');
  act.id='touch-action'; act.className='touch-control';
  act.textContent='E';
  act.title='Interakcja (E)';
  const ph=document.createElement('div');
  ph.id='touch-phone'; ph.className='touch-control';
  ph.textContent='📱';
  ph.title='Telefon (P)';
  document.body.appendChild(jx);
  document.body.appendChild(act);
  document.body.appendChild(ph);
  document.body.classList.add('touch-device');
  /* Joystick state */
  let activeTouchId=null;
  let centerX=0, centerY=0;
  const RADIUS=50; /* max thumb offset */
  const DEAD_ZONE=12; /* poniżej tego nie ruszamy */
  /* Mapowanie pozycji thumb (dx,dy) na K[] virtual keys */
  function updateKeys(dx,dy){
    const dist=Math.hypot(dx,dy);
    if(dist<DEAD_ZONE){
      K['ArrowUp']=K['ArrowDown']=K['ArrowLeft']=K['ArrowRight']=false;
      return;
    }
    const angle=Math.atan2(dy,dx); /* -PI..PI */
    /* 8-way movement: 8 sektorów po 45° */
    const deg=(angle*180/Math.PI+360)%360;
    K['ArrowUp']=(deg>=202.5 && deg<337.5);
    K['ArrowDown']=(deg>=22.5 && deg<157.5);
    K['ArrowLeft']=(deg>=112.5 && deg<247.5);
    K['ArrowRight']=(deg>=292.5 || deg<67.5);
  }
  function resetThumb(){
    thumb.style.transform='translate(0,0)';
    K['ArrowUp']=K['ArrowDown']=K['ArrowLeft']=K['ArrowRight']=false;
  }
  /* Touch handlers — joystick */
  jx.addEventListener('touchstart',e=>{
    if(activeTouchId!==null) return;
    const t=e.changedTouches[0];
    activeTouchId=t.identifier;
    const rect=jx.getBoundingClientRect();
    centerX=rect.left+rect.width/2; centerY=rect.top+rect.height/2;
    e.preventDefault();
  },{passive:false});
  jx.addEventListener('touchmove',e=>{
    for(const t of e.changedTouches){
      if(t.identifier!==activeTouchId) continue;
      let dx=t.clientX-centerX, dy=t.clientY-centerY;
      const dist=Math.hypot(dx,dy);
      if(dist>RADIUS){ dx=dx/dist*RADIUS; dy=dy/dist*RADIUS; }
      thumb.style.transform=`translate(${dx}px,${dy}px)`;
      updateKeys(dx,dy);
      e.preventDefault();
    }
  },{passive:false});
  const endHandler=e=>{
    for(const t of e.changedTouches){
      if(t.identifier!==activeTouchId) continue;
      activeTouchId=null;
      resetThumb();
    }
  };
  jx.addEventListener('touchend',endHandler);
  jx.addEventListener('touchcancel',endHandler);
  /* Action button — tryInteract() */
  act.addEventListener('touchstart',e=>{
    e.preventDefault();
    if(typeof tryInteract==='function') tryInteract();
  },{passive:false});
  /* Phone button — togglePhone() */
  ph.addEventListener('touchstart',e=>{
    e.preventDefault();
    if(typeof togglePhone==='function') togglePhone();
  },{passive:false});
})();
