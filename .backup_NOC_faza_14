      _render();
      return;
    }
    if(!G.casinoChips) G.casinoChips=0;
    const _bet=parseInt(document.getElementById('slots-bet').value)||20;
    if(_bet<MIN_BET){lastResult='⚠️ Minimum '+MIN_BET+' żetonów';_render();return;}
    if(_bet>MAX_BET){lastResult='⚠️ Maksymalna stawka '+MAX_BET.toLocaleString('pl')+' żetonów';_render();return;}
    if(_bet>G.casinoChips){lastResult='⚠️ Za mało żetonów — idź do kantoru!';_render();return;}
    bet=_bet;G.casinoChips-=_bet;
    spinning=true;
    /* v2.0.25: VIP sloty mają subtelnie inny dźwięk (premium tone + gold tinkle) */
    if(G._casinoVip && typeof sfxSlotSpinVip==='function') sfxSlotSpinVip();
    else if(typeof sfxSlotSpin==='function') sfxSlotSpin();
    const finalReels=[_pickSymbolIdx(),_pickSymbolIdx(),_pickSymbolIdx()];
    const startTime=Date.now();
    /* v2.0.28: duration 2400 → 1900 — wcześniej animacja kończyła wszystkie bębny po 1900ms (stopTime 900+500+500),
       ale finalize wywoływany dopiero po 2400ms → 500ms ciszy z static reels. Teraz finalize NATYCHMIAST po stop. */
    const duration=1900;
    G._slotsCooldownUntil=startTime+duration+150;
    // v1.8.17: finalize natychmiast gdy gracz wychodzi (zapobiega exploit przyspieszania animacji)
    let finalized=false;
    const _finalize=()=>{
      if(finalized) return;
      finalized=true;
      reels=finalReels;
      spinning=false;
      if(!G.casinoStats) G.casinoStats={slotsSpins:0,slotsWon:0,rouletteSpins:0,rouletteWon:0,blackjackPlayed:0,blackjackWon:0,warPlayed:0,warWon:0,biggestWin:0,totalWon:0,totalLost:0};
      G.casinoStats.slotsSpins++;
      if(reels[0]===reels[1] && reels[1]===reels[2]){
        // 3-of-kind
        const sym=SYMBOLS[reels[0]];
        const win=_bet*sym.pay3;
        G.casinoChips+=win;
        G.casinoStats.slotsWon++;
        G.casinoStats.totalWon+=win;
        if(win>G.casinoStats.biggestWin)G.casinoStats.biggestWin=win;
        if(sym.s==='💎'){
          // v2.0.12: stary bonus bet*10*vipMult usunięty — różnica regular/VIP teraz w pay2 + niejednolitych bębnach
          lastResult=`💎💎💎 J A C K P O T ! ! ! 💎💎💎<br><span style="color:#27ae60">+${win.toLocaleString('pl')}🎟️</span>`;
          if(typeof confetti==='function')confetti(60);
          /* v2.0.25: MEGA WIN — jackpot fanfara zamiast zwykłego cash */
          if(typeof sfxJackpot==='function')sfxJackpot();
          if(typeof showGain==='function')showGain('+'+win.toLocaleString('pl')+' 🎟️','#f1c40f');
        } else {
          lastResult=`🎉 ${sym.s}${sym.s}${sym.s} — wygrana ${win.toLocaleString('pl')} 🎟️ (${sym.pay3}×)`;
          if(typeof sfxCash==='function')sfxCash();
          if(typeof showGain==='function')showGain('+'+win.toLocaleString('pl')+' 🎟️','#27ae60');
          if(win>=1000 && typeof confetti==='function')confetti(25);
        }
      } else {
        // v2.0.12: 2-of-kind (dokładnie 2 z 3 takie same)
        let pairIdx=-1;
        if(reels[0]===reels[1] || reels[0]===reels[2]) pairIdx=reels[0];
        else if(reels[1]===reels[2]) pairIdx=reels[1];
        if(pairIdx>=0 && SYMBOLS[pairIdx].pay2>0){
          const sym=SYMBOLS[pairIdx];
          const win=Math.max(1,Math.floor(_bet*sym.pay2));
          G.casinoChips+=win;
          G.casinoStats.slotsWon++;
          G.casinoStats.totalWon+=win;
          /* v2.1.179: pay2 >= 1 = "zwrot stawki" (1× = exact return), pay2 < 1 = "drobny zwrot" (część stawki) */
          lastResult=`✨ 2× ${sym.s} — ${sym.pay2>=1?'zwrot stawki':'drobny zwrot'} ${win.toLocaleString('pl')} 🎟️ (${sym.pay2}×)`;
          if(typeof sfxCash==='function')sfxCash();
          if(typeof showGain==='function')showGain('+'+win.toLocaleString('pl')+' 🎟️','#27ae60');
        } else {
          lastResult=`${SYMBOLS[reels[0]].s} ${SYMBOLS[reels[1]].s} ${SYMBOLS[reels[2]].s} — przegrana`;
          G.casinoStats.totalLost+=_bet;
        }
      }
      if(typeof updateHUD==='function')updateHUD();
      _syncBetFromInput();
      window._activeCasinoFinalize=null;
      if(document.getElementById('slots-cv')) _render();
    };
    window._activeCasinoFinalize=_finalize;
    const _animate=()=>{
      if(finalized) return;
      const elapsed=Date.now()-startTime;
      const rel=[0,0,0];
      for(let i=0;i<3;i++){
        const stopTime=900+i*500;
        if(elapsed<stopTime){
          rel[i]=_pickSymbolIdx();
        } else {
          rel[i]=finalReels[i];
        }
      }
      _drawReels(rel);
      if(elapsed<duration){requestAnimationFrame(_animate);}
      else _finalize();
    };
    requestAnimationFrame(_animate);
  };
  _render();
  openOverlay();
};

