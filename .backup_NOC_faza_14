    G.energy=clampStat('energy', G.energy-5);addXP(20);progressQuest('carwash'); // v1.8.59: carwash 9→5 (-70% od oryginału 15)
    /* v2.1.120: Wave 6 N19 — rep konsystencja: +1 rep co 5 myć (parallel z pizza/kurier). */
    if(G._cwCount%5===0){G.streetRep=Math.min(100,(G.streetRep||0)+1);if(typeof addNotif==='function')addNotif('🚗 +1 rep uliczna (po 5 myciach — ludzie znają Cię)');}
    ctx.fillStyle='rgba(0,0,0,.85)';ctx.fillRect(0,0,W,H);
    ctx.fillStyle='#27ae60';ctx.font='bold 28px "Segoe UI",sans-serif';ctx.textAlign='center';
    ctx.fillText('🚗✨ Auto umyte perfekcyjnie!',W/2,H/2-22);
    ctx.fillStyle='#f1c40f';ctx.font='bold 26px "Segoe UI",sans-serif';
    ctx.fillText(`+${pay} zł`,W/2,H/2+14);
    ctx.fillStyle='#7ec8e3';ctx.font='15px "Segoe UI",sans-serif';
    ctx.fillText(`Skill myjni: ${skill} | XP: +20`,W/2,H/2+44);
    ctx.textAlign='left';
    notify(`🚗 Myjnia zakończona! +${pay} zł`);
    closeJobPanelAfter(3000);
  }
  window._jobMgCleanup=()=>{over=true;cancelAnimationFrame(raf);document.removeEventListener('keydown',keydown);document.removeEventListener('keyup',keyup);panel.classList.remove('on');panel.style.display='none';document.getElementById('mg-job-content').innerHTML='';};
}

