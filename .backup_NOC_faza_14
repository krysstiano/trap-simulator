    document.getElementById('mv-track-picker')?.remove();
    setTimeout(()=>startYTMinigame('Muzyczny'),400);
  };
}

let recBarAnim=null,recBarPos=0,recBarDir=1;
function startRecBar(){
  if(recBarAnim) clearInterval(recBarAnim);
  recBarPos=0;recBarDir=1;
  recBarAnim=setInterval(()=>{
    recBarPos+=recBarDir*1.2;if(recBarPos>=96||recBarPos<=0) recBarDir*=-1;
    const b=document.getElementById('rec-bar');
    if(b) b.style.left=recBarPos+'%';else clearInterval(recBarAnim);
  },16);
}

function doRecord(){
  if(recBarAnim){clearInterval(recBarAnim);recBarAnim=null;}
  const inZone=recBarPos>=35&&recBarPos<=65;
  const camQ=G.camera?G.camera.quality:10;
  const rawMicQ=G.mic?G.mic.quality:10;
  const ifMult=G.mic&&G.mic.type==='xlr'?(G.audioInterface?G.audioInterface.ifMult:0.3):1;
  const micQ=Math.floor(rawMicQ*ifMult);
  const acousticBonus=(G.acousticFoams||0)*3+(G.acousticPanels||0)*6; // #36B stackujące
  const headBonus=G.headphones?Math.floor(G.headphones.quality/20):0;
  // v1.8.97: akcesoria muzyczne realnie aplikowane: statyw +3, popfiltr +2, koszyk +4, selfie ring +8% (vlog)
  const accBonus=((G._musicAcc?.statyw)?3:0)+((G._musicAcc?.popfiltr)?2:0)+((G._musicAcc?.koszyk)?4:0);
  const ringMult=(G._musicAcc?.ring)?1.08:1;
  const base=inZone?70:40;
  let _ytQ=Math.floor((base*(camQ/100)+micQ*.12+acousticBonus+headBonus+accBonus)*ringMult+rnd(0,12));
  /* v2.1.150: Music video bonus — jeśli gracz wybrał track dla "Muzyczny" genre, jakość singla daje bonus (max +30%) */
  let _mvBonus=0;
  if(G._ytMusicVideoTrack){
    const _tQ=G._ytMusicVideoTrack.masterQ||G._ytMusicVideoTrack.quality||50;
    _mvBonus=Math.floor(_tQ*0.3);
    _ytQ+=_mvBonus;
  }
  G.ytQuality=clamp(_ytQ,5,100);
  G.ytRecorded=true;G.ytEdited=false;
  G.energy=clampStat('energy', G.energy-15);G.hunger=clampStat('hunger', G.hunger-5);
  addXP(10);
  const r=document.getElementById('rec-result');
  if(r) r.textContent=(inZone?'✅ Świetne ujęcie!':'⚠️ Przeciętne.')+'  Jakość: '+G.ytQuality+'%  Gra: '+G.ytGame+(_mvBonus>0?` · 🎬 Music video bonus: +${_mvBonus}%`:'');
  setTimeout(()=>{closeMG();renderYTOverlay();openOverlay();},2000);
}

