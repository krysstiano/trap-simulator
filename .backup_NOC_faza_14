    // F+ 2026-05-12 #73: stary duplikat usunięty — używa się istniejącego tickBills() z G.bills (wywoływane wyżej w nextPeriod)
    /* v2.1.151+v2.1.161: Label Management passive income + promotion + evolution + studio costs */
    if(G.label?.type==='indie' && Array.isArray(G.label.artists) && G.label.artists.length>0){
