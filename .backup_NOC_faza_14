.copt-btns{display:flex;gap:8px;flex-wrap:wrap;}
.copt-btn{background:linear-gradient(145deg,rgba(14,22,40,0.7),rgba(10,16,30,0.7));border:1px solid rgba(126,200,227,0.18);color:#cfe7f5;font-size:13px;padding:9px 18px;cursor:pointer;border-radius:8px;transition:all .18s;font-family:inherit;font-weight:500;backdrop-filter:blur(4px);}
.copt-btn:hover{background:linear-gradient(145deg,rgba(28,44,72,0.8),rgba(18,28,52,0.8));border-color:rgba(126,200,227,0.45);color:#fff;transform:translateY(-1px);}
.copt-btn.active{background:linear-gradient(145deg,rgba(40,80,140,0.85),rgba(20,42,82,0.85));border-color:rgba(126,200,227,0.7);color:#fff;box-shadow:0 4px 14px rgba(126,200,227,.25),inset 0 1px 0 rgba(255,255,255,.08);}
.name-inp{background:linear-gradient(145deg,rgba(14,22,40,0.7),rgba(10,16,30,0.7));border:1px solid rgba(126,200,227,0.25);color:#fff;font-family:inherit;font-size:17px;padding:11px 16px;border-radius:8px;width:260px;transition:all .18s;}
.name-inp:focus{outline:none;border-color:rgba(126,200,227,0.7);background:linear-gradient(145deg,rgba(20,32,54,0.8),rgba(14,22,42,0.8));box-shadow:0 0 0 3px rgba(126,200,227,.1);}
.start-btn{background:linear-gradient(145deg,#8edff5,#5ab4d2);border:1px solid rgba(126,200,227,0.7);color:#020a14;font-family:inherit;font-size:17px;font-weight:800;padding:14px 48px;cursor:pointer;border-radius:10px;margin-top:14px;letter-spacing:1.5px;transition:all .22s cubic-bezier(0.22,0.61,0.36,1);text-transform:uppercase;box-shadow:0 8px 24px rgba(126,200,227,.4),inset 0 1px 0 rgba(255,255,255,.3);}
