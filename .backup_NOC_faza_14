    X.fillStyle='#2a2a32';X.fillRect(sx-68,sy + (isNorth?-36:32),136,8);
    X.fillStyle='#4a4a55';X.fillRect(sx-68,sy + (isNorth?-36:32),136,2.5);
    X.fillStyle='#1a1a22';X.fillRect(sx-68,sy + (isNorth?-29:39),136,1.5);
    // Ławka — zawsze BLIŻEJ JEZDNI (po stronie isNorth ? S strona : N strona)
    const benchY = isNorth ? sy-1 : sy-13; // N: ławka tuż pod sy (od strony S); S: ławka powyżej sy (od strony N)
    X.fillStyle='#3a2008';X.fillRect(sx-44,benchY,88,14);
    X.fillStyle='#7a4a20';X.fillRect(sx-44,benchY,88,3);
