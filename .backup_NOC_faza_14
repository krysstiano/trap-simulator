// Cykl 25s: 12s zielone auta + 3s żółte → 7s zielone piesi + 3s żółte (przygotowanie)
// Każde skrzyżowanie ma 4 sygnalizatory aut (4 strony) + 2 sygnalizatory pieszych (po obu stronach przejścia)
function getTrafficLight(){
  // F+ 2026-05-12 v2: PEŁNA mechanika z DECAY 2s (user request)
  // Cykl 26s:
  //   0-9s: cars=GREEN, peds=red (auta jadą)
  //   9-12s: cars=YELLOW, peds=red (transition pre-stop)
  //   12-14s: cars=RED, peds=RED (DECAY 2s — auta stoją, piesi czekają — bezpieczeństwo)
  //   14-21s: cars=red, peds=GREEN (piesi przechodzą — 7s)
  //   21-23s: cars=red, peds=RED (DECAY 2s — piesi NIE zaczynają, auta dalej czerwone)
  //   23-26s: cars=YELLOW, peds=red (transition pre-go — przygotowanie kierowców)
  // Po 26s cykl restart
  if(typeof G!=='undefined' && G.timeOfDay===3){
    const blink=(Date.now()%1200)<600;
    return blink ? {cars:'yellow',peds:'red'} : {cars:'off',peds:'off'};
  }
  const t=(Date.now()%26000);
  if(t<9000) return {cars:'green',peds:'red'};   // 9s zielone auta
  if(t<12000) return {cars:'yellow',peds:'red'}; // 3s żółte
  if(t<14000) return {cars:'red',peds:'red'};    // 2s DECAY (auta zatrzymują, piesi czekają)
  if(t<21000) return {cars:'red',peds:'green'};  // 7s zielone piesi
  if(t<23000) return {cars:'red',peds:'red'};    // 2s DECAY (piesi kończą)
  return {cars:'yellow',peds:'red'};             // 3s żółte pre-green
}
