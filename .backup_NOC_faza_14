function snapCamera(){const room=ROOMS[currentRoom];const wW=room.wT*T,wH=room.hT*T;cam.x=clamp(P.wx+P.w/2-640,0,Math.max(0,wW-1280));cam.y=clamp(P.wy+P.h/2-360,0,Math.max(0,wH-658));cam._initialized=true;}

function updatePlayer(){
  /* v1.9.89: kamera rusza nawet gdy paused — wymagane dla cinematic flythrough */
  if(window._cinemCam && window._cinemCam.active){
    P.moving=false; /* v2.1.21: clear żeby kroki NIE grały gdy user trzymał strzałkę przed odpaleniem przelot kamerą */
    updateCamera();
    return;
  }
  if(_paused) return;
  if(overlayOpen()||phoneOpen()||mgOpen()) return;
  if(npcDlgOpen()) return;
  if(G._resting) return;
  const sleepOv=document.getElementById('sleep-overlay');
  if(sleepOv&&sleepOv.classList.contains('on')) return;
  // Cinematic active (intro/milestone/itp.) — blokuj ruch dopóki widoczny
  // DOM-first: element istnieje = aktywny | usunięty = automatyczne odblokowanie (samoresetujący)
  if(document.querySelector('[id$="-cinematic"]')) return;
  let dx=0,dy=0;
  if(K['ArrowUp']||K['w']||K['W']){dy=-P.spd;P.dir=0;}
  if(K['ArrowDown']||K['s']||K['S']){dy=P.spd;P.dir=2;}
  if(K['ArrowLeft']||K['a']||K['A']){dx=-P.spd;P.dir=3;}
  if(K['ArrowRight']||K['d']||K['D']){dx=P.spd;P.dir=1;}
  if(dx!==0 && dy!==0){
    const norm = 1/Math.sqrt(2);
    dx *= norm; dy *= norm;
  }
  if(G.car&&(dx!==0||dy!==0)&&currentRoom==='ulica'&&G._inCar){const boost=G.car.speed||1;dx*=boost;dy*=boost;}
  /* v2.1.26: ROLLBACK delta-time normalization. v2.1.17 wprowadził dt, ale powodował niestabilną prędkość.
     User: "Czasem normalna, czasem ultra wolna" + "Gracz dalej porusza sie ultra wolno. Nie było tak wcześniej."
     Powrót do prostej P.wx += dx (jak przed v2.1.17). Browser handluje FPS przez requestAnimationFrame
     co naturalnie skaluje (60 FPS = 60 klatek/sec niezależnie od ekranu). */
  P.moving=dx!==0||dy!==0;
  if(P.moving){anim++; if(!G._tutStat)G._tutStat={}; if(anim%10===0) G._tutStat.moved=(G._tutStat.moved||0)+1;} /* v1.9.48: throttle 1 inkrement co 10 klatek (audyt tutorial: ~60fps × 30 = 0.5s; po fixie ~5s) */
  const room=ROOMS[currentRoom];
  let nx=clamp(P.wx+dx,0,room.wT*T-P.w);
  let ny=clamp(P.wy+dy,62,room.hT*T-P.h-8);
  // Building collision (only on ulica)
  if(currentRoom==='ulica'){
    const bldgs=room.objects.filter(o=>o.w>60&&o.h>60&&!o.id.startsWith('npc_')&&o.id!=='bench'&&o.id!=='bench2'&&o.id!=='pond'&&o.id!=='skate'&&o.id!=='bboying'&&o.id!=='save'&&o.id!=='wardrobe'&&o.id!=='apt_cust'&&o.id!=='phone_home'&&o.id!=='freestyle_spot');
    // Park fence collision — segmenty wokół parku x:0-672, y:864-1248. Wejście tylko przez bramkę c=13, r=21-22 (wy 1008-1104)
    const FT=14; // grubość płotku
    const parkFence=[
      // Górny płotek: y=864 (cała szerokość 0-672)
      {wx:0,wy:864-FT/2,w:672,h:FT},
      // Dolny płotek: y=1248
      {wx:0,wy:1248-FT/2,w:672,h:FT},
      // Prawy płotek górny (r=18-20): y=864-1008
      {wx:672-FT,wy:864,w:FT,h:1008-864},
      // Prawy płotek dolny (r=23-25): y=1104-1248
      {wx:672-FT,wy:1104,w:FT,h:1248-1104},
    ];
    const allCollide=[...bldgs,...DB_DECORATIVE,...parkFence];
    const pw=P.w,ph=P.h;
    // Try X movement first
    const testX={wx:nx,wy:P.wy};
    for(const b of allCollide){
      if(testX.wx<b.wx+b.w&&testX.wx+pw>b.wx&&testX.wy<b.wy+b.h&&testX.wy+ph>b.wy){nx=P.wx;break;}
    }
    // Try Y movement
    const testY={wx:nx,wy:ny};
    for(const b of allCollide){
      if(testY.wx<b.wx+b.w&&testY.wx+pw>b.wx&&testY.wy<b.wy+b.h&&testY.wy+ph>b.wy){ny=P.wy;break;}
    }
  } else {
    // Wewnątrz pokojów (mieszkanie/premium/lux/studio/silownia/merch_studio) — kolizja z obiektami solid (ściany)
    const walls=room.objects.filter(o=>o.solid);
    if(walls.length){
      const pw=P.w,ph=P.h;
      const testX={wx:nx,wy:P.wy};
      for(const b of walls){if(testX.wx<b.wx+b.w&&testX.wx+pw>b.wx&&testX.wy<b.wy+b.h&&testX.wy+ph>b.wy){nx=P.wx;break;}}
      const testY={wx:nx,wy:ny};
      for(const b of walls){if(testY.wx<b.wx+b.w&&testY.wx+pw>b.wx&&testY.wy<b.wy+b.h&&testY.wy+ph>b.wy){ny=P.wy;break;}}
    }
  }
  P.wx=nx;P.wy=ny;
  // F+ DUPLIKAT KROKÓW — usunięty drugi dźwięk kroków (sfxStep "noise" w tle).
  // Gracz miał 2 nakładające się dźwięki: playStep (tup-tup, gameLoop) + sfxStep (szuru-szuru, tu).
  // Zostaje TYLKO playStep przez maybeSoundStep w gameLoop.
  // Reset licznika żeby nie eskalował:
  if(!P.moving) P._stepCnt=0;
  updateCamera();
  const nearId=getNear();
  const pr=document.getElementById('prompt');
  if(nearId&&!overlayOpen()&&!phoneOpen()&&!npcDlgOpen()){
    const obj=ROOMS[currentRoom].objects.find(o=>o.id===nearId);
    if(obj){
      let txt=obj.prompt;
      // Dynamic apartment label
      if(obj.act==='enter_apt'){
        const aptName=G.apartment==='mega_villa'?'Mega Villa 🏖':G.apartment==='mansion'?'Rezydencja 🏰':G.apartment==='luxury'?'Penthouse 💎':G.apartment==='premium'?'Apartament Premium':G.apartment==='basic'?'Mieszkanie Podstawowe':'Traphouse';
        txt=`[E] Wejdź — ${aptName}`;
      }
      // Studio Merch — wymaga 5000 fanów
      if(obj.id==='merch_studio'){
        if((G.fans||0)<5000) txt=`🔒 Studio Projektowania — wymaga 5000 fanów (masz ${(G.fans||0).toLocaleString('pl')})`;
        else txt='[E] Studio Projektowania';
      }
      // Dynamic lock hints for career objects
      // v1.8.71: poprawne wymogi + info o alternatywnej ścieżce przez drzewko umiejętności
      if(obj.act&&obj.act.startsWith('open:')){
        const cid=obj.act.slice(5);
        const carNames={youtuber:'YouTuber',beatmaker:'Beatmaker',gamer:'Gamer',influencer:'Influencer',soundeng:'Realizator Dźwięku'};
        if(carNames[cid]&&G.careers&&G.careers[cid]&&!G.careers[cid].unlocked){
          const totalXP=G.xp+(G.level-1)*CFG.xpPerLevel;
          // v1.8.71: influencer wymaga 500 followers (nie xpReq=200 — to było źle); reszta używa właściwych progów
          if(cid==='influencer') txt=`🔒 ${carNames[cid]} — wymaga 500 fanów (masz ${(G.fans||0)})`;
