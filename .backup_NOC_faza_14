    X.beginPath();X.arc(sx,sy,3,0,Math.PI*2);X.stroke();
    // Refleks światła
    X.fillStyle='rgba(120,120,120,.35)';
    X.beginPath();X.arc(sx-3,sy-3,1.5,0,Math.PI*2);X.fill();
    // F+ Punkt #5: Para wieczorem/nocą (timeOfDay>=2) — animowana mgła kanalizacyjna
    if(G.timeOfDay>=2 && (m.wx*7+m.wy*3)%3===0){ // tylko 1/3 studzienek paruje
      const _pt=Date.now();
      for(let p=0;p<3;p++){
        const phase=_pt*0.0008+m.wx*0.01+p*1.2;
        const py=sy-8-((_pt*0.05+p*40)%50);
