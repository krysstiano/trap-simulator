    addXP(5);renderInfluencerOverlay();return;
  }
  const inflSk=getSkillLvl('influencer'); // F3-FIX-B (raw lvl jeszcze uzywany w UI)
  // Sponsor: stawka × followers obniżona (0.1→0.04), cap 12k aby late-game nie eksplodowało
  let payment=Math.min(12000,Math.floor((rnd(100,400)+Math.floor(G.followers*.04))*(1+inflSk*0.10)));
