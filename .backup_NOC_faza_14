const BANK_INVEST_MAX=3;
window.invest=(amount,days,pct)=>{
  /* v2.1.225 BUG #35 fix: defensive validation — wcześniej cheat console `invest(-1000,...)` → G.money += 1000 (gain!),
     plus NaN z corrupt input mógł skorumpować save (G.money=NaN). */
  if(typeof amount!=='number' || !Number.isFinite(amount) || amount<=0){
    notify('Nieprawidłowa kwota inwestycji!');return;
  }
  if(typeof days!=='number' || !Number.isFinite(days) || days<=0){
    notify('Nieprawidłowa liczba dni!');return;
  }
  if(typeof pct!=='number' || !Number.isFinite(pct)){
    notify('Nieprawidłowy procent zwrotu!');return;
  }
  if(!G.bank.investments) G.bank.investments=[];
  if(G.bank.investments.length>=BANK_INVEST_MAX){
    notify(`📈 Limit aktywnych inwestycji: ${BANK_INVEST_MAX}. Poczekaj na zwrot lub zamknij którąś.`);
    return;
  }
  if(G.money<amount){notify('Za mało pieniędzy!');return;}
  G.money-=amount;
  const returnAmount=Math.floor(amount*(1+pct/100));
  G.bank.investments.push({amount,returnAmount,returnDay:G.day+days});
  notify(`📈 Zainwestowano ${amount.toLocaleString('pl')} zł → zwrot ${returnAmount.toLocaleString('pl')} zł za ${days} dni`);
  renderPhoneApp('bank');
};
