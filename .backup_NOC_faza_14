/* ─── CREW CHALLENGES (Faza E) ───────────────────────────────────── */
const CREW_CHALLENGE_TYPES=[
  {type:'earn_money',  emoji:'💰', title:'Zarobcie razem 100 000 zł', target:100000},
  {type:'play_concerts',emoji:'🎤',title:'Zagrajcie razem 5 koncertów', target:5},
  {type:'record_tracks',emoji:'💿',title:'Nagrajcie razem 3 tracki', target:3},
  /* v2.1.141: gain_fans aktywowane — refactor G.fans hooks ukończony, wszystkie 11 miejsc używa addFans() wrapper (L12270+). */
  {type:'gain_fans',   emoji:'👥', title:'Zdobądźcie razem 5 000 fanów', target:5000},
];
function _crewWeekKey(){
  /* ISO week format YYYY-WXX */
  const d=new Date();
  d.setHours(0,0,0,0);
  d.setDate(d.getDate()+4-(d.getDay()||7));
  const yearStart=new Date(d.getFullYear(),0,1);
  const weekNum=Math.ceil(((d-yearStart)/86400000+1)/7);
  return d.getFullYear()+'-W'+String(weekNum).padStart(2,'0');
}
window._crewFetchChallenge=async function(){
  if(!G.playerCrew) return null;
  const wk=_crewWeekKey();
  const rows=await _lbFetch(`crew_challenges?crew_id=eq.${G.playerCrew.id}&week_key=eq.${wk}&limit=1`);
  if(!Array.isArray(rows)||rows.length===0){
    /* Auto-generate wyzwanie dla tego tygodnia jeśli jestem leaderem */
    if(G.playerCrew.isLeader){
      const t=CREW_CHALLENGE_TYPES[Math.floor(Math.random()*CREW_CHALLENGE_TYPES.length)];
      await _lbFetch('crew_challenges',{
        method:'POST',
        headers:{'Prefer':'resolution=ignore-duplicates,return=minimal'},
        body:JSON.stringify({
          crew_id:G.playerCrew.id, week_key:wk, type:t.type, emoji:t.emoji, title:t.title,
          target:t.target, progress:0, reward_xp:500, reward_money:1000
        })
      });
      const refetch=await _lbFetch(`crew_challenges?crew_id=eq.${G.playerCrew.id}&week_key=eq.${wk}&limit=1`);
      return Array.isArray(refetch)&&refetch.length>0?refetch[0]:null;
    }
    return null;
  }
  return rows[0];
};
/* v2.1.55 Amper: NAPRAWA race condition w postępie crew challenge.
   Wcześniej: każdy earn() (kilkanaście/min) wywoływał async _crewAddProgress → fetch + patch.
   Wszystkie równoczesne wywołania czytały TĘ SAMĄ starą wartość progress i nadpisywały się — Amper zarobił >100k ale progress utknął na ~10k bo wszystko poza ostatnim patchem ginęło.
   Naprawa: lokalna kolejka per-type + atomowy flush co max 5s. Wielokrotne earn() sumują się lokalnie, jeden patch wysyła sumę. */
window._crewProgressQueue=window._crewProgressQueue||{};
window._crewProgressLastFlush=window._crewProgressLastFlush||0;
window._crewProgressFlushing=false;
window._crewAddProgress=function(type,amount){
  if(!G.playerCrew||!amount||amount<=0) return;
  window._crewProgressQueue[type]=(window._crewProgressQueue[type]||0)+amount;
  const now=Date.now();
  if(now-window._crewProgressLastFlush>5000){
    window._crewProgressLastFlush=now;
    _crewFlushProgress();
  }
};
async function _crewFlushProgress(){
  if(window._crewProgressFlushing) return;
  if(!G.playerCrew) return;
  window._crewProgressFlushing=true;
  try{
    const challenge=await _crewFetchChallenge();
    if(!challenge||challenge.completed){window._crewProgressQueue={};return;}
    const amount=window._crewProgressQueue[challenge.type]||0;
    if(amount<=0) return;
    window._crewProgressQueue[challenge.type]=0;
    const newProgress=Math.min(challenge.target,(challenge.progress||0)+amount);
    const willComplete=newProgress>=challenge.target;
    await _lbFetch(`crew_challenges?id=eq.${challenge.id}`,{
      method:'PATCH',
