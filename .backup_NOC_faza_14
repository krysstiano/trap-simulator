          <button onclick="window._bjDeal()" class="cta-pulse" style="background:linear-gradient(145deg,#2eaf5a,#1a7838);color:#fff;border:1px solid rgba(46,175,90,.7);padding:12px 28px;font-size:15px;font-weight:700;cursor:pointer;border-radius:10px;font-family:inherit;letter-spacing:1px">🃏 ROZDAJ</button>
