          if(typeof saveGameSilent==='function') saveGameSilent();
        });
      } else {
        /* fallback gdy gameConfirm niedostępne */
        if(!confirm('🅿️ Zaparkować auto tutaj? Auto zostanie na parkingu — wróć tu aby odebrać.')) return;
        const parkObj=ROOMS.ulica.objects.find(o=>o.id==='parking');
        const slotPos=_findFreeParkingSpot(parkObj);
        G._carParkedAt=slotPos;
        G._inCar=false;
        G._carsParked=(G._carsParked||0)+1;
        if(typeof showMsg==='function') showMsg('🅿️ Zaparkowałeś auto na parkingu. Wróć tutaj, by je odebrać (E).');
      }
      return; /* asynchroniczne — zapis przez callback w gameConfirm */
    } else if(G._carParkedAt){
      // Auto stoi na parkingu — gracz odbiera je
      G._carParkedAt=null;
      G._inCar=true;
      if(typeof showMsg==='function')showMsg('🚗 Wsiadłeś do auta — szybki transport po mieście aktywny (boost prędkości).');
