function findSponsor(){
  /* v2.1.116: Wave 7 W77 — single sponsor deal/dzień (anty 4-source stack: findSponsor + runCampaign + tweet + event razem dawały 33k zł/dzień). */
  if(G._sponsorDealActive===G.day){showMsg('💼 Masz już dzisiaj aktywny deal sponsorski. Wróć jutro.','r');return;}
  if(G._lastSponsorDay===G.day){showMsg('💼 Już znalazłeś dziś sponsora.','r');return;}
  if((G.energy||0)<15){showMsg('⚡ Za mało energii (potrzeba 15 — negocjacje męczą)','r');return;}
