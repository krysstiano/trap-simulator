      cx.fillStyle='#1a1a22';cx.fillRect(x,y,80,140);
      cx.strokeStyle='#c8a520';cx.lineWidth=2;cx.strokeRect(x,y,80,140);
      // Symbol
      cx.fillStyle='#fff';
