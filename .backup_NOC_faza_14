              const btnHtml = owned ? `<span style="font-size:9px;color:#27ae60;font-weight:700">KUPIONE</span>` :
                `<button ${canBuy?'':'disabled'} onclick="window.buyPowerUp('${key}',${i})" style="background:${canBuy?'#3a1a5a':'#0a0a14'};border:1px solid ${canBuy?'#9b59b6':'#1a2a3a'};color:${canBuy?'#cf9be8':'#334'};padding:2px 6px;border-radius:3px;cursor:${canBuy?'pointer':'not-allowed'};font-size:9px;white-space:nowrap">${p.cost} zł</button>`;
              return `<div style="display:flex;align-items:center;gap:4px;margin-bottom:4px;font-size:10px">
                <span style="flex-shrink:0">${statusIcon}</span>
