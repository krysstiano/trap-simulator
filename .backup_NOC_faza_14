// Detale uliczne — donice z kwiatami, hydranty, ławki, kosze, billboardy.
// Pozycje deterministyczne, by się nie zmieniały między klatkami.
// Walidator pozycji dla dekoracji miejskich — gwarantuje że hydrant/kosz NIGDY
// nie wpada na jezdnię ani na inny obiekt. Wywoływane raz przy starcie + cache wynik.
function _isOnRoad(wx,wy){
  // Jezdnie V (chodniki bezpieczne — między 14-21/44-51/70-77 jest też road dla V2, V1, V3)
  // Jezdnia: V1 768-960, V2 2208-2400, V3 3456-3648
  // Jezdnia: H1 384-576, H2 1920-2112, H3 2880-3072
  if(wy>=384&&wy<=576) return true;
  if(wy>=1920&&wy<=2112) return true;
  if(wy>=2880&&wy<=3072) return true;
  if(wx>=768&&wx<=960) return true;
  if(wx>=2208&&wx<=2400) return true;
  if(wx>=3456&&wx<=3648) return true;
  return false;
}
function _collidesWithSt(wx,wy,others,minDist){
  for(const o of others){
    if(Math.abs(o.wx-wx)<minDist && Math.abs(o.wy-wy)<minDist) return true;
  }
  return false;
}
function _validateStPositions(arr,others=[]){
  return arr.filter(p=>!_isOnRoad(p.wx,p.wy) && !_collidesWithSt(p.wx,p.wy,others,30));
}
