window.getPrestigeReqs=function(rank){
  const r=rank||((G.prestige||0)+1);
  return {level:15+(r-1)*3, fans:100000*Math.pow(2,r-1)}; // P1=lvl15+100k, P2=lvl18+200k, P3=lvl21+400k, P5=lvl27+1.6M, P10=lvl42+51M
};
/* v2.1.160: Prestige Skill Tree — 6 permanentnych perków, każde Prestige = 1 punkt. Persystują przez kolejne Prestige.
   Per-perk: koszt 1 pt, działa permanentnie na top of base prestige bonuses. */
const PRESTIGE_SKILLS={
  studio_mogul:{name:'Studio Mogul',emoji:'🎙',desc:'+10% royalties (Spotify/Tidal/SoundCloud)',cost:1},
  cult_following:{name:'Cult Following',emoji:'👑',desc:'+20% addFans (każde źródło fanów)',cost:1},
  iron_discipline:{name:'Iron Discipline',emoji:'💪',desc:'-15% energy drain (mniej szybkie zmęczenie)',cost:1},
