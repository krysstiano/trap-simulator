    closeJobPanelAfter(2800);
    setTimeout(()=>{if(panel.classList.contains('on'))return;openCareerOverlay('gamer');},2900);
  }
  window._jobMgCleanup=()=>{over=true;cancelAnimationFrame(raf);document.removeEventListener('keydown',kh);if(keyTimeout)clearTimeout(keyTimeout);panel.classList.remove('on');document.getElementById('mg-job-content').innerHTML='';};
  nextRound();
}

