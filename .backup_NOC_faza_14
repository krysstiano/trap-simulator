/* v2.1.225: Quality calc — crew + scenario vibe + outfit (Crown +10) + drip 100+ (+5) + random 0-20. Cap 100. */
function _musicVideoCalcQuality(crewTier, scenario){
  const crew=MUSIC_VIDEO_CREW.find(c=>c.id===crewTier);
  const scn=MUSIC_VIDEO_SCENARIOS.find(s=>s.id===scenario);
  if(!crew||!scn) return 0;
  let q=crew.qualityBoost + scn.vibeBonus;
  /* Outfit bonus: Crown of Hip-Hop +10 */
  if(G.outfit?.top==='crown_of_hh') q+=10;
  /* Drip bonus */
  if((G.drip||0)>=100) q+=5;
  /* Random variance 0-20 */
  q += Math.floor(Math.random()*21);
  return Math.min(100, q);
}

/* v2.1.225: Record music video — instant resolution (no minigame UI). */
window.recordMusicVideo=function(trackIdx, crewTier, scenario){
  if(!Array.isArray(G.musicVideos)) G.musicVideos=[];
  if(typeof trackIdx!=='number' || trackIdx<0 || trackIdx>=(G.studioTracks||[]).length){
    if(typeof showMsg==='function') showMsg('⚠️ Nieznany singiel','r');return;
  }
  const track=G.studioTracks[trackIdx];
  if(track.isDemo){if(typeof showMsg==='function') showMsg('⚠️ Demo NIE może mieć teledysku — wydaj pełen singiel','r');return;}
  /* 1 video per track — BUG #34 fix: compound key (name+releaseDay) bo player może nazwać 2 tracki same way */
  const _trackKey=`${track.name}_${track.releaseDay||0}`;
  if(G.musicVideos.some(v=>(v.trackKey||`${v.trackName}_${v.trackDay||0}`)===_trackKey)){
    if(typeof showMsg==='function') showMsg('⚠️ Ten singiel już ma teledysk','r');return;
  }
  /* 7-dni cooldown między teledyskami */
  if((G._lastMusicVideoDay||0)>0 && (G.day-G._lastMusicVideoDay)<7){
    const _left=7-(G.day-G._lastMusicVideoDay);
    if(typeof showMsg==='function') showMsg(`⚠️ Cooldown teledysków — następny za ${_left} ${_left===1?'dzień':'dni'}`,'r');return;
  }
  const crew=MUSIC_VIDEO_CREW.find(c=>c.id===crewTier);
  const scn=MUSIC_VIDEO_SCENARIOS.find(s=>s.id===scenario);
  if(!crew||!scn){if(typeof showMsg==='function') showMsg('⚠️ Nieprawidłowy crew/scenariusz','r');return;}
  if((G.money||0)<crew.cost){if(typeof showMsg==='function') showMsg(`⚠️ Brak ${crew.cost-G.money} zł na produkcję`,'r');return;}
  /* Charge money */
  G.money-=crew.cost;
  /* Calculate quality + effects */
  const quality=_musicVideoCalcQuality(crewTier, scenario);
  let streamsMult=1.2, viralChance=0.05, fameBonus=0;
  if(quality>=80){streamsMult=3.0; viralChance=0.30; fameBonus=10;}
  else if(quality>=50){streamsMult=1.8; viralChance=0.15;}
  const _viral=Math.random()<viralChance;
  /* Apply permanent streams boost */
  const _oldStreams=track.streams||0;
  const _newStreams=Math.floor(_oldStreams*streamsMult);
  const _bonusStreams=_newStreams-_oldStreams;
  track.streams=_newStreams;
  if(_viral) track.streams=Math.floor(track.streams*1.5);
  /* Spotify listeners + streams updated */
  if(G.spotify){
    G.spotify.streams=(G.spotify.streams||0)+_bonusStreams;
    G.spotify.listeners=(G.spotify.listeners||0)+Math.floor(_bonusStreams*0.1);
  }
  /* YouTube subs boost (music video → YT) */
  if(G.yt){
    G.yt.subs=(G.yt.subs||0)+Math.floor(_bonusStreams*0.05);
  }
  /* Fame bonus (high quality only) */
  if(fameBonus>0){
    if(typeof addFame==='function') addFame(fameBonus); else G.fame=Math.min(500,(G.fame||0)+fameBonus);
  }
  /* Save video record */
  /* BUG #34 fix: include trackKey + trackDay dla stable compound identifier (handle duplicate names) */
  G.musicVideos.push({trackName:track.name, trackKey:_trackKey, trackDay:track.releaseDay||0, scenario:scn.id, crewTier:crew.id, quality, day:G.day, viral:_viral, streamsBoost:streamsMult});
  G._lastMusicVideoDay=G.day;
  /* Notify + cinematic dla viral hits */
  const _qLabel=quality>=80?'🔥 LEGENDARNY':quality>=50?'💎 Mocny':'🎬 Standardowy';
  if(typeof notify==='function') notify(`🎬 Teledysk "${track.name}" (${scn.name}) — ${_qLabel} (Q${quality})! +${_bonusStreams.toLocaleString('pl')} streamów${_viral?' · 🔥 VIRAL ×1.5':''}${fameBonus>0?` · +${fameBonus} sławy`:''}`);
  if(typeof addNotif==='function') addNotif(`🎬 Teledysk: ${track.name} (Q${quality}) · streams ×${streamsMult}${_viral?' viral':''}`);
  if(_viral && typeof showMilestoneCinematic==='function' && quality>=80){
    showMilestoneCinematic({emoji:'🔥',title:'VIRALOWY TELEDYSK',subtitle:track.name,tagline:`${scn.name} · Q${quality}${fameBonus?' · +'+fameBonus+' sławy':''}`,accentColor:'#e91e8c',accent2:'#f1c40f',duration:5000});
  }
  /* Cleanup modal + refresh UI */
  document.getElementById('music-video-modal')?.remove();
  document.getElementById('music-video-modal-bd')?.remove();
  if(typeof renderPhoneMuzyka==='function') renderPhoneMuzyka();
  if(typeof saveGameSilent==='function') saveGameSilent();
};

