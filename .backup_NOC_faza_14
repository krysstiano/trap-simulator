window._acceptOrder=(id)=>{
  const o=SOUND_ORDERS.find(x=>x.id===id);if(!o)return;
  document.getElementById('order-picker')?.remove();
  G._lastSoundOrderDay=G.day;
  // Quality calc na podstawie miku + skill + reali
  const realLvl=(getRaperST&&getRaperST('realizacja'))||0;
  const micQ=G.mic?.quality||10;
  const skill=(G.skills?.soundeng)||0;
  const quality=Math.min(100,Math.round(40+micQ*0.3+realLvl*8+skill*5));
  /* v2.1.86 Amper: BUFF Sound Eng — baseline ×1.5 i skill scaling ×0.15→×0.25. Sound Eng był ekonomicznie martwy (~250 zł/dzień). Po buffie ~3-5k przy aktywnym graniu. */
  let pay=Math.floor((o.payMin+(o.payMax-o.payMin)*(quality/100))*1.5);
  pay=Math.floor(pay*(1+skill*0.25));
  // v1.8.99: Realizacja level scaling — desc obiecuje "Czysty dźwięk 300-800 zł" (lvl 2), "Legenda 5k-15k zł" (lvl 5). Bez tej formuły max wypłata to 5000 zł niezależnie od poziomu.
  if(realLvl>=5) pay=Math.floor(pay*2.5);
  else if(realLvl>=4) pay=Math.floor(pay*1.8);
  else if(realLvl>=2) pay=Math.floor(pay*1.3);
  if(G.managementDeal) pay=Math.floor(pay*G.managementBonus);
  earn(pay,false);G.careers.soundeng.projects++;G.energy=clampStat('energy', G.energy-o.energy);addXP(o.xpGain);
  // Czas zużyty (kilka godzin gry)
  if(typeof gameMin!=='undefined') gameMin=Math.min(1439,gameMin+o.timeMin);
  showMsg(`${o.em} "${o.name}" zakończone! Jakość: ${quality}%, +${pay} zł, +${o.xpGain} XP`,'g');
  if(typeof notify==='function') notify(`${o.em} +${pay} zł za zlecenie`);
  if(typeof updateHUD==='function') updateHUD();
  if(typeof renderSoundEngOverlay==='function') renderSoundEngOverlay();
};
/* v2.1.48 Amper: wydanie albumu RAPERA z tracków (storyline pkt 17 "Pierwszy album").
   Wcześniej istniał tylko releaseAlbum() dla beatmakera z bitów — raper nie miał możliwości wydania albumu.
   Wymaga: 5+ niezużytych tracków rapera, mikrofon q≥50, 2000 zł. Tracki zostają w katalogu (royalties),
   ale counter `tracksInAlbums` rośnie o 5 — kolejny album wymaga 5 nowych tracków. */
function releaseRaperAlbum(){
  if(!G.careers||!G.careers.raper){showMsg('🎤 Kariera rapera niedostępna','r');return;}
  const r=G.careers.raper;
  const tracks=r.tracks||0;
  const usedInAlbums=r.tracksInAlbums||0;
  const available=tracks-usedInAlbums;
  if(available<5){showMsg(`💿 Potrzebujesz 5 nowych tracków rapera (masz ${available} dostępnych)`,'r');return;}
  if(!G.mic||G.mic.quality<50){showMsg('🎙 Wymaga mikrofonu z jakością co najmniej 50%','r');return;}
  if((G.money||0)<2000){showMsg('💰 Potrzebujesz 2 000 zł na produkcję albumu','r');return;}
  G.money-=2000;
  r.tracksInAlbums=usedInAlbums+5;
  const micMult=G.mic.quality/100;
  const fameMult=1+Math.min(100,(G.fame||0))*0.01; /* v2.1.212: cap fame 100 dla album payout — fame >100 NIE eksploduje */
  let pay=Math.floor(rnd(5000,20000)*micMult*fameMult);
  /* v2.1.82 Amper: REBALANS releaseRaperAlbum — koniec eksplozji 5-30k słuchaczy z 1 albumu.
     Stary system: eksplozja → skokowy growth + niezdrowa krzywa.
     Nowy: skalowane z micQ + followers + fame. Targety: quality 50/1k followers/fame 20 → ~1500, quality 100/100k/fame 90 → ~9000. Reszta growth idzie przez Daily Organic Engine (v2.1.81). */
  let spListeners=Math.floor(100 + (G.mic.quality||50)*20 + (G.followers||0)*0.05 + Math.min(100,G.fame||0)*20); /* v2.1.212: cap fame coef 100 (anti-eksplozja album spotify listeners) */
  /* v2.1.113: Wave 1 W5 — streamBoost dystrybutora aplikowany do RAPER ALBUM (analogicznie do beatmaker). */
  const _distBoostRA=(G.distributor?.streamBoost)||1;
  if(_distBoostRA>1) spListeners=Math.floor(spListeners*_distBoostRA);
  if(typeof getRaperST==='function' && getRaperST('teksty')>=3){pay=Math.floor(pay*1.30);spListeners=Math.floor(spListeners*1.30);}
  if(typeof getRaperST==='function' && getRaperST('mikser')>=5 && G.label?.type && G.label.type!=='indie'){pay=Math.floor(pay*1.15);}
  if(G.managementDeal) pay=Math.floor(pay*(G.managementBonus||1));
  if(G.label?.type==='major') pay=Math.floor(pay*0.5);
  if(typeof earn==='function') earn(pay,false); else {G.money+=pay;G.totalEarned=(G.totalEarned||0)+pay;}
  G.spotify=G.spotify||{listeners:0};
  G.tidal=G.tidal||{listeners:0};
  G.spotify.listeners=(G.spotify.listeners||0)+spListeners;
  G.tidal.listeners=(G.tidal.listeners||0)+Math.floor(spListeners*0.3);
  G.followers=(G.followers||0)+Math.floor(spListeners*0.5);
  addFans(Math.floor(spListeners*0.3)); /* v2.1.141: spotify listeners → fans conversion */
  if(typeof addFame==='function') addFame(20); else G.fame=clamp((G.fame||0)+20,0,500);
  G.albumsReleased=(G.albumsReleased||0)+1;
  if(typeof addXP==='function') addXP(100);
  if(typeof checkAchievements==='function') checkAchievements();
  if(typeof checkStoryline==='function') checkStoryline();
  if(G.albumsReleased===1 && !G._debutAlbumShown && typeof showMilestoneCinematic==='function'){
    G._debutAlbumShown=true;
    showMilestoneCinematic({
      emoji:'💿',title:'DEBIUTANCKI ALBUM',subtitle:'Twój pierwszy krążek wydany',
      tagline:`+${pay.toLocaleString('pl')} zł · +${spListeners.toLocaleString('pl')} słuchaczy Spotify · +20 sławy`,
      accentColor:'#c8a520',accent2:'#9b59b6',duration:5000
    });
  } else {
    showMsg(`💿 ALBUM WYDANY! +${pay.toLocaleString('pl')} zł, +${spListeners.toLocaleString('pl')} słuchaczy Spotify, +20 sława!`);
  }
  addNotif(`💿 Album #${G.albumsReleased} wydany! +${pay.toLocaleString('pl')} zł`);
  if(typeof sfxCash==='function') sfxCash();
  if(typeof confetti==='function') confetti(40);
  if(typeof saveGameSilent==='function') saveGameSilent();
  if(typeof renderPhoneRaper==='function') renderPhoneRaper();
}
function releaseAlbum(){
  if(G.careers.beatmaker.beats<5||!G.mic||G.mic.quality<50||G.money<2000) return;
  G.money-=2000;G.careers.beatmaker.beats-=5;
  const micMult=G.mic.quality/100;const fameMult=1+Math.min(100,(G.fame||0))*0.01; /* v2.1.216 [Amper]: cap fame 100 — beatmaker releaseAlbum NIE eksploduje przy fame 500 (wcześniej ×6 max payout exploit) */
  let pay=Math.floor(rnd(5000,20000)*micMult*fameMult);
  /* v2.1.82 Amper: REBALANS releaseAlbum (beatmaker) — analogiczna naprawa eksplozji jak rap album. Skalowane z micQ + followers + fame. */
  let spListeners=Math.floor(100 + (G.mic.quality||50)*20 + (G.followers||0)*0.05 + Math.min(100,G.fame||0)*20); /* v2.1.212: cap fame coef 100 (anti-eksplozja album spotify listeners) */
  /* v2.1.113: Wave 1 W5 — streamBoost dystrybutora aplikowany do ALBUM (wcześniej tylko singel). Empire ×1.3, AWAL ×1.2. */
  const _distBoostAlb=(G.distributor?.streamBoost)||1;
  if(_distBoostAlb>1) spListeners=Math.floor(spListeners*_distBoostAlb);
  // v1.8.97: Teksty 3 — "Albumy sprzedają się o 30% lepiej" (wcześniej fake — nie czytane)
  if(typeof getRaperST==='function' && getRaperST('teksty')>=3){
    pay=Math.floor(pay*1.30); spListeners=Math.floor(spListeners*1.30);
  }
  // v1.8.97: Mikser 5 — mastering dla labelów (+15% wypłaty jeśli signed)
  if(typeof getRaperST==='function' && getRaperST('mikser')>=5 && G.label.type && G.label.type!=='indie'){
    pay=Math.floor(pay*1.15);
  }
  if(G.managementDeal) pay=Math.floor(pay*G.managementBonus);
  if(G.label.type==='major') pay=Math.floor(pay*.5);
  /* v1.9.29: BUG FIX — album payout przez earn() (Prestige moneyMult bypass) */
  if(typeof earn==='function') earn(pay,false); else {G.money+=pay;G.totalEarned=(G.totalEarned||0)+pay;}
  /* v1.9.31: Prestige fameMult dla album +20 fame */
  G.spotify.listeners+=spListeners;G.tidal.listeners+=Math.floor(spListeners*.3);
  G.followers+=Math.floor(spListeners*.5);
  /* v1.9.31: Prestige fameMult przez addFame() (album +20 to największy single fame source) */
  if(typeof addFame==='function') addFame(20); else G.fame=clamp(G.fame+20,0,500);
  G.albumsReleased=(G.albumsReleased||0)+1;addXP(100);
  checkAchievements();
  // CINEMATIC — pierwszy album debutancki (v1.9.46: guard flag, audyt album system — counter mógł crashować przy save state edycji)
  if(G.albumsReleased===1 && !G._debutAlbumShown && typeof showMilestoneCinematic==='function'){
    G._debutAlbumShown=true;
    showMilestoneCinematic({
      emoji:'💿',title:'DEBIUTANCKI ALBUM',subtitle:'Twój pierwszy krążek wydany',
      tagline:`+${pay.toLocaleString('pl')} zł · +${spListeners.toLocaleString('pl')} słuchaczy Spotify · +20 sławy`,
      accentColor:'#c8a520',accent2:'#9b59b6',duration:5000
    });
  } else {
    showMsg(`💿 ALBUM WYDANY! +${pay.toLocaleString('pl')} zł, +${spListeners.toLocaleString('pl')} słuchaczy Spotify, +20 sława!`);
  }
  addNotif(`💿 Album #${G.albumsReleased} wydany! +${pay.toLocaleString('pl')} zł`);
  renderSoundEngOverlay();
}
function doGhostwrite(){
  // Cooldown: 1 ghostwriting / dzień
  if(G._lastGhostDay===G.day){showMsg('✍️ Napisałeś już dziś tekst. Wróć jutro.','r');return;}
  if((G.energy||0)<25){showMsg('⚡ Za mało energii (25 — pisanie wymaga skupienia)','r');return;}
  // Wymóg: skill teksty 1+ lub realizacja 2+
  const txt=(getRaperST&&getRaperST('teksty')||0);
  const real=(getRaperST&&getRaperST('realizacja')||0);
  if(txt<1 && real<2){showMsg('📝 Wymaga: Teksty 1+ lub Realizacja 2+ w drzewku rapera','r');return;}
  G._lastGhostDay=G.day;G.energy=clampStat('energy', G.energy-25);
  let pay=Math.floor(rnd(100,500)*getKarieraBonus('soundeng'));if(G.managementDeal) pay=Math.floor(pay*G.managementBonus); // F3-FIX-B
  /* v2.1.98: Prestige moneyMult przez earn() (Wave 1 K29 ghostwriting bypass fix) */
  if(typeof earn==='function') earn(pay,false); else {G.money+=pay;G.totalEarned=(G.totalEarned||0)+pay;}
  G.careers.soundeng.ghostwrites++;addXP(35);
  document.getElementById('sound-res').textContent=`✍️ Ghostwriting gotowy! +${pay} zł (1× dziennie)`;renderSoundEngOverlay();
}

