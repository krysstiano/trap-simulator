  const _evalHand=(cards)=>{
    const vals=cards.map(c=>c%13).sort((a,b)=>a-b);
    const suits=cards.map(c=>Math.floor(c/13));
    const counts={};vals.forEach(v=>counts[v]=(counts[v]||0)+1);
