        {wx:2000, wy:1600, label:'MIASTO', zoom:1.0},
      ],
      durPerPlace:6000,
    },
  ];
  /* Spłaszczona lista shots — każdy item = jeden cel kamery */
  const SHOTS=[];
  TOPICS.forEach((topic, topicIdx)=>{
    topic.places.forEach((place, placeIdx)=>{
      SHOTS.push({
        topicIdx, placeIdx,
        em:topic.em,
        title:topic.title,
        desc:topic.desc,
        placeLabel: place.label,
        placeCount: topic.places.length,
        wx:place.wx, wy:place.wy,
        zoom:place.zoom||1.5,
        dur:topic.durPerPlace||3500,
        panSweep:!!topic.panSweep, /* v1.9.99: ciągły pan zamiast osobnych zoom-in */
        isLastInTopic: placeIdx === topic.places.length-1,
        isFirstInTopic: placeIdx === 0,
      });
    });
  });
  let shotIdx=0;
  let _hlAnimRaf=null;
  /* v2.1.21: manual control strzałkami — wyłącz auto-advance, gracz sam przechodzi po krokach. */
  let _autoAdvanceTimer=null;
  let _shotTransitioning=false;
  const _animateHighlight=(targetOpacity, dur)=>{
    if(_hlAnimRaf){cancelAnimationFrame(_hlAnimRaf);_hlAnimRaf=null;}
    const startO = window._cinemCam.hlOpacity||0;
    const t0 = Date.now();
    const step=()=>{
      const t = Math.min(1, (Date.now()-t0)/dur);
      const e = t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2;
      window._cinemCam.hlOpacity = startO + (targetOpacity - startO) * e;
      if(t<1) _hlAnimRaf = requestAnimationFrame(step);
      else _hlAnimRaf=null;
    };
    _hlAnimRaf = requestAnimationFrame(step);
  };
  /* v2.1.199: tracker zmiany topica — wcześniej `s.isFirstInTopic` było używane jako sygnał "nowy topic". ALE gdy gracz cofa się strzałką w lewo z pierwszego place nowego topica do ostatniego place poprzedniego topica, `isFirstInTopic=false` → overlay NIE updateował tytułu/opisu. User feedback: "przeszedłem na Zdrowie i Forma, cofnąłem ←, w okienku dalej Zdrowie i Forma". Fix: porównuj topicIdx z ostatnim renderowanym, NIE używaj isFirstInTopic. */
  let _lastRenderedTopicIdx = -1;
  const _showOverlay=(s)=>{
    let o=document.getElementById('cinem-overlay');
    const isNew=!o;
    const isTopicChange = s.topicIdx !== _lastRenderedTopicIdx;
    if(isNew){
      o=document.createElement('div');
      o.id='cinem-overlay';
      o.style.cssText='position:fixed;left:50%;bottom:60px;transform:translateX(-50%) translateY(40px) scale(.92);background:linear-gradient(135deg,rgba(10,10,30,.96),rgba(20,10,40,.96));border:2px solid #c8a520;border-radius:14px;padding:22px 36px;max-width:720px;text-align:center;z-index:9997;box-shadow:0 12px 48px rgba(0,0,0,.7),0 0 40px rgba(200,165,32,.5);opacity:0;transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1)';
      document.body.appendChild(o);
    } else if(isTopicChange){
      o.style.opacity='0';
      o.style.transform='translateX(-50%) translateY(20px) scale(.96)';
    }
    const renderHTML=()=>{
      o.innerHTML=`
        <div style="font-size:62px;margin-bottom:10px;animation:emojiFloat 2s ease-in-out infinite;text-shadow:0 0 30px rgba(200,165,32,.7)">${s.em}</div>
        <h2 style="color:#c8a520;font-size:26px;letter-spacing:3px;margin:0 0 8px;text-shadow:0 0 20px rgba(200,165,32,.6)">${s.title}</h2>
        <div id="cinem-place-label" style="color:#fff;font-size:14px;font-weight:700;margin-bottom:10px;letter-spacing:2px;background:rgba(200,165,32,.18);display:inline-block;padding:4px 14px;border-radius:14px;border:1px solid rgba(200,165,32,.4);transition:opacity .3s">📍 ${s.placeLabel} <span style="opacity:.6;font-weight:400">(${s.placeIdx+1}/${s.placeCount})</span></div>
        <div style="color:#e8e8f0;font-size:14px;line-height:1.65">${s.desc}</div>
        <div style="margin-top:12px;color:#778;font-size:11px;letter-spacing:1px">Topic ${s.topicIdx+1}/${TOPICS.length}</div>`;
    };
    if(isTopicChange){
      setTimeout(()=>{
        renderHTML();
        requestAnimationFrame(()=>{
          o.style.opacity='1';
          o.style.transform='translateX(-50%) translateY(0) scale(1)';
        });
      }, isNew ? 50 : 350);
    } else {
      const lbl=document.getElementById('cinem-place-label');
      if(lbl){
        lbl.style.opacity='0';
        setTimeout(()=>{
          lbl.innerHTML=`📍 ${s.placeLabel} <span style="opacity:.6;font-weight:400">(${s.placeIdx+1}/${s.placeCount})</span>`;
          lbl.style.opacity='1';
        }, 300);
      } else {
        renderHTML();
      }
    }
    _lastRenderedTopicIdx = s.topicIdx;
  };
  const _next=()=>{
    if(!G._cinematicActive) return;
    if(shotIdx>=SHOTS.length){window._closeCinematic();return;}
    const s=SHOTS[shotIdx];
    /* v1.9.99: PAN SWEEP topic = ciągły gładki ruch z lerpMul=0.6 i utrzymaniem zoom między places.
       Normal topic = leć szeroko (zoom 1.05) → zoom in (zoom z place) + highlight. */
    /* v2.1.9: target BEZ Math.max(0,...) — clamp robi updateCamera z zoom-aware bounds.
       Wcześniej Math.max(0, ...) odcinało ujemne target dla budynków blisko lewego/górnego brzegu mapy
       (TRAPHOUSE wx:170 wymaga cam.x=-470, STUDIO wy:210 wymaga cam.y=-119 etc.). */
    window._cinemCam.targetX=s.wx-640;
    window._cinemCam.targetY=s.wy-329;
    if(s.panSweep){
      /* PAN: utrzymaj zoom z first place przez cały topic, ciągły ruch BEZ przerw highlight */
      window._cinemCam.lerpMul = 0.6; /* WOLNIEJSZE = bardziej "filmowo" */
      window._cinemCam.targetZoom = s.zoom||1.25;
      /* Highlight tylko przy first place, potem ciągły bez podświetlenia (panoramic feel) */
      if(s.isFirstInTopic){
        _animateHighlight(0, 250);
        setTimeout(()=>{
          if(!G._cinematicActive) return;
          window._cinemCam.highlight={wx:s.wx, wy:s.wy, r:300}; /* duże highlight area */
          _animateHighlight(0.4, 800); /* delikatne podświetlenie, nie pełne */
        }, 900);
      } else {
        /* przesuwaj highlight razem z kamerą */
        window._cinemCam.highlight={wx:s.wx, wy:s.wy, r:300};
      }
    } else {
      /* v2.1.26: prawdziwy efekt PRZELOTU. Sekwencja:
         1. Zoom-OUT do 1.0 (kamera oddala się, gracz widzi miasto z lotu ptaka)
         2. Lerp camera do nowej pozycji (płynny "przelot" nad miastem)
         3. Po 1200ms: zoom-IN do s.zoom (kamera ląduje na celu) + highlight
         User: "Kamera powinna się oddalać, przelatywać na kolejne miejsce, dopiero wtedy zoomować". */
      window._cinemCam.lerpMul = 1;
      window._cinemCam.targetZoom = 1.0; /* ZOOM OUT — szeroki widok */
      _animateHighlight(0, 300);
      window._cinemCam.highlight=null;
      setTimeout(()=>{
        if(!G._cinematicActive) return;
        /* ZOOM IN po dotarciu kamery do celu */
        window._cinemCam.targetZoom = s.zoom||1.5;
        window._cinemCam.highlight={wx:s.wx, wy:s.wy, r:Math.max(110, 140 - (s.zoom-1)*60)};
        _animateHighlight(1, 800);
      }, 1200);
    }
    _showOverlay(s);
    /* v2.1.21: MANUAL CONTROL. Auto-advance USUNIĘTY — gracz steruje strzałkami ←/→.
       Wcześniej `setTimeout(_next, s.dur)` automatycznie przeskakiwał. */
    shotIdx++;
    _shotTransitioning=false;
  };
  /* v2.1.21: _prev() do cofania strzałką ← */
  const _prev=()=>{
    if(!G._cinematicActive) return;
    if(_shotTransitioning) return;
    if(shotIdx<=1) return; /* już na pierwszym shot */
    _shotTransitioning=true;
    shotIdx-=2; /* shotIdx-1 to obecny shot (już incrementowany), shotIdx-2 to poprzedni */
    if(shotIdx<0) shotIdx=0;
    _next();
  };
  /* v2.1.21: keyboard event handler dla cinematic */
  window._cinemKeyHandler=(e)=>{
    if(!G._cinematicActive) return;
    if(e.key==='ArrowRight' || e.key==='d' || e.key==='D'){
      e.preventDefault();
      if(!_shotTransitioning && shotIdx<SHOTS.length){_shotTransitioning=true; _next();}
    } else if(e.key==='ArrowLeft' || e.key==='a' || e.key==='A'){
      e.preventDefault();
      _prev();
    } else if(e.key==='Escape'){
      e.preventDefault();
      window._closeCinematic();
    }
  };
  window.addEventListener('keydown', window._cinemKeyHandler);
  window._closeCinematic=()=>{
    G._cinematicActive=false;
    G._cinematicCompleted=true;
    document.body.classList.remove('cinematic-active'); /* v1.9.99: przywróć HUD */
    if(_hlAnimRaf){cancelAnimationFrame(_hlAnimRaf);_hlAnimRaf=null;}
    /* v2.1.21: cleanup keyboard handler */
    if(window._cinemKeyHandler){
      window.removeEventListener('keydown', window._cinemKeyHandler);
      window._cinemKeyHandler=null;
    }
    if(window._cinemCam){window._cinemCam.active=false;window._cinemCam.highlight=null;window._cinemCam.hlOpacity=0;window._cinemCam.targetZoom=1;}
    const ov=document.getElementById('cinem-overlay');
    if(ov){ov.style.opacity='0';ov.style.transform='translateX(-50%) translateY(40px) scale(.9)';setTimeout(()=>ov.remove(),600);}
    const lt=document.getElementById('cinem-letterbox-top');const lb=document.getElementById('cinem-letterbox-bot');
    if(lt){lt.style.transition='opacity .8s,height .8s';lt.style.opacity='0';lt.style.height='0';setTimeout(()=>lt.remove(),800);}
    if(lb){lb.style.transition='opacity .8s,height .8s';lb.style.opacity='0';lb.style.height='0';setTimeout(()=>lb.remove(),800);}
    document.getElementById('cinem-skipbar')?.remove();
    if(typeof _paused!=='undefined') _paused=G._introPausedBefore===true;
    delete G._introPausedBefore;
    /* Wyśmietl kolejkę przegapionych toastów (jeśli kod chciał coś wysłać podczas cinematic) */
    if(window._cinemQueuedMsgs && window._cinemQueuedMsgs.length>0){
      const queued = window._cinemQueuedMsgs.slice(-3); /* max 3 ostatnie */
      window._cinemQueuedMsgs=[];
      queued.forEach((m,i)=>setTimeout(()=>showMsg(m.t,m.type,m.duration), 1100+i*4500));
    }
    if(typeof saveGameSilent==='function') saveGameSilent();
    if(typeof showMsg==='function') setTimeout(()=>showMsg('🎬 Przelot zakończony. Powodzenia w grze!','g',5000),900);
  };
  /* Letterbox bars (czarne paski u góry/dołu — efekt kinowy z slide-in).
     v2.1.21: 80→15vh + 60→12vh — żeby zakryć HUD na każdej skali (1080p HUD=93px, 4K=186px). */
  const lt=document.createElement('div');
  lt.id='cinem-letterbox-top';
  lt.style.cssText='position:fixed;top:-15vh;left:0;right:0;height:15vh;background:#000;z-index:9996;transition:top .9s cubic-bezier(.4,.0,.2,1)';
  const lb=document.createElement('div');
  lb.id='cinem-letterbox-bot';
  lb.style.cssText='position:fixed;bottom:-12vh;left:0;right:0;height:12vh;background:#000;z-index:9996;transition:bottom .9s cubic-bezier(.4,.0,.2,1)';
  document.body.appendChild(lt);document.body.appendChild(lb);
  requestAnimationFrame(()=>{lt.style.top='0';lb.style.bottom='0';});
  /* Skip button */
  const sk=document.createElement('div');
  sk.id='cinem-skipbar';
  sk.style.cssText='position:fixed;top:14px;right:24px;z-index:9998;opacity:0;transition:opacity .8s';
  sk.innerHTML=`
    <div style="display:flex;gap:8px;align-items:center">
      <button onclick="window._cinemPrev&&window._cinemPrev()" id="cinem-prev-btn" style="background:rgba(0,0,0,.85);color:#c8a520;border:1px solid #c8a520;padding:10px 14px;border-radius:8px;cursor:pointer;font-size:18px;font-weight:700;font-family:inherit" title="Poprzedni (←)">←</button>
      <div style="background:rgba(0,0,0,.6);color:#aac;padding:8px 12px;border-radius:6px;font-size:11px;letter-spacing:1px">Steruj strzałkami ← →</div>
      <button onclick="window._cinemNext&&window._cinemNext()" id="cinem-next-btn" style="background:rgba(0,0,0,.85);color:#c8a520;border:1px solid #c8a520;padding:10px 14px;border-radius:8px;cursor:pointer;font-size:18px;font-weight:700;font-family:inherit" title="Następny (→)">→</button>
      <button onclick="window._closeCinematic()" style="background:rgba(0,0,0,.85);color:#c8a520;border:1px solid #c8a520;padding:12px 20px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:700;letter-spacing:1px;font-family:inherit">Pomiń przelot ✕</button>
    </div>`;
  /* v2.1.21: expose _prev/_next dla klików buttonów */
  window._cinemPrev=()=>_prev();
  window._cinemNext=()=>{if(!_shotTransitioning && shotIdx<SHOTS.length){_shotTransitioning=true; _next();}};
  document.body.appendChild(sk);
  setTimeout(()=>{sk.style.opacity='1';},400);
  setTimeout(_next,900); /* delay 900ms na letterbox slide-in */
};

