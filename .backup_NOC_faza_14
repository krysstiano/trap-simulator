    _drawBoard();
  };
  const _drawBoard=()=>{
    const c=document.getElementById('plinko-canvas');if(!c) return;
    const X=c.getContext('2d');
    X.fillStyle='#0a0f1a';X.fillRect(0,0,500,380);
    // Pegs
    for(let row=0;row<ROWS;row++){
      const pegs=row+3;
      const startX=250-(pegs-1)*16;
      const y=30+row*25;
      for(let p=0;p<pegs;p++){
        X.fillStyle='#c8a520';
        X.beginPath();X.arc(startX+p*32,y,3,0,Math.PI*2);X.fill();
      }
    }
    // Slot boxes
    for(let s=0;s<SLOTS.length;s++){
      const sx=10+s*54;
      X.fillStyle=SLOT_COLORS[s];
      X.fillRect(sx,335,52,40);
      X.fillStyle='#fff';X.font='bold 14px sans-serif';X.textAlign='center';
      X.fillText(SLOTS[s]+'×',sx+26,360);
    }
  };
  window._plinkoOnBet=()=>{
    const el=document.getElementById('plinko-bet');
    if(el){const v=parseInt(el.value);if(!isNaN(v))bet=v;}
    /* v2.0.22: BEZ _render() — powoduje że focus jest tracony między keystrokes i kolejne cyfry nie rejestrują się.
       Banner pokazuje się dopiero przy próbie drop (jeśli bet > max). Cooldown / cena widoczne na buttonie. */
  };
  /* v1.9.95: SPAM MODE — multiple balls naraz. activeBalls = array, każda kulka osobna animacja na requestAnimationFrame (smooth 60fps). */
  const activeBalls=[];
  window._plinkoDrop=()=>{
    if(G.casinoChips<bet||bet<10) return;
    if(bet>5000){lastResult='⚠️ Maksymalna stawka 5000 żetonów';_render();return;}
    G.casinoChips-=bet;
    /* v2.0.25: drop sound + bouncing pegs */
    if(typeof sfxPlinkoDrop==='function') sfxPlinkoDrop();
    let pos=0;
    const path=[];
    for(let i=0;i<ROWS;i++){
      const left=Math.random()<0.5;
      pos+=left?-1:1;
      path.push({left,pos});
    }
    const slotIdx=Math.max(0,Math.min(SLOTS.length-1,Math.floor((pos+ROWS)/(2*ROWS/SLOTS.length))));
    const multiplier=SLOTS[slotIdx];
    const win=Math.floor(bet*multiplier);
    /* Kulka: ball z pozycją, ścieżką, t (czas startu), bet, win, slotIdx */
    activeBalls.push({
      x:250, y:20, vx:0, vy:0, path, t0:performance.now(),
      bet, win, slotIdx, multiplier, finalized:false,
      colorHue:Math.floor(Math.random()*360)
    });
    if(!ballAnim) _startAnimLoop();
    _renderHUD();
  };
  const _startAnimLoop=()=>{
    if(ballAnim) return;
    const tick=()=>{
      const c=document.getElementById('plinko-canvas');
      if(!c){activeBalls.length=0;ballAnim=null;return;}
      const X2=c.getContext('2d');
      _drawBoard();
      const now=performance.now();
      for(let i=activeBalls.length-1;i>=0;i--){
        const b=activeBalls[i];
        const elapsed=(now-b.t0)/1000; /* seconds */
        const DUR_PER_ROW=0.18; /* czas między rzędami — smooth */
        const stepF=Math.min(ROWS, elapsed/DUR_PER_ROW);
        const step=Math.floor(stepF);
        const frac=stepF-step;
        let targetX, targetY;
        if(step>=ROWS){
          /* v2.0.2: BUG FIX — slotMid był liczony błędnie (formuła dawała 210 dla slot 0 ale faktyczny X=36).
             Faktyczne X slotów (z _drawBoard): sx=10+s*54, centrum=sx+26 = 36+s*54.
             Kulka po peg jest na (250+lastPos*16), slot na 36+slotIdx*54 — interpolacja smoothem. */
          const lastPos=b.path[ROWS-1].pos;
          const pegEndX = 250 + lastPos*16; /* gdzie kulka kończy peg-fazę */
          const slotMid = 36 + b.slotIdx*54; /* faktyczne centrum slotu */
          const afterRows=(elapsed - ROWS*DUR_PER_ROW)/0.4; /* 0.4s spadania do slotu */
          /* ease-in dla X (subtelny, bo dystans nie powinien być duży gdy mapping jest dobry) */
          const eX = afterRows*afterRows; /* quadratic ease-in */
          targetX = pegEndX + (slotMid-pegEndX)*Math.min(1,eX);
          targetY = 30+ROWS*25 + Math.min(40, afterRows*40);
          if(afterRows>=1 && !b.finalized){
            b.finalized=true;
            _finalize(b);
          }
          if(afterRows>=1.4){
            activeBalls.splice(i,1);
            continue;
          }
        } else {
          const curPos = step===0 ? 0 : b.path[step-1].pos;
          const nextPos = b.path[step].pos;
          targetX = 250 + (curPos + (nextPos-curPos)*frac)*16;
          targetY = 30 + step*25 + frac*25;
        }
        b.x = targetX; b.y = targetY;
        /* Trail (motion blur) */
        X2.fillStyle=`hsla(${b.colorHue},80%,55%,.25)`;
        X2.beginPath();X2.arc(b.x,b.y-4,8,0,Math.PI*2);X2.fill();
        /* Main ball */
        const g=X2.createRadialGradient(b.x-2,b.y-2,1,b.x,b.y,6.5);
        g.addColorStop(0,'#fff');g.addColorStop(0.6,`hsl(${b.colorHue},90%,65%)`);g.addColorStop(1,`hsl(${b.colorHue},80%,40%)`);
        X2.fillStyle=g;X2.beginPath();X2.arc(b.x,b.y,6.5,0,Math.PI*2);X2.fill();
        X2.strokeStyle=`hsla(${b.colorHue},90%,30%,.8)`;X2.lineWidth=1;X2.stroke();
      }
      if(activeBalls.length>0){
        ballAnim = requestAnimationFrame(tick);
      } else {
        ballAnim=null;
      }
    };
    ballAnim = requestAnimationFrame(tick);
  };
  const _finalize=(b)=>{
    G.casinoChips+=b.win;
    G.casinoStats=G.casinoStats||{};
    G.casinoStats.plinkoPlayed=(G.casinoStats.plinkoPlayed||0)+1;
