  if(existing){
    gameConfirm(`Slot ${item.slot} ma już save (Dzień ${(()=>{try{return JSON.parse(existing).G?.day||'?'}catch{return '?'}})()}). Nadpisać go przywracając z kosza?\n\n💡 Aktualny save trafi do kosza.`, ()=>{
