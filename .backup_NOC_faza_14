// Sala Koncertowa
function renderSalaKoncertowa(){
  const scena=getRaperST('scena');
  /* v2.1.37 [Amper]: koncerty wymagają fanów lojalnych (G.fans), nie obserwujących */
  const totalFans=(G.fans||0);
  // v1.8.18: Mała Scena fansReq 100→30 (pierwsze doświadczenie powinno być dostępne wcześnie),
  // Klub 500→300, Arena 2000→1500 (nadal gated, ale spójne z nową niższą derivacją fanów z followersów).
  /* v2.1.50 Amper: NERF zarobków koncertowych ~55%. Wcześniej Arena 5-15k przy 4000 słuchaczy dawała 13k+ z mnożnikami — niespójne z rozwojem gracza. Nowe ranges + standardowe mnożniki (fame/follower/scena/drip/friendship) skalują rozsądnie. */
  const venues=[
    {name:'Mała Scena',cost:500,fameReq:10,scenaReq:1,fansReq:30,earnMin:200,earnMax:700,desc:'Max 200 osób. Pierwsze doświadczenie.'},
    {name:'Klub Muzyczny',cost:1500,fameReq:25,scenaReq:2,fansReq:300,earnMin:700,earnMax:2200,desc:'Do 1000 osób. Prawdziwa impreza.'},
    {name:'Arena',cost:5000,fameReq:55,scenaReq:4,fansReq:1500,earnMin:2500,earnMax:7000,desc:'Tysiące fanów. Legendarny koncert.'},
    /* v2.1.232: 3 nowe endgame venues. Wymagają Scena 6/7/8 + odpowiedniego fame/fans (skala 0-500 fame). Conservative base earn — soft compression + nerf mnożników utrzymują payout w rozsądnych granicach. */
    {name:'Coachella',cost:15000,fameReq:200,scenaReq:6,fansReq:250000,earnMin:4000,earnMax:9000,desc:'Festival 3 dni. Set headlinera na pustyni Kalifornii.',festival:3},
    {name:'Wembley',cost:50000,fameReq:350,scenaReq:7,fansReq:750000,earnMin:7000,earnMax:15000,desc:'Stadion 100 000 osób w Londynie. +1500 lojalnych fanów po koncercie.',stadiumFans:1500},
    {name:'Megastar',cost:200000,fameReq:450,scenaReq:8,fansReq:2000000,prestigeReq:1,earnMin:10000,earnMax:22000,desc:'World tour 7 miast: Warszawa → Berlin → Londyn → NYC → Tokio → São Paulo → Sydney.',tour:7},
  ];
  /* v2.1.90 Amper: licznik koncertów dziś + payout info (1:100% / 2:50% / 3:75% / 4+:BLOKADA). */
  const _todayConc = (G._concertsCounter && G._concertsCounter.day === G.day) ? G._concertsCounter.count : 0;
  const _todayPayout = _todayConc===0?'100%':_todayConc===1?'50%':_todayConc===2?'75%':'BLOKADA';
  const _todayColor = _todayConc===0?'#27ae60':_todayConc<3?'#f39c12':'#e74c3c';
  /* v2.1.112: S3/S4 — pokazuj aktywne bonusy holiday/festival/outfit żeby gracz wiedział co stackuje przed koncertem. */
  const _bonusChips=[];
  if(G.activeHoliday){
    const _h=G.activeHoliday;
    if(_h.id==='sylwester') _bonusChips.push('🎆 Sylwester: koncerty ×2.0 + 100 fanów');
    else if(_h.id==='majowka') _bonusChips.push('🌷 Majówka: koncerty ×1.5');
  }
  if(G.activeFestival && G.activeFestival.effect){
    if(G.activeFestival.effect.concertFameMult) _bonusChips.push(`🎵 ${G.activeFestival.name||'Festiwal'}: sława koncertu ×${G.activeFestival.effect.concertFameMult}`);
  }
  const _outfitMap={music:'+5%',designer_concert:'+15%',smoking:'+10%',suit:'+5%',sport:'+3%',sport_pro:'+5%',luxury:'+12%',zimowa:'+2%',jeansowa:'+4%',tracksuit:'+2%',leather_jacket:'+6%',designer_hoodie:'+8%',crown_of_hh:'+20%'}; /* v2.1.148 hotfix: 3 nowe outfity concert mult tooltip · v2.1.217: Crown of Hip-Hop +20% (Tier 4 GOAT) */
  const _outfit=G.outfit?.top;
  if(_outfit && _outfitMap[_outfit]) _bonusChips.push(`👕 Outfit ${_outfit}: ${_outfitMap[_outfit]} zarobków`);
  /* v2.1.229: scena earn mult nerf (1.25→1.15 max). Scena 6/7/8 daje INNE bonusy (fame/fanów/follower) — osobne chipy. */
  if(scena>=2) _bonusChips.push(`🎭 Scena ${scena}/8: koncerty ${[null,null,'×1.05','×1.10','×1.15','×1.15','×1.15','×1.15','×1.15'][scena]||'×1.15'}`);
  /* v2.1.231: chipy dla Scena 6/7/8 — pokazują dodatkowe perki (fame/follower/fanów). */
  if(scena>=6) _bonusChips.push('🎤 Festival Headliner (Scena 6): +1 sławy/koncert');
  if(scena>=7) _bonusChips.push('🏟️ Stadium Star (Scena 7): +5% bonusu obserwujących');
  if(scena>=8) _bonusChips.push('🌍 World Megastar (Scena 8): +200 fanów/koncert');
  if(G.managementDeal) _bonusChips.push('💼 Management Kamila: ×1.2 zarobków');
  if(G._repBoost75) _bonusChips.push('👑 Rep75: +15% fanów koncertu');
  /* v2.1.207 [Amper]: ROZBUDOWANE chipy — brakowały: drip, friendship Marcin, prestige, mood, mogul, tour magnate, streak, diamond hands. */
  /* v2.1.210 [Amper]: drip + PU połączone w jeden czytelny chip — gracz widzi "Drip 200/200 + PU" zamiast "drip ×1.5 effective 300". Liczba dripu ZAWSZE max 200. */
  const _dripBase=(G.drip||0);
  const _hasPU=(typeof getRaperST==='function' && getRaperST('autopromocja')>=4);
  const _dripCapPct=_hasPU?30:20;
  const _dripBonus=Math.min(_dripCapPct,Math.floor((typeof getEffectiveDrip==='function'?getEffectiveDrip():_dripBase)*0.1));
  if(_dripBase>0){
    const _puLabel=_hasPU?' + Ulepszenie "Personal brand"':'';
    _bonusChips.push(`💎 Drip ${_dripBase}/200${_puLabel}: +${_dripBonus}% zarobków + fanów (maks. +${_dripCapPct}%)`);
  }
  const _marcinF=(typeof getFriendshipBonus==='function')?getFriendshipBonus('marcin'):1;
  if(_marcinF>1.05) _bonusChips.push(`🎤 Marcin friendship: ×${Math.min(1.5,_marcinF).toFixed(2)} zarobków`);
  const _moneyMult=G.prestigeBonus?.moneyMult||1;
  if(_moneyMult>1.0) _bonusChips.push(`⭐ Prestige money: ×${_moneyMult.toFixed(2)} (rank ${G.prestige||0})`);
  if(typeof getRaperST==='function' && getRaperST('biznes')>=5) _bonusChips.push('💼 Mogul (Biznes 5): ×1.3 zarobków');
  const _tourMag=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('tour_magnate'):1;
  if(_tourMag>1.0) _bonusChips.push(`🌍 Tour Magnate: ×${_tourMag.toFixed(2)} zarobków`);
  const _diamond=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('diamond_hands'):1;
  if(_diamond>1.0) _bonusChips.push(`💎 Diamond Hands: ×${_diamond.toFixed(2)} zarobków`);
  const _streak=(typeof streakBonusMult==='function')?streakBonusMult():1;
  if(_streak>1.0) _bonusChips.push(`🔥 Login streak: ×${_streak.toFixed(2)} zarobków`);
  const _moodMult=(G.stress||0)>=80?1.10:((G.stress||0)<20?0.95:1);
  if(_moodMult>1.0) _bonusChips.push(`😄 Nastrój wysoki (≥80): ×1.10 zarobków`);
  else if(_moodMult<1.0) _bonusChips.push(`😞 Niski nastrój (<20): ×0.95 zarobków (debuff)`);
  const _bonusHtml=_bonusChips.length>0?
    `<div style="background:#0a1f10;border:1px solid #27ae60;border-radius:8px;padding:10px 14px;margin-bottom:14px;font-size:12px;color:#7ec87e;line-height:1.6">
      ✨ <b>AKTYWNE BONUSY KONCERTU:</b><br>${_bonusChips.map(c=>`<span style="display:inline-block;background:#0a3a1a;border:1px solid #1a5a2a;padding:3px 8px;border-radius:4px;margin:2px 4px 2px 0;font-size:11px">${c}</span>`).join('')}
    </div>`:'';
  /* v2.1.204 [Amper]: estimateConcertEarn — pokazuje gracza realistic finalny zarobek z aktualnymi mnożnikami.
     User feedback: UI mówi "2500-7000 zł" Arena, ale faktyczny payout 50689 zł. Dodajemy estymację. */
  function _estimateConcertEarn(earnMin, earnMax){
    /* v2.1.229: UI estimate zsynchronizowany z faktyczną formułą koncertu (L24224+). Wszystkie mults nerfowane + fame sqrt + soft compression. */
    const fame_mult = Math.max(0.3, Math.min(2.0, Math.sqrt((G.fame||0)/100)));
    const follower_mult = Math.min(1.5, Math.max(0.5, (G.followers||0)/10000));
    const venue_mult = earnMax>=15000?1.10:earnMax>=3000?1.05:1.0;
    // Outfit (v2.1.229 nerfs: designer_concert 1.15→1.10, luxury 1.12→1.08, crown_of_hh 1.20→1.10)
    const outMap = {music:1.05, designer_concert:1.10, smoking:1.10, suit:1.05, sport:1.03, sport_pro:1.05, luxury:1.08, zimowa:1.02, jeansowa:1.04, tracksuit:1.02, leather_jacket:1.06, designer_hoodie:1.08, crown_of_hh:1.10};
    const outfitMult = outMap[G.outfit?.top] || 1.0;
    // Scena (v2.1.229 nerf 1.25→1.15)
    const scenaMult = scena>=4?1.15:scena>=3?1.10:scena>=2?1.05:1.0;
    const scenaEnergyMult = (typeof getScenaEnergyBonus==='function')?getScenaEnergyBonus():1.0;
    // Drip (v2.1.229 nerf cap 30%→20%)
    const dripV = (typeof getEffectiveDrip==='function')?getEffectiveDrip():(G.drip||0);
    const dripMult = 1 + Math.min(0.20, dripV*0.001);
    // Management
    const mgmtMult = G.managementDeal ? Math.min(1.2, G.managementBonus||1) : 1.0;
    // Holiday (v2.1.229 nerf Sylwester 2.0→1.3, Majówka 1.5→1.2)
    let holMult = 1.0;
    if(G.activeHoliday){
      if(G.activeHoliday.id==='sylwester') holMult = 1.3;
      else if(G.activeHoliday.id==='majowka') holMult = 1.2;
    }
    // Marcin friendship (v2.1.229 nerf cap 1.5→1.20)
    const marcinMult = (typeof getFriendshipBonus==='function')?Math.min(1.20, getFriendshipBonus('marcin')):1.0;
    // Prestige money mult (v2.1.229 nerf rank×0.05→×0.02 cap 1.20)
    const prestigeMult = G.prestigeBonus?.moneyMult || 1.0;
    // Mogul (v2.1.229 nerf 1.3→1.15)
    const mogulMult = (typeof getRaperST==='function' && getRaperST('biznes')>=5)?1.15:1.0;
    // Tour Magnate prestige skill (v2.1.229 nerf 1.15→1.10)
    const tourMagMult = (typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('tour_magnate'):1.0;
    // Mood (v2.1.229 nerf 1.10→1.05)
    const moodMult = (G.stress||0)>=80?1.05:((G.stress||0)<20?0.95:1.0);
    // Tier 4 GOAT (v2.1.229 nerf 1.20→1.10)
    const tier4Mult = (typeof getFameTier==='function' && getFameTier()===4)?1.10:1.0;
    // perfMult — assume good play (accuracy 80%, maxCombo 25, hype 80)
    const perfMultLow  = 0.6 * (1+10*0.002) * 1.05;
    const perfMultHigh = 0.95* (1+50*0.002) * 1.20;
    const baseMult = fame_mult * follower_mult * venue_mult * outfitMult * scenaMult * scenaEnergyMult * dripMult * mgmtMult * holMult * marcinMult * prestigeMult * mogulMult * tourMagMult * moodMult * tier4Mult;
    /* v2.1.233: HYPERBOLIC soft compression (start 80k, asymptota 260k). UI estimate spójne z endConcert L24313. Brak nagłego progu — gracz NIE widzi "ścianki", krzywa gładka. */
    function _softCompress(e){
      if(e<=80000) return e;
      const _excess=e-80000;
      return 80000+Math.floor(_excess/(1+_excess/180000));
    }
    const estLow  = _softCompress(Math.floor(earnMin * baseMult * perfMultLow));
    const estHigh = _softCompress(Math.floor(earnMax * baseMult * perfMultHigh));
    return {low:estLow, high:estHigh};
  }
  document.getElementById('ov-content').innerHTML=`
    <h2>🎤 Sala Koncertowa</h2>
    <p class="sub">Wynajmij scenę i zagraj koncert. Im większa sława i więcej fanów, tym większy zarobek!</p>
    <p style="color:#667;font-size:14px;margin-bottom:8px">Sława: <strong style="color:#9b59b6">${Math.floor(G.fame||0)}/500</strong> · Scena: ${scena}/8 · Fani: ${totalFans} · Koncerty: ${G.events.performed}</p>
    ${_bonusHtml}
    <div style="background:#0a1220;border:1px solid #2a3a4a;border-radius:8px;padding:10px 14px;margin-bottom:14px;font-size:13px;color:#cdd;line-height:1.6">
      🎤 <b style="color:${_todayColor}">Koncerty dziś: ${_todayConc}/3</b> — następny payout: <b style="color:${_todayColor}">${_todayPayout}</b>
      <div style="font-size:11px;color:#8aa;margin-top:4px">Limit: <b>3 koncerty/dzień</b>. Pierwszy 100%, drugi 50%, trzeci 75% (publiczność wraca). Po 3 — czekaj do jutra.</div>
    </div>
    ${scena<1?`<div style="background:#1a0a0a;border:1px solid #5a1a1a;border-radius:8px;padding:12px;margin-bottom:14px;font-size:13px;color:#e74c3c">🔒 Odblokuj <strong>Scena 1</strong> w drzewku umiejętności rapera żeby grać koncerty!</div>`:''}
    <div class="shopgrid">
      ${(window._venues=venues).map(v=>{
        /* v2.1.232: prestigeReq check (Megastar wymaga prestige≥1). Plus festival/tour badges w opisie. */
        const _prestigeOk = !v.prestigeReq || (G.prestige||0)>=v.prestigeReq;
        const blocked=G.fame<v.fameReq||G.money<v.cost||scena<v.scenaReq||totalFans<v.fansReq||!_prestigeOk;
        const lockReason = !_prestigeOk?`Prestige ${v.prestigeReq}+ wymagane`:scena<v.scenaReq?`Scena ${v.scenaReq} wymagane`:totalFans<v.fansReq?`${v.fansReq.toLocaleString('pl')} fanów wymagane`:G.fame<v.fameReq?`Sława ${v.fameReq}+ wymagane`:'';
        /* v2.1.204 [Amper]: pokaż gracza estymacja finalnego zarobku z aktywnymi mnożnikami. */
        const _est=_estimateConcertEarn(v.earnMin, v.earnMax);
        const _badge = v.festival?`<span style="background:#1a3a1a;color:#27ae60;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700">🎪 FESTIVAL ${v.festival}d</span>`:v.tour?`<span style="background:#3a1a1a;color:#e74c3c;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700">🌍 WORLD TOUR ${v.tour}d</span>`:v.stadiumFans?`<span style="background:#1a1a3a;color:#7ec8e3;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700">🏟️ STADION +${v.stadiumFans} fanów</span>`:'';
        return`<div class="sitem" style="width:200px">
          <h3>🎵 ${v.name} ${_badge}</h3>
          <p>${v.desc}</p>
          <p style="color:#667;font-size:11px">Sława: ${v.fameReq} · Scena: ${v.scenaReq} · Fani: ${v.fansReq.toLocaleString('pl')}${v.prestigeReq?' · Prestige '+v.prestigeReq+'+':''}</p>
          <div class="pr">Wynajem: ${v.cost.toLocaleString('pl')} zł</div>
          <div style="color:#888;font-size:10px;margin-bottom:2px">Baza${v.festival||v.tour?'/dzień':''}: ${v.earnMin.toLocaleString('pl')}–${v.earnMax.toLocaleString('pl')} zł</div>
          <div style="color:#27ae60;font-size:12px;font-weight:700;margin-bottom:2px">💰 Twój szacunek${v.festival||v.tour?'/dzień':''}: ${_est.low.toLocaleString('pl')}–${_est.high.toLocaleString('pl')} zł</div>
          <div style="color:#778;font-size:9px;margin-bottom:8px">Niski: słaba gra (60% acc, mały combo) · Wysoki: perfect (100% acc, combo 50+, hype 100)</div>
          ${lockReason?`<div style="color:#e74c3c;font-size:11px;margin-bottom:6px">🔒 ${lockReason}</div>`:''}
          <button class="bbtn" onclick="performConcert('${v.name}',${v.cost},${v.fameReq},${v.earnMin},${v.earnMax})" ${blocked?'disabled':''}>Zarezerwuj</button>
        </div>`;
      }).join('')}
    </div>
    <div class="res" id="shop-res">Wybierz event.</div>
    <button class="cbtn" onclick="closeOverlay()">← Wróć</button>
  `;
}

// Biuro Nieruchomości
function renderBiuroNieruchomosci(){
  /* v2.1.51 Amper: ceny mieszkań podniesione ~3-4× — wcześniej za 60k zł gracz miał już penthouse co kompletnie nie pasowało do dochodów z koncertów po znerfowaniu. */
  /* v2.1.172: Traphouse usunięty z listy — jest startowym/bazowym domem, nie wymaga zakupu. */
  const apts=[
    {id:'basic',name:'Mieszkanie Podstawowe',cost:15000,desc:'Czyste, spokojne. Lepszy odpoczynek.',bonusText:'+5% regeneracja energii',req:{level:2}},
    {id:'premium',name:'Apartament Premium',cost:60000,desc:'Przestronne, stylowe. Kuchnia z wyspą, regał z trofeami.',bonusText:'+15% regeneracja energii, +3 nastrój/doba (komfort)',req:{level:4,fans:2000}},
    {id:'luxury',name:'Penthouse Luksusowy',cost:250000,desc:'Najlepsze w mieście. Basen, sauna, jacuzzi, ognisko, panorama.',bonusText:'+25% regeneracja energii, +6 nastrój/doba, +15 sława, wszystkie luksusowe udogodnienia',req:{level:7,fans:10000,fame:50}},
    /* v2.1.171: Mansion — najwyższy tier 5, w prestiżowej dzielnicy obok Biura Nieruchomości */
    {id:'mansion',name:'Rezydencja',cost:1500000,desc:'Luksusowa rezydencja w prestiżowej dzielnicy miasta. Marmurowa fasada, kolumny jońskie, balkon, prywatne studio.',bonusText:'+40% regen energii, +10 nastrój/doba, +30 sława przy zakupie, prywatne studio (nagrania w pełnej jakości, bez utraty)',req:{level:15,fans:100000,fame:90}},
    /* v2.1.215 [Amper]: Mega Villa — Tier 3 Legendary apartament. Wymaga posiadania Penthouse i Mansion. */
    {id:'mega_villa',name:'Mega Villa',cost:3000000,desc:'Absolutny szczyt luksusu — mega villa z basenem, palmami, prywatnym studio, helipadem. Lokalizacja: odosobniona luksusowa dzielnica południowo-wschodnia (poza centrum miasta). Status absolutnie elitarny.',bonusText:'+50% regen energii, +20 nastrój/doba, +30 sławy przy zakupie, +2 sławy/dzień gry pasywnie (recognized brand)',req:{level:18,fans:300000,fame:250,mustOwnMansion:true,mustOwnPenthouse:true}},
  ];
  function reqMet(req){
    if(req.level && G.level<req.level) return false;
    if(req.fans && (G.fans||0)<req.fans) return false;
    if(req.fame && (G.fame||0)<req.fame) return false;
    /* v2.1.215 [Amper]: Mega Villa wymaga POSIADANIA Penthouse i Mansion (nie tylko zamieszkania) */
    if(req.mustOwnMansion && !(G.apartment==='mansion' || (G._ownedApts||[]).includes('mansion'))) return false;
    if(req.mustOwnPenthouse && !(G.apartment==='luxury' || (G._ownedApts||[]).includes('luxury'))) return false;
    return true;
  }
  function reqText(req){
    const parts=[];
    if(req.level) parts.push(`lvl ${req.level}${G.level<req.level?' ❌':' ✅'}`);
    if(req.fans) parts.push(`${req.fans.toLocaleString('pl')} fanów${(G.fans||0)<req.fans?' ❌':' ✅'}`);
    if(req.fame) parts.push(`${req.fame} sławy${(G.fame||0)<req.fame?' ❌':' ✅'}`);
    /* v2.1.215 [Amper]: Mega Villa wymogi posiadania */
    if(req.mustOwnPenthouse){const _own=G.apartment==='luxury'||(G._ownedApts||[]).includes('luxury');parts.push(`Penthouse posiadany${_own?' ✅':' ❌'}`);}
    if(req.mustOwnMansion){const _own=G.apartment==='mansion'||(G._ownedApts||[]).includes('mansion');parts.push(`Rezydencja posiadana${_own?' ✅':' ❌'}`);}
    return parts.length?parts.join(' · '):'';
  }
  // #71 U Wynajem mieszkań — pokaż posiadane (niemieszkalne) mieszkania z opcją wynajęcia
  if(!G.rentals) G.rentals={};
  const _rentRates={traphouse:25,basic:80,premium:200,luxury:500,mansion:1500,mega_villa:3500}; // v2.1.172: mansion · v2.1.215: Mega Villa 3500 zł/dzień (najwyższy tier rentu)
  const _rentableNames={traphouse:'Traphouse',basic:'Mieszkanie Podstawowe',premium:'Apartament Premium',luxury:'Penthouse Luksusowy',mansion:'Rezydencja',mega_villa:'Mega Villa'};
  const ownedExtras=(G._ownedApts||[]).filter(id=>id!==G.apartment);
  let rentalsHtml='';
  if(ownedExtras.length>0){
    rentalsHtml=`
      <h3 style="color:#f1c40f;margin-top:20px;margin-bottom:8px">💰 Wynajem posiadanych mieszkań</h3>
      <p style="color:#888;font-size:12px;margin-bottom:10px">Mieszkania w które już się wprowadziłeś (a teraz mieszkasz gdzie indziej) możesz wynająć — przynoszą pasywny dochód co dobę.</p>
      <div class="shopgrid">
        ${ownedExtras.map(id=>{
          const rented=G.rentals[id]===true;
          const rate=_rentRates[id]||50;
          const notice=G._rentalNotice?.[id];
          const noticeTxt = notice ? `<p style="color:#f39c12;font-size:11px;margin:4px 0">📝 Wypowiedzenie: koniec Dnia ${notice}</p>` : '';
          const buttonTxt = rented ? (notice ? '❌ Cofnij wypowiedzenie' : '📝 Wypowiedz (7 dni)') : '🔑 Wynajmij';
          return `<div class="sitem" style="width:200px;border-color:${rented?(notice?'#f39c12':'#27ae60'):'#5a4020'}">
            <h3>${_rentableNames[id]||id}</h3>
            <p style="color:#aaa;font-size:12px">Dochód: <strong style="color:#f1c40f">${rate} zł/doba</strong></p>
            <p style="color:${rented?'#27ae60':'#888'};font-size:12px;margin:6px 0">${rented?'✅ Aktualnie wynajęte':'⛔ Nie wynajęte'}</p>
            ${noticeTxt}
            <button class="bbtn" onclick="window.toggleRental('${id}')">${buttonTxt}</button>
          </div>`;
        }).join('')}
      </div>
    `;
  }
  // F+ 2026-05-12 #73: sekcja rachunków ZSYNCHRONIZOWANA z G.bills (jeden system zamiast 2)
  if(!G.bills) G.bills={pending:[],history:[],evicted:false};
  const _pendingBills=(G.bills.pending||[]).filter(b=>!b.paid);
  const _billsTotal=_pendingBills.reduce((s,b)=>s+b.amount,0);
  const _maxOverdue=Math.max(0,..._pendingBills.map(b=>Math.max(0,(G.day||1)-(b.dueDay||0))));
  const _billsColor = _billsTotal>0 ? (G.bills.evicted?'#e74c3c':_maxOverdue>=3?'#f39c12':'#7ec8e3') : '#27ae60';
  const _eksmisjaWarning = G.bills.evicted ? '<div style="color:#e74c3c;font-weight:bold;margin-top:4px">🚨 EKSMISJA AKTYWNA — spłać aby wrócić</div>' : _maxOverdue>=4 ? '<div style="color:#e74c3c;font-weight:bold;margin-top:4px">⚠️ EKSMISJA JUTRO!</div>' : _maxOverdue>=3 ? '<div style="color:#f39c12;margin-top:4px">⚠️ Eksmisja za 2 dni</div>' : '';
  const _billsHtml=`
    <div style="background:#0a0a14;border:2px solid ${_billsColor};border-radius:8px;padding:14px;margin-bottom:14px">
      <h3 style="color:${_billsColor};margin:0 0 8px 0">📧 Rachunki za mieszkanie</h3>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="color:#aaa;font-size:12px">Do zapłaty (${_pendingBills.length} rachunków):</div>
          <div style="color:${_billsColor};font-size:22px;font-weight:bold">${_billsTotal.toLocaleString('pl')} zł</div>
          ${_maxOverdue>0?`<div style="color:#888;font-size:11px">Max zaległych dni: ${_maxOverdue}</div>`:''}
          ${_eksmisjaWarning}
          <div style="color:#778;font-size:10px;margin-top:6px">Pełny menedżer rachunków: Telefon → 💸 Rachunki</div>
        </div>
        <button onclick="window.payAllBills();renderBiuroNieruchomosci()" ${_billsTotal<=0||G.money<_billsTotal?'disabled':''} style="background:${_billsTotal>0&&G.money>=_billsTotal?'#27ae60':'#2a2a2a'};color:#fff;border:none;padding:14px 24px;font-size:15px;font-weight:bold;cursor:pointer;border-radius:6px;font-family:inherit">💰 Zapłać wszystkie</button>
      </div>
    </div>`;
  document.getElementById('ov-content').innerHTML=`
    <h2>🏠 Biuro Nieruchomości</h2>
    <p class="sub">Kupuj mieszkania — automatycznie zamieszkujesz w najlepszym posiadanym. Większe apartamenty wymagają wyższego statusu.</p>
    <p style="color:#667;font-size:14px;margin-bottom:12px">Aktualnie mieszkasz w: <strong style="color:#7ec8e3">${CFG.APT_NAMES[G.apartment]||G.apartment}</strong></p>
    ${_billsHtml}
    <div class="shopgrid">
      ${apts.map(a=>{
        const reqOk=reqMet(a.req);
        const reqStr=reqText(a.req);
        const ownedBefore=(G._ownedApts||[]).includes(a.id);
        const moneyOk=G.money>=a.cost;
        /* v2.1.172: Posiadane mieszkania zawsze 'Posiadane' (no Przeprowadź się). Auto-best logic obsługuje aktywację. */
        const disabled=ownedBefore||!reqOk||!moneyOk;
        const priceLabel=ownedBefore?'<span style="color:#7ec87e">✅ Posiadane</span>':a.cost.toLocaleString('pl')+' zł';
        const btnLabel=ownedBefore?'✅ Posiadane':!reqOk?'Brak wymogów':!moneyOk?'Brak kasy':'🔑 Kup';
        const activeMark=(G.apartment===a.id)?'<div class="owned" style="color:#27ae60;font-size:11px;margin-top:4px">🏠 Twoje aktualne mieszkanie</div>':'';
        return `<div class="sitem" style="width:200px"><h3>${a.name}</h3><p>${a.desc}</p><p style="color:#27ae60;font-size:11px;margin-bottom:4px">${a.bonusText}</p>${reqStr?`<p style="color:${reqOk?'#7ec87e':'#e74c3c'};font-size:11px;margin-bottom:6px">📋 ${reqStr}</p>`:''}<div class="pr">${priceLabel}</div>${activeMark}<button class="bbtn" onclick="buyApartment('${a.id}',${a.cost})" ${disabled?'disabled':''}>${btnLabel}</button></div>`;
      }).join('')}
    </div>
    ${rentalsHtml}
    <div class="res" id="shop-res">Wybierz mieszkanie.</div>
    <button class="cbtn" onclick="closeOverlay()">← Wróć</button>
  `;
}

// F+ 2026-05-12: wypowiedzenie najmu z 7-dniowym okresem (PLAN_SESJA #73 wynajem mechanika)
window.toggleRental=(id)=>{
  if(!G.rentals) G.rentals={};
  if(!G._rentalNotice) G._rentalNotice={};
  if(G.rentals[id]===true){
    // Aktywne — wypowiedz z 7-dniowym terminem
    if(G._rentalNotice[id]){
      // Już w okresie wypowiedzenia — odwołaj
      delete G._rentalNotice[id];
      if(typeof showMsg==='function')showMsg('✅ Wypowiedzenie odwołane. Najem trwa dalej.');
    } else {
      G._rentalNotice[id]=(G.day||1)+7;
      if(typeof showMsg==='function')showMsg(`📝 Wypowiedzenie najmu. Najem aktywny jeszcze 7 dni — potem dostęp wraca.`);
    }
  } else {
    G.rentals[id]=true;
    if(typeof showMsg==='function')showMsg('🔑 Najem aktywowany. Codziennie dostajesz czynsz.');
  }
  if(typeof renderBiuroNieruchomosci==='function') renderBiuroNieruchomosci();
  if(typeof saveGameSilent==='function') saveGameSilent();
};

