let currentRoom='ulica';
function wx2sx(wx){return wx-cam.x;}
function wy2sy(wy){return wy-cam.y+62;}

function drawTileMap(room){
  const ox=-cam.x,oy=-cam.y+62;
  const wW=room.wT*T, wH=room.hT*T;
  // Gdy pokój jest mniejszy niż viewport (np. studio 1056×672, silownia 960×672 vs 1280×658),
  // dorysuj ciemne tło aby NIE było pustego czarnego paska po prawej / na dole.
  if(wW<1280 || wH<658){
    X.fillStyle='#0e1420';
    X.fillRect(0,62,1280,658);
    // Subtelny gradient żeby nie wyglądało jak "out-of-bounds"
    const g=X.createLinearGradient(0,62,0,720);
    g.addColorStop(0,'rgba(50,30,50,.10)');g.addColorStop(1,'rgba(0,0,0,.30)');
    X.fillStyle=g;X.fillRect(0,62,1280,658);
  }
  for(let r=0;r<room.hT;r++){
    for(let c=0;c<room.wT;c++){
      const tx=c*T+ox,ty=r*T+oy;
      if(tx>-T&&tx<1280&&ty>-T&&ty<720){
        const id=room.map[r][c];
        if(tiles[id]) X.drawImage(tiles[id],tx,ty);
      }
    }
  }
}

function drawObjects(room){
  const nearId=getNear();
  for(const obj of room.objects){
    // NPC fan only visible when player has fans
    if(obj.id==='npc_fan'&&(G.fans||0)<10) continue;
    const sx=wx2sx(obj.wx),sy=wy2sy(obj.wy);
    // Clipping uwzględnia szerokość obiektu — dla długich ścian (np. wall_h2b lux: 1480px)
    // sam sx nie wystarczy: lewa krawędź może być daleko poza ekranem, a prawa wciąż widoczna.
    // v1.9.20: Dodano Y-axis culling — wcześniej offscreen pionowe obiekty pełzły pełen pipeline rysowania
    if(sx+obj.w<-50||sx>1530||sy+(obj.h||64)<-50||sy>820) continue;
    if(nearId===obj.id){
      const pulse=0.55+0.45*Math.sin(anim*0.12);
      X.save();
      // Aura — radial gradient za obiektem (zamiast tylko ring)
      X.globalCompositeOperation='lighter';
      const cx=sx+obj.w/2,cy=sy+obj.h/2;
      const r=Math.max(obj.w,obj.h)*0.7;
      const g=X.createRadialGradient(cx,cy,obj.w*0.3,cx,cy,r);
      g.addColorStop(0,`rgba(126,200,227,${0.18+pulse*0.10})`);
      g.addColorStop(0.6,`rgba(126,200,227,${0.05+pulse*0.05})`);
      g.addColorStop(1,'rgba(126,200,227,0)');
      X.fillStyle=g;X.fillRect(sx-r/2,sy-r/2,obj.w+r,obj.h+r);
      X.globalCompositeOperation='source-over';
      // Ring — dotychczasowy
      X.shadowColor='#7ec8e3';X.shadowBlur=18+10*pulse;
      X.strokeStyle=`rgba(126,200,227,${0.6+0.4*pulse})`;X.lineWidth=2;
      X.strokeRect(sx-3,sy-3,obj.w+6,obj.h+6);
      X.restore();
    }
    drawSprite(obj.id,sx,sy,obj.w,obj.h);
  }
}

