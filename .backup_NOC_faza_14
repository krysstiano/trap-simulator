function startRestMG(type,_dur,_eg,_mg,label,onDone){
  if(_restTimer)return;
  G._resting=true;
  _restOnDone=onDone||null;
  /* v2.1.228 audit-fix #66: rest energy regen za wolne (user: "nie oplaca sie odpoczywac tylko spac").
     Sofa 0.65→2.0 energy/tick (200ms) = 10/s = 100 energy w 10s real. Bench/pond 0.30→1.2 (full restore w 17s).
     Sleep nadal najszybszy do full health+hunger combo, ale rest teraz konkurencyjny dla krótkich top-up'ów. */
  const maxTicks=type==='sofa'?300:150;
  const energyPerTick=type==='sofa'?2.0:1.2;
  const moodPerTick=type==='sofa'?0.15:0.07; /* v2.1.200: sofa 0.5→0.15, bench 0.25→0.07 (Agent E+F audyt) — wcześniej sofa dawała +0.5/200ms = 150/min mood (cap 100 w 40s), bench +75/min (cap w 80s). Teraz sofa +45/min (cap w 2min), bench +21/min (cap w 5min). Spójne z sleep 0.6→0.15 fix i tickDecay 1.0 (10/min). Mood nadal regeneruje ale wymaga aktywnego użycia. */
  const hungerPerTick=0.05;
  const wrap=document.getElementById('wrap');
  let existing=document.getElementById('rest-overlay');
  if(existing)existing.remove();
  const ov=document.createElement('div');
  ov.id='rest-overlay';
  ov.style.cssText='position:absolute;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(4,10,22,.96);border:1px solid #2a4a6a;border-radius:10px;padding:16px 30px;z-index:25;min-width:340px;text-align:center;pointer-events:all;';
  const icons={sofa:'🛋',bench:'🪑',pond:'🐟'};
  ov.innerHTML=`
    <div style="font-size:15px;color:#7ec8e3;font-weight:700;margin-bottom:6px">${icons[type]||'⏳'} ${label}</div>
    <div style="background:#0a1220;border-radius:6px;height:12px;overflow:hidden;width:100%;margin-bottom:8px">
      <div id="rest-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#3498db,#7ec8e3);border-radius:6px;transition:width .18s;"></div>
    </div>
    <div id="rest-status" style="font-size:13px;color:#aaa;margin-bottom:10px;line-height:1.6">⚡ — · 🍔 —</div>
    <button onclick="stopRest()" style="background:transparent;border:1px solid #2a4a6a;color:#556;font-family:inherit;font-size:12px;padding:6px 20px;cursor:pointer;border-radius:4px;transition:all .15s;" onmouseover="this.style.borderColor='#7ec8e3';this.style.color='#7ec8e3'" onmouseout="this.style.borderColor='#2a4a6a';this.style.color='#556'">Wstań [Esc]</button>
  `;
  wrap.appendChild(ov);
  let ticks=0;
  _restTimer=setInterval(()=>{
    if(!G._resting){stopRest();return;}
    ticks++;
    G.energy=clampStat('energy', G.energy+energyPerTick);
    G.stress=clamp(G.stress+moodPerTick,0,100);
    G.hunger=clampStat('hunger', G.hunger-hungerPerTick);
    updateHUD();
    const bar=document.getElementById('rest-bar');
    if(bar)bar.style.width=(ticks/maxTicks*100)+'%';
    const st=document.getElementById('rest-status');
    if(st)st.innerHTML=`⚡ <b style="color:#3498db">${Math.floor(G.energy)}%</b> &nbsp;·&nbsp; 🍔 <b style="color:#27ae60">${Math.floor(G.hunger)}%</b>`;
    // auto-stop: energy full, hunger critical, or max time reached
    // v2.1.25: minimum 30 ticks (6s) PRZED auto-stop (żeby okno nie zamykało się natychmiast gdy energy=100)
    // v2.1.26: XP z capem (1× na minutę real per type)
    if(ticks>=30 && (G.energy>=100||G.hunger<=2||ticks>=maxTicks)){
      const msgs={sofa:'🛋 Odpoczęłeś na sofie!',bench:'🌳 Relaks na ławce!',pond:'🐟 Spokój przy stawie!'};
      addXPCapped(2, 'rest_finalize_'+type, 60000);
      if(_restOnDone){_restOnDone();_restOnDone=null;}
      notify(msgs[type]||'Odpoczęłeś!');
      stopRest();
    }
  },200);
}

