body.cinematic-active #hphone{opacity:0!important;visibility:hidden!important;pointer-events:none!important;transition:opacity .6s ease-out;} /* v2.1.199: #prompt też ukryty — user feedback "widać [E] Wejdź - Traphouse podczas cinematic" */
@keyframes fmapHalo{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.85}50%{transform:translate(-50%,-50%) scale(1.4);opacity:.4}}
