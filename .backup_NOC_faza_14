    </div>`;
  document.body.appendChild(m);
  /* v1.9.20: BUG FIX — double-fire guard. Rapid double-click "Tak" wcześniej wykonywał onYes() 2× → duplicate state mutations (np. double-delete save, double-charge G.money). */
  let _fired=false;
