/* v1.9.31 → v2.1.212: addFame z diminishing returns + cap 500 */
function addFame(n){
  if(!n||n<=0)return 0;
  const skillMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('legend_status'):1;
  const mult=(G.prestigeBonus?.fameMult||1)*skillMult;
  const dimMult=getFameDimMult();
  /* v2.1.217 [Amper] BALANS: min 1 fame gain dla pozytywnego input — chroni małe rewardy (Daily Wheel +1, fountain +3) przed zerową wypłatą przy Tier 3+ (round(0.25)=0). */
  const final=Math.max(1, Math.round(n*mult*dimMult));
  G.fame=Math.min(500,Math.max(0,(G.fame||0)+final));
  return final;
}
/* v2.1.141: addFans(n) wrapper — analogicznie do addFame()/earn(). Hook dla crew challenge 'gain_fans' (Faza E TODO L42547).
   Wszystkie miejsca przyrostu G.fans (12 lokalizacji) używają tej funkcji — 1 punkt modyfikacji dla future buffów (np. Marketing crew +10%).
   NIE używa się w defensive init / save migration / admin commands (te NIE są "gracz zdobywa fanów"). */
