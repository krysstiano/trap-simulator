  return `TRAP-${hex.slice(0,4)}-${hex.slice(4,8)}-${hex.slice(8,12)}`;
}
function parseFriendCode(code){
  if(!code) return null;
  const up=code.toUpperCase();
  // Nowy format 12 hex (3 segmenty)
  let m=up.match(/^TRAP[-_]?([0-9A-F]{4})[-_]?([0-9A-F]{4})[-_]?([0-9A-F]{4})$/);
  if(m) return (m[1]+m[2]+m[3]).toLowerCase();
  // Stary format 8 hex (2 segmenty) — backward compat
  m=up.match(/^TRAP[-_]?([0-9A-F]{4})[-_]?([0-9A-F]{4})$/);
  if(m) return (m[1]+m[2]).toLowerCase();
  return null;
}
async function addFriend(code){
  const prefix=parseFriendCode(code);
  if(!prefix) return {ok:false,error:'Nieprawidłowy kod (przykład: TRAP-A3F1-B2C9)'};
  const found=await _lbFetch(`leaderboard?user_id=like.${prefix}*&order=updated_at.desc&limit=5`);
  if(!found||!found.length) return {ok:false,error:'Nie znaleziono gracza z tym kodem'};
  const uniqueUsers=new Map();
  for(const e of found){if(!uniqueUsers.has(e.user_id)) uniqueUsers.set(e.user_id,e);}
  const friend=[...uniqueUsers.values()][0];
  if(friend.user_id===G.playerUUID) return {ok:false,error:'To Twój własny kod 😄'};
  if((G.friends||[]).some(f=>f.userId===friend.user_id)) return {ok:false,error:`${friend.nick} jest już Twoim znajomym`};
  /* v2.1.0: pending invite flow. Sprawdź czy ten gracz nas wcześniej nie zaprosił → auto-accept. */
  const incoming=await _lbFetch(`friendships?from_user_id=eq.${friend.user_id}&to_user_id=eq.${G.playerUUID}&status=eq.pending&limit=1`);
  if(Array.isArray(incoming) && incoming.length>0){
    await _lbAcceptFriendRequest(friend.user_id,friend.nick);
    return {ok:true,friend,autoAccepted:true};
  }
  /* Sprawdź czy nie ma już zaproszenia ode mnie */
  const existing=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${friend.user_id}&limit=1`);
  if(Array.isArray(existing) && existing.length>0 && existing[0].status==='pending'){
    return {ok:false,error:'Zaproszenie już wysłane — czeka na akceptację'};
  }
  /* v2.1.11: merge-duplicates żeby re-send invite po rejected/accepted działało */
  await _lbFetch('friendships?on_conflict=from_user_id,to_user_id',{
    method:'POST',
    headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
    body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:friend.user_id,status:'pending'})
  });
  return {ok:true,friend,pending:true};
}
async function addFriendByUserId(userId,nick){
  if(userId===G.playerUUID) return {ok:false,error:'To Twój własny profil 😄'};
  if((G.friends||[]).some(f=>f.userId===userId)) return {ok:false,error:`${nick||'Gracz'} jest już Twoim znajomym`};
  /* v2.1.11: lepszy nick fallback — najpierw spróbuj odzyskać świeży nick z LB (najnowszy entry tego usera),
     dopiero potem fallback do prostego "Gracz" zamiast UUID prefixu który wygląda jak Player_d6eda2 */
  let _safeNick=_validNick(nick)?nick:null;
  if(!_safeNick){
    const lbRow=await _lbFetch(`leaderboard?user_id=eq.${userId}&order=updated_at.desc&limit=1`);
    if(Array.isArray(lbRow) && lbRow.length>0 && _validNick(lbRow[0].nick)) _safeNick=lbRow[0].nick;
  }
  if(!_safeNick) _safeNick='Gracz';
  const incoming=await _lbFetch(`friendships?from_user_id=eq.${userId}&to_user_id=eq.${G.playerUUID}&status=eq.pending&limit=1`);
  if(Array.isArray(incoming) && incoming.length>0){
    await _lbAcceptFriendRequest(userId,_safeNick);
    return {ok:true,autoAccepted:true};
  }
  /* v2.1.11: użyj merge-duplicates (UPSERT) — gdy invite/friendship już istnieje (np. status='rejected'),
     nadpisuje status='pending' zamiast ignore. Plus on_conflict=from_user_id,to_user_id musi pasować do PRIMARY KEY. */
  const r=await _lbFetch('friendships?on_conflict=from_user_id,to_user_id',{
    method:'POST',
    headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
    body:JSON.stringify({from_user_id:G.playerUUID,to_user_id:userId,status:'pending'})
  });
  if(r===null){
    /* Sprawdź czy rekord już istnieje — może to konflikt nie błąd sieci */
    const exists=await _lbFetch(`friendships?from_user_id=eq.${G.playerUUID}&to_user_id=eq.${userId}&limit=1`);
    if(Array.isArray(exists) && exists.length>0){
      const e=exists[0];
      if(e.status==='pending') return {ok:false,error:'Zaproszenie już wysłane — czekaj na akceptację'};
      if(e.status==='accepted') return {ok:false,error:'Już jesteście znajomymi'};
      if(e.status==='rejected') return {ok:false,error:'Zaproszenie odrzucone — spróbuj za chwilę'};
    }
    return {ok:false,error:'Błąd serwera. Spróbuj ponownie.'};
  }
  return {ok:true,pending:true};
}
