  }
}catch(_){}

function scaleGame(){
  /* v2.1.155: Mobile portrait fix v2 — character creator/menu były mikroskopijne (scale 0.29 dla 375x667).
     Strategy: detect mobile + pre-game state (menu/creator visible) → DISABLE #wrap transform, pokaż natywne UI.
     Po startGame (gameplay) — normalne scaling (gracz widzi canvas z auto-zoom przez #wrap scale).
     Plus: rotate hint na bardzo małych portraitach (<420px). */
  const isMobile=window.innerWidth<900;
  const el=document.getElementById('wrap');
  /* v2.1.163: null guard — scaleGame może być wywoływane podczas init przed pełnym DOM parse */
  if(!el) return;
  /* Pre-game state detection: menu visible LUB creator visible (nie zaczęta gra) */
  const menuEl=document.getElementById('menu');
  const creatorEl=document.getElementById('creator');
  const inPreGame = (menuEl && window.getComputedStyle(menuEl).display!=='none') ||
                    (creatorEl && window.getComputedStyle(creatorEl).display!=='none');
  if(isMobile && inPreGame){
    /* Pre-game na mobile: NATIVE UI, no scaling — #wrap full viewport, menu/creator natywne pixele */
    el.style.transform='none';
    el.style.left='0';
    el.style.top='0';
    el.style.width='100vw';
    el.style.height='100vh';
    document.body.classList.add('mobile-pregame');
  } else {
    /* Gameplay scaling (lub desktop) */
    document.body.classList.remove('mobile-pregame');
    el.style.width='1280px';
    el.style.height='720px';
    const s=Math.min(window.innerWidth/1280,window.innerHeight/720);
    const scaledW=1280*s, scaledH=720*s;
    el.style.transform=`scale(${s})`;
    el.style.left=Math.max(0,(window.innerWidth-scaledW)/2)+'px';
    el.style.top=Math.max(0,(window.innerHeight-scaledH)/2)+'px';
  }
  const isPortrait=window.innerHeight>window.innerWidth;
  /* v2.1.153: rotate hint dla bardzo małych portrait (<420px width) */
  let hint=document.getElementById('rotate-hint');
  if(isMobile && isPortrait && window.innerWidth<420){
    if(!hint){
      hint=document.createElement('div');
      hint.id='rotate-hint';
      hint.style.cssText='position:fixed;top:8px;left:50%;transform:translateX(-50%);background:rgba(40,80,140,.92);color:#fff;padding:8px 14px;border-radius:8px;border:1px solid #7ec8e3;font-family:inherit;font-size:12px;font-weight:700;z-index:9998;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.5)';
      hint.innerHTML='🔄 Obróć telefon poziomo dla lepszej rozgrywki';
      document.body.appendChild(hint);
      setTimeout(()=>{if(hint)hint.style.opacity='0.7';},4000);
    }
  } else if(hint){
    hint.remove();
  }
}
window.addEventListener('resize',scaleGame);
scaleGame();
// v1.8.57: generowanie gwiazd i śniegu w menu (deterministyczne — wartości stałe między startami żeby nie migotały)
(function _initMenuFx(){
  const stars=document.getElementById('menu-stars');
  if(stars && !stars.children.length){
    // 80 gwiazd na całe tło menu, rozsiane po niebie (górne 60% ekranu)
    for(let i=0;i<80;i++){
      const sp=document.createElement('span');
      // pseudo-random deterministyczny (sin)
      const x=((i*37)%97)/97*100;
      const y=((i*53)%89)/89*55; // tylko górne 55% (niebo)
      const dur=2.2+((i*7)%30)/10;
      const delay=((i*13)%30)/10;
      const size=1+(i%3)*0.5;
      sp.style.cssText=`left:${x}%;top:${y}%;width:${size}px;height:${size}px;animation-duration:${dur}s;animation-delay:${delay}s;`;
      stars.appendChild(sp);
    }
  }
  const snow=document.getElementById('menu-snow');
  if(snow && !snow.children.length){
    // 35 płatków śniegu losowo rozsianych (Unicode glyph)
    const glyphs=['❄','✦','❅','*'];
    for(let i=0;i<35;i++){
      const sp=document.createElement('span');
      const x=((i*41)%101)/101*100;
      const dur=8+((i*11)%80)/10;
      const delay=((i*17)%120)/10;
      const size=10+((i*23)%14);
      const glyph=glyphs[i%4];
      sp.textContent=glyph;
      sp.style.cssText=`left:${x}%;font-size:${size}px;animation-duration:${dur}s;animation-delay:-${delay}s;`;
      snow.appendChild(sp);
    }
  }
})();
