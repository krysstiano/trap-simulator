// ═══════════════════════════════════════════════════════════════════
function startFreestyleMG(){
  // Skill gate — Flow 1 gives bonus, but game is open to beginners
  const flowLevel=getRaperST('flow');
  const el=document.getElementById('mg-job');
  el.style.display='';el.classList.add('on');
  el.innerHTML='';
  // v1.8.64: safety — wyczyść bufor admina żeby trafienie "snowy"/"amper" w freestyle nie uruchomiło panelu
  // (główna ochrona to !_busyMG check w globalnym keydown, ten reset usuwa też stare litery sprzed minigry)
  try{ _adminSeq=''; }catch(_){}

  const WORDS=['drip','flow','beats','swag','bars','trap','wave','grind','hustle','cold',
    'melodia','rytm','sława','ulica','hajs','noc','raj','ból','moc','ekipa',
    'freestyle','mikrofon','studio','label','stream','viral','koncert','single','track','album',
    'raper','tekst','hook','wers','beton','blok','łańcuch','fame',
    'rhyme','verse','beat','stage','crowd','money','dope',
    // Game-themed
    'amper','puch43','snowy','traper','traphouse','penthouse','vibe','clout','street','ghetto',
    // Trap/rap extras
    'autotune','808','sub','drumkit','adlib','remix','mixtape','cypher','gold','platyna',
    'biling','flexin','cash','grands','squad','homies','fresh','ice','chain','rolex',
    // v1.8.64: dodane
    'rollie','vvs','diamond','iced out','focusrite','nt1'];

  // v1.8.97: Flow 1 "Podstawowy rytm" — freestyle trwa +10% dłużej (33s zamiast 30)
  const _flowDur=(typeof getRaperST==='function' && getRaperST('flow')>=1)?33:30;
  let gameActive=true,timeLeft=_flowDur,score=0,combo=0,wordsCorrect=0;
  let curWord='',typed='',wordStartTime=0;

  function pickWord(){
    let w;
    do {
      // v1.8.64: minimalny smaczek — ~2% szansy na słowo z bonus poola (snowy/amper)
      if(Math.random()<0.02){
        w = Math.random()<0.5 ? 'snowy' : 'amper';
      } else {
        w = WORDS[Math.floor(Math.random()*WORDS.length)];
      }
    } while(w===curWord);
    return w;
  }

  function nextWord(){
    curWord=pickWord();typed='';wordStartTime=Date.now();
    renderWord();
  }

  function renderWord(){
    const wa=document.getElementById('fs-wordarea');
    if(!wa) return;
    let html='';
    for(let i=0;i<curWord.length;i++){
      if(i<typed.length){
        html+=`<span style="font-size:52px;font-weight:900;letter-spacing:6px;color:#27ae60">${curWord[i].toUpperCase()}</span>`;
      } else if(i===typed.length){
        html+=`<span style="font-size:52px;font-weight:900;letter-spacing:6px;color:#fff;border-bottom:3px solid #f1c40f">${curWord[i].toUpperCase()}</span>`;
      } else {
        html+=`<span style="font-size:52px;font-weight:900;letter-spacing:6px;color:#334">${curWord[i].toUpperCase()}</span>`;
      }
    }
    wa.innerHTML=html;
  }

  el.innerHTML=`
    <h2 style="color:#e91e8c;font-size:22px;margin-bottom:4px">🎤 Freestyle na ulicy</h2>
    <div style="font-size:13px;color:#667;margin-bottom:10px">Wpisz słowo na klawiaturze! Szybko i bezbłędnie = więcej punktów!</div>
    ${flowLevel<1?'<div style="font-size:12px;color:#f1c40f;margin-bottom:8px;">💡 Odblokuj Flow w drzewku aby zwiększyć nagrody!</div>':''}
    <div style="display:flex;gap:24px;margin-bottom:12px;font-size:15px;color:#aaa;">
      <span>⏱ <b id="fs-time">30</b>s</span>
      <span>🔥 Score: <b id="fs-score">0</b></span>
      <span>🎵 Combo: <b id="fs-combo">0x</b></span>
      <span>✅ <b id="fs-words">0</b> słów</span>
    </div>
    <div style="width:680px;min-height:110px;background:#050c18;border:2px solid #e91e8c;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;padding:10px;">
      <div id="fs-wordarea"></div>
    </div>
    <div id="fs-feed" style="font-size:20px;color:#f1c40f;min-height:28px;text-align:center;font-weight:700;margin-bottom:8px;"></div>
    <button id="fs-exit" style="background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:8px 20px;cursor:pointer;border-radius:4px;font-size:14px;">✕ Wyjdź</button>
  `;
  document.getElementById('fs-exit').onclick=()=>{gameActive=false;cleanup();};
  nextWord();

  const timer=setInterval(()=>{
    if(!gameActive){clearInterval(timer);return;}
    timeLeft-=0.1;
    const bt=document.getElementById('fs-time');if(bt)bt.textContent=Math.ceil(timeLeft);
    if(timeLeft<=0){gameActive=false;clearInterval(timer);cleanup();}
  },100);

  window._fsKeydown=(e)=>{
    if(!gameActive) return;
    if(e.key.length===1&&!e.ctrlKey&&!e.altKey&&!e.metaKey){
      e.preventDefault();
      const expected=curWord[typed.length];
      if(!expected) return;
      if(e.key.toLowerCase()===expected.toLowerCase()){
        typed+=e.key;
        if(typed.length===curWord.length){
          // Word completed!
          const elapsed=(Date.now()-wordStartTime)/1000;
          const speedBonus=Math.max(1,Math.round(5/Math.max(0.5,elapsed)));
          const flowMult=flowLevel>=2?1.15:1;
          const pts=Math.round((10+combo*2)*speedBonus*flowMult);
          score+=pts;combo++;wordsCorrect++;
          document.getElementById('fs-score').textContent=score;
          document.getElementById('fs-combo').textContent=combo+'x';
          document.getElementById('fs-words').textContent=wordsCorrect;
          const msgs=['🔥 FIRE!','💯 ON POINT!','⚡ BARS!','🎤 FLOW!','✅ DOPE!','💪 FRESH!','😤 HARD!'];
          const fd=document.getElementById('fs-feed');if(fd)fd.textContent=msgs[Math.floor(Math.random()*msgs.length)];
          nextWord();
        } else {
          renderWord();
        }
      } else {
        // Wrong key — break combo, shake effect
        combo=0;
        document.getElementById('fs-combo').textContent='0x';
        const fd=document.getElementById('fs-feed');if(fd)fd.textContent='💀 Błąd!';
        const wa=document.getElementById('fs-wordarea');
        if(wa){
          wa.style.animation='none';
          requestAnimationFrame(()=>{wa.style.animation='fs-shake .2s';});
        }
      }
    }
  };
  document.addEventListener('keydown',window._fsKeydown);

  function cleanup(){
    clearInterval(timer);
    if(window._fsKeydown){document.removeEventListener('keydown',window._fsKeydown);window._fsKeydown=null;}
    // Award rewards
    let raperXP=0,fansGained=0,followers=0,repGain=0,mainXP=0;
    // Wpływ pogody na freestyle (deszcz/burza/śnieg = mniej publiki)
    const weatherMult = G.weather===2 ? 0.5 :  // deszcz
                       G.weather===5 ? 0.4 :   // burza
                       G.weather===3 ? 0.7 :   // śnieg
                       G.weather===0 ? 1.15 :  // słońce — bonus
                       1.0;
    if(weatherMult<1) addNotif(`☔ ${G.weather===5?'Burza':G.weather===2?'Deszcz':'Śnieg'} — mniej osób na ulicy (${Math.round((1-weatherMult)*100)}% nagród mniej)`);
    // F3-FIX-D: FLOW + SKUPIENIE (Master Mind +25% jakości aktywności)
    score = Math.floor(score * getFlowFreestyleBonus() * getSkupienieFocusBonus());
    // v1.8.96: Talent Contest — bonus freestyle
    const _fsBoost=typeof festivalEffect==='function'?(festivalEffect('freestyleBoost')||1):1;
    if(_fsBoost>1){ score=Math.floor(score*_fsBoost); }
    if(score>0){
      if(!G.careers.raper) G.careers.raper={level:0,freestyles:0,tracks:0,xp:0,skillPts:0};
      G.careers.raper.freestyles=(G.careers.raper.freestyles||0)+1;
      // #78 NERF 10× — gracz dostawał ~266 raperXP / 106 fanów / 133 follow / 88 rep za 30s freestyle (absurd)
      // Teraz: ~26 raperXP / 10 fanów / 13 follow / 8 rep — wymaga ~10 freestyle aby wbić poziom raper
      raperXP=Math.floor(score*weatherMult/100);addRaperXP(raperXP);
      /* v2.1.33: stare dwa liczniki (fansGained score/250 + followers score/200) były dodawane oba do casual po refaktorze v2.1.31.
         Zostawiona większa formuła (score/200) jako pojedyncza — odpowiada "13 follow / 30s" z komentarza #78 NERF. */
      /* v2.1.112: Wave 1 S2 — viral bonus visible feedback (wcześniej cichy bonus, gracz nie wiedział że Flow 4 aktywował). */
      const _viralRoll = flowLevel>=4 && Math.random()<0.10;
      fansGained=Math.floor(score*weatherMult/200)+(_viralRoll?50:0);
      /* v2.1.34: uliczny freestyle = lojalni fani (zatrzymali się, słuchają) */
      if(fansGained>0){addFans(fansGained);} /* v2.1.141: freestyle ulica fans */
      if(_viralRoll){if(typeof addNotif==='function')addNotif('🔥 VIRAL FREESTYLE! Flow 4 evolution: +50 lojalnych fanów!');if(typeof showMsg==='function')showMsg('🔥 Viral freestyle! +50 fanów bonus!','g',3500);}
      followers=fansGained; /* alias dla komunikatów */
      mainXP=Math.floor(score/80);addXP(mainXP);  // XP bez pogody — score/8→score/80
      repGain=Math.floor(score*weatherMult/300);
      G.streetRep=Math.min(100,(G.streetRep||0)+repGain);
      progressQuest('freestyle');
    }
    // Grade + high score
    const grade=score>=500?'S':score>=300?'A':score>=150?'B':score>=75?'C':score>0?'D':'F';
    const gradeCol={'S':'#f1c40f','A':'#e91e8c','B':'#3498db','C':'#2ecc71','D':'#aaa','F':'#555'}[grade];
    const prevHigh=G.careers.raper?G.careers.raper.freestyleHighScore||0:0;
    const isNewRecord=score>prevHigh&&score>0;
    if(isNewRecord){if(!G.careers.raper)G.careers.raper={level:0,freestyles:0,tracks:0,xp:0,skillPts:0};G.careers.raper.freestyleHighScore=score;}
    if(grade==='S'||grade==='A') confetti(grade==='S'?50:25);
    const rewardsHtml=score>0?`
      <div style="background:#0a1220;border:1px solid #1a3a5a;border-radius:10px;padding:12px 16px;margin-bottom:16px;text-align:left">
        <div style="font-size:12px;color:#556;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Nagrody</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:14px">
          <div style="color:#e8a020">🎤 +${raperXP} XP rapera</div>
          <div style="color:#2ecc71">⭐ +${mainXP} XP</div>
          <div style="color:#3498db">👥 +${fansGained} fanów</div>
          <div style="color:#9b59b6">📱 +${followers} followersów</div>
          ${repGain>0?`<div style="color:#e91e8c">🏆 +${repGain} rep ulicy</div>`:''}
        </div>
      </div>`:'<div style="color:#667;font-size:14px;margin-bottom:16px">Brak punktów — brak nagrody.</div>';
    el.innerHTML=`
      <div style="text-align:center;padding:22px 24px">
        <div style="font-size:18px;color:#e91e8c;font-weight:700;margin-bottom:2px">🎤 Freestyle zakończony!</div>
        ${isNewRecord?`<div style="font-size:11px;color:#f1c40f;letter-spacing:2px;font-weight:700;margin-bottom:2px">★ NOWY REKORD! ★</div>`:''}
        <div style="font-size:88px;font-weight:900;color:${gradeCol};line-height:1;text-shadow:0 0 28px ${gradeCol}99;margin:8px 0 4px">${grade}</div>
        <div style="font-size:30px;font-weight:700;color:#fff;margin-bottom:2px">${score} pkt</div>
        <div style="font-size:13px;color:#778;margin-bottom:4px">${wordsCorrect} słów · max combo ${combo}x</div>
        ${prevHigh>0&&!isNewRecord?`<div style="font-size:11px;color:#445;margin-bottom:12px">Rekord: ${prevHigh} pkt</div>`:'<div style="margin-bottom:12px"></div>'}
        ${rewardsHtml}
        <div style="display:flex;gap:10px;justify-content:center">
          <button onclick="var _e=document.getElementById('mg-job');_e.style.display='none';_e.classList.remove('on');_e.innerHTML='';startFreestyleMG();" style="background:#0a1528;border:1px solid #e91e8c;color:#e91e8c;padding:10px 22px;border-radius:6px;cursor:pointer;font-size:15px;font-weight:700">🔄 Jeszcze raz</button>
          <button onclick="var _e=document.getElementById('mg-job');_e.style.display='none';_e.classList.remove('on');_e.innerHTML='';" style="background:#1a0a0a;border:1px solid #5a1a1a;color:#e74c3c;padding:10px 22px;border-radius:6px;cursor:pointer;font-size:15px">✕ Wyjdź</button>
        </div>
      </div>
    `;
  }

  window._jobMgCleanup=()=>{gameActive=false;clearInterval(timer);if(window._fsKeydown)document.removeEventListener('keydown',window._fsKeydown);el.style.display='none';el.classList.remove('on');el.innerHTML='';};
}

