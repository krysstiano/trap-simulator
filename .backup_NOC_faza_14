window.renewSponsor=function(brandId, mode){
  const sIdx=(G.activeSponsors||[]).findIndex(s=>s.brandId===brandId);
  if(sIdx<0) return;
  const s=G.activeSponsors[sIdx];
  /* Renewal tylko jeśli kontrakt wygasa w ciągu 3 dni */
  if(s.expireDay-G.day>3){if(typeof showMsg==='function') showMsg('📋 Odnowienie dostępne dopiero na 3 dni przed końcem kontraktu.','r');return;}
  if(mode==='same'){
    s.expireDay=G.day+10; s.renewalCount=(s.renewalCount||0)+1;
    if(typeof showMsg==='function') showMsg(`📋 Kontrakt odnowiony! +10 dni.`,'g');
  } else if(mode==='negotiate'){
    /* v2.1.218 [Amper] BALANS: fail negocjacji NIE zrywa kontraktu (wcześniej -EV vs "same" — 0.7×11k=7.7k < 10k).
       Teraz fail = kontrakt zostaje same (+10 dni same rate). EV = 0.7×11 + 0.3×10 = 10.7k > 10k same. */
    const success=Math.random()<0.70;
    if(success){
      s.dailyRate=Math.floor(s.dailyRate*1.10);
      s.expireDay=G.day+10; s.renewalCount=(s.renewalCount||0)+1;
      if(typeof showMsg==='function') showMsg(`📋 Negocjacja sukces! +10% rate → ${s.dailyRate} zł/dzień, +10 dni.`,'g',5000);
    } else {
      /* Fail = kontrakt zostaje aktywny ze starą stawką (marka mówi "nie podwyższymy, ale kontynuujemy"). */
      s.expireDay=G.day+10; s.renewalCount=(s.renewalCount||0)+1;
      const brand=getSponsorBrand(brandId);
      if(typeof showMsg==='function') showMsg(`📋 ${brand?.name}: "Nie możemy podnieść stawki, ale kontynuujemy współpracę." Kontrakt odnowiony bez podwyżki, +10 dni.`,'f',5000);
    }
  }
  if(typeof renderPhoneApp==='function') renderPhoneApp('contracts');
};

