// Particle pool — proste cząstki dla efektów. Reużywany array.
const _particles=[];
function _spawnParticle(p){_particles.push(p);if(_particles.length>180)_particles.shift();}
function emitDust(wx,wy){_spawnParticle({wx,wy,vx:(Math.random()-0.5)*0.4,vy:-0.3-Math.random()*0.4,life:30,max:30,col:'rgba(190,170,140,',size:2+Math.random()*2});}
function emitSpark(wx,wy,col){
  for(let i=0;i<6;i++){
    const a=Math.random()*Math.PI*2,sp=1.2+Math.random()*1.8;
    _spawnParticle({wx,wy,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-0.6,life:24,max:24,col:(col||'rgba(255,220,140,'),size:1.5+Math.random()*1.5,grav:0.06});
  }
}
function emitSmoke(wx,wy){_spawnParticle({wx,wy:wy-Math.random()*4,vx:(Math.random()-0.5)*0.2,vy:-0.4-Math.random()*0.3,life:60,max:60,col:'rgba(120,120,130,',size:3+Math.random()*4,grow:0.05});}
function updateAndDrawParticles(){
  X.save();
  for(let i=_particles.length-1;i>=0;i--){
    const p=_particles[i];p.life--;
    p.wx+=p.vx;p.wy+=p.vy;
    if(p.grav)p.vy+=p.grav;
    if(p.grow)p.size+=p.grow;
    if(p.life<=0){_particles.splice(i,1);continue;}
    const sx=wx2sx(p.wx),sy=wy2sy(p.wy);
    if(sx<-30||sx>1310||sy<32||sy>760)continue;
    const a=p.life/p.max;
    X.fillStyle=p.col+a.toFixed(2)+')';
    X.beginPath();X.arc(sx,sy,p.size,0,Math.PI*2);X.fill();
  }
  X.restore();
}
