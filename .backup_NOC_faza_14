      <button class="cbtn" onclick="if(window._jobMgCleanup)window._jobMgCleanup()">← Porzuć</button>
    </div>`;

  function renderGrid(){
    const g=document.getElementById('sq-grid');if(!g)return;
    let html='<div style="display:grid;gap:4px">';
    TRACKS.forEach((tr,ti)=>{
      // D1: hint dla tego tracka
      const trackHints=hintMode?hints[tr.name]:null;
      html+=`<div style="display:flex;align-items:center;gap:4px">
        <span style="color:${tr.color};font-size:11px;font-weight:700;min-width:44px;text-align:right">${tr.name}</span>
        ${Array.from({length:STEPS},(_,si)=>{
          const isHint=trackHints && trackHints[si]===1 && !grid[ti][si];
          // Highlight: zielona ramka + lekkie zielone tło dla sugerowanych pustych pól
          const hintBorder=isHint?'2px dashed #27ae60':'1px solid #1a2535';
          const hintBg=isHint?'rgba(39,174,96,.15)':'#0a1018';
          return `<div id="sq-${ti}-${si}" onclick="window._sqToggle2&&window._sqToggle2(${ti},${si})"
          style="width:36px;height:28px;border-radius:4px;cursor:pointer;border:${si===step&&playing?'1px solid '+tr.color:hintBorder};
          background:${grid[ti][si]?(si===step&&playing?tr.color+'ee':tr.color+'88'):(si===step&&playing?'#2a2a2a':hintBg)};
          box-shadow:${grid[ti][si]&&si===step&&playing?'0 0 8px '+tr.color:isHint?'inset 0 0 6px rgba(39,174,96,.3)':'none'};transition:background .05s"></div>`;
        }).join('')}
      </div>`;
    });
    html+='</div>';g.innerHTML=html;
  }

  window._sqBpm=bpm;
  // #36E: blokada toggle podczas Play — gracz musi zatrzymać aby edytować
  window._sqToggle2=(ti,si)=>{
    if(playing){if(typeof showMsg==='function')showMsg('⏸ Zatrzymaj odtwarzanie żeby edytować pattern','r');return;}
    grid[ti][si]=grid[ti][si]?0:1;calcQuality();renderGrid();
  };
  // _sqRandomize usunięte — gracz musi sam stworzyć pattern

  function calcQuality(){
    // Jakość = czy bity mają ciekawy pattern (nie za rzadki, nie za gęsty)
    const dens=grid.flat().filter(Boolean).length/(STEPS*TRACKS.length);
    const kicks=grid[0].filter(Boolean).length;
    const snares=grid[1].filter(Boolean).length;
    /* v2.1.102: BUFF kod do match UI (Wave 5 K50/W50) — UI obiecuje synth808 +15%, drumPro +10%, kod miał +12/+8. Wybór: buff kod (NIE nerf UI). */
    const plugBonus=(G.plugins&&G.plugins.drumPro?10:0)+(G.plugins&&G.plugins.synth808&&(G.currentTrack&&(G.currentTrack.genre==='trap'||G.currentTrack.genre==='drill'))?15:0);
    /* v1.9.49: Hint mode -15% jakości (audyt DAW — wcześniej hint mode dawał te same nagrody co tryb bez podpowiedzi, więc tryb bez podpowiedzi był niewybierający) */
    const hintPenalty=hintMode?0.85:1;
    quality=Math.floor(clamp((dens*2.5+(kicks>=3?20:0)+(snares>=2?15:0)+(midiQ/5)+plugBonus)*hintPenalty*90/100*100,10,100));
    G._lastBeatQ=quality;
    const qEl=document.getElementById('sq-q');if(qEl)qEl.textContent=`Jakość: ${quality}%`;
    const fin=document.getElementById('sq-finish');
    if(fin)fin.disabled=quality<20;
    editTime++;
    const pr=document.getElementById('sq-prog');if(pr)pr.style.width=Math.min(100,quality)+'%';
  }

  function playStep2(){
    step=(step+1)%STEPS;
    // Play audio feedback for active cells (6 tracków: KICK, SNARE, HH, OPEN HAT, CLAP, 808)
    TRACKS.forEach((tr,ti)=>{
      if(grid[ti][step]){
        try{const a=getAudio();const o=a.createOscillator();const gn=a.createGain();o.connect(gn);gn.connect(typeof _sfxMasterGain!=='undefined'&&_sfxMasterGain?_sfxMasterGain:a.destination); /* v1.9.15: routed przez SFX master gain, suwak SFX teraz kontroluje sekwencer */
          // ti: 0=KICK 1=SNARE 2=HH 3=OPEN HAT 4=CLAP 5=808
          o.type=['sine','square','square','square','triangle','sine'][ti]||'sine';
          const f=[60,200,800,1200,500,55][ti]||200;
          o.frequency.setValueAtTime(f,a.currentTime);
          // OPEN HAT i CLAP dłuższy decay
          const decay=(ti===3||ti===4)?0.25:0.1;
          gn.gain.setValueAtTime(.08,a.currentTime);gn.gain.exponentialRampToValueAtTime(.001,a.currentTime+decay);
          o.start();o.stop(a.currentTime+decay+0.02);}catch(e){}
      }
    });
    renderGrid();
  }

  // #36E: ducking BGM podczas Play, BPM live restartuje timer
  window._sqRestartTimer=()=>{
    if(!playing) return;
    if(stepTimer) clearInterval(stepTimer);
    stepTimer=setInterval(()=>{playStep2();calcQuality();},60000/((window._sqBpm||90)*4));
  };
  window._sqToggle=()=>{
    playing=!playing;
    const btn=document.getElementById('sq-play');if(btn)btn.textContent=playing?'⏸ Stop':'▶ Play';
