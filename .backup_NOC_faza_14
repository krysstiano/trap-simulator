window.buyToFridge=(id)=>{
  const food=FOOD_CATALOG.find(f=>f.id===id);
  const _price=applyShopDiscount(food.price); // F3-FIX: negocjacje skill
  if(!food||G.money<_price){document.getElementById('shop-res').textContent='Za mało pieniędzy!';return;}
  G.money-=_price;
  const existing=G.fridgeItems.find(i=>i.id===id);
  if(existing) existing.qty++;
  else G.fridgeItems.push({...food,qty:1});
  document.getElementById('shop-res').textContent=`✅ ${food.emoji} ${food.name} → lodówka! -${food.price} zł`;
  renderFoodShop();
};

window.eatFromFridge=(id)=>{
  const item=G.fridgeItems.find(i=>i.id===id);
  if(!item||item.qty<=0) return;
  item.qty--;if(item.qty<=0) G.fridgeItems=G.fridgeItems.filter(i=>i.id!==id);
  // v1.8.99: Dieta skill — +5%/pkt energii z jedzenia (zgodnie z opisem — wcześniej fake)
  const _dietaMult=typeof getDietaEnergyBonus==='function'?getDietaEnergyBonus():1;
  if(item.hunger>0) G.hunger=eatFood(Math.round(item.hunger*_dietaMult));
  if(item.energy>0) G.energy=clampStat('energy', G.energy+Math.round(item.energy*_dietaMult));
  if(item.health!==0) G.health=clampStat('health', G.health+item.health);
  if(item.stress!==0) G.stress=clamp(G.stress+item.stress,0,100); /* v1.9.22: BUG FIX — pozwala na ujemny stres (energetyk -5) — wcześniej ignorowane */
  playEat();progressQuest('eat');
  const r=document.getElementById('fridge-res');
  if(r) r.textContent=`${item.emoji} Zjadłeś/wypiłeś ${item.name}! +${item.hunger} głód +${item.energy} energia`;
  // Re-render fridge
  setTimeout(()=>openFridgeUI(),500);
};

