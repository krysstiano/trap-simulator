     Po v2.1.40 (fani jako główna mechanika) G.fans rośnie szybko i mnożnik eksplodował → gracz dostawał 15-25k zł/dzień gry pasywnie z merchu (co 6 min realnego czasu).
     Nowe wzory: fameMult cap 1.5× (przy fame=100), hardcoreMult cap 2× (przy fans≥20k). Bardziej spójne z resztą balansu. */
  const t=MERCH_TYPES[product.type];
  const m=MERCH_MATERIALS[product.material];
  const d=MERCH_DESIGNS[product.design];
  const sugPrice=calcSuggestedPrice(product.type,product.material);
  const priceMod=Math.max(0.1, 1 - (product.price/sugPrice - 1) * 0.8);
  const fameMult = Math.min(1.5, 1 + (G.fame||0)*0.005);
  const hardcoreMult = Math.min(2.0, 1 + (G.fans||0)*0.00005);
  const trendMult=(G.merchStore.trend?.type===product.type)?G.merchStore.trend.multiplier:1;
  // Pogoda: zła pogoda → +30% popyt (zostają w domu, kupują online)
  const weatherMult=[2,3,4,5].includes(G.weather)?1.3:1.0;
  // Sezon: wpływa na popyt na konkretne produkty (zima → bluzy, lato → tshirty/czapki)
  const seasonMult=typeof seasonMerchMult==='function'?seasonMerchMult(product.type):1.0;
  // Festiwal: Black Friday → ×3 sprzedaż na 1 dzień
  const festMult=typeof festivalEffect==='function'?(festivalEffect('merchSalesMult')||1):1;
  /* v2.1.116: Wave 5 S46 — Holiday BlackFriday × Festival BlackFriday dual channel fix.
     Wcześniej calcDemand czytał tylko festival, nie Holiday. Teraz oba aplikują (jeśli oba aktywne = stack ×9, ale Holiday BF deterministic day 49 vs Festival BF random — rzadko razem). */
  const holidayMerchMult=typeof holidayBonus==='function'?(holidayBonus('merch')||1):1;
  /* v2.1.84 Amper: BUFF coefficient 0.0002 → 0.0005 (×2.5). Plus podniesione capacity (15/30/60/120) i wyższy hard cap (8k → 50k). Razem daje late game ~10-15k zł/dzień netto merch. */
  let base = (G.followers||0) * 0.0005 * priceMod * fameMult * hardcoreMult * (d?.popMod||1) * (m.popularityMod||1) * trendMult * merchPopularityMult() * weatherMult * seasonMult * festMult * holidayMerchMult;
  if(product.isLimited) base*=0.6;
  return Math.max(0, Math.floor(base));
}
function merchDailyTick(){
  ensureMerchStore();
  const ms=G.merchStore;
  if(ms.products.length===0) return;
  /* v2.1.64 Amper: IDEMPOTENCY GUARD — root cause raportu "300k w kilka minut".
     `nextPeriod()` (a więc i merchDailyTick) może być wywołany WIELOKROTNIE per real-time minuta:
     - World Tour: 5 miast × `nextPeriod()` w sekwencji (linia 20088) → 5× tick w ciągu ~30s
     - Sleep multi-day: jeśli sleepDebt skacze przez 3 dni, 3× tick
     - Inne skip-day akcje (np. eviction respawn)
     Bez guard'a Amper mógł dostać 30+ ticków × ~10k = 300k. Naprawione: tick wykonuje się max RAZ per G.day. */
  if(G._lastMerchTickDay===G.day) return;
  G._lastMerchTickDay=G.day;
  const cap=merchCapacity();
  let totalSold=0, totalRevenue=0;
  const slotsCount=ms.products.length;
  const capPerSlot=Math.floor(cap/slotsCount);
  /* v2.1.62 Amper: zbieramy breakdown per-produkt do szczegółowych faktur i toastów. */
  const breakdown=[];
  for(const p of ms.products){
    const demand=calcDemand(p);
    const sold=Math.min(demand, capPerSlot);
    if(sold>0){
      const t=MERCH_TYPES[p.type], m=MERCH_MATERIALS[p.material];
      const unitProfit=p.price-t.baseCost*m.priceMult;
      const profit=sold*unitProfit;
      const roundedProfit=Math.max(0,Math.floor(profit));
      if(typeof earn==='function') earn(roundedProfit,false); else {G.money+=roundedProfit;G.totalEarned=(G.totalEarned||0)+roundedProfit;}
      p.dailySales=sold;
      p.totalSold=(p.totalSold||0)+sold;
      p.totalRevenue=(p.totalRevenue||0)+sold*p.price;
      totalSold+=sold;
      totalRevenue+=roundedProfit;
      breakdown.push({emoji:t.emoji, name:`${t.name} ${m.name}`, sold, gross:sold*p.price, profit:roundedProfit, unitPrice:p.price});
    } else p.dailySales=0;
  }
  // Tygodniowy bonus collab — co 7 dni +500 sprzedaży podzielonych proporcjonalnie
  let collabBonus=0;
  if(ms.upgrades.collab && G.day%7===0 && ms.products.length>0){
    const bonus=500;
    const perProd=Math.floor(bonus/ms.products.length);
    for(const p of ms.products){
      const profit=perProd*(p.price-MERCH_TYPES[p.type].baseCost*MERCH_MATERIALS[p.material].priceMult);
      const _mProfit=Math.max(0,Math.floor(profit));
      if(typeof earn==='function') earn(_mProfit,false); else {G.money+=_mProfit;}
      p.totalSold=(p.totalSold||0)+perProd;
      p.totalRevenue=(p.totalRevenue||0)+perProd*p.price;
      collabBonus+=_mProfit;
      totalSold+=perProd;
      totalRevenue+=_mProfit;
    }
    addNotif(`🤝 Influencer collab: +${bonus} sprzedaży, +${collabBonus.toLocaleString('pl')} zł!`);
  }
  // Marketing — automatyczne wzmianki
  if(ms.upgrades.marketing && Math.random()<0.3){
    const fanGain=rnd(20,50);
    G.followers+=fanGain;
    addNotif(`📱 Marketing online: +${fanGain} fanów`);
  }
  /* v2.1.84 Amper: HARD DAILY CAP podniesiony 8000 → 50000 zł. Late-game gracz z 1mln+ followers + max upgrades + Black Friday i tak rzadko będzie blisko 50k — to safety net na exploity, nie ograniczenie progresu. Wcześniej 8k zatrzymywał gracza na ~3-4k netto/dzień co było demotywujące. */
  const HARD_DAILY_CAP=50000;
  if(totalRevenue>HARD_DAILY_CAP){
    const excess=totalRevenue-HARD_DAILY_CAP;
    G.money=Math.max(0,G.money-excess);
    G.totalEarned=Math.max(0,(G.totalEarned||0)-excess);
    totalRevenue=HARD_DAILY_CAP;
    addNotif(`⚖️ Merch — dzienny limit zysku ${HARD_DAILY_CAP.toLocaleString('pl')} zł osiągnięty.`);
  }
  /* v2.1.84 Amper: KLIENCI → FANI. Każda sprzedaż buduje lojalność — klienci merchu zostają fanami.
     Formuła: sqrt(totalSold) × 0.5 fanów dziennie. 10 sztuk sprzedanych = +1.5 fana, 100 = +5 fanów, 500 = +11 fanów. */
  if(totalSold > 0){
    const _merchFans = Math.floor(Math.sqrt(totalSold) * 0.5);
    if(_merchFans > 0){
      addFans(_merchFans); /* v2.1.141: merch trend fans */
      if(Math.random() < 0.3 && typeof addNotif==='function') addNotif(`🎤 Klienci merchu → +${_merchFans} fanów (lojalność)`);
    }
  }
  // Koszty utrzymania
  const opCost=merchDailyOperatingCost();
  if(opCost>0){
    G.money=Math.max(0,G.money-opCost);
    totalRevenue-=opCost;
  }
  ms.history.push({day:G.day,totalSold,totalRevenue,products:ms.products.length,opCost,breakdown});
  if(ms.history.length>30) ms.history.shift();
  ms.totalLifetimeRevenue+=Math.max(0,totalRevenue);
  ms.totalLifetimeSold+=totalSold;
  if(G.merch){
    G.merch.sold=(G.merch.sold||0)+totalSold;
    G.merch.revenue=(G.merch.revenue||0)+Math.max(0,totalRevenue);
  }
  /* v2.1.62 Amper: szczegółowa FAKTURA — gracz widzi co dokładnie się sprzedało, po jakiej cenie, ile kosztów. */
  if(totalSold>0){
    const _itemsStr=breakdown.map(b=>`${b.emoji} ${b.sold}× ${b.name} → ${b.gross.toLocaleString('pl')} zł`).join('\n');
    const _grossTotal=breakdown.reduce((s,b)=>s+b.gross,0);
    addNotif(`📋 Faktura merch #${ms.history.length} (dzień ${G.day}):\n${_itemsStr}\n💼 Brutto: ${_grossTotal.toLocaleString('pl')} zł · Koszty: -${opCost} zł · NETTO: ${totalRevenue.toLocaleString('pl')} zł`);
    if(typeof showGain==='function' && totalRevenue>0){
      const _toastBreakdown=breakdown.slice(0,2).map(b=>`${b.emoji}${b.sold}`).join(' ');
      const _extras=breakdown.length>2?` +${breakdown.length-2}`:'';
      showGain(`🧢 Merch ${_toastBreakdown}${_extras} · +${totalRevenue.toLocaleString('pl')} zł`,'#9b59b6');
    }
  }
  else if(opCost>0) addNotif(`💸 Merch — brak sprzedaży dziś, koszty utrzymania: -${opCost} zł`);
  // Trend update co 7 dni
  if(!ms.trend || ms.trend.expiresDay<=G.day){
    const types=merchAvailableTypes();
    const newTrend=types[Math.floor(Math.random()*types.length)];
    /* v2.1.109: trend multiplier skaluje z fame (Wave 7 N20) — wcześniej zawsze ×2.0 niezależnie od progress.
       Skala: fame 0 → ×2.0 (base), fame 50 → ×2.5, fame 100 → ×3.0. Late game gracz dostaje bigger boost (utrzymuje relevancy). */
    const _trendMult = 2.0 + Math.min(1.0, (G.fame||0)/100);
    ms.trend={type:newTrend, multiplier:_trendMult, expiresDay:G.day+7};
    addNotif(`📈 Nowy trend: "${MERCH_TYPES[newTrend].name}" na topie przez 7 dni! Boost ×${_trendMult.toFixed(1)}`);
  }
  /* v2.1.62 Amper: TYGODNIOWY RAPORT co 7 dni gry — podsumowanie sprzedaży, najlepszy produkt, wykres. */
  if(G.day%7===0 && ms.history.length>=2){
    const last7=ms.history.slice(-7);
    const _weekRev=last7.reduce((s,h)=>s+(h.totalRevenue||0),0);
    const _weekSold=last7.reduce((s,h)=>s+(h.totalSold||0),0);
    if(_weekSold>0 && typeof showMsg==='function'){
      const _avgDay=Math.round(_weekRev/last7.length);
      const _bestDay=last7.reduce((a,b)=>(a.totalRevenue||0)>(b.totalRevenue||0)?a:b);
      showMsg(`📊 Tygodniowy raport merch (dzień ${G.day})\nSprzedaż: ${_weekSold} szt · Netto: ${_weekRev.toLocaleString('pl')} zł\nŚrednia dzienna: ${_avgDay.toLocaleString('pl')} zł · Najlepszy dzień: ${_bestDay.day} (${(_bestDay.totalRevenue||0).toLocaleString('pl')} zł)`,'g',8000);
    }
  }
}

