        <div style="font-size:30px;letter-spacing:6px;color:#c8a520;font-weight:900;text-shadow:0 0 18px rgba(200,165,32,.6)">🎱 KENO ROYAL</div>
        <p style="color:#aac;font-size:12px;margin:6px 0;max-width:600px;margin:6px auto">Wybierz <b style="color:#fff">4 do 10 liczb</b> z planszy (1-80). Krupier losuje 20 liczb. Im więcej Twoich liczb wylosowanych, tym większa wygrana. <b style="color:#f1c40f">Max wygrana: 1000× stawki</b> przy trafieniu wszystkich liczb.</p>
      </div>
      <div style="text-align:center;margin-bottom:12px">
        <span class="chip chip-gold" style="font-size:13px;padding:6px 14px">🎟️ ${G.casinoChips.toLocaleString('pl')} żetonów</span>
        <span style="margin-left:14px;color:#aac;font-size:13px">Wybrano: <b style="color:${picked.length>=4?'#7eff90':'#f4a097'}">${picked.length}/10</b> ${picked.length<4?'(min 4)':''}</span>
      </div>
      ${G.casinoChips<20?'<div style="background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.5);padding:12px;border-radius:10px;text-align:center;color:#f4a097;font-size:13px;margin:10px auto;max-width:520px">💸 Brak żetonów! Wymień gotówkę w <b>💰 Kantorze</b>.</div>':''}
      ${picked.length>=4?`<div style="background:rgba(20,30,50,0.4);border:1px solid #2a4a6a;border-radius:8px;padding:10px;margin:8px auto;max-width:520px;font-size:12px;color:#aac">
        <div style="color:#f1c40f;font-weight:700;margin-bottom:4px;text-align:center">📋 Tabela wygranych dla ${picked.length} liczb:</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center">
          ${Object.entries(PAYOUT[picked.length]||{}).sort((a,b)=>parseInt(b[0])-parseInt(a[0])).map(([hits,mult])=>`<span style="background:#0a1525;padding:4px 8px;border-radius:5px;border:1px solid #2a4a6a"><b style="color:#7ec87e">${hits} traf.</b> → <b style="color:#f1c40f">${mult}×</b> (${Math.floor(bet*mult)} żet.)</span>`).join('')}
        </div>
      </div>`:''}
      <div style="text-align:center;margin-bottom:12px;max-width:480px;margin:0 auto 12px">${grid}</div>
      <div style="text-align:center;margin-bottom:10px">
        <label style="color:#aac;font-size:13px">Stawka:</label>
        <input type="number" id="keno-bet" min="20" max="1000" value="${bet}" style="width:80px;background:#0a1525;border:1px solid #2a4a6a;color:#fff;padding:6px;border-radius:6px;margin:0 8px" oninput="window._kenoOnBet(this.value)"> <span style="color:#aac;font-size:10px">(max 1000)</span>
        <button class="cbtn" ${ok?'':'disabled'} onclick="window._kenoDraw()" style="background:${ok?'#27ae60':'#3a3a3a'};color:#fff;border:none;padding:10px 24px;border-radius:8px;font-weight:700;cursor:${ok?'pointer':'not-allowed'};margin-left:8px">🎱 LOSUJ</button>
        <button class="cbtn" onclick="window._kenoClear()" style="margin-left:8px;background:#3a3a3a">⟲ Wyczyść</button>
      </div>
      <div id="keno-result" style="text-align:center;color:#f1c40f;font-size:16px;font-weight:700;margin-top:10px;min-height:24px">${lastResult}</div>
      <div style="text-align:center;margin-top:14px"><button class="cbtn" onclick="closeOverlay()">← Wróć do kasyna</button></div>`;
  };
  window._kenoToggle=(n)=>{
    if(drawing)return;
    /* v2.0.8: jeśli poprzednia gra się skończyła (drawn ma liczby) — pierwszy klik czyści tylko drawn + lastResult,
       NIE wymuszając cleanu picked. Gracz może po prostu dodać/odjąć liczby z poprzedniego wyboru. */
    if(drawn.length>0){
      drawn=[];
      lastResult='';
    }
    const i=picked.indexOf(n);
    if(i>=0) picked.splice(i,1);
    else if(picked.length<10) picked.push(n);
    _render();
  };
  window._kenoClear=()=>{picked=[];drawn=[];lastResult='';_render();};
  window._kenoOnBet=(v)=>{const x=parseInt(v);if(!isNaN(x))bet=x;};
  window._kenoDraw=()=>{
    if(drawing||picked.length<4||picked.length>10||bet<20||bet>G.casinoChips)return;
    if(bet>1000){lastResult='⚠️ Maksymalna stawka 1000 żetonów';drawing=false;_render();return;}
    /* v2.0.27: global cooldown. v2.0.28: direct DOM żeby siatka numerów NIE była przerysowywana */
    const _now=Date.now();
    if(G._kenoCooldownUntil && _now<G._kenoCooldownUntil){
      lastResult=`⏳ Poczekaj ${((G._kenoCooldownUntil-_now)/1000).toFixed(1)}s — krupier wciąż losuje`;
      const resEl=document.getElementById('ov-content')?.querySelector('[style*="font-size:14px"][style*="min-height"]');
      if(resEl) resEl.textContent=lastResult;
      return;
    }
    G._kenoCooldownUntil = _now + 2700; /* 20 numerów * 120ms + buffer */
    drawing=true;
    G.casinoChips-=bet;
    drawn=[];
    const pool=[];for(let i=1;i<=80;i++)pool.push(i);
    // Fisher-Yates shuffle first 20
    for(let i=0;i<20;i++){const j=i+Math.floor(Math.random()*(pool.length-i));[pool[i],pool[j]]=[pool[j],pool[i]];}
    const drawList=pool.slice(0,20);
    let step=0;
    const interval=setInterval(()=>{
      drawn.push(drawList[step]);
      /* v2.0.25: dźwięk balli per liczba */
      if(typeof sfxKenoDraw==='function') sfxKenoDraw();
      step++;
      _render();
      if(step>=20){
        clearInterval(interval);
        const hits=picked.filter(n=>drawn.includes(n)).length;
        const mult=PAYOUT[picked.length]?.[hits]||0;
        const win=Math.floor(bet*mult);
        G.casinoChips+=win;
        G.casinoStats=G.casinoStats||{};
        G.casinoStats.kenoPlayed=(G.casinoStats.kenoPlayed||0)+1;
        if(win>0)G.casinoStats.kenoWon=(G.casinoStats.kenoWon||0)+1;
        if(win>(G.casinoStats.biggestWin||0))G.casinoStats.biggestWin=win;
        G.casinoStats.totalWon=(G.casinoStats.totalWon||0)+win;
        G.casinoStats.totalLost=(G.casinoStats.totalLost||0)+bet;
        lastResult=win>0?`🎯 Trafień: ${hits}/${picked.length}. Mnożnik ${mult}× → +${win} żetonów!`:`Trafień: ${hits}/${picked.length} — niewystarczająco`;
        /* v2.0.25: JACKPOT przy mnożniku ≥100× (pełna ścieżka pick), BigWin ≥10×, cash ≥1× */
        if(mult>=100){ if(typeof sfxJackpot==='function')sfxJackpot(); if(typeof confetti==='function')confetti(50); }
        else if(mult>=10){ if(typeof sfxBigWin==='function')sfxBigWin(); }
        else if(mult>=1){ if(typeof sfxCash==='function')sfxCash(); }
        drawing=false;
        if(typeof saveGameSilent==='function')saveGameSilent();
        _render();
      }
    },120);
  };
  _render();openOverlay();
};

/* ═══════════════════════════════════════════════════════════════════
   v1.9.93: DAILY WHEEL OF FORTUNE — darmowy spin raz dziennie. Bez stawki.
   Nagrody losowane z 8 segmentów (regular: kasa/żetony/XP/sława/drobna kasa).
   VIP wersja: 5× lepsze nagrody, wymaga 1 piętra kasyna.
   ═══════════════════════════════════════════════════════════════════ */
window.openDailyWheel=(isVip)=>{
  const lastSpin = (isVip?G._lastVipDailyWheel:G._lastDailyWheel)||-1;
  const available = lastSpin !== G.day;
  /* Nagrody — 8 segmentów */
  /* v2.0.15: REBALANS — daily wheel ma być "smaczkiem", nie game-breakerem.
     Regular: średnio ~53 zł + 6ż + drobne /dzień. Max jackpot 250 zł.
     VIP: średnio ~76 zł + 19ż + drobne /dzień. Max jackpot 500 zł.
     Wcześniej (v1.9.93-v2.0.14): VIP jackpot 25k zł — psuło ekonomię. */
  const REWARDS_REGULAR = [
    {type:'money',  amt:40,   label:'+40 zł',     em:'💰', color:'#27ae60'},
    {type:'chips',  amt:15,   label:'+15 żetonów',em:'🎟️', color:'#f1c40f'},
    {type:'xp',     amt:35,   label:'+35 XP',     em:'⭐', color:'#3498db'},
    {type:'money',  amt:80,   label:'+80 zł',     em:'💵', color:'#e74c3c'},
    {type:'chips',  amt:30,   label:'+30 żetonów',em:'🎰', color:'#9b59b6'},
    {type:'fame',   amt:1,    label:'+1 sławy',   em:'✨', color:'#1abc9c'},
    {type:'money',  amt:50,   label:'+50 zł',     em:'💸', color:'#e67e22'},
    {type:'jackpot',amt:250,  label:'+250 zł',    em:'🏆', color:'#ffd700'},
  ];
  const REWARDS_VIP = [
    {type:'money',  amt:150,  label:'+150 zł',     em:'💰', color:'#27ae60'},
    {type:'chips',  amt:50,   label:'+50 żetonów', em:'🎟️', color:'#f1c40f'},
    {type:'xp',     amt:75,   label:'+75 XP',     em:'⭐', color:'#3498db'},
    {type:'money',  amt:150,  label:'+150 zł',     em:'💵', color:'#e74c3c'},
    {type:'chips',  amt:100,  label:'+100 żetonów',em:'🎰', color:'#9b59b6'},
    {type:'fame',   amt:2,    label:'+2 sławy',    em:'✨', color:'#1abc9c'},
    {type:'money',  amt:100,  label:'+100 zł',     em:'💸', color:'#e67e22'},
    {type:'jackpot',amt:500,  label:'+500 zł',     em:'🏆', color:'#ffd700'},
  ];
  const REWARDS = isVip ? REWARDS_VIP : REWARDS_REGULAR;
  let spinning=false, rotation=0, lastResult='', resultIdx=-1;
  const _render=()=>{
    const tier = isVip?'VIP DAILY WHEEL':'DAILY WHEEL OF FORTUNE';
    const tierColor = isVip?'#ff80c0':'#c8a520';
    const msgStatus = available ?
      `<div style="background:linear-gradient(135deg,rgba(39,174,96,.3),rgba(20,80,40,.2));border:1px solid #27ae60;border-radius:8px;padding:12px;text-align:center;color:#7eff90;font-weight:700;margin-bottom:14px">✨ DARMOWY SPIN DOSTĘPNY ✨</div>` :
      `<div style="background:linear-gradient(135deg,rgba(174,39,39,.3),rgba(80,20,20,.2));border:1px solid #aa3030;border-radius:8px;padding:12px;text-align:center;color:#ff9090;margin-bottom:14px">⏳ Wracaj jutro — spin był już użyty dziś</div>`;
    document.getElementById('ov-content').innerHTML=`
      <div style="text-align:center;padding:12px 0 6px;position:relative">
        <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:120px;height:2px;background:linear-gradient(90deg,transparent,${tierColor},transparent)"></div>
        <div style="font-size:26px;letter-spacing:5px;color:${tierColor};font-weight:900;text-shadow:0 0 22px ${tierColor}88">🎡 ${tier}</div>
        <div style="color:#aaa;font-size:11px;margin-top:6px">Darmowy spin raz dziennie · 8 nagród · bez stawki</div>
      </div>
      ${msgStatus}
      <div style="position:relative;margin:0 auto;width:fit-content">
        <canvas id="daily-wheel-cv" width="340" height="340" style="display:block;background:radial-gradient(ellipse at center,#1a0e0a 0%,#080612 100%);border-radius:50%;border:3px solid ${tierColor};box-shadow:0 0 42px ${tierColor}66,inset 0 0 22px ${tierColor}22"></canvas>
      </div>
      <div id="daily-wheel-result" style="text-align:center;margin:10px 0;font-size:16px;min-height:24px;color:${tierColor};font-weight:700;letter-spacing:1px">${lastResult}</div>
      <div style="text-align:center;margin-top:8px">
        <button class="cbtn" ${available && !spinning?'':'disabled'} onclick="window._spinDailyWheel(${isVip?'true':'false'})" style="background:${available && !spinning?'linear-gradient(135deg,#27ae60,#1abc9c)':'#3a3a3a'};color:#fff;border:none;padding:14px 36px;border-radius:10px;font-weight:800;cursor:${available && !spinning?'pointer':(spinning?'progress':'not-allowed')};letter-spacing:2px;font-size:14px">${spinning?'🌀 KRĘCI SIĘ...':'🎡 ZAKRĘĆ KOŁEM'}</button>
      </div>
      <div style="text-align:center;margin-top:14px"><button class="cbtn" onclick="closeOverlay()">← Wróć do kasyna</button></div>
    `;
    _drawWheel();
  };
  const _drawWheel=()=>{
    const c=document.getElementById('daily-wheel-cv');if(!c)return;
    const cx2=c.getContext('2d');
    cx2.clearRect(0,0,340,340);
    const ccx=170, ccy=170, r=140;
    cx2.save();
    cx2.translate(ccx,ccy);
    cx2.rotate(rotation);
    /* 8 segmentów */
    for(let i=0;i<8;i++){
      const a1=i*Math.PI/4 - Math.PI/2;
      const a2=(i+1)*Math.PI/4 - Math.PI/2;
      cx2.fillStyle=REWARDS[i].color;
      cx2.beginPath();cx2.moveTo(0,0);cx2.arc(0,0,r,a1,a2);cx2.closePath();cx2.fill();
      cx2.strokeStyle='#000';cx2.lineWidth=2;cx2.stroke();
      /* Etykieta na segmencie */
      cx2.save();
      const ma=(a1+a2)/2;
      cx2.rotate(ma);
      cx2.fillStyle='#fff';cx2.font='bold 13px Arial,sans-serif';cx2.textAlign='center';cx2.textBaseline='middle';
      cx2.strokeStyle='#000';cx2.lineWidth=3;cx2.lineJoin='round';
      /* v2.0.15: czyste labels (bez "JACKPOT"/"J:" prefixów). Skróty żetonów→ż, sławy→sł, emoji per typ. */
      const txt=REWARDS[i].em+' '+REWARDS[i].label.replace(' żetonów','ż').replace(' sławy',' sł');
      cx2.strokeText(txt, r*0.6, 0);
      cx2.fillText(txt, r*0.6, 0);
      cx2.restore();
    }
    /* Środek koła — gold pin */
    const pinG=cx2.createRadialGradient(0,-5,2,0,0,18);
    pinG.addColorStop(0,'#fff7c0');pinG.addColorStop(0.5,'#f1c40f');pinG.addColorStop(1,'#8a6a08');
    cx2.fillStyle=pinG;cx2.beginPath();cx2.arc(0,0,22,0,Math.PI*2);cx2.fill();
    cx2.strokeStyle='#5a3a08';cx2.lineWidth=1.5;cx2.stroke();
    cx2.restore();
    /* Wskaźnik (trójkąt na górze) */
    cx2.fillStyle='#fff';
    cx2.beginPath();cx2.moveTo(ccx,ccy-r+4);cx2.lineTo(ccx-12,ccy-r-14);cx2.lineTo(ccx+12,ccy-r-14);cx2.closePath();cx2.fill();
    cx2.strokeStyle='#000';cx2.lineWidth=2;cx2.stroke();
  };
  window._spinDailyWheel=(vipFlag)=>{
    if(spinning) return;
    const lastSpin2 = (vipFlag?G._lastVipDailyWheel:G._lastDailyWheel)||-1;
    if(lastSpin2===G.day){
      if(typeof showMsg==='function') showMsg('⏳ Spin już użyty — wracaj jutro!','r',3000);
      return;
    }
    spinning=true;
    /* v2.0.27: ANTI-GLITCH — set lastDailyWheel IMMEDIATELY przy starcie spinu (nie w finalize callback).
       Wcześniej gracz mógł kręcić, wyjść z overlay PRZED zakończeniem animacji (closure spinning=false reset
       po openDailyWheel ponownym), wrócić i kręcić znowu kilka razy = wielokrotny spin tego samego dnia. */
    if(vipFlag) G._lastVipDailyWheel = G.day;
    else G._lastDailyWheel = G.day;
    /* Wylosuj wynik — uniform random over 8 segments */
    resultIdx = Math.floor(Math.random()*8);
    /* Animacja: spin 5-7 pełnych obrotów + landing na segmencie */
    const fullSpins = 5 + Math.floor(Math.random()*3);
    const segAngle = Math.PI/4;
    /* Cel: środek segmentu resultIdx pod wskaźnikiem (top, czyli -PI/2 w canvas) */
    /* Po rotacji o `rotation`, segment i ma środek na (i*segAngle + segAngle/2 - PI/2 + rotation).
       Chcemy ten kąt = -PI/2 (góra), więc rotation = PI/2 - i*segAngle - segAngle/2 - PI/2 = -i*segAngle - segAngle/2 */
    const finalRotation = -resultIdx*segAngle - segAngle/2 + fullSpins*Math.PI*2;
    const startRot = rotation % (Math.PI*2);
    const totalDelta = finalRotation - startRot;
    const t0 = Date.now();
    const dur = 4500;
    /* v2.0.25: ticking sound podczas spinu Daily Wheel */
    if(typeof sfxWheelTick==='function') sfxWheelTick();
    _render();
    /* v2.0.27: _activeCasinoFinalize — gracz wychodzi w trakcie animacji = wygrana naliczona natychmiast */
    let finalized=false;
    const _finalize=()=>{
      if(finalized) return;
      finalized=true;
      spinning=false;
      const reward = REWARDS[resultIdx];
      /* Aplikuj nagrodę */
      if(reward.type==='money'){
        if(typeof earn==='function') earn(reward.amt, true);
        else G.money=(G.money||0)+reward.amt;
      } else if(reward.type==='chips'){
        G.casinoChips=(G.casinoChips||0)+reward.amt;
      } else if(reward.type==='xp'){
        if(typeof addXP==='function') addXP(reward.amt);
        else G.xp=(G.xp||0)+reward.amt;
      } else if(reward.type==='fame'){
        /* v2.1.216 [Amper]: Daily Wheel fame przez addFame() — diminishing returns + Prestige fameMult (wcześniej bypass) */
        if(typeof addFame==='function') addFame(reward.amt); else G.fame=Math.min(500,(G.fame||0)+reward.amt);
      } else if(reward.type==='jackpot'){
        if(typeof earn==='function') earn(reward.amt, true);
        else G.money=(G.money||0)+reward.amt;
        if(typeof confetti==='function') confetti(80);
        if(typeof showMsg==='function') showMsg(`🏆 JACKPOT! ${reward.label}!`,'g',6000);
        if(typeof sfxJackpot==='function') sfxJackpot();
      } else {
        if(typeof sfxCash==='function') sfxCash();
      }
      G._dailyWheelSpins = (G._dailyWheelSpins||0)+1;
      lastResult = `🎉 Wygrałeś: ${reward.em} ${reward.label}!`;
      if(typeof saveGameSilent==='function') saveGameSilent();
      if(typeof addNotif==='function') addNotif(`🎡 Daily Wheel: ${reward.em} ${reward.label}`);
      window._activeCasinoFinalize=null;
      if(document.getElementById('daily-wheel-cv')) _render();
    };
    window._activeCasinoFinalize=_finalize;
    const animate=()=>{
      if(finalized) return;
      const t = Math.min(1, (Date.now()-t0)/dur);
      /* ease-out quint — szybko startuje, długi tail */
      const e = 1 - Math.pow(1-t, 5);
      rotation = startRot + totalDelta * e;
      _drawWheel();
      if(t<1) requestAnimationFrame(animate);
      else _finalize();
    };
    requestAnimationFrame(animate);
  };
  _render();
  openOverlay();
};

