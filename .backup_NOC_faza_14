        <button onclick="window.spendSkill('${key}')" style="width:100%;background:${canUp?'#1a3a6a':'#0a0a14'};border:1px solid ${canUp?'#3498db':'#1a2a3a'};color:${canUp?'#7ec8e3':'#334'};padding:6px;border-radius:4px;cursor:${canUp?'pointer':'not-allowed'};font-size:12px;margin-bottom:6px">${isMaxed?'✓ MAX':canUp?'+ Ulepsz (1 pkt)':'Brak pkt'}</button>
        ${(isMaxed && def.powerUps) ? `
          <div style="border-top:1px solid #1a2a3a;padding-top:6px;margin-top:6px">
            <div style="font-size:10px;color:#a060c0;font-weight:700;margin-bottom:4px">⚡ POWER-UPS ${pu}/3</div>
            ${def.powerUps.map((p,i)=>{
              const owned = i < pu;
              const canBuy = !owned && i === pu && (G.money||0) >= p.cost;
              const statusIcon = owned?'✅':canBuy?'🔓':'🔒';
