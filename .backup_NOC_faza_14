      carLbl.innerHTML=`🚗 ${G.car.name}`;
      wrap.appendChild(carLbl);
    }
    // Quest target
    const tgt=_storylineTargetLoc();
    if(tgt){
      // Multi-target (firstjob): rysuj pin dla KAŻDEGO celu, gracz sam wybiera
      const targets=tgt.multi?tgt.targets:[tgt];
      /* v2.1.184: dla multi-target (firstjob 6 prac na wy=2280, blisko siebie ~320px wx step) — pełne piny z tekstem ("🚗 Myjnia") NAKŁADAŁY SIĘ. Fix: gdy multi-target → kompaktowe piny tylko emoji bez tekstu (każdy ~40px wide zamiast ~150px). User feedback "żółte paski na środku ulicy obok dripu". */
      const _compact=tgt.multi && targets.length>2;
