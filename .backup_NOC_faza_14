        ${SPOTS.map((s,i)=>`<div onclick="window.vlogClick(${i})" style="position:absolute;left:${s.x}px;top:${s.y}px;font-size:${i===idx&&!done?'44px':'32px'};cursor:pointer;opacity:${i<idx?'.25':i===idx?'1':'.5'};transition:all .25s;${i===idx&&!done?'filter:drop-shadow(0 0 8px #3498db)':''}">${s.emoji}</div>`).join('')}
