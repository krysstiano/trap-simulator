/* v2.1.228: Get current step dla NPC (default 1). */
function _dialogGetStep(npcId){
  if(!G._dialogProgress || typeof G._dialogProgress!=='object') G._dialogProgress={};
  return G._dialogProgress[npcId]?.step || 1;
}

/* v2.1.228: Sprawdź czy gracz spełnia prereq aktualnego stepu. */
function _dialogPrereqMet(npcId){
  const tree=DIALOG_TREES[npcId];
  if(!tree) return false;
  const step=_dialogGetStep(npcId);
  const node=tree.arc.find(a=>a.step===step);
  if(!node) return false;
  const p=node.prereq||{};
  if(p.day && (G.day||0)<p.day) return false;
  if(p.fame && (G.fame||0)<p.fame) return false;
  if(p.fans && (G.fans||0)<p.fans) return false;
  if(p.streetRep && (G.streetRep||0)<p.streetRep) return false;
  if(p.tracks && ((G.studioTracks||[]).filter(t=>!t.isDemo).length)<p.tracks) return false;
  if(p.friendship && (G.npcFriendship?.[npcId]||0)<p.friendship) return false;
  return true;
}

/* v2.1.228: Pick option idx → apply reward + advance step. */
window.dialogChooseOption=function(npcId, optionIdx){
  const tree=DIALOG_TREES[npcId];
  if(!tree){if(typeof showMsg==='function') showMsg('Nieznany NPC','r');return;}
  const step=_dialogGetStep(npcId);
  const node=tree.arc.find(a=>a.step===step);
  if(!node){if(typeof showMsg==='function') showMsg('Koniec historii dla tego NPC','f');return;}
  const opt=node.options[optionIdx];
  if(!opt){if(typeof showMsg==='function') showMsg('Nieprawidłowa opcja','r');return;}
  /* Apply rewards */
  if(opt.money>0){if(typeof earn==='function') earn(opt.money,false); else G.money+=opt.money;}
  if(opt.fame>0){if(typeof addFame==='function') addFame(opt.fame); else G.fame=Math.min(500,(G.fame||0)+opt.fame);}
  if(opt.fans>0){if(typeof addFans==='function') addFans(opt.fans); else G.fans=(G.fans||0)+opt.fans;}
  if(opt.streetRep>0){G.streetRep=Math.min(100,(G.streetRep||0)+opt.streetRep);}
  if(opt.xp>0 && typeof addXP==='function') addXP(opt.xp);
  if(opt.friendship>0 && typeof addFriendship==='function') addFriendship(npcId, opt.friendship);
  /* Advance step + history */
  if(!G._dialogProgress) G._dialogProgress={};
  if(!G._dialogProgress[npcId]) G._dialogProgress[npcId]={step:1, choices:[]};
  G._dialogProgress[npcId].choices.push({step, option:optionIdx, day:G.day});
  G._dialogProgress[npcId].step=step+1;
  /* Notify */
  const _gains=[];
  if(opt.money) _gains.push(`+${opt.money} zł`);
  if(opt.fame) _gains.push(`+${opt.fame} sławy`);
  if(opt.fans) _gains.push(`+${opt.fans} fanów`);
  if(opt.streetRep) _gains.push(`+${opt.streetRep} rep`);
  if(opt.friendship) _gains.push(`+${opt.friendship} przyjaźni`);
  if(opt.xp) _gains.push(`+${opt.xp} XP`);
  if(typeof notify==='function') notify(`💬 ${tree.npcName}: rozmowa ${step}/${tree.arc.length} — ${_gains.join(', ')||'+1 wspomnienie'}`);
  /* Cinematic dla finału (step 5) */
  if(step>=tree.arc.length && typeof showMilestoneCinematic==='function'){
    showMilestoneCinematic({emoji:tree.em, title:'STORY ARC COMPLETE', subtitle:tree.npcName, tagline:'Twoja relacja dotarła do finału. Pamiętasz każdy moment.', accentColor:'#e91e8c', accent2:'#9b59b6', duration:5000});
  }
  /* v2.1.228 audit-fix #40: checkAchievements trigger po dialog choice (story_marcin/kamil/producent/all). Bez tego achievementy nie odblokowywałyby się natychmiast — dopiero przy kolejnym daily tick. */
  if(typeof checkAchievements==='function') checkAchievements();
  if(typeof renderPhoneStories==='function') renderPhoneStories();
  if(typeof saveGameSilent==='function') saveGameSilent();
};

