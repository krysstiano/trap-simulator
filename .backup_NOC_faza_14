  /* v1.9.28: Hater penalty — marki unikają toksycznych. Cap -30% successChance. */
  const _haterRatioSp=(G.haters||0)/Math.max(1,G.followers);
  const _haterPenalty=Math.min(0.3, _haterRatioSp*1.5);
  const successChance=Math.min(0.9, 0.4 + Math.min(0.5, G.followers/2000) - _haterPenalty);
  G.energy=Math.max(0,(G.energy||0)-15);
