        <div style="font-size:11px;color:#556;margin-bottom:6px;line-height:1.4">${def.desc}</div>
        ${currentEffStr}${nextEffStr}
        <div style="background:#0a0a14;border-radius:4px;height:6px;margin-bottom:6px;overflow:hidden"><div style="width:${pct}%;height:100%;background:${isMaxed?'#f1c40f':'#3498db'};border-radius:4px"></div></div>
