function buildMaps(){
  // Ulica (90x75 tiles) — trzy drogi + skrzyżowania V1/V2/V3
  const ru=ROOMS.ulica;ru.map=[];
  for(let r=0;r<ru.hT;r++){
    ru.map.push([]);
    for(let c=0;c<ru.wT;c++){
      const isH1=r>=8&&r<=11;
      const isH2=r>=40&&r<=43;
      const isH3=r>=60&&r<=63; // H3 na pełnej szerokości mapy
      const isV1=c>=16&&c<=19;
      const isV2=c>=46&&c<=49;
      const isV3=c>=72&&c<=75; // V3 idzie pełnym pionem
      const isRoad=isH1||isH2||isH3||isV1||isV2||isV3;
      const isSideH1=(r===6||r===7||r===12||r===13);
      const isSideH2=(r===38||r===39||r===44||r===45);
      const isSideH3=(r===58||r===59||r===64||r===65); // H3 chodnik pełna szerokość
      const isSideV=((c===14||c===15||c===20||c===21||c===44||c===45||c===50||c===51)&&!isRoad)||
                    ((c===70||c===71||c===76||c===77)&&!isRoad); // V3 sidewalk pełnym pionem
      let t;
      // Park: ROZSZERZONY — pełna szerokość Z1 (do lewej krawędzi mapy), c=0-13, r=18-25 (14×8 kafli).
      // Pixel: x=0-672, y=864-1200.
      const inParkBox = !isRoad && !(isSideH1||isSideH2||isSideH3||isSideV) && r>=18 && r<=25 && c>=0 && c<=13;
      const isPark = inParkBox; // pełen prostokąt — bez okrągłego kształtu
      // Ścieżka — od chodnika V1 (c=13) w lewo do c=2 (sklepów), centralny rząd r=21
      const pathYAt = c => 21 + Math.round(Math.sin((c-2)*0.55)*1.4);
      const isParkPath = isPark && (r===pathYAt(c) || r===pathYAt(c)+1);
      // Wejście — przerwa w płocie od strony V1 chodnika (wschód), c=13, r=21-22
      const isParkEntrance = isPark && c===13 && (r===21||r===22);
      const isFlowerBed = isPark && (
        (r===18&&c===0) || (r===18&&c===13) ||
        (r===25&&c===0) || (r===25&&c===13)
      );
      // Strefy commercial (Z2, Z3, Z4) między chodnikami = ciemny miejski "concrete/podjazd"
      // żeby między blokami NIE widać zielonej trawy.
      // Dolny pas (r>=66): Z3 (Drip District S — Balenciaga/Bottega/Dior/Prada) też commercial,
      //   ale Z1/Z2/Z4 zostają zielone bo to apartamenty mieszkalne (apt_basic/penthouse/premium).
      const inCommercialZone = (c>=22 && c<=43) || (c>=52 && c<=69) || (c>=78 && c<=89);
      const inMidCentral = r>=14 && r<=37;       // między H1 (12-13) i H2 (38-39)
      const inMidH2H3 = r>=46 && r<=57;          // między H2 (44-45) i H3 (58-59) — Drip N strefa
      const inDripSouth = r>=66 && (c>=52 && c<=69); // dolny pas tylko Z3 (Drip S)
      const isUrbanFiller = !isRoad && !(isSideH1||isSideH2||isSideH3||isSideV)
                            && ((inCommercialZone && (inMidCentral||inMidH2H3)) || inDripSouth);
      if(isRoad){t='road';}
      else if(isSideH1||isSideH2||isSideH3||isSideV){t='side';}
      else if(isParkPath){t='sand';}
      else if(isFlowerBed){t='flowerbed';}
      else if(isPark){t='park';}
      else if(r<=1||r>=73){t='gdark';}
      else if(isUrbanFiller){t='urban';}
      else{t='grass';}
      ru.map[r].push(t);
    }
  }
  // Mieszkanie (Traphouse)
  const rm=ROOMS.mieszkanie;rm.map=[];
  for(let r=0;r<rm.hT;r++){rm.map.push([]);for(let c=0;c<rm.wT;c++)rm.map[r].push(r<2?'wallp':'wood');}
  // Apartament Premium
  const rmp=ROOMS.mieszkanie_premium;rmp.map=[];
  for(let r=0;r<rmp.hT;r++){rmp.map.push([]);for(let c=0;c<rmp.wT;c++)rmp.map[r].push(r<2?'wallp':'parquet');}
  // Penthouse Lux
  const rml=ROOMS.mieszkanie_lux;rml.map=[];
  for(let r=0;r<rml.hT;r++){rml.map.push([]);for(let c=0;c<rml.wT;c++)rml.map[r].push(r<2?'wallp_lux':'marble');}
  // Siłownia
  const rs=ROOMS.silownia;rs.map=[];
  for(let r=0;r<rs.hT;r++){rs.map.push([]);for(let c=0;c<rs.wT;c++)rs.map[r].push(r<2?'wallp':'gym');}
  // Studio Projektowania (merch_studio)
  const rms=ROOMS.merch_studio;rms.map=[];
  for(let r=0;r<rms.hT;r++){rms.map.push([]);for(let c=0;c<rms.wT;c++)rms.map[r].push(r<2?'wallp':'parquet');}
  // Studio
  const rst=ROOMS.studio;rst.map=[];
  for(let r=0;r<rst.hT;r++){rst.map.push([]);for(let c=0;c<rst.wT;c++)rst.map[r].push(r<2?'wallp':'wood');}
  // Kasyno — bordowy dywan z złotym wzorem
  const rcas=ROOMS.casino;rcas.map=[];
  for(let r=0;r<rcas.hT;r++){rcas.map.push([]);for(let c=0;c<rcas.wT;c++)rcas.map[r].push(r<2?'wallp':'casino_carpet');}
  /* v1.9.91: Kasyno VIP — premium 1 piętro */
  /* v2.0.11: Casino VIP — premium 2-warstwowa podłoga.
     - r<2: wallp_lux (ściany)
     - r=2-3 środek: vip_carpet (czerwony chodnik z gold pattern dla wejścia)
     - reszta: vip_marble (czarno-gold marble) */
  const rcvip=ROOMS.casino_vip;rcvip.map=[];
  for(let r=0;r<rcvip.hT;r++){
    rcvip.map.push([]);
    for(let c=0;c<rcvip.wT;c++){
      let tile;
      if(r<2) tile='wallp_lux';
      else if(r>=10 && r<=12 && c>=10 && c<=14) tile='vip_carpet'; /* czerwony dywan na wejściu (środek-dół) */
      else tile='vip_marble';
      rcvip.map[r].push(tile);
    }
  }
  /* v1.9.95: Winda — większy interior z lux floor + walls (16×11 zamiast 8×7) */
  const relev=ROOMS.elevator;relev.map=[];
  for(let r=0;r<relev.hT;r++){relev.map.push([]);for(let c=0;c<relev.wT;c++)relev.map[r].push(r<3?'wallp_lux':'marble');}
}

