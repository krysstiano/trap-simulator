// v1.9.12: Debounce saveGameSilent — wcześniej 18 callsitów + auto-save co 30s = częste JSON.stringify 20KB G state w click handlerach
let _saveGameDebTimer=null;
function _saveGameImmediate(){
  /* v1.9.22: skip save w trakcie minigry/snu/odpoczynku (half-applied state risk: pending debounce mógł firowac PO wejściu w mg) */
  if(typeof mgOpen==='function' && mgOpen()) return false;
  if(typeof sleepInterval!=='undefined' && sleepInterval) return false;
  if(typeof _restTimer!=='undefined' && _restTimer) return false;
  try{
    const payload=_saveSnapshot();
    /* v1.9.22: rolling backup — _prev. v1.9.97: ROZSZERZONE — zapis do _prev1...prev5 (rolling 5 backupów). */
    try{
      const _old=localStorage.getItem(SAVE_KEY);
      if(_old){
        /* Shift: prev4→prev5, prev3→prev4, prev2→prev3, prev1→prev2, _prev→prev1 */
        for(let i=4;i>=1;i--){
          const src=localStorage.getItem(SAVE_KEY+'_prev'+i);
          if(src) localStorage.setItem(SAVE_KEY+'_prev'+(i+1),src);
        }
        const oldPrev=localStorage.getItem(SAVE_KEY+'_prev');
        if(oldPrev) localStorage.setItem(SAVE_KEY+'_prev1',oldPrev);
        localStorage.setItem(SAVE_KEY+'_prev',_old);
      }
    }catch(e){}
    localStorage.setItem(SAVE_KEY,payload);
    flashAutoSaveIcon();
    if(_saveFileHandle) writeToFileHandle(payload).catch(()=>{});
    return true;
  }catch(e){
    /* v1.9.52: detect quota error i zaproponuj plik (audyt auto-save) */
    if(e&&e.name==='QuotaExceededError'){
      showMsg('💾 Pamięć przeglądarki pełna! Zapisz grę do pliku w menu (chroni postęp).','r');
      try{localStorage.removeItem(SAVE_KEY+'_prev');}catch(_){}
    } else {
      showMsg('⚠️ Auto-zapis nie działa: '+e.message,'r');
    }
    return false;
  }
}
function saveGameSilent(){
  // Debounce: ostatnie wywołanie w oknie 800ms wygrywa, kasuje poprzednie
  if(_saveGameDebTimer){clearTimeout(_saveGameDebTimer);}
  _saveGameDebTimer=setTimeout(()=>{_saveGameImmediate();_saveGameDebTimer=null;},800);
