// ─── WORLD TOUR ──
function runTourDay(){
  if(!G._tourActive) return;
  const t=G._tourActive;
  /* v2.1.232: typed tour — 'worldtour' (Marcin), 'coachella' (3d festival), 'megastar' (7d). Per type label/finishing msg. */
  const _type = t.type || 'worldtour';
  const _emoji = _type==='coachella' ? '🎪' : '🌍';
  const _typeLabel = _type==='coachella' ? 'COACHELLA' : _type==='megastar' ? 'MEGASTAR WORLD TOUR' : 'WORLD TOUR';
  // Tour ukończona — finalizacja po ostatnim mieście
  if(t.day>=t.cities.length){
    /* v2.1.50 Amper: nerf bonusu końcowego (0.5→0.2 totalEarned, 0.3→0.15 totalFans). */
    const completionBonus=Math.floor((t.totalEarned||0)*0.2);
    const completionFans=Math.floor((t.totalFans||0)*0.15);
    /* v2.1.98: Prestige moneyMult przez earn() + Prestige fameMult przez addFame(). */
    if(completionBonus>0){if(typeof earn==='function')earn(completionBonus,false);else{G.money+=completionBonus;G.totalEarned=(G.totalEarned||0)+completionBonus;}}
    if(completionFans>0){G.followers+=completionFans;}
    showMsg(`${_emoji} ${_typeLabel} ZAKOŃCZONA! ${t.cities.length} ${_type==='coachella'?'dni':'miast'}, +${t.totalEarned.toLocaleString('pl')} zł + bonus ${completionBonus.toLocaleString('pl')} zł + ${completionFans.toLocaleString('pl')} obserwujących. Jesteś legendą!`);
    addNotif(`${_emoji} ${_typeLabel} ukończona!`);
    addFame(_type==='megastar'?25:_type==='coachella'?12:15); /* megastar 25, coachella 12, worldtour 15 */
    /* v2.1.235: trackery ukończonych multi-day eventów (achievement coachella_played / megastar_complete). */
    if(_type==='coachella') G._coachellaPlayed=(G._coachellaPlayed||0)+1;
    else if(_type==='megastar') G._megastarComplete=(G._megastarComplete||0)+1;
    G._tourActive=null;
    confetti(60);
    return;
  }
  const city=t.cities[t.day];
  if((G.energy||0)<15){
    showMsg(`⚡ Za mało energii (potrzeba 15) — trasa wstrzymana w ${city}. Odpocznij i wróć by kontynuować.`,'r');
    return;
  }
  G.energy=Math.max(0,G.energy-15);
  /* v2.1.50 Amper: NERF zarobków per miasto. v2.1.232: typed earnMin/Max z venue (Coachella 4000-9000, Megastar 10000-22000), Marcin World Tour zachowuje legacy 3000-7500. */
  const mult=1+t.day*0.15;
  const _baseMin = t.earnMin || 3000;
  const _baseMax = t.earnMax || 7500;
  /* v2.1.203 [Amper]: tour cinematic przeniesiony do endConcert (post-minigame). */
  startConcertMG(`${_emoji} ${_typeLabel}: ${city} (${t.day+1}/${t.cities.length})`, 0, 0, Math.round(_baseMin*mult), Math.round(_baseMax*mult));
}

