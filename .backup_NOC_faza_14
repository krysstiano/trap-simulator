  tour_magnate:{name:'Tour Magnate',emoji:'🌍',desc:'+15% concert earnings',cost:1},
};
/* Helper functions dla perks */
function hasPrestigeSkill(key){return !!(G.prestigeSkills && G.prestigeSkills[key]);}
/* v2.1.229: nerf tour_magnate 1.15→1.10, diamond_hands 1.10→1.05 (concert balance refactor). Inne skille bez zmiany. */
function getPrestigeSkillMult(key){return hasPrestigeSkill(key) ? {studio_mogul:1.10,cult_following:1.20,iron_discipline:0.85,diamond_hands:1.05,legend_status:1.08,tour_magnate:1.10}[key] : 1;}
window.buyPrestigeSkill=(key)=>{
  if(!PRESTIGE_SKILLS[key]){return;}
