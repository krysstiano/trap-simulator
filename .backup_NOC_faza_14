/* v2.1.226: Beef system — diss tracki. Reuse CHART_NPCS jako rivals.
   Player score: random 50-100 + Crown +15 + drip 100+ +10. NPC score: random 40-90 + power gap modifier.
   Cooldowns: 7 dni global, 30 dni same NPC, max 5 beefs per NPC.
   Effects win: 5-15% NPC fans converted to player + 10-30 fame. Loss: +50 hejterzy, -5 fame, -20 mood. */
window.startBeef=function(npcId){
  if(typeof CHART_NPCS==='undefined'){if(typeof showMsg==='function') showMsg('⚠️ Chart NPCs nie dostępne','r');return;}
  const npc=CHART_NPCS.find(n=>n.id===npcId);
  if(!npc){if(typeof showMsg==='function') showMsg('⚠️ Nieznany rival','r');return;}
  /* Gating: fame 100+ */
  if((G.fame||0)<100){if(typeof showMsg==='function') showMsg('🔒 Beef wymaga 100 sławy minimum','r');return;}
  /* Cooldown global 7 dni */
  if((G._lastBeefDay||0)>0 && (G.day-G._lastBeefDay)<7){
    const _left=7-(G.day-G._lastBeefDay);
    if(typeof showMsg==='function') showMsg(`⚠️ Cooldown beef — następny za ${_left} ${_left===1?'dzień':'dni'}`,'r');return;
  }
  /* Per-NPC max 5 */
  const _count=(G.beefNpcCount||{})[npcId]||0;
  if(_count>=5){if(typeof showMsg==='function') showMsg('⚠️ Beefowałeś tego NPC 5 razy — wystarczy','r');return;}
  /* Per-NPC cooldown 30 dni (sprawdź ostatni beef przeciw temu NPC) */
  const _lastSameNpc=(G.beefHistory||[]).filter(b=>b.npcId===npcId).slice(-1)[0];
  if(_lastSameNpc && (G.day-_lastSameNpc.day)<30){
    const _left=30-(G.day-_lastSameNpc.day);
    if(typeof showMsg==='function') showMsg(`⚠️ Ostatni beef z ${npc.name} ${30-(_left)} dni temu. Czekaj jeszcze ${_left} dni`,'r');return;
  }
  /* Scoring */
  let playerScore=50+Math.floor(Math.random()*51); // 50-100
  if(G.outfit?.top==='crown_of_hh') playerScore+=15;
  if((G.drip||0)>=100) playerScore+=10;
  playerScore=Math.min(120, playerScore); // cap
  let npcScore=40+Math.floor(Math.random()*51); // 40-90
  /* Power gap modifier: jeśli NPC ma fame > player +50, NPC dostaje +20 score (heavyweight beef hard) */
  const _npcCur=(typeof _chartNpcGetCurrent==='function')?_chartNpcGetCurrent(npc):{fame:npc.fameBase,fans:npc.fansBase};
  if(_npcCur.fame > (G.fame||0)+50) npcScore+=20;
  /* Compare */
  const won=playerScore>npcScore;
  /* Effects */
  let fansChange=0, fameChange=0, hatersChange=0, moodChange=0;
  if(won){
    /* Win: convert 5-15% NPC fans + 10-30 fame */
    const _convertPct=0.05+Math.random()*0.10;
    fansChange=Math.floor(_npcCur.fans*_convertPct/100); // /100 bo NPC fans są w milionach
    fansChange=Math.min(fansChange, 50000); // cap dla balansu
    fameChange=10+Math.floor(Math.random()*21); // 10-30
    if(typeof addFans==='function') addFans(fansChange);
    if(typeof addFame==='function') addFame(fameChange); else G.fame=Math.min(500,(G.fame||0)+fameChange);
  } else {
    /* Loss: +50 hejterzy, -5 fame, -20 mood */
    hatersChange=50;
    G.haters=(G.haters||0)+hatersChange;
    fameChange=-5;
    G.fame=Math.max(0,(G.fame||0)-5);
    moodChange=-20;
    G.stress=Math.max(0,(G.stress||0)-20);
  }
  /* Save history + cooldowns */
  if(!Array.isArray(G.beefHistory)) G.beefHistory=[];
  G.beefHistory.push({npcId, npcName:npc.name, day:G.day, result:won?'win':'loss', playerScore, npcScore, fansChange, fameChange, hatersChange, moodChange});
  if(G.beefHistory.length>50) G.beefHistory=G.beefHistory.slice(-50);
  G._lastBeefDay=G.day;
  if(!G.beefNpcCount||typeof G.beefNpcCount!=='object') G.beefNpcCount={};
  G.beefNpcCount[npcId]=(_count||0)+1;
  /* Notify + cinematic dla big wins */
  if(won){
    if(typeof notify==='function') notify(`🥊 BEEF WIN! Pokonałeś ${npc.emoji} ${npc.name} (${playerScore} vs ${npcScore})! +${fansChange.toLocaleString('pl')} fanów, +${fameChange} sławy.`);
    if(typeof addNotif==='function') addNotif(`🥊 BEEF WIN vs ${npc.name} (${playerScore}-${npcScore})`);
    if(fameChange>=25 && typeof showMilestoneCinematic==='function'){
      showMilestoneCinematic({emoji:'🥊',title:'BEEF WIN!',subtitle:`vs ${npc.name}`,tagline:`${playerScore} vs ${npcScore} · +${fansChange.toLocaleString('pl')} fanów · +${fameChange} sławy`,accentColor:'#e91e8c',accent2:'#f1c40f',duration:5000});
    }
  } else {
    if(typeof notify==='function') notify(`🥊 BEEF LOSS! ${npc.emoji} ${npc.name} cię zniszczył (${playerScore} vs ${npcScore}). +${hatersChange} hejterzy, -5 sławy, -20 nastrój.`,'r');
    if(typeof addNotif==='function') addNotif(`🥊 BEEF LOSS vs ${npc.name} (${playerScore}-${npcScore})`);
  }
  /* Cleanup + refresh */
  document.getElementById('beef-modal')?.remove();
  document.getElementById('beef-modal-bd')?.remove();
  if(typeof renderPhoneBeef==='function') renderPhoneBeef();
  if(typeof saveGameSilent==='function') saveGameSilent();
};

