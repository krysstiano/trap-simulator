const NPC_COOLDOWN_MS = 20000; // 20s cooldown per NPC option

function openNPCDialogue(type){
  const data=NPC_DATA[type];if(!data) return;
  /* v1.9.79/v1.9.86: zaliczenie pending SMS visit przy podejściu.
     Mapping NPC_DATA → SMS_CONTACTS (vendor=zbyszek, fan=fan, crew=crew, etc.) */
  /* v2.1.116: Wave 4 W35 — dodane mapowanie quest→wiktor (wcześniej SMS od Wiktora nigdy nie firował). */
  const _smsKey={vendor:'zbyszek',fan:'fan',crew:'crew',marcin:'marcin',kamil:'kamil',producent:'producent',quest:'wiktor',booking:'marcin',manager:'kamil'}[type]||type;
  if(typeof window._smsCheckPendingVisit==='function') window._smsCheckPendingVisit(_smsKey);
  const dlg=document.getElementById('npc-dlg');
  // Wyciagnij emoji z poczatku name (np. "😊 Twój fan" -> "😊")
  const emoMatch=data.name.match(/^(\p{Extended_Pictographic}|[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}])+/u);
  dlg.dataset.emoji=emoMatch?emoMatch[0]:'👤';
  // Bez emoji w nazwie (avatar je zawiera)
  const cleanName=emoMatch?data.name.replace(emoMatch[0],'').trim():data.name;
  document.getElementById('npc-dlg-name').textContent=cleanName;
  const line=data.lines[rnd(0,data.lines.length-1)];
  document.getElementById('npc-dlg-text').textContent='"'+line+'"';
  const optsDiv=document.getElementById('npc-dlg-opts');
  optsDiv.innerHTML='';
  data.opts.forEach((opt,i)=>{
    if(opt.cond && !opt.cond()) return;
    const key=`${type}_${i}`;
    const lastUsed=npcCooldowns[key]||0;
    const now=Date.now();
    const optText=typeof opt.text==='function'?opt.text():opt.text;
    // v1.8.16: BEZ cooldown dla akcji info-only (Sprawdź ekipę, Wyjdź, Nie teraz, Nie interesuje mnie)
    const onCooldown=now-lastUsed<NPC_COOLDOWN_MS&&optText!=='Wyjdź'&&optText!=='Nie teraz'&&optText!=='Nie interesuje mnie'&&optText!=='Sprawdź ekipę';
    const btn=document.createElement('button');btn.className='npc-opt';
    btn.textContent=onCooldown?`${optText} (${Math.ceil((NPC_COOLDOWN_MS-(now-lastUsed))/1000)}s)`:optText;
    btn.disabled=onCooldown;
    btn.style.opacity=onCooldown?'.45':'1';
    // v1.8.16: NIE ustawiaj cooldown dla akcji info-only (jak Sprawdź ekipę)
    // v1.9.16: BUG FIX — cooldown po fn() z guardem opt.fn().__noCooldown. Wcześniej "Za mało kasy" błąd dawał 20s cooldown chociaż nic się nie wydarzyło.
    btn.onclick=()=>{
      const noCooldownTexts=['Wyjdź','Nie teraz','Nie interesuje mnie','Sprawdź ekipę'];
      // Zapamiętaj money/energy/streetRep PRZED akcją — jeśli żaden się nie zmienił, prawdopodobnie był "Za mało kasy" error i nie chcemy cooldownu
      const _beforeMoney=G.money,_beforeEnergy=G.energy;
      opt.fn();
      const _changed=(G.money!==_beforeMoney)||(G.energy!==_beforeEnergy);
      if(!noCooldownTexts.includes(optText) && _changed) npcCooldowns[key]=Date.now();
    };
    optsDiv.appendChild(btn);
  });
  dlg.classList.add('on');
}

// ═══════════════════════════════════════════════════════════════════
//  DECAY
// ═══════════════════════════════════════════════════════════════════
let lastDecay=Date.now();
function tickDecay(){
  if(_paused) return;
  // Admin: freeze statystyk — zatrzymaj decay hunger/energy/health/stress
  if(G._adminFreezeStat){lastDecay=Date.now();return;}
  /* v1.9.26: BUG FIX — tickDecay drenuje statystyki PODCZAS snu. sleepInterval ma własne drain (200ms tick), więc tickDecay przy 6s daje double drain. */
  if(typeof sleepInterval!=='undefined' && sleepInterval){lastDecay=Date.now();return;}
  const now=Date.now();
  if(isOverlayOpen()){lastDecay=now;return;}
  if(now-lastDecay<CFG.decayInterval) return;
  lastDecay=now;

  const fitFactor=1-Math.floor(G.fitness/25)*0.05; // max -20% decay at fitness 100 (legacy — uzyte w hunger)
  const kondLvl=(G.skills&&getSkillLvl('kondycja')||0);
  // v2.1.29: kondycja PU faktycznie aplikowane (wcześniej GHOST). PU1=-3, PU2=-6, PU3=-10 → kumulacja -19%
  const kondPU=(typeof _pu==='function'?_pu('kondycja'):0);
  const kondPUBonus=kondPU>=3?0.19:(kondPU===2?0.09:(kondPU===1?0.03:0));
  const kondMult=1-(kondLvl*0.08)-kondPUBonus; // Główne drzewko: -8% spadku energii / pkt + PU
  const apetMult=getApetytMult(); // F3-FIX-B: skill+PU+evo (max -50% przy evo)
  // FORMA → ENERGIA: delikatna mechanika -5% spadku energii przy formie 100 (liniowo)
  const formaEnergyMult=1-(G.forma||0)/100*0.05; // 0→1.0, 100→0.95
  // KONDYCJA → ZDROWIE: delikatna mechanika -5% spadku zdrowia przy kondycji 100 (liniowo)
  const fitnessHealthMult=1-(G.fitness||0)/100*0.05; // 0→1.0, 100→0.95
  G.hunger=clampStat('hunger', G.hunger-Math.ceil(CFG.hungerDecay*fitFactor*apetMult));
  /* v2.1.164: Iron Discipline FIX — `Math.ceil(2*0.85)=Math.ceil(1.7)=2` neutralizowało skill (zero efektu).
     Naprawa: probabilistic skip — Iron Discipline daje 15% szansę że tick nie odejmuje energii.
     Średnio = -15% drain over time, ale każdy tick jest integer (zachowuje precision). */
  const _ironDisciplineSkip = (typeof hasPrestigeSkill==='function' && hasPrestigeSkill('iron_discipline')) && Math.random()<0.15;
  const _energyDrain = _ironDisciplineSkip ? 0 : Math.ceil(CFG.energyDecay*formaEnergyMult*kondMult);
  G.energy=clampStat('energy', G.energy-_energyDrain);
  // Kondycja 5 → passive energy regen (z głównego drzewka)
  // v1.8.96: Evolution "Pasywna regeneracja" (Kondycja evo) — REALNIE aplikowane: szybsza regen 5%→20% chance, +2 zamiast +1
  if((typeof _evo==='function'&&_evo('kondycja'))&&G.energy<getMaxStat('energy')&&Math.random()<0.20){
    G.energy=Math.min(getMaxStat('energy'),G.energy+2);
  } else if(kondLvl>=5&&G.energy<getMaxStat('energy')&&Math.random()<0.05){
    G.energy=Math.min(getMaxStat('energy'),G.energy+1);
  }

  if(G.hunger<=0||G.energy<=0){
    const odpMult=getOdpornoscMult(); // F3-FIX-B: skill+PU+evo (max -50% przy evo)
    G.health=clampStat('health', G.health-Math.ceil(CFG.healthDecayAmt*odpMult*fitnessHealthMult));
    if(G.hunger<=0) showMsg('⚠️ GŁÓD! Tracisz zdrowie! Idź do sklepu lub restauracji!','r');
    if(G.energy<=0) showMsg('⚠️ WYCZERPANIE! Idź spać natychmiast!','r');
  }

  /* v2.1.26: PRZEJEDZENIE — TYLKO decay (kary są natychmiastowe w eatFood).
     v2.1.30: decayInterval 7.2s → ~8.3 ticki/min real, 0.3/tick = ~2.5 pkt/min real. */
  if(typeof G.overeat !== 'number') G.overeat = 0;
  if(G.overeat > 0){
    G.overeat = Math.max(0, G.overeat - 0.3);
  }
  // F5.4 E3: Mróz (śnieg/mgła) na ulicy = -1 zdrowia co 30s, kurtka zimowa redukuje 85%
  if(currentRoom==='ulica' && (G.weather===3||G.weather===4||G.weather===5)){
    G._frostTick = (G._frostTick||0)+1;
    if(G._frostTick >= 5){ // co 5 ticków decay (30s)
      G._frostTick = 0;
      const winterCoatMult = (G.outfit && (G.outfit.top==='zimowa')) ? 0.15 : 1.0;
      const jeansowaMult = (G.outfit && (G.outfit.top==='jeansowa')) ? 0.5 : 1.0;
      const frostDmg = Math.ceil(1 * winterCoatMult * jeansowaMult);
      if(frostDmg > 0){
        G.health = clampStat('health', G.health-frostDmg);
        if(G.health<50 && Math.random()<0.3) showMsg('🥶 Mróz wyziębił cię! Załóż kurtkę zimową.','r');
      }
    }
  }
  if(G.health<=25&&G.health>0){
    const msgs=['❤️ KRYTYCZNE ZDROWIE! Idź do szpitala!','🏥 Zdrowie poniżej 25%! Potrzebujesz pomocy!','❗ Umierasz! Szpital lub jedz!'];
    if(Math.random()<0.4) showMsg(msgs[Math.floor(Math.random()*msgs.length)],'r');
    /* v2.1.123: Wave 6 W65 — pulsing HP bar + audio cue + once-per-state cinematic. */
    if(!G._lowHpWarning){
      G._lowHpWarning=true;
      try{
        const _hpEl=document.getElementById('hhealth');
        if(_hpEl){_hpEl.style.animation='hpPulse 0.8s ease-in-out infinite';_hpEl.style.textShadow='0 0 8px #e74c3c';}
        /* Inject CSS keyframes raz */
        if(!document.getElementById('hpPulseStyle')){
          const _st=document.createElement('style');_st.id='hpPulseStyle';
          _st.textContent='@keyframes hpPulse{0%,100%{opacity:1;color:#e74c3c}50%{opacity:0.5;color:#fff}}';
          document.head.appendChild(_st);
        }
        if(typeof playDangerSound==='function') playDangerSound();
      }catch(_){}
      if(typeof showMilestoneCinematic==='function' && !G._lowHpCinematicShown){
        G._lowHpCinematicShown=true;
        showMilestoneCinematic({emoji:'❤️',title:'KRYTYCZNE ZDROWIE',subtitle:'Zdrowie poniżej 25%',tagline:'Idź do szpitala, zjedz coś lub się prześpij!',accentColor:'#e74c3c',accent2:'#c0392b',duration:3500});
      }
    }
  } else if(G._lowHpWarning && G.health>40){
    /* Reset visual jeśli HP się odbudowało */
    G._lowHpWarning=false;
    /* v2.1.137: reset _lowHpCinematicShown — wcześniej cinematic fires raz na CAŁY playthrough (nigdy nie reset). Teraz reset gdy HP odbudowane → kolejny spadek poniżej 25% pokaże cinematic znowu. */
    G._lowHpCinematicShown=false;
    try{const _hpEl=document.getElementById('hhealth');if(_hpEl){_hpEl.style.animation='';_hpEl.style.textShadow='';}}catch(_){}
  }

  G.stress=clamp(G.stress-CFG.stressDecay,0,100);
  if((G.sleepDebt||0)>=3) G.energy=clampStat('energy', G.energy-Math.floor((G.sleepDebt||0)*.5));

  /* v2.1.80 Amper: REBALANS streaming royalties — sqrt-based (zawsze rośnie, brak hard cap).
     Filozofia: gracz = raper → muzyka = main passive income. Stary system (cap 50 zł Spotify, cap 40 Tidal) zatrzymywał progres late game.
     Nowe formuły: liniowy * 0.00001 + sqrt * 0.045 (Spotify), 0.00001 + sqrt * 0.025 (Tidal — HiFi premium ale mniej słuchaczy).
     Targety dzienne: Spotify early 75/mid 1200/late 5500/maxed 17500 zł. Tidal early 30/mid 400/late 1400/maxed 3300. */
  /* v2.1.116: Wave 5 W55 — per-tick check expiration label kontraktu (global label 60 dni). Wcześniej gracz tracił dzień 70% cut przed reset. */
  let _activeLabelType=G.label.type;
  if(_activeLabelType==='global' && G.label.contractEndsDay && G.day>=G.label.contractEndsDay){
    _activeLabelType=null; /* kontrakt wygasł — pełne royalty od TEGO ticka */
  }
  const labelCut=_activeLabelType==='global'?0.3:_activeLabelType==='major'?0.5:1.0; // major 50%, global 70%
  /* v2.1.163: Prestige Skill "Studio Mogul" +10% royalties */
  const _studioMogulMult=(typeof getPrestigeSkillMult==='function')?getPrestigeSkillMult('studio_mogul'):1;
  if(G.label.type==='major'){G.spotify.listeners+=rnd(1,5);G.tidal.listeners+=rnd(0,2);}
  if(G.label.type==='global'){G.spotify.listeners+=rnd(3,8);G.tidal.listeners+=rnd(1,4);} // global +50% słuchaczy
  if(G.spotify.listeners>0){
    const r=Math.floor((G.spotify.listeners*0.000015*labelCut + Math.sqrt(G.spotify.listeners)*0.045*labelCut)*_studioMogulMult);
    if(r>0){if(typeof earn==='function')earn(r,false);else{G.money+=r;G.totalEarned=(G.totalEarned||0)+r;}G.spotify.royalties+=r;addNotif('🎵 Spotify: +'+r+' zł'+(G.label.type==='major'?' (major -50%)':''));} /* v2.1.96: Prestige moneyMult przez earn() */
  }
  if(G.tidal.listeners>0){
