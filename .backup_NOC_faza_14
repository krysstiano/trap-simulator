// ─── #64 SYSTEM RACHUNKÓW ─────────────────────────────────────────
// Rachunki generowane co 7 dni per mieszkanie. Termin 7 dni. Odsetki +10%/dzień po terminie.
// Eksmisja po 21+ dniach niepłacenia → powrót do traphouse + dług do spłaty.
const APT_RENT={traphouse:50, basic:250, premium:600, luxury:1800, mansion:5000, mega_villa:12000}; /* v2.1.159: Mansion · v2.1.215: Mega Villa 12k zł/tydzień (Tier 3 Legendary) */
function tickBills(){
  if(!G.bills) G.bills={pending:[], history:[], evicted:false};
  const apt=G.apartment||'traphouse';
  // v1.9.14: BUG FIX — czynsz pobierany za WSZYSTKIE posiadane mieszkania, nie tylko obecne (anti-OP exploit "rent out luxury, live in traphouse")
  // Owned = current + wszystkie wpisane do G._ownedApts (zakupione ale niezamieszkane)
  const _allOwned=new Set([apt]);
  if(Array.isArray(G._ownedApts)) G._ownedApts.forEach(a=>{if(a&&a!=='traphouse')_allOwned.add(a);});
  // Generowanie nowego rachunku co 7 dni (poniedziałek = G.day%7==1)
  if(G.day%7===1 && (G._lastBillDay||0)!==G.day){
    G._lastBillDay=G.day;
    for(const _apt of _allOwned){
      const _rent=APT_RENT[_apt]||50;
      // Mieszkania wynajmowane innym: właściciel płaci niższy "rachunek administracyjny" (~50% bills)
      const _isRented=G.rentals&&G.rentals[_apt]===true&&_apt!==apt;
      const _finalRent=_isRented?Math.floor(_rent*0.5):_rent;
      const _label=_isRented?'czynsz administracyjny (wynajmowany)':'czynsz';
      const bill={
        id:'rent_'+_apt+'_'+G.day,
        type:'czynsz',
        apt:_apt,
        amount:_finalRent,
        _baseAmount:_finalRent,
        dueDay:G.day+7,
        issuedDay:G.day,
        paid:false,
      };
      G.bills.pending.push(bill);
      addNotif(`📨 Nowy rachunek: ${_finalRent} zł ${_label} (${CFG.APT_NAMES[_apt]||_apt}). Termin: Dzień ${bill.dueDay}.`);
    }
    if(_allOwned.size>1 && typeof showSmartHint==='function') showSmartHint(`📨 Posiadasz ${_allOwned.size} mieszkań — wszystkie generują rachunki. Sprawdź telefon → 💸 Rachunki.`);
  }
  // #73: Naliczanie odsetek za KAŻDY dzień opóźnienia (10% kwoty bazowej/dzień)
  G.bills.pending.forEach(b=>{
    if(b.paid) return;
    if(G.day>b.dueDay){
      const overdue=G.day-b.dueDay;
      // Odsetki — naliczane raz dziennie na bazie ORYGINALNEJ kwoty (nie composite)
      if(b._lastInterestDay!==G.day){
        b._lastInterestDay=G.day;
        b._baseAmount=b._baseAmount||b.amount;
        const interest=Math.round(b._baseAmount*0.10);
        b.amount+=interest;
        b.overdue=overdue;
        if(overdue===1) showMsg(`⚠️ Rachunek "${b.type}" przeterminowany! +${interest} zł odsetek.`,'r');
        else if(overdue===3) showMsg(`🚨 Rachunek 3 dni po terminie! EKSMISJA za 2 dni — zapłać teraz!`,'r');
        else if(overdue===4) showMsg(`🚨🚨 EKSMISJA JUTRO! Ostatnia szansa — zapłać natychmiast!`,'r');
      }
    }
  });
  // #73 EKSMISJA po >5 dniach overdue (było 21) — z KAŻDEGO mieszkania (nie tylko nie-traphouse)
  const evictBill=G.bills.pending.find(b=>!b.paid && (G.day-b.dueDay)>5);
  if(evictBill && !G.bills.evicted){
    G.bills.evicted=true;
    G._evictedFromApt=G.apartment; // zachowaj do listu
    /* v1.9.58: reset apartmentu po eksmisji żeby gracz nie zachowywał bonusów (audyt apt regen) */
    if(G.apartment && G.apartment!=='traphouse') G.apartment='traphouse';
    // Wyrzucamy gracza na ulicę jeśli aktualnie jest w mieszkaniu
    if(['mieszkanie','mieszkanie_premium','mieszkanie_lux'].includes(currentRoom)){
      const sp=APT_EXIT_SPAWNS?.[G.apartment]||{wx:600,wy:500};
      changeRoom('ulica',sp.wx,sp.wy);
    }
    showMsg('🚨 EKSMISJA! Zostałeś wyrzucony z mieszkania za niepłacenie rachunków. Spłać wszystkie zaległości w telefonie (💸 Rachunki) by odzyskać dostęp.','r');
    addNotif('🚨 EKSMISJA z mieszkania!');
  }
}
window.payAllBills=()=>{
  if(!G.bills?.pending?.length) return;
  const total=G.bills.pending.reduce((s,b)=>s+b.amount,0);
  if(G.money<total){if(typeof showMsg==='function')showMsg(`💸 Brak kasy — potrzeba ${total} zł, masz ${G.money}.`,'r');return;}
  // Spłać wszystkie
  G.money-=total;
  G.bills.pending.forEach(b=>{b.paid=true;b.paidDay=G.day;G.bills.history.push(b);});
  G.bills.pending=[];
  // v1.8.56: BUG FIX — komunikat "EKSMISJA ZNIESIONA" pokazywał się ZAWSZE po payAllBills (bo evicted był właśnie ustawiony na false).
  // Teraz sprawdzamy stan PRZED zmianą.
  const _wasEvicted=!!G.bills.evicted;
  if(_wasEvicted){
    G.bills.evicted=false;delete G._evictedFromApt; /* v1.9.18: cleanup _evictedFromApt po recovery */
    /* v2.1.172: Auto-restore G.apartment do najlepszego posiadanego (zamiast wymagania manualnego "Przeprowadź się" w biurze) */
    if(typeof window._setActiveAptToBest==='function') window._setActiveAptToBest();
  }
  if(typeof showMsg==='function')showMsg(`✅ Spłacono wszystkie rachunki za ${total} zł!${_wasEvicted?' EKSMISJA ZNIESIONA — wracasz do swojego najlepszego mieszkania.':''}`,'g');
  if(typeof renderPhoneApp==='function' && document.getElementById('phone')?.classList.contains('on')){
    renderPhoneApp('bills');
  }
  if(typeof updateHUD==='function')updateHUD();
};
window.payBill=(billId)=>{
  if(!G.bills) return;
  const b=G.bills.pending.find(x=>x.id===billId&&!x.paid);
  if(!b){showMsg('Rachunek nie znaleziony.','r');return;}
  // v1.8.24: defensywna walidacja — uszkodzony save mógłby mieć b.amount=undefined → NaN poisoning G.money.
  if(typeof b.amount!=='number'||!isFinite(b.amount)||b.amount<0){
    console.error('payBill: invalid b.amount',b);
    showMsg('Uszkodzony rachunek — pomijam.','r');
    G.bills.pending=G.bills.pending.filter(x=>x.id!==billId);
    return;
  }
  if(G.money<b.amount){showMsg(`💸 Brak kasy! Potrzeba ${b.amount} zł, masz ${G.money}.`,'r');return;}
  G.money-=b.amount;
  b.paid=true;
  b.paidDay=G.day;
  G.bills.history.push(b);
  G.bills.pending=G.bills.pending.filter(x=>x.id!==billId);
  // Odblokuj eksmisję jeśli wszystkie rachunki za nie-traphouse spłacone
  if(G.bills.evicted && !G.bills.pending.some(x=>!x.paid && x.apt!=='traphouse')){
    G.bills.evicted=false;
    showMsg('✅ Wszystkie zaległe rachunki spłacone! System automatycznie przywraca cię do najlepszego posiadanego mieszkania.','g');
  }
  notify(`💸 Zapłacono ${b.amount} zł za "${b.type}".`);
  if(typeof renderPhoneApp==='function' && document.getElementById('phone')?.classList.contains('on')){
    renderPhoneApp('bills');
  }
  updateHUD();
};

