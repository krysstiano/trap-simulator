    }
    // Dzienny bonus
    const dayBonus=50+G.level*10;if(typeof earn==='function')earn(dayBonus,false);else{G.money+=dayBonus;G.totalEarned=(G.totalEarned||0)+dayBonus;} /* v1.9.66: Prestige dla daily bonus */
    addNotif(`🌅 Nowy dzień! Dzienny bonus: +${dayBonus} zł${_aptMoodBonus?` · +${_aptMoodBonus} nastrój (mieszkanie)`:''}`);
    // Reset dziennego zadania — jeśli z poprzedniego dnia i odebrane lub nieukończone
    if(G.dailyQuest&&G.dailyQuest.day<G.day&&(G.dailyQuest.claimed||!G.dailyQuest.completed)){
      G.dailyQuest=null;generateDailyQuest();
    }
    // Tygodniowy bonus co 7 dni
    if(G.day%7===0){
      const weekBonus=500+G.level*50;if(typeof earn==='function')earn(weekBonus,false);else{G.money+=weekBonus;G.totalEarned+=weekBonus;} /* v1.9.66: Prestige dla weekly bonus */
      G.stress=clamp(G.stress+20,0,100);
      showMsg(`🎊 Tydzień ${Math.floor(G.day/7)} ukończony! Nagroda tygodniowa: +${weekBonus} zł, +20 nastrój!`);
      addNotif(`🎊 Nagroda tygodniowa: +${weekBonus} zł`);
      // Tygodniowe royalties ze streaming
      if(G.studioTracks&&G.studioTracks.length>0){
        let totalRoy=0;
        for(const tr of G.studioTracks){
          // Streams rosną co tydzień zależnie od fanów i jakości
          const txtMult=getRaperST('teksty')>=1?1.10:1; // Teksty 1+ → +10% streams
          const growth=Math.floor(((G.fans?(G.followers||0)*0.02:0)+(tr.quality||30)*0.5)*txtMult);
          tr.streams=(tr.streams||0)+growth;
          const rstPct=(G.distributor?G.distributor.royaltyPct:80)/100;
          const bizRoyMult=getRaperST('biznes')>=2?1.15:1; // Biznes 2+ → +15% royalties
          const dripRoyMult=1+Math.min(0.60,(typeof getEffectiveDrip==='function'?getEffectiveDrip():(G.drip||0))*0.002); /* v2.1.209 [Amper]: cap 40→60% z PU Personal brand (bez PU drip 200 = +40%, z PU effective 300 = +60%) */
          /* v1.9.18: BUG FIX EXPLOIT — royalty liczone z GROWTH (delta tygodniowa), nie z tr.streams (cumulative). Wcześniej 100k stream track płacił 400zł co tydzień FOREVER, infinity glitch. */
          const roy=Math.floor(growth*0.004*rstPct*((tr.quality||30)/100+0.2)*bizRoyMult*dripRoyMult*20);
          totalRoy+=roy;
