function startVocalRecordMG(){
  /* v2.1.44 [Amper]: KRYTYCZNA NAPRAWA FREEZE — reset inline style.display przed dodaniem .on.
     Bez tego: jeśli wcześniejsza minigra (sequencer/koncert/etc) ustawiła display:none przy cleanup,
     panel pozostaje niewidoczny mimo .on → mgOpen()=true → updatePlayer blokowany → gracz nie może się ruszać. */
  const panel=document.getElementById('mg-job');panel.style.display='';panel.innerHTML='';panel.classList.add('on');
  _jobPanelSession++;
  const micQ=G.mic?G.mic.quality:10;
  // Minigame state
  let takes=0,hits=0,quality=0,phase='wait',cursorX=0,cursorDir=1,speed=2.2+micQ*0.015;
  let zones=[],done=false,animId=null;
  const TOTAL_TAKES=6;

  // Build UI
  const title=document.createElement('h2');title.textContent='🎙 Sesja Nagraniowa';title.style.cssText='color:#e091f0;margin-bottom:4px;font-size:24px;';
  const sub=document.createElement('p');sub.style.cssText='color:#667;font-size:13px;margin-bottom:14px;';
  sub.textContent=`Mikrofon: ${G.mic?G.mic.name:'Brak'} (${micQ}%) · Naciśnij SPACJĘ gdy kursor jest w zielonej strefie`;
  const cv=document.createElement('canvas');cv.width=680;cv.height=160;cv.style.cssText='border:1px solid #2a1a3a;border-radius:8px;background:#0a0412;display:block;margin:0 auto 10px;';
  const info=document.createElement('div');info.style.cssText='text-align:center;font-size:15px;color:#ccc;margin-bottom:12px;';
  const bClose=document.createElement('button');bClose.textContent='← Przerwij';bClose.className='cbtn';
  /* v2.1.44 [Amper]: Przerwij — kompletny cleanup (keydown listener, flag, display:none) żeby NIE zostawiać stickylock dla kolejnego wejścia */
  bClose.onclick=()=>{
    done=true;
    cancelAnimationFrame(animId);
    try{window.removeEventListener('keydown',onSpace);}catch(_){}
    G._dawVocalMode=false;
    panel.classList.remove('on');
    panel.style.display='none';
    renderSoundEngOverlay();
    openOverlay();
  };
  panel.append(title,sub,cv,info,bClose);

  const ctx2=cv.getContext('2d');
  // Generate green zones for this session
  function newZones(){zones=[];for(let i=0;i<3;i++)zones.push(100+Math.random()*480);}
  newZones();

  function draw(){
    ctx2.clearRect(0,0,680,160);
    // Background track
    ctx2.fillStyle='#150a20';ctx2.fillRect(20,55,640,50);
    ctx2.strokeStyle='#2a1a40';ctx2.lineWidth=1;ctx2.strokeRect(20,55,640,50);
    // Waveform decoration
    ctx2.strokeStyle='rgba(160,80,220,0.25)';ctx2.lineWidth=1;
    ctx2.beginPath();for(let x=20;x<660;x+=4){const y=80+Math.sin(x*0.08+Date.now()*0.004)*10*(Math.random()*0.4+0.8);if(x===20)ctx2.moveTo(x,y);else ctx2.lineTo(x,y);}ctx2.stroke();
    // Green zones
    zones.forEach(z=>{ctx2.fillStyle='rgba(40,200,80,0.22)';ctx2.fillRect(z-18,55,36,50);ctx2.strokeStyle='rgba(40,200,80,0.6)';ctx2.lineWidth=1;ctx2.strokeRect(z-18,55,36,50);});
    // Cursor
    const cx=20+cursorX;
    ctx2.fillStyle='#f0d040';ctx2.fillRect(cx-2,45,4,70);
    ctx2.beginPath();ctx2.moveTo(cx-7,45);ctx2.lineTo(cx+7,45);ctx2.lineTo(cx,38);ctx2.closePath();ctx2.fill();
    // Takes counter
    ctx2.fillStyle='#ccc';ctx2.font='bold 14px "Segoe UI"';ctx2.textAlign='left';
    ctx2.fillText(`Take ${takes+1}/${TOTAL_TAKES}`,25,30);
    // Hit indicators
    ctx2.textAlign='right';ctx2.fillStyle='#7ec87e';
    ctx2.fillText(`Trafień: ${hits}/${takes}`,655,30);
    // Quality bar
    const qPct=Math.min(quality,100)/100;
    ctx2.fillStyle='#1a0a2a';ctx2.fillRect(20,130,640,14);
    const grd=ctx2.createLinearGradient(20,0,660,0);grd.addColorStop(0,'#6a20a0');grd.addColorStop(1,'#e040ff');
    ctx2.fillStyle=grd;ctx2.fillRect(20,130,640*qPct,14);
    ctx2.fillStyle='#aaa';ctx2.font='11px "Segoe UI"';ctx2.textAlign='center';ctx2.fillText('JAKOŚĆ: '+Math.round(quality)+'%',340,142);
  }

  function onSpace(e){
    if(done)return;
    if(e.code!=='Space')return;
    e.preventDefault();
    const cx=cursorX;
    let hit=false;
    zones.forEach(z=>{if(Math.abs(cx-(z-20))<20)hit=true;});
    hits+=(hit?1:0);
    // quality based on mic + hit ratio
    const hitBonus=hit?20:5;const micBonus=micQ*0.15;
    quality=clamp(quality+hitBonus+micBonus,0,100);
    takes++;
    // Flash effect
    cv.style.boxShadow=hit?'0 0 18px rgba(40,200,80,0.7)':'0 0 10px rgba(200,40,40,0.4)';
    setTimeout(()=>{cv.style.boxShadow='';},200);
    newZones();
    if(takes>=TOTAL_TAKES){
      done=true;cancelAnimationFrame(animId);window.removeEventListener('keydown',onSpace);
      finishVocal();return;
    }
    info.textContent=hit?`✅ Take ${takes} — trafiony! (${Math.round(quality)}% jakości)`:`❌ Take ${takes} — spóźniony!`;
  }
  window.addEventListener('keydown',onSpace);

  function loop(){
    if(done)return;
    cursorX+=cursorDir*speed;
    if(cursorX>=640){cursorX=640;cursorDir=-1;}
    if(cursorX<=0){cursorX=0;cursorDir=1;}
    draw();animId=requestAnimationFrame(loop);
  }loop();

  function finishVocal(){
    quality=Math.round(quality*getMoodMod()*getSleepMod());
    if(getMoodMod()<0.88) addNotif('😓 Niski nastrój obniżył jakość wokalu!');
    const micQ2=G.mic?G.mic.quality:10;
    let pay=Math.floor((40+quality*1.2+micQ2*0.5)*(1+hits/TOTAL_TAKES*0.5)*getKarieraBonus('soundeng')); // F3-FIX-B
    if(G.managementDeal) pay=Math.floor(pay*G.managementBonus);
    earn(pay,false);G.careers.soundeng.projects++;G.energy=clampStat('energy', G.energy-20);
    addXP(Math.round(15+quality*0.2));G.spotify.listeners+=rnd(10,50+Math.round(quality));
    progressQuest('vocal');
    // Store in currentTrack if launched from DAW
    // v1.8.18: pipeline — po nagraniu wokalu sugeruj mixer.
    const _wasDawVocal = !!G._dawVocalMode;
    if(G._dawVocalMode){G.currentTrack.vocalQ=Math.round(quality);G._dawVocalMode=false;}
    let _nextStepBtn;
    if(_wasDawVocal && G.hasDaw){
      _nextStepBtn=`<button class="cbtn" style="margin-top:18px;background:#1a0a2a;border-color:#9b59b6;color:#9b59b6" onclick="document.getElementById('mg-job').classList.remove('on');renderDAWOverlay('mixer');openOverlay()">🎚️ Następny krok: Miks →</button>`;
    } else {
      _nextStepBtn=`<button class="cbtn" style="margin-top:18px" onclick="document.getElementById('mg-job').classList.remove('on');renderSoundEngOverlay();openOverlay()">← Wróć do studia</button>`;
    }
    panel.innerHTML=`<h2 style="color:#e091f0">🎙 Sesja zakończona!</h2>
      <p style="color:#999;margin:10px 0">Trafień: ${hits}/${TOTAL_TAKES} · Jakość: ${Math.round(quality)}%</p>
      <p style="font-size:22px;color:#f1c40f;margin:14px 0">+${pay} zł</p>
      <p style="color:#27ae60">${quality>=70?'🏆 Profesjonalna realizacja!':quality>=40?'👍 Dobra sesja':'🎤 Da się poprawić...'}</p>
      ${_nextStepBtn}`;
  }
}
