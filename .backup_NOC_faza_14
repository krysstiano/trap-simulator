      <button onclick="window._tutNav(-1)" ${idx<=0?'disabled':''} style="background:#0a1525;border:1px solid #2a4a6a;color:#7ec8e3;padding:7px 14px;border-radius:6px;cursor:${idx<=0?'not-allowed':'pointer'};font-family:inherit;font-size:12px;opacity:${idx<=0?.4:1};transition:all .15s">← Poprzedni</button>
