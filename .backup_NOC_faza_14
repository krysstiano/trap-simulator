  const _pedsGreen = trafficL.peds === 'green';
  /* v2.1.10 ROOT CAUSE FIX: _crossXranges to PASY ZEBRA (crosswalks) — NIE V-drogi!
     Crosswalks są OBOK V-road (w chodniku V wschód/zachód), nie na samej drodze.
