  ];
  /* Stary V-road range (do detect kiedy NPC chce wejść na drogę): */
  const _vRoadRanges = [[768,960],[2208,2400],[3456,3648]];
  /* v2.1.8 NPC PHASE 2: kompletne mapowanie chodników 1:1 zsynchronizowane z SIDEWALK_YS=[290,320,590,615,1830,1860,2120,2150,2790,2820,3080,3110].
     Wcześniej H3 mapowanie miało tylko {2790:3080, 3080:2790} — gdy NPC spawn na 2820/3110 (różnica 30) tolerancja 11 zwracała null → H3 NPC NIGDY nie crossowali.
     Plus tolerancja zwiększona z 11 do 35 (max różnica wewnątrz tego samego chodnika to 30 px — np. 290 vs 320 są oba na H1 N, mapowanie do 615/590 jest spójne, ale w obrębie tolerancji). */
  const _chSwitchH1 = {290:615, 320:590, 615:290, 590:320};
  const _chSwitchH2 = {1830:2150, 1860:2120, 2150:1830, 2120:1860};
  const _chSwitchH3 = {2790:3080, 2820:3110, 3080:2790, 3110:2820};
  const _getCrossTarget = (wy) => {
    const all = {...{},..._chSwitchH1,..._chSwitchH2,..._chSwitchH3};
    let best=null, bestDist=35;
    for(const srcStr of Object.keys(all)){
      const src=parseInt(srcStr,10);
      const d=Math.abs(src-wy);
      if(d<bestDist){bestDist=d;best={sourceY:src,targetY:all[srcStr]};}
    }
    return best;
  };
  const _isInCrossingX = (wx) => _crossXranges.some(([a,b]) => wx >= a && wx <= b);
  /* v2.1.8: pobiera środek crosswalk najbliższego do podanej wx (gdy NPC ma wejść na pasy). */
  const _nearestCrosswalkCenter = (wx) => {
    let best=null, bestDist=Infinity;
    for(const [a,b] of _crossXranges){
      const c=(a+b)/2;
      const d=Math.abs(wx-c);
      if(d<bestDist){bestDist=d;best={center:c,range:[a,b]};}
    }
    return best;
  };

  /* v2.1.7: SIDEWALK SAFETY — hard snap jeśli NPC opuścił chodnik (np. zglitchował na drogę). */
  const _SAFE_SIDEWALKS=[290,320,590,615,1830,1860,2120,2150,2790,2820,3080,3110];
  const _nearestSidewalkY=(wy)=>{
    let best=_SAFE_SIDEWALKS[0], bestDist=Math.abs(wy-best);
    for(const sy of _SAFE_SIDEWALKS){const d=Math.abs(wy-sy);if(d<bestDist){bestDist=d;best=sy;}}
    return best;
  };
  /* v2.1.21: collision avoidance TYLKO w obrębie skrzyżowania (crosswalk area).
     Poza skrzyżowaniem NPC mogą przechodzić obok siebie bez push — wcześniej wyglądało jak "przepychanie się".
     Push tylko gdy: oboje crossują LUB oboje w pobliżu V-road wx (±60) i blisko jakiegokolwiek chodnika crosswalk wy.
     Używamy zewnętrznego _vRoadRanges (zdefiniowane w linii 35032). */
  const _inCrosswalkArea = (p)=>{
    if(p._crossingDir!==0) return true;
    const _nearVRoad = _vRoadRanges.some(([a,b])=>p.wx>=a-60 && p.wx<=b+60);
    if(!_nearVRoad) return false;
    const _crosswalkYs=[290,320,590,615,1830,1860,2120,2150,2790,2820,3080,3110];
    return _crosswalkYs.some(sy=>Math.abs(p.wy-sy)<=25);
  };
  /* v2.1.143: NPC z-ordering — sort cityPeds po Y żeby NPC z dołu ekranu (wyższe Y) rysowali się NA WIERZCHU NPC z góry (niższe Y). Wcześniej array insertion order = NPC za budynkami pojawiali się na wierzchu (visual glitch). Single sort per frame, n≈30-50, trivial cost. */
  cityPeds.sort((a,b)=>(a.wy||0)-(b.wy||0));
  for(let i=0;i<cityPeds.length;i++){
    const pa=cityPeds[i];
    if(!_inCrosswalkArea(pa)) continue;
    for(let j=i+1;j<cityPeds.length;j++){
      const pb=cityPeds[j];
      if(!_inCrosswalkArea(pb)) continue;
      const dwx=pa.wx-pb.wx, dwy=pa.wy-pb.wy;
      if(Math.abs(dwx)<35 && Math.abs(dwy)<25){
        const push = dwx>=0 ? 1 : -1;
        const force = 3;
        if(pa._crossingDir!==0 && pb._crossingDir!==0){
          pa.wx += push*force; pb.wx -= push*force;
          pa._pushedThisFrame=true; pb._pushedThisFrame=true;
        } else {
          if(pa._crossingDir===0) { pa.wx += push*force; pa._pushedThisFrame=true; }
          if(pb._crossingDir===0) { pb.wx -= push*force; pb._pushedThisFrame=true; }
        }
      }
    }
  }
  for(const ped of cityPeds){
    if(typeof ped.idleTimer!=='number') ped.idleTimer=0;
    // v1.8.27: bug fix — baseSpd==0 to "finite number" więc poprzedni guard (isFinite) jej nie wymieniał.
    if(typeof ped.baseSpd!=='number'||!isFinite(ped.baseSpd)||ped.baseSpd<0.3) ped.baseSpd=0.9;
    if(typeof ped.dx!=='number'||!isFinite(ped.dx)) ped.dx=Math.random()>.5?ped.baseSpd:-ped.baseSpd;
    if(typeof ped._crossingDir!=='number') ped._crossingDir=0;
    if(typeof ped._crossingTargetY!=='number') ped._crossingTargetY=0;
    /* v2.1.7: HARD SIDEWALK SNAP.
       v2.1.14: skip gdy NPC blisko V-road wx (obszar crosswalk) — bo tam wy może być edge (376/620/1916/...) co jest legalnie blisko pasów. */
    const _inCrosswalkArea = [[768,960],[2208,2400],[3456,3648]].some(([a,b])=>ped.wx>=a-60 && ped.wx<=b+60);
    if(ped._crossingDir===0 && (ped._crossCooldown||0)<=0 && !_inCrosswalkArea){
      const _nearest=_nearestSidewalkY(ped.wy);
      if(Math.abs(ped.wy-_nearest)>15){ped.wy=_nearest;}
    }
    /* v2.1.7: GLOBAL STUCK COUNTER (na poziomie ped, niezależny od waypointów).
       Jeśli wx się NIE zmienił >0.5px przez 90 frames I NPC nie ma pomysł (idleTimer<=0) → wymuś nowy dx + reset wy.
       Naprawia "NPC zablokowany w miejscu, chodzi na boki" i "freezuje". */
    ped._lastWxCheck=ped._lastWxCheck||{wx:ped.wx,frames:0,bounceResetFrames:0};
    /* v2.1.8: gdy NPC porusza się normalnie >120 klatek, reset bounce counter (nowy V-road encounter to ok) */
    ped._lastWxCheck.bounceResetFrames=(ped._lastWxCheck.bounceResetFrames||0)+1;
    if(ped._lastWxCheck.bounceResetFrames>120){ped._vRoadBounceCount=0; ped._lastWxCheck.bounceResetFrames=0;}
    /* v2.1.21: jeśli wx się zmienił TYLKO z powodu collision push (_pushedThisFrame=true) — NIE reset counter,
       bo to nie jest faktyczny ruch NPC. Inaczej NPC stojący ale pushowany przez sąsiada nigdy nie wymusza nowego dx. */
    if(Math.abs(ped.wx-ped._lastWxCheck.wx)>0.5 && !ped._pushedThisFrame){
      ped._lastWxCheck.wx=ped.wx; ped._lastWxCheck.frames=0;
    } else if(ped._crossingDir===0 && ped.idleTimer<=0){
      ped._lastWxCheck.frames++;
      if(ped._lastWxCheck.frames>90){
        ped.dx=ped.baseSpd*(Math.random()>.5?1:-1);
        ped.wy=_nearestSidewalkY(ped.wy);
        ped._lastWxCheck.frames=0;
        if(ped._wpRoute){ped._wpRoute=null;}
      }
    }
    /* _pushedThisFrame reset PO anim++ check (na końcu pętli) — żeby anim mógł go sprawdzić. */
    // v1.8.16: USUNIĘTE waypointy + anti-stuck teleport (powodowały "NPC teleportuje się").
    // Zostaje PROSTA logika: NPC chodzi w jednym kierunku po chodniku, gdy kolizja zmienia kierunek.
    // anim++ TYLKO gdy NPC FAKTYCZNIE zmienił pozycję (nie tylko ma dx).
    const _prevPedWx = ped.wx;
    const _prevPedWy = ped.wy;

    // PRZECHODZENIE PRZEZ CROSSWALK
    if(ped._crossingDir !== 0){
      /* v2.1.12: 1.5× crossing speed (baseSpd*1.5) — wcześniej 3× wyglądało jak sprint/teleport ("BARDZO SZYBKO PRZEBIEGA").
         Teraz normalny chód, szybszy o 50% — przejście 325px w ~4s zamiast 2s. */
      ped.wy += ped._crossingDir * ped.baseSpd * 1.5;
      if((ped._crossingDir > 0 && ped.wy >= ped._crossingTargetY) ||
         (ped._crossingDir < 0 && ped.wy <= ped._crossingTargetY)){
        ped.wy = ped._crossingTargetY;
        ped._crossingDir = 0;
        ped._crossCooldown = 60;
        /* v2.1.12: per-V-road cooldown — zapobiega "back-and-forth przez to samo crosswalk".
           Zapisz wx range index który właśnie crossowal i timestamp. Następne crossing TEGO SAMEGO V-road
           blokowane przez 8 sekund — NPC musi iść do innego crosswalk (V1/V2/V3) zamiast wracać. */
        if(!ped._vRoadLastCross) ped._vRoadLastCross={};
        const _vIdx=ped.wx<1500?'V1':ped.wx<3200?'V2':'V3';
        ped._vRoadLastCross[_vIdx]=Date.now()+8000;
        /* v1.9.78: po crossing — zachowaj goal direction (audyt NPC) */
        if(typeof ped._goalX==='number'){
          const goalDir=ped._goalX>ped.wx?1:-1;
          ped.dx=goalDir*Math.abs(ped.baseSpd);
        } else {
          ped.dx = Math.random()>0.5 ? Math.abs(ped.baseSpd) : -Math.abs(ped.baseSpd);
        }
      }
      if(!ped._colors){ ped._colors={shirt:'#3498db',pants:'#1a2a3a',skin:'#e8c8a0'}; }
    }
    if(typeof ped._crossCooldown!=='number') ped._crossCooldown=0;
    if(ped._crossCooldown>0) ped._crossCooldown--;

    /* v2.1.18: pomocnik — sprawdza czy NPC niedawno crossował V-road w tej okolicy */
    const _vIdxCur = ped.wx<1500?'V1':ped.wx<3200?'V2':'V3';
    const _curVRoadJustCrossed = ped._vRoadLastCross && ped._vRoadLastCross[_vIdxCur] && Date.now() < ped._vRoadLastCross[_vIdxCur];
    /* czekaj w pasie gdy peds=RED — TYLKO jeśli NIE crossował niedawno (anti back-and-forth). */
    if(_isInCrossingX(ped.wx) && !_pedsGreen && ped._crossingDir===0 && ped._crossCooldown<=0 && !_curVRoadJustCrossed){
      ped.dx = 0;
      ped.idleTimer = 300;
      ped._waitingForLight = true;
    }
    /* Decyzja "chcę przejść" — tylko gdy nie cooldown I niedawno NIE crossował tej V-road (anti back-and-forth fix v2.1.18). */
    if(ped._crossingDir === 0 && _pedsGreen && _isInCrossingX(ped.wx) && ped._crossCooldown<=0 && !_curVRoadJustCrossed){
      const cross = _getCrossTarget(ped.wy);
      if(cross !== null && Math.random() < 0.7){
        ped.wy = cross.sourceY;
        ped._crossingTargetY = cross.targetY;
        ped._crossingDir = cross.targetY > ped.wy ? 1 : -1;
        ped._waitingForLight = false;
        for(const [a,b] of _crossXranges){
          if(ped.wx >= a && ped.wx <= b){
            if(ped.wx < a+12) ped.wx = a+12;
            else if(ped.wx > b-12) ped.wx = b-12;
            break;
          }
        }
      }
    }
    /* v2.1.18: gdy NPC stoi w obszarze crosswalk z _curVRoadJustCrossed=true → wymuś ruch DALEJ od V-road
       (zamiast czekać i triggerować crossing). Wybierz kierunek poza V-road wx range. */
    if(_curVRoadJustCrossed && _isInCrossingX(ped.wx) && ped._crossingDir===0 && ped.idleTimer<=10){
      const vRanges=[[768,960],[2208,2400],[3456,3648]];
      const _vR = vRanges.find(([a,b]) => Math.abs(ped.wx - (a+b)/2) < 200);
      if(_vR){
        /* Push NPC OD V-road na chodnik V (poza crosswalk wx range) */
        if(ped.wx < _vR[0]){ ped.dx = -Math.abs(ped.baseSpd); /* w lewo od V-road */ }
        else if(ped.wx > _vR[1]){ ped.dx = Math.abs(ped.baseSpd); /* w prawo */ }
        else {
          /* NPC w środku V-road wx — wybierz losowo */
          ped.dx = (Math.random()>0.5?1:-1) * Math.abs(ped.baseSpd);
        }
      }
    }
    // Horizontal logic tylko gdy NPC NIE przechodzi przez crosswalk
    if(ped._crossingDir === 0){
    // v1.8.18: randomizacja dx TYLKO gdy NPC nie jest idle (wcześniej re-randomizowała się co frame
    // gdy ped.dx=0 z powodu czerwonego światła, powodując rapid eye/face flip — "kręcą głową szybko").
    if(ped.idleTimer<=0){
      /* v2.1.8 PHASE 2: anti-oscylacja. Gdy NPC ma dx≈0 ALE _crossCooldown>0 (po crossingu) lub waiting przy V-road,
         NIE re-randomizuj dx co frame — to powodowało "spamują a/d / kręcą głową".
         Zamiast: jeśli mamy _faceDir, użyj go jako kierunek; inaczej preferuj waypoint dir; ostatnia opcja random. */
      if(Math.abs(ped.dx)<0.1 && ped._crossCooldown<=0 && ped._crossingDir===0){
        const _wpDir=Array.isArray(ped._wpRoute)&&typeof ped._wpRoute[ped._wpIdx]==='number'
          ? (ped._wpRoute[ped._wpIdx]>ped.wx?1:-1)
          : (ped._faceDir||(Math.random()>.5?1:-1));
        ped.dx=ped.baseSpd*_wpDir;
      }
      else if(Math.abs(ped.dx)>0.1 && Math.abs(Math.abs(ped.dx)-ped.baseSpd)>0.5) ped.dx=Math.sign(ped.dx)*ped.baseSpd;
    }
    if(ped.idleTimer<=0){
      const newWx=ped.wx+ped.dx;
      // v1.8.29: NPC NIE wchodzi na V-road jeśli nie crossuje — bez tego NPC szli przez środek
      // skrzyżowań (V-road area widoczna jako road) zamiast przejść po pasach.
      // V1: 768-960, V2: 2208-2400, V3: 3456-3648. Sprawdzamy czy newWx wpada w road area.
      const _vRoadHit = (newWx>=768&&newWx<=960)||(newWx>=2208&&newWx<=2400)||(newWx>=3456&&newWx<=3648);
      const _alreadyInVRoad = (ped.wx>=768&&ped.wx<=960)||(ped.wx>=2208&&ped.wx<=2400)||(ped.wx>=3456&&ped.wx<=3648);
      if(_vRoadHit && !_alreadyInVRoad){
        /* v2.1.8 PHASE 2: nowa logika V-road approach.
           1. NPC zawsze TRAFIA w pas zebra: snap wx do CENTRUM najbliższego crosswalka + snap wy do najbliższego mapowanego chodnika
           2. Jeśli GREEN + brak cooldown → przechodzi
           3. Jeśli RED → zatrzymuje się dokładnie przy krawędzi pasów (bez bounce — żadnej oscylacji)
           4. Jeśli cooldown → bounce + zaplanuj inne crossing (anti-oscylacja przez counter) */
        const _cross=_getCrossTarget(ped.wy);
        /* v2.1.12: per-V-road cooldown — gdy NPC niedawno crossował TĘ SAMĄ V-road, NIE pozwól crossować ponownie (back-and-forth fix) */
        const _vIdxNow=newWx<1500?'V1':newWx<3200?'V2':'V3';
        const _vRoadJustCrossed = ped._vRoadLastCross && ped._vRoadLastCross[_vIdxNow] && Date.now() < ped._vRoadLastCross[_vIdxNow];
        if(_cross && ped._crossCooldown<=0 && !_vRoadJustCrossed){
          /* Znajdź właściwy crosswalk (ten przez który NPC właśnie wchodzi) */
          let _crosswalkCenter=null, _crosswalkRange=null;
          for(const [a,b] of _crossXranges){
            if(newWx>=a-50 && newWx<=b+50){_crosswalkCenter=(a+b)/2; _crosswalkRange=[a,b]; break;}
          }
          if(_crosswalkCenter!==null){
            if(_pedsGreen){
              /* GREEN: SNAP wx do CENTRUM crosswalk + start crossing */
              ped.wx=Math.round(_crosswalkCenter);
              ped.wy=_cross.sourceY;
              ped._crossingTargetY=_cross.targetY;
              ped._crossingDir=_cross.targetY>ped.wy?1:-1;
              ped.dx=0;
              ped._vRoadBounceCount=0;
              ped._waitingForLight=false; /* v2.1.16: clear waiting flag — NPC zaczyna crossing */
            } else {
              /* v2.1.16: COFNIĘTE edge mapping z v2.1.14. Postać h=56, więc edge wy=376 dawało stopy=432 NA DRODZE H1
                 (postać wystawała na ulicę). Wracamy do `_cross.sourceY` (=290/320/590/615/...) — top na chodniku,
                 stopy w pasach zebra (346-384 dla H1 N). Dodano flag `_waitingForLight` dla renderowania emoji wskaźnika nad głową. */
              ped.dx=0;
              ped.idleTimer=300;
              ped.wx=Math.round(_crosswalkCenter);
              ped.wy=_cross.sourceY;
              ped._waitingForLight=true;
            }
          } else {
            /* Edge case: hit V-road ale nie znalazł crosswalk range → bounce */
            ped.dx=-ped.dx;
          }
        } else if(!_cross){
          /* wy NIE pasuje do żadnego crossing → SNAP wy do najbliższego mapowanego chodnika żeby NPC mógł crossować w następnej klatce */
          const _crossingCapableSidewalks=[290,320,590,615,1830,1860,2120,2150,2790,2820,3080,3110];
          let bestY=_crossingCapableSidewalks[0], bestD=Math.abs(ped.wy-bestY);
          for(const sy of _crossingCapableSidewalks){
            const d=Math.abs(ped.wy-sy);
            if(d<bestD){bestD=d;bestY=sy;}
          }
          ped.wy=bestY;
          ped.dx=0;
          ped.idleTimer=4; /* daj klatce na recompute */
        } else {
          /* v2.1.12: cooldown LUB _vRoadJustCrossed → odbij + INVALIDATE waypointy żeby NPC dostał nowy cel
             PO TEJ SAMEJ STRONIE V-road (zamiast oscylować chcąc wracać do waypointa za V-road).
             Wtedy NPC pójdzie horyzontalnie wzdłuż chodnika do innego crosswalk lub zmieni kierunek na lokalny. */
          ped.dx=-ped.dx;
          ped._bounceFromVRoad=Date.now()+2000; /* 2s waypoint override block */
          if(_vRoadJustCrossed && Array.isArray(ped._wpRoute)){
            /* Regeneruj waypointy ograniczone do TEJ SAMEJ STRONY V-road */
            ped._wpRoute=null;
          }
        }
      } else if(_pedHitsSolid(newWx,ped.wy)){
        ped.dx=-ped.dx;
        // Jeśli WCIĄŻ koliduje (utknął w budynku) — wyrwij na bezpieczny chodnik
        if(_pedHitsSolid(ped.wx,ped.wy)){
          for(let tries=0;tries<8;tries++){
            const newY=safePedYs[Math.floor(Math.random()*safePedYs.length)];
            if(!_pedHitsSolid(ped.wx,newY)){ped.wy=newY;break;}
          }
        }
      } else {
        ped.wx=newWx;
      }
      // Granice mapy — odbicie
      if(ped.wx<60){ped.dx=Math.abs(ped.dx);ped.wx=60;}
      if(ped.wx>4280){ped.dx=-Math.abs(ped.dx);ped.wx=4280;}
      // Sprawdź czy NPC wpadł na jezdnię (drogi H1/H2/H3) — wyrzuć na chodnik (skip jeśli właśnie crossuje)
      if(ped._crossingDir===0){
        const yH=ped.wy, yF=ped.wy+45;
        const inRoad=(y1,y2)=>(yH>=y1&&yH<=y2)||(yF>=y1&&yF<=y2)||(yH<y1&&yF>y2);
        if(inRoad(384,576)||inRoad(1920,2112)||inRoad(2880,3072)){
          // Wybierz najbliższy bezpieczny chodnik
          let bestY=safePedYs[0],bestD=Math.abs(safePedYs[0]-ped.wy);
          for(const sy of safePedYs){
            const d=Math.abs(sy-ped.wy);
            if(d<bestD){bestY=sy;bestD=d;}
          }
          ped.wy=bestY;
        }
      }
      // Okazjonalna zmiana kierunku (rozsądny ruch po chodniku) — TYLKO jeśli nie ma celu
      /* v1.9.82: PORZĄDNE waypoint pathfinding (po v1.9.79 rollback).
         Każdy NPC ma trasę 4 waypointów (4 różne miejsca w mieście).
         Anti-stuck: jeśli NPC stoi w tym samym miejscu >100 klatek → skip do następnego waypointu. */
      if(!Array.isArray(ped._wpRoute)||ped._wpRoute.length===0){
        /* v2.1.14: waypoint generation respects _vRoadJustCrossed cooldowns — żeby NPC NIE dostał waypointu
           za V-road który niedawno crossował (zapobiega "back-and-forth wracaj do waypointa przez tę samą V-road").
           Ogranicz wx range do tej samej strony każdej cooldown V-road. */
        let _minWx=150, _maxWx=4150;
        if(ped._vRoadLastCross){
          const now=Date.now();
          if(ped._vRoadLastCross.V1 && now<ped._vRoadLastCross.V1){
            if(ped.wx<768) _maxWx=Math.min(_maxWx, 760);
            else if(ped.wx>960) _minWx=Math.max(_minWx, 968);
          }
          if(ped._vRoadLastCross.V2 && now<ped._vRoadLastCross.V2){
            if(ped.wx<2208) _maxWx=Math.min(_maxWx, 2200);
            else if(ped.wx>2400) _minWx=Math.max(_minWx, 2408);
          }
          if(ped._vRoadLastCross.V3 && now<ped._vRoadLastCross.V3){
            if(ped.wx<3456) _maxWx=Math.min(_maxWx, 3448);
            else if(ped.wx>3648) _minWx=Math.max(_minWx, 3656);
          }
        }
        ped._wpRoute=[];
        let _attempts=0;
        while(ped._wpRoute.length<4 && _attempts<50){
          const w=_minWx+Math.random()*(_maxWx-_minWx);
          const _onVRoad=(w>=768&&w<=960)||(w>=2208&&w<=2400)||(w>=3456&&w<=3648);
          if(!_onVRoad) ped._wpRoute.push(w);
          _attempts++;
        }
        /* Fallback — jeśli wx range zbyt wąski, wypełnij środkiem range */
        const _midWx=(_minWx+_maxWx)/2;
        while(ped._wpRoute.length<4) ped._wpRoute.push(_midWx+(ped._wpRoute.length-2)*100);
        ped._wpIdx=0;
        ped._wpStuckFrames=0;
        ped._wpLastWx=ped.wx;
      }
      const _wpTarget=ped._wpRoute[ped._wpIdx];
      const _wpDist=Math.abs(ped.wx-_wpTarget);
      /* Jeśli dotarł (50px) → następny waypoint */
      if(_wpDist<50){
        ped._wpIdx=(ped._wpIdx+1)%ped._wpRoute.length;
        if(ped._wpIdx===0){
          /* Trasa skończona — generuj nową */
          ped._wpRoute=null;
        }
        ped._wpStuckFrames=0;
        ped._wpLastWx=ped.wx;
      } else {
        /* Sprawdź stuck — wx nie zmienił się >5px w X klatkach */
        if(Math.abs(ped.wx-ped._wpLastWx)<5){
          ped._wpStuckFrames=(ped._wpStuckFrames||0)+1;
