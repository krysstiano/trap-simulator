  };
  window._warOnBetInput=()=>{_syncBetFromInput();};
  const _shuffleDeck=()=>{
    const suits=['♠','♥','♦','♣'];
    const ranks=[{r:'2',v:2},{r:'3',v:3},{r:'4',v:4},{r:'5',v:5},{r:'6',v:6},{r:'7',v:7},{r:'8',v:8},{r:'9',v:9},{r:'10',v:10},{r:'J',v:11},{r:'Q',v:12},{r:'K',v:13},{r:'A',v:14}];
    deck=[];
    for(const s of suits) for(const r of ranks) deck.push({s, r:r.r, v:r.v});
    for(let i=deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]];}
  };
  const _drawCard=(cx,x,y,card,faceDown=false)=>{
    cx.fillStyle='rgba(0,0,0,.35)';cx.fillRect(x+2,y+3,64,88);
    cx.fillStyle='#fff';cx.fillRect(x,y,64,88);
    cx.strokeStyle='#1a1a1a';cx.lineWidth=1.5;cx.strokeRect(x,y,64,88);
    if(faceDown){
      cx.fillStyle='#5a1818';cx.fillRect(x+3,y+3,58,82);
      cx.strokeStyle='#c8a520';cx.lineWidth=1;cx.strokeRect(x+5,y+5,54,78);
      cx.fillStyle='#7a2828';
      for(let r=0;r<6;r++)for(let c=0;c<3;c++){
        cx.beginPath();cx.arc(x+13+c*18,y+15+r*13,2.5,0,Math.PI*2);cx.fill();
      }
      cx.fillStyle='#c8a520';cx.font='bold 24px Arial';cx.textAlign='center';cx.textBaseline='middle';cx.fillText('⚔',x+32,y+44);
    } else if(card){
      const isRed=card.s==='♥'||card.s==='♦';
      cx.fillStyle=isRed?'#c01020':'#1a1a1a';
      cx.font='bold 17px Arial,sans-serif';cx.textAlign='left';cx.textBaseline='top';
      cx.fillText(card.r,x+4,y+4);
      cx.font='bold 15px Arial,sans-serif';
      cx.fillText(card.s,x+4,y+26);
      cx.font='bold 38px Arial,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
      cx.fillText(card.s,x+32,y+47);
      cx.font='bold 17px Arial,sans-serif';cx.textAlign='right';cx.textBaseline='bottom';
      cx.fillText(card.r,x+60,y+84);
    }
  };
  // Stos żetonów (uproszczona wersja z blackjacka)
  const _drawChipStack=(cx_ctx,cx,cy,amount,label)=>{
    if(amount<=0) return;
    const denoms=[{v:500,c:'#7a3aa3',e:'#a050d0'},{v:100,c:'#1a1a1a',e:'#3a3a3a'},{v:25,c:'#27ae60',e:'#50d080'},{v:5,c:'#c01020',e:'#e04050'},{v:1,c:'#f0f0f0',e:'#ffffff'}];
    const breakdown=[];let rem=amount;
    for(const d of denoms){const cnt=Math.floor(rem/d.v);if(cnt>0){breakdown.push({...d,cnt});rem-=cnt*d.v;}}
    const maxPerCol=6;let colIdx=0,posInCol=0;
    for(const b of breakdown){
      for(let i=0;i<b.cnt;i++){
        const x=cx+colIdx*16,y=cy-posInCol*4;
        cx_ctx.fillStyle='rgba(0,0,0,.5)';cx_ctx.beginPath();cx_ctx.ellipse(x+1,y+2,10,3.5,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle='#1a1a1a';cx_ctx.beginPath();cx_ctx.ellipse(x,y,10,3.5,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle=b.c;cx_ctx.beginPath();cx_ctx.ellipse(x,y-1,9,3,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle=b.e;cx_ctx.beginPath();cx_ctx.ellipse(x,y-2,7,2.2,0,0,Math.PI*2);cx_ctx.fill();
        cx_ctx.fillStyle='rgba(255,255,255,.7)';
        cx_ctx.fillRect(x-9,y-2,2,1.5);cx_ctx.fillRect(x+7,y-2,2,1.5);
