    /* v2.0.25: dźwięk wyniku — JACKPOT dla brzegów 20×, BigWin dla 4×, zwykły cash dla mniejszych */
    if(b.multiplier>=20){ if(typeof sfxJackpot==='function')sfxJackpot(); }
    else if(b.multiplier>=4){ if(typeof sfxBigWin==='function')sfxBigWin(); }
    else if(b.multiplier>=1.5){ if(typeof sfxCash==='function')sfxCash(); }
    if(typeof saveGameSilent==='function')saveGameSilent();
    _renderHUD();
  };
  /* v1.9.95: _renderHUD — light update (tylko żetony + result) bez przebudowy całego overlay (zapobiega lag przy spam) */
  const _renderHUD=()=>{
    const chipsEl=document.getElementById('plinko-chips');
