    // Flicker effect — czasami "miga" jak sterowne neony
    const flickerSeed=(obj.wx*7+obj.wy*11)%100;
    const flicker=(Math.sin(now*0.001+flickerSeed)*0.5+0.5)>0.04?1.0:0.4;
    // Pozycja szyldu — góra budynku (gdzie label jest narysowany)
    const cx=sx+obj.w/2;
    const cy=sy+obj.h*0.30; // ~tam gdzie label
    const baseR=28*intensity*flicker;
    // Bloom warstwa 1 — mocno wokół tekstu
    const g1=X.createRadialGradient(cx,cy,2,cx,cy,baseR);
    g1.addColorStop(0,col+'cc');
    g1.addColorStop(0.4,col+'40');
    g1.addColorStop(1,col+'00');
    X.fillStyle=g1;X.beginPath();X.arc(cx,cy,baseR,0,Math.PI*2);X.fill();
    // Bloom warstwa 2 — szersza poświata
    const r2=70*intensity*flicker;
    const g2=X.createRadialGradient(cx,cy,15,cx,cy,r2);
    g2.addColorStop(0,col+'30');
    g2.addColorStop(0.5,col+'10');
    g2.addColorStop(1,col+'00');
    X.fillStyle=g2;X.beginPath();X.arc(cx,cy,r2,0,Math.PI*2);X.fill();
  }
  X.restore();
}

