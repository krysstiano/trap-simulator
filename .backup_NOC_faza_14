    {wx:280,wy:625},{wx:680,wy:625},{wx:980,wy:625,full:true},{wx:1380,wy:625},{wx:2080,wy:625},{wx:3080,wy:625,full:true},{wx:3280,wy:625},{wx:3850,wy:625},
    // North H2 wy=1855
    {wx:480,wy:1855},{wx:1380,wy:1855,full:true},{wx:2380,wy:1855},{wx:3380,wy:1855},
