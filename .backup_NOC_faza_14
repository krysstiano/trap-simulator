function drawStudioDecorations(){
  /* v2.1.52 Amper: REDESIGN — premium feel jak w prawdziwym studio nagraniowym.
     STREFY:
       LEWA (0-340): kabina nagraniowa — mic_booth interactive
       ŚRODEK (340-820): mikser, krzesło, audio interface, monitory na stojakach
       PRAWA-GÓRA (820-1296, 62-400): biurko z DAW computer + ekran
       PRAWA-DÓŁ (820-1296, 400-672): lounge — kanapa + stolik
       GÓRA (62-160): panele akustyczne na całej długości
       DOLNA krawędź: LED strip
     Pełny viewport: 1296×672. */
  const flx=wx2sx(0),fly=wy2sy(62),flw=wx2sx(1296)-flx,flh=wy2sy(672)-fly;
  /* v2.1.67 Amper: prawdziwa podłoga z desek drewnianych studyjnych — herringbone pattern + ciepły gradient. */
  /* Bazowy ciemny drewno z gradient */
  const flg=X.createLinearGradient(flx,fly,flx,fly+flh);
  flg.addColorStop(0,'#1a0e16');flg.addColorStop(.5,'#241218');flg.addColorStop(1,'#160a12');
  X.fillStyle=flg;X.fillRect(flx,fly,flw,flh);
  /* Deski podłogowe — poziome (kierunek równoległy do ścian) z subtelnymi pęknięciami */
  const _plankH=64;
  for(let py=fly;py<fly+flh;py+=_plankH){
    /* Każda deska ma lekko inną teksturę */
    const _seed=(py-fly)/_plankH;
    const _shade=(_seed%2===0)?'#1d0f15':'#1a0d14';
    X.fillStyle=_shade;X.fillRect(flx,py,flw,_plankH);
    /* Linia łączenia desek — ciemna */
    X.strokeStyle='rgba(8,4,6,.7)';X.lineWidth=1;
    X.beginPath();X.moveTo(flx,py);X.lineTo(flx+flw,py);X.stroke();
    /* Wewnętrzne grain desek — bardzo subtelne */
    X.strokeStyle='rgba(60,40,55,.06)';X.lineWidth=0.5;
    for(let gx=0;gx<flw;gx+=3){
      const _yoff=Math.sin((gx+_seed*100)*0.05)*1.5;
      X.beginPath();X.moveTo(flx+gx,py+_plankH/2+_yoff);X.lineTo(flx+gx+3,py+_plankH/2+_yoff);X.stroke();
    }
    /* Łączenia pionowe (różne pozycje per deska) — pseudo-random na podstawie seeda */
    const _splits=[(120+_seed*73)%flw, (380+_seed*131)%flw, (720+_seed*43)%flw, (1020+_seed*97)%flw];
    X.strokeStyle='rgba(0,0,0,.55)';X.lineWidth=1;
    for(const sx of _splits){X.beginPath();X.moveTo(flx+sx,py);X.lineTo(flx+sx,py+_plankH);X.stroke();}
  }
  /* Subtelny purple ambient overlay — recording studio mood */
  const _amb=X.createRadialGradient(flx+flw/2,fly+flh/2,0,flx+flw/2,fly+flh/2,Math.max(flw,flh)*0.7);
  _amb.addColorStop(0,'rgba(80,40,120,.08)');_amb.addColorStop(.5,'rgba(40,20,60,.04)');_amb.addColorStop(1,'rgba(0,0,0,.25)');
  X.fillStyle=_amb;X.fillRect(flx,fly,flw,flh);

  const _tt=Date.now();
  /* ON AIR — pulsujący czerwony neon NAD kabiną (lewa strona, wyrównany z mic_booth) */
  {
    const oax=wx2sx(100),oay=wy2sy(105);
    const pulse=0.7+Math.sin(_tt/400)*0.3;
    X.shadowColor='#e74c3c';X.shadowBlur=14*pulse;
    X.fillStyle=`rgba(0,0,0,0.9)`;X.fillRect(oax,oay,160,28);
    X.strokeStyle=`rgba(231,76,60,${0.9*pulse})`;X.lineWidth=2.5;X.strokeRect(oax,oay,160,28);
    X.fillStyle=`rgba(255,${100-50*pulse},${100-50*pulse},${pulse})`;
    X.font='bold 16px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.fillText('● ON AIR',oax+80,oay+15);
    X.shadowBlur=0;X.textAlign='left';X.textBaseline='alphabetic';
  }

  /* v2.1.69 Amper: studio monitors PRZENIESIONE — flankują KOMPUTER, nie mikser. Pod kątem ~38° względem krzesła (środek 960, 369): monitor lewy x:780, prawy x:1140, oba na biurku obok komputera (wy:170). To sweet spot stereo dla nasłuchiwania producenckiego. */
  for(const sm of [{x:wx2sx(780),y:wy2sy(170)},{x:wx2sx(1140),y:wy2sy(170)}]){
    const sx=sm.x,sy=sm.y;
    // Cień stojaka
    X.fillStyle='rgba(0,0,0,.35)';X.fillRect(sx+4,sy+62,28,4);
    // Statyw
    X.fillStyle='#1a1a1a';X.fillRect(sx+15,sy+30,4,32);
    X.fillRect(sx+5,sy+62,24,3);
    // Obudowa głośnika (drewniana ciemna)
    const cg=X.createLinearGradient(sx,sy,sx+34,sy+30);
    cg.addColorStop(0,'#1a1a1e');cg.addColorStop(0.5,'#2a2a30');cg.addColorStop(1,'#1a1a1e');
    X.fillStyle=cg;X.fillRect(sx,sy,34,30);
    X.strokeStyle='#3a3a3a';X.lineWidth=1;X.strokeRect(sx+.5,sy+.5,33,29);
    // Tweeter (mniejszy)
    X.fillStyle='#0a0a0a';X.beginPath();X.arc(sx+17,sy+8,3,0,Math.PI*2);X.fill();
    X.fillStyle='#1a1a1a';X.beginPath();X.arc(sx+17,sy+8,2,0,Math.PI*2);X.fill();
    // Woofer (większy)
    X.fillStyle='#0a0a0a';X.beginPath();X.arc(sx+17,sy+20,7,0,Math.PI*2);X.fill();
    X.fillStyle='#1a1a1a';X.beginPath();X.arc(sx+17,sy+20,5.5,0,Math.PI*2);X.fill();
    X.fillStyle='#2a2a2a';X.beginPath();X.arc(sx+17,sy+20,2.5,0,Math.PI*2);X.fill();
    // LED status (zielona pulsująca)
    const sled=0.5+Math.sin(_tt/600)*0.5;
    X.fillStyle=`rgba(39,174,96,${0.4+sled*0.6})`;
    X.beginPath();X.arc(sx+30,sy+27,1.5,0,Math.PI*2);X.fill();
  }
  /* v2.1.52 Amper: plakaty na ścianie nad mikserem (środek) — nie kolidują z kabiną (lewa) ani DAW (prawa). */
  const posters=[
    {wx:380,wy:120,c1:'#e91e8c',c2:'#9b59b6',title:'TRAP\nKING'},
    {wx:560,wy:120,c1:'#f1c40f',c2:'#e67e22',title:'MUSIC\nLIFE'},
    {wx:740,wy:120,c1:'#3498db',c2:'#27ae60',title:'LIVE\nFEST'},
  ];
  for(const po of posters){
    const px=wx2sx(po.wx),py=wy2sy(po.wy);
    // Cień ramki
    X.fillStyle='rgba(0,0,0,.35)';X.fillRect(px+2,py+2,58,80);
    // Ramka czarna
    X.fillStyle='#0a0a0a';X.fillRect(px,py,60,82);
    // Plakat — gradient
    const pg=X.createLinearGradient(px+2,py+2,px+58,py+80);
    pg.addColorStop(0,po.c1);pg.addColorStop(1,po.c2);
    X.fillStyle=pg;X.fillRect(px+2,py+2,56,78);
    // Tekst
    X.font='bold 10px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='middle';
    X.fillStyle='rgba(0,0,0,.6)';X.fillText(po.title.split('\n')[0],px+31,py+34);X.fillText(po.title.split('\n')[1]||'',px+31,py+47);
    X.fillStyle='#fff';X.fillText(po.title.split('\n')[0],px+30,py+33);X.fillText(po.title.split('\n')[1]||'',px+30,py+46);
    X.textAlign='left';X.textBaseline='alphabetic';
    // Stamp odznaki "PLATINUM" w rogu
    X.fillStyle='rgba(241,196,15,.85)';X.beginPath();X.arc(px+8,py+74,5,0,Math.PI*2);X.fill();
    X.fillStyle='#000';X.font='bold 5px Arial';X.fillText('★',px+5,py+76);
  }
  // LED strip — wzdłuż dolnej krawędzi północnej ściany (RGB pulsujący)
  const t=Date.now();
  const ledAx=wx2sx(20),ledAy=wy2sy(110),ledAw=wx2sx(1036)-ledAx;
  for(let i=0;i<28;i++){
    const lx=ledAx+i*(ledAw/28);
    const hue=(i*40+t/30)%360;
    X.fillStyle=`hsl(${hue},80%,60%)`;
    X.fillRect(lx,ledAy,3,3);
    X.shadowBlur=8;X.shadowColor=`hsl(${hue},80%,60%)`;
    X.fillRect(lx,ledAy,3,3);X.shadowBlur=0;
  }
  // Piankowe panele akustyczne na ścianie północnej — #29B stackująca wizualizacja
  const ax=wx2sx(50),ay=wy2sy(58),aw=950,ah=50;
  const foams=G.acousticFoams||0,panels=G.acousticPanels||0;
  const totalAc=foams+panels*2; // panele liczone podwójnie (większe)
  X.fillStyle='#1a0a0a';X.fillRect(ax,ay,aw,ah);
  const pW=Math.floor(aw/9);
  for(let i=0;i<9;i++){
    const px=ax+2+i*(aw-4)/9;
    // Wypełnij panele od lewej zgodnie z liczbą zakupionych (max 9 widocznych slotów)
    const filled=i<Math.min(9,totalAc);
    if(filled){
      X.fillStyle=i%2===0?'#3a1818':'#2a1010';
      X.fillRect(px+1,ay+2,pW-3,ah-4);
      X.fillStyle='rgba(100,40,40,.4)';X.fillRect(px+3,ay+4,pW-7,ah-8);
      // Tekstura pianki — kropki
      X.fillStyle='rgba(0,0,0,.3)';
      for(let dx=4;dx<pW-4;dx+=6){for(let dy=6;dy<ah-8;dy+=6){X.fillRect(px+dx,ay+dy,2,2);}}
    } else {
      // Pusty slot — ciemniejszy
      X.fillStyle=i%2===0?'#222':'#1a1a1a';
      X.fillRect(px+1,ay+2,pW-3,ah-4);
      // Indykator "tu można zamontować" — szary plus
      X.fillStyle='rgba(120,120,120,.2)';X.font='14px Arial';X.textAlign='center';X.textBaseline='middle';
      X.fillText('+',px+pW/2,ay+ah/2);X.textAlign='left';X.textBaseline='alphabetic';
    }
  }
  /* v2.1.67 Amper: STUDIO + NICK GRACZA — auto-scaling czcionka w zależności od długości nicka. */
  const panelColor=foams>0||panels>0;
  X.shadowBlur=0;X.shadowColor='transparent';
  X.textAlign='center';X.textBaseline='alphabetic';
  const _nick=(G.globalNick||G.name||'PRODUCER').toUpperCase();
  const _prefix=panelColor?'🎤 STUDIO PRO':'🎙 STUDIO';
  const _label=`${_prefix} • ${_nick}`;
  /* Auto-fit: zaczynaj od 18px, zmniejszaj aż label się zmieści w 90% szerokości panelu */
  const _maxW=aw*0.9;
  let _fs=18;
  X.font=`bold ${_fs}px "Segoe UI",Arial,sans-serif`;
  while(_fs>9 && X.measureText(_label).width>_maxW){_fs--;X.font=`bold ${_fs}px "Segoe UI",Arial,sans-serif`;}
  X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=3;X.lineJoin='round';
  X.strokeText(_label,ax+aw/2,ay+ah/2+_fs/3);
  /* Wypełnienie gradient: złoto dla PRO, ciemne dla bazowego */
  const _txtGrad=X.createLinearGradient(ax,ay,ax,ay+ah);
  if(panelColor){_txtGrad.addColorStop(0,'#f1c40f');_txtGrad.addColorStop(.5,'#e91e8c');_txtGrad.addColorStop(1,'#c8a520');}
  else {_txtGrad.addColorStop(0,'#cfd8e0');_txtGrad.addColorStop(1,'#888a92');}
  X.fillStyle=_txtGrad;X.fillText(_label,ax+aw/2,ay+ah/2+_fs/3);
  X.textAlign='left';

  // Złote/platynowe nagrody (jeśli gracz ma wydane single)
  if((G.studioTracks||[]).length>0){
    const tracks=G.studioTracks;
    const goldCount=tracks.filter(t=>(t.streams||0)>=10000).length;
    const platCount=tracks.filter(t=>(t.streams||0)>=100000).length;
    if(goldCount>0||platCount>0){
      /* v2.1.52 Amper: tablica nagród przesunięta na ścianę po lewej obok kabiny (wcześniej kolidowała z plakatem prawym wx:880). */
      const wx0=wx2sx(56),wy0=wy2sy(360);
      X.fillStyle='rgba(0,0,0,.4)';X.fillRect(wx0+3,wy0+3,140,80);
      X.fillStyle='#3a2818';X.fillRect(wx0,wy0,140,80);
      X.fillStyle='#1a1208';X.fillRect(wx0+4,wy0+4,132,72);
      // Płyty na tablicy
      const slots=[[15,18],[55,18],[95,18],[15,48],[55,48],[95,48]];
      let idx=0;
      for(let i=0;i<platCount&&idx<6;i++){
        const [sx,sy]=slots[idx++];
        const cx=wx0+sx+10,cy=wy0+sy+10;
        const grd=X.createRadialGradient(cx,cy,2,cx,cy,11);
        grd.addColorStop(0,'#f8f8f8');grd.addColorStop(.6,'#a0a0a0');grd.addColorStop(1,'#505050');
        X.fillStyle=grd;X.beginPath();X.arc(cx,cy,10,0,Math.PI*2);X.fill();
        X.fillStyle='#0a0a0a';X.beginPath();X.arc(cx,cy,2,0,Math.PI*2);X.fill();
      }
      for(let i=0;i<goldCount&&idx<6;i++){
        const [sx,sy]=slots[idx++];
        const cx=wx0+sx+10,cy=wy0+sy+10;
        const grd=X.createRadialGradient(cx,cy,2,cx,cy,11);
        grd.addColorStop(0,'#fff4a0');grd.addColorStop(.6,'#d4a020');grd.addColorStop(1,'#7a5810');
        X.fillStyle=grd;X.beginPath();X.arc(cx,cy,10,0,Math.PI*2);X.fill();
        X.fillStyle='#0a0a0a';X.beginPath();X.arc(cx,cy,2,0,Math.PI*2);X.fill();
      }
      X.font='bold 10px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
      X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2;X.strokeText('🏆 NAGRODY',wx0+70,wy0-3);
      X.fillStyle='#f1c40f';X.fillText('🏆 NAGRODY',wx0+70,wy0-3);X.textAlign='left';
    }
  }

  /* v2.1.69 Amper: audio interface PRZESUNIĘTY WYŻEJ (iy:330 → iy:290), żeby nie kolidował z krzesłem które też jest w okolicy y=380-440. Mikser dekoracyjny (audio interface) ma być minimalnie wyżej. */
  const ix=wx2sx(895),iy=wy2sy(290),iw=130,ih=60;
  if(G.audioInterface){
    X.fillStyle='#0a0a1a';X.fillRect(ix,iy,iw,ih);
    X.fillStyle='#12122a';X.fillRect(ix+3,iy+3,iw-6,ih-6);
    const kc=['#e74c3c','#3498db','#2ecc71','#f39c12'];
    for(let i=0;i<4;i++){
      const kx=ix+13+i*(iw-14)/4,ky=iy+ih*.38;
      X.fillStyle='#222';X.beginPath();X.arc(kx,ky,6,0,Math.PI*2);X.fill();
      X.fillStyle=kc[i];X.beginPath();X.arc(kx,ky,4,0,Math.PI*2);X.fill();
      X.strokeStyle='#fff';X.lineWidth=1;X.beginPath();X.moveTo(kx,ky);X.lineTo(kx,ky-5);X.stroke();
    }
    for(let i=0;i<8;i++){
      X.fillStyle=i<5?'#27ae60':i<7?'#f39c12':'#e74c3c';
      X.fillRect(ix+5+i*13,iy+ih*.65,10,5);
    }
    X.fillStyle='#555';X.fillRect(ix+3,iy+ih*.5,6,ih*.35);
    X.font='bold 10px "Segoe UI",Arial,sans-serif';X.fillStyle='#3498db';X.textAlign='center';
    X.fillText('AUDIO',ix+iw/2,iy+ih-4);X.textAlign='left';
  }

  /* v2.1.69 Amper: krzesło PRZESUNIĘTE WYŻEJ (chY:380→340) żeby zostawić gap przed sofą która stoi niżej (wy:480). Środek krzesła = (960, 369). */
  const chX=wx2sx(931),chY=wy2sy(340),chW=58,chH=58;
  X.fillStyle='rgba(0,0,0,.25)';X.beginPath();X.ellipse(chX+chW/2,chY+chH+4,28,5,0,0,Math.PI*2);X.fill();
  X.fillStyle='#1a1a2a';X.fillRect(chX,chY,chW,chH);
  const chg=X.createLinearGradient(chX,chY,chX+chW,chY);
  chg.addColorStop(0,'#1a1a2a');chg.addColorStop(.5,'#2a2a3a');chg.addColorStop(1,'#1a1a2a');
  X.fillStyle=chg;X.fillRect(chX+4,chY+4,chW-8,chH*.55);
  X.fillStyle='#1e1e30';X.fillRect(chX+8,chY+chH*.55,chW-16,chH*.35);
  X.fillStyle='#333';
  [[chX+14,chY+chH],[chX+chW-14,chY+chH],[chX+chW/2,chY+chH]].forEach(([cx,cy])=>{
    X.beginPath();X.arc(cx,cy,3,0,Math.PI*2);X.fill();
  });

  /* Słuchawki — na ścianie obok audio interface (prawa strona). */
  if(G.headphones){
    const hpX=wx2sx(840),hpY=wy2sy(330);
    X.strokeStyle='#222';X.lineWidth=4;X.beginPath();X.arc(hpX,hpY,14,Math.PI,0);X.stroke();
    X.fillStyle='#222';X.beginPath();X.arc(hpX-14,hpY,5,0,Math.PI*2);X.fill();
    X.beginPath();X.arc(hpX+14,hpY,5,0,Math.PI*2);X.fill();
    /* Hak na ścianie */
    X.fillStyle='#555';X.fillRect(hpX-2,hpY-22,4,8);
  }

  /* v2.1.52 Amper: kabel XLR od kabiny do miksera (lewa→środek). */
  X.strokeStyle='rgba(180,80,80,.55)';X.lineWidth=2.5;X.setLineDash([4,3]);
  X.beginPath();X.moveTo(wx2sx(260),wy2sy(280));X.bezierCurveTo(wx2sx(340),wy2sy(330),wx2sx(420),wy2sy(330),wx2sx(490),wy2sy(310));X.stroke();
  /* Kabel od miksera do audio interface (środek→prawa). */
  X.strokeStyle='rgba(80,140,200,.55)';
  X.beginPath();X.moveTo(wx2sx(620),wy2sy(310));X.bezierCurveTo(wx2sx(720),wy2sy(360),wx2sx(820),wy2sy(340),wx2sx(880),wy2sy(330));X.stroke();
  X.setLineDash([]);

  /* v2.1.52 Amper: regał winyli przeniesiony na LEWĄ DOLNĄ ścianę pod tablicą nagród (nie pod kabinę). */
  {
    const rx=wx2sx(180),ry=wy2sy(440);
    // Cień
    X.fillStyle='rgba(0,0,0,.2)';X.fillRect(rx+4,ry+6,74,104);
    // Korpus regału
    const rg=X.createLinearGradient(rx,ry,rx+70,ry);
    rg.addColorStop(0,'#1e1a14');rg.addColorStop(.5,'#2e2820');rg.addColorStop(1,'#1a1610');
    X.fillStyle=rg;X.fillRect(rx,ry,70,100);
    // Półki
    X.fillStyle='#3a3020';
    [0,33,66].forEach(i=>{X.fillRect(rx+2,ry+i+30,66,4);});
    /* v2.1.228 audit-fix #69: winyle wyglądały jak książki na półce (10x24 px paski).
       Teraz: kwadratowe okładki LP 22x22 z czarnym kółkiem vinyla wystającym z jednej strony — wyraźnie rozpoznawalne jako vinyl. */
    const vcolors=['#8B0000','#004080','#2d5a1b','#5a1b5a','#1b3a5a','#7a3a0a'];
    for(let sh=0;sh<3;sh++){
      const shy=ry+sh*33+5;
      let vx=rx+3;
      for(let v=0;v<3;v++){
        // Okładka LP (22x22)
        X.fillStyle=vcolors[(v+sh)%vcolors.length];
        X.fillRect(vx,shy,22,22);
        X.strokeStyle='rgba(0,0,0,.4)';X.lineWidth=0.5;X.strokeRect(vx+.5,shy+.5,21,21);
        // Czarny krążek vinyla wystający z prawej strony okładki (3px)
        X.fillStyle='#0a0a0a';
        X.beginPath();X.arc(vx+22,shy+11,9,Math.PI*1.5,Math.PI*0.5);X.fill();
        // Złota nalepka na środku krążka
        X.fillStyle='#c8a520';
        X.beginPath();X.arc(vx+22,shy+11,3,Math.PI*1.5,Math.PI*0.5);X.fill();
        vx+=22;
      }
    }
    /* v2.1.67 Amper: napis VINYLS NAD regałem (ry-22), głośnik na BOKU regału (rx+74, po prawej stronie) — wcześniej głośnik na top (ry-34) zasłaniał napis. */
    X.font='bold 11px "Segoe UI",Arial,sans-serif';X.textAlign='center';X.textBaseline='alphabetic';
    X.strokeStyle='rgba(0,0,0,.85)';X.lineWidth=2.5;X.lineJoin='round';X.strokeText('💿 VINYLS',rx+35,ry-8);
    X.fillStyle='#f1c40f';X.fillText('💿 VINYLS',rx+35,ry-8);
    X.textAlign='left';
    /* Głośnik bookshelf — po PRAWEJ stronie regału (nie zasłania napisu) */
    const spx=rx+76,spy=ry+10;
    X.fillStyle='#111';X.fillRect(spx,spy,32,40);
    X.fillStyle='#222';X.fillRect(spx+2,spy+2,28,36);
    // Tweeter (góra)
    X.fillStyle='#333';X.beginPath();X.arc(spx+16,spy+10,5,0,Math.PI*2);X.fill();
    X.fillStyle='#555';X.beginPath();X.arc(spx+16,spy+10,3,0,Math.PI*2);X.fill();
    // Woofer (dół)
    const wg=X.createRadialGradient(spx+16,spy+27,0,spx+16,spy+27,11);
    wg.addColorStop(0,'#555');wg.addColorStop(.7,'#222');wg.addColorStop(1,'#111');
    X.fillStyle=wg;X.beginPath();X.arc(spx+16,spy+27,10,0,Math.PI*2);X.fill();
    X.strokeStyle='#444';X.lineWidth=1;X.beginPath();X.arc(spx+16,spy+27,9,0,Math.PI*2);X.stroke();
    // Logo głośnika — na środku boku, pod tweetterem
    X.fillStyle='rgba(255,200,80,.6)';X.font='4px Arial';X.textAlign='center';
    X.fillText('▶',spx+16,spy+38);X.textAlign='left';
  }
}

function drawMieszkanieDecorations(){
