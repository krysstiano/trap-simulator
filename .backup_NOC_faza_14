  };
  const nextUnlk=nextLvl?(LVL_UNLOCKS[nextLvl.level]||'+2 pkt umiejętności'):'';

  // ── Node graph layout ──
  // Left col (x=0): independent nodes. Right col (x=168): dependent nodes.
  const _GP={
    flow:        {x:0,  y:0},   teksty:  {x:168,y:0},
    produkcja:   {x:0,  y:70},  scena:   {x:168,y:70},
