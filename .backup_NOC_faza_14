    // ── Misja główna — sprawdzenie po nowym dniu ──
    if(G.mainMission&&G.mainMission.active&&!G.mainMission.failed){
      const mm=G.mainMission;
      /* v2.1.36: mainMission "Pierwsze 100/250/500/1000 fanów" sprawdza FANÓW LOJALNYCH (G.fans) */
      const totalFans=(G.fans||0);
      // Sprawdź milestone'y
      for(const ms of mm.milestones){
        if(!ms.done&&totalFans>=ms.fans){
          ms.done=true;
          /* v2.1.176: AUDYT — używaj earn() żeby aplikował Prestige moneyMult + mogul + streak + diamondHands + mood. */
          if(ms.reward.money){if(typeof earn==='function')earn(ms.reward.money,false);else{G.money+=ms.reward.money;G.totalEarned=(G.totalEarned||0)+ms.reward.money;}}
          if(ms.reward.xp) addXP(ms.reward.xp);
          if(ms.reward.followers) G.followers=(G.followers||0)+ms.reward.followers;
          if(ms.reward.fame){if(typeof addFame==='function')addFame(ms.reward.fame);else G.fame=clamp((G.fame||0)+ms.reward.fame,0,500);}
          showMsg(`🎯 ${ms.label}${ms.reward.money?' +'+ms.reward.money+' zł':''}${ms.reward.xp?' +'+ms.reward.xp+' XP':''}!`);
          addNotif(`🏆 Misja: ${ms.label}`);
          if(ms.fans>=1000){mm.active=false;} // misja ukończona
        }
      }
      // Sprawdź czy przegrana (30+ dni)
      if(mm.active&&!mm.failed){
        const daysElapsed=G.day-mm.startDay;
        if(daysElapsed>=mm.daysLimit&&totalFans<1000){
          mm.failed=true;
          G.money=Math.max(0,G.money-2000);
          G.fame=clamp((G.fame||0)-20,0,500);
          G.followers=Math.floor((G.followers||0)*0.7);
          showMsg('💔 Misja nieudana! Nie zdobyłeś 1000 fanów w 30 dni. -2000 zł, -20 sławy, -30% obserwujących','r');
          addNotif('❌ Misja: 30 dni minęło bez 1000 fanów');
          mm.active=false;
        }
      }
    }
    /* v2.1.133: dodano daily interest 1% — wcześniej pożyczka była "free loan forever" (1000→1200 raz, brak kapitalizacji). Teraz każdego dnia +1% do salda — gracz nie może trzymać 500k loan w nieskończoność. */
    if(G.bank.loan>0){const _interest=Math.ceil(G.bank.loan*0.01);G.bank.loan+=_interest;if(_interest>0)addNotif(`💳 Odsetki kredytu: +${_interest} zł (saldo ${G.bank.loan} zł)`);}
    // Spłata kredytu automatyczna jeśli masz pieniądze
    if(G.bank.loan>0&&G.money>=G.bank.loan){G.money-=G.bank.loan;addNotif('💳 Kredyt auto-spłacony!');G.bank.loan=0;}
    // Sprawdź dojrzałe inwestycje
    if(G.bank.investments&&G.bank.investments.length>0){
      const mature=G.bank.investments.filter(i=>i.returnDay<=G.day);
      const kept=G.bank.investments.filter(i=>i.returnDay>G.day);
      G.bank.investments=kept;
      for(const inv of mature){
        // F3-FIX: INWESTYCJE skill — bonus zwrotu z banku (max +15% skill, +50% PU3, evo Magnat z osobno)
        const _invMult = (typeof getInwestycjeBankBonus === 'function') ? getInwestycjeBankBonus() : 1;
        const baseRet = inv.returnAmount;
        const bonusGain = Math.floor(baseRet * (_invMult - 1));
        /* v1.9.18: Cap ROI na 2× initial amount (poprzednio bonus uncapped — Inwestycje +15% + PU3 +50% + Magnat evo dawało +95% nad baseRet = +ROI bez sufitu) */
        const _capRet = inv.amount*2;
        const totalRet = Math.min(_capRet, baseRet + bonusGain);
        /* v2.1.122: Wave 3 W32 — bonus część (skill+PU+evo) powinna mieć Prestige multiplier. Kapitał (inv.amount) bez mult, zysk z earn(). */
        G.money+=inv.amount; /* kapitał wraca bez Prestige */
        const _profitNet=totalRet-inv.amount;
        if(_profitNet>0){if(typeof earn==='function')earn(_profitNet,false);else G.money+=_profitNet;}
        /* v2.1.41 [Amper]: do totalEarned dodajemy tylko ZYSK NETTO (totalRet - inv.amount).
           Wcześniej dodawano cały totalRet — kapitał (już zarobione przed inwestycją) liczył się drugi raz w leaderboard.
           Exploit: inwestuj 1000→zwrot 1200→totalEarned+=1200 (powinno +=200). */
        const _profit = totalRet - inv.amount;
        if(_profit > 0){
          G.totalEarned=(G.totalEarned||0)+_profit;
          G.bank.totalInvestmentProfit = (G.bank.totalInvestmentProfit||0) + _profit;
        }
        /* v2.1.120: Wave 6 S51 — invest history tracker (zachowaj 20 ostatnich). */
        if(!Array.isArray(G.bank.investHistory)) G.bank.investHistory=[];
        G.bank.investHistory.push({amount:inv.amount,returnAmount:totalRet,returnDay:G.day,profit:_profit});
        if(G.bank.investHistory.length>20) G.bank.investHistory=G.bank.investHistory.slice(-20);
        if(bonusGain > 0){
          addNotif(`📈 Inwestycja: ${baseRet} zł + ${bonusGain} zł (skill Inwestycje +${Math.round((_invMult-1)*100)}%) = ${totalRet} zł!`);
        } else {
          addNotif(`📈 Inwestycja zwróciła ${totalRet} zł (zysk: +${totalRet-inv.amount} zł)!`);
        }
      }
    }
  }
}

function addXP(amount){
  // BALANS #67: User feedback "2 min = lvl 4" — multiplier 0.6→0.5, baza 100→150, krzywa 1.5→1.8
  // Stary: 100→150→225→337→506. Nowy: 150→270→486→874→1574 — gracz musi grindować.
  // F3-FIX-B: CZYTANIE skill+PU+evo (max ~+115% przy lvl 3 + PU3 + evo czyli "Mędrzec")
  /* v1.9.21: negative XP guard + cap G.level 100 anti-overflow */
  amount=Math.max(0, amount|0);
  if(G.level>=100) return;
  const _czytMult = 1 + _sk('czytanie')*0.05 + _pu('czytanie')*0.15;
  // Evolution Mędrzec: +1 darmowy pkt umie co 3 lvl postaci (osobny mechanizm — przy levelup)
  G.xp+=Math.round(amount*0.5*_czytMult);
  /* v1.9.21: while-loop dla multi-level — pojedynczy addXP(500) może dać 3 levele zamiast tylko 1 (poprzednio surplus carry, level skip) */
  let needed=Math.floor(150*Math.pow(1.8,G.level-1));
  while(G.xp>=needed && G.level<100){
    G.xp-=needed;G.level++;
