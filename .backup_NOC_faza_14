// Helper: zwraca tablicę kategorii wpisu (obsługuje stary `cat:'X'` i nowy `cats:[...]`)
function _patchEntryCats(p){
  if(Array.isArray(p.cats)) return p.cats;
  if(p.cat) return [p.cat];
  return [];
}
// v1.8.89: helper zwraca tablicę reporterów (beta-testerów którzy zgłosili)
function _patchEntryReporters(p){
  if(Array.isArray(p.reporters)) return p.reporters;
  if(p.reporter) return [p.reporter];
  return [];
}
// Deterministyczny kolor z nicku (hash → HSL)
function _reporterColor(nick){
  if(!nick) return '#9b59b6';
  let h=0;
  for(let i=0;i<nick.length;i++) h=(h*31+nick.charCodeAt(i))&0xffff;
  const hue=h%360;
  return `hsl(${hue},65%,55%)`;
}
let _patchFilterCat='all';
function showPatchNotes(){
  // Kolory i etykiety per typ wpisu
  const TYPE={
    add:     {bg:'#1c8045',fg:'#fff',lbl:'NOWE',  emoji:'✨',accent:'#27ae60'},
    feature: {bg:'#1c8045',fg:'#fff',lbl:'NOWE',  emoji:'✨',accent:'#27ae60'},
    fix:     {bg:'#a73026',fg:'#fff',lbl:'NAPRAWA',emoji:'🔧',accent:'#e74c3c'},
    change:  {bg:'#b87510',fg:'#fff',lbl:'ZMIANA',emoji:'🔄',accent:'#f39c12'},
  };
  // Podkreślanie ważnych słów/liczb w opisie. KOLEJNOŚĆ KRYTYCZNA:
  // 1) cudzysłowy MUSZĄ być pierwsze (zanim dodamy span ze style),
  //    inaczej regex łapie cudzysłowy ze STYLE jako "tekst".
  // 2) wszystkie style używają APOSTROFÓW, nie cudzysłowów.
  const highlight=(d)=>{
    let s=d;
    /* v2.1.21 KRYTYCZNE: escape `<` i `>` PIERWSZE — bez tego wpisy z `<style>`, `<br>` itp.
       konsumowały kolejne wpisy jako CSS/HTML content (user widział tylko do v2.0.3 z 444 wpisów).
       Plus zachowaj <br><br> z PATCH_NOTES (markdown-like line breaks używane w starych wpisach). */
    s=s.replace(/<br\s*\/?>/gi,'LINEBREAK'); /* zachowaj <br> */
    s=s.replace(/<b\b([^>]*)>([^<]*)<\/b>/gi,'BOLD_OPEN$2BOLD_CLOSE'); /* zachowaj <b> tags */
    s=s.replace(/</g,'&lt;').replace(/>/g,'&gt;'); /* escape reszty */
    s=s.replace(/LINEBREAK/g,'<br>');
    s=s.replace(/BOLD_OPEN([^]*)BOLD_CLOSE/g,'<b>$1</b>');
    /* Markdown **bold** → <b> (używane w wielu wpisach) */
    s=s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');
    /* Backticks `code` → <code> żeby wyglądało jak inline code */
    s=s.replace(/`([^`]+)`/g,"<code style='background:rgba(126,200,227,.12);color:#7ec8e3;padding:1px 5px;border-radius:3px;font-family:monospace;font-size:12px'>$1</code>");
    // 1) Cudzysłowy → niebieskie
    s=s.replace(/"([^"]+)"/g,
      "<span style='color:#7ec8e3;font-weight:600'>&quot;$1&quot;</span>");
    // 2) Słowa kluczowe wielką literą
    s=s.replace(/\b(NERF|BUFF|BUG|ROOT|CRITICAL|REBUILD|FIX|NAPRAWA)\b/g,
      "<span style='color:#e91e8c;font-weight:700'>$1</span>");
    // 3) Liczby z jednostkami zł/min/sek/%/× — wymagają BOUNDARY po jednostce
    s=s.replace(/(\d+[\d,.]*\s*(?:zł|min|sek|%|×))(?![a-zą곟żśćńó])/gi,
      "<span style='color:#f1c40f;font-weight:700'>$1</span>");
    return s;
  };
  // v1.8.88: filtrowanie obsługuje wpisy z wieloma kategoriami (cats:[...])
  // v1.8.88: filtrowanie obsługuje wpisy z wieloma kategoriami (cats:[...])
