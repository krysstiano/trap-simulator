      ${G.casinoChips>=10&&bet<10?`<div style="background:rgba(241,196,15,.15);border:1px solid rgba(241,196,15,.5);padding:10px;border-radius:10px;text-align:center;color:#f1c40f;font-size:13px;margin:10px auto;max-width:520px;font-weight:700">⚠️ Minimalna stawka: <b>10 żetonów</b>. Podnieś stawkę w polu poniżej.</div>`:''}
      ${bet>G.casinoChips&&G.casinoChips>=10?`<div style="background:rgba(241,196,15,.15);border:1px solid rgba(241,196,15,.5);padding:10px;border-radius:10px;text-align:center;color:#f1c40f;font-size:13px;margin:10px auto;max-width:520px;font-weight:700">⚠️ Stawka (${bet}) przekracza Twoje żetony (${G.casinoChips}). Obniż stawkę lub wymień więcej gotówki.</div>`:''}
      ${bet>5000?`<div style="background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.5);padding:10px;border-radius:10px;text-align:center;color:#f4a097;font-size:13px;margin:10px auto;max-width:520px;font-weight:700">⚠️ Maksymalna stawka: <b>5000 żetonów</b> (Twoja: ${bet})</div>`:''}
      <div style="text-align:center;margin-bottom:10px">
