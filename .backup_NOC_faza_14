/* v1.9.99: ukryj HUD i UI podczas cinematic flythrough — pure cinematic experience */
/* v2.1.21: visibility:hidden żeby HUD background gradient zniknął natychmiast (nie tylko opacity).
   Wcześniej HUD bg widać było pod letterboxem na większych viewportach (scale>1). */
body.cinematic-active #hud,
body.cinematic-active #minimap-wrap,
body.cinematic-active #quest-widget,
body.cinematic-active #hclock,
body.cinematic-active #ms-track-pill,
