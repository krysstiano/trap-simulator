function getDAWPluginCeiling(){
  // Max jakość bez wtyczek: 70%, z wtyczkami: do 100%
  /* v2.1.76 Amper: dodane drumPro (+8) i synth808 (+12) — wcześniej działały tylko w beat sequencerze (calcQuality linia ~15755), ale getDAWPluginCeiling ich nie liczyło, przez co sufit całego pipeline'u DAW był zaniżony dla graczy z beat pluginami. Cap Math.min(30) chroni przed inflacją. */
  const p=G.plugins||{};
  let bonus=0;
  if(p.eqPro) bonus+=8;if(p.punchComp) bonus+=10;if(p.reverbSpace) bonus+=8;if(p.deEsser) bonus+=6;if(p.tapeSat) bonus+=6;
  if(p.limiterLoud) bonus+=10;if(p.stereoImager) bonus+=8;if(p.multibandComp) bonus+=14;
  /* v2.1.102: BUFF kod do match UI — drumPro +10 (było +8, UI obiecuje +10%), synth808 +15 (było +12, UI obiecuje +15%) */
  if(p.drumPro) bonus+=10;if(p.synth808) bonus+=15;
  return Math.min(30,bonus); // max +30 above 70
}

