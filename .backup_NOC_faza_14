function addFriendship(npcId, amount){
  if(!G.npcFriendship) G.npcFriendship={};
  // v1.8.21: Networking skill boost — szybsze znajomości (+1 per lvl, +PU, +evo×2)
  const _netBonus=(typeof getNetworkingExtraContacts==='function')?getNetworkingExtraContacts():0;
  if(_netBonus>0 && amount>0) amount += Math.max(1, Math.floor(_netBonus));
  const old=G.npcFriendship[npcId]||0;
  /* v2.1.223 BUG #32 fix: clamp BOTH ends — wcześniej Math.min(100,...) blocked tylko top.
     Negative amount (np. L28702 `addFriendship(contactId,-2)`) mogło dawać friendship<0. */
  const nu=Math.max(0, Math.min(100, old+amount));
  G.npcFriendship[npcId]=nu;
  // Próg odblokowania
  if(old<25 && nu>=25) addNotif(`💚 ${npcId.toUpperCase()} — przyjaźń 25! Odblokowane lepsze opcje`);
  if(old<50 && nu>=50) addNotif(`💛 ${npcId.toUpperCase()} — przyjaźń 50! Bonusy aktywne`);
  if(old<75 && nu>=75) addNotif(`🧡 ${npcId.toUpperCase()} — przyjaźń 75! VIP traktowanie`);
  if(old<100 && nu>=100) showMsg(`❤️ ${npcId.toUpperCase()} — MAKSYMALNA PRZYJAŹŃ! Najlepsze nagrody.`);
}
function getFriendshipBonus(npcId){
  const f=G.npcFriendship?.[npcId]||0;
  if(f>=100) return 1.5;
  if(f>=75) return 1.3;
  if(f>=50) return 1.15;
  if(f>=25) return 1.05;
  return 1.0;
}
