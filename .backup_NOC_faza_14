  // ── HYDRANTY (czerwone, na chodnikach) — pozycje WALIDOWANE: nie kolidują z koszami/ławkami ──
  const hydrants=[
    // North chodnik H1 wy=330 (kosze: 280,680,980,1480,2080,2680,3280,3780; ławka: 1500,330)
