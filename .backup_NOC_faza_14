      if(comboMax>=5 && typeof showMsg==='function') showMsg(`🔥 Max combo ${comboMax}× — bonus +${bonusPoints} zł!`,'g',4000);
      cleanup();
    }
  },1000);

  cvs.addEventListener('mousemove',e=>{
    const rect=cvs.getBoundingClientRect();
    spongeX=(e.clientX-rect.left)*(700/rect.width);
    spongeY=(e.clientY-rect.top)*(280/rect.height);
    if(mouseDown&&hasSoap&&soapLevel>0&&gameActive){
      items.forEach(it=>{
        if(it.done)return;
        it.spots.forEach(s=>{
          if(!s.dirty)return;
          const dx=spongeX-s.x,dy=(spongeY-s.y)/0.5;
          // #83 Kran ON → 50% mniejsze zużycie mydła + większy zasięg gąbki (woda + mydło)
          const reach=faucetOn?s.r+18:s.r+14;
          if(Math.hypot(dx,dy)<reach){
            s.dirty=false;it.cleaned++;totalWashed++;
            emitCleanSparkle(s.x,s.y);
            emitBubbles(spongeX,spongeY-8,faucetOn?5:3);
            sfxBubble();
            soapLevel=Math.max(0,soapLevel-(faucetOn?1.25:2.5));
            const se=document.getElementById('zmwk-soap');if(se)se.textContent=Math.round(soapLevel);
            /* v2.1.175: COMBO — szybkie czyszczenie pod rząd = bonus */
            const _now=Date.now();
            if(_now-comboLastTime<1000) combo++; else combo=1;
            comboLastTime=_now;
            comboMax=Math.max(comboMax,combo);
            if(combo>=3) bonusPoints+=combo; /* combo >=3 daje bonus points */
            const ce=document.getElementById('zmwk-clean');if(ce)ce.textContent=totalWashed + (combo>=3?` 🔥 x${combo}`:'');
            /* Perfect plate detection — gdy wszystkie spoty 1 itemu doczyszczone w combo */
            if(it.spots.every(sp=>!sp.dirty) && !it.perfectShown){
              it.perfectShown=true;
              perfectFlashTime=40;
              perfectFlashLabel=`✨ PERFEKT! ${it.type.label}`;
              bonusPoints+=5; /* extra +5 punktów za perfect plate */
            }
            if(soapLevel<=0)hasSoap=false;
          }
        });
        if(it.spots.every(s=>!s.dirty))it.done=true;
      });
    }
  });

  cvs.addEventListener('mousedown',e=>{
    mouseDown=true;
    const rect=cvs.getBoundingClientRect();
    const mx=(e.clientX-rect.left)*(700/rect.width),my=(e.clientY-rect.top)*(280/rect.height);
    if(Math.hypot(mx-soapDispX,my-soapDispY)<32){
      hasSoap=true;soapLevel=Math.min(100,soapLevel+30);
      const se=document.getElementById('zmwk-soap');if(se)se.textContent=Math.round(soapLevel);
      const msg=document.getElementById('zmwk-msg');
      if(msg){msg.textContent='Nabrano płynu!';setTimeout(()=>{if(msg)msg.textContent='';},1200);}
    }
    // #83 Kran — odkręca/zakręca wodę. Woda+mydło = lepsze mycie (+50% szybkość, mniejsze zużycie mydła)
    if(Math.hypot(mx-fx,my-(fy-22))<28){
      faucetOn=!faucetOn;
      const msg=document.getElementById('zmwk-msg');
      if(msg){msg.textContent=faucetOn?'💧 Kran ON — szybkie mycie!':'💧 Kran zakręcony';setTimeout(()=>{if(msg)msg.textContent='';},1400);}
    }
  });
  cvs.addEventListener('mouseup',()=>{mouseDown=false;});
  cvs.addEventListener('mouseleave',()=>{mouseDown=false;});

  function draw(){
    if(!gameActive&&el.style.display==='none')return;
    /* v2.1.175: combo decay — reset combo jeśli >1s bez czyszczenia */
    if(combo>0 && Date.now()-comboLastTime>1200){combo=0;}
    // #83 Tło kuchni — kafelki ścian
    const bg=cx.createLinearGradient(0,0,0,280);
    bg.addColorStop(0,'#1a2230');bg.addColorStop(1,'#0e1622');
    cx.fillStyle=bg;cx.fillRect(0,0,700,280);
    // Subtelna siatka kafelków ścian
    cx.strokeStyle='rgba(255,255,255,.03)';cx.lineWidth=1;
    for(let y=0;y<110;y+=22){cx.beginPath();cx.moveTo(0,y);cx.lineTo(700,y);cx.stroke();}
    for(let x=0;x<700;x+=44){cx.beginPath();cx.moveTo(x,0);cx.lineTo(x,110);cx.stroke();}
    // #83 Blat granitowy nad zlewem
    const blat=cx.createLinearGradient(0,100,0,115);
    blat.addColorStop(0,'#3a3a45');blat.addColorStop(1,'#5a5a65');
    cx.fillStyle=blat;cx.fillRect(20,100,610,12);
    cx.strokeStyle='#222';cx.lineWidth=1;cx.strokeRect(20,100,610,12);
    // #83 Sink — stalowy, z głębszym wyglądem
    const sinkG=cx.createLinearGradient(30,110,30,250);
    sinkG.addColorStop(0,'#0c1a26');sinkG.addColorStop(.5,'#0a1828');sinkG.addColorStop(1,'#08141e');
    cx.fillStyle=sinkG;cx.fillRect(30,110,600,140);
    // Stalowa krawędź sink
    cx.strokeStyle='#3a4a5a';cx.lineWidth=3;cx.strokeRect(30,110,600,140);
    cx.strokeStyle='#5a6a7a';cx.lineWidth=1;cx.strokeRect(31,111,598,138);
    // Woda w zlewie (lekko niebieska)
    cx.fillStyle='rgba(40,90,140,0.20)';cx.fillRect(32,112,596,136);
    // Water shimmer
    for(let i=0;i<4;i++){
      cx.strokeStyle=`rgba(80,160,230,${0.08+Math.sin(Date.now()/1000+i)*0.04})`;
      cx.lineWidth=1;cx.beginPath();cx.moveTo(32,130+i*20);cx.lineTo(628,130+i*20);cx.stroke();
    }
    // #83 Odpływ
    cx.fillStyle='#222';cx.beginPath();cx.arc(330,235,8,0,Math.PI*2);cx.fill();
    cx.fillStyle='#444';for(let i=0;i<6;i++){const a=i*Math.PI/3;cx.fillRect(330+Math.cos(a)*4-1,235+Math.sin(a)*4-1,2,2);}
    // #83 Faucet (bateria) — większa, profesjonalna
    // Mocowanie do blatu
    cx.fillStyle='#7a9aaa';cx.fillRect(fx-9,fy-12,18,12);
    // Pionowa rura
    const pipeG=cx.createLinearGradient(fx-7,fy-42,fx+7,fy-42);
    pipeG.addColorStop(0,'#6a8a9a');pipeG.addColorStop(.5,'#9ac0d8');pipeG.addColorStop(1,'#6a8a9a');
    cx.fillStyle=pipeG;cx.fillRect(fx-7,fy-44,14,42);
    // Spout horizontal (zakrzywiony)
    cx.fillStyle='#8ab0c8';cx.beginPath();
    cx.moveTo(fx-7,fy-44);cx.lineTo(fx-7,fy-52);cx.lineTo(fx-3,fy-56);cx.lineTo(fx+3,fy-56);cx.lineTo(fx+7,fy-52);cx.lineTo(fx+7,fy-44);cx.closePath();cx.fill();
    // Knob (gałka) — duża, klikalna
    cx.fillStyle=faucetOn?'#27ae60':'#3a4a5a';
    cx.beginPath();cx.arc(fx,fy-50,7,0,Math.PI*2);cx.fill();
    cx.strokeStyle='#fff';cx.lineWidth=1.5;cx.beginPath();cx.arc(fx,fy-50,7,0,Math.PI*2);cx.stroke();
    // Hint click — ramka pulsująca gdy zakręcony
    if(!faucetOn){
      const pulse=0.4+Math.sin(Date.now()/300)*0.3;
      cx.strokeStyle=`rgba(255,220,80,${pulse})`;cx.lineWidth=2;
      cx.beginPath();cx.arc(fx,fy-50,11,0,Math.PI*2);cx.stroke();
    }
    // Water stream — gdy odkręcony
    if(faucetOn){
      const wt=Date.now();
      cx.fillStyle='rgba(100,180,255,0.55)';
      cx.beginPath();cx.moveTo(fx-3,fy);cx.lineTo(fx-5+Math.sin(wt*.01),fy+28);cx.lineTo(fx+5+Math.sin(wt*.01),fy+28);cx.lineTo(fx+3,fy);cx.fill();
      cx.fillStyle='rgba(150,210,255,0.4)';
      cx.beginPath();cx.ellipse(fx+Math.sin(wt*.01),fy+30,7,3.5,0,0,Math.PI*2);cx.fill();
      if(Math.random()<0.35)emitWaterDrops(fx,fy+30,2);
    }
    // #83 Etykieta kranu — JASNA logika
    cx.font='bold 12px "Segoe UI",Arial';cx.textAlign='center';
    cx.strokeStyle='rgba(0,0,0,.85)';cx.lineWidth=3;
    cx.strokeText(faucetOn?'💧 WODA — ON':'💧 WODA — OFF',fx,fy-66);
    cx.fillStyle=faucetOn?'#7ee87e':'#aab8c4';
    cx.fillText(faucetOn?'💧 WODA — ON':'💧 WODA — OFF',fx,fy-66);
    cx.font='10px "Segoe UI",Arial';
    const subText=faucetOn?'+50% szybkość, -50% mydło':'Klik = odkręć';
    cx.strokeText(subText,fx,fy-78);
    cx.fillStyle='#c0d0e0';cx.fillText(subText,fx,fy-78);
    cx.textAlign='left';
    // Draw items
    items.forEach(it=>{
      const {type,x,y,r,spots,done}=it;
      type.draw(cx,x,y,r);
      spots.forEach(s=>{
        if(s.dirty){
          cx.fillStyle='rgba(100,60,15,0.7)';
          cx.beginPath();cx.ellipse(s.x,s.y,s.r*0.9,s.r*0.45,0,0,Math.PI*2);cx.fill();
        }
      });
      if(done){
        cx.fillStyle='rgba(40,200,100,0.35)';
        cx.beginPath();cx.ellipse(x,y,r*1.1,r*.45,0,0,Math.PI*2);cx.fill();
        cx.fillStyle='#27ae60';cx.font='bold 16px Arial';cx.textAlign='center';
        cx.fillText('✓',x,y+5);cx.textAlign='left';
      }
      cx.fillStyle='#cdd';cx.font='bold 12px "Segoe UI",Arial,sans-serif';cx.textAlign='center';
      cx.strokeStyle='rgba(0,0,0,.65)';cx.lineWidth=2.5;cx.strokeText(it.type.label,x,y+r+18);
      cx.fillText(it.type.label,x,y+r+18);cx.textAlign='left';
    });
    // Soap dispenser (dish soap bottle)
    const sdx=soapDispX,sdy=soapDispY;
    cx.fillStyle='#1a7a3a';cx.fillRect(sdx-14,sdy-50,28,60);
    cx.fillStyle='#2a9a5a';cx.beginPath();cx.arc(sdx,sdy-50,10,Math.PI,0);cx.fill();
    cx.fillStyle='#aaa';cx.fillRect(sdx-4,sdy-64,8,14);cx.fillRect(sdx-2,sdy-68,4,6);
    cx.fillStyle='#7ec8e3';cx.font='bold 12px "Segoe UI",Arial';cx.textAlign='center';
    cx.strokeStyle='rgba(0,0,0,.7)';cx.lineWidth=2.5;cx.strokeText('PŁYN',sdx,sdy+22);
    cx.fillText('PŁYN',sdx,sdy+22);
    cx.fillStyle='#9ab0c0';cx.font='9px "Segoe UI",Arial';
    cx.strokeText('Klik = nabierz',sdx,sdy+34);
    cx.fillText('Klik = nabierz',sdx,sdy+34);
    cx.fillStyle='#27ae60';cx.font='bold 13px "Segoe UI",Arial';
    cx.strokeText(`${Math.round(soapLevel)}%`,sdx,sdy-10);
    cx.fillText(`${Math.round(soapLevel)}%`,sdx,sdy-10);cx.textAlign='left';
    // Soap fill meter on bottle
    const fillH=Math.round(soapLevel/100*56);
    cx.fillStyle=`rgba(40,180,80,0.4)`;cx.fillRect(sdx-12,sdy-48+56-fillH,24,fillH);
    // Sponge
    cx.fillStyle=hasSoap?'#c8e840':'#d4a020';
    cx.beginPath();
    if(cx.roundRect)cx.roundRect(spongeX-16,spongeY-11,32,22,5);
    else cx.rect(spongeX-16,spongeY-11,32,22);
    cx.fill();
    // Sponge texture
    cx.fillStyle='rgba(0,0,0,.15)';
    for(let i=0;i<4;i++)for(let j=0;j<2;j++){cx.fillRect(spongeX-12+i*8,spongeY-7+j*8,5,5);}
    if(hasSoap&&soapLevel>0){
      cx.fillStyle='rgba(200,240,60,.25)';cx.beginPath();cx.arc(spongeX,spongeY,24,0,Math.PI*2);cx.fill();
      // Soap bubbles
      for(let i=0;i<3;i++){
        cx.strokeStyle='rgba(200,255,100,.5)';cx.lineWidth=1;
        cx.beginPath();cx.arc(spongeX+Math.sin(Date.now()/500+i)*15,spongeY-18+i*4,4+i,0,Math.PI*2);cx.stroke();
      }
    }
    if(soapLevel<=0){
      cx.fillStyle='rgba(180,40,40,.9)';cx.font='bold 13px "Segoe UI",Arial';cx.textAlign='center';
      cx.fillText('⚠ Brak płynu! Kliknij dozownik →',340,268);cx.textAlign='left';
    }
    // Update + render particles (bańki, krople, sparkle)
    for(let i=fx_particles.length-1;i>=0;i--){
      const p=fx_particles[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.type==='bubble'){p.vy*=0.98;p.x+=Math.sin(Date.now()/300+i)*0.4;}
      else if(p.type==='water'){p.vy+=0.35;}
      else if(p.type==='sparkle'){p.vx*=0.92;p.vy*=0.92;}
      p.life--;
      const a=Math.max(0,p.life/p.max);
      if(p.type==='bubble'){
        cx.strokeStyle=`rgba(200,255,180,${a*0.85})`;cx.lineWidth=1.2;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.stroke();
        cx.fillStyle=`rgba(255,255,255,${a*0.4})`;
        cx.beginPath();cx.arc(p.x-p.size*0.3,p.y-p.size*0.3,p.size*0.3,0,Math.PI*2);cx.fill();
      } else if(p.type==='water'){
        cx.fillStyle=`rgba(120,200,255,${a*0.85})`;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.fill();
      } else if(p.type==='sparkle'){
        cx.shadowBlur=4;cx.shadowColor='#ffe066';
        cx.fillStyle=`rgba(255,240,120,${a})`;
        cx.beginPath();cx.arc(p.x,p.y,p.size,0,Math.PI*2);cx.fill();
        cx.shadowBlur=0;
      }
      if(p.life<=0)fx_particles.splice(i,1);
    }
    /* v2.1.175: Perfect-plate flash + combo indicator */
    if(perfectFlashTime>0){
      perfectFlashTime--;
      const fa=perfectFlashTime/40;
      cx.fillStyle=`rgba(255,220,80,${fa*0.18})`;cx.fillRect(0,0,700,280);
      cx.font='bold 22px "Segoe UI",Arial';cx.textAlign='center';
      cx.strokeStyle='rgba(0,0,0,.85)';cx.lineWidth=4;cx.strokeText(perfectFlashLabel,350,80);
      cx.fillStyle=`rgba(255,220,80,${fa})`;cx.fillText(perfectFlashLabel,350,80);cx.textAlign='left';
    }
    if(combo>=3){
      cx.font='bold 18px "Segoe UI",Arial';cx.textAlign='center';
      cx.strokeStyle='rgba(0,0,0,.85)';cx.lineWidth=3;cx.strokeText(`🔥 COMBO ×${combo}`,350,260);
      cx.fillStyle='#f1c40f';cx.fillText(`🔥 COMBO ×${combo}`,350,260);cx.textAlign='left';
    }
    // Win check
    if(items.every(it=>it.done)&&gameActive){
      gameActive=false;
      earned=32; // #84 NERF: pełna zmiana = 32 zł (poprzednio 45)
      /* v2.1.175: COMBO bonus dodany do pełnej zmiany */
      earned+=bonusPoints;
      earned=Math.floor(earned*getPracaBonus('zmywak')); // F3-FIX-B
      const nightBonus=G.timeOfDay===3;if(nightBonus)earned=Math.floor(earned*1.3);
      if(G.managementDeal)earned=Math.floor(earned*G.managementBonus);
      /* v2.1.177: round do najbliższego 5 zł — czystszy odbiór dla gracza */
      earned=Math.round(earned/5)*5;
      G.energy=clampStat('energy', G.energy-3); // v1.8.59: zmywak 6→3 (-70% od oryginału 10)
      /* v2.1.120: Wave 6 N19 — rep konsystencja zmywak: +1 rep co 5 ukończonych pełnych zmian. */
      G._zmCount=(G._zmCount||0)+1;
      if(G._zmCount%5===0){G.streetRep=Math.min(100,(G.streetRep||0)+1);if(typeof addNotif==='function')addNotif('🫧 +1 rep uliczna (5 pełnych zmian — szanują Cię w kuchni)');}
      cx.fillStyle='rgba(0,0,0,.75)';cx.fillRect(0,0,700,280);
      cx.fillStyle='#27ae60';cx.font='bold 26px "Segoe UI",Arial';cx.textAlign='center';
      cx.fillText(`Wszystko czyste! +${earned} zł`,350,120);
      if(comboMax>=3){
        cx.fillStyle='#f1c40f';cx.font='bold 18px "Segoe UI",Arial';
        cx.fillText(`🔥 Max combo: ${comboMax}× · bonus +${bonusPoints} zł`,350,156);
      }
      cx.textAlign='left';
      /* v2.1.183 (Agent minigame audit): missing progressQuest('zmywak') w pełnym clear path. Wcześniej tylko timeout (L23683) wywoływał, więc storyline NIE zaliczał prawidłowego sukcesu zmywaka. Earn jest płacony przez cleanup() L23982. */
      if(typeof progressQuest==='function') progressQuest('zmywak');
      closeJobPanelAfter(3200);cleanup();return; // v1.8.44: 2200→3200ms (spójność z carwash/construction)
    }
    if(gameActive) requestAnimationFrame(draw);
  }
  draw();

  window._jobMgCleanup=()=>{
    gameActive=false;
    // Sprawdź session token — jeśli już startuje nowa minigra (np. zmywak po szybkim restarcie),
    // ten cleanup nie powinien zamykać NOWEGO okna
    if(_jobPanelSession!==_sessId) return;
    if(window._zmwkTimer){clearInterval(window._zmwkTimer);window._zmwkTimer=null;}
    el.classList.remove('on');el.style.display='none';
    el.innerHTML='<div id="mg-job-content"></div>';
    // Reset kursora — canvas miał cursor:none, po wyjściu wymuszamy default na body
    document.body.style.cursor='';
    if(earned>0){earn(earned);addXP(5);updateHUD();}
  };
}

