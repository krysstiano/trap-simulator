    if(G.streetRep>=90)G.streetRep=clamp(G.streetRep-1,0,100);
    // #77 BUG FIX: TV/Rośliny dają DZIENNY bonus nastroju (nie tylko jednorazowy przy zakupie)
    const _furn=G.aptPurchases?.furniture||[];
