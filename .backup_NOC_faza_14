window.drawPreviewPlayer = function(canvasEl, outfitId){
  const ctx = canvasEl.getContext('2d');
  ctx.clearRect(0,0,canvasEl.width,canvasEl.height);
  const scale = canvasEl.width / 32;
  ctx.save();
  ctx.scale(scale, scale);
  const cw = canvasEl.width/scale;
  const ch = canvasEl.height/scale;
  const cx = cw/2;
  const sy = 2;
  const w = 28, h = 36;
  const sc = SKIN_COLS[P.skin]||SKIN_COLS.light;
  const oc = (G.outfitColors && G.outfitColors[outfitId]) || {};
  // Default body color z _OUTFIT_COLOR_SLOTS
  const defSlot = (_OUTFIT_COLOR_SLOTS[outfitId] || []).find(s => s.key === 'body');
  const defAccentSlot = (_OUTFIT_COLOR_SLOTS[outfitId] || []).find(s => s.key === 'accent');
  const cc = oc.body || (defSlot && defSlot.def) || P.cloth || '#2a5080';
  const accent = oc.accent || (defAccentSlot && defAccentSlot.def) || '#f1c40f';
  const pc = P.pants||G.pants||'#1a2a3a';
  const shc = P.shoes||G.shoes||'#0a0a0a';
  // Cień
  ctx.fillStyle='rgba(0,0,0,.3)';
  ctx.beginPath(); ctx.ellipse(cx, sy+h-1, 11, 3, 0, 0, Math.PI*2); ctx.fill();
  // Spodnie
  ctx.fillStyle = pc;
  ctx.fillRect(cx-9, sy+h*.64, 9, h*.32);
  ctx.fillRect(cx, sy+h*.64, 9, h*.32);
  // Buty
  ctx.fillStyle = shc;
  ctx.beginPath(); ctx.ellipse(cx-5, sy+h-2, 6, 3, 0, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(cx+5, sy+h-2, 6, 3, 0, 0, Math.PI*2); ctx.fill();
  // Tors (kolor outfit)
  ctx.fillStyle = cc;
  ctx.fillRect(cx-12, sy+h*.42, 24, h*.24);
  // Kołnierz lighter
  ctx.fillStyle = lightenHex(cc, 15);
  ctx.fillRect(cx-12, sy+h*.42, 24, 3);
  // Ramiona — outfit overlay (sport/sport_pro mają skin, inne kolor outfit)
  if(outfitId === 'sport' || outfitId === 'sport_pro') ctx.fillStyle = sc;
  else if(outfitId === 'default') ctx.fillStyle = sc;
  else ctx.fillStyle = cc;
  ctx.fillRect(cx-17, sy+h*.43, 5, h*.22);
  ctx.fillRect(cx+12, sy+h*.43, 5, h*.22);
  // Szyja
  ctx.fillStyle = sc;
  ctx.fillRect(cx-4, sy+h*.36, 8, h*.07);
  // Głowa
  ctx.fillRect(cx-11, sy+h*.10, 22, 18);
  ctx.beginPath(); ctx.arc(cx, sy+h*.10+3, 11, Math.PI, 0); ctx.fill();
  // Włosy
  ctx.fillStyle = '#3a2010';
  ctx.beginPath(); ctx.arc(cx, sy+h*.10+5, 10, Math.PI, 0); ctx.fill();
  // Oczy — sync z drawPlayer v1.8.29 (białka + źrenice + highlight)
  ctx.fillStyle = 'rgba(255,255,255,.85)';
  ctx.beginPath(); ctx.arc(cx-4, sy+h*.24, 2.4, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+4, sy+h*.24, 2.4, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = 'rgba(20,20,40,.95)';
  ctx.beginPath(); ctx.arc(cx-4, sy+h*.24, 1.4, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+4, sy+h*.24, 1.4, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,.9)';
  ctx.beginPath(); ctx.arc(cx-4.4, sy+h*.235, 0.5, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(cx+3.6, sy+h*.235, 0.5, 0, Math.PI*2); ctx.fill();
  // Uśmiech — szerszy, łagodniejszy łuk
  ctx.strokeStyle = 'rgba(40,15,15,.7)';
  ctx.lineWidth = 1.3; ctx.lineCap = 'round';
  ctx.beginPath(); ctx.arc(cx, sy+h*.31, 3.5, 0.15*Math.PI, 0.85*Math.PI); ctx.stroke();
  ctx.lineCap = 'butt';

  // OUTFIT-SPECIFIC ZNACZNIK (uproszczony — kluczowy element)
  const torsoY = sy + h*.42;
  const torsoH = h*.24;
  if(outfitId === 'suit'){
    // Marynarka czarna na środku V + krawat
    ctx.fillStyle = '#0a0a1a';
    ctx.beginPath();
    ctx.moveTo(cx-12, torsoY); ctx.lineTo(cx-3, torsoY); ctx.lineTo(cx-1, torsoY+5);
    ctx.lineTo(cx-3, torsoY+torsoH); ctx.lineTo(cx-12, torsoY+torsoH); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx+12, torsoY); ctx.lineTo(cx+3, torsoY); ctx.lineTo(cx+1, torsoY+5);
    ctx.lineTo(cx+3, torsoY+torsoH); ctx.lineTo(cx+12, torsoY+torsoH); ctx.closePath(); ctx.fill();
    // Krawat
    ctx.fillStyle = oc.tie || '#8b1a2a';
    ctx.fillRect(cx-2, torsoY+1, 4, torsoH-1);
  } else if(outfitId === 'smoking'){
    ctx.fillStyle = '#000';
    ctx.fillRect(cx-12, torsoY, 24, torsoH);
    // Biała koszula V
    ctx.fillStyle = '#fff';
    ctx.fillRect(cx-3, torsoY, 6, torsoH);
    // Mucha
    ctx.fillStyle = '#000';
    ctx.beginPath();
    ctx.moveTo(cx-3, torsoY); ctx.lineTo(cx-3, torsoY+3); ctx.lineTo(cx, torsoY+1.5);
    ctx.lineTo(cx+3, torsoY+3); ctx.lineTo(cx+3, torsoY); ctx.closePath(); ctx.fill();
  } else if(outfitId === 'street' || outfitId === 'zimowa'){
    // Kaptur za głową
    ctx.fillStyle = darkenHex(cc, 25);
    ctx.beginPath();
    ctx.ellipse(cx, sy+h*.36, 13, 5, 0, 0, Math.PI);
    ctx.fill();
  } else if(outfitId === 'sport' || outfitId === 'sport_pro'){
    // Opaska
    ctx.fillStyle = accent;
    ctx.fillRect(cx-11, sy+h*.16, 22, 2);
    // Akcent dol koszulki
    ctx.fillRect(cx-12, torsoY+torsoH-1.5, 24, 1.5);
  } else if(outfitId === 'music'){
    // Złoty łańcuch
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.ellipse(cx, torsoY+1, 6, 1.5, 0, 0, Math.PI);
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx, torsoY+3); ctx.lineTo(cx-2.5, torsoY+5.5);
    ctx.lineTo(cx, torsoY+8); ctx.lineTo(cx+2.5, torsoY+5.5); ctx.closePath();
    ctx.fill();
  } else if(outfitId === 'luxury'){
    // Gruby łańcuch + diamond
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.ellipse(cx, torsoY+1, 7, 2, 0, 0, Math.PI);
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx, torsoY+3); ctx.lineTo(cx-3, torsoY+6.5);
    ctx.lineTo(cx, torsoY+10); ctx.lineTo(cx+3, torsoY+6.5); ctx.closePath();
    ctx.fill();
    // Epolety
    ctx.fillRect(cx-17, torsoY+1, 5, 1.5);
    ctx.fillRect(cx+12, torsoY+1, 5, 1.5);
  } else if(outfitId === 'designer_concert'){
    // Zigzag akcent
    ctx.strokeStyle = accent;
    ctx.lineWidth = 1.3;
    ctx.beginPath();
    ctx.moveTo(cx-10, torsoY+3); ctx.lineTo(cx-7, torsoY+5);
    ctx.lineTo(cx-3, torsoY+3); ctx.lineTo(cx, torsoY+5);
    ctx.lineTo(cx+3, torsoY+3); ctx.lineTo(cx+7, torsoY+5);
    ctx.lineTo(cx+10, torsoY+3);
    ctx.stroke();
  } else if(outfitId === 'jeansowa'){
    // 2 kieszenie
    ctx.fillStyle = darkenHex(cc, 25);
    ctx.fillRect(cx-9, torsoY+5, 5, 3);
    ctx.fillRect(cx+4, torsoY+5, 5, 3);
    // Mosiężne guziki
    ctx.fillStyle = '#c89020';
    ctx.beginPath(); ctx.arc(cx-6.5, torsoY+6.5, 0.5, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx+6.5, torsoY+6.5, 0.5, 0, Math.PI*2); ctx.fill();
  } else if(outfitId === 'polo'){
    // Kołnierzyk V
    ctx.fillStyle = lightenHex(cc, 25);
    ctx.beginPath();
    ctx.moveTo(cx-7, torsoY); ctx.lineTo(cx-2, torsoY+4); ctx.lineTo(cx-2, torsoY); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(cx+7, torsoY); ctx.lineTo(cx+2, torsoY+4); ctx.lineTo(cx+2, torsoY); ctx.closePath(); ctx.fill();
  }
  ctx.restore();
};

window.setOutfitColor = function(outfitId, key, hex){
  if(!G.outfitColors) G.outfitColors = {};
  if(!G.outfitColors[outfitId]) G.outfitColors[outfitId] = {};
  G.outfitColors[outfitId][key] = hex;
  // Jeśli zmieniany jest aktywny outfit — od razu zaktualizuj P.cloth dla "body"
  if(G.outfit && G.outfit.top === outfitId && key === 'body'){
    P.cloth = hex;
  }
  if(typeof renderWardrobeChange === 'function') renderWardrobeChange();
};

function _renderColorPalette(outfitId){
  const slots = _OUTFIT_COLOR_SLOTS[outfitId] || [];
  if(slots.length === 0) return '';
  const oc = (G.outfitColors && G.outfitColors[outfitId]) || {};
  let html = '<div style="background:#1a1a2a;border:1px solid #2a3a50;border-radius:8px;padding:12px;margin-top:10px">';
  html += '<div style="color:#7ec87e;font-size:11px;font-weight:700;letter-spacing:1px;margin-bottom:8px">🎨 KOLORY OUTFITA</div>';
  for(const slot of slots){
    const cur = oc[slot.key] || slot.def;
    html += `<div style="margin-bottom:10px"><div style="color:#aac;font-size:12px;margin-bottom:4px">${slot.label}: <span style="color:${cur};font-weight:700">${(slot.palette.find(p=>p.hex===cur)||{}).name||'własny'}</span></div>`;
    html += '<div style="display:flex;gap:4px;flex-wrap:wrap">';
    for(const c of slot.palette){
      const sel = c.hex === cur ? 'border:2px solid #fff;box-shadow:0 0 8px rgba(255,255,255,0.5)' : 'border:2px solid #333';
      html += `<button onclick="setOutfitColor('${outfitId}','${slot.key}','${c.hex}')" title="${c.name}" style="width:28px;height:28px;background:${c.hex};${sel};border-radius:6px;cursor:pointer;padding:0"></button>`;
    }
    html += '</div></div>';
  }
  html += '</div>';
  return html;
}

