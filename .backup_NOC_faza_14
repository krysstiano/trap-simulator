/* v2.1.107: Lyrics minigame — Wave 7 K63 ZAIMPLEMENTOWANE.
   Mechanika: 8 par rymów (np. "deszcz / dreszcz" / "miasto / piasto") wyświetlone losowo. Gracz klika pary które się rymują.
   Quality: hits/8 × 100 + skill bonus. Energy -15. */
window.dawStartLyricsMG=()=>{
  const ct=G.currentTrack;
  if(!ct || !(ct.beatQ>0)){showMsg('📝 Najpierw stwórz beat!','r');return;}
  if((G.energy||0)<15){showMsg('⚡ Za mało energii (15)','r');return;}
  closeOverlay();
  const RHYME_POOL=[
    {a:'deszcz',b:'dreszcz'},{a:'noc',b:'moc'},{a:'flow',b:'show'},{a:'beat',b:'street'},
    {a:'rap',b:'trap'},{a:'cash',b:'flash'},{a:'mic',b:'click'},{a:'dym',b:'rym'},
    {a:'krew',b:'gniew'},{a:'czas',b:'głos'},{a:'serce',b:'śmierć'},{a:'bóg',b:'wróg'},
    {a:'dom',b:'tom'},{a:'sen',b:'pień'},{a:'cień',b:'dzień'},{a:'krwi',b:'dni'}
  ];
  /* Wybierz 8 par losowo */
  const _shuffled=[...RHYME_POOL].sort(()=>Math.random()-0.5);
  const _pairs=_shuffled.slice(0,8);
  /* Stwórz listę 16 słów (8 par) wymieszanych */
  const _words=[];
  _pairs.forEach((p,i)=>{
    _words.push({txt:p.a,pair:i,matched:false});
    _words.push({txt:p.b,pair:i,matched:false});
  });
  _words.sort(()=>Math.random()-0.5);
  let _selected=-1;
  let _hits=0;
  let _misses=0;
  let _combo=0;  /* v2.1.149: combo system — consecutive hits bez missów */
  let _maxCombo=0;  /* v2.1.149: max combo w tym minigame */
  let _tStart=Date.now();
  const TIME_LIMIT=60000; /* 60s */
  const panel=document.getElementById('mg-job');
  panel.style.display='';panel.innerHTML='';panel.classList.add('on');
  const render=()=>{
    const _elapsed=Date.now()-_tStart;
    const _remain=Math.max(0,Math.ceil((TIME_LIMIT-_elapsed)/1000));
    const _done=_pairs.every((_,i)=>_words.filter(w=>w.pair===i&&w.matched).length===2);
    let html=`<div style="padding:20px;text-align:center;max-width:600px;margin:0 auto;color:#fff">
      <h2 style="color:#9b59b6;font-size:22px;margin-bottom:6px">📝 Piszesz teksty</h2>
      <p style="color:#aaa;font-size:13px;margin-bottom:14px">Klikaj pary słów które się rymują (8 par). Czas: <b style="color:${_remain<15?'#e74c3c':'#aaa'}">${_remain}s</b> · Trafienia: <b style="color:#2ecc71">${_hits}</b>/8 · Pudła: <b style="color:#e74c3c">${_misses}</b>${_combo>=2?` · <b style="color:#f39c12">🔥 Combo: ${_combo}</b>`:''}</p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px">`;
    _words.forEach((w,i)=>{
      const isSel=_selected===i;
      const isMatched=w.matched;
      html+=`<button onclick="window._lyricsClick(${i})" ${isMatched?'disabled':''} style="padding:14px 8px;background:${isMatched?'#0a3a1a':isSel?'#3a1a5a':'#1a1a2a'};border:1px solid ${isMatched?'#2ecc71':isSel?'#9b59b6':'#2a2a3a'};color:${isMatched?'#7ec87e':'#fff'};border-radius:8px;font-size:14px;cursor:${isMatched?'default':'pointer'};font-weight:${isSel?'700':'500'}">${w.txt}</button>`;
    });
    html+=`</div>`;
    if(_done){
      html+=`<button class="cbtn" onclick="window._lyricsFinish()" style="background:#27ae60">✅ Zakończ — zapisz teksty</button>`;
    } else {
      html+=`<button class="cbtn" onclick="window._lyricsFinish()" style="background:#5a3a1a">⏭ Wcześniejszy koniec (mniej hitów = niższa jakość)</button>`;
    }
    html+=`</div>`;
    panel.innerHTML=html;
    if(_remain<=0) window._lyricsFinish();
  };
  window._lyricsClick=(idx)=>{
    if(_words[idx].matched) return;
    if(_selected===-1){_selected=idx;render();return;}
    if(_selected===idx){_selected=-1;render();return;}
    /* Sprawdź czy rymują się */
    if(_words[_selected].pair===_words[idx].pair){
      _words[_selected].matched=true;_words[idx].matched=true;_hits++;
      _combo++; if(_combo>_maxCombo) _maxCombo=_combo;
      if(typeof sfxSparkle==='function')sfxSparkle();
      /* v2.1.149: combo milestone messages */
      if(_combo===3){if(typeof showMsg==='function')showMsg('🔥 Combo 3!','g',1200);}
      else if(_combo===5){if(typeof showMsg==='function')showMsg('🔥🔥 Combo 5! Flow on fire!','g',1500);}
      else if(_combo===8){if(typeof showMsg==='function')showMsg('🔥🔥🔥 PERFECT FLOW! 8/8 bez pudła!','g',2000);}
    } else {
      _misses++;
      _combo=0;  /* v2.1.149: reset combo na miss */
      if(typeof showMsg==='function')showMsg('❌ Nie rymują się!','r',1500);
    }
    _selected=-1;
    render();
  };
  window._lyricsFinish=()=>{
    /* Quality calc: hits/8 × 100 base + Teksty skill bonus +15%/lvl (max +75%) - misses penalty
       v2.1.149: + combo bonus (max +10 za perfect 8/8 streak, +5 za maxCombo>=5, +3 za maxCombo>=3) */
    const _baseQ=Math.floor((_hits/8)*100);
    const _txtSk=(typeof getRaperST==='function'?getRaperST('teksty'):0)||0;
    const _skMult=1+_txtSk*0.15;
    const _missPenalty=_misses*3;
    let _comboBonus=0;
    if(_maxCombo>=8) _comboBonus=10; /* perfect run 8/8 bez pudła */
    else if(_maxCombo>=5) _comboBonus=5;
    else if(_maxCombo>=3) _comboBonus=3;
    const _q=Math.max(10,Math.min(100,Math.floor(_baseQ*_skMult-_missPenalty)+_comboBonus));
    if(_comboBonus>0 && typeof addNotif==='function') addNotif(`🔥 Max combo ${_maxCombo}: +${_comboBonus}% bonus jakości tekstów!`);
    G.currentTrack=G.currentTrack||{};
    G.currentTrack.lyricsQ=_q;
    G.energy=clampStat('energy',G.energy-15);
    addRaperXP(8);addXP(15);
    /* Skill teksty rośnie przy 65%+ accuracy */
    if(_hits>=5 && getRaperST){
      G.raperST=G.raperST||{};
      G.raperST.teksty=Math.min(5,(G.raperST.teksty||0)+1);
      addNotif('📝 Skill Teksty +1 (poziom '+(G.raperST.teksty)+')');
    }
    panel.classList.remove('on');
    panel.innerHTML='';
    delete window._lyricsClick;delete window._lyricsFinish;
    notify(`📝 Teksty napisane! Jakość ${_q}%, trafienia ${_hits}/8, pudła ${_misses}`);
    if(_q>=85){if(typeof confetti==='function')confetti(20);}
    /* Otwórz DAW z tabem teksty */
    setTimeout(()=>{if(typeof renderDAWOverlay==='function'){renderDAWOverlay('lyrics');openOverlay();}},400);
  };
  render();
  /* Auto-finish na timer end */
  const _watchdog=setInterval(()=>{
    if(!document.getElementById('mg-job')?.classList.contains('on')){clearInterval(_watchdog);return;}
    const _el=Date.now()-_tStart;
    if(_el>=TIME_LIMIT){clearInterval(_watchdog);if(window._lyricsFinish)window._lyricsFinish();}
    else render();
  },1000);
};

window.dawDoMix=()=>{
  const ct=G.currentTrack;
  /* v2.1.71 Amper: pełna spójność z _GENRE_OPT w UI. Wcześniej dawDoMix miał DRUGI zestaw wartości (różny od pokazywanych graczowi)
     + ignorował suwak Drums (G._mixPan jako save key dla drums od v2.1.69). To był ghost feature.
     Teraz: dawDoMix opts === _GENRE_OPT, drums faktycznie wlicza się w score (waga 0.15).
     v2.1.72: rename G._mixPan → G._mixDrums (spójna nazwa wewnętrzna ze label "Drums"). Save migration w load. */
  const eq=G._mixEq||50,rev=G._mixRev||30,comp=G._mixComp||60,mel=G._mixMel||70,drums=G._mixDrums||50;
  const genre=ct.genre||'trap';
  const opts={
    trap:    {bass:75, rev:30, comp:75, mel:65, drums:70},
    boombap: {bass:55, rev:55, comp:50, mel:75, drums:85},
    drill:   {bass:80, rev:20, comp:85, mel:55, drums:70},
    reggaeton:{bass:60, rev:45, comp:65, mel:80, drums:80},
    jerk:    {bass:55, rev:40, comp:60, mel:70, drums:60},
    /* v2.1.168: 4 nowe gatunki — MUSI matchować UI _GENRE_OPT (L18441-18444) inaczej UI/code asymetria */
    afrobeat:{bass:65, rev:50, comp:55, mel:75, drums:85},
    electronic:{bass:70, rev:35, comp:80, mel:60, drums:55},
    rnb:     {bass:50, rev:60, comp:55, mel:85, drums:50},
    jazz_fusion:{bass:60, rev:65, comp:45, mel:80, drums:70},
  };
  const opt=opts[genre]||opts.trap;
  /* Wagi: bass 0.3, rev 0.2, comp 0.2, mel 0.15, drums 0.15 — bass najważniejszy (foundation tracka), drums i mel ważne ale mniej. */
  const score=100-Math.abs(eq-opt.bass)*0.3-Math.abs(rev-opt.rev)*0.2-Math.abs(comp-opt.comp)*0.2-Math.abs(mel-opt.mel)*0.15-Math.abs(drums-opt.drums)*0.15;
  /* v2.1.75 Amper: tapeSat dodany do plugBonus miksera (wcześniej liczony tylko w masterze i suficie — asymetryczny boost). Plugin opisany jako "+6% ciepłe brzmienie analogowe" — pasuje do mixu i masteru. */
  const plugBonus=(G.plugins.eqPro?8:0)+(G.plugins.punchComp?10:0)+(G.plugins.reverbSpace?8:0)+(G.plugins.deEsser?6:0)+(G.plugins.tapeSat?6:0);
  const baseMax=70+getDAWPluginCeiling();
  const beatMult=ct.beatQ>0?(0.5+ct.beatQ/200):0.5;
  const vocalMult=ct.vocalQ>0?(0.5+ct.vocalQ/200):0.5;
  // BUG — usunięto rnd(0,10): spam "Zrób miks" zmieniał wynik bez ruchu suwaków. Teraz deterministyczne.
  /* v1.9.18: DAW tier bonus aplikowany do mixu (poprzednio nie różniło Basic vs Logic Pro) */
  const _dawTierMixBonus={1:3,2:8,3:14}[G.dawTier]||0;
  /* v2.1.122: Wave 1 W1 — BUFF mix plugin bonus 0.4→1.0 mult (UI obiecuje "+8% jakości miksu" dla eqPro, kod dawał +8×0.4=+3.2% — nerf). Teraz pełny +8 pkt = +8% jakości faktycznie. */
  ct.mixQ=Math.round(clamp(score*0.9*beatMult*vocalMult+plugBonus*1.0+_dawTierMixBonus,10,baseMax+_dawTierMixBonus));
  G.energy=clampStat('energy', G.energy-15);addXP(15);
  // v1.8.18: pipeline — po miksie automatycznie przejdź do masteringu
  if(typeof showMsg==='function')showMsg(`🎚️ Miks gotowy: ${ct.mixQ}%. Następny krok: 🎛️ Master →`,'g',5000);
  renderDAWOverlay('master');
};

window.dawDoMaster=()=>{
  const ct=G.currentTrack;
  const lim=G._masLim||80,stereo=G._masStereo||60,lufs=G._masLufs||70;
  /* v1.9.32: BUG FIX — master genre-specific opts (poprzednio hardcoded 80/60 dla wszystkich gatunków, jak mix).
     v2.1.73 Amper: ⚠️ WARTOŚCI MUSZĄ BYĆ IDENTYCZNE z _MASTER_OPT w UI (renderDAWOverlay master, linia ~17402).
     Wcześniej UI miało jedne wartości, dawDoMaster drugie — gracz dążył do liczby pokazywanej, kod oceniał względem innej.
     Filozofia z v2.1.69: limiter trap/drill mocne (loud club), boombap subtelne (dynamika), reggaeton średnie.
     Stereo: boombap szerokie (organic), drill wąskie (mono punch), reggaeton szerokie (taneczna ekspansja). */
  const _genreM=ct.genre||'trap';
  const _optsM={
    trap:    {lim:82, stereo:60},
    boombap: {lim:65, stereo:75},
    drill:   {lim:88, stereo:50},
    reggaeton:{lim:78, stereo:72},
    jerk:    {lim:75, stereo:65},
    /* v2.1.168: 4 nowe gatunki — MUSI matchować UI _MASTER_OPT (L18528-18534) */
    afrobeat:{lim:72, stereo:70},
    electronic:{lim:85, stereo:55},
    rnb:     {lim:68, stereo:78},
    jazz_fusion:{lim:62, stereo:80},
  };
  const _optM=_optsM[_genreM]||_optsM.trap;
  const optLim=_optM.lim,optStereo=_optM.stereo;
  // #37D LUFS rebuild: skala 0-100 slider → -30 do 0 dB. Im lepszy mix, tym wąższy bezpieczny zakres bliżej 0 dB.
  const lufsDb=-30+lufs*0.30; // -30 do 0
  // mixQ < 40: bezpieczna strefa -20 do -15 (slider 33-50, opt slider ~42)
  // mixQ 40-70: bezpieczna strefa -15 do -10 (slider 50-67, opt slider ~58)
  // mixQ >= 70: bezpieczna strefa -10 do -5 (slider 67-83, opt slider ~75)
  const mixQ=ct.mixQ||0;
  let optLufsSlider, safeMin, safeMax;
  if(mixQ>=70){optLufsSlider=75;safeMin=67;safeMax=83;}
  else if(mixQ>=40){optLufsSlider=58;safeMin=50;safeMax=67;}
  else {optLufsSlider=42;safeMin=33;safeMax=50;}
  // Penalty: przester (lufs > safeMax) - bardzo źle, zbyt cicho (lufs < safeMin) - lekko źle
  let lufsScore=100;
  if(lufs>safeMax) lufsScore-= (lufs-safeMax)*1.5; // przester — duża kara
  else if(lufs<safeMin) lufsScore-= (safeMin-lufs)*0.8; // za cicho — mniejsza kara
  // Bonus za optimum
  lufsScore-=Math.abs(lufs-optLufsSlider)*0.3;
  lufsScore=clamp(lufsScore,10,100);
  const score=100-Math.abs(lim-optLim)*0.5-Math.abs(stereo-optStereo)*0.3 - (100-lufsScore)*0.45;
  const plugBonus=(G.plugins.limiterLoud?10:0)+(G.plugins.stereoImager?8:0)+(G.plugins.multibandComp?14:0)+(G.plugins.tapeSat?6:0);
  /* v1.9.18: DAW tier bonus aplikowany do mastera (poprzednio Basic vs Logic Pro dawało identyczny output, opisy tierów +15/+25/+40 były dead) */
  const dawTierBonus={1:5,2:12,3:20}[G.dawTier]||0;
  const baseMax=Math.min(100,70+Math.min(30,plugBonus)+dawTierBonus);
  const mixMult=ct.mixQ>0?(0.6+ct.mixQ/250):0.6;
  /* v2.1.122: Wave 1 W1 — BUFF master plugin bonus 0.3→1.0 mult (analogicznie do mix). */
  ct.masterQ=Math.round(clamp(score*mixMult+plugBonus*1.0+dawTierBonus,10,baseMax));
  G.energy=clampStat('energy', G.energy-10);addXP(10);
  const lufsLabel=lufsDb.toFixed(1)+' dB';
  const lufsStatus=lufs>safeMax?`⚠️ PRZESTER (${lufsLabel}) — kara za przesterowanie!`:lufs<safeMin?`🔈 ZA CICHO (${lufsLabel}) — kara za niski poziom`:`✅ Optymalny LUFS (${lufsLabel})`;
  // v1.8.18: pipeline — po masteringu automatycznie przejdź do dystrybucji (gotowy do wydania)
  if(typeof showMsg==='function')showMsg(`🎛️ Master: ${ct.masterQ}%. ${lufsStatus} — wydaj singiel w Dystrybucji!`,'g',6000);
  renderDAWOverlay('dystrybucja');
};

/* v2.1.70 Amper: SoundCloud — bez wymogu dystrybutora, niskie zarobki (~25% streamów, brak dist royalty cut).
   Filozofia: SoundCloud to platforma startowa, każdy może wrzucić demo. Dystrybucja (Spotify/Tidal) = duże pieniądze.
   v2.1.179: obniżono masterQ wymóg z 40 do 20 — SC ma być DUŻO łatwiej dostępny w early game.
   User feedback: "SC mniej dochodowy od pozostałych streamingów, ale dużo łatwiej osiągalny w early game". */
window.dawReleaseToSoundCloud=()=>{
  const ct=G.currentTrack;
  if(ct.masterQ<20){showMsg(`Master musi mieć min. 20% żeby wrzucić na SoundCloud (masz ${ct.masterQ}%). To bardzo niski próg — SC akceptuje nawet rough drafty.`,'r');return;}
  if(!G.soundcloud) G.soundcloud={listeners:0,streams:0,royalties:0,tracksUploaded:0};
  /* v2.1.135: dodano lyrics komponent (waga 12%, mniej niż Spotify 15% bo SC = "rough draft platform") — wcześniej gracze piszący teksty NIE byli nagradzani za SC release (niespójność z Spotify single L18274). */
  const _lQ=ct.lyricsQ||50;
  const finalQ=Math.round((ct.beatQ||50)*0.22+(ct.vocalQ||50)*0.20+(_lQ)*0.12+(ct.mixQ||50)*0.22+(ct.masterQ||50)*0.24);
  const trackNum=(G.studioTracks||[]).length+1;
  const genres_pl={trap:'Trap',boombap:'Boom Bap',drill:'Drill',reggaeton:'Reggaeton',jerk:'Jerk',afrobeat:'Afrobeat',electronic:'Electronic',rnb:'R&B',jazz_fusion:'Jazz Fusion'}; /* v2.1.157: 4 nowe gatunki */
  const _customName=(ct.name||'').trim().slice(0,40);
  const name=_customName||`SC #${trackNum} — ${genres_pl[ct.genre]||'Trap'}`;
  /* Streamy ~25% pełnego releasera (bez distribution boost, bez major label reach) */
  let streams=Math.floor((20+G.followers*0.15)*(finalQ/100+0.2)*rnd(80,120)/100);
  streams=Math.min(80000,streams); /* cap niższy niż 500k dla Spotify */
  /* Royalty ~0.0008 zł/stream (5× mniej niż Spotify 0.004) — SoundCloud monetyzacja słaba */
  const royalties=Math.floor(streams*0.0008);
  G.studioTracks=G.studioTracks||[];
  G.studioTracks.push({name,quality:finalQ,streams,royalties,releaseDay:G.day,genre:ct.genre,beatQ:ct.beatQ,vocalQ:ct.vocalQ,mixQ:ct.mixQ,masterQ:ct.masterQ,platform:'soundcloud'});
  if(G.studioTracks.length>200) G.studioTracks.shift();
  G.soundcloud.listeners+=Math.floor(streams*0.08);
  G.soundcloud.streams+=streams;
  G.soundcloud.royalties+=royalties;
  G.soundcloud.tracksUploaded++;
  G.careers.raper.tracks=(G.careers.raper.tracks||0)+1;
  /* Mniej fanów niż Spotify — SoundCloud audience nie konwertuje tak dobrze */
  const fans=Math.floor(streams*0.005*(finalQ/100+0.2));
  G.followers+=fans;
  G.fame=clamp((G.fame||0)+Math.floor(finalQ/40),0,500);
  if(typeof earn==='function') earn(royalties,false); else {G.money+=royalties;G.totalEarned=(G.totalEarned||0)+royalties;}
  addRaperXP(Math.floor(10+finalQ*0.3));
  addXP(20);
  showGain(`🟠 +${fans} fanów (SoundCloud)`,'#ff5500');
  showMsg(`🟠 "${name}" wrzucony na SoundCloud! ${streams.toLocaleString('pl')} streamów, +${royalties} zł, +${fans} fanów. Mały zasięg, ale każdy może wrzucić.`);
  addNotif(`🟠 SoundCloud: "${name}" — ${streams.toLocaleString('pl')} streamów`);
  /* Reset current track */
  G.currentTrack={beatQ:0,vocalQ:0,mixQ:0,masterQ:0,lyricsQ:0,genre:ct.genre,name:''}; /* v2.1.107: lyricsQ reset */
  G._mixEq=50;G._mixRev=30;G._mixComp=60;G._mixMel=70;G._mixDrums=50;G._masLim=80;G._masStereo=60;G._masLufs=70;
  renderDAWOverlay('master');
};
window.dawReleaseSingle=()=>{
  const ct=G.currentTrack;
  if(!G.distributor){showMsg('⚠️ Wybierz dystrybutora w zakładce Dystrybucja!','r');renderDAWOverlay('dystrybucja');return;}
  if(ct.masterQ<60){showMsg(`Master musi mieć min. 60% (masz ${ct.masterQ}%). Popraw w zakładce Master.`,'r');return;}
  if(G.level<2){showMsg('Musisz być min. Poziom 2 żeby wydać singiel.','r');return;}
  // v1.8.98: DistroKid limit 5 singli/rok (zgodnie z opisem dystrybutora). 1 rok gry = 56 dni.
  if(G.distributor.limitSingles && G.distributor.limitSingles<99){
    const yearStart=G.day-((G.day-1)%56);
    const singlesThisYear=(G.studioTracks||[]).filter(t=>t.releaseDay>=yearStart && !t.isDemo).length;
    if(singlesThisYear>=G.distributor.limitSingles){
      showMsg(`⚠️ Limit ${G.distributor.name}: max ${G.distributor.limitSingles} singli na rok gry (wydano już ${singlesThisYear}). Przejdź na większego dystrybutora lub poczekaj do nowego roku.`,'r',6000);
      renderDAWOverlay('dystrybucja');return;
    }
  }
  // v1.8.28: zmiana z multiplication (degradacja: 75/75/75/75 → 32%) na weighted average.
  // Master ma największą wagę (final touch), beat i mix po równo, vocal trochę mniej.
  // 50/50/50/50 = 50%, 75/75/75/75 = 75%, 100/100/100/100 = 100%. Sensowna progresja.
  /* v2.1.107: Lyrics dodane do finalQ jako 5-ty komponent (waga 15%, kosztem mniejszej wagi vocalQ).
     Lyrics OPCJONALNY — jeśli gracz nie napisał tekstów (lyricsQ=0), używa fallback 50% (jak inne pre-Lyrics tracki). */
  const _lQ=ct.lyricsQ||50;
  const finalQ=Math.round((ct.beatQ||50)*0.22+(ct.vocalQ||50)*0.18+(_lQ)*0.15+(ct.mixQ||50)*0.22+(ct.masterQ||50)*0.23);
  const trackNum=(G.studioTracks||[]).length+1;
  const genres_pl={trap:'Trap',boombap:'Boom Bap',drill:'Drill',reggaeton:'Reggaeton',jerk:'Jerk',afrobeat:'Afrobeat',electronic:'Electronic',rnb:'R&B',jazz_fusion:'Jazz Fusion'}; /* v2.1.157: 4 nowe gatunki */
  /* v2.1.44 [Amper]: custom tytuł singla — user-input z Master tab, fallback do auto */
  const _customName=(ct.name||'').trim().slice(0,40);
  const name=_customName||`Singiel #${trackNum} — ${genres_pl[ct.genre]||'Trap'}`;
  let streams=Math.floor((50+G.followers*0.5)*(finalQ/100+0.3)*rnd(80,120)/100);
  // v1.8.97: Teksty 4 — co 5. track to automatyczny HIT (+200% streamów). Wcześniej fake.
  let _hitFlag=false;
  if(typeof getRaperST==='function' && getRaperST('teksty')>=4 && trackNum%5===0){
    streams=Math.floor(streams*3); _hitFlag=true;
  }
  // v1.8.97: Teksty 2 — +20% szans że track trafi na playlistę (= +50% streamów single roll)
  if(typeof getRaperST==='function' && getRaperST('teksty')>=2 && Math.random()<0.20){
    streams=Math.floor(streams*1.50); _hitFlag=true;
  }
  // v1.8.97: Mikser 2 — +20% streamów z każdego tracku (passive)
  if(typeof getRaperST==='function' && getRaperST('mikser')>=2){
    streams=Math.floor(streams*1.20);
  }
  /* v2.1.70 Amper: Empire/AWAL streamBoost — kompensacja niższych royalties poprzez większy zasięg. */
  const _distStreamBoost=(G.distributor?.streamBoost)||1;
  if(_distStreamBoost>1) streams=Math.floor(streams*_distStreamBoost);
  /* v1.9.54: stream cap na 500k per release */
  streams=Math.min(500000,streams);
  const royalties=Math.floor(streams*0.004*(G.distributor?G.distributor.royaltyPct/100:0.8));
  G.studioTracks=G.studioTracks||[];
  G.studioTracks.push({name,quality:finalQ,streams,royalties,releaseDay:G.day,genre:ct.genre,beatQ:ct.beatQ,vocalQ:ct.vocalQ,mixQ:ct.mixQ,masterQ:ct.masterQ,hit:_hitFlag});
  /* v2.1.0: Crew challenge — record_tracks progress (full single) */
  if(G.playerCrew && typeof window._crewAddProgress==='function'){try{window._crewAddProgress('record_tracks',1);}catch(e){}}
  /* v1.9.33: Memory cap — anti-bloat dla save (poprzednio unbounded growth → 100+ tracków late-game) */
  if(G.studioTracks.length>200) G.studioTracks.shift();
  G.spotify.listeners+=Math.floor(streams*0.1);G.spotify.streams+=streams;
  /* v1.9.22: BUG FIX — Tidal też dostaje listeners/streams ze singla (poprzednio tylko Spotify, niespójnie z releaseBeat/releaseAlbum) */
  G.tidal.listeners=(G.tidal.listeners||0)+Math.floor(streams*0.03);
  G.tidal.streams=(G.tidal.streams||0)+Math.floor(streams*0.3);
  G.careers.raper.tracks=(G.careers.raper.tracks||0)+1;
  // v1.8.96: Kontrakt typu 'track' liczy nagrane single (wcześniej kontrakt "Nagraj 3 tracki" nie zaliczał się nigdy)
  if(G.contract && G.contract.type==='track'){
    G.contract.progress++;
    if(G.contract.progress>=G.contract.target) completeContract();
  }
  const mixFansMult=getRaperST('mikser')>=4?1.25:1; // Mikser 4+ → +25% fanów z tracku
  const fans=Math.floor(streams*0.02*(finalQ/100+0.2)*mixFansMult);
  if(typeof G.fans!=='number') G.fans=0;G.followers+=fans;
  // v1.8.97: Prestige fameMult — bonus do sławy z singla (już w addFame)
  const _famePrestigeT=G.prestigeBonus?.fameMult||1;
  // v1.8.97: Przyjaźń z Producentem — bonus do sławy z singla (zgodnie z opisem "VIP traktowanie")
  const _producentFM=typeof getFriendshipBonus==='function'?getFriendshipBonus('producent'):1;
  /* v2.1.218 [Amper] BALANS KRYTYCZNY: singla fame BYPASSOWAŁ addFame() (no diminishing). Naprawione: przez addFame, _famePrestigeT usunięte z manual (addFame samo aplikuje). */
  const _singleFameRaw=Math.floor(finalQ/20*_producentFM);
  if(typeof addFame==='function') addFame(_singleFameRaw); else G.fame=clamp((G.fame||0)+Math.floor(_singleFameRaw*_famePrestigeT),0,500);
  /* v1.9.29: BUG FIX — royalty singla przez earn() żeby aplikował Prestige moneyMult (poprzednio bezpośrednie G.money+= pomijało bonus) */
  if(typeof earn==='function') earn(royalties,false); else {G.money+=royalties;G.totalEarned=(G.totalEarned||0)+royalties;}
  addRaperXP(Math.floor(20+finalQ*0.5));addXP(40);
  confetti(20);showGain(`🎵 +${fans} fanów`,'#e91e8c');
  // #37E: animacja uploadu — gracz widzi że track faktycznie idzie do dystrybutora
  showUploadProgress(name,G.distributor.name,()=>{
    showMsg(`🚀 "${name}" wydany przez ${G.distributor.name}! ${streams.toLocaleString('pl')} streamów, +${royalties} zł, +${fans} fanów!`);
  });
  addNotif(`🎵 Nowy singiel "${name}" wydany! ${streams.toLocaleString('pl')} streamów`);
  // Reset current track
  G.currentTrack={beatQ:0,vocalQ:0,mixQ:0,masterQ:0,lyricsQ:0,genre:ct.genre,name:''}; /* v2.1.107: lyricsQ reset */
  G._mixEq=50;G._mixRev=30;G._mixComp=60;G._mixMel=70;G._mixDrums=50;G._masLim=80;G._masStereo=60;G._masLufs=70;
  renderDAWOverlay('master');
};

// #37E: Upload progress przy wydaniu singla — gracz widzi że track idzie do dystrybutora
window.showUploadProgress=(trackName,distName,onDone)=>{
  document.getElementById('upload-overlay')?.remove();
  const ov=document.createElement('div');
  ov.id='upload-overlay';
  ov.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(160deg,#0a1525,#1a0a2a);border:2px solid #9b59b6;border-radius:14px;padding:24px 32px;width:420px;z-index:280;box-shadow:0 0 60px rgba(155,89,182,.5);color:#fff;font-family:inherit;text-align:center';
  ov.innerHTML=`
    <div style="font-size:18px;color:#9b59b6;font-weight:900;margin-bottom:6px">📤 UPLOAD W TOKU</div>
    <div style="font-size:13px;color:#aaa;margin-bottom:16px">Wysyłanie "${trackName}" do <b style="color:#7ec8e3">${distName}</b>...</div>
    <div style="background:#0a0a14;border-radius:8px;height:14px;overflow:hidden;margin-bottom:10px"><div id="up-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#9b59b6,#e91e8c,#f1c40f);transition:width .15s"></div></div>
    <div id="up-status" style="font-size:11px;color:#7790;letter-spacing:1px;min-height:14px">Inicjalizacja...</div>
  `;
  document.body.appendChild(ov);
  let pct=0;
  const phases=['Inicjalizacja...','Konwersja audio...','Wysyłanie do serwerów...','Weryfikacja jakości...','Indeksowanie metadanych...','Publikacja na platformach...','Track LIVE! 🎉'];
  const tick=setInterval(()=>{
    pct+=Math.random()*15+5;
    if(pct>=100){pct=100;clearInterval(tick);
      document.getElementById('up-bar').style.width='100%';
      document.getElementById('up-status').textContent=phases[phases.length-1];
      document.getElementById('up-status').style.color='#27ae60';
      setTimeout(()=>{ov.remove();if(typeof onDone==='function')onDone();},800);
      return;
    }
    document.getElementById('up-bar').style.width=pct+'%';
    const phaseIdx=Math.min(phases.length-2,Math.floor(pct/100*(phases.length-1)));
    document.getElementById('up-status').textContent=phases[phaseIdx];
  },180);
};

// ─── KONTRAKTY ────────────────────────────────────────────────────
function completeContract(){
  if(!G.contract) return;
  let pay=G.contract.payment;if(G.managementDeal) pay=Math.floor(pay*G.managementBonus);
  // v1.8.98: Biznes 1 — kontrakty +10% korzystniejsze (zgodnie z opisem "Negocjacje")
  if(typeof getRaperST==='function' && getRaperST('biznes')>=1) pay=Math.floor(pay*1.10);
  // v1.8.61: kontrakt — rep nerf z +10 do +9 (user: koncerty max 9)
  earn(pay,false);if(typeof addFame==='function')addFame(10);else G.fame=clamp(G.fame+10,0,500);addXP(60);G.streetRep=clamp(G.streetRep+9,0,100);
  showMsg(`🎉 Kontrakt wykonany! +${pay} zł, +10 sława, +9 rep uliczna`);
  addNotif(`✅ Kontrakt "${G.contract.desc}" zakończony! +${pay} zł`);
  G.contract=null;
}

/* v2.1.224: Streaming chart — 10 fictional rappers z bazowymi fame i fans.
   Gracz rywalizuje o pozycję w rankingu. NPC rosną ~1% per dzień gry (organic growth).
   Score = fame × 1000 + fans (player and NPC same formula). */
const CHART_NPCS=[
  {id:'kid_drip',      name:'Kid Drip',      emoji:'🎯', fameBase:50,  fansBase:15000,   tag:'Underground'},
  {id:'lex_local_npc', name:'Lex Local',     emoji:'🎤', fameBase:80,  fansBase:35000,   tag:'Local Hero'},
  {id:'mc_riser_npc',  name:'MC Riser',      emoji:'⚡', fameBase:120, fansBase:80000,   tag:'Rising'},
  {id:'sora_wave_npc', name:'Sora Wave',     emoji:'🌊', fameBase:160, fansBase:200000,  tag:'Indie Wave'},
  {id:'doja_light_npc',name:'Doja Light',    emoji:'✨', fameBase:200, fansBase:500000,  tag:'Pop Star'},
  {id:'top_one_npc',   name:'Top One',       emoji:'👑', fameBase:260, fansBase:1200000, tag:'National'},
  {id:'goldie_b',      name:'Goldie B',      emoji:'💰', fameBase:320, fansBase:2500000, tag:'Mainstream'},
  {id:'nyx_arrow',     name:'NYX Arrow',     emoji:'🏹', fameBase:380, fansBase:4000000, tag:'Superstar'},
  {id:'phantom_mc_npc',name:'Phantom MC',    emoji:'🎭', fameBase:450, fansBase:6500000, tag:'Legend'},
  {id:'goat_eternal',  name:'GOAT Eternal',  emoji:'🏆', fameBase:490, fansBase:9000000, tag:'GOAT'},
];

/* v2.1.224: Init NPC current state z bazą (lazy — pierwszy access). */
function _chartNpcGetCurrent(npc){
  if(!G._chartNpcs || typeof G._chartNpcs!=='object') G._chartNpcs={};
  if(!G._chartNpcs[npc.id]) G._chartNpcs[npc.id]={fame:npc.fameBase, fans:npc.fansBase};
  return G._chartNpcs[npc.id];
}

/* v2.1.224: Daily growth tick — wywoływany w nextPeriod po G.day++. ~1% per dzień gry. */
function _chartNpcDailyGrowth(){
  if(!G._chartNpcs || typeof G._chartNpcs!=='object') G._chartNpcs={};
  for(const npc of CHART_NPCS){
    const cur=_chartNpcGetCurrent(npc);
    /* Random 0.5-1.5% per day — slight variance dla każdego NPC */
    const _famMult=1+(0.005+Math.random()*0.010);
    const _fanMult=1+(0.005+Math.random()*0.010);
    cur.fame=Math.min(500, Math.floor(cur.fame*_famMult));
    cur.fans=Math.floor(cur.fans*_fanMult);
  }
}

/* v2.1.224: Score formula — same for player and NPC. */
function _chartScore(fame, fans){
  return Math.floor((fame||0)*1000 + (fans||0));
}

/* v2.1.224: Render phone Chart app. */
function renderPhoneChart(){
  document.getElementById('ph-title').textContent='📊 Streaming Chart';
  const _esc=(typeof _escHtml==='function')?_escHtml:(s=>String(s||''));
  /* Compute scores for player + all NPCs */
  const playerScore=_chartScore(G.fame||0, G.fans||0);
  const entries=CHART_NPCS.map(npc=>{
