          <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
            <button onclick="window._busGuess('suit0')" style="background:#1a1a1a;color:#fff;border:1px solid #fff;padding:12px 18px;border-radius:10px;font-weight:800;cursor:pointer;font-size:18px;font-family:inherit">♠</button>
            <button onclick="window._busGuess('suit1')" style="background:#fff;color:#c01020;border:1px solid #000;padding:12px 18px;border-radius:10px;font-weight:800;cursor:pointer;font-size:18px;font-family:inherit">♥</button>
            <button onclick="window._busGuess('suit2')" style="background:#fff;color:#c01020;border:1px solid #000;padding:12px 18px;border-radius:10px;font-weight:800;cursor:pointer;font-size:18px;font-family:inherit">♦</button>
            <button onclick="window._busGuess('suit3')" style="background:#1a1a1a;color:#fff;border:1px solid #fff;padding:12px 18px;border-radius:10px;font-weight:800;cursor:pointer;font-size:18px;font-family:inherit">♣</button>
          </div>`:''}
        ${_canCashOut?`<div style="margin-top:10px"><button onclick="window._busCashOut()" style="background:linear-gradient(135deg,#f1c40f,#c8a520);color:#000;border:none;padding:10px 28px;border-radius:10px;font-weight:800;cursor:pointer;font-size:14px;font-family:inherit">💰 WYPŁAĆ ${winSoFar.toLocaleString('pl')} żet.</button></div>`:''}
      </div>
      <div style="text-align:center;margin-top:14px"><button class="cbtn" onclick="closeOverlay()">← Wróć do VIP</button></div>`;
  };
  window._busOnBet=(v)=>{const x=parseInt(v);if(!isNaN(x))bet=x;};
  window._busDeal=()=>{
    if(stage!=='deal') return;
    if(bet<MIN_BET||bet>Math.min(MAX_BET,G.casinoChips)) return;
    const _now=Date.now();
    if(G._busCooldownUntil && _now<G._busCooldownUntil){
      lastResult=`⏳ Poczekaj ${((G._busCooldownUntil-_now)/1000).toFixed(1)}s`;_render();return;
    }
    G._busCooldownUntil=_now+1000;
    G.casinoChips-=bet;
    G.casinoStats=G.casinoStats||{};
    G.casinoStats.busPlayed=(G.casinoStats.busPlayed||0)+1;
    G.casinoStats.totalLost=(G.casinoStats.totalLost||0)+bet;
    hand=[]; roundIdx=0;
    /* Wylosuj 4 karty z góry */
    for(let i=0;i<4;i++) hand.push(_drawCard());
    if(typeof sfxCardDeal==='function')sfxCardDeal();
    stage='play'; lastResult='Runda 1: Zgadnij KOLOR pierwszej karty!';
    _render();
  };
  window._busGuess=(choice)=>{
    if(stage!=='play')return;
    const card=_cardObj(hand[roundIdx]);
    let win=false, why='';
    if(roundIdx===0){
      const isRed=card.red;
      win = (choice==='red' && isRed) || (choice==='black' && !isRed);
      why = win ? `✅ ${card.n}${card.s} — trafiony kolor!` : `❌ ${card.n}${card.s} — pudło.`;
    } else if(roundIdx===1){
      const prev=_cardObj(hand[0]);
      if(card.v===prev.v) { win=false; why=`❌ ${card.n}${card.s} = ${prev.n}${prev.s} (równa wartość = przegrana).`; }
      else {
        win = (choice==='higher' && card.v>prev.v) || (choice==='lower' && card.v<prev.v);
        why = win ? `✅ ${card.n}${card.s} ${card.v>prev.v?'>':' <'} ${prev.n}${prev.s} — trafiony!` : `❌ ${card.n}${card.s} ${card.v>prev.v?'>':'<'} ${prev.n}${prev.s} — pudło.`;
      }
    } else if(roundIdx===2){
      const v1=_cardObj(hand[0]).v, v2=_cardObj(hand[1]).v;
      const lo=Math.min(v1,v2), hi=Math.max(v1,v2);
      if(card.v===v1||card.v===v2){ win=false; why=`❌ ${card.n}${card.s} = wartość już znana (push = przegrana).`; }
      else {
        const inside = card.v>lo && card.v<hi;
        win = (choice==='inside' && inside) || (choice==='outside' && !inside);
        why = win ? `✅ ${card.n}${card.s} — trafiony zakres!` : `❌ ${card.n}${card.s} — pudło.`;
      }
    } else if(roundIdx===3){
      const guessSuit=parseInt(choice.replace('suit',''));
      win = card.suitIdx===guessSuit;
      why = win ? `🏆 ${card.n}${card.s} — FULL BUS!` : `❌ ${card.n}${card.s} — pudło.`;
    }
    roundIdx++;
    if(typeof sfxCardDeal==='function')sfxCardDeal();
    if(!win){
      stage='deal';
      lastResult=`${why} Strata ${bet} żet. (rundy zaliczone: ${roundIdx-1}/4)`;
      if(typeof sfxLoss==='function')sfxLoss();
      if(typeof saveGameSilent==='function')saveGameSilent();
      _render();
      return;
    }
    /* Win this round */
    if(roundIdx>=4){
      /* Full bus — auto cash out */
      const finalPayout=Math.floor(bet*PAYOUTS[3]);
      G.casinoChips+=finalPayout;
      G.casinoStats.busWon=(G.casinoStats.busWon||0)+1;
      G.casinoStats.busFullRide=(G.casinoStats.busFullRide||0)+1;
      G.casinoStats.totalWon=(G.casinoStats.totalWon||0)+finalPayout;
      if(finalPayout>(G.casinoStats.biggestWin||0))G.casinoStats.biggestWin=finalPayout;
      lastResult=`🚌🎉 FULL BUS! ${why.replace('🏆 ','')} +${finalPayout.toLocaleString('pl')} żet. (${PAYOUTS[3]}×)`;
      if(typeof sfxJackpot==='function')sfxJackpot();
      if(typeof confetti==='function')confetti(60);
      stage='deal';
      if(typeof saveGameSilent==='function')saveGameSilent();
      _render();
      return;
    }
    /* Continue or cash out */
    lastResult=`${why} Runda ${roundIdx+1}: ${ROUND_NAMES[roundIdx]}`;
    if(typeof sfxCash==='function')sfxCash();
    _render();
  };
  window._busCashOut=()=>{
    if(stage!=='play'||roundIdx<1) return;
    const payout=Math.floor(bet*PAYOUTS[roundIdx-1]);
    G.casinoChips+=payout;
    G.casinoStats.busWon=(G.casinoStats.busWon||0)+1;
    G.casinoStats.totalWon=(G.casinoStats.totalWon||0)+payout;
    if(payout>(G.casinoStats.biggestWin||0))G.casinoStats.biggestWin=payout;
    lastResult=`💰 Wypłata po R${roundIdx}: +${payout.toLocaleString('pl')} żet. (${PAYOUTS[roundIdx-1]}×)`;
    if(typeof sfxCash==='function')sfxCash();
    stage='deal'; roundIdx=0; hand=[];
    if(typeof saveGameSilent==='function')saveGameSilent();
    _render();
  };
  _render();openOverlay();
};

/* ═══════════════════════════════════════════════════════════════════
   v1.9.72: KOŁO FORTUNY — 16 segmentów, każdy z mnożnikiem. Spin → losowy segment.
   Mnożniki: 0×, 1.5×, 2×, 5×, 10×, 50× — average ~0.94× (low house edge)
   ═══════════════════════════════════════════════════════════════════ */
window.openWheel=()=>{
  let bet=30, spinning=false, lastResult='', rotation=0;
  /* v1.9.95: REALISTYCZNY Wheel of Fortune — 16 segmentów, EV 0.94 (house edge 6%).
     Rozkład: 8× LOSS (czarne, 50%), 4× 1× zwrot (zielone), 3× 2× wygrana (żółte), 1× 5× JACKPOT (gold).
     Suma mnożników = 15/16 = 0.94. Opis ZGODNY z faktycznymi segmentami na kole. */
  const SEGMENTS=[0,1,0,2,0,1,0,5,0,1,0,2,0,1,0,2];
  /* Kolor czerwony = loss, zielony = zwrot 1×, żółty = win 2×, gold = JACKPOT 5× */
  const COLORS=['#c01a1a','#27ae60','#c01a1a','#f1c40f','#c01a1a','#27ae60','#c01a1a','#ffd700','#c01a1a','#27ae60','#c01a1a','#f1c40f','#c01a1a','#27ae60','#c01a1a','#f1c40f'];
  const _render=()=>{
    if(!G.casinoChips)G.casinoChips=0;
    const ok=!spinning&&bet>=30&&bet<=G.casinoChips;
    document.getElementById('ov-content').innerHTML=`
      <div style="text-align:center;margin-bottom:14px">
        <div style="font-size:30px;letter-spacing:6px;color:#c8a520;font-weight:900;text-shadow:0 0 18px rgba(200,165,32,.6)">🎯 KOŁO FORTUNY</div>
        <p style="color:#aac;font-size:12px;margin:6px 0;max-width:560px;margin:6px auto">Stawka <b style="color:#c8a520">30–10 000 żetonów</b> · Zakręć kołem — wskaźnik wylosuje 1 z 16 segmentów. Mnożnik × Twoja stawka = wygrana.</p>
      </div>
      <div style="text-align:center;margin-bottom:8px">
        <span class="chip chip-gold" style="font-size:13px;padding:6px 14px">🎟️ <span id="wheel-chips">${G.casinoChips.toLocaleString('pl')}</span> żetonów</span>
      </div>
      ${G.casinoChips<30?'<div style="background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.5);padding:12px;border-radius:10px;text-align:center;color:#f4a097;font-size:13px;margin:10px auto;max-width:520px">💸 Brak żetonów! Wymień gotówkę w <b>💰 Kantorze</b>.</div>':''}
      <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin:10px auto;max-width:520px;font-size:11px">
        <span style="background:#c01a1a;color:#fff;padding:5px 10px;border-radius:6px;font-weight:700">8× 🔴 LOSS (50%)</span>
        <span style="background:#27ae60;color:#fff;padding:5px 10px;border-radius:6px;font-weight:700">4× 🟢 1× zwrot (25%)</span>
        <span style="background:#f1c40f;color:#000;padding:5px 10px;border-radius:6px;font-weight:700">3× 🟡 2× wygrana (18.75%)</span>
        <span style="background:linear-gradient(135deg,#ffd700,#c8a520);color:#000;padding:5px 10px;border-radius:6px;font-weight:700">1× 🏆 JACKPOT 5× (6.25%)</span>
      </div>
      <canvas id="wheel-canvas" width="440" height="440" style="display:block;margin:0 auto;background:radial-gradient(ellipse at center,#1a0a0a,#000);border-radius:50%;box-shadow:0 0 40px rgba(200,165,32,.3)"></canvas>
      <div style="text-align:center;margin-top:14px">
        <label style="color:#aac;font-size:13px">Stawka:</label>
        <input type="number" id="wheel-bet" min="30" max="10000" value="${bet}" style="width:80px;background:#0a1525;border:1px solid #2a4a6a;color:#fff;padding:6px;border-radius:6px;margin:0 8px" oninput="window._wheelOnBet(this.value)"> <span style="color:#aac;font-size:10px">(max 10 000)</span>
        <button onclick="window._wheelSpin()" ${ok?'':'disabled'} style="background:${ok?'linear-gradient(135deg,#27ae60,#1abc9c)':'#3a3a3a'};color:#fff;border:none;padding:12px 32px;border-radius:8px;font-weight:800;cursor:${ok?'pointer':'not-allowed'};margin-left:8px;font-size:15px;letter-spacing:2px;font-family:inherit">🎯 KRĘĆ</button>
      </div>
      ${bet>10000?`<div style="background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.5);padding:8px;border-radius:8px;text-align:center;color:#f4a097;font-size:12px;margin:6px auto;max-width:520px">⚠️ Maksymalna stawka: <b>10 000 żetonów</b> (Twoja: ${bet})</div>`:''}
      <div id="wheel-result" style="text-align:center;color:#f1c40f;font-size:18px;font-weight:800;margin-top:14px;min-height:30px">${lastResult}</div>
      <div style="text-align:center;margin-top:14px"><button class="cbtn" onclick="closeOverlay()">← Wróć do kasyna</button></div>`;
    _drawWheel();
  };
  const _drawWheel=()=>{
    const c=document.getElementById('wheel-canvas');if(!c)return;
    const X=c.getContext('2d');
    X.clearRect(0,0,440,440);
    const cx=220, cy=220, R=200;
    /* External ring (gold rim) */
    X.fillStyle='#5a4010';X.beginPath();X.arc(cx,cy,R+8,0,Math.PI*2);X.fill();
    const rim=X.createRadialGradient(cx-30,cy-30,5,cx,cy,R+8);
    rim.addColorStop(0,'#f8e070');rim.addColorStop(0.5,'#c8a520');rim.addColorStop(1,'#5a3a08');
    X.fillStyle=rim;X.beginPath();X.arc(cx,cy,R+5,0,Math.PI*2);X.fill();
    /* Wheel body */
    X.save();X.translate(cx,cy);X.rotate(rotation);
    const segAngle=Math.PI*2/16;
    for(let i=0;i<16;i++){
      const a1=i*segAngle, a2=(i+1)*segAngle;
      /* gradient per segment dla głębi */
      const segG=X.createLinearGradient(0,0,Math.cos(a1+segAngle/2)*R,Math.sin(a1+segAngle/2)*R);
      const baseCol=COLORS[i];
      segG.addColorStop(0,baseCol);
      segG.addColorStop(1,_lightenHex?_lightenHex(baseCol,-30):baseCol);
      X.fillStyle=segG;
      X.beginPath();X.moveTo(0,0);X.arc(0,0,R,a1,a2);X.closePath();X.fill();
      /* Czarna ramka między segmentami */
      X.strokeStyle='#1a0a0a';X.lineWidth=2;X.stroke();
      /* Złota linia separująca segmenty */
      X.strokeStyle='rgba(255,215,0,.5)';X.lineWidth=1;
      X.beginPath();X.moveTo(0,0);X.lineTo(Math.cos(a1)*R,Math.sin(a1)*R);X.stroke();
      /* Etykieta segmentu */
      X.save();X.rotate(a1+segAngle/2);
      X.fillStyle=SEGMENTS[i]>=2?'#000':'#fff';
      X.strokeStyle=SEGMENTS[i]>=2?'rgba(255,255,255,.5)':'rgba(0,0,0,.6)';
      X.lineWidth=2;X.lineJoin='round';
      X.font='bold 18px "Russo One",Arial,sans-serif';X.textAlign='right';X.textBaseline='middle';
      const txt = SEGMENTS[i]===0?'✕':(SEGMENTS[i]===5?'JACKPOT':SEGMENTS[i]+'×');
      const tx=R-15;
      X.font=SEGMENTS[i]===5?'bold 11px Arial':'bold 18px Arial';
      X.strokeText(txt,tx,0);
      X.fillText(txt,tx,0);
      X.restore();
    }
    /* Center hub */
    X.restore();
    const hubG=X.createRadialGradient(cx-8,cy-8,2,cx,cy,30);
    hubG.addColorStop(0,'#fff7c0');hubG.addColorStop(0.5,'#f1c40f');hubG.addColorStop(1,'#5a3a08');
    X.fillStyle=hubG;X.beginPath();X.arc(cx,cy,30,0,Math.PI*2);X.fill();
    X.strokeStyle='#3a2408';X.lineWidth=2;X.stroke();
    /* Małe gold dots wokół hub */
    for(let i=0;i<8;i++){
      const a=i*Math.PI/4;
      X.fillStyle='#c8a520';
      X.beginPath();X.arc(cx+Math.cos(a)*22,cy+Math.sin(a)*22,2.5,0,Math.PI*2);X.fill();
    }
    /* Pointer (wskaźnik) — z góry */
    X.fillStyle='#c01020';
    X.beginPath();X.moveTo(cx,cy-R+8);X.lineTo(cx-14,cy-R-18);X.lineTo(cx+14,cy-R-18);X.closePath();X.fill();
    X.strokeStyle='#f8e070';X.lineWidth=2;X.stroke();
    /* Highlight glow on pointer */
    X.fillStyle='rgba(255,255,255,.4)';
    X.beginPath();X.moveTo(cx,cy-R+4);X.lineTo(cx-5,cy-R-12);X.lineTo(cx+5,cy-R-12);X.closePath();X.fill();
  };
  window._wheelOnBet=(v)=>{const x=parseInt(v);if(!isNaN(x))bet=x;};
  window._wheelSpin=()=>{
    if(spinning||bet<30||bet>G.casinoChips)return;
    if(bet>10000){lastResult='⚠️ Maksymalna stawka 10 000 żetonów';spinning=false;_render();return;}
    /* v2.0.27: global cooldown. v2.0.28: direct DOM żeby koło NIE było resetowane */
    const _now=Date.now();
    if(G._wheelCooldownUntil && _now<G._wheelCooldownUntil){
      const resEl=document.getElementById('wheel-result');
      lastResult=`⏳ Poczekaj ${((G._wheelCooldownUntil-_now)/1000).toFixed(1)}s — koło jeszcze się kręci`;
      if(resEl) resEl.textContent=lastResult;
      return;
    }
    G._wheelCooldownUntil = _now + 3700;
    spinning=true;
    G.casinoChips-=bet;
    /* v2.0.25: ticking sound podczas spinu */
    if(typeof sfxWheelTick==='function') sfxWheelTick();
    const idx=Math.floor(Math.random()*16);
    /* v1.9.98: BUG FIX — po pierwszym spinie rotation zostawała w PI*10, kolejny spin targetAngle też ~PI*10
       → różnica mała → koło "ledwo się rusza". Fix: NORMALIZUJ rotation do [0, 2π) przed nowym spinem. */
    rotation = rotation % (Math.PI*2);
    if(rotation<0) rotation += Math.PI*2;
    const startRot = rotation;
    const segMid = (idx*(Math.PI*2/16)) + (Math.PI*2/32);
    let finalDelta = (3*Math.PI/2 - segMid) - startRot;
    while(finalDelta<0) finalDelta += Math.PI*2;
    const targetAngle = startRot + finalDelta + Math.PI*2*5;
    const duration=3500;
    const startTime=Date.now();
    /* v2.0.24: finalize w osobnej funkcji + zarejestrowany w _activeCasinoFinalize.
       Gdy gracz wyjdzie z overlay podczas animacji, closeOverlay() wywoła _finalize natychmiast
       — wygrana jest naliczana, gracz nie traci stawki za sam fakt wyjścia. */
    let finalized=false;
    const _finalize=()=>{
      if(finalized) return;
      finalized=true;
      rotation = targetAngle % (Math.PI*2);
      const mult=SEGMENTS[idx];
      const win=Math.floor(bet*mult);
      G.casinoChips+=win;
      G.casinoStats=G.casinoStats||{};
      G.casinoStats.wheelPlayed=(G.casinoStats.wheelPlayed||0)+1;
      if(win>0)G.casinoStats.wheelWon=(G.casinoStats.wheelWon||0)+1;
      if(win>(G.casinoStats.biggestWin||0))G.casinoStats.biggestWin=win;
      G.casinoStats.totalWon=(G.casinoStats.totalWon||0)+win;
      G.casinoStats.totalLost=(G.casinoStats.totalLost||0)+bet;
      lastResult=mult>=5?`🎉 JACKPOT! Segment ${mult}× → +${win} żetonów!`:mult>=2?`🎯 Wygrana ${mult}× → +${win} żetonów!`:mult>=1?`Zwrot stawki (${bet} żet.)`:`Niestety przegrana (segment 0×)`;
      /* v2.0.25: jackpot/bigwin/cash w zależności od mnożnika */
      if(mult>=5){ if(typeof sfxJackpot==='function')sfxJackpot(); if(typeof confetti==='function')confetti(50); }
      else if(mult>=2){ if(typeof sfxBigWin==='function')sfxBigWin(); }
      else if(mult>=1){ if(typeof sfxCash==='function')sfxCash(); }
      spinning=false;
      if(typeof saveGameSilent==='function')saveGameSilent();
      window._activeCasinoFinalize=null;
      if(document.getElementById('wheel-canvas')) _render();
    };
    window._activeCasinoFinalize=_finalize;
    const anim=()=>{
      if(finalized) return;
      const t=Math.min(1,(Date.now()-startTime)/duration);
      const eased=1-Math.pow(1-t,3);
      rotation=startRot+(targetAngle-startRot)*eased;
      _drawWheel();
      if(t<1) requestAnimationFrame(anim);
      else _finalize();
    };
    anim();
  };
  _render();openOverlay();
};

