window.doPrestige=()=>{
  const rank=(G.prestige||0)+1;
  /* v1.9.48: cap Prestige na 10 (audyt late-game: bez capa = unbounded scaling, P100 = 6x multiplier) */
  if(rank>10){showMsg('🏆 Maksymalny Prestige (10) osiągnięty! Bez dalszych progresów rankingu.','r');return;}
  const reqs=getPrestigeReqs(rank);
  if(G.level<reqs.level){showMsg(`Prestige ${rank} wymaga poziomu ${reqs.level} (masz ${G.level})`,'r');return;}
  if((G.fans||0)<reqs.fans){showMsg(`Prestige ${rank} wymaga ${reqs.fans.toLocaleString('pl')} fanów (masz ${(G.fans||0).toLocaleString('pl')})`,'r');return;}
  // v1.8.94: wykładnicze nagrody (rank² zamiast rank)
  const reward=rank*rank*5000;
  const fanBonus=rank*rank*1000;
  const skillPtBonus=1+Math.floor(rank/2);
  G.prestige=rank;G.level=1;G.xp=0;
  /* v2.1.160: Prestige Skill Points +1 za każdy Prestige rank */
  G.prestigePoints=(G.prestigePoints||0)+1;
  if(typeof addNotif==='function')addNotif(`🌟 +1 Prestige Skill Point! Razem masz: ${G.prestigePoints}. Wydaj w Telefon → Prestige Skills.`);
  G.money+=reward;G.totalEarned=(G.totalEarned||0)+reward;
  G.followers+=fanBonus;G.fame=clamp(G.fame+10,0,500);
  G.skillPoints=(G.skillPoints||0)+skillPtBonus;
  G.sleepDebt=0;
  // v1.9.15: anuluj aktywny kontrakt (poprzednio orphan — deadline pozostawał w przyszłości, nigdy nie wygasał)
  if(G.contract){addNotif('📜 Kontrakt anulowany przez Prestige — zacznij od nowa.');G.contract=null;}
  // v1.9.19: BUG FIX — Crew też się resetuje na Prestige (poprzednio survival crew dawał compound permanent +15+15+20% przez wieczne uruchomienia)
  if(Array.isArray(G.crew) && G.crew.length>0){
    addNotif('👥 Ekipa rozeszła się przy Prestige — rekrutuj na nowo!');
    G.crew=[];
  }
  /* v1.9.21: Career levels też się resetują na Prestige. Wcześniej "Legend" raper przy gracz lvl 1 = career flags persistowały, unlock check `c.gamer.unlocked` true mimo G.level=1. */
  if(G.careers){
    if(G.careers.raper){G.careers.raper.xp=0;G.careers.raper.level=0;G.careers.raper.skillPts=0;}
    /* v1.9.46: career counters też resetuj (sponsorships/posts/projects/beats) — wcześniej cyfry rosły infinit przez kolejne playthrough'y (audyt sponsor system) */
    ['gamer','beatmaker','youtuber','influencer','soundeng'].forEach(c=>{
      if(G.careers[c]){
        G.careers[c].unlocked=false;
        // zachowaj structural fields, ale wyzeruj counters
        Object.keys(G.careers[c]).forEach(k=>{
          if(typeof G.careers[c][k]==='number' && k!=='unlocked') G.careers[c][k]=0;
        });
      }
