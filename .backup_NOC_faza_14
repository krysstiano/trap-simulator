function sr(s){const x=Math.sin(s*9301+49297)*233280;return x-Math.floor(x);}
function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
function rnd(a,b){return Math.floor(Math.random()*(b-a+1))+a;}

// ═══ Skill effect helpers (F3-FIX FAZA B: hierarchia skill < power-up < evolution) ═══
// Wzor uniwersalny:
//   bonus = lvl*BASE + pu*PU_STEP + evo*EVO_BONUS
//   gdzie PU_STEP > BASE i EVO_BONUS > PU_STEP*3 (evolution = NAJWIEKSZA)
// Power-ups daja BAZOWE +30/+60/+90% (PU_STEP=0.30 × count, max count=3) (PU_STEP = 0.30 czyli pu*0.30)
// Evolution = +50-100% extra (unikatowy bonus)

// Helper bezpieczny do skill access (chroni przed undefined w early game)
function _sk(key){ return (typeof getSkillLvl==='function')?getSkillLvl(key):0; }
function _pu(key){ return (typeof getSkillPowerUps==='function')?getSkillPowerUps(key):0; }
function _evo(key){ return (typeof hasSkillEvolution==='function' && hasSkillEvolution(key))?1:0; }

// Negocjacje — discount w sklepach (skill -5%/pkt = max -15%, +PU -10/-20/-30, +Evo Master Trader -50%)
// v1.8.95: evo bonus 0.20 → 0.50 (zgodnie z opisem evolution "Wszystkie sklepy mają -50% cen")
function getShopDiscount(){
  const lvl=_sk('negocjacje'), pu=_pu('negocjacje'), evo=_evo('negocjacje');
  /* v1.9.45: pre-clamp żeby BF stack nie startował z ujemnego multiplikatora (audyt shop logic) */
  let d = Math.max(0.20, 1 - lvl*0.05 - pu*0.10 - evo*0.50);
  // v1.8.97: Black Friday — wszystkie sklepy -20% (holidayBonus('shop') = 0.8)
  if(typeof holidayBonus==='function'){
    const hb=holidayBonus('shop');
    if(hb<1) d *= hb;
  }
  return Math.max(0.20, d); // cap rozszerzony do 80% discount aby BF stackował się z evo
