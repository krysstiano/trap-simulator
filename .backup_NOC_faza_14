        /* system / bank — automaty, gracz nie buduje "przyjaźni" */
        if(contactId==='system'||contactId==='bank'){
          return `${_replyCounter}<div style="display:flex;gap:4px;flex-wrap:wrap">
            <button onclick="_smsQuickReply('${contactId}','thanks')" style="flex:1;background:#1a2535;border:1px solid #2a4a6a;color:#7ec8e3;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">✓ OK</button>
          </div>`;
        }
        /* SMS-only NPC (Kamil Stary kumpel, Label, Sponsor, Crew, GymBro) */
        if(_smsOnly){
          return `${_replyCounter}<div style="display:flex;gap:4px;flex-wrap:wrap">
            <button onclick="_smsQuickReply('${contactId}','thanks')" style="flex:1;background:#1a3525;border:1px solid #2a6a3a;color:#9ee89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">👍 Dzięki (+1 przyjaźń)</button>
            <button onclick="_smsQuickReply('${contactId}','call')" style="flex:1;background:#2a1a35;border:1px solid #6a3a8a;color:#c89eeb;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">📞 Zadzwoń (+2 przyjaźń)</button>
            <button onclick="_smsQuickReply('${contactId}','later')" style="flex:1;background:#352525;border:1px solid #6a3a3a;color:#e89e9e;padding:8px;border-radius:6px;cursor:pointer;font-size:11px">— Ignoruj (-1 przyjaźń)</button>
          </div>`;
        }
        /* Fizyczne NPC w mieście — można "wpaść" */
        return `${_replyCounter}<div style="display:flex;gap:4px;flex-wrap:wrap">
          <button onclick="_smsQuickReply('${contactId}','thanks')" style="flex:1;background:#1a3525;border:1px solid #2a6a3a;color:#9ee89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">👍 Dzięki (+1 przyjaźń)</button>
          <button onclick="_smsQuickReply('${contactId}','visit')" style="flex:1;background:#2a3525;border:1px solid #6a8a3a;color:#e8e89e;padding:8px;border-radius:6px;cursor:pointer;font-size:12px">🚶 Wpadnę (+3 przyjaźń)</button>
          <button onclick="_smsQuickReply('${contactId}','later')" style="flex:1;background:#352525;border:1px solid #6a3a3a;color:#e89e9e;padding:8px;border-radius:6px;cursor:pointer;font-size:11px">— Ignoruj (-1 przyjaźń)</button>
        </div>`;
      })()}
    </div>`;
  // Auto-scroll do dołu
  setTimeout(()=>{const t=document.getElementById('sms-thread');if(t)t.scrollTop=t.scrollHeight;},10);
  if(typeof saveGameSilent==='function') saveGameSilent();
};
window._smsReply=function(contactId,text){
