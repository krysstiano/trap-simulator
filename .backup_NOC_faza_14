window._smsQuickReply=function(contactId,type){
  /* v1.9.82: per-MESSAGE tracking (a nie per NPC per dzień).
     Każda wiadomość od NPC może być odpowiedziana RAZ. NPC wysyła różne — każdą gracz odpowiada osobno. */
  const conv=G.sms?.conversations?.[contactId]||[];
  if(conv.length===0) return;
  /* Znajdź ostatnią wiadomość OD NPC (nie 'me') która NIE ma jeszcze odpowiedzi */
  let targetMsgIdx=-1;
  for(let i=conv.length-1;i>=0;i--){
    const m=conv[i];
    if(m.from==='me') continue;
    if(m._replied) continue;
    targetMsgIdx=i; break;
  }
  if(targetMsgIdx<0){
    if(typeof showMsg==='function') showMsg('💬 Już odpowiedziałeś na wszystkie wiadomości od tego kontaktu. Poczekaj na nowe.','r',4500);
    return;
  }
  const replies={
    thanks:{text:'👍 OK, dzięki!',friendDelta:1,energyDelta:0,note:'+1 przyjaźń'},
    visit:{text:'Zaraz wpadnę.',friendDelta:0,energyDelta:0,note:'Zobowiązanie aktywne — podejdź do NPC żeby zaliczyć (+3 przyjaźń, max 2 dni)',pendingVisit:true},
    /* v2.1.66 Amper: call dla SMS-only NPC — nie ma fizycznej obecności, więc nie można "wpaść". */
    call:{text:'Spoko, zadzwonię później pogadać.',friendDelta:2,energyDelta:0,note:'Pogadałeś z nim przez telefon. +2 przyjaźń.'},
    later:{text:'Może później.',friendDelta:-1,energyDelta:0,note:'-1 przyjaźń (NPC zniechęcony)'}
  };
  const r=replies[type]||replies.thanks;
  _smsReply(contactId,r.text);
  /* v1.9.82: mark target msg as replied */
  if(conv[targetMsgIdx]) conv[targetMsgIdx]._replied=true;
  if(typeof addFriendship==='function' && r.friendDelta!==0) addFriendship(contactId,r.friendDelta);
  if(r.energyDelta<0 && typeof clampStat==='function') G.energy=clampStat('energy',(G.energy||0)+r.energyDelta);
  if(r.pendingVisit){
    if(!G._smsPendingVisit) G._smsPendingVisit={};
    G._smsPendingVisit[contactId]={day:G.day,expiresDay:G.day+2};
    if(typeof addNotif==='function') addNotif(`📍 ${contactId} czeka — podejdź do niego (max 2 dni) żeby zaliczyć wizytę.`);
    /* v2.0.31: opcja podglądu mapy z podświetloną lokalizacją NPC.
       v2.1.66 Amper: Kamil usunięty — SMS-only, nie ma fizycznej obecności. */
    const _mapNpcs=['wiktor','marcin','zbyszek','producent'];
    if(_mapNpcs.includes(contactId) && typeof gameConfirm==='function'){
      const cName=(typeof SMS_CONTACTS!=='undefined' && SMS_CONTACTS[contactId])?SMS_CONTACTS[contactId].name:contactId;
      setTimeout(()=>{
        gameConfirm(`📍 Pokazać gdzie znaleźć ${cName} na mapie miasta?`,()=>{
          const phEl=document.getElementById('phone');
          if(phEl && !phEl.classList.contains('on')){phEl.classList.add('on');}
          if(typeof renderPhoneNPCMap==='function') renderPhoneNPCMap(contactId);
        });
      },400);
    }
  }
  if(typeof showMsg==='function' && r.note) showMsg(`💬 ${r.note}`,'f',3500);
  if(typeof saveGameSilent==='function') saveGameSilent();
};
/* v1.9.79: zaliczenie wizyty przy podejściu do NPC */
window._smsCheckPendingVisit=function(contactId){
  /* v1.9.84: validation — pomiń jeśli contactId nie istnieje w SMS_CONTACTS */
  if(typeof SMS_CONTACTS!=='undefined' && !SMS_CONTACTS[contactId]) return;
  if(!G._smsPendingVisit||!G._smsPendingVisit[contactId]) return;
  const pv=G._smsPendingVisit[contactId];
  if(G.day>pv.expiresDay){
    delete G._smsPendingVisit[contactId];
    if(typeof addFriendship==='function') addFriendship(contactId,-2);
    if(typeof addNotif==='function') addNotif(`⏰ Spóźniłeś się — wizyta wygasła (-2 przyjaźń)`);
    return;
  }
  if(typeof addFriendship==='function') addFriendship(contactId,3);
  delete G._smsPendingVisit[contactId];
  if(typeof showMsg==='function') showMsg(`🤝 Wizyta zaliczona — +3 przyjaźń!`,'g',3000);
  if(typeof saveGameSilent==='function') saveGameSilent();
};
window._smsExecAction=function(contactId,msgIdx){
  const msg=G.sms.conversations[contactId]?.[msgIdx];
  if(!msg||!msg.action) return;
  msg._actionUsed=true;
  // Akcja może być funkcją lub stringiem (np. otwórz overlay)
  try{
    if(typeof msg.action.fn==='function') msg.action.fn();
    /* v1.9.69: usunięty eval() branch — dead code, action.fn nigdy nie jest stringiem (audyt final security pass) */
  }catch(e){console.warn('SMS action failed:',e);}
  renderSMSConversation(contactId);
};

