// Daily play streak — bonus do zarobków za codzienne logowanie. Reset jeśli przerwa >1 dnia.
function updatePlayStreak(){
  const today=new Date();const isoToday=today.toISOString().slice(0,10);
  const last=G._lastPlayDate||'';
  if(isoToday===last) return; // ten sam dzień — bez zmian
  if(last){
    const yesterday=new Date(today.getTime()-86400000).toISOString().slice(0,10);
    if(last===yesterday) G.playStreak=(G.playStreak||0)+1;
    else G.playStreak=1; // przerwa — reset
  } else {
    G.playStreak=1; // pierwsze logowanie
  }
  G._lastPlayDate=isoToday;
  // Popup tylko gdy streak>=2 (drugi dzień z rzędu daje już bonus). Pierwszy dzień = bez spam'u.
  if(G.playStreak>=2){
    /* v2.0.29 BUG FIX: cache playStreak w closure + defensive re-check w setTimeout.
       Wcześniej: between setTimeout schedule (now) i fire (+1800ms), Prestige reset mógł ustawić
       G.playStreak=0. Template literal reread `${G.playStreak}` dawał 0, ale bonusPct był cached =2%.
       Efekt: "Streak 0 dni bonus 2%" — bezsensowne. Fix: cache streakDays oraz defensive guard. */
    const streakDays = G.playStreak;
    const bonusPct = Math.min(20, (streakDays-1)*2);
    setTimeout(()=>{
      if((G.playStreak||0) < 2) return; // defensive — playStreak zresetowany między schedule i fire
      showMsg(`🔥 Streak: ${streakDays} dni z rzędu! Bonus do zarobków: +${bonusPct}%`);
      if(streakDays>=3) confetti(15);
    },1800);
  }
}
