function rebuildAptTile(type,color){
  if(type==='floor'){
    makeTile('wood',c=>{
      c.fillStyle=color;c.fillRect(0,0,T,T);
      const lc=lightenHex(color,15);
      for(let i=0;i<4;i++){c.fillStyle=i%2===0?lc:color;c.fillRect(0,i*12+1,T,11);}
      c.strokeStyle='rgba(0,0,0,.15)';c.lineWidth=1;
      for(let y=12;y<T;y+=12){c.beginPath();c.moveTo(0,y);c.lineTo(T,y);c.stroke();}
    });
  } else if(type==='wall'){
    makeTile('wallp',c=>{
      c.fillStyle=color;c.fillRect(0,0,T,T);
      const dc=darkenHex(color,10);
      for(let y=0;y<T;y+=6){for(let x=0;x<T;x+=6){c.fillStyle=((Math.floor(x/6)+Math.floor(y/6))%2===0)?dc:color;c.fillRect(x,y,6,6);}}
    });
  }
}

